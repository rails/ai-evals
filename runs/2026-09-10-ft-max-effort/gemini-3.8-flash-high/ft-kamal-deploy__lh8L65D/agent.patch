diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..e5c8af8
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,60 @@
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image.
+image: your-user/fizzy
+
+# Deploy to this server.
+servers:
+  web:
+    - 192.168.0.1
+
+# Enable SSL auto-certification via Let's Encrypt from kamal-proxy.
+proxy:
+  ssl: true
+  host: app.example.com
+
+# Credentials for your image host.
+registry:
+  # Specify the registry server, if you're not using Docker Hub
+  # server: ghcr.io
+  username: your-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Configure builder setup.
+builder:
+  arch: amd64
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  clear:
+    # Hostname used for URLs in emails and background jobs (match proxy.host)
+    APP_HOST: app.example.com
+
+    # Mail server settings
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: your-smtp-username
+    # SMTP_DOMAIN: example.com
+    # SMTP_AUTHENTICATION: plain
+    # SMTP_ENABLE_STARTTLS_AUTO: true
+    # MAILER_FROM_ADDRESS: "Fizzy <support@example.com>"
+
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+
+# Persistent storage volume for SQLite databases and Active Storage uploads.
+# Survives redeployments.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests.
+asset_path: /rails/public/assets
+
+# Aliases are triggered with "bin/kamal <alias>".
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..9348da8 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -80,6 +80,46 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Configure host for URLs generated outside of request context (mailers, jobs, exports)
+  if app_host = ENV["APP_HOST"].presence || ENV["APP_FQDN"].presence || ENV["HOST"].presence
+    app_host = app_host.sub(/\Ahttps?:\/\//, "").chomp("/")
+    config.action_controller.default_url_options = { host: app_host, protocol: "https" }
+    config.action_mailer.default_url_options     = { host: app_host, protocol: "https" }
+
+    config.after_initialize do
+      Rails.application.routes.default_url_options.merge!(config.action_controller.default_url_options)
+    end
+  end
+
+  # Configure SMTP settings for Action Mailer
+  smtp_address = ENV["SMTP_ADDRESS"].presence || ENV["SMTP_HOST"].presence
+  if smtp_address
+    config.action_mailer.delivery_method = :smtp
+
+    smtp_auth = if ENV["SMTP_AUTHENTICATION"].present?
+      case ENV["SMTP_AUTHENTICATION"].downcase
+      when "none", "false" then nil
+      else ENV["SMTP_AUTHENTICATION"].to_sym
+      end
+    elsif ENV["SMTP_USERNAME"].presence || ENV["SMTP_USER"].presence
+      :plain
+    end
+
+    smtp_tls = ENV["SMTP_TLS"] == "true" || ENV["SMTP_SSL"] == "true"
+
+    config.action_mailer.smtp_settings = {
+      address:        smtp_address,
+      port:           ENV.fetch("SMTP_PORT", smtp_tls ? 465 : 587).to_i,
+      domain:         ENV["SMTP_DOMAIN"].presence || app_host,
+      user_name:      (ENV["SMTP_USERNAME"].presence || ENV["SMTP_USER"].presence),
+      password:       ENV["SMTP_PASSWORD"].presence,
+      authentication: smtp_auth,
+      tls:            (true if smtp_tls),
+      enable_starttls_auto: (false if !smtp_tls && ENV["SMTP_ENABLE_STARTTLS_AUTO"] == "false"),
+      openssl_verify_mode: ENV["SMTP_OPENSSL_VERIFY_MODE"].presence
+    }.compact
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
diff --git a/docs/deployment.md b/docs/deployment.md
new file mode 100644
index 0000000..3c04cea
--- /dev/null
+++ b/docs/deployment.md
@@ -0,0 +1,63 @@
+# Deployment
+
+Fizzy is configured for single-box deployment using [Kamal](https://kamal-deploy.org/). This runs everything in a single container on a Linux server: the Rails web application, background jobs via Solid Queue inside Puma, SQLite databases, and SSL certificates automatically provisioned by `kamal-proxy`.
+
+## Prerequisites
+
+1. **A Linux server** with SSH access and Docker (Kamal will install Docker automatically during setup if not already present).
+2. **A domain name** whose DNS points to your server's IP address.
+3. **A container registry** (such as Docker Hub or GitHub Packages / `ghcr.io`) where Docker images can be pushed.
+4. **An SMTP server** for delivering sign-in verification codes and notification emails.
+
+## Configuration
+
+### 1. `config/deploy.yml`
+
+Edit `config/deploy.yml` with your details:
+
+- **Server IP**: In `servers.web`, specify your server's IP address or hostname.
+- **Hostname**: In `proxy.host` and `env.clear.APP_HOST`, specify your domain name (e.g. `fizzy.example.com`). `kamal-proxy` will automatically request a Let's Encrypt SSL certificate for this host.
+- **Image & Registry**: In `image` and `registry.username`, specify your registry account and image name (e.g. `your-user/fizzy`).
+- **Mail Server**: In `env.clear`, configure your SMTP settings (`SMTP_ADDRESS`, `SMTP_PORT`, `SMTP_USERNAME`, `MAILER_FROM_ADDRESS`, etc.).
+
+### 2. `.kamal/secrets`
+
+Provide your deployment secrets via `.kamal/secrets`. You can export them as environment variables on your machine:
+
+```sh
+export KAMAL_REGISTRY_PASSWORD="your-registry-password"
+export SECRET_KEY_BASE="$(bin/rails secret)"
+export SMTP_PASSWORD="your-smtp-password"
+```
+
+Alternatively, you can use a password manager adapter (such as 1Password or Bitwarden) supported by Kamal.
+
+## Deploying
+
+Run `kamal setup` to bootstrap the server and deploy Fizzy:
+
+```sh
+kamal setup
+```
+
+Or using the binstub:
+
+```sh
+bin/kamal setup
+```
+
+This will:
+1. Ensure Docker is installed and running on your server.
+2. Start `kamal-proxy` and configure SSL termination via Let's Encrypt.
+3. Build and push your Docker image.
+4. Mount a persistent volume (`fizzy_storage:/rails/storage`) for your SQLite databases and file uploads so data survives future deploys.
+5. Run database migrations and launch the app container.
+6. Serve Fizzy at `https://your-host`.
+
+## Subsequent Deploys
+
+To deploy future updates, run:
+
+```sh
+kamal deploy
+```
diff --git a/test/configuration_test.rb b/test/configuration_test.rb
new file mode 100644
index 0000000..9357ea2
--- /dev/null
+++ b/test/configuration_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+require "kamal"
+
+class ConfigurationTest < ActiveSupport::TestCase
+  test "magic link mailer generates correct links with default_url_options" do
+    identity = identities(:kevin)
+    magic_link = MagicLink.create!(identity: identity)
+
+    old_options = ActionMailer::Base.default_url_options
+    ActionMailer::Base.default_url_options = { host: "fizzy.example.com", protocol: "https" }
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+    assert_match "https://fizzy.example.com", email.body.encoded
+  ensure
+    ActionMailer::Base.default_url_options = old_options
+  end
+
+  test "production environment configures host and smtp" do
+    result = IO.popen(
+      [
+        "env",
+        "RAILS_ENV=production",
+        "SECRET_KEY_BASE=1234567890123456789012345678901234567890",
+        "APP_HOST=fizzy.example.com",
+        "SMTP_ADDRESS=smtp.example.com",
+        "SMTP_PORT=587",
+        "SMTP_USERNAME=user1",
+        "SMTP_PASSWORD=pass1",
+        "bin/rails", "runner",
+        "puts Rails.application.config.action_controller.default_url_options.to_json; " \
+        "puts Rails.application.config.action_mailer.default_url_options.to_json; " \
+        "puts Rails.application.routes.default_url_options.to_json; " \
+        "puts Rails.application.config.action_mailer.smtp_settings.to_json"
+      ],
+      &:read
+    )
+
+    lines = result.lines.map(&:strip)
+    controller_options = JSON.parse(lines[0])
+    mailer_options = JSON.parse(lines[1])
+    routes_options = JSON.parse(lines[2])
+    smtp_settings = JSON.parse(lines[3])
+
+    assert_equal({ "host" => "fizzy.example.com", "protocol" => "https" }, controller_options)
+    assert_equal({ "host" => "fizzy.example.com", "protocol" => "https" }, mailer_options)
+    assert_equal({ "host" => "fizzy.example.com", "protocol" => "https" }, routes_options)
+    assert_equal "smtp.example.com", smtp_settings["address"]
+    assert_equal 587, smtp_settings["port"]
+    assert_equal "user1", smtp_settings["user_name"]
+    assert_equal "pass1", smtp_settings["password"]
+    assert_equal "plain", smtp_settings["authentication"]
+  end
+
+  test "production environment handles APP_HOST with scheme and trailing slash" do
+    result = IO.popen(
+      [
+        "env",
+        "RAILS_ENV=production",
+        "SECRET_KEY_BASE=1234567890123456789012345678901234567890",
+        "APP_HOST=https://fizzy.example.com/",
+        "bin/rails", "runner",
+        "puts Rails.application.config.action_mailer.default_url_options.to_json"
+      ],
+      &:read
+    )
+
+    mailer_options = JSON.parse(result.strip)
+    assert_equal({ "host" => "fizzy.example.com", "protocol" => "https" }, mailer_options)
+  end
+
+  test "production environment handles SMTP TLS settings" do
+    result = IO.popen(
+      [
+        "env",
+        "RAILS_ENV=production",
+        "SECRET_KEY_BASE=1234567890123456789012345678901234567890",
+        "SMTP_ADDRESS=smtp.gmail.com",
+        "SMTP_TLS=true",
+        "SMTP_USERNAME=user@gmail.com",
+        "SMTP_PASSWORD=secret",
+        "bin/rails", "runner",
+        "puts Rails.application.config.action_mailer.smtp_settings.to_json"
+      ],
+      &:read
+    )
+
+    smtp_settings = JSON.parse(result.strip)
+    assert_equal "smtp.gmail.com", smtp_settings["address"]
+    assert_equal 465, smtp_settings["port"]
+    assert_equal true, smtp_settings["tls"]
+    assert_nil smtp_settings["enable_starttls_auto"]
+  end
+
+  test "kamal deploy config is valid for single-box deployment" do
+    config = Kamal::Configuration.create_from(config_file: Rails.root.join("config/deploy.yml"))
+
+    assert_equal "fizzy", config.service
+    assert_equal [ "web" ], config.roles.map(&:name)
+    assert config.role(:web).running_proxy?
+    assert config.role(:web).proxy.ssl?
+    assert_equal [ "app.example.com" ], config.role(:web).proxy.hosts
+    assert_includes config.volume_args, "fizzy_storage:/rails/storage"
+    assert_equal "/rails/public/assets", config.asset_path
+
+    env = config.role(:web).env("192.168.0.1")
+    assert_equal "app.example.com", env.clear["APP_HOST"]
+    assert_equal "smtp.example.com", env.clear["SMTP_ADDRESS"]
+    assert_equal 587, env.clear["SMTP_PORT"]
+    assert_includes env.secret_keys, "SECRET_KEY_BASE"
+    assert_includes env.secret_keys, "SMTP_PASSWORD"
+  end
+end
