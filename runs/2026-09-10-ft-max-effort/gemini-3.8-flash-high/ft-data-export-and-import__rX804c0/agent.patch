+require "application_system_test_case"
+require "zip"
+
+class ExportAndImportTest < ApplicationSystemTestCase
+  test "admin can initiate account export from settings" do
+    sign_in_as(users(:kevin))
+
+    visit account_settings_url
+    assert_selector "h2", text: "Export account"
+    click_on "Export entire account"
+
+    assert_text "We're preparing your account export"
+  end
+
+  test "user can initiate cards export from profile" do
+    sign_in_as(users(:david))
+
+    visit user_url(users(:david))
+    assert_selector "h2", text: "Export cards"
+    click_on "Export my cards"
+
+    assert_text "We're preparing your cards export"
+  end
+
+  test "signed in user can view import page and upload an account file" do
+    sign_in_as(users(:david))
+
+    visit new_account_import_url(script_name: nil)
+    assert_selector "h1", text: "Import Account"
+
+    tempfile = Tempfile.new([ "account", ".zip" ])
+    Zip::File.open(tempfile.path, create: true) do |zip|
+      zip.get_output_stream("accounts/records.json") do |f|
+        f.write([ { name: "System Test Account" } ].to_json)
+      end
+    end
+
+    attach_file "file", tempfile.path
+    click_on "Start import"
+
+    assert_text "We're importing your account"
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+end
