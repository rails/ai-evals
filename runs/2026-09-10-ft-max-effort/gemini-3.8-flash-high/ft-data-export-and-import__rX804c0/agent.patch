+  end
+
+  test "signed in user can view new import page" do
+    sign_in_as @user
+    get new_account_import_url(script_name: nil)
+    assert_response :success
+  end
+
+  test "unauthenticated user cannot view new import page" do
+    get new_account_import_url(script_name: nil)
+    assert_response :redirect
+  end
+
+  test "signed in user can upload an account file to import" do
+    sign_in_as @user
+
+    tempfile = Tempfile.new([ "test", ".zip" ])
+    Zip::File.open(tempfile.path, create: true) do |zip|
+      zip.get_output_stream("test.txt") { |f| f.write("hello") }
+    end
+
+    uploaded_file = Rack::Test::UploadedFile.new(tempfile.path, "application/zip")
+
+    assert_difference -> { Import.count }, 1 do
+      assert_enqueued_with(job: ImportJob) do
+        post account_imports_url(script_name: nil), params: { file: uploaded_file }
+      end
+    end
+
+    assert_response :redirect
+    import = Import.last
+    assert_equal @identity, import.identity
+    assert import.file.attached?
+  ensure
+    tempfile&.close
+    tempfile&.unlink
+  end
+end
