+class ImportMailer < ApplicationMailer
+  def completed(import)
+    @import = import
+    @account = import.account
+
+    mail(
+      to: import.identity.email_address,
+      subject: "Your Fizzy account import is complete"
+    )
+  end
+
+  def failed(import)
+    @import = import
+    @error_message = import.error_message
+
+    mail(
+      to: import.identity.email_address,
+      subject: "Your Fizzy account import failed"
+    )
+  end
+end
