diff --git a/test/models/export_test.rb b/test/models/export_test.rb
new file mode 100644
index 0000000..8f75f88
--- /dev/null
+++ b/test/models/export_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+require "zip"
+
+class ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+  end
+
+  test "account export creates a zip file containing account data, cards as JSON with comments, and files" do
+    export = @account.exports.create!(user: @user, kind: :account)
+
+    assert_enqueued_emails 1 do
+      export.process_now
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+
+    export.file.open do |f|
+      Zip::File.open(f.path) do |zip|
+        assert zip.find_entry("accounts/records.json"), "Expected accounts/records.json in zip"
+        assert zip.find_entry("users/records.json"), "Expected users/records.json in zip"
+        assert zip.find_entry("boards/records.json"), "Expected boards/records.json in zip"
+        assert zip.find_entry("cards/records.json"), "Expected cards/records.json in zip"
+        assert zip.find_entry("cards.json"), "Expected cards.json in zip"
+
+        cards_entry = zip.find_entry("cards.json")
+        cards = JSON.parse(cards_entry.get_input_stream.read)
+        assert cards.is_a?(Array)
+        assert_equal @account.cards.count, cards.size
+
+        # Check cards come as JSON with their comments
+        card_with_comments = cards.find { |c| c["comments"].present? } || cards.first
+        assert card_with_comments.key?("comments")
+        assert card_with_comments.key?("title")
+        assert card_with_comments.key?("description")
+      end
+    end
+  end
+
+  test "cards export includes only cards the user can see, with comments and attachments" do
+    card = cards(:logo)
+    # Add an attachment to the card
+    Current.with_account(@account) do
+      card.image.attach(
+        io: File.open(Rails.root.join("test/fixtures/files/moon.jpg")),
+        filename: "moon.jpg",
+        content_type: "image/jpeg"
+      )
+      card.comments.create!(creator: @user, body: "Here is a comment")
+    end
+
+    export = @account.exports.create!(user: @user, kind: :cards)
+
+    assert_enqueued_emails 1 do
+      export.process_now
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+
+    export.file.open do |f|
+      Zip::File.open(f.path) do |zip|
+        assert zip.find_entry("cards.json")
+
+        cards_data = JSON.parse(zip.find_entry("cards.json").get_input_stream.read)
+        assert_equal @user.accessible_cards.count, cards_data.size
+
+        exported_card = cards_data.find { |c| c["id"] == card.id }
+        assert exported_card, "Expected card to be exported"
+        assert_equal card.title, exported_card["title"]
+        assert exported_card["comments"].any? { |c| c["body"].include?("Here is a comment") }
+
+        # Check picture is in zip
+        files = zip.glob("attachments/*/*").map(&:name) + zip.glob("files/*").map(&:name)
+        assert files.any? { |name| name.include?("moon.jpg") || name.include?(card.image.blob.key) }
+      end
+    end
+  end
+
+  test "download token works and expires in one day" do
+    export = @account.exports.create!(user: @user, kind: :account, status: :completed)
+    token = export.download_token
+
+    assert_equal export, Export.find_by_download_token(token)
+
+    expired_token = export.signed_id(purpose: :download, expires_in: -1.second)
+    assert_nil Export.find_by_download_token(expired_token)
+  end
+end
diff --git a/test/models/import_test.rb b/test/models/import_test.rb
new file mode 100644
index 0000000..553e81e
--- /dev/null
+++ b/test/models/import_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+require "zip"
+
+class ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @admin = users(:kevin)
+    @identity = identities(:kevin)
+  end
+
+  test "brings an account file back in and gets a new account with boards, cards, comments, files, people" do
+    # First, export the account
+    export = @account.exports.create!(user: @admin, kind: :account)
+    export.process_now
+    assert export.completed?
+
+    # Now create an import with the exported zip file
+    new_identity = Identity.create!(email_address: "newuser@example.com")
+    import_account = Account.create!(name: "Importing Account...")
+    import = new_identity.imports.new(account: import_account)
+
+    Current.with_account(import_account) do
+      export.file.open do |f|
+        import.file.attach(io: File.open(f.path), filename: "export.zip", content_type: "application/zip")
+        import.save!
+      end
+    end
+
+    assert_enqueued_emails 1 do
+      import.process_now
+    end
+
+
+    assert import.completed?
+    assert import.account.present?
+    assert_not_equal @account.id, import.account.id
+
+    new_account = import.account
+    assert_equal @account.name, new_account.name
+    assert new_account.boards.any?, "Expected boards to be imported"
+    assert new_account.cards.any?, "Expected cards to be imported"
+    assert new_account.users.any?, "Expected people (users) to be imported"
+    assert new_account.users.exists?(identity: new_identity), "Expected importer to be a user"
+    assert new_account.users.find_by(identity: new_identity).owner?, "Expected importer to be owner"
+  end
+
+  test "failed import leaves nothing behind and sends email with reason" do
+    initial_account_count = Account.count
+    new_identity = Identity.create!(email_address: "failuretest@example.com")
+
+    import_account = Account.create!(name: "Temporary Account...")
+    import = new_identity.imports.new(account: import_account)
+
+    Current.with_account(import_account) do
+      import.file.attach(
+        io: StringIO.new("Not a valid zip file content"),
+        filename: "corrupt.zip",
+        content_type: "application/zip"
+      )
+      import.save!
+    end
+
+    assert_enqueued_emails 1 do
+      import.process_now
+    end
+
+    assert import.failed?
+    assert import.error_message.present?
+
+    # Verify an import that can't be completed leaves nothing behind
+    assert_equal initial_account_count, Account.count
+    assert_nil Account.find_by(id: import_account.id)
+  end
+
+  test "can import cards-only zip file and create a new account with boards, cards, comments, people" do
+    # Export cards
+    export = @account.exports.create!(user: @admin, kind: :cards)
+    export.process_now
+    assert export.completed?
+
+    new_identity = Identity.create!(email_address: "cardimporter@example.com")
+    import_account = Account.create!(name: "Importing Cards...")
+    import = new_identity.imports.new(account: import_account)
+
+    Current.with_account(import_account) do
+      export.file.open do |f|
+        import.file.attach(io: File.open(f.path), filename: "cards.zip", content_type: "application/zip")
+        import.save!
+      end
+    end
+
+    assert_enqueued_emails 1 do
+      import.process_now
+    end
+
+    assert import.completed?
+    new_account = import.account
+    assert new_account.present?
+    assert new_account.boards.any?
+    assert new_account.cards.any?
+    assert new_account.users.exists?(identity: new_identity)
+  end
+end
