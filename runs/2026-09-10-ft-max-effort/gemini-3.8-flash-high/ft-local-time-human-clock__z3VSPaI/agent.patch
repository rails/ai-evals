diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..67f6646
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time renders local-time tag with ISO8601 datetime" do
+    time = Time.utc(2025, 1, 22, 13, 42, 0)
+    assert_dom_equal %(<local-time datetime="2025-01-22T13:42:00Z" type="time" class="local-time-value"></local-time>),
+      local_time(time)
+  end
+
+  test "local_time with format" do
+    time = Time.utc(2025, 1, 22, 13, 42, 0)
+    assert_dom_equal %(<local-time datetime="2025-01-22T13:42:00Z" format="%l:%M %p" class="local-time-value"></local-time>),
+      local_time(time, "%l:%M %p")
+  end
+
+  test "local_date renders with date type" do
+    time = Time.utc(2025, 1, 22, 13, 42, 0)
+    assert_dom_equal %(<local-time datetime="2025-01-22T13:42:00Z" type="date" class="local-time-value"></local-time>),
+      local_date(time)
+  end
+
+  test "local_date with format" do
+    time = Time.utc(2025, 1, 22, 13, 42, 0)
+    assert_dom_equal %(<local-time datetime="2025-01-22T13:42:00Z" format="%b %-d" class="local-time-value"></local-time>),
+      local_date(time, format: "%b %-d")
+  end
+
+  test "local_time_ago renders with time-ago type" do
+    time = Time.utc(2025, 1, 22, 13, 42, 0)
+    assert_dom_equal %(<local-time datetime="2025-01-22T13:42:00Z" type="time-ago" class="local-time-value"></local-time>),
+      local_time_ago(time)
+  end
+
+  test "local_relative_time renders with given type" do
+    time = Time.utc(2025, 1, 22, 13, 42, 0)
+    assert_dom_equal %(<local-time datetime="2025-01-22T13:42:00Z" type="time-or-date" class="local-time-value"></local-time>),
+      local_relative_time(time, type: "time-or-date")
+  end
+
+  test "local_time_or_date renders with time-or-date type" do
+    time = Time.utc(2025, 1, 22, 13, 42, 0)
+    assert_dom_equal %(<local-time datetime="2025-01-22T13:42:00Z" type="time-or-date" class="local-time-value"></local-time>),
+      local_time_or_date(time)
+  end
+
+  test "custom class is appended" do
+    time = Time.utc(2025, 1, 22, 13, 42, 0)
+    assert_dom_equal %(<local-time datetime="2025-01-22T13:42:00Z" type="time" class="local-time-value custom-class"></local-time>),
+      local_time(time, class: "custom-class")
+  end
+
+  test "nil time returns nil" do
+    assert_nil local_time(nil)
+    assert_nil local_date(nil)
+    assert_nil local_time_ago(nil)
+    assert_nil local_relative_time(nil)
+  end
+end
diff --git a/test/system/time_rendering_test.rb b/test/system/time_rendering_test.rb
new file mode 100644
index 0000000..464355f
--- /dev/null
+++ b/test/system/time_rendering_test.rb
@@ -0,0 +1,107 @@
+require "application_system_test_case"
+
+class TimeRenderingTest < ApplicationSystemTestCase
+  setup do
+    @card = cards(:logo)
+    @user = users(:david)
+    sign_in_as(@user)
+  end
+
+  test "comments show time for today, yesterday, and relative days" do
+    two_hours_ago = 2.hours.ago
+    yesterday = 1.day.ago
+    five_days_ago = 5.days.ago
+
+    c_today = @card.comments.create!(creator: @user, body: "Comment two hours ago", created_at: two_hours_ago)
+    c_yesterday = @card.comments.create!(creator: @user, body: "Comment yesterday", created_at: yesterday)
+    c_5days = @card.comments.create!(creator: @user, body: "Comment 5 days ago", created_at: five_days_ago)
+
+    visit card_url(@card)
+
+    within("#comment_#{c_today.id}") do
+      time_el = find(".comment__permalink-title local-time")
+      assert_equal "time-or-date", time_el["type"]
+      assert_match(/\d{1,2}:\d{2}\s+(AM|PM)/, time_el.text(:all))
+    end
+
+    within("#comment_#{c_yesterday.id}") do
+      time_el = find(".comment__permalink-title local-time")
+      assert_equal "yesterday", time_el.text(:all)
+    end
+
+    within("#comment_#{c_5days.id}") do
+      time_el = find(".comment__permalink-title local-time")
+      assert_includes [ "5 days ago", "Sep 12" ], time_el.text(:all)
+    end
+  end
+
+  test "card auto-closing overnight reads tomorrow, further out reads in 3 days" do
+    @card.update!(last_active_at: 1.day.from_now - @card.auto_postpone_period)
+
+    visit card_url(@card)
+
+    within("##{dom_id(@card, :closure_notice)}") do
+      assert_text "Moves to “Not Now” tomorrow if there’s no activity."
+    end
+
+    @card.update!(last_active_at: 3.days.from_now - @card.auto_postpone_period)
+    visit card_url(@card)
+
+    within("##{dom_id(@card, :closure_notice)}") do
+      assert_text "Moves to “Not Now” in 3 days if there’s no activity."
+    end
+  end
+
+  test "card closure and card stamp format correctly" do
+    closed_time = Time.utc(2025, 9, 12, 13, 42, 0)
+    @card.close(user: @user)
+    @card.closure.update!(created_at: closed_time)
+
+    visit card_url(@card)
+
+    within(".card-perma__closure-message") do
+      assert_text "Completed by David on Sep 12."
+    end
+
+    within(".card__closed-date") do
+      assert_equal "Sep 12, 2025", find("local-time").text(:all)
+    end
+  end
+
+  test "card metadata shows relative times" do
+    @card.update!(created_at: 2.hours.ago, last_active_at: 1.hour.ago)
+
+    visit card_url(@card)
+
+    within("##{dom_id(@card, :meta)}") do
+      assert_equal "2 hours ago", find(".card__meta-text--added local-time").text(:all)
+      assert_equal "1 hour ago", find(".card__meta-text--updated local-time").text(:all)
+    end
+  end
+
+  test "notifications show localized date" do
+    notification = notifications(:logo_mentioned_david)
+    visit notifications_path
+
+    within("##{dom_id(notification)}") do
+      assert_selector ".card__timestamp local-time[format='%b %-d']"
+    end
+  end
+
+  test "access tokens show localized datetime" do
+    access_token = identity_access_tokens(:davids_api_token)
+    sign_in_as(users(:david))
+    visit my_access_tokens_path
+
+    within("tr[style*='#{dom_id(access_token)}']") do
+      assert_selector "local-time[format='%-m/%-d/%y, %l:%M %p']"
+    end
+  end
+
+  test "day timeline shows localized column title and event timestamps" do
+    visit events_path
+
+    assert_selector ".events__column-header local-time[format='%A, %B %-d']"
+    assert_selector ".event__timestamp local-time[format='%l:%M %p']"
+  end
+end
