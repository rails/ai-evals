diff --git a/app/javascript/initializers/local_time.js b/app/javascript/initializers/local_time.js
new file mode 100644
index 0000000..48791c6
--- /dev/null
+++ b/app/javascript/initializers/local_time.js
@@ -0,0 +1,257 @@
+const MONTH_NAMES = [
+  "January", "February", "March", "April", "May", "June",
+  "July", "August", "September", "October", "November", "December"
+]
+
+const MONTH_NAMES_SHORT = [
+  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
+  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
+]
+
+const DAY_NAMES = [
+  "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"
+]
+
+const DAY_NAMES_SHORT = [
+  "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"
+]
+
+export function strftime(date, format) {
+  return format.replace(/%(-?[A-Za-z%])/g, (match, token) => {
+    switch (token) {
+      case "A": return DAY_NAMES[date.getDay()]
+      case "a": return DAY_NAMES_SHORT[date.getDay()]
+      case "B": return MONTH_NAMES[date.getMonth()]
+      case "b": return MONTH_NAMES_SHORT[date.getMonth()]
+      case "-d": return String(date.getDate())
+      case "d": return String(date.getDate()).padStart(2, "0")
+      case "-e":
+      case "e": return String(date.getDate())
+      case "-m": return String(date.getMonth() + 1)
+      case "m": return String(date.getMonth() + 1).padStart(2, "0")
+      case "Y": return String(date.getFullYear())
+      case "y": return String(date.getFullYear()).slice(-2)
+      case "-H": return String(date.getHours())
+      case "H": return String(date.getHours()).padStart(2, "0")
+      case "-I":
+      case "-l":
+      case "l":
+        return String(date.getHours() % 12 || 12)
+      case "I":
+        return String(date.getHours() % 12 || 12).padStart(2, "0")
+      case "-M": return String(date.getMinutes())
+      case "M": return String(date.getMinutes()).padStart(2, "0")
+      case "-S": return String(date.getSeconds())
+      case "S": return String(date.getSeconds()).padStart(2, "0")
+      case "p": return date.getHours() >= 12 ? "PM" : "AM"
+      case "P": return date.getHours() >= 12 ? "pm" : "am"
+      case "%": return "%"
+      default: return match
+    }
+  })
+}
+
+function toMidnight(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+function calendarDaysDifference(fromDate, toDate) {
+  const fromMidnight = toMidnight(fromDate)
+  const toMidnightDate = toMidnight(toDate)
+  const msPerDay = 1000 * 60 * 60 * 24
+  return Math.round((toMidnightDate.getTime() - fromMidnight.getTime()) / msPerDay)
+}
+
+function isToday(date, now = new Date()) {
+  return calendarDaysDifference(date, now) === 0
+}
+
+function isYesterday(date, now = new Date()) {
+  return calendarDaysDifference(date, now) === 1
+}
+
+function isTomorrow(date, now = new Date()) {
+  return calendarDaysDifference(now, date) === 1
+}
+
+export function formatTime(date) {
+  return strftime(date, "%l:%M %p")
+}
+
+export function formatTimeOrDate(date, now = new Date()) {
+  if (isToday(date, now)) {
+    return formatTime(date)
+  }
+
+  if (isYesterday(date, now)) {
+    return "yesterday"
+  }
+
+  const daysAgo = calendarDaysDifference(date, now)
+  if (daysAgo >= 2 && daysAgo < 7) {
+    return `${daysAgo} days ago`
+  }
+
+  if (date.getFullYear() === now.getFullYear()) {
+    return strftime(date, "%b %-d")
+  }
+
+  return strftime(date, "%b %-d, %Y")
+}
+
+export function formatTimeAgo(date, now = new Date()) {
+  const diffInSeconds = Math.round((now.getTime() - date.getTime()) / 1000)
+
+  // Future dates
+  if (diffInSeconds < 0) {
+    const futureSeconds = -diffInSeconds
+
+    if (isTomorrow(date, now)) {
+      return "tomorrow"
+    }
+
+    const futureDays = calendarDaysDifference(now, date)
+    if (futureDays >= 1) {
+      if (futureDays === 1) return "tomorrow"
+      if (futureDays < 30) return `in ${futureDays} days`
+      const months = Math.round(futureDays / 30)
+      if (months < 12) return months === 1 ? "in 1 month" : `in ${months} months`
+      const years = Math.round(futureDays / 365)
+      return years === 1 ? "in 1 year" : `in ${years} years`
+    }
+
+    // Future today (hours / minutes / seconds)
+    if (futureSeconds < 60) return "today"
+    const futureMinutes = Math.round(futureSeconds / 60)
+    if (futureMinutes < 60) return futureMinutes === 1 ? "in 1 minute" : `in ${futureMinutes} minutes`
+    const futureHours = Math.round(futureMinutes / 60)
+    return futureHours === 1 ? "in 1 hour" : `in ${futureHours} hours`
+  }
+
+  // Past dates
+  if (isYesterday(date, now)) {
+    return "yesterday"
+  }
+
+  const daysAgo = calendarDaysDifference(date, now)
+  if (daysAgo >= 1) {
+    if (daysAgo === 1) return "yesterday"
+    if (daysAgo < 30) return `${daysAgo} days ago`
+    const months = Math.round(daysAgo / 30)
+    if (months < 12) return months === 1 ? "1 month ago" : `${months} months ago`
+    const years = Math.round(daysAgo / 365)
+    return years === 1 ? "1 year ago" : `${years} years ago`
+  }
+
+  // Past today
+  if (diffInSeconds < 60) {
+    return "just now"
+  }
+  const minutes = Math.round(diffInSeconds / 60)
+  if (minutes < 60) {
+    return minutes === 1 ? "1 minute ago" : `${minutes} minutes ago`
+  }
+  const hours = Math.round(minutes / 60)
+  return hours === 1 ? "1 hour ago" : `${hours} hours ago`
+}
+
+export function formatFullDate(date) {
+  return strftime(date, "%B %-d, %Y at %l:%M %p")
+}
+
+const relativeElements = new Set()
+let timer = null
+
+function ensureTimer() {
+  if (!timer && typeof setInterval !== "undefined") {
+    timer = setInterval(() => {
+      for (const el of relativeElements) {
+        if (el.isConnected) {
+          el.update()
+        } else {
+          relativeElements.delete(el)
+        }
+      }
+    }, 60_000)
+  }
+}
+
+export class LocalTimeElement extends HTMLElement {
+  static observedAttributes = [ "datetime", "type", "format" ]
+
+  connectedCallback() {
+    this.update()
+    if (this.#isRelative) {
+      relativeElements.add(this)
+      ensureTimer()
+    }
+  }
+
+  disconnectedCallback() {
+    relativeElements.delete(this)
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) {
+      this.update()
+    }
+  }
+
+  get #isRelative() {
+    const type = this.getAttribute("type")
+    return type === "time-ago" || type === "time-or-date"
+  }
+
+  get date() {
+    const datetime = this.getAttribute("datetime")
+    if (!datetime) return null
+    const parsed = new Date(datetime)
+    return isNaN(parsed.getTime()) ? null : parsed
+  }
+
+  update() {
+    const date = this.date
+    if (!date) return
+
+    const format = this.getAttribute("format")
+    const type = this.getAttribute("type")
+
+    let text = ""
+    if (format) {
+      text = strftime(date, format)
+    } else if (type === "time-or-date") {
+      text = formatTimeOrDate(date)
+    } else if (type === "time-ago") {
+      text = formatTimeAgo(date)
+    } else if (type === "time") {
+      text = formatTime(date)
+    } else if (type === "date") {
+      text = strftime(date, "%b %-d, %Y")
+    } else {
+      text = formatFullDate(date)
+    }
+
+    this.textContent = text
+
+    if (!this.hasAttribute("title")) {
+      this.setAttribute("title", formatFullDate(date))
+    }
+
+    const stamp = this.closest('[data-controller~="bridge--stamp"]')
+    if (stamp) {
+      stamp.setAttribute("data-bridge-description", text.trim())
+    }
+  }
+}
+
+if (typeof customElements !== "undefined" && !customElements.get("local-time")) {
+  customElements.define("local-time", LocalTimeElement)
+}
+
+document.addEventListener("turbo:render", () => {
+  for (const el of relativeElements) {
+    if (el.isConnected) {
+      el.update()
+    }
+  }
+})
