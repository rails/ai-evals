diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..45b0e44 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,71 @@
 module TimeHelper
+  def local_time(time, options = nil, &block)
+    return if time.blank?
+
+    options = { format: options } if options.is_a?(String)
+    options = options&.dup || {}
+
+    format = options.delete(:format)
+    type = options.delete(:type) || (format.present? ? nil : "time")
+
+    render_local_time(time, type: type, format: format, **options, &block)
+  end
+
+  def local_date(time, options = nil, &block)
+    return if time.blank?
+
+    options = { format: options } if options.is_a?(String)
+    options = options&.dup || {}
+
+    format = options.delete(:format)
+    type = options.delete(:type) || (format.present? ? nil : "date")
+
+    render_local_time(time, type: type, format: format, **options, &block)
+  end
+
+  def local_time_ago(time, options = nil, &block)
+    return if time.blank?
+
+    options = options&.dup || {}
+    render_local_time(time, type: "time-ago", **options, &block)
+  end
+
+  def local_relative_time(time, options = nil, &block)
+    return if time.blank?
+
+    options = { type: options } if options.is_a?(String)
+    options = options&.dup || {}
+    type = options.delete(:type) || "time-or-date"
+
+    render_local_time(time, type: type, **options, &block)
+  end
+
+  def local_time_or_date(time, options = nil, &block)
+    local_relative_time(time, type: "time-or-date", **(options || {}), &block)
+  end
+
+  private
+    def render_local_time(time, type: nil, format: nil, **options, &block)
+      css_class = token_list("local-time-value", options.delete(:class))
+      attributes = {
+        datetime: time_to_iso8601(time),
+        type: type,
+        format: format,
+        class: css_class.presence
+      }.compact.merge(options)
+
+      tag.local_time(**attributes, &block)
+    end
+
+    def time_to_iso8601(time)
+      if time.respond_to?(:utc)
+        time.utc.iso8601
+      elsif time.respond_to?(:to_time)
+        time.to_time.utc.iso8601
+      elsif time.respond_to?(:iso8601)
+        time.iso8601
+      else
+        time.to_s
+      end
+    end
 end
