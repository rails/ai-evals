new file mode 100644
index 0000000..235c3e3
--- /dev/null
+++ b/test/mailers/identity_mailer_test.rb
@@ -0,0 +1,22 @@
+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "sign_in_code puts code in subject so it shows in notification" do
+    email = IdentityMailer.sign_in_code(email_address: "user@example.com", code: "123456")
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "user@example.com" ], email.to
+    assert_includes email.subject, "123456"
+    assert email.subject.start_with?("123456")
+    assert_equal "123456 is your Fizzy code", email.subject
+
+    assert email.html_part.present?
+    assert email.text_part.present?
+    assert_includes email.text_part.body.encoded, "123456"
+    assert_includes email.html_part.body.encoded, "123456"
+    assert_includes email.text_part.body.encoded, "fifteen minutes"
+  end
+end
diff --git a/test/models/sign_in_code_test.rb b/test/models/sign_in_code_test.rb
new file mode 100644
index 0000000..7e30e1b
--- /dev/null
+++ b/test/models/sign_in_code_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class SignInCodeTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "create_for generates a 6-character code and delivers email" do
+    assert_emails 1 do
+      sign_in_code = SignInCode.create_for("user@example.com")
+      assert_equal 6, sign_in_code.code.length
+      assert sign_in_code.active?
+      assert_not sign_in_code.expired?
+      assert_equal "user@example.com", sign_in_code.email_address
+    end
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "user@example.com" ], mail.to
+    assert_includes mail.subject, SignInCode.last.code
+  end
+
+  test "code works for fifteen minutes" do
+    sign_in_code = SignInCode.create_for("user@example.com")
+
+    travel 14.minutes do
+      assert sign_in_code.active?
+      assert_not sign_in_code.expired?
+      assert sign_in_code.verify(sign_in_code.code)
+    end
+
+    travel 16.minutes do
+      assert_not sign_in_code.active?
+      assert sign_in_code.expired?
+      assert_not sign_in_code.verify(sign_in_code.code)
+    end
+  end
+
+  test "authenticate verifies code case-insensitively and with whitespace" do
+    sign_in_code = SignInCode.create_for("user@example.com", code: "ABC123")
+
+    assert_equal sign_in_code, SignInCode.authenticate("abc123", email_address: "user@example.com")
+    assert_equal sign_in_code, SignInCode.authenticate(" ABC123 ", email_address: "user@example.com")
+    assert_nil SignInCode.authenticate("wrong", email_address: "user@example.com")
+  end
+
+  test "authenticate respects 15 minute expiration" do
+    sign_in_code = SignInCode.create_for("user@example.com")
+
+    travel 16.minutes do
+      assert_nil SignInCode.authenticate(sign_in_code.code, email_address: "user@example.com")
+    end
+  end
+end
