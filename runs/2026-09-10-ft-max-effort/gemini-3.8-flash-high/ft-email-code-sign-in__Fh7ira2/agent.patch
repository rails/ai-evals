+require "application_system_test_case"
+
+class EmailCodeAuthenticationTest < ApplicationSystemTestCase
+  test "sign in by email code" do
+    identity = identities(:kevin)
+
+    visit new_session_url(script_name: nil)
+
+    fill_in "email_address", with: identity.email_address
+    click_on "Let’s go"
+
+    assert_text "Check your email"
+    assert_selector "input[name=code]"
+
+    code = SignInCode.last.code
+    fill_in "code", with: code
+    click_on "Continue"
+
+    assert_no_text "Check your email"
+  end
+
+  test "sign up by email code" do
+    visit new_signup_url(script_name: nil)
+
+    fill_in "signup[email_address]", with: "brandnew@example.com"
+    click_on "Let’s go"
+
+    assert_text "Check your email"
+    assert_selector "input[name=code]"
+
+    code = SignInCode.last.code
+    fill_in "code", with: code
+    click_on "Continue"
+
+    assert_text "Complete your sign-up"
+    fill_in "signup[full_name]", with: "Brand New Person"
+    click_on "Continue"
+
+    assert_text "Welcome, and thanks for signing up for Fizzy"
+  end
+
+  test "join by email code" do
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    visit join_url(code: join_code.code, script_name: account.slug)
+
+    fill_in "email_address", with: "newworker@example.com"
+    click_on "Continue"
+
+    assert_text "We sent a six-character code to newworker@example.com"
+    assert_selector "input[name=code]"
+
+    code = SignInCode.last.code
+    fill_in "code", with: code
+    click_on "Continue"
+
+    assert_text "Great! Now enter your name"
+  end
+end
