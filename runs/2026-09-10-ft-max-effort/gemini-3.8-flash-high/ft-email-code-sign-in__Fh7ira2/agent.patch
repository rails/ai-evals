diff --git a/app/models/sign_in_code.rb b/app/models/sign_in_code.rb
new file mode 100644
index 0000000..c243cd1
--- /dev/null
+++ b/app/models/sign_in_code.rb
@@ -0,0 +1,79 @@
+class SignInCode < ApplicationRecord
+  EXPIRATION_TIME = 15.minutes
+  CODE_LENGTH = 6
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  validates :email_address, presence: true, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code, presence: true
+  validates :expires_at, presence: true
+
+  scope :active, -> { where("expires_at > ?", Time.current) }
+  scope :for_email, ->(email) { where(email_address: email.to_s.strip.downcase) }
+
+  class << self
+    def create_for(email_address, code: nil)
+      email_address = email_address.to_s.strip.downcase
+      code ||= generate_code
+
+      create!(
+        email_address: email_address,
+        code: code,
+        expires_at: EXPIRATION_TIME.from_now
+      ).tap do |sign_in_code|
+        sign_in_code.deliver_later
+      end
+    end
+
+    def authenticate(code, email_address: nil, code_id: nil)
+      return if code.blank?
+
+      scope = active
+
+      if code_id.present?
+        scope = scope.where(id: code_id)
+      elsif email_address.present?
+        scope = scope.for_email(email_address)
+      end
+
+      record = scope.order(created_at: :desc).find { |candidate| candidate.verify(code) }
+
+      if record.nil? && (code_id.present? || email_address.present?)
+        record = active.order(created_at: :desc).find { |candidate| candidate.verify(code) }
+      end
+
+      record
+    end
+
+    def generate_code
+      SecureRandom.random_number(10**CODE_LENGTH).to_s.rjust(CODE_LENGTH, "0")
+    end
+  end
+
+  def active?
+    Time.current < expires_at
+  end
+
+  def expired?
+    !active?
+  end
+
+  def verify(input_code)
+    if active?
+      code.to_s.strip.downcase == input_code.to_s.strip.downcase
+    else
+      false
+    end
+  end
+
+  def deliver_later
+    IdentityMailer.sign_in_code(email_address: email_address, code: code).deliver_later
+  end
+
+  def deliver_now
+    IdentityMailer.sign_in_code(email_address: email_address, code: code).deliver_now
+  end
+end
+
+EmailVerificationCode = SignInCode
+EmailCode = SignInCode
