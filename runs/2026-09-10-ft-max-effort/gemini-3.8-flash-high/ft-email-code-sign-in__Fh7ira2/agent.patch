@@ -0,0 +1,32 @@
+<% @page_title = "Join #{@join_code.account.name} in Fizzy" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+
+  <p class="margin-none-block-start">
+    We sent a six-character code to <strong><%= @email_address %></strong>. The code will expire in 15 minutes.
+  </p>
+
+  <%= form_with url: join_path(code: @join_code.code, tenant: params[:tenant]), class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <%= form.hidden_field :email_address, value: @email_address %>
+
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, value: nil, required: true, class: "input full-width center txt-align-center font-weight-bold", autofocus: true, autocomplete: "one-time-code", placeholder: "Enter 6-character code" %>
+      </label>
+    </div>
+
+    <button type="submit" id="log_in" class="btn btn--link center" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <div class="margin-block-start center">
+    <%= link_to "Enter a different email address", join_path(code: @join_code.code, reset: true), class: "btn btn--plain txt-link center txt-small" %>
+  </div>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
