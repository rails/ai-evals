diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..3a1f6c4
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time renders a local-time tag with ISO8601 UTC timestamp" do
+    time = Time.utc(2026, 9, 11, 14, 30, 0)
+    tag = local_time(time)
+
+    assert_match %r{<local-time[^>]*datetime="2026-09-11T14:30:00Z"[^>]*>}, tag
+    assert_match %r{class="local-time-value"}, tag
+  end
+
+  test "local_time returns nil when time is blank" do
+    assert_nil local_time(nil)
+    assert_nil local_time("")
+  end
+
+  test "local_time accepts format as string" do
+    time = Time.utc(2026, 9, 11, 14, 30, 0)
+    tag = local_time(time, "%b %-d")
+
+    assert_match %r{format="%b %-d"}, tag
+    assert_match %r{datetime="2026-09-11T14:30:00Z"}, tag
+  end
+
+  test "local_time accepts format as symbol" do
+    time = Time.utc(2026, 9, 11, 14, 30, 0)
+    tag = local_time(time, :short)
+
+    assert_match %r{format="short"}, tag
+  end
+
+  test "local_time accepts options hash with format and type" do
+    time = Time.utc(2026, 9, 11, 14, 30, 0)
+    tag = local_time(time, format: "%b %d, %Y", type: "time-or-date", class: "custom-class")
+
+    assert_match %r{format="%b %d, %Y"}, tag
+    assert_match %r{type="time-or-date"}, tag
+    assert_includes tag, "local-time-value custom-class"
+  end
+
+  test "local_date defaults to %B %-d, %Y format" do
+    time = Time.utc(2026, 9, 11, 14, 30, 0)
+    tag = local_date(time)
+
+    assert_match %r{format="%B %-d, %Y"}, tag
+    assert_match %r{datetime="2026-09-11T14:30:00Z"}, tag
+  end
+
+  test "local_date accepts custom format" do
+    time = Time.utc(2026, 9, 11, 14, 30, 0)
+    tag = local_date(time, format: "%A, %B %-d")
+
+    assert_match %r{format="%A, %B %-d"}, tag
+  end
+
+  test "local_date works with Date objects" do
+    date = Date.new(2026, 9, 11)
+    tag = local_date(date)
+
+    assert_match %r{datetime="2026-09-11T00:00:00Z"}, tag
+    assert_match %r{format="%B %-d, %Y"}, tag
+  end
+
+  test "local_time_ago sets type to time-ago" do
+    time = Time.utc(2026, 9, 11, 14, 30, 0)
+    tag = local_time_ago(time)
+
+    assert_match %r{type="time-ago"}, tag
+    assert_match %r{datetime="2026-09-11T14:30:00Z"}, tag
+  end
+
+  test "local_relative_time sets type to time-or-date" do
+    time = Time.utc(2026, 9, 11, 14, 30, 0)
+    tag = local_relative_time(time)
+
+    assert_match %r{type="time-or-date"}, tag
+    assert_match %r{datetime="2026-09-11T14:30:00Z"}, tag
+  end
+
+  test "time_tag delegates to local_time when no content or block is given" do
+    time = Time.utc(2026, 9, 11, 14, 30, 0)
+    tag = time_tag(time)
+
+    assert_match %r{<local-time}, tag
+  end
+
+  test "time_tag preserves default behavior when content is given" do
+    time = Time.utc(2026, 9, 11, 14, 30, 0)
+    tag = time_tag(time, "Custom content")
+
+    assert_match %r{<time[^>]*datetime="2026-09-11T14:30:00Z"[^>]*>Custom content</time>}, tag
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..7e5cd98
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,158 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "browser renders times in viewer's timezone" do
+    sign_in_as users(:kevin)
+
+    # Execute JavaScript directly in the browser with controlled time and custom elements
+    results = page.evaluate_script(<<~JS)
+      (() => {
+        const results = {}
+
+        // Mock current time: 2026-09-17 15:42:00 local time
+        const now = new Date(2026, 8, 17, 15, 42, 0)
+
+        // Helper to test formatting via LocalTime helpers
+        const formatOrDate = window.formatTimeOrDate || ((date, n) => {
+          const el = document.createElement("local-time")
+          el.setAttribute("datetime", date.toISOString())
+          return el
+        })
+
+        // Test 1: comment from 2 hours ago (today at 1:42 PM)
+        const twoHoursAgo = new Date(2026, 8, 17, 13, 42, 0)
+        const el1 = document.createElement("local-time")
+        el1.setAttribute("datetime", twoHoursAgo.toISOString())
+        document.body.appendChild(el1)
+
+        // Test 2: comment from last night (yesterday at 10:30 PM)
+        const lastNight = new Date(2026, 8, 16, 22, 30, 0)
+        const el2 = document.createElement("local-time")
+        el2.setAttribute("datetime", lastNight.toISOString())
+        document.body.appendChild(el2)
+
+        // Test 3: comment from earlier in the week (5 days ago)
+        const fiveDaysAgo = new Date(2026, 8, 12, 10, 0, 0)
+        const el3 = document.createElement("local-time")
+        el3.setAttribute("datetime", fiveDaysAgo.toISOString())
+        document.body.appendChild(el3)
+
+        // Test 4: card auto-closing overnight (tomorrow at 4:00 AM)
+        const tomorrow = new Date(2026, 8, 18, 4, 0, 0)
+        const el4 = document.createElement("local-time")
+        el4.setAttribute("datetime", tomorrow.toISOString())
+        document.body.appendChild(el4)
+
+        // Test 5: card auto-closing in 3 days
+        const inThreeDays = new Date(2026, 8, 20, 15, 42, 0)
+        const el5 = document.createElement("local-time")
+        el5.setAttribute("datetime", inThreeDays.toISOString())
+        document.body.appendChild(el5)
+
+        return {
+          registered: customElements.get("local-time") !== undefined,
+          el1Title: el1.title,
+          el1HasClass: el1.classList.contains("local-time-value")
+        }
+      })()
+    JS
+
+    assert results["registered"], "<local-time> should be registered as a custom element"
+  end
+
+  test "formatTimeOrDate, formatTimeAgo, and formatTime behavior in browser" do
+    sign_in_as users(:kevin)
+
+    results = page.evaluate_async_script(<<~JS)
+      const callback = arguments[arguments.length - 1];
+
+      // Import the local_time helper module using importmap
+      import("helpers/local_time").then(module => {
+        // Base reference time: 2026-09-17 15:42:00 (Thursday, Sep 17 at 3:42 PM)
+        const now = new Date(2026, 8, 17, 15, 42, 0);
+
+        // 1. Two hours ago today (1:42 PM)
+        const twoHoursAgo = new Date(2026, 8, 17, 13, 42, 0);
+        const textTwoHoursAgo = module.formatTimeOrDate(twoHoursAgo, now);
+
+        // 2. Last night (yesterday)
+        const lastNight = new Date(2026, 8, 16, 22, 30, 0);
+        const textLastNight = module.formatTimeOrDate(lastNight, now);
+
+        // 3. Earlier in the week (5 days ago: Sep 12)
+        const fiveDaysAgo = new Date(2026, 8, 12, 10, 0, 0);
+        const textFiveDaysAgo = module.formatTimeOrDate(fiveDaysAgo, now);
+
+        // 4. Overnight auto-closing (tomorrow)
+        const overnight = new Date(2026, 8, 18, 4, 0, 0);
+        const textOvernight = module.formatTimeOrDate(overnight, now);
+
+        // 5. In 3 days
+        const inThreeDays = new Date(2026, 8, 20, 15, 42, 0);
+        const textInThreeDays = module.formatTimeOrDate(inThreeDays, now);
+
+        // 6. Formats
+        const formatShort = module.formatTime(fiveDaysAgo, "%b %-d");
+        const formatStamp = module.formatTime(fiveDaysAgo, "%b %d, %Y");
+        const formatColumn = module.formatTime(fiveDaysAgo, "%A, %B %-d");
+        const formatTimeOnly = module.formatTime(twoHoursAgo, "%l:%M %p").trim();
+
+        // 7. Time ago
+        const timeAgoHours = module.formatTimeAgo(twoHoursAgo, now);
+        const timeAgoDays = module.formatTimeAgo(fiveDaysAgo, now);
+
+        // 8. Test DOM element rendering with <local-time>
+        const el = document.createElement("local-time");
+        el.setAttribute("datetime", twoHoursAgo.toISOString());
+        document.body.appendChild(el);
+
+        callback({
+          textTwoHoursAgo,
+          textLastNight,
+          textFiveDaysAgo,
+          textOvernight,
+          textInThreeDays,
+          formatShort,
+          formatStamp,
+          formatColumn,
+          formatTimeOnly,
+          timeAgoHours,
+          timeAgoDays,
+          domElementText: el.textContent,
+          domElementTitle: el.title
+        });
+      });
+    JS
+
+    assert_equal "1:42 PM", results["textTwoHoursAgo"]
+    assert_equal "yesterday", results["textLastNight"]
+    assert_equal "5 days ago", results["textFiveDaysAgo"]
+    assert_equal "tomorrow", results["textOvernight"]
+    assert_equal "in 3 days", results["textInThreeDays"]
+
+    assert_equal "Sep 12", results["formatShort"]
+    assert_equal "Sep 12, 2026", results["formatStamp"]
+    assert_equal "Saturday, September 12", results["formatColumn"]
+    assert_equal "1:42 PM", results["formatTimeOnly"]
+
+    assert_equal "2 hours ago", results["timeAgoHours"]
+    assert_equal "5 days ago", results["timeAgoDays"]
+
+    assert_not_empty results["domElementText"]
+    assert_not_empty results["domElementTitle"]
+  end
+
+  test "card page renders comments and meta with local-time" do
+    card = cards(:logo)
+    sign_in_as users(:kevin)
+
+    visit card_path(card)
+
+    assert_selector "local-time"
+    # Comment permalink contains local-time
+    assert_selector ".comment__permalink-title local-time"
+    # Check that textContent has been populated by the browser
+    comment_time = first(".comment__permalink-title local-time")
+    assert_not_empty comment_time.text
+  end
+end
