diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..b286d5c 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,63 @@
 module TimeHelper
+  def local_time(time, options = nil, &block)
+    return if time.blank?
+
+    options = format_or_options(options)
+    format = options.delete(:format)
+    type = options.delete(:type)
+
+    options[:class] = [ "local-time-value", options[:class] ].compact.join(" ")
+
+    tag.local_time(
+      block_given? ? yield : nil,
+      datetime: time.to_time.utc.iso8601,
+      format: format,
+      type: type,
+      **options
+    )
+  end
+
+  def local_date(time, options = nil, &block)
+    return if time.blank?
+
+    options = format_or_options(options)
+    options[:format] ||= "%B %-d, %Y"
+    local_time(time, options, &block)
+  end
+
+  def local_time_ago(time, options = nil, &block)
+    return if time.blank?
+
+    options = format_or_options(options)
+    options[:type] = "time-ago"
+    local_time(time, options, &block)
+  end
+
+  def local_relative_time(time, options = nil, &block)
+    return if time.blank?
+
+    options = format_or_options(options)
+    options[:type] ||= "time-or-date"
+    local_time(time, options, &block)
+  end
+
+  def time_tag(date_or_time, *args, **options, &block)
+    if block_given? || args.present?
+      super
+    else
+      local_time(date_or_time, **options)
+    end
+  end
+
+  private
+    def format_or_options(options)
+      case options
+      when Hash
+        options.dup
+      when String, Symbol
+        { format: options.to_s }
+      else
+        {}
+      end
+    end
 end
