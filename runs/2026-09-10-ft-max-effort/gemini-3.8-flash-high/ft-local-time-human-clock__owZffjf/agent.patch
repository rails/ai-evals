diff --git a/app/javascript/helpers/local_time.js b/app/javascript/helpers/local_time.js
new file mode 100644
index 0000000..a0ec7c1
--- /dev/null
+++ b/app/javascript/helpers/local_time.js
@@ -0,0 +1,229 @@
+const MONTH_NAMES = [
+  "January", "February", "March", "April", "May", "June",
+  "July", "August", "September", "October", "November", "December"
+]
+
+const SHORT_MONTH_NAMES = [
+  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
+  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
+]
+
+const DAY_NAMES = [
+  "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"
+]
+
+const SHORT_DAY_NAMES = [
+  "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"
+]
+
+const FORMAT_PRESETS = {
+  short: "%b %-d",
+  long: "%B %-d, %Y",
+  time: "%l:%M %p",
+  date: "%b %-d, %Y"
+}
+
+export function formatTime(date, format) {
+  if (FORMAT_PRESETS[format]) {
+    format = FORMAT_PRESETS[format]
+  }
+
+  const hours24 = date.getHours()
+  const hours12 = hours24 % 12 || 12
+  const ampm = hours24 < 12 ? "AM" : "PM"
+  const minutes = date.getMinutes()
+  const seconds = date.getSeconds()
+
+  return format.replace(/%([a-zA-Z%_-]+)/g, (match, flag) => {
+    switch (flag) {
+      case "A": return DAY_NAMES[date.getDay()]
+      case "a": return SHORT_DAY_NAMES[date.getDay()]
+      case "B": return MONTH_NAMES[date.getMonth()]
+      case "b": return SHORT_MONTH_NAMES[date.getMonth()]
+      case "d": return String(date.getDate()).padStart(2, "0")
+      case "-d": return String(date.getDate())
+      case "e": return String(date.getDate())
+      case "m": return String(date.getMonth() + 1).padStart(2, "0")
+      case "-m": return String(date.getMonth() + 1)
+      case "Y": return String(date.getFullYear())
+      case "y": return String(date.getFullYear()).slice(-2)
+      case "H": return String(hours24).padStart(2, "0")
+      case "-H": return String(hours24)
+      case "I": return String(hours12).padStart(2, "0")
+      case "l": return String(hours12)
+      case "M": return String(minutes).padStart(2, "0")
+      case "S": return String(seconds).padStart(2, "0")
+      case "p": return ampm
+      case "P": return ampm.toLowerCase()
+      case "%": return "%"
+      default: return match
+    }
+  })
+}
+
+export function getDayDiff(date, now = new Date()) {
+  const startOfNow = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime()
+  const startOfDate = new Date(date.getFullYear(), date.getMonth(), date.getDate()).getTime()
+  return Math.round((startOfDate - startOfNow) / (1000 * 60 * 60 * 24))
+}
+
+export function formatTimeOrDate(date, now = new Date()) {
+  const dayDiff = getDayDiff(date, now)
+
+  if (dayDiff === 0) {
+    if (date.getTime() <= now.getTime()) {
+      return formatTime(date, "%l:%M %p").trim()
+    } else {
+      return "today"
+    }
+  }
+
+  if (dayDiff === -1) {
+    return "yesterday"
+  }
+
+  if (dayDiff === 1) {
+    return "tomorrow"
+  }
+
+  if (dayDiff > 1) {
+    return `in ${dayDiff} days`
+  }
+
+  // dayDiff < -1: earlier in the week or past
+  if (dayDiff >= -6) {
+    return `${Math.abs(dayDiff)} days ago`
+  }
+
+  if (date.getFullYear() === now.getFullYear()) {
+    return formatTime(date, "%b %-d")
+  }
+
+  return formatTime(date, "%b %-d, %Y")
+}
+
+export function formatTimeAgo(date, now = new Date()) {
+  const diffInSeconds = Math.round((now.getTime() - date.getTime()) / 1000)
+
+  if (diffInSeconds < 0) {
+    const futureSeconds = -diffInSeconds
+    if (futureSeconds < 60) return "just now"
+    const minutes = Math.round(futureSeconds / 60)
+    if (minutes < 60) return `in ${minutes} ${minutes === 1 ? "minute" : "minutes"}`
+    const hours = Math.round(futureSeconds / 3600)
+    if (hours < 24) return `in ${hours} ${hours === 1 ? "hour" : "hours"}`
+    const days = Math.round(futureSeconds / 86400)
+    return `in ${days} ${days === 1 ? "day" : "days"}`
+  }
+
+  if (diffInSeconds < 60) {
+    return "just now"
+  }
+
+  const minutes = Math.round(diffInSeconds / 60)
+  if (minutes < 60) {
+    return `${minutes} ${minutes === 1 ? "minute" : "minutes"} ago`
+  }
+
+  const hours = Math.round(diffInSeconds / 3600)
+  if (hours < 24) {
+    return `${hours} ${hours === 1 ? "hour" : "hours"} ago`
+  }
+
+  const dayDiff = Math.abs(getDayDiff(date, now))
+  if (dayDiff === 1) {
+    return "yesterday"
+  }
+  if (dayDiff < 30) {
+    return `${dayDiff} days ago`
+  }
+
+  const months = Math.round(dayDiff / 30)
+  if (months < 12) {
+    return `${months} ${months === 1 ? "month" : "months"} ago`
+  }
+
+  const years = Math.round(dayDiff / 365)
+  return `${years} ${years === 1 ? "year" : "years"} ago`
+}
+
+export function formatFullDate(date) {
+  return `${formatTime(date, "%A, %B %-d, %Y")} at ${formatTime(date, "%l:%M %p").trim()}`
+}
+
+export function updateElement(el, now = new Date()) {
+  const datetime = el.getAttribute("datetime")
+  if (!datetime) return
+
+  const date = new Date(datetime)
+  if (isNaN(date.getTime())) return
+
+  const format = el.getAttribute("format")
+  const type = el.getAttribute("type")
+
+  let text
+  if (format) {
+    text = formatTime(date, format)
+  } else if (type === "time-ago") {
+    text = formatTimeAgo(date, now)
+  } else {
+    text = formatTimeOrDate(date, now)
+  }
+
+  if (text) {
+    el.textContent = text
+  }
+
+  if (!el.hasAttribute("title")) {
+    el.title = formatFullDate(date)
+  }
+}
+
+const elements = new Set()
+let timer = null
+
+export function registerElement(el) {
+  elements.add(el)
+  updateElement(el)
+  startTimer()
+}
+
+export function unregisterElement(el) {
+  elements.delete(el)
+  if (elements.size === 0) {
+    stopTimer()
+  }
+}
+
+export function updateAllElements() {
+  for (const el of elements) {
+    if (el.isConnected) {
+      updateElement(el)
+    } else {
+      elements.delete(el)
+    }
+  }
+}
+
+function startTimer() {
+  if (!timer && typeof setInterval !== "undefined") {
+    timer = setInterval(updateAllElements, 60000)
+  }
+}
+
+function stopTimer() {
+  if (timer) {
+    clearInterval(timer)
+    timer = null
+  }
+}
+
+if (typeof document !== "undefined") {
+  document.addEventListener("visibilitychange", () => {
+    if (document.visibilityState === "visible") {
+      updateAllElements()
+    }
+  })
+
+  document.addEventListener("turbo:load", updateAllElements)
+}
