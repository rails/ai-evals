diff --git a/app/javascript/initializers/local_time.js b/app/javascript/initializers/local_time.js
new file mode 100644
index 0000000..1c0fec6
--- /dev/null
+++ b/app/javascript/initializers/local_time.js
@@ -0,0 +1,23 @@
+import { registerElement, unregisterElement, updateElement } from "helpers/local_time"
+
+class LocalTimeElement extends HTMLElement {
+  static get observedAttributes() {
+    return [ "datetime", "format", "type" ]
+  }
+
+  connectedCallback() {
+    registerElement(this)
+  }
+
+  disconnectedCallback() {
+    unregisterElement(this)
+  }
+
+  attributeChangedCallback() {
+    updateElement(this)
+  }
+}
+
+if (typeof customElements !== "undefined" && !customElements.get("local-time")) {
+  customElements.define("local-time", LocalTimeElement)
+}
