+
+  NON_TENANT_TABLES = %w[
+    account_external_id_sequences
+    accounts
+    action_pack_passkeys
+    assignees_filters
+    assigners_filters
+    boards_filters
+    closers_filters
+    creators_filters
+    filters_tags
+    identities
+    identity_access_tokens
+    magic_links
+    sessions
+  ].freeze
+
+  test "every tenant table has required and indexed account_id" do
+    TENANT_TABLES.each do |table|
+      columns = ActiveRecord::Base.connection.columns(table)
+      account_id_col = columns.find { |c| c.name == "account_id" }
+
+      assert_not_nil account_id_col, "Expected #{table} to have an account_id column"
+      assert_equal false, account_id_col.null, "Expected #{table}.account_id to be NOT NULL (null: false)"
+
+      indexes = ActiveRecord::Base.connection.indexes(table)
+      has_index = indexes.any? { |idx| idx.columns == [ "account_id" ] || idx.columns.first == "account_id" }
+      assert has_index, "Expected #{table} to have an index on account_id"
+    end
+  end
+
+  test "non-tenant tables do not have account_id" do
+    NON_TENANT_TABLES.each do |table|
+      columns = ActiveRecord::Base.connection.columns(table)
+      account_id_col = columns.find { |c| c.name == "account_id" }
+
+      assert_nil account_id_col, "Expected #{table} to NOT have an account_id column"
+    end
+  end
+
+  test "tags table has account-scoped unique index on title" do
+    indexes = ActiveRecord::Base.connection.indexes("tags")
+    unique_scoped_index = indexes.find { |idx| idx.unique && idx.columns == %w[account_id title] }
+
+    assert_not_nil unique_scoped_index, "Expected tags to have a unique index on [:account_id, :title]"
+
+    title_only_index = indexes.find { |idx| idx.unique && idx.columns == %w[title] }
+    assert_nil title_only_index, "Expected tags to NOT have a unique index on [:title] alone"
+  end
+
+  test "model associations default account from context or parent record" do
+    account = accounts(:"37s")
+    board = boards(:writebook)
+    card = cards(:logo)
+    user = users(:david)
+
+    # Access
+    access = Access.new(board: board, user: user)
+    access.validate
+    assert_equal account.id, access.account_id
+
+    # Assignment
+    assignment = Assignment.new(card: card, assignee: user, assigner: user)
+    assignment.validate
+    assert_equal account.id, assignment.account_id
+
+    # Board::Publication
+    publication = Board::Publication.new(board: board)
+    publication.validate
+    assert_equal account.id, publication.account_id
+
+    # Card::ActivitySpike
+    spike = Card::ActivitySpike.new(card: card)
+    spike.validate
+    assert_equal account.id, spike.account_id
+
+    # Card::Goldness
+    goldness = Card::Goldness.new(card: card)
+    goldness.validate
+    assert_equal account.id, goldness.account_id
+
+    # Card::NotNow
+    not_now = Card::NotNow.new(card: card, user: user)
+    not_now.validate
+    assert_equal account.id, not_now.account_id
+
+    # Closure
+    closure = Closure.new(card: card, user: user)
+    closure.validate
+    assert_equal account.id, closure.account_id
+
+    # Entropy
+    entropy = Entropy.new(container: board, auto_postpone_period: 30.days.to_i)
+    entropy.validate
+    assert_equal account.id, entropy.account_id
+
+    # Mention
+    mention = Mention.new(source: card, mentioner: user, mentionee: user)
+    mention.validate
+    assert_equal account.id, mention.account_id
+
+    # Pin
+    pin = Pin.new(card: card, user: user)
+    pin.validate
+    assert_equal account.id, pin.account_id
+
+    # Reaction
+    reaction = Reaction.new(reactable: card, reacter: user, content: "👍")
+    reaction.validate
+    assert_equal account.id, reaction.account_id
+
+    # Search::Query
+    search_query = Search::Query.new(user: user, terms: "multi-tenant")
+    search_query.validate
+    assert_equal account.id, search_query.account_id
+
+    # Storage::Total
+    total = Storage::Total.new(owner: board)
+    total.validate
+    assert_equal account.id, total.account_id
+
+    # Tagging
+    tagging = Tagging.new(card: card, tag: tags(:web))
+    tagging.validate
+    assert_equal account.id, tagging.account_id
+
+    # User::Settings
+    settings = User::Settings.new(user: user)
+    settings.validate
+    assert_equal account.id, settings.account_id
+
+    # Watch
+    watch = Watch.new(card: card, user: user)
+    watch.validate
+    assert_equal account.id, watch.account_id
+
+    # Webhook::DelinquencyTracker
+    tracker = Webhook::DelinquencyTracker.new(webhook: webhooks(:active))
+    tracker.validate
+    assert_equal account.id, tracker.account_id
+
+    # Webhook::Delivery
+    delivery = Webhook::Delivery.new(webhook: webhooks(:active), event: events(:logo_published))
+    delivery.validate
+    assert_equal account.id, delivery.account_id
+  end
+
+  test "migration backfill drops orphaned rows without accounts" do
+    # Verify migration drops orphaned rows by rolling back, inserting orphans, and migrating
+    ActiveRecord::Migration.suppress_messages do
+      FinishRolloutOfAccountId.new.down
+
+      # Insert an orphaned row in accesses that has no valid board
+      orphan_id = ActiveRecord::Type::Uuid.generate
+      ActiveRecord::Base.connection.execute(
+        "INSERT INTO accesses (id, board_id, user_id, involvement, created_at, updated_at) " \
+        "VALUES ('#{orphan_id}', 'non-existent-board-id', 'non-existent-user-id', 'access_only', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)"
+      )
+
+      assert_equal 1, ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM accesses WHERE id = '#{orphan_id}'")
+
+      # Run migration up
+      FinishRolloutOfAccountId.new.up
+
+      # Orphaned row must be dropped
+      assert_equal 0, ActiveRecord::Base.connection.select_value("SELECT COUNT(*) FROM accesses WHERE id = '#{orphan_id}'")
+    end
+  end
+end
