+    SQL
+    execute <<~SQL
+      UPDATE active_storage_attachments SET account_id = (SELECT account_id FROM action_text_rich_texts WHERE action_text_rich_texts.id = active_storage_attachments.record_id) WHERE record_type = 'ActionText::RichText' AND account_id IS NULL;
+    SQL
+
+    # active_storage_blobs (from attachments)
+    execute <<~SQL
+      UPDATE active_storage_blobs SET account_id = (SELECT active_storage_attachments.account_id FROM active_storage_attachments WHERE active_storage_attachments.blob_id = active_storage_blobs.id LIMIT 1) WHERE account_id IS NULL;
+    SQL
+
+    # active_storage_variant_records (from blobs)
+    execute <<~SQL
