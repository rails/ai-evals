diff --git a/app/models/notification/bundlable.rb b/app/models/notification/bundlable.rb
new file mode 100644
index 0000000..718541a
--- /dev/null
+++ b/app/models/notification/bundlable.rb
@@ -0,0 +1,35 @@
+module Notification::Bundlable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true
+    has_many :bundle_items, class_name: "Notification::BundleItem", dependent: :destroy
+    has_many :bundles, through: :bundle_items, class_name: "Notification::Bundle"
+
+    after_save_commit :bundle_now, if: :bundlable?
+
+    alias_attribute :window_id, :bundle_id
+    alias_method :window, :bundle
+    alias_method :window=, :bundle=
+    alias_method :windows, :bundles
+  end
+
+  def bundle_later
+    Notification::BundleJob.perform_later(self)
+  end
+
+  def bundle_now
+    Notification::Bundle.add(self)
+  end
+
+  private
+    def bundlable?
+      (previously_new_record? || source_id_previously_changed?) &&
+        user.present? &&
+        user.bundle_email_frequency.present? &&
+        user.bundle_email_frequency != "never" &&
+        !creator&.system? &&
+        user.active? &&
+        account.active?
+    end
+end
diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..d2e3858
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,155 @@
+class Notification::Bundle < ApplicationRecord
+  DURATIONS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.with_indifferent_access.freeze
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :bundle_items, class_name: "Notification::BundleItem", dependent: :destroy
+  has_many :notifications, through: :bundle_items
+
+  scope :open, -> { where(delivered_at: nil) }
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :due, -> { open.where("ends_at <= ?", Time.current) }
+  scope :ordered, -> { order(starts_at: :asc) }
+
+  validates :frequency, presence: true, inclusion: { in: DURATIONS.keys }
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_at_after_starts_at
+  validate :cannot_overlap_with_existing_bundles
+
+  alias_attribute :bundle_email_frequency, :frequency
+  alias_attribute :started_at, :starts_at
+
+  class << self
+    def add(notification)
+      user = notification.user
+      return unless user
+
+      frequency = user.bundle_email_frequency
+      return if frequency == "never" || frequency.blank?
+
+      user.with_lock do
+        bundle = user.notification_bundles.open.order(starts_at: :asc).first
+
+        if bundle
+          if bundle.ends_at <= Time.current && (notification.created_at.blank? || notification.created_at > bundle.ends_at)
+            bundle.deliver_now
+            bundle = open_bundle_for(notification, user: user, frequency: frequency)
+          end
+          bundle.add(notification)
+        else
+          bundle = open_bundle_for(notification, user: user, frequency: frequency)
+          bundle.add(notification)
+        end
+
+        bundle
+      end
+    end
+
+    def duration_for(frequency)
+      DURATIONS[frequency.to_s] || 4.hours
+    end
+
+    def deliver_all_due
+      due.find_each(&:deliver_now)
+    end
+
+    private
+      def open_bundle_for(notification, user:, frequency:)
+        duration = duration_for(frequency)
+        notification_time = notification.created_at || Time.current
+        last_bundle = user.notification_bundles.order(ends_at: :desc).first
+
+        starts_at = if last_bundle && last_bundle.ends_at > notification_time
+          last_bundle.ends_at
+        else
+          notification_time
+        end
+
+        ends_at = starts_at + duration
+
+        create!(
+          account: notification.account || user.account,
+          user: user,
+          frequency: frequency,
+          starts_at: starts_at,
+          ends_at: ends_at
+        ).tap(&:schedule_delivery)
+      end
+  end
+
+  def add(notification)
+    bundle_items.find_or_create_by!(
+      account: notification.account || account,
+      notification: notification
+    )
+    notification.update_column(:bundle_id, id) if notification.has_attribute?(:bundle_id)
+  end
+
+  def schedule_delivery
+    Notification::Bundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver_now
+    return if delivered?
+    return unless user&.active? && account&.active?
+    return if user.settings&.bundle_email_frequency == "never"
+
+    notifications_to_deliver = notifications.preload(
+      :creator, :account,
+      card: [ :board, :column, :closure, :not_now ],
+      source: [ :board, :creator, { eventable: [ :closure, :board, :assignments ] } ]
+    ).to_a
+
+    if notifications_to_deliver.any?
+      Current.set(account: account, user: user) do
+        NotificationMailer.digest(self).deliver_now
+      end
+    end
+
+    update!(delivered_at: Time.current)
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliveryJob.perform_later(self)
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def open?
+    delivered_at.nil?
+  end
+
+  def duration
+    self.class.duration_for(frequency)
+  end
+
+  private
+    def ends_at_after_starts_at
+      return unless starts_at && ends_at
+
+      if ends_at <= starts_at
+        errors.add(:ends_at, "must be after starts_at")
+      end
+    end
+
+    def cannot_overlap_with_existing_bundles
+      return unless user && starts_at && ends_at
+
+      overlapping = user.notification_bundles
+        .where.not(id: id)
+        .where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+
+      if overlapping.exists?
+        errors.add(:base, "Window overlaps with an existing window")
+      end
+    end
+end
+
+Notification::Window = Notification::Bundle
