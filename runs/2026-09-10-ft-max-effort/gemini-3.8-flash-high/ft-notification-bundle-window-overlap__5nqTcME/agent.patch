+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..fc76b22
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,377 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @creator = users(:david)
+    @card = cards(:logo)
+    @other_card = cards(:layout)
+
+    @user.settings.update!(bundle_email_frequency: "never")
+    @user.notification_bundles.destroy_all
+    @user.notifications.destroy_all
+  end
+
+  test "frequencies and durations" do
+    @user.settings.bundle_email_frequency = "never"
+    assert_nil @user.settings.bundle_email_duration
+
+    @user.settings.bundle_email_frequency = "every_few_hours"
+    assert_equal 4.hours, @user.settings.bundle_email_duration
+
+    @user.settings.bundle_email_frequency = "daily"
+    assert_equal 1.day, @user.settings.bundle_email_duration
+
+    @user.settings.bundle_email_frequency = "weekly"
+    assert_equal 1.week, @user.settings.bundle_email_duration
+  end
+
+  test "when bundle_email_frequency is never, no bundle is created" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      Notification.create!(user: @user, card: @card, source: events(:logo_assignment_david), creator: @creator)
+    end
+  end
+
+  test "the clock starts when the first notification lands" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    frozen_time = Time.zone.parse("2026-05-01 10:00:00")
+
+    travel_to frozen_time do
+      notification = Notification.create!(user: @user, card: @card, source: events(:logo_assignment_david), creator: @creator)
+
+      bundle = @user.open_notification_bundle
+      assert_not_nil bundle
+      assert_equal frozen_time, bundle.starts_at
+      assert_equal frozen_time + 4.hours, bundle.ends_at
+      assert_equal "every_few_hours", bundle.frequency
+      assert_not bundle.delivered?
+      assert_includes bundle.notifications, notification
+      assert_equal bundle, notification.bundle
+    end
+  end
+
+  test "daily frequency creates 24-hour window" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+
+    frozen_time = Time.zone.parse("2026-05-01 10:00:00")
+
+    travel_to frozen_time do
+      Notification.create!(user: @user, card: @card, source: events(:logo_assignment_david), creator: @creator)
+
+      bundle = @user.open_notification_bundle
+      assert_equal frozen_time, bundle.starts_at
+      assert_equal frozen_time + 24.hours, bundle.ends_at
+    end
+  end
+
+  test "weekly frequency creates 7-day window" do
+    @user.settings.update!(bundle_email_frequency: "weekly")
+
+    frozen_time = Time.zone.parse("2026-05-01 10:00:00")
+
+    travel_to frozen_time do
+      Notification.create!(user: @user, card: @card, source: events(:logo_assignment_david), creator: @creator)
+
+      bundle = @user.open_notification_bundle
+      assert_equal frozen_time, bundle.starts_at
+      assert_equal frozen_time + 7.days, bundle.ends_at
+    end
+  end
+
+  test "multiple notifications landing in window belong to the already opened window" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    start_time = Time.zone.parse("2026-05-01 10:00:00")
+
+    travel_to start_time do
+      Notification.create!(user: @user, card: @card, source: events(:logo_assignment_david), creator: @creator)
+    end
+
+    bundle = @user.open_notification_bundle
+
+    travel_to start_time + 1.hour do
+      Notification.create!(user: @user, card: @other_card, source: events(:layout_commented), creator: @creator)
+    end
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal 2, bundle.notifications.count
+    assert_equal start_time, bundle.reload.starts_at
+    assert_equal start_time + 4.hours, bundle.ends_at
+  end
+
+  test "late-arriving notifications belong in the window that has already opened" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    start_time = Time.zone.parse("2026-05-01 10:00:00")
+
+    travel_to start_time do
+      Notification.create!(user: @user, card: @card, source: events(:logo_assignment_david), creator: @creator)
+    end
+
+    bundle = @user.open_notification_bundle
+
+    # Notification arrives at 10:30, but has timestamp 09:30 (before window started)
+    travel_to start_time + 30.minutes do
+      late_notification = Notification.create!(
+        user: @user,
+        card: @other_card,
+        source: events(:layout_commented),
+        creator: @creator,
+        created_at: start_time - 30.minutes
+      )
+
+      assert_equal 1, @user.notification_bundles.count
+      assert_includes bundle.reload.notifications, late_notification
+      assert_equal bundle, late_notification.bundle
+    end
+  end
+
+  test "late-arriving notification arriving near end of open window belongs to it" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    start_time = Time.zone.parse("2026-05-01 10:00:00")
+
+    travel_to start_time do
+      Notification.create!(user: @user, card: @card, source: events(:logo_assignment_david), creator: @creator)
+    end
+
+    bundle = @user.open_notification_bundle
+
+    # Notification arrives at 14:02 with timestamp 13:55 (before window ended, before delivery)
+    travel_to start_time + 4.hours + 2.minutes do
+      late_notification = Notification.create!(
+        user: @user,
+        card: @other_card,
+        source: events(:layout_commented),
+        creator: @creator,
+        created_at: start_time + 3.hours + 55.minutes
+      )
+
+      assert_equal 1, @user.notification_bundles.count
+      assert_includes bundle.reload.notifications, late_notification
+    end
+  end
+
+  test "nobody ever ends up with two overlapping windows" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    start_time = Time.zone.parse("2026-05-01 10:00:00")
+
+    bundle1 = Notification::Bundle.create!(
+      account: @user.account,
+      user: @user,
+      frequency: "every_few_hours",
+      starts_at: start_time,
+      ends_at: start_time + 4.hours
+    )
+
+    # Attempt to create overlapping bundle
+    overlapping_bundle = Notification::Bundle.new(
+      account: @user.account,
+      user: @user,
+      frequency: "every_few_hours",
+      starts_at: start_time + 1.hour,
+      ends_at: start_time + 5.hours
+    )
+
+    assert_not overlapping_bundle.valid?
+    assert_includes overlapping_bundle.errors[:base], "Window overlaps with an existing window"
+
+    # Adjacent bundle (starts exactly when previous ends) is valid
+    adjacent_bundle = Notification::Bundle.new(
+      account: @user.account,
+      user: @user,
+      frequency: "every_few_hours",
+      starts_at: start_time + 4.hours,
+      ends_at: start_time + 8.hours
+    )
+
+    assert adjacent_bundle.valid?
+  end
+
+  test "new window opened after previous window is delivered never overlaps" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    start_time = Time.zone.parse("2026-05-01 10:00:00")
+
+    travel_to start_time do
+      Notification.create!(user: @user, card: @card, source: events(:logo_assignment_david), creator: @creator)
+    end
+
+    bundle1 = @user.open_notification_bundle
+
+    # Deliver window 1 at 14:00
+    travel_to start_time + 4.hours do
+      bundle1.deliver_now
+    end
+
+    assert bundle1.delivered?
+
+    # Late notification arrives at 14:15 with timestamp 13:55 (before bundle1 ended)
+    travel_to start_time + 4.hours + 15.minutes do
+      notification = Notification.create!(
+        user: @user,
+        card: @other_card,
+        source: events(:layout_commented),
+        creator: @creator,
+        created_at: start_time + 3.hours + 55.minutes
+      )
+
+      bundle2 = @user.open_notification_bundle
+      assert_not_nil bundle2
+      assert_not_equal bundle1.id, bundle2.id
+      # Starts at bundle1.ends_at (14:00), never overlapping
+      assert_equal bundle1.ends_at, bundle2.starts_at
+      assert_equal bundle1.ends_at + 4.hours, bundle2.ends_at
+    end
+  end
+
+  test "send one email per window" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    start_time = Time.zone.parse("2026-05-01 10:00:00")
+
+    travel_to start_time do
+      Notification.create!(user: @user, card: @card, source: events(:logo_assignment_david), creator: @creator)
+      Notification.create!(user: @user, card: @other_card, source: events(:layout_commented), creator: @creator)
+    end
+
+    bundle = @user.open_notification_bundle
+    assert_equal 2, bundle.notifications.count
+
+    # Time travels to end of window
+    travel_to start_time + 4.hours do
+      assert_emails 1 do
+        bundle.deliver_now
+      end
+
+      assert bundle.reload.delivered?
+      assert_not_nil bundle.delivered_at
+    end
+
+    # Delivering again does not send duplicate email
+    travel_to start_time + 4.hours + 1.minute do
+      assert_emails 0 do
+        bundle.deliver_now
+      end
+    end
+  end
+
+  test "delivery does not send email if user turned frequency to never" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    start_time = Time.zone.parse("2026-05-01 10:00:00")
+
+    travel_to start_time do
+      Notification.create!(user: @user, card: @card, source: events(:logo_assignment_david), creator: @creator)
+    end
+
+    bundle = @user.open_notification_bundle
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    travel_to start_time + 4.hours do
+      assert_emails 0 do
+        bundle.deliver_now
+      end
+    end
+  end
+
+  test "deliver_all_due processes past-due bundles" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    start_time = Time.zone.parse("2026-05-01 10:00:00")
+
+    travel_to start_time do
+      Notification.create!(user: @user, card: @card, source: events(:logo_assignment_david), creator: @creator)
+    end
+
+    travel_to start_time + 4.hours + 1.minute do
+      assert_emails 1 do
+        Notification::Bundle.deliver_all_due
+      end
+
+      assert @user.notification_bundles.first.delivered?
+    end
+  end
+
+  test "multiple events on same card in same window update notification without duplicates" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    card = cards(:logo)
+    card.watch_by(@user)
+
+    start_time = Time.zone.parse("2026-05-01 10:00:00")
+
+    travel_to start_time do
+      perform_enqueued_jobs only: [ NotifyRecipientsJob ] do
+        card.comments.create!(body: "First comment", creator: @creator)
+      end
+    end
+
+    bundle = @user.open_notification_bundle
+    assert_equal 1, bundle.notifications.count
+
+    travel_to start_time + 1.hour do
+      perform_enqueued_jobs only: [ NotifyRecipientsJob ] do
+        card.comments.create!(body: "Second comment", creator: @creator)
+      end
+    end
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal 1, bundle.reload.notifications.count
+    assert_equal 2, bundle.notifications.first.unread_count
+  end
+
+  test "scheduled delivery job delivers email at end of window" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    card = cards(:logo)
+    card.watch_by(@user)
+
+    start_time = Time.zone.parse("2026-05-01 10:00:00")
+
+    travel_to start_time do
+      perform_enqueued_jobs only: [ NotifyRecipientsJob ] do
+        card.comments.create!(body: "Test comment", creator: @creator)
+      end
+    end
+
+    bundle = @user.open_notification_bundle
+    assert_not bundle.delivered?
+
+    travel_to start_time + 4.hours do
+      assert_emails 1 do
+        perform_enqueued_jobs only: [ Notification::Bundle::DeliveryJob ]
+      end
+
+      assert bundle.reload.delivered?
+      assert_not_nil bundle.delivered_at
+    end
+  end
+
+  test "rapid notifications reuse open window and do not create overlapping windows" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    card1 = cards(:logo)
+    card2 = cards(:layout)
+    card3 = cards(:shipping)
+
+    [ card1, card2, card3 ].each { |c| c.watch_by(@user) }
+
+    perform_enqueued_jobs only: [ NotifyRecipientsJob ] do
+      card1.comments.create!(body: "Comment 1", creator: @creator)
+      card2.comments.create!(body: "Comment 2", creator: @creator)
+      card3.comments.create!(body: "Comment 3", creator: @creator)
+    end
+
+    bundles = @user.notification_bundles.reload
+    assert_equal 1, bundles.count
+    assert_equal 3, bundles.first.notifications.count
+  end
+end
