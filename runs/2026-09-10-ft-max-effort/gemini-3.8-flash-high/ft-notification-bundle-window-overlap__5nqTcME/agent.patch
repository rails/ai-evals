diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..21563c2
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,34 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle_or_user, notifications = nil)
+    if bundle_or_user.is_a?(User)
+      @user = bundle_or_user
+      @account = @user.account
+      @notifications = notifications || @user.notifications.none
+      @bundle = nil
+    else
+      @bundle = bundle_or_user
+      @user = @bundle.user
+      @account = @bundle.account
+      @notifications = notifications || @bundle.notifications
+    end
+
+    Current.set(account: @account, user: @user) do
+      mail(
+        to: @user.identity.email_address,
+        subject: digest_subject
+      )
+    end
+  end
+
+  alias_method :bundle_email, :digest
+
+  private
+    def digest_subject
+      count = @notifications.respond_to?(:count) ? @notifications.count : @notifications.size
+      if count == 1
+        "Notification digest: 1 new notification"
+      else
+        "Notification digest: #{count} new notifications"
+      end
+    end
+end
