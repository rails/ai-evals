diff --git a/test/mailers/notification_mailer_test.rb b/test/mailers/notification_mailer_test.rb
new file mode 100644
index 0000000..7bb88ad
--- /dev/null
+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @creator = users(:david)
+    @card = cards(:logo)
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "digest email sent with bundle" do
+    bundle = Notification::Bundle.create!(
+      account: @user.account,
+      user: @user,
+      frequency: "every_few_hours",
+      starts_at: 4.hours.ago,
+      ends_at: Time.current
+    )
+    bundle.add(@notification)
+
+    email = NotificationMailer.digest(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match(/Notification digest/i, email.subject)
+    assert_match ERB::Util.html_escape(@card.title), email.html_part.body.to_s
+    assert_match @card.title, email.text_part.body.to_s
+  end
+
+  test "digest email sent with user and notifications" do
+    email = NotificationMailer.digest(@user, [ @notification ])
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match(/Notification digest/i, email.subject)
+    assert_match ERB::Util.html_escape(@card.title), email.html_part.body.to_s
+    assert_match @card.title, email.text_part.body.to_s
+  end
+end
