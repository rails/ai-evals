diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..adc2b98 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,42 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def api_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: extracted_assignee_ids }
+    when "card_board_changed"
+      {
+        old_board: (extracted_particular("old_board") || extracted_particular("old_collection")).to_s,
+        new_board: (extracted_particular("new_board") || extracted_particular("new_collection")).to_s
+      }
+    when "card_title_changed"
+      {
+        old_title: extracted_particular("old_title").to_s,
+        new_title: extracted_particular("new_title").to_s
+      }
+    when "card_triaged"
+      {
+        column: extracted_particular("column").to_s
+      }
+    else
+      {}
+    end
+  end
+
+  private
+    def extracted_particulars
+      hash = particulars.is_a?(Hash) ? particulars : {}
+      hash = hash["particulars"] || hash[:particulars] if (hash["particulars"] || hash[:particulars]).is_a?(Hash)
+      hash.is_a?(Hash) ? hash : {}
+    end
+
+    def extracted_particular(key)
+      extracted_particulars[key.to_s] || extracted_particulars[key.to_sym]
+    end
+
+    def extracted_assignee_ids
+      assignee_ids || extracted_particulars["assignee_ids"] || extracted_particulars[:assignee_ids] || []
+    end
 end
