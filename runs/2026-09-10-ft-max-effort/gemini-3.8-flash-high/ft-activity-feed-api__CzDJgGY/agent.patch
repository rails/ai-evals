+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns account activities as JSON" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    assert_kind_of Array, @response.parsed_body
+    assert_operator @response.parsed_body.size, :>, 0
+
+    first_activity = @response.parsed_body.first
+    assert_equal %w[
+      action
+      board
+      created_at
+      creator
+      description
+      eventable
+      eventable_type
+      id
+      particulars
+      url
+    ].sort, first_activity.keys.sort
+  end
+
+  test "request via explicit account slug path" do
+    untenanted do
+      get "#{accounts("37s").slug}/activities.json"
+    assert_response :success
+      assert_kind_of Array, @response.parsed_body
+    end
+  end
+
+  test "returns newest activity first" do
+    get activities_path(format: :json)
+    assert_response :success
+
+    created_at_timestamps = @response.parsed_body.map { |a| Time.iso8601(a["created_at"]) }
+    assert_equal created_at_timestamps, created_at_timestamps.sort.reverse
+  end
+
+  test "omits card_collection_changed events" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_collection_changed")
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    assert_not_includes @response.parsed_body.map { |a| a["id"] }, event.id
+  end
+
+  test "includes card_title_changed events" do
+    event = events(:logo_published)
+    event.update_columns(
+      action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old Title", "new_title" => "New Title" } }
+    )
+
+    get activities_path(format: :json)
+    assert_response :success
+
+    activity = @response.parsed_body.find { |a| a["id"] == event.id }
+    assert_not_nil activity
+    assert_equal "card_title_changed", activity["action"]
+    assert_equal({ "old_title" => "Old Title", "new_title" => "New Title" }, activity["particulars"])
