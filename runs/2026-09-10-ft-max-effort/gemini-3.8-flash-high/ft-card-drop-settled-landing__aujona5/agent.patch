diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..0fd253e
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,267 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+    @in_progress_column = @board.columns.find_by!(name: "In progress")
+    @review_column = @board.columns.find_by!(name: "Review")
+    @triage_column = @board.columns.find_by!(name: "Triage")
+  end
+
+  test "dragging a card to another column moves it instantly and persists" do
+    card = cards(:logo) # In "Triage"
+
+    visit board_url(@board)
+    expand_column(@triage_column)
+    assert_selector "##{dom_id(@triage_column)} ##{dom_id(card, :article)}"
+
+    # Drag card from Triage to Review
+    drag_card(card, to: @review_column)
+
+    # Expand Review column to see the card
+    expand_column(@review_column)
+    assert_selector "##{dom_id(@review_column)} ##{dom_id(card, :article)}"
+    assert_no_selector "##{dom_id(@triage_column)} ##{dom_id(card, :article)}"
+
+    # Check that column name badge updated in header
+    within "##{dom_id(@review_column)} ##{dom_id(card, :article)}" do
+      assert_selector ".card__header .card__column-name", text: "Review", visible: :all
+    end
+
+    # Reload page to verify persistence
+    visit board_url(@board)
+    assert_equal @review_column, card.reload.column
+  end
+
+  test "dragging a card to Not Now postpones it" do
+    card = cards(:logo)
+
+    visit board_url(@board)
+    expand_column(@triage_column)
+    assert_selector "##{dom_id(@triage_column)} ##{dom_id(card, :article)}"
+
+    drag_card(card, to: "not-now")
+
+    expand_column("not-now")
+    assert_selector "#not-now ##{dom_id(card, :article)}"
+    assert_no_selector "##{dom_id(@triage_column)} ##{dom_id(card, :article)}"
+
+    visit board_url(@board)
+    assert card.reload.postponed?
+  end
+
+  test "dragging a card to Done closes it" do
+    card = cards(:logo)
+
+    visit board_url(@board)
+    expand_column(@triage_column)
+    assert_selector "##{dom_id(@triage_column)} ##{dom_id(card, :article)}"
+
+    drag_card(card, to: "closed-cards")
+
+    expand_column("closed-cards")
+    assert_selector "#closed-cards ##{dom_id(card, :article)}"
+    assert_no_selector "##{dom_id(@triage_column)} ##{dom_id(card, :article)}"
+
+    visit board_url(@board)
+    assert card.reload.closed?
+  end
+
+  test "dragging a card to Maybe sends it back to triage" do
+    card = cards(:logo)
+
+    visit board_url(@board)
+    expand_column(@triage_column)
+    assert_selector "##{dom_id(@triage_column)} ##{dom_id(card, :article)}"
+
+    drag_card(card, to: "maybe")
+
+    # Maybe is expanded by default on desktop
+    assert_selector "#maybe ##{dom_id(card, :article)}"
+    assert_no_selector "##{dom_id(@triage_column)} ##{dom_id(card, :article)}"
+
+    visit board_url(@board)
+    assert card.reload.awaiting_triage?
+  end
+
+  test "dragging within the same column does nothing" do
+    card = cards(:logo)
+
+    visit board_url(@board)
+    expand_column(@triage_column)
+    assert_selector "##{dom_id(@triage_column)} ##{dom_id(card, :article)}"
+
+    drag_card(card, to: @triage_column)
+
+    assert_selector "##{dom_id(@triage_column)} ##{dom_id(card, :article)}"
+    assert_equal @triage_column, card.reload.column
+  end
+
+  test "dragging card dims the dragged card and lights up the target column" do
+    card = cards(:logo)
+
+    visit board_url(@board)
+    expand_column(@triage_column)
+
+    # Verify dragstart adds dragged item class
+    card_element = find("##{dom_id(card, :article)}")
+    target_element = find("##{dom_id(@review_column)}")
+
+    page.execute_script(<<~JS, card_element, target_element)
+      const [source, target] = arguments;
+      window.__dndDataTransfer = new DataTransfer();
+      source.dispatchEvent(new DragEvent('dragstart', { bubbles: true, cancelable: true, dataTransfer: window.__dndDataTransfer }));
+      target.dispatchEvent(new DragEvent('dragenter', { bubbles: true, cancelable: true, dataTransfer: window.__dndDataTransfer }));
+      target.dispatchEvent(new DragEvent('dragover', { bubbles: true, cancelable: true, dataTransfer: window.__dndDataTransfer }));
+    JS
+
+    # Verify dragged item dimmed and column lights up
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item"
+    assert_selector "##{dom_id(@review_column)}.drag-and-drop__hover-container"
+
+    # Finish drag
+    page.execute_script(<<~JS, card_element, target_element)
+      const [source, target] = arguments;
+      target.dispatchEvent(new DragEvent('drop', { bubbles: true, cancelable: true, dataTransfer: window.__dndDataTransfer }));
+      source.dispatchEvent(new DragEvent('dragend', { bubbles: true, cancelable: true, dataTransfer: window.__dndDataTransfer }));
+    JS
+
+    assert_no_selector ".drag-and-drop__dragged-item"
+    assert_no_selector ".drag-and-drop__hover-container"
+
+    expand_column(@review_column)
+    assert_selector "##{dom_id(@review_column)} ##{dom_id(card, :article)}"
+  end
+
+  test "dragging a non-golden card into a column with golden cards places it after golden cards" do
+    golden_card = cards(:logo) # Golden, in Triage
+    non_golden_card = cards(:text) # Non-golden, in "In progress"
+
+    visit board_url(@board)
+    expand_column(@in_progress_column)
+
+    # Drag non-golden card to Triage
+    drag_card(non_golden_card, to: @triage_column)
+
+    expand_column(@triage_column)
+
+    # Verify order in DOM: golden card is first, then non_golden_card
+    cards_in_triage = page.all("##{dom_id(@triage_column)} .card").map { |el| el[:id] }
+    assert_equal dom_id(golden_card, :article), cards_in_triage.first
+    assert_includes cards_in_triage, dom_id(non_golden_card, :article)
+    assert cards_in_triage.index(dom_id(golden_card, :article)) < cards_in_triage.index(dom_id(non_golden_card, :article))
+  end
+
+  test "dragging a golden card into a column places it at the very top" do
+    golden_card = cards(:logo) # Golden, in Triage
+    regular_card = cards(:text) # in In progress
+
+    visit board_url(@board)
+    expand_column(@triage_column)
+
+    drag_card(golden_card, to: @in_progress_column)
+
+    expand_column(@in_progress_column)
+
+    cards_in_progress = page.all("##{dom_id(@in_progress_column)} .card").map { |el| el[:id] }
+    assert_equal dom_id(golden_card, :article), cards_in_progress.first
+  end
+
+  test "dragging a card from Done to a column reopens and moves it" do
+    card = cards(:logo)
+    card.close(user: users(:david))
+
+    visit board_url(@board)
+    expand_column("closed-cards")
+    assert_selector "#closed-cards ##{dom_id(card, :article)}"
+
+    drag_card(card, to: @review_column)
+
+    expand_column(@review_column)
+    assert_selector "##{dom_id(@review_column)} ##{dom_id(card, :article)}"
+    assert_no_selector "#closed-cards ##{dom_id(card, :article)}"
+
+    visit board_url(@board)
+    assert_equal @review_column, card.reload.column
+    assert card.open?
+  end
+
+  test "dragging to an empty column displays cards and hides blank slate" do
+    card = cards(:logo)
+
+    visit board_url(@board)
+    expand_column(@review_column) # Review is empty
+    assert_selector "##{dom_id(@review_column)} .blank-slate--drag"
+
+    expand_column(@triage_column)
+    drag_card(card, to: @review_column)
+
+    expand_column(@review_column)
+    assert_selector "##{dom_id(@review_column)} ##{dom_id(card, :article)}"
+    assert_no_selector "##{dom_id(@review_column)} .blank-slate--drag"
+  end
+
+  test "dragging the last card out of a column shows the blank slate in source column" do
+    card = cards(:text) # The only card in "In progress"
+
+    visit board_url(@board)
+    expand_column(@in_progress_column)
+    assert_no_selector "##{dom_id(@in_progress_column)} .blank-slate--drag"
+
+    drag_card(card, to: @review_column)
+
+    expand_column(@in_progress_column)
+    assert_selector "##{dom_id(@in_progress_column)} .blank-slate--drag"
+  end
+
+  test "dragging a card from Not Now to a column moves and activates it" do
+    card = cards(:logo)
+    card.postpone(user: users(:david))
+
+    visit board_url(@board)
+    expand_column("not-now")
+    assert_selector "#not-now ##{dom_id(card, :article)}"
+
+    drag_card(card, to: @review_column)
+
+    expand_column(@review_column)
+    assert_selector "##{dom_id(@review_column)} ##{dom_id(card, :article)}"
+    assert_no_selector "#not-now ##{dom_id(card, :article)}"
+
+    visit board_url(@board)
+    assert_equal @review_column, card.reload.column
+    assert card.active?
+  end
+
+  private
+    def expand_column(column)
+      col_id = column.is_a?(String) ? column : dom_id(column)
+      col = find("##{col_id}")
+      if col[:class].include?("is-collapsed")
+        find("##{col_id} .cards__expander").click
+        assert_selector "##{col_id}.is-expanded"
+      end
+    end
+
+    def drag_card(card, to:)
+      source_selector = "##{dom_id(card, :article)}"
+      target_selector = to.is_a?(String) ? "##{to}" : "##{dom_id(to)}"
+
+      source = find(source_selector, visible: :all)
+      target = find(target_selector, visible: :all)
+
+      page.execute_script(<<~JS, source, target)
+        const [source, target] = arguments;
+        const dataTransfer = new DataTransfer();
+
+        source.dispatchEvent(new DragEvent('dragstart', { bubbles: true, cancelable: true, dataTransfer: dataTransfer }));
+        target.dispatchEvent(new DragEvent('dragenter', { bubbles: true, cancelable: true, dataTransfer: dataTransfer }));
+        target.dispatchEvent(new DragEvent('dragover', { bubbles: true, cancelable: true, dataTransfer: dataTransfer }));
+        target.dispatchEvent(new DragEvent('drop', { bubbles: true, cancelable: true, dataTransfer: dataTransfer }));
+        source.dispatchEvent(new DragEvent('dragend', { bubbles: true, cancelable: true, dataTransfer: dataTransfer }));
+      JS
+    end
+end
