diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..945df1c
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,242 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  connect() {
+    this.draggedCard = null
+    this.sourceColumn = null
+    this.currentHoverColumn = null
+  }
+
+  dragstart(event) {
+    const card = event.target.closest(".card")
+    if (!card || !this.element.contains(card)) return
+
+    this.draggedCard = card
+    this.sourceColumn = card.closest(".cards")
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+
+    setTimeout(() => {
+      if (this.draggedCard) {
+        this.draggedCard.classList.add(this.#draggedItemClass)
+      }
+    }, 0)
+  }
+
+  dragover(event) {
+    const column = event.target.closest(".cards")
+    if (!this.draggedCard || !column || !this.element.contains(column)) return
+    if (column === this.sourceColumn) return
+
+    event.preventDefault()
+    event.dataTransfer.dropEffect = "move"
+
+    if (this.currentHoverColumn !== column) {
+      this.#setHoverColumn(column)
+    }
+  }
+
+  dragenter(event) {
+    const column = event.target.closest(".cards")
+    if (!this.draggedCard || !column || !this.element.contains(column)) return
+    if (column === this.sourceColumn) return
+
+    event.preventDefault()
+    this.#setHoverColumn(column)
+  }
+
+  dragleave(event) {
+    const column = event.target.closest(".cards")
+    if (!column) return
+
+    if (!column.contains(event.relatedTarget)) {
+      column.classList.remove(this.#hoverContainerClass)
+      if (this.currentHoverColumn === column) {
+        this.currentHoverColumn = null
+      }
+    }
+  }
+
+  dragend() {
+    if (this.draggedCard) {
+      this.draggedCard.classList.remove(this.#draggedItemClass)
+    }
+    this.#clearHoverContainers()
+    this.draggedCard = null
+    this.sourceColumn = null
+    this.currentHoverColumn = null
+  }
+
+  async drop(event) {
+    const column = event.target.closest(".cards")
+    if (!this.draggedCard || !column || !this.element.contains(column)) return
+
+    this.#clearHoverContainers()
+
+    if (column === this.sourceColumn) {
+      this.dragend()
+      return
+    }
+
+    event.preventDefault()
+
+    const card = this.draggedCard
+    const sourceColumn = this.sourceColumn
+    const targetColumn = column
+
+    card.classList.remove(this.#draggedItemClass)
+    this.draggedCard = null
+    this.sourceColumn = null
+    this.currentHoverColumn = null
+
+    this.#moveCardOptimistically(card, sourceColumn, targetColumn)
+
+    try {
+      await this.#saveCardPlacement(card, targetColumn)
+    } catch (error) {
+      console.error("Failed to save card placement:", error)
+      this.#moveCardOptimistically(card, targetColumn, sourceColumn)
+    }
+  }
+
+  // Private
+
+  get #draggedItemClass() {
+    return this.hasDraggedItemClass ? this.draggedItemClass : "drag-and-drop__dragged-item"
+  }
+
+  get #hoverContainerClass() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : "drag-and-drop__hover-container"
+  }
+
+  #setHoverColumn(column) {
+    if (this.currentHoverColumn && this.currentHoverColumn !== column) {
+      this.currentHoverColumn.classList.remove(this.#hoverContainerClass)
+    }
+    this.currentHoverColumn = column
+    column.classList.add(this.#hoverContainerClass)
+  }
+
+  #clearHoverContainers() {
+    this.element.querySelectorAll(`.${this.#hoverContainerClass}`).forEach(el => {
+      el.classList.remove(this.#hoverContainerClass)
+    })
+  }
+
+  #moveCardOptimistically(card, sourceColumn, targetColumn) {
+    this.#insertCardIntoColumn(card, targetColumn)
+    this.#updateCardAppearance(card, targetColumn)
+    this.#updateExpanderCount(sourceColumn, -1)
+    this.#updateExpanderCount(targetColumn, 1)
+  }
+
+  #insertCardIntoColumn(card, targetColumn) {
+    const isGolden = card.classList.contains("golden-effect")
+    const existingCards = Array.from(targetColumn.querySelectorAll(".card")).filter(c => c !== card)
+
+    if (targetColumn.id === "not-now" || targetColumn.id === "closed-cards") {
+      if (existingCards.length > 0) {
+        existingCards[0].before(card)
+      } else {
+        this.#targetListContainer(targetColumn).prepend(card)
+      }
+    } else {
+      if (isGolden) {
+        if (existingCards.length > 0) {
+          existingCards[0].before(card)
+        } else {
+          this.#targetListContainer(targetColumn).prepend(card)
+        }
+      } else {
+        const goldenCards = Array.from(targetColumn.querySelectorAll(".card.golden-effect")).filter(c => c !== card)
+        if (goldenCards.length > 0) {
+          goldenCards[goldenCards.length - 1].after(card)
+        } else if (existingCards.length > 0) {
+          existingCards[0].before(card)
+        } else {
+          this.#targetListContainer(targetColumn).prepend(card)
+        }
+      }
+    }
+  }
+
+  #targetListContainer(column) {
+    return column.querySelector("[id$='-pagination-contents-1']") ||
+           column.querySelector("[id$='-pagination-list']") ||
+           column.querySelector(".cards__list")
+  }
+
+  #updateCardAppearance(card, targetColumn) {
+    const header = card.querySelector(".card__header")
+    const existingBadge = card.querySelector(".card__header .card__column-name")
+
+    if (targetColumn.dataset.columnId) {
+      const columnName = targetColumn.dataset.columnName
+      if (existingBadge) {
+        const textEl = existingBadge.querySelector(".overflow-ellipsis") || existingBadge
+        textEl.textContent = columnName
+      } else if (header) {
+        const badge = document.createElement("span")
+        badge.className = "btn justify-start card__column-name card__column-name--current txt-uppercase min-width max-width"
+        badge.innerHTML = `<span class="overflow-ellipsis">${columnName}</span>`
+        header.appendChild(badge)
+      }
+    } else {
+      if (existingBadge) {
+        existingBadge.remove()
+      }
+    }
+
+    const stages = card.querySelectorAll(".card__stages .card__column-name")
+    stages.forEach(stage => {
+      const isCurrent = targetColumn.dataset.columnId && stage.textContent.trim() === targetColumn.dataset.columnName?.trim()
+      stage.classList.toggle("card__column-name--current", Boolean(isCurrent))
+    })
+
+    if (targetColumn.id === "not-now") {
+      card.classList.add("card--postponed")
+      card.classList.remove("card--active")
+    } else if (targetColumn.id === "closed-cards") {
+      card.classList.remove("card--active", "card--postponed")
+    } else {
+      card.classList.add("card--active")
+      card.classList.remove("card--postponed")
+    }
+  }
+
+  #updateExpanderCount(column, delta) {
+    const countEl = column.querySelector(".cards__expander-count")
+    if (!countEl) return
+
+    const text = countEl.textContent.trim()
+    if (text.includes("+")) return
+
+    const count = parseInt(text, 10)
+    if (!isNaN(count)) {
+      countEl.textContent = Math.max(0, count + delta)
+    }
+  }
+
+  async #saveCardPlacement(card, targetColumn) {
+    const triageUrl = card.dataset.cardTriageUrl
+    const notNowUrl = card.dataset.cardNotNowUrl
+    const closureUrl = card.dataset.cardClosureUrl
+
+    if (targetColumn.id === "not-now") {
+      await post(notNowUrl, { responseKind: "json" })
+    } else if (targetColumn.id === "closed-cards") {
+      await post(closureUrl, { responseKind: "json" })
+    } else if (targetColumn.id === "maybe") {
+      await destroy(triageUrl, { responseKind: "json" })
+    } else if (targetColumn.dataset.columnId) {
+      await post(triageUrl, {
+        body: { column_id: targetColumn.dataset.columnId },
+        responseKind: "json"
+      })
+    }
+  }
+}
