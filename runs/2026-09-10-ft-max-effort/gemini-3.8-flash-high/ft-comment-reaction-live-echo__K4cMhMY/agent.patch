new file mode 100644
index 0000000..db0ea61
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    @comment = comments(:logo_agreement_kevin)
+    @user = users(:kevin)
+  end
+
+  test "valid reaction creation" do
+    reaction = @comment.reactions.create!(reacter: @user, content: "👍")
+    assert_equal @comment.account, reaction.account
+    assert_equal @user, reaction.reacter
+    assert_equal "👍", reaction.content
+    assert reaction.emoji_only?
+  end
+
+  test "validates presence of content" do
+    reaction = @comment.reactions.build(reacter: @user, content: "")
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "validates length at most 16 characters" do
+    reaction = @comment.reactions.build(reacter: @user, content: "1234567890123456")
+    assert reaction.valid?
+
+    reaction.content = "12345678901234567"
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "normalizes content by stripping whitespace" do
+    reaction = @comment.reactions.create!(reacter: @user, content: "  hello  ")
+    assert_equal "hello", reaction.content
+  end
+
+  test "emoji_only? detection" do
+    assert Reaction.new(content: "👍").emoji_only?
+    assert Reaction.new(content: "🎉").emoji_only?
+    assert Reaction.new(content: "❤️").emoji_only?
+    assert Reaction.new(content: "👏").emoji_only?
+    assert_not Reaction.new(content: "hello").emoji_only?
+    assert_not Reaction.new(content: "👍 hello").emoji_only?
+    assert_not Reaction.new(content: "123").emoji_only?
+  end
+
+  test "destroying comment destroys its reactions" do
+    reaction = @comment.reactions.create!(reacter: @user, content: "🚀")
+    reactions_count = @comment.reactions.count
+    assert_difference -> { Reaction.count }, -reactions_count do
+      @comment.destroy
+    end
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "touching comment and card when reaction is created and destroyed" do
+    card = @comment.card
+    comment_time = @comment.updated_at
+    card_time = card.updated_at
+
+    reaction = nil
+    travel 1.second do
+      reaction = @comment.reactions.create!(reacter: @user, content: "🔥")
+    end
+    assert_operator @comment.reload.updated_at, :>, comment_time
+    assert_operator card.reload.updated_at, :>, card_time
+
+    comment_time = @comment.updated_at
+    card_time = card.updated_at
+
+    travel 2.seconds do
+      reaction.destroy
+    end
+    assert_operator @comment.reload.updated_at, :>, comment_time
+    assert_operator card.reload.updated_at, :>, card_time
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..a11761c
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,137 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "adding a reaction to a comment" do
+    sign_in_as users(:kevin)
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      # Initial state: trigger button is visible, form is hidden
+      trigger = find(".reactions__trigger")
+      assert trigger.visible?
+
+      # Clicking trigger turns into small input with confirm and cancel
+      trigger.click
+      assert_no_selector ".reactions__trigger", visible: true
+      assert_selector ".reaction__form", visible: true
+
+      # Canceling brings trigger back
+      find(".reaction__cancel-btn").click
+      assert_selector ".reactions__trigger", visible: true
+      assert_no_selector ".reaction__form", visible: true
+
+      # Open again and confirm a reaction
+      find(".reactions__trigger").click
+      fill_in "Reaction", with: "🔥"
+      find(".reaction__submit-btn").click
+
+      # Confirming puts reaction right there in the strip, input is gone, button is back
+      assert_selector ".reaction", text: "🔥"
+      assert_selector ".reactions__trigger", visible: true
+      assert_no_selector ".reaction__form", visible: true
+    end
+  end
+
+  test "canceling reaction input with Escape key" do
+    sign_in_as users(:kevin)
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find(".reactions__trigger").click
+      assert_selector ".reaction__form", visible: true
+
+      find(".reaction__input").send_keys :escape
+
+      assert_selector ".reactions__trigger", visible: true
+      assert_no_selector ".reaction__form", visible: true
+    end
+  end
+
+  test "adding multiple reactions in sequence" do
+    sign_in_as users(:kevin)
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      # Add first reaction
+      find(".reactions__trigger").click
+      fill_in "Reaction", with: "🎉"
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "🎉"
+      assert_selector ".reactions__trigger", visible: true
+
+      # Add second reaction
+      find(".reactions__trigger").click
+      fill_in "Reaction", with: "❤️"
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "🎉"
+      assert_selector ".reaction", text: "❤️"
+      assert_selector ".reactions__trigger", visible: true
+    end
+  end
+
+  test "clicking own reaction reveals a way to remove it" do
+    sign_in_as users(:kevin)
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      reaction_el = find(".reaction", text: "👍")
+
+      # Initially delete button is not visible
+      assert_no_selector ".reaction__delete", visible: true
+
+      # Clicking own reaction reveals delete button
+      reaction_el.click
+      assert_selector ".reaction__delete", visible: true
+
+      # Clicking delete removes the reaction
+      within reaction_el do
+        find(".reaction__delete button").click
+      end
+
+      assert_no_selector ".reaction", text: "👍"
+    end
+  end
+
+  test "clicking another user's reaction does not reveal a way to remove it" do
+    sign_in_as users(:david)
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      reaction_el = find(".reaction", text: "👍")
+
+      # Clicking Kevin's reaction as David does not reveal delete
+      reaction_el.click
+      assert_no_selector ".reaction__delete", visible: true
+    end
+  end
+
+  test "reactions broadcast in real-time without reloading" do
+    sign_in_as users(:david)
+    visit card_url(@card)
+
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+    assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+
+    within "##{dom_id(@comment, :reactions)}" do
+      assert_no_selector ".reaction", text: "🚀"
+    end
+
+    # Kevin reacts elsewhere
+    @comment.reactions.create!(reacter: users(:kevin), content: "🚀")
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    # David sees reaction land without reloading
+    within "##{dom_id(@comment, :reactions)}" do
+      assert_selector ".reaction", text: "🚀", wait: 5
+    end
+  end
+end
