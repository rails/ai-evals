diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..29e552d
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+    assert_response :success
+    assert_equal @comment.reactions.count, @response.parsed_body.count
+    assert_equal "👍", @response.parsed_body.first["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.first["reacter"]["id"]
+  end
+
+  test "create as turbo_stream" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment),
+        params: { reaction: { content: "🎉" } },
+        as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = @comment.reactions.last
+    assert_equal "🎉", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+    assert_match dom_id(@comment, :reactions), @response.body
+    assert_match "🎉", @response.body
+  end
+
+  test "create as JSON with wrapped params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment),
+        params: { reaction: { content: "🙌" } },
+        as: :json
+    end
+
+    assert_response :created
+    json = @response.parsed_body
+    assert_equal "🙌", json["content"]
+    assert_equal users(:kevin).id, json["reacter"]["id"]
+    assert_equal card_comment_reaction_path(@card, @comment, @comment.reactions.last, format: :json), @response.headers["Location"]
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment),
+        params: { content: "🚀" },
+        as: :json
+    end
+
+    assert_response :created
+    assert_equal "🚀", @response.parsed_body["content"]
+  end
+
+  test "create with maximum 16 characters succeeds" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment),
+        params: { reaction: { content: "1234567890123456" } },
+        as: :json
+    end
+
+    assert_response :created
+    assert_equal "1234567890123456", @comment.reactions.last.content
+  end
+
+  test "create on draft card is forbidden" do
+    card = cards(:logo)
+    comment = card.comments.create!(creator: users(:kevin), body: "A comment")
+    card.update_columns(status: "drafted")
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(card, comment),
+        params: { reaction: { content: "👍" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy as turbo_stream by reacter" do
+    reaction = reactions(:logo_kevin_thumbs_up)
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_not Reaction.exists?(reaction.id)
+    assert_match dom_id(@comment, :reactions), @response.body
+  end
+
+  test "destroy as JSON by reacter" do
+    reaction = reactions(:logo_kevin_thumbs_up)
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy by another user is forbidden" do
+    reaction = reactions(:logo_jz_celebration)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+    assert Reaction.exists?(reaction.id)
+  end
+
+  test "can add multiple reactions to the same comment" do
+    assert_difference -> { @comment.reactions.count }, +2 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "❤️" } }, as: :turbo_stream
+      assert_response :success
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "✨" } }, as: :turbo_stream
+      assert_response :success
+    end
+  end
+
+  test "comment JSON includes reactions_url" do
+    get card_comment_path(@card, @comment), as: :json
+    assert_response :success
+    assert_equal card_comment_reactions_url(@card, @comment), @response.parsed_body["reactions_url"]
+  end
+end
