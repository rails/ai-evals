new file mode 100644
index 0000000..8a3fe44
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,24 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment&.account }
+  belongs_to :comment, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  delegate :card, to: :comment
+
+  broadcasts_refreshes_to :card
+
+  normalizes :content, with: ->(text) { text.strip }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  scope :chronologically, -> { order(created_at: :asc, id: :asc) }
+
+  def emoji_only?
+    return false if content.blank?
+
+    EmojiHelper::REACTIONS.key?(content) || (
+      content.match?(/\A[\p{Extended_Pictographic}\p{Emoji_Presentation}\p{Emoji_Modifier}\p{Emoji_Component}\uFE0F\u200D\s]+\z/) &&
+      !content.match?(/\A[\d\s#*]+\z/)
+    )
+  end
+end
