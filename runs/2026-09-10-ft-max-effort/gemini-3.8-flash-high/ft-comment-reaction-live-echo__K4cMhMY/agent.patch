diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..a61c8af
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,56 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  wrap_parameters :reaction, include: %i[ content ]
+
+  before_action :set_comment
+  before_action :ensure_card_is_commentable, only: :create
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reacter, only: :destroy
+
+  def index
+    @reactions = @comment.reactions.chronologically
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params.merge(reacter: Current.user))
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def ensure_reacter
+      head :forbidden unless Current.user == @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..c656903
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,40 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static values = {
+    reacterId: String
+  }
+
+  connect() {
+    if (this.isOwnReaction) {
+      this.element.classList.add("reaction--deleteable")
+      this.element.tabIndex = 0
+    }
+  }
+
+  toggle(event) {
+    if (event.target.closest(".reaction__delete")) return
+    if (!this.isOwnReaction) return
+
+    this.element.classList.toggle("expanded")
+  }
+
+  close() {
+    this.element.classList.remove("expanded")
+  }
+
+  closeOnClickOutside(event) {
+    if (!this.element.contains(event.target)) {
+      this.close()
+    }
+  }
+
+  delete(event) {
+    event.stopPropagation()
+    this.element.classList.add("reaction--deleting")
+  }
+
+  get isOwnReaction() {
+    return window.Current?.user?.id === this.reacterIdValue
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..26f05c4
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,41 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  open(event) {
+    event?.stopPropagation()
+    this.triggerTarget.style.display = "none"
+    this.formTarget.style.display = ""
+    this.formTarget.setAttribute("data-turbo-permanent", "")
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event?.stopPropagation()
+    this.formTarget.style.display = "none"
+    this.formTarget.removeAttribute("data-turbo-permanent")
+    this.triggerTarget.style.display = ""
+    this.inputTarget.value = ""
+  }
+
+  submit() {
+    this.formTarget.removeAttribute("data-turbo-permanent")
+  }
+
+  handleSubmitEnd(event) {
+    if (event.detail.success) {
+      this.cancel()
+    }
+  }
+
+  closeOnClickOutside(event) {
+    if (this.isOpen && !this.element.contains(event.target)) {
+      this.cancel()
+    }
+  }
+
+  get isOpen() {
+    return this.hasFormTarget && this.formTarget.style.display !== "none"
+  }
+}
