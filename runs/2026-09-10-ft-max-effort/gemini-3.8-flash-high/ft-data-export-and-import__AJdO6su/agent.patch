+        user.save!(validate: false)
+      end
+
+      if context.import&.identity.present?
+        importing_identity = context.import.identity
+        unless context.account.users.where(identity_id: importing_identity.id).exists?
+          context.account.users.create!(
+            identity: importing_identity,
+            name: importing_identity.email_address.split("@").first.titleize,
+            role: "owner",
+            verified_at: Time.current
+          )
+        end
+      end
+    end
 end
diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
