diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..e77b4f2
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,58 @@
+class ZipFile::Reader
+  def initialize(io)
+    @io = io
+    @reader = ZipKit::FileReader.new
+    @entries = @reader.read_zip_structure(io: @io)
+    @entries_by_filename = @entries.index_by(&:filename)
+  end
+
+  def entries
+    @entries
+  end
+
+  def entry(name)
+    @entries_by_filename[name]
+  end
+
+  def exists?(name)
+    @entries_by_filename.key?(name)
+  end
+
+  def glob(pattern)
+    @entries.select { |e| File.fnmatch(pattern, e.filename) }.map(&:filename).sort
+  end
+
+  def read(name)
+    if entry = entry(name)
+      extractor = entry.extractor_from(@io)
+      output = String.new(encoding: Encoding::BINARY, capacity: entry.uncompressed_size)
+      while chunk = extractor.extract(64.kilobytes)
+        output << chunk
+      end
+      output
+    end
+  end
+
+  def open_entry(name)
+    if entry = entry(name)
+      extractor = entry.extractor_from(@io)
+      tempfile = Tempfile.new([ "zip_entry", File.extname(name) ])
+      tempfile.binmode
+      while chunk = extractor.extract(64.kilobytes)
+        tempfile.write(chunk)
+      end
+      tempfile.rewind
+
+      if block_given?
+        begin
+          yield tempfile
+        ensure
+          tempfile.close
+          tempfile.unlink
+        end
+      else
+        tempfile
+      end
+    end
+  end
+end
