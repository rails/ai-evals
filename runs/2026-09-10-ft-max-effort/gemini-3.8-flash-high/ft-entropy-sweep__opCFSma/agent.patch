diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..e1fed82 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,25 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+  test "board auto_postpone_all_due postpones due cards on that board only" do
+    cards(:logo).update!(last_active_at: entropies(:writebook_board).auto_postpone_period.seconds.ago - 2.days)
+    cards(:radio).update!(last_active_at: entropies(:miltons_wish_list_board).auto_postpone_period.seconds.ago - 2.days)
+
+    boards(:writebook).auto_postpone_all_due
+
+    assert cards(:logo).reload.postponed?
+    assert_not cards(:radio).reload.postponed?
+  end
+
+  test "board due_to_be_postponed_cards falls back to account entropy when board entropy is invalid" do
+    board = boards(:writebook)
+    board.entropy.update_column(:auto_postpone_period, 999.days.to_i)
+
+    # With 999 days invalid, it should fall back to Current.account.entropy (30 days)
+    cards(:logo).update!(last_active_at: 35.days.ago)
+    assert_includes board.due_to_be_postponed_cards, cards(:logo)
+
+    cards(:logo).update!(last_active_at: 20.days.ago)
+    assert_not_includes board.due_to_be_postponed_cards, cards(:logo)
+  end
 end
