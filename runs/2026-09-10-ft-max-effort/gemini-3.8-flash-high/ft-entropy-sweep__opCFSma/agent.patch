diff --git a/app/models/board/entropic.rb b/app/models/board/entropic.rb
index d3e48d6..fc04b71 100644
--- a/app/models/board/entropic.rb
+++ b/app/models/board/entropic.rb
@@ -10,6 +10,16 @@ module Board::Entropic
     super || account.entropy
   end
 
+  def auto_postpone_all_due
+    due_to_be_postponed_cards.find_each do |card|
+      card.auto_postpone(user: account.system_user)
+    end
+  end
+
+  def due_to_be_postponed_cards
+    cards.active.where(account_id: account_id, last_active_at: ..auto_postpone_period_in_days.days.ago)
+  end
+
   def auto_postpone_period=(new_value)
     entropy ||= association(:entropy).reader || self.build_entropy
     entropy.update! auto_postpone_period: new_value
