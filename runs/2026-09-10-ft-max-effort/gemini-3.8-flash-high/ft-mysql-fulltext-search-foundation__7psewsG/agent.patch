diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..de49e4f
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,186 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    Current.user = users(:david)
+  end
+
+  test "show search page without query" do
+    get search_path
+    assert_response :success
+    assert_select "input[name='q']"
+  end
+
+  test "finds cards by title with matched words wrapped in mark" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "mark", text: "logo"
+    assert_select ".card__title" do
+      assert_select "mark", text: "logo"
+    end
+    assert_select ".card", count: 1
+    assert_includes response.body, "The <mark>logo</mark> isn't big enough"
+  end
+
+  test "finds cards by description with matched words wrapped in mark" do
+    card = boards(:writebook).cards.create!(
+      title: "Navigation redesign",
+      status: "published",
+      creator: users(:david)
+    )
+    card.update!(description: "We need a hamburger menu on mobile devices")
+
+    get search_path(q: "hamburger")
+    assert_response :success
+
+    assert_select "mark", text: "hamburger"
+    assert_select ".card__title", text: /Navigation redesign/
+    assert_select ".card__search-excerpt" do
+      assert_select "mark", text: "hamburger"
+    end
+  end
+
+  test "finds cards by comment body with matched words wrapped in mark" do
+    # layout_overflowing_david comment has: "The text is overflowing the container."
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select "mark", text: "overflowing"
+    assert_select ".card__title", text: /Layout is broken/
+    assert_select ".card__search-comment" do
+      assert_select "mark", text: "overflowing"
+    end
+  end
+
+  test "results are ordered newest first" do
+    board = boards(:writebook)
+    card1 = board.cards.create!(title: "Keyword older", status: "published", creator: users(:david), created_at: 2.days.ago)
+    card2 = board.cards.create!(title: "Keyword newest", status: "published", creator: users(:david), created_at: 1.hour.ago)
+    card3 = board.cards.create!(title: "Keyword middle", status: "published", creator: users(:david), created_at: 1.day.ago)
+
+    get search_path(q: "Keyword")
+    assert_response :success
+
+    titles = css_select(".card__title").map(&:text).map(&:strip)
+    assert_equal [ "Keyword newest", "Keyword middle", "Keyword older" ], titles
+  end
+
+  test "people only ever see results from boards they currently have access to" do
+    # Kevin has access to private board, David does not
+    Current.user = users(:kevin)
+    private_card = boards(:private).cards.create!(
+      title: "Confidential Project X",
+      status: "published",
+      creator: users(:kevin)
+    )
+
+    # David searches for "Confidential" - should find nothing
+    Current.user = users(:david)
+    get search_path(q: "Confidential")
+    assert_response :success
+    assert_select ".card", count: 0
+
+    # Kevin searches for "Confidential" - should find the card
+    logout_and_sign_in_as :kevin
+    Current.user = users(:kevin)
+    get search_path(q: "Confidential")
+    assert_response :success
+    assert_select ".card", count: 1
+    assert_select "mark", text: "Confidential"
+  end
+
+  test "people do not see results from comments on inaccessible boards" do
+    Current.user = users(:kevin)
+    private_card = boards(:private).cards.create!(
+      title: "Regular title",
+      status: "published",
+      creator: users(:kevin)
+    )
+    private_card.comments.create!(
+      creator: users(:kevin),
+      body: "Secret comment about aardvark"
+    )
+
+    # David cannot see comments on private boards
+    Current.user = users(:david)
+    get search_path(q: "aardvark")
+    assert_response :success
+    assert_select ".card", count: 0
+
+    # Kevin can see it
+    logout_and_sign_in_as :kevin
+    Current.user = users(:kevin)
+    get search_path(q: "aardvark")
+    assert_response :success
+    assert_select ".card", count: 1
+    assert_select "mark", text: "aardvark"
+  end
+
+  test "draft cards never turn up in search results" do
+    board = boards(:writebook)
+    draft = board.cards.create!(
+      title: "Platypus draft card",
+      status: "drafted",
+      creator: users(:david)
+    )
+    draft.update!(description: "Draft platypus details")
+
+    get search_path(q: "Platypus")
+    assert_response :success
+    assert_select ".card", count: 0
+  end
+
+  test "comments on draft cards never turn up in search results" do
+    board = boards(:writebook)
+    # If a card was published, commented on, and then changed to drafted
+    card = board.cards.create!(
+      title: "Drafted later card",
+      status: "published",
+      creator: users(:david)
+    )
+    card.comments.create!(
+      creator: users(:david),
+      body: "Comment on card about armadillo"
+    )
+    card.update_columns(status: "drafted")
+
+    get search_path(q: "armadillo")
+    assert_response :success
+    assert_select ".card", count: 0
+  end
+
+  test "search is case-insensitive" do
+    get search_path(q: "LOGO")
+    assert_response :success
+
+    assert_select ".card", count: 1
+    assert_select "mark", text: "logo"
+  end
+
+  test "search with multiple words highlights all matched words" do
+    get search_path(q: "logo big")
+    assert_response :success
+
+    assert_select ".card", count: 1
+    assert_select "mark", text: "logo"
+    assert_select "mark", text: "big"
+  end
+
+  test "search as JSON returns matching cards array" do
+    get search_path(q: "logo", format: :json)
+    assert_response :success
+
+    assert_kind_of Array, response.parsed_body
+    assert_equal [ cards(:logo).number ], response.parsed_body.pluck("number")
+  end
+
+  test "search with no results shows blank slate" do
+    get search_path(q: "nonexistenttermxyz")
+    assert_response :success
+
+    assert_select ".card", count: 0
+    assert_select ".blank-slate", text: "No cards match your search"
+  end
+end
diff --git a/test/helpers/searches_helper_test.rb b/test/helpers/searches_helper_test.rb
