+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @cards = if @query.present?
+      Current.user.accessible_cards.published.search(@query).reverse_chronologically.preloaded.preload(comments: [ :creator, :rich_text_body ])
+    else
+      Card.none
+    end
+
+    set_page_and_extract_portion_from @cards
+
+    respond_to do |format|
+      format.html
+      format.json { render "cards/index" }
+    end
+  end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..1897a18
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,33 @@
+module SearchesHelper
+  def highlight_search(text, query)
+    return text if text.blank? || query.blank?
+
+    words = query.to_s.split
+    return text if words.empty?
+
+    phrases = ([ query.to_s, ERB::Util.html_escape(query.to_s) ] + words + words.map { |w| ERB::Util.html_escape(w) }).uniq
+    highlight(text, phrases)
+  end
+
+  def search_excerpt(content, query, radius: 80)
+    return nil if content.blank? || query.blank?
+
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+    text = text.gsub(/\s+/, " ").strip
+    return nil if text.blank?
+
+    words = query.to_s.split
+    return nil if words.empty?
+
+    match_phrase = if text.downcase.include?(query.to_s.downcase)
+      query.to_s
+    else
+      words.find { |w| text.downcase.include?(w.downcase) }
+    end
+
+    return nil unless match_phrase
+
+    snippet = excerpt(text, match_phrase, radius: radius) || text.truncate(radius * 2)
+    highlight_search(snippet, query)
+  end
+end
