diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..7d0dbd9
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,39 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def search(query)
+      return none if query.blank?
+
+      words = query.to_s.split
+      return none if words.empty?
+
+      account = Current.account
+
+      words.inject(all) do |relation, word|
+        pattern = "%#{ActiveRecord::Base.sanitize_sql_like(word.downcase)}%"
+
+        desc_rich_texts = ActionText::RichText
+          .where(record_type: "Card", name: "description")
+          .where("LOWER(action_text_rich_texts.body) LIKE ? ESCAPE '\\'", pattern)
+        desc_rich_texts = desc_rich_texts.where(account_id: account.id) if account
+
+        comment_rich_texts = ActionText::RichText
+          .where(record_type: "Comment", name: "body")
+          .where("LOWER(action_text_rich_texts.body) LIKE ? ESCAPE '\\'", pattern)
+        comment_rich_texts = comment_rich_texts.where(account_id: account.id) if account
+
+        comment_card_ids = Comment
+          .where(id: comment_rich_texts.select(:record_id))
+        comment_card_ids = comment_card_ids.where(account_id: account.id) if account
+
+        relation.where(
+          "LOWER(cards.title) LIKE :pattern ESCAPE '\\' OR cards.id IN (:desc_card_ids) OR cards.id IN (:comment_card_ids)",
+          pattern: pattern,
+          desc_card_ids: desc_rich_texts.select(:record_id),
+          comment_card_ids: comment_card_ids.select(:card_id)
+        )
+      end
+    end
+  end
+end
diff --git a/app/views/searches/_card.html.erb b/app/views/searches/_card.html.erb
