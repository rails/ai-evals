+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<div class="panel center margin pad max-width">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half align-center full-width", data: { turbo_frame: "_top" } do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards by title, description, or comments…",
+          class: "input input--transparent full-width", autofocus: true, autocorrect: "off", autocomplete: "off" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+</div>
+
+<%= turbo_frame_tag :cards_container do %>
+  <section class="cards cards--grid">
+    <div class="cards__list hide-scrollbar">
+      <% if @cards.any? %>
+        <%= with_automatic_pagination :cards_paginated_container, @page do %>
+          <%= render partial: "searches/card", collection: @page.records, as: :card, locals: { query: @query } %>
+        <% end %>
+      <% elsif @query.present? %>
+        <div class="blank-slate">No cards match your search</div>
+      <% end %>
+    </div>
+  </section>
+<% end %>
