+++ b/test/helpers/searches_helper_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class SearchesHelperTest < ActionView::TestCase
+  test "highlight_search wraps matched word in mark" do
+    result = highlight_search("The quick brown fox", "quick")
+    assert_equal "The <mark>quick</mark> brown fox", result
+  end
+
+  test "highlight_search is case insensitive" do
+    result = highlight_search("The Quick Brown Fox", "quick")
+    assert_equal "The <mark>Quick</mark> Brown Fox", result
+  end
+
+  test "highlight_search with multiple words" do
+    result = highlight_search("The quick brown fox", "quick fox")
+    assert_equal "The <mark>quick</mark> brown <mark>fox</mark>", result
+  end
+
+  test "highlight_search preserves HTML in title" do
+    result = highlight_search("Fix <code>bug</code> in production".html_safe, "bug")
+    assert_equal "Fix <code><mark>bug</mark></code> in production", result
+  end
+
+  test "highlight_search returns blank or original for nil/empty" do
+    assert_nil highlight_search(nil, "quick")
+    assert_equal "", highlight_search("", "quick")
+    assert_equal "Hello", highlight_search("Hello", "")
+    assert_equal "Hello", highlight_search("Hello", nil)
+  end
+
+  test "search_excerpt returns nil when no match" do
+    assert_nil search_excerpt("Some unrelated text here", "banana")
+    assert_nil search_excerpt("", "banana")
+    assert_nil search_excerpt(nil, "banana")
+    assert_nil search_excerpt("Some text", "")
+  end
+
+  test "search_excerpt returns highlighted snippet for match" do
+    result = search_excerpt("This is a wonderful feature that we built", "wonderful")
+    assert_includes result, "<mark>wonderful</mark>"
+  end
+
+  test "search_excerpt works on ActionText content" do
+    rich_text = ActionText::RichText.new(body: "<div>Here is <b>bold</b> text about a <mark-test>zebra</mark-test></div>")
+    result = search_excerpt(rich_text, "zebra")
+    assert_includes result, "<mark>zebra</mark>"
+  end
+
+  test "search_excerpt centers on match in long text" do
+    prefix = "word " * 50
+    suffix = " end" * 50
+    content = "#{prefix}specialkeyword#{suffix}"
+    result = search_excerpt(content, "specialkeyword", radius: 30)
+    assert_includes result, "<mark>specialkeyword</mark>"
+    assert result.length < content.length
+  end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..db32942
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    Current.user = users(:david)
+    @board = boards(:writebook)
+  end
+
+  test "search finds cards by title" do
+    card = @board.cards.create!(title: "Unique Title Zebra", status: "published", creator: users(:david))
+
+    results = Card.search("Zebra")
+    assert_includes results, card
+  end
+
+  test "search finds cards by description" do
+    card = @board.cards.create!(title: "Some Card", status: "published", creator: users(:david))
+    card.update!(description: "Contains a flamingo in description")
+
+    results = Card.search("flamingo")
+    assert_includes results, card
+  end
+
+  test "search finds cards by comment body" do
+    card = @board.cards.create!(title: "Another Card", status: "published", creator: users(:david))
+    card.comments.create!(creator: users(:david), body: "Mentions a kangaroo here")
+
+    results = Card.search("kangaroo")
+    assert_includes results, card
+  end
+
+  test "search is case insensitive" do
+    card = @board.cards.create!(title: "Uppercase PTERODACTYL", status: "published", creator: users(:david))
+
+    assert_includes Card.search("pterodactyl"), card
+    assert_includes Card.search("PTERODACTYL"), card
+  end
+
+  test "search with multiple words" do
+    card = @board.cards.create!(title: "Blue Whale", status: "published", creator: users(:david))
+
+    assert_includes Card.search("blue whale"), card
+    assert_includes Card.search("whale blue"), card
+    assert_not_includes Card.search("blue shark"), card
+  end
+
+  test "search returns none for blank or empty query" do
+    assert_empty Card.search("")
+    assert_empty Card.search("   ")
+    assert_empty Card.search(nil)
+  end
+
+  test "search handles special characters like percent and underscore" do
+    card = @board.cards.create!(title: "Score 100% achieved", status: "published", creator: users(:david))
+
+    assert_includes Card.search("100%"), card
+    assert_not_includes Card.search("100_"), card
+  end
+end
