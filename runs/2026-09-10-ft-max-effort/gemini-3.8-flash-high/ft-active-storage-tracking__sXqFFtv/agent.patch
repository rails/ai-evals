@@ -0,0 +1,192 @@
+require "test_helper"
+
+class Board::StorageTrackingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+    Current.account = @account
+    Current.user = @user
+    Current.session = sessions(:david)
+    @board = @account.boards.create!(name: "Storage Board", creator: @user)
+    @board2 = @account.boards.create!(name: "Second Storage Board", creator: @user)
+  end
+
+  test "initial bytes_used is 0" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @board.calculate_bytes_used
+  end
+
+  test "card image is counted in bytes_used on board and account" do
+    card = @board.cards.create!(title: "Card with image", creator: @user, status: "published")
+
+    assert_difference -> { @board.reload.bytes_used }, file_fixture("moon.jpg").size do
+      assert_difference -> { @account.reload.bytes_used }, file_fixture("moon.jpg").size do
+        card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "purging card image reduces bytes_used on board and account" do
+    card = @board.cards.create!(title: "Card with image", creator: @user, status: "published")
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    perform_enqueued_jobs
+
+    image_size = card.image.blob.byte_size
+
+    assert_difference -> { @board.reload.bytes_used }, -image_size do
+      assert_difference -> { @account.reload.bytes_used }, -image_size do
+        card.image.purge
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "purge_later on card image reduces bytes_used on board and account" do
+    card = @board.cards.create!(title: "Card with image", creator: @user, status: "published")
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    perform_enqueued_jobs
+
+    image_size = card.image.blob.byte_size
+
+    assert_difference -> { @board.reload.bytes_used }, -image_size do
+      assert_difference -> { @account.reload.bytes_used }, -image_size do
+        card.image.purge_later
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "embeds in card descriptions are counted in bytes_used" do
+    card = @board.cards.create!(title: "Card with embed", creator: @user, status: "published")
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("test content for embed"), filename: "test.txt")
+    attachment_html = ActionText::Attachment.from_attachable(blob).to_html
+
+    assert_difference -> { @board.reload.bytes_used }, blob.byte_size do
+      assert_difference -> { @account.reload.bytes_used }, blob.byte_size do
+        card.update!(description: "<p>Embedded file: #{attachment_html}</p>")
+        perform_enqueued_jobs
+      end
+    end
+
+    # Removing embed reduces bytes_used
+    assert_difference -> { @board.reload.bytes_used }, -blob.byte_size do
+      assert_difference -> { @account.reload.bytes_used }, -blob.byte_size do
+        card.update!(description: "<p>No attachments here</p>")
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "embeds in comments are counted in bytes_used" do
+    card = @board.cards.create!(title: "Card with comments", creator: @user, status: "published")
+    comment = card.comments.create!(creator: @user)
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("comment attachment data"), filename: "comment.txt")
+    attachment_html = ActionText::Attachment.from_attachable(blob).to_html
+
+    assert_difference -> { @board.reload.bytes_used }, blob.byte_size do
+      assert_difference -> { @account.reload.bytes_used }, blob.byte_size do
+        comment.update!(body: "<p>Comment embed: #{attachment_html}</p>")
+        perform_enqueued_jobs
+      end
+    end
+
+    # Destroying comment reduces bytes_used
+    assert_difference -> { @board.reload.bytes_used }, -blob.byte_size do
+      assert_difference -> { @account.reload.bytes_used }, -blob.byte_size do
+        comment.destroy
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "embeds in board public_description are counted in bytes_used" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("board description embed"), filename: "board.txt")
+    attachment_html = ActionText::Attachment.from_attachable(blob).to_html
+
+    assert_difference -> { @board.reload.bytes_used }, blob.byte_size do
+      assert_difference -> { @account.reload.bytes_used }, blob.byte_size do
+        @board.update!(public_description: "<p>Board embed: #{attachment_html}</p>")
+        perform_enqueued_jobs
+      end
+    end
+
+    assert_difference -> { @board.reload.bytes_used }, -blob.byte_size do
+      assert_difference -> { @account.reload.bytes_used }, -blob.byte_size do
+        @board.update!(public_description: "<p>No embed</p>")
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "moving a card transfers its bytes_used between boards" do
+    card = @board.cards.create!(title: "Card to move", creator: @user, status: "published")
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    perform_enqueued_jobs
+
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("card embed"), filename: "card.txt")
+    card.update!(description: "<p>#{ActionText::Attachment.from_attachable(blob).to_html}</p>")
+    perform_enqueued_jobs
+
+    comment = card.comments.create!(creator: @user)
+    blob2 = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("comment embed"), filename: "comment.txt")
+    comment.update!(body: "<p>#{ActionText::Attachment.from_attachable(blob2).to_html}</p>")
+    perform_enqueued_jobs
+
+    total_card_bytes = card.image.blob.byte_size + blob.byte_size + blob2.byte_size
+
+    assert_equal total_card_bytes, @board.reload.bytes_used
+    assert_equal 0, @board2.reload.bytes_used
+
+    # Move card to board2: board1 loses bytes, board2 gains bytes, account unchanged
+    assert_difference -> { @board.reload.bytes_used }, -total_card_bytes do
+      assert_difference -> { @board2.reload.bytes_used }, total_card_bytes do
+        assert_no_difference -> { @account.reload.bytes_used } do
+          card.move_to(@board2)
+          perform_enqueued_jobs
+        end
+      end
+    end
+  end
+
+  test "destroying a card removes its usage from board and account" do
+    card = @board.cards.create!(title: "Card to destroy", creator: @user, status: "published")
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    perform_enqueued_jobs
+
+    card_size = card.image.blob.byte_size
+
+    assert_difference -> { @board.reload.bytes_used }, -card_size do
+      assert_difference -> { @account.reload.bytes_used }, -card_size do
+        card.destroy
+        perform_enqueued_jobs
+      end
+    end
+  end
+
+  test "destroying a board updates account bytes_used" do
+    card = @board.cards.create!(title: "Card on dying board", creator: @user, status: "published")
+    card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    perform_enqueued_jobs
+
+    board_bytes = @board.reload.bytes_used
+
+    assert_difference -> { @account.reload.bytes_used }, -board_bytes do
+      @board.destroy
+      perform_enqueued_jobs
+    end
+  end
+
+  test "avatars and exports do not count towards bytes_used" do
+    initial_account_bytes = @account.reload.bytes_used
+    initial_board_bytes = @board.reload.bytes_used
+
+    @user.avatar.attach io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg"
+    export = Account::Export.create!(account: @account, user: @user)
+    export.file.attach io: StringIO.new("export zip content"), filename: "export.zip"
+    perform_enqueued_jobs
+
+    assert_equal initial_account_bytes, @account.reload.bytes_used
+    assert_equal initial_board_bytes, @board.reload.bytes_used
+  end
+end
