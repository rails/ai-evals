diff --git a/test/models/account/storage_tracking_test.rb b/test/models/account/storage_tracking_test.rb
new file mode 100644
index 0000000..ae89b1d
--- /dev/null
+++ b/test/models/account/storage_tracking_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Account::StorageTrackingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @user = users(:david)
+    Current.account = @account
+    Current.user = @user
+    Current.session = sessions(:david)
+  end
+
+  test "initial bytes_used returns column or 0" do
+    account = Account.create!(name: "Fresh Account")
+    assert_equal 0, account.bytes_used
+    assert_equal 0, account.calculate_bytes_used
+  end
+
+  test "bytes_used includes everything counted across all boards" do
+    board1 = @account.boards.create!(name: "Board 1", creator: @user)
+    board2 = @account.boards.create!(name: "Board 2", creator: @user)
+
+    card1 = board1.cards.create!(title: "Card 1", creator: @user, status: "published")
+    card1.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+
+    card2 = board2.cards.create!(title: "Card 2", creator: @user, status: "published")
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("embed in board 2 card"), filename: "test.txt")
+    card2.update!(description: "<p>#{ActionText::Attachment.from_attachable(blob).to_html}</p>")
+
+    perform_enqueued_jobs
+
+    assert_equal file_fixture("moon.jpg").size, board1.reload.bytes_used
+    assert_equal blob.byte_size, board2.reload.bytes_used
+    assert_equal file_fixture("moon.jpg").size + blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "calculate_bytes_used_later enqueues Account::CalculateBytesUsedJob" do
+    assert_enqueued_with(job: Account::CalculateBytesUsedJob, args: [ @account ]) do
+      @account.calculate_bytes_used_later
+    end
+  end
+
+  test "calculate_bytes_used_now updates stored bytes_used" do
+    board = @account.boards.create!(name: "Manual Board", creator: @user)
+    board.update_columns(bytes_used: 50_000)
+
+    @account.calculate_bytes_used_now
+    assert_equal @account.boards.sum(:bytes_used), @account.reload.bytes_used
+  end
+end
diff --git a/test/models/board/storage_tracking_test.rb b/test/models/board/storage_tracking_test.rb
