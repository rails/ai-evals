diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
index f85a27a..2f72c68 100644
--- a/config/initializers/active_storage.rb
+++ b/config/initializers/active_storage.rb
@@ -56,3 +56,62 @@ Rails.application.config.to_prepare do
   ActiveStorage::BaseController.include ActiveStorageControllerExtensions
   ActiveStorage::DirectUploadsController.include ActiveStorageDirectUploadsControllerExtensions
 end
+
+module StorageAttachmentTracking
+  def self.prepended(base)
+    base.after_upload :track_storage_usage_later
+    base.after_destroy_commit :track_storage_usage_later
+  end
+
+  def purge
+    board = storage_board
+    super
+  ensure
+    board&.calculate_bytes_used_later
+  end
+
+  def purge_later
+    board = storage_board
+    super
+  ensure
+    board&.calculate_bytes_used_later
+  end
+
+  private
+    def track_storage_usage_later
+      storage_board&.calculate_bytes_used_later
+    end
+
+    def storage_board
+      case record_type
+      when "Card"
+        record&.board if name == "image"
+      when "ActionText::RichText"
+        if name == "embeds"
+          rich_text = record || ActionText::RichText.find_by(id: record_id)
+          case rich_text&.record_type
+          when "Board"
+            rich_text.record || Board.find_by(id: rich_text.record_id)
+          when "Card"
+            card = rich_text.record || Card.find_by(id: rich_text.record_id)
+            card&.board
+          when "Comment"
+            comment = rich_text.record || Comment.find_by(id: rich_text.record_id)
+            comment&.card&.board
+          end
+        end
+      end
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  prepend StorageAttachmentTracking unless ancestors.include?(StorageAttachmentTracking)
+end
+
+Rails.application.config.to_prepare do
+  if defined?(ActiveStorage::Attachment)
+    ActiveStorage::Attachment.prepend(StorageAttachmentTracking) unless ActiveStorage::Attachment.ancestors.include?(StorageAttachmentTracking)
+  end
+end
