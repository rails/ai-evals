diff --git a/app/models/board/storage_tracking.rb b/app/models/board/storage_tracking.rb
new file mode 100644
index 0000000..92deb1b
--- /dev/null
+++ b/app/models/board/storage_tracking.rb
@@ -0,0 +1,54 @@
+module Board::StorageTracking
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :track_account_bytes_used_later
+  end
+
+  def bytes_used
+    super || 0
+  end
+
+  def calculate_bytes_used_later
+    Board::CalculateBytesUsedJob.perform_later(self)
+  end
+  alias_method :track_bytes_used_later, :calculate_bytes_used_later
+
+  def calculate_bytes_used_now
+    total = calculate_bytes_used
+    update_columns(bytes_used: total)
+    account&.calculate_bytes_used_now
+    total
+  end
+  alias_method :track_bytes_used_now, :calculate_bytes_used_now
+
+  def calculate_bytes_used
+    card_images_bytes + embedded_files_bytes
+  end
+
+  private
+    def card_images_bytes
+      ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "Card", name: "image", record_id: cards.select(:id))
+        .sum(:byte_size)
+    end
+
+    def embedded_files_bytes
+      ActiveStorage::Attachment.joins(:blob)
+        .where(record_type: "ActionText::RichText", name: "embeds", record_id: board_and_card_rich_text_ids)
+        .sum(:byte_size)
+    end
+
+    def board_and_card_rich_text_ids
+      card_ids = cards.select(:id)
+      comment_ids = Comment.where(card_id: card_ids).select(:id)
+
+      ActionText::RichText.where(record_type: "Board", record_id: id).select(:id)
+        .or(ActionText::RichText.where(record_type: "Card", record_id: card_ids).select(:id))
+        .or(ActionText::RichText.where(record_type: "Comment", record_id: comment_ids).select(:id))
+    end
+
+    def track_account_bytes_used_later
+      account&.calculate_bytes_used_later
+    end
+end
