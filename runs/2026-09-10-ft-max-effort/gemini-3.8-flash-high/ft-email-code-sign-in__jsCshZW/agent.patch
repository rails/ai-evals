+class IdentityMailer < ApplicationMailer
+  def sign_in_code(*args, **kwargs)
+    @email_address = kwargs[:email_address] || args[0]
+    @code = kwargs[:code] || args[1]
+
+    mail to: @email_address, subject: "#{@code} is your Fizzy code"
+  end
+end
diff --git a/app/models/session/magic_link.rb b/app/models/session/magic_link.rb
new file mode 100644
index 0000000..79f615f
--- /dev/null
+++ b/app/models/session/magic_link.rb
@@ -0,0 +1,59 @@
+class Session::MagicLink
+  EXPIRATION = 15.minutes
+
+  class << self
+    def issue(email_address:, purpose: "sign_in", join_code: nil)
+      code = generate_code
+      token = generate_token(email_address: email_address, code: code, purpose: purpose, join_code: join_code)
+      deliver_code(email_address: email_address, code: code)
+      token
+    end
+
+    def find_by_token(token)
+      if token.present?
+        Rails.application.message_verifier(:pending_authentication).verified(
+          token,
+          purpose: :pending_authentication
+        )
+      end
+    end
+
+    def verify(token, code)
+      if (payload = find_by_token(token)) && valid_code?(payload, code)
+        payload
+      end
+    end
+
+    private
+      def generate_code
+        SecureRandom.alphanumeric(6).upcase
+      end
+
+      def generate_token(email_address:, code:, purpose:, join_code:)
+        Rails.application.message_verifier(:pending_authentication).generate(
+          {
+            "email_address" => email_address,
+            "code_digest" => code_digest(code),
+            "purpose" => purpose.to_s,
+            "join_code" => join_code
+          },
+          purpose: :pending_authentication,
+          expires_in: EXPIRATION
+        )
+      end
+
+      def code_digest(code)
+        OpenSSL::HMAC.hexdigest("SHA256", Rails.application.secret_key_base, code.to_s.strip.upcase)
+      end
+
+      def valid_code?(payload, code)
+        return false if code.blank?
+
+        ActiveSupport::SecurityUtils.secure_compare(payload["code_digest"], code_digest(code))
+      end
+
+      def deliver_code(email_address:, code:)
+        IdentityMailer.sign_in_code(email_address: email_address, code: code).deliver_later
+      end
+  end
+end
