+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end">
+    <% if @purpose == "join" && @account_name.present? %>
+      Join <%= @account_name %> in Fizzy
+    <% elsif @purpose == "sign_up" %>
+      Sign up
+    <% else %>
+      Get into Fizzy
+    <% end %>
+  </h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium", data: { controller: "form" } do |form| %>
+    <%= form.hidden_field :pending_authentication_token, value: @pending_authentication_token if @pending_authentication_token.present? %>
+
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width center uppercase", autofocus: true, autocomplete: "one-time-code", placeholder: "6-character code", maxlength: 6 %>
+      </label>
+    </div>
+
+    <% if @purpose == "join" && @account_name.present? %>
+      <p>Enter the 6-character code sent to <strong><%= @email_address %></strong> to join <%= @account_name %>.</p>
+    <% elsif @purpose == "sign_up" %>
+      <p>Enter the 6-character code sent to <strong><%= @email_address %></strong> to create your account.</p>
+    <% else %>
+      <p>Enter the 6-character code sent to <strong><%= @email_address %></strong> to sign in.</p>
+    <% end %>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Let’s go</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <div class="margin-block-start">
+    <% back_path = case @purpose
+       when "join" then (@join_code_value.present? ? join_path(code: @join_code_value, script_name: @account_slug) : new_session_path)
+       when "sign_up" then new_signup_path
+       else new_session_path
+       end %>
+    <%= link_to "Use a different email", back_path, class: "btn btn--plain txt-link center txt-small" %>
+  </div>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
