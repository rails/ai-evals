@@ -0,0 +1,107 @@
+class Sessions::MagicLinksController < ApplicationController
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def show
+    redirect_to new_session_magic_link_path
+  end
+
+  def new
+    if pending_authentication.nil?
+      redirect_to new_session_path
+    else
+      @email_address = pending_authentication["email_address"]
+      @purpose = pending_authentication["purpose"]
+      @join_code_value = pending_authentication["join_code"]
+      @pending_authentication_token = pending_authentication_token
+
+      if @purpose == "join" && @join_code_value.present?
+        if join_code = Account::JoinCode.find_by(code: @join_code_value)
+          @account_name = join_code.account.name
+          @account_slug = join_code.account.slug
+        end
+      end
+    end
+  end
+
+  def create
+    if pending_authentication.present? && (payload = Session::MagicLink.verify(pending_authentication_token, params[:code]))
+      consume_magic_link(payload)
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def pending_authentication_token
+      params[:pending_authentication_token].presence || cookies[:pending_authentication_token]
+    end
+
+    def pending_authentication
+      @pending_authentication ||= Session::MagicLink.find_by_token(pending_authentication_token)
+    end
+
+    def consume_magic_link(payload)
+      cookies.delete(:pending_authentication_token, path: "/")
+
+      identity = Identity.find_or_create_by!(email_address: payload["email_address"])
+      start_new_session_for(identity)
+
+      case payload["purpose"]
+      when "join"
+        complete_join(identity, payload["join_code"])
+      when "sign_up"
+        respond_to do |format|
+          format.html { redirect_to new_signup_completion_path }
+          format.json { render json: { session_token: session_token }, status: :created }
+        end
+      else
+        respond_to do |format|
+          format.html { redirect_to after_authentication_url }
+          format.json { render json: { session_token: session_token } }
+        end
+      end
+    end
+
+    def complete_join(identity, join_code_value)
+      join_code = Account::JoinCode.find_by!(code: join_code_value)
+      join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: join_code.account, identity: identity)
+
+      destination_url = if user.setup?
+        landing_url(script_name: join_code.account.slug)
+      else
+        new_users_verification_url(script_name: join_code.account.slug)
+      end
+
+      respond_to do |format|
+        format.html { redirect_to destination_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def invalid_code
+      respond_to do |format|
+        format.html do
+          if pending_authentication.present?
+            redirect_to new_session_magic_link_path, alert: "That code didn't work. Try again."
+          else
+            redirect_to new_session_path, alert: "That code didn't work. Try again."
+          end
+        end
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
