+require "test_helper"
+
+class Sessions::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    @email_address = "user@example.com"
+  end
+
+  test "new with valid pending authentication" do
+    token = Session::MagicLink.issue(email_address: @email_address, purpose: "sign_in")
+    cookies[:pending_authentication_token] = token
+
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_response :success
+      assert_select "h1", text: /Get into Fizzy/i
+      assert_includes @response.body, @email_address
+      assert_select "input[name='code']"
+    end
+  end
+
+  test "new with join purpose renders account name and back link" do
+    join_code = account_join_codes(:"37s")
+    token = Session::MagicLink.issue(email_address: "joiner@example.com", purpose: "join", join_code: join_code.code)
+    cookies[:pending_authentication_token] = token
+
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_response :success
+      assert_select "h1", text: /Join 37signals in Fizzy/i
+      assert_select "a[href=?]", join_path(code: join_code.code, script_name: join_code.account.slug)
+    end
+  end
+
+  test "new with sign_up purpose renders signup title and back link" do
+    token = Session::MagicLink.issue(email_address: "newbie@example.com", purpose: "sign_up")
+    cookies[:pending_authentication_token] = token
+
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_response :success
+      assert_select "h1", text: /Sign up/i
+      assert_select "a[href=?]", new_signup_path
+    end
+  end
+
+  test "new without pending authentication redirects to session#new" do
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "new with expired pending authentication redirects to session#new" do
+    token = Session::MagicLink.issue(email_address: @email_address, purpose: "sign_in")
+    cookies[:pending_authentication_token] = token
+
+    travel 16.minutes do
+      untenanted do
+        get new_session_magic_link_path
+
+        assert_redirected_to new_session_path
+      end
+    end
+  end
+
+  test "new for authenticated user redirects to root" do
+    sign_in_as :kevin
+
+    untenanted do
+      get new_session_magic_link_path
+
+      assert_redirected_to root_url
+    end
+  end
+
+  test "show redirects to new" do
+    untenanted do
+      get session_magic_link_path
+
+      assert_redirected_to new_session_magic_link_path
+    end
+  end
+
+  test "create sign_in with valid code" do
+    perform_enqueued_jobs do
+      token = Session::MagicLink.issue(email_address: @email_address, purpose: "sign_in")
+      code = ActionMailer::Base.deliveries.last.subject.split.first
+      cookies[:pending_authentication_token] = token
+
+      untenanted do
+        assert_difference -> { Identity.count }, +1 do
+          post session_magic_link_path, params: { code: code }
+        end
+
+        assert_redirected_to landing_url
+        assert cookies[:session_token].present?
+        assert cookies[:pending_authentication_token].blank?
+      end
+    end
+  end
+
+  test "create sign_in with invalid code" do
+    perform_enqueued_jobs do
+      token = Session::MagicLink.issue(email_address: @email_address, purpose: "sign_in")
+      cookies[:pending_authentication_token] = token
+
+      untenanted do
+        assert_no_difference -> { Identity.count } do
+          post session_magic_link_path, params: { code: "WRONG1" }
+        end
+
+        assert_redirected_to new_session_magic_link_path
+        assert_equal "That code didn't work. Try again.", flash[:alert]
+        assert_nil cookies[:session_token]
+        assert_equal token, cookies[:pending_authentication_token]
+      end
+    end
+  end
+
+  test "create via JSON with valid code" do
+    perform_enqueued_jobs do
+      token = Session::MagicLink.issue(email_address: @email_address, purpose: "sign_in")
+      code = ActionMailer::Base.deliveries.last.subject.split.first
+      cookies[:pending_authentication_token] = token
+
+      untenanted do
+        post session_magic_link_path(format: :json), params: { code: code }
+
+        assert_response :ok
+        assert @response.parsed_body["session_token"].present?
+      end
+    end
+  end
+
+  test "create via JSON with invalid code" do
+    perform_enqueued_jobs do
+      token = Session::MagicLink.issue(email_address: @email_address, purpose: "sign_in")
+      cookies[:pending_authentication_token] = token
+
+      untenanted do
+        post session_magic_link_path(format: :json), params: { code: "WRONG1" }
+
+        assert_response :unauthorized
+        assert_equal "That code didn't work. Try again.", @response.parsed_body["message"]
+      end
+    end
+  end
+
+  test "create sign_up redirects to new_signup_completion_path" do
+    perform_enqueued_jobs do
+      token = Session::MagicLink.issue(email_address: "newuser@example.com", purpose: "sign_up")
+      code = ActionMailer::Base.deliveries.last.subject.split.first
+      cookies[:pending_authentication_token] = token
+
