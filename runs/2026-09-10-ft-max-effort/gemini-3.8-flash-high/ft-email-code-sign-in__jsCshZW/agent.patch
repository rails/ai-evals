diff --git a/test/mailers/identity_mailer_test.rb b/test/mailers/identity_mailer_test.rb
new file mode 100644
index 0000000..785a47b
--- /dev/null
+++ b/test/mailers/identity_mailer_test.rb
@@ -0,0 +1,32 @@
+require "test_helper"
+
+class IdentityMailerTest < ActionMailer::TestCase
+  test "sign_in_code sends to email address with code in subject" do
+    code = "ABC123"
+    email = IdentityMailer.sign_in_code(email_address: "alice@example.com", code: code)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "alice@example.com" ], email.to
+    assert_equal "#{code} is your Fizzy code", email.subject
+    assert email.subject.start_with?(code), "Subject should start with the code so it shows in notifications"
+
+    assert email.html_part.present?, "Email should have HTML part"
+    assert email.text_part.present?, "Email should have text part"
+
+    assert_match code, email.html_part.body.encoded
+    assert_match code, email.text_part.body.encoded
+    assert_match "15 minutes", email.html_part.body.encoded
+    assert_match "15 minutes", email.text_part.body.encoded
+  end
+
+  test "sign_in_code supports positional arguments" do
+    code = "XYZ789"
+    email = IdentityMailer.sign_in_code("bob@example.com", code)
+
+    assert_equal [ "bob@example.com" ], email.to
+    assert_equal "#{code} is your Fizzy code", email.subject
+  end
+end
diff --git a/test/models/session/magic_link_test.rb b/test/models/session/magic_link_test.rb
new file mode 100644
index 0000000..bdc256b
--- /dev/null
+++ b/test/models/session/magic_link_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class Session::MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "issue generates token and delivers email with 6-character code in subject" do
+    assert_emails 1 do
+      token = Session::MagicLink.issue(email_address: "test@example.com", purpose: "sign_in")
+      assert_kind_of String, token
+
+      mail = ActionMailer::Base.deliveries.last
+      assert_equal [ "test@example.com" ], mail.to
+      assert_match /\A[A-Z0-9]{6} is your Fizzy code\z/, mail.subject
+
+      code = mail.subject.split.first
+      assert_equal 6, code.length
+
+      payload = Session::MagicLink.find_by_token(token)
+      assert_equal "test@example.com", payload["email_address"]
+      assert_equal "sign_in", payload["purpose"]
+    end
+  end
+
+  test "issue with join_code" do
+    token = Session::MagicLink.issue(email_address: "joiner@example.com", purpose: "join", join_code: "JOIN123")
+    payload = Session::MagicLink.find_by_token(token)
+
+    assert_equal "join", payload["purpose"]
+    assert_equal "JOIN123", payload["join_code"]
+  end
+
+  test "verify with valid code" do
+    perform_enqueued_jobs do
+      token = Session::MagicLink.issue(email_address: "user@example.com", purpose: "sign_in")
+      code = ActionMailer::Base.deliveries.last.subject.split.first
+
+      payload = Session::MagicLink.verify(token, code)
+      assert_not_nil payload
+      assert_equal "user@example.com", payload["email_address"]
+    end
+  end
+
+  test "verify is case-insensitive and trims whitespace" do
+    perform_enqueued_jobs do
+      token = Session::MagicLink.issue(email_address: "user@example.com", purpose: "sign_in")
+      code = ActionMailer::Base.deliveries.last.subject.split.first
+
+      payload = Session::MagicLink.verify(token, "  #{code.downcase}  ")
+      assert_not_nil payload
+      assert_equal "user@example.com", payload["email_address"]
+    end
+  end
+
+  test "verify with invalid code" do
+    token = Session::MagicLink.issue(email_address: "user@example.com", purpose: "sign_in")
+
+    assert_nil Session::MagicLink.verify(token, "WRONG1")
+    assert_nil Session::MagicLink.verify(token, "")
+    assert_nil Session::MagicLink.verify(token, nil)
+  end
+
+  test "token expires after 15 minutes" do
+    perform_enqueued_jobs do
+      token = Session::MagicLink.issue(email_address: "user@example.com", purpose: "sign_in")
+      code = ActionMailer::Base.deliveries.last.subject.split.first
+
+      travel 14.minutes do
+        assert_not_nil Session::MagicLink.verify(token, code)
+        assert_not_nil Session::MagicLink.find_by_token(token)
+      end
+
+      travel 16.minutes do
+        assert_nil Session::MagicLink.verify(token, code)
+        assert_nil Session::MagicLink.find_by_token(token)
+      end
+    end
+  end
+
+  test "tampered token is invalid" do
+    token = Session::MagicLink.issue(email_address: "user@example.com", purpose: "sign_in")
+
+    assert_nil Session::MagicLink.find_by_token(token + "tampered")
+    assert_nil Session::MagicLink.verify(token + "tampered", "ABCDEF")
+  end
+end
