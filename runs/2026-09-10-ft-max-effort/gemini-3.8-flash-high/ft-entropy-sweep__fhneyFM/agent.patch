diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..4e61a16 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,23 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "due_to_be_postponed on board scope returns only due cards for that board" do
+    cards(:logo).update!(last_active_at: entropies(:writebook_board).auto_postpone_period.seconds.ago - 2.days)
+    cards(:shipping).update!(last_active_at: entropies(:writebook_board).auto_postpone_period.seconds.ago + 2.days)
+    cards(:radio).update!(last_active_at: entropies(:miltons_wish_list_board).auto_postpone_period.seconds.ago - 2.days)
+
+    assert_includes boards(:writebook).cards.due_to_be_postponed, cards(:logo)
+    assert_not_includes boards(:writebook).cards.due_to_be_postponed, cards(:shipping)
+    assert_not_includes boards(:writebook).cards.due_to_be_postponed, cards(:radio)
+  end
+
+  test "auto_postpone_all_due ignores closed and postponed cards" do
+    cards(:logo).update!(last_active_at: entropies(:writebook_board).auto_postpone_period.seconds.ago - 2.days)
+    cards(:logo).close
+
+    assert_no_difference -> { Card.postponed.count } do
+      Card.auto_postpone_all_due
+    end
+  end
 end
