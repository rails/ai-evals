--- /dev/null
+++ b/app/models/account/storage_usage.rb
@@ -0,0 +1,21 @@
+module Account::StorageUsage
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    bytes = self[:bytes_used]
+    (bytes.present? && bytes > 0) ? bytes : boards.sum(:bytes_used)
+  end
+
+  def calculate_bytes_used_later
+    Account::CalculateBytesUsedJob.perform_later(self)
+  end
+
+  def calculate_bytes_used_now
+    update_columns(bytes_used: boards.sum(:bytes_used))
+  end
+
+  def recalculate_storage_usage
+    boards.find_each(&:calculate_bytes_used_now)
+    calculate_bytes_used_now
+  end
+end
