diff --git a/test/models/storage_usage_test.rb b/test/models/storage_usage_test.rb
new file mode 100644
index 0000000..b988a8a
--- /dev/null
+++ b/test/models/storage_usage_test.rb
@@ -0,0 +1,288 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+  end
+
+  test "initial bytes_used is 0 when no attachments exist" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "tracks card images" do
+    card = @board.cards.create!(title: "Card with image")
+    blob = create_blob(data: "image data 12345", filename: "test.png", content_type: "image/png")
+
+    perform_enqueued_jobs do
+      card.image.attach(blob)
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+
+    # Purge the image
+    perform_enqueued_jobs do
+      card.image.purge
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "tracks files embedded in card descriptions" do
+    card = @board.cards.create!(title: "Card with description embed")
+    blob = create_blob(data: "card description embed content", filename: "doc.txt")
+
+    perform_enqueued_jobs do
+      card.update!(description: ActionText::Content.new("Description").append_attachables(blob))
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+
+    # Remove the embed
+    perform_enqueued_jobs do
+      card.update!(description: ActionText::Content.new("Description without embed"))
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "tracks files embedded in comments" do
+    card = @board.cards.create!(title: "Card for comments")
+    card.publish
+    blob = create_blob(data: "comment embed content here", filename: "comment_file.txt")
+
+    comment = nil
+    perform_enqueued_jobs do
+      comment = card.comments.create!(body: ActionText::Content.new("Comment").append_attachables(blob))
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+
+    # Destroy comment
+    perform_enqueued_jobs do
+      comment.destroy!
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "tracks files embedded in board descriptions" do
+    blob = create_blob(data: "board public description content", filename: "board.txt")
+
+    perform_enqueued_jobs do
+      @board.update!(public_description: ActionText::Content.new("Board description").append_attachables(blob))
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+
+    # Remove embed
+    perform_enqueued_jobs do
+      @board.update!(public_description: ActionText::Content.new("Board description without embed"))
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "moving a card to another board moves the storage usage" do
+    card = @board.cards.create!(title: "Card to move")
+    blob = create_blob(data: "card image content", filename: "img.png", content_type: "image/png")
+
+    perform_enqueued_jobs do
+      card.image.attach(blob)
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal 0, @other_board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+
+    perform_enqueued_jobs do
+      card.move_to(@other_board)
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal blob.byte_size, @other_board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "destroying a card removes its storage from board and account" do
+    card = @board.cards.create!(title: "Card to destroy")
+    blob = create_blob(data: "card image content", filename: "img.png", content_type: "image/png")
+
+    perform_enqueued_jobs do
+      card.image.attach(blob)
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    perform_enqueued_jobs do
+      card.destroy!
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "destroying a board removes its storage from account" do
+    card = @board.cards.create!(title: "Card on board")
+    blob = create_blob(data: "board card image", filename: "img.png", content_type: "image/png")
+
+    perform_enqueued_jobs do
+      card.image.attach(blob)
+    end
+
+    assert_equal blob.byte_size, @account.reload.bytes_used
+
+    perform_enqueued_jobs do
+      @board.destroy!
+    end
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "account usage sums all boards" do
+    card1 = @board.cards.create!(title: "Card on board 1")
+    blob1 = create_blob(data: "board 1 content", filename: "1.png", content_type: "image/png")
+
+    card2 = @other_board.cards.create!(title: "Card on board 2")
+    blob2 = create_blob(data: "board 2 larger content", filename: "2.png", content_type: "image/png")
+
+    perform_enqueued_jobs do
+      card1.image.attach(blob1)
+      card2.image.attach(blob2)
+    end
+
+    assert_equal blob1.byte_size, @board.reload.bytes_used
+    assert_equal blob2.byte_size, @other_board.reload.bytes_used
+    assert_equal blob1.byte_size + blob2.byte_size, @account.reload.bytes_used
+  end
+
+  test "user avatars and exports do not count towards storage usage" do
+    user = users(:david)
+    user.avatar.attach(io: File.open(file_fixture("avatar.svg")), filename: "avatar.svg", content_type: "image/svg+xml")
+
+    export = @account.exports.create!(user: user)
+    export_blob = create_blob(data: "export zip content", filename: "export.zip")
+    export.file.attach(export_blob)
+
+    @board.calculate_bytes_used_now
+    @account.calculate_bytes_used_now
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "replacing a card image updates the bytes_used" do
+    card = @board.cards.create!(title: "Card with image to replace")
+    blob1 = create_blob(data: "short image", filename: "img1.png", content_type: "image/png")
+    blob2 = create_blob(data: "a much longer image with more bytes", filename: "img2.png", content_type: "image/png")
+
+    perform_enqueued_jobs do
+      card.image.attach(blob1)
+    end
+
+    assert_equal blob1.byte_size, @board.reload.bytes_used
+    assert_equal blob1.byte_size, @account.reload.bytes_used
+
+    perform_enqueued_jobs do
+      card.image.attach(blob2)
+    end
+
+    assert_equal blob2.byte_size, @board.reload.bytes_used
+    assert_equal blob2.byte_size, @account.reload.bytes_used
+  end
+
+  test "combined storage on a single board with all 4 attachment types" do
+    # 1. Board description embed
+    blob_board = create_blob(data: "board public description file", filename: "b.txt")
+    perform_enqueued_jobs do
+      @board.update!(public_description: ActionText::Content.new("Board desc").append_attachables(blob_board))
+    end
+
+    # 2. Card 1 image
+    card1 = @board.cards.create!(title: "Card 1")
+    blob_card1_img = create_blob(data: "card 1 image data", filename: "c1.png", content_type: "image/png")
+    perform_enqueued_jobs do
+      card1.image.attach(blob_card1_img)
+    end
+
+    # 3. Card 1 description embed
+    blob_card1_desc = create_blob(data: "card 1 description file attachment", filename: "c1_desc.txt")
+    perform_enqueued_jobs do
+      card1.update!(description: ActionText::Content.new("Card 1 desc").append_attachables(blob_card1_desc))
+    end
+
+    # 4. Card 1 comment embed
+    card1.publish
+    blob_comment = create_blob(data: "comment attached document", filename: "comment.pdf", content_type: "application/pdf")
+    perform_enqueued_jobs do
+      card1.comments.create!(body: ActionText::Content.new("Comment").append_attachables(blob_comment))
+    end
+
+    # 5. Card 2 image on same board
+    card2 = @board.cards.create!(title: "Card 2")
+    blob_card2_img = create_blob(data: "card 2 image", filename: "c2.png", content_type: "image/png")
+    perform_enqueued_jobs do
+      card2.image.attach(blob_card2_img)
+    end
+
+    expected_total = blob_board.byte_size + blob_card1_img.byte_size + blob_card1_desc.byte_size +
+                     blob_comment.byte_size + blob_card2_img.byte_size
+
+    assert_equal expected_total, @board.reload.bytes_used
+    assert_equal expected_total, @account.reload.bytes_used
+
+    # Move Card 1 to other board: Card 1's image, description embed, and comment embed should move
+    card1_bytes = blob_card1_img.byte_size + blob_card1_desc.byte_size + blob_comment.byte_size
+    remaining_board_bytes = blob_board.byte_size + blob_card2_img.byte_size
+
+    perform_enqueued_jobs do
+      card1.move_to(@other_board)
+    end
+
+    assert_equal remaining_board_bytes, @board.reload.bytes_used
+    assert_equal card1_bytes, @other_board.reload.bytes_used
+    assert_equal expected_total, @account.reload.bytes_used
+  end
+
+  test "multiple embeds in a single card description" do
+    card = @board.cards.create!(title: "Card with multiple embeds")
+    blob1 = create_blob(data: "first embed file", filename: "1.txt")
+    blob2 = create_blob(data: "second embed file with different content", filename: "2.txt")
+
+    perform_enqueued_jobs do
+      card.update!(description: ActionText::Content.new("Multiple").append_attachables([ blob1, blob2 ]))
+    end
+
+    expected = blob1.byte_size + blob2.byte_size
+    assert_equal expected, @board.reload.bytes_used
+    assert_equal expected, @account.reload.bytes_used
+
+    # Remove only one embed
+    perform_enqueued_jobs do
+      card.update!(description: ActionText::Content.new("Single").append_attachables([ blob1 ]))
+    end
+
+    assert_equal blob1.byte_size, @board.reload.bytes_used
+    assert_equal blob1.byte_size, @account.reload.bytes_used
+  end
+
+  private
+    def create_blob(data:, filename:, content_type: "text/plain")
+      ActiveStorage::Blob.create_and_upload!(
+        io: StringIO.new(data),
+        filename: filename,
+        content_type: content_type
+      )
+    end
+end
