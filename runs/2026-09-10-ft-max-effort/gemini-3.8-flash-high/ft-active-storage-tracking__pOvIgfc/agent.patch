new file mode 100644
index 0000000..f408018
--- /dev/null
+++ b/app/models/concerns/storage_usage/attachment.rb
@@ -0,0 +1,54 @@
+module StorageUsage::Attachment
+  extend ActiveSupport::Concern
+
+  included do
+    before_destroy :remember_storage_board
+    after_create_commit :recalculate_storage_usage_on_create
+    after_destroy_commit :recalculate_storage_usage_on_destroy
+  end
+
+  def delete
+    board = storage_usage_board
+    super.tap do
+      if board&.persisted?
+        if self.class.connection.transaction_open?
+          self.class.connection.current_transaction.after_commit { board.calculate_bytes_used_later }
+        else
+          board.calculate_bytes_used_later
+        end
+      end
+    end
+  end
+
+  private
+    def remember_storage_board
+      @storage_usage_board = storage_usage_board
+    end
+
+    def recalculate_storage_usage_on_create
+      storage_usage_board&.calculate_bytes_used_later
+    end
+
+    def recalculate_storage_usage_on_destroy
+      board = @storage_usage_board || storage_usage_board
+      board&.calculate_bytes_used_later if board&.persisted?
+    end
+
+    def storage_usage_board
+      case record_type
+      when "Card"
+        record&.board if name == "image"
+      when "ActionText::RichText"
+        if name == "embeds" && (rich_text = record)
+          case rich_text.record_type
+          when "Board"
+            rich_text.record if rich_text.name == "public_description"
+          when "Card"
+            rich_text.record&.board if rich_text.name == "description"
+          when "Comment"
+            rich_text.record&.card&.board if rich_text.name == "body"
+          end
+        end
+      end
+    end
+end
