--- /dev/null
+++ b/app/models/board/storage_usage.rb
@@ -0,0 +1,71 @@
+module Board::StorageUsage
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :recalculate_account_bytes_used_later
+  end
+
+  def bytes_used
+    self[:bytes_used] || 0
+  end
+
+  def calculate_bytes_used_later
+    Board::CalculateBytesUsedJob.perform_later(self)
+  end
+
+  def calculate_bytes_used_now
+    bytes = calculate_bytes_used
+    update_columns(bytes_used: bytes)
+    account.update_columns(bytes_used: account.boards.sum(:bytes_used))
+  end
+
+  def calculate_bytes_used
+    board_public_description_bytes + cards_image_bytes + cards_description_bytes + comments_body_bytes
+  end
+
+  private
+    def recalculate_account_bytes_used_later
+      account.calculate_bytes_used_later
+    end
+
+    def board_public_description_bytes
+      ActiveStorage::Attachment
+        .where(account_id: account_id, record_type: "ActionText::RichText", name: "embeds")
+        .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+        .joins(:blob)
+        .where(action_text_rich_texts: { record_type: "Board", record_id: id, name: "public_description" })
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def cards_image_bytes
+      ActiveStorage::Attachment
+        .where(account_id: account_id, record_type: "Card", name: "image")
+        .joins("INNER JOIN cards ON cards.id = active_storage_attachments.record_id")
+        .joins(:blob)
+        .where(cards: { board_id: id })
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def cards_description_bytes
+      ActiveStorage::Attachment
+        .where(account_id: account_id, record_type: "ActionText::RichText", name: "embeds")
+        .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+        .joins("INNER JOIN cards ON cards.id = action_text_rich_texts.record_id")
+        .joins(:blob)
+        .where(action_text_rich_texts: { record_type: "Card", name: "description" })
+        .where(cards: { board_id: id })
+        .sum("active_storage_blobs.byte_size")
+    end
+
+    def comments_body_bytes
+      ActiveStorage::Attachment
+        .where(account_id: account_id, record_type: "ActionText::RichText", name: "embeds")
+        .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+        .joins("INNER JOIN comments ON comments.id = action_text_rich_texts.record_id")
+        .joins("INNER JOIN cards ON cards.id = comments.card_id")
+        .joins(:blob)
+        .where(action_text_rich_texts: { record_type: "Comment", name: "body" })
+        .where(cards: { board_id: id })
+        .sum("active_storage_blobs.byte_size")
+    end
+end
