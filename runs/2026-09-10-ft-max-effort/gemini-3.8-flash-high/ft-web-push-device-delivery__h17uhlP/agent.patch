--- /dev/null
+++ b/test/integration/push_notifications_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class PushNotificationsTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    PushSubscription.destroy_all
+    @david = users(:david)
+    @kevin = users(:kevin)
+    sign_in_as @kevin
+  end
+
+  test "complete push notification lifecycle: view settings, subscribe, receive push, unsubscribe" do
+    switch_env("VAPID_PUBLIC_KEY" => "test_public_key", "VAPID_PRIVATE_KEY" => "test_private_key") do
+      # 1. View notification settings
+      get notifications_settings_path
+      assert_response :success
+      assert_select "section[data-controller='notifications']"
+      assert_select "meta[name='vapid-public-key'][content='test_public_key']"
+
+      # 2. Browser subscribes
+      assert_difference -> { @kevin.push_subscriptions.count }, 1 do
+        post user_push_subscriptions_path(@kevin),
+          params: {
+            push_subscription: {
+              endpoint: "https://push.example.com/device/kevin-desktop",
+              p256dh_key: "kevin_p256dh",
+              auth_key: "kevin_auth"
+            }
+          },
+          as: :json
+      end
+      assert_response :created
+
+      subscription = @kevin.push_subscriptions.last
+      assert_equal "https://push.example.com/device/kevin-desktop", subscription.endpoint
+
+      # 3. An event happens that creates a notification for Kevin (David comments on a card Kevin watches)
+      card = cards(:logo)
+      card.watchers << @kevin unless card.watchers.include?(@kevin)
+
+      # Verify notification push delivery
+      delivered_payload = nil
+      WebPush.stubs(:payload_send).with do |params|
+        delivered_payload = JSON.parse(params[:message])
+        assert_equal subscription.endpoint, params[:endpoint]
+        assert_equal subscription.p256dh_key, params[:p256dh]
+        assert_equal subscription.auth_key, params[:auth]
+        true
+      end
+
+      assert_enqueued_with(job: Notification::PushJob) do
+        comment = card.comments.create!(creator: @david, body: "Looking great!")
+        event = Event.create!(creator: @david, action: "comment_created", eventable: comment, board: card.board)
+        Notifier.for(event).notify
+      end
+
+      perform_enqueued_jobs(only: Notification::PushJob)
+
+      # 4. Verify the push payload says what the tray says and opens the card
+      assert_not_nil delivered_payload
+      assert_equal "RE: The logo isn't big enough", delivered_payload["title"]
+      assert_equal "Looking great!", delivered_payload["body"]
+      assert_equal "/cards/#{card.number}", delivered_payload["path"]
+      assert_equal "/cards/#{card.number}", delivered_payload["url"]
+      assert_equal card.id, delivered_payload["card_id"]
+
+      # 5. Kevin unsubscribes
+      assert_difference -> { @kevin.push_subscriptions.count }, -1 do
+        delete user_push_subscriptions_path(@kevin),
+          params: { endpoint: subscription.endpoint },
+          as: :json
+      end
+      assert_response :no_content
+
+      # 6. Another notification does not enqueue push
+      assert_no_enqueued_jobs(only: Notification::PushJob) do
+        comment2 = card.comments.create!(creator: @david, body: "Another comment")
+        event2 = Event.create!(creator: @david, action: "comment_created", eventable: comment2, board: card.board)
+        Notifier.for(event2).notify
+      end
+    end
+  end
+
+  private
+    def switch_env(envs)
+      old_values = envs.keys.index_with { |k| ENV[k] }
+      envs.each { |k, v| ENV[k] = v }
+      yield
+    ensure
+      old_values.each { |k, v| ENV[k] = v }
+    end
+end
