+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    @other_user = users(:kevin)
+    sign_in_as @user
+  end
+
+  test "create push subscription as JSON" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user),
+        params: {
+          push_subscription: {
+            endpoint: "https://push.example.com/sub/123",
+            p256dh_key: "test_p256dh_key",
+            auth_key: "test_auth_key"
+          }
+        },
+        as: :json
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/sub/123", subscription.endpoint
+    assert_equal "test_p256dh_key", subscription.p256dh_key
+    assert_equal "test_auth_key", subscription.auth_key
+  end
+
+  test "create push subscription as HTML" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user),
+        params: {
+          push_subscription: {
+            endpoint: "https://push.example.com/sub/html123",
+            p256dh_key: "test_p256dh_key",
+            auth_key: "test_auth_key"
+          }
+        }
+    end
+
+    assert_redirected_to notifications_settings_path
+  end
+
+  test "create updates existing subscription with same endpoint" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/existing",
+      p256dh_key: "old_key",
+      auth_key: "old_auth"
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user),
+        params: {
+          push_subscription: {
+            endpoint: "https://push.example.com/sub/existing",
+            p256dh_key: "new_key",
+            auth_key: "new_auth"
+          }
+        },
+        as: :json
+    end
+
+    assert_response :created
+    assert_equal "new_key", subscription.reload.p256dh_key
+    assert_equal "new_auth", subscription.auth_key
+  end
+
+  test "create removes endpoint if registered by another user" do
+    other_sub = @other_user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/shared",
+      p256dh_key: "other_key",
+      auth_key: "other_auth"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user),
+        params: {
+          push_subscription: {
+            endpoint: "https://push.example.com/sub/shared",
+            p256dh_key: "david_key",
+            auth_key: "david_auth"
+          }
+        },
+        as: :json
+    end
+
+    assert_response :created
+    assert_not PushSubscription.exists?(other_sub.id)
+  end
+
+  test "destroy by ID as JSON" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/to_delete",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy by endpoint as JSON" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/endpoint_delete",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user),
+        params: { endpoint: subscription.endpoint },
+        as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy by nested push_subscription endpoint param" do
