--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,125 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    PushSubscription.destroy_all
+    @user = users(:david)
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "validates required attributes" do
+    subscription = PushSubscription.new
+    assert_not subscription.valid?
+    assert_includes subscription.errors[:user], "must exist"
+    assert_includes subscription.errors[:endpoint], "can't be blank"
+    assert_includes subscription.errors[:p256dh_key], "can't be blank"
+    assert_includes subscription.errors[:auth_key], "can't be blank"
+  end
+
+  test "validates uniqueness of endpoint" do
+    @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/unique",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    duplicate = @user.push_subscriptions.build(
+      endpoint: "https://push.example.com/unique",
+      p256dh_key: "key2",
+      auth_key: "auth2"
+    )
+    assert_not duplicate.valid?
+    assert_includes duplicate.errors[:endpoint], "has already been taken"
+  end
+
+  test "push sends payload via WebPush when configured" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/send",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    switch_env("VAPID_PUBLIC_KEY" => "pub_key", "VAPID_PRIVATE_KEY" => "priv_key") do
+      WebPush.expects(:payload_send).with(
+        message: @notification.to_push_payload,
+        endpoint: subscription.endpoint,
+        p256dh: "p256dh",
+        auth: "auth",
+        vapid: {
+          public_key: "pub_key",
+          private_key: "priv_key",
+          subject: "mailto:support@fizzy.do"
+        }
+      )
+
+      subscription.push(@notification)
+    end
+  end
+
+  test "push destroys subscription on ExpiredSubscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/expired",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    fake_response = stub(body: "Gone", inspect: "410 Gone")
+    switch_env("VAPID_PUBLIC_KEY" => "pub_key", "VAPID_PRIVATE_KEY" => "priv_key") do
+      WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(fake_response, "push.example.com"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        subscription.push(@notification)
+      end
+    end
+  end
+
+  test "push destroys subscription on InvalidSubscription" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/invalid",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    fake_response = stub(body: "Not Found", inspect: "404 Not Found")
+    switch_env("VAPID_PUBLIC_KEY" => "pub_key", "VAPID_PRIVATE_KEY" => "priv_key") do
+      WebPush.stubs(:payload_send).raises(WebPush::InvalidSubscription.new(fake_response, "push.example.com"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        subscription.push(@notification)
+      end
+    end
+  end
+
+  test "push does nothing when not configured" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/unconfigured",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+
+    switch_env("VAPID_PUBLIC_KEY" => nil, "VAPID_PRIVATE_KEY" => nil) do
+      WebPush.expects(:payload_send).never
+      subscription.push(@notification)
+    end
+  end
+
+  test "deactivating user destroys push subscriptions" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/deactivate",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    @user.deactivate
+    assert_not PushSubscription.exists?(subscription.id)
+  end
+
+  private
+    def switch_env(envs)
+      old_values = envs.keys.index_with { |k| ENV[k] }
+      envs.each { |k, v| ENV[k] = v }
+      yield
+    ensure
+      old_values.each { |k, v| ENV[k] = v }
+    end
+end
