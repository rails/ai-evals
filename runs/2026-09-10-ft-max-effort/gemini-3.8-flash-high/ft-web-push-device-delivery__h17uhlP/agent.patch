diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..b0b4435
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,39 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+
+  def create
+    PushSubscription.where(endpoint: push_subscription_params[:endpoint]).where.not(user: @user).destroy_all
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    subscription.update!(push_subscription_params.merge(user_agent: request.user_agent))
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications enabled" }
+      format.json { render json: subscription, status: :created }
+    end
+  end
+
+  def destroy
+    subscription = @user.push_subscriptions.find_by(id: params[:id]) ||
+                   @user.push_subscriptions.find_by(endpoint: endpoint_param)
+    subscription&.destroy
+
+    respond_to do |format|
+      format.html { redirect_to notifications_settings_path, notice: "Push notifications disabled" }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+
+    def endpoint_param
+      params[:endpoint] || params.dig(:push_subscription, :endpoint)
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..3da9080
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,190 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { getMetaContent } from "helpers/meta_helpers"
+
+export default class extends Controller {
+  static targets = [ "toggle", "details", "explainer" ]
+  static values = { userId: String, vapidPublicKey: String, url: String }
+
+  async connect() {
+    if (!this.supported) {
+      if (this.hasToggleTarget) this.toggleTarget.disabled = true
+      return
+    }
+
+    if (Notification.permission === "denied") {
+      if (this.hasToggleTarget) {
+        this.toggleTarget.checked = false
+        this.toggleTarget.disabled = true
+      }
+      this.element.classList.remove("notifications--on")
+      this.showDetails()
+      return
+    }
+
+    this.hideDetails()
+    await this.syncStatus()
+  }
+
+  async syncStatus() {
+    try {
+      const registration = await this.getRegistration()
+      const subscription = await registration?.pushManager?.getSubscription()
+
+      if (subscription) {
+        if (this.hasToggleTarget) this.toggleTarget.checked = true
+        this.element.classList.add("notifications--on")
+      } else {
+        if (this.hasToggleTarget) this.toggleTarget.checked = false
+        this.element.classList.remove("notifications--on")
+      }
+    } catch (error) {
+      console.error("Failed to check push subscription", error)
+    }
+  }
+
+  async toggle() {
+    if (this.toggleTarget.checked) {
+      await this.subscribe()
+    } else {
+      await this.unsubscribe()
+    }
+  }
+
+  async subscribe() {
+    try {
+      const permission = await Notification.requestPermission()
+      if (permission !== "granted") {
+        this.toggleTarget.checked = false
+        this.element.classList.remove("notifications--on")
+        if (permission === "denied") {
+          this.toggleTarget.disabled = true
+          this.showDetails()
+        }
+        return
+      }
+
+      this.hideDetails()
+
+      const registration = await this.getRegistration()
+      let subscription = await registration?.pushManager?.getSubscription()
+
+      if (!subscription) {
+        const vapidKey = this.vapidPublicKeyValue || getMetaContent("vapid-public-key")
+        if (!vapidKey) {
+          throw new Error("VAPID public key not found")
+        }
+        subscription = await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.urlBase64ToUint8Array(vapidKey)
+        })
+      }
+
+      const { p256dhKey, authKey } = this.getSubscriptionKeys(subscription)
+
+      const response = await post(this.urlValue, {
+        body: {
+          push_subscription: {
+            endpoint: subscription.endpoint,
+            p256dh_key: p256dhKey,
+            auth_key: authKey
+          }
+        },
+        responseKind: "json"
+      })
+
+      if (response.ok) {
+        this.element.classList.add("notifications--on")
+        this.toggleTarget.checked = true
+      } else {
+        throw new Error("Server rejected push subscription")
+      }
+    } catch (error) {
+      console.error("Failed to subscribe to push notifications", error)
+      this.toggleTarget.checked = false
+      this.element.classList.remove("notifications--on")
+    }
+  }
+
+  async unsubscribe() {
+    try {
+      const registration = await this.getRegistration()
+      const subscription = await registration?.pushManager?.getSubscription()
+
+      if (subscription) {
+        await destroy(this.urlValue, {
+          query: { endpoint: subscription.endpoint },
+          responseKind: "json"
+        })
+        await subscription.unsubscribe()
+      }
+
+      this.element.classList.remove("notifications--on")
+      this.toggleTarget.checked = false
+    } catch (error) {
+      console.error("Failed to unsubscribe", error)
+    }
+  }
+
+  showDetails() {
+    if (this.hasExplainerTarget) this.explainerTarget.removeAttribute("hidden")
+    this.detailsTargets.forEach(el => el.removeAttribute("hidden"))
+  }
+
+  hideDetails() {
+    if (this.hasExplainerTarget) this.explainerTarget.setAttribute("hidden", "hidden")
+    this.detailsTargets.forEach(el => el.setAttribute("hidden", "hidden"))
+  }
+
+  get supported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  async getRegistration() {
+    if (!("serviceWorker" in navigator)) return null
+    if (navigator.serviceWorker.ready) {
+      return await navigator.serviceWorker.ready
+    }
+    return (await navigator.serviceWorker.getRegistration()) || (await navigator.serviceWorker.register("/service-worker.js"))
+  }
+
+  getSubscriptionKeys(subscription) {
+    const json = subscription.toJSON()
+    let p256dhKey = json.keys?.p256dh
+    let authKey = json.keys?.auth
+
+    if (!p256dhKey && subscription.getKey) {
+      p256dhKey = this.arrayBufferToBase64(subscription.getKey("p256dh"))
+    }
+    if (!authKey && subscription.getKey) {
+      authKey = this.arrayBufferToBase64(subscription.getKey("auth"))
+    }
+
+    return { p256dhKey, authKey }
+  }
+
+  urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+    return outputArray
+  }
+
+  arrayBufferToBase64(buffer) {
+    if (!buffer) return ""
+    const bytes = new Uint8Array(buffer)
+    let binary = ""
+    for (let i = 0; i < bytes.byteLength; i++) {
+      binary += String.fromCharCode(bytes[i])
+    }
+    return window.btoa(binary)
+      .replace(/\+/g, "-")
+      .replace(/\//g, "_")
+      .replace(/=+$/, "")
+  }
+}
