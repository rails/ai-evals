+require "test_helper"
+
+class Notification::PushTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    PushSubscription.destroy_all
+    @david = users(:david)
+    @kevin = users(:kevin)
+  end
+
+  test "title and body for card assignment event" do
+    notification = notifications(:logo_assignment_kevin)
+    assert_equal "The logo isn't big enough", notification.title
+    assert_equal "Assigned to Kevin", notification.body
+    assert_equal "/cards/#{notification.card.number}", notification.path
+  end
+
+  test "title and body for comment created event" do
+    notification = notifications(:layout_commented_kevin)
+    assert_equal "RE: Layout is broken", notification.title
+    assert_equal "The text is overflowing the container.", notification.body
+    assert_equal "/cards/#{notification.card.number}", notification.path
+  end
+
+  test "title and body for mention notification" do
+    notification = notifications(:logo_mentioned_david)
+    assert_equal "JZ @mentioned you", notification.title
+    assert_equal "I agree.", notification.body
+    assert_equal "/cards/#{notification.card.number}", notification.path
+  end
+
+  test "to_push_payload contains all required attributes" do
+    notification = notifications(:logo_assignment_kevin)
+    payload = JSON.parse(notification.to_push_payload)
+
+    assert_equal notification.title, payload["title"]
+    assert_equal notification.body, payload["body"]
+    assert_equal notification.path, payload["path"]
+    assert_equal notification.path, payload["url"]
+    assert_equal notification.card.id, payload["card_id"]
+  end
+
+  test "enqueues push job on create if user has push subscriptions" do
+    @kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/1",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    card = cards(:text)
+    event = events(:text_published)
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notification.create!(user: @kevin, creator: @david, source: event, card: card)
+    end
+  end
+
+  test "does not enqueue push job on create if user has no push subscriptions" do
+    assert_equal 0, @david.push_subscriptions.count
+
+    card = cards(:text)
+    event = events(:text_published)
+
+    assert_no_enqueued_jobs(only: Notification::PushJob) do
+      Notification.create!(user: @david, creator: @kevin, source: event, card: card)
+    end
+  end
+
+  test "enqueues push job on update if source_id changed and user has subscriptions" do
+    @kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/1",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    notification = notifications(:logo_assignment_kevin)
+    new_event = events(:logo_published)
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      notification.update!(source: new_event)
+    end
+  end
+
+  test "does not enqueue push job on mark read or unread" do
+    @kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/1",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_no_enqueued_jobs(only: Notification::PushJob) do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "deliver_push pushes to all subscriptions of user" do
+    sub1 = @kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/desktop",
+      p256dh_key: "key1",
+      auth_key: "auth1"
+    )
+    sub2 = @kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/mobile",
+      p256dh_key: "key2",
+      auth_key: "auth2"
+    )
+
+    notification = notifications(:logo_assignment_kevin)
+
+    switch_env("VAPID_PUBLIC_KEY" => "pub", "VAPID_PRIVATE_KEY" => "priv") do
+      PushSubscription.any_instance.expects(:push).with(notification).twice
+      notification.deliver_push
+    end
+  end
+
+  private
+    def switch_env(envs)
+      old_values = envs.keys.index_with { |k| ENV[k] }
+      envs.each { |k, v| ENV[k] = v }
+      yield
+    ensure
+      old_values.each { |k, v| ENV[k] = v }
+    end
+end
