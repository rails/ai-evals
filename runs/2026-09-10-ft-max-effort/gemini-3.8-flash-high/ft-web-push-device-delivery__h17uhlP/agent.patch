+      endpoint: "https://push.example.com/sub/nested_delete",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user),
+        params: { push_subscription: { endpoint: subscription.endpoint } },
+        as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy as HTML" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/html_delete",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription)
+    end
+
+    assert_redirected_to notifications_settings_path
+  end
+
+  test "cannot subscribe for another user" do
+    post user_push_subscriptions_path(@other_user),
+      params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/sub/forbidden",
+          p256dh_key: "key",
+          auth_key: "auth"
+        }
+      },
+      as: :json
+
+    assert_response :forbidden
+  end
+
+  test "cannot destroy another user subscription" do
+    subscription = @other_user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/sub/other_protected",
+      p256dh_key: "key",
+      auth_key: "auth"
+    )
+
+    assert_no_difference -> { PushSubscription.count } do
+      delete user_push_subscription_path(@other_user, subscription), as: :json
+    end
+
+    assert_response :forbidden
+  end
+end
