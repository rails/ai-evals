diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..b5e60da
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  include SearchTestHelper
+
+  setup do
+    Current.session = sessions(:david)
+    @account = Account.create_with_owner(
+      account: { name: "Test Account" },
+      owner: { name: "Test Owner", identity: identities(:david) }
+    )
+    @user = @account.users.find_by(role: :owner)
+    Current.account = @account
+    Current.user = @user
+    @other_account = accounts("37s")
+  end
+
+  test "permanently removes all data associated with accounts canceled more than 30 days ago" do
+    board = @account.boards.create!(name: "Board 1", creator: @user)
+
+    card = board.cards.create!(title: "Due Card", creator: @user, status: "published")
+    card.comments.create!(body: "Due comment", creator: @user)
+    card.steps.create!(content: "Due step")
+    tag = @account.tags.create!(title: "due_tag")
+    card.tags << tag
+    card.pins.create!(user: @user)
+    card.watches.create!(user: @user)
+    card.reactions.create!(content: "🎉", reacter: @user)
+    card.toggle_assignment(@user)
+    card.close(user: @user)
+
+    Filter.remember(creator: @user, terms: "due")
+    @user.search_queries.create!(terms: "due search")
+
+    webhook = board.webhooks.create!(name: "Due Hook", url: "https://example.com/due", signing_secret: "secret")
+    webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    Storage::Entry.record(account: @account, delta: 100, operation: "reconcile")
+
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    account_id = @account.id
+    user_identity = @user.identity
+
+    uuid_type = ActiveRecord::Type::Uuid.new
+    binary_id = uuid_type.serialize(account_id)
+
+    tables_with_account_id = ActiveRecord::Base.connection.tables.select do |tbl|
+      ActiveRecord::Base.connection.columns(tbl).any? { |col| col.name == "account_id" }
+    end
+
+    assert_predicate @account, :due_for_incineration?
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account_id), "Account should be permanently deleted"
+
+    tables_with_account_id.each do |tbl|
+      count = ActiveRecord::Base.connection.select_value(
+        "SELECT COUNT(*) FROM #{tbl} WHERE account_id = ?",
+        "COUNT",
+        [ ActiveRecord::Relation::QueryAttribute.new("account_id", binary_id, ActiveRecord::Type::Binary.new) ]
+      )
+      assert_equal 0, count, "Expected 0 records in #{tbl} for incinerated account, found #{count}"
+    end
+
+    assert Identity.exists?(user_identity.id), "Identity should not be deleted"
+    assert Account.exists?(@other_account.id), "Other account should remain intact"
+  end
+
+  test "does not incinerate accounts canceled less than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 10.days.ago)
+
+    assert_not @account.due_for_incineration?
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "does not incinerate active accounts" do
+    assert_not @account.cancelled?
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "does not incinerate reactivated accounts" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 35.days.ago)
+    @account.reactivate
+    @account.reload
+
+    assert_not @account.cancelled?
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+  end
+
+  test "recurring job is configured in config/recurring.yml" do
+    recurring_config = Rails.application.config_for(:recurring)
+    task = recurring_config[:incinerate_due_accounts] || recurring_config["incinerate_due_accounts"]
+
+    assert task.present?, "Expected incinerate_due_accounts task in config/recurring.yml"
+    assert_equal "Account::IncinerateDueJob", task[:class] || task["class"]
+  end
+end
