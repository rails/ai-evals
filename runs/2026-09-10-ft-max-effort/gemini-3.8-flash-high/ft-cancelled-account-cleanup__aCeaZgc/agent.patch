diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..037952f
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = Account.create_with_owner(
+      account: { name: "Test Incineratable" },
+      owner: { name: "Owner", identity: identities(:david) }
+    )
+    @user = @account.users.find_by(role: :owner)
+    Current.account = @account
+    Current.user = @user
+  end
+
+  test "due_for_incineration scope includes accounts canceled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes accounts canceled less than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 10.days.ago)
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes active accounts" do
+    assert_not @account.cancelled?
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes reactivated accounts" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 35.days.ago)
+    @account.reactivate
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration? returns true when canceled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 31.days.ago)
+
+    assert_predicate @account, :due_for_incineration?
+  end
+
+  test "due_for_incineration? returns false when canceled less than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update!(created_at: 10.days.ago)
+
+    assert_not @account.due_for_incineration?
+  end
+
+  test "due_for_incineration? returns false when not canceled" do
+    assert_not @account.due_for_incineration?
+  end
+
+  test "incinerate destroys account and cleans up all data" do
+    board = @account.boards.create!(name: "Test Board", creator: @user)
+    card = board.cards.create!(title: "Card", creator: @user, status: "published")
+    card.comments.create!(body: "Comment", creator: @user)
+    @account.cancel(initiated_by: @user)
+
+    account_id = @account.id
+    @account.incinerate
+
+    assert_not Account.exists?(account_id)
+    assert_not Board.where(account_id: account_id).exists?
+    assert_not Card.where(account_id: account_id).exists?
+    assert_not Comment.where(account_id: account_id).exists?
+    assert_not Account::Cancellation.where(account_id: account_id).exists?
+  end
+
+  test "incinerate_due incinerates only due accounts" do
+    due_account = @account
+    due_account.cancel(initiated_by: @user)
+    due_account.cancellation.update!(created_at: 35.days.ago)
+
+    recent_account = Account.create_with_owner(
+      account: { name: "Recent Account" },
+      owner: { name: "Owner 2", identity: identities(:kevin) }
+    )
+    recent_user = recent_account.users.find_by(role: :owner)
+    recent_account.cancel(initiated_by: recent_user)
+    recent_account.cancellation.update!(created_at: 5.days.ago)
+
+    Account.incinerate_due
+
+    assert_not Account.exists?(due_account.id)
+    assert Account.exists?(recent_account.id)
+  end
+end
