@@ -0,0 +1,45 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+  before_action :set_account, except: :index
+
+  def index
+    @accounts = Account.order(created_at: :desc)
+  end
+
+  def show
+  end
+
+  def comp
+    @account.comp!
+    redirect_to saas.admin_account_path(@account), notice: "Account comped"
+  end
+
+  def uncomp
+    @account.uncomp!
+    redirect_to saas.admin_account_path(@account), notice: "Account uncomped"
+  end
+
+  def override
+    card_count = params[:card_count].presence || params.dig(:overridden_limit, :card_count).presence || params.dig(:account, :card_count).presence
+    bytes_used = params[:bytes_used].presence || params.dig(:overridden_limit, :bytes_used).presence || params.dig(:account, :bytes_used).presence
+
+    override = @account.overridden_limit || @account.build_overridden_limit
+    override.card_count = card_count.to_i if card_count.present?
+    override.bytes_used = bytes_used.to_i if bytes_used.present?
+    override.save!
+
+    redirect_to saas.admin_account_path(@account), notice: "Override updated"
+  end
+
+  def reset
+    @account.overridden_limit&.destroy
+    redirect_to saas.admin_account_path(@account), notice: "Override reset"
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:id]) ||
+                 Account.find_by(external_account_id: params[:id]) ||
+                 Account.find(params[:id])
+    end
+end
