@@ -0,0 +1,37 @@
+class CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def show
+    create
+  end
+
+  def create
+    plan_key = params[:plan] || (Current.account.plan.to_s == "Unlimited" ? "unlimited_plus" : "unlimited")
+    plan = Plan[plan_key]
+
+    session = Stripe::Checkout::Session.create(
+      customer: Current.account.subscription&.stripe_customer_id,
+      customer_email: Current.account.owner_email,
+      client_reference_id: Current.account.id,
+      mode: "subscription",
+      line_items: [ {
+        price: plan.stripe_price_id,
+        quantity: 1
+      } ],
+      success_url: account_settings_url(script_name: Current.account.slug),
+      cancel_url: account_settings_url(script_name: Current.account.slug),
+      metadata: {
+        account_id: Current.account.id,
+        plan_key: plan.key
+      },
+      subscription_data: {
+        metadata: {
+          account_id: Current.account.id,
+          plan_key: plan.key
+        }
+      }
+    )
+
+    redirect_to session.url, allow_other_host: true
+  end
+end
