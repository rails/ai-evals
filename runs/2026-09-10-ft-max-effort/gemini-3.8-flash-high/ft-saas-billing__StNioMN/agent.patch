+require "test_helper"
+
+class SettingsAndBillingTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "admins see their plan and Upgrade in settings" do
+    sign_in_as :mike # Mike is owner/admin of Initech
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_includes response.body, "Free"
+    assert_includes response.body, "Upgrade"
+  end
+
+  test "admins see paid plan in settings" do
+    sign_in_as :mike
+    @account.create_subscription!(
+      stripe_customer_id: "cus_test_unlimited",
+      stripe_subscription_id: "sub_test_unlimited",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_includes response.body, "Unlimited"
+    assert_includes response.body, "Upgrade"
+  end
+
+  test "non-admins do not see plan or Upgrade in settings" do
+    user = @account.users.create!(
+      identity: identities(:jz),
+      role: :member,
+      name: "Regular Member"
+    )
+    sign_in_as :jz
+
+    get account_settings_path(script_name: @account.slug)
+
+    assert_response :success
+    assert_not_includes response.body, "Current plan:"
+    assert_not_includes response.body, "Upgrade"
+  end
+
+  test "upgrade initiates Stripe checkout session and redirects to Stripe" do
+    sign_in_as :mike
+
+    post saas.checkout_path(script_name: @account.slug)
+
+    assert_response :redirect
+    assert_match %r{\Ahttps://checkout\.stripe\.com}, response.location
+  end
+
+  test "customer portal redirects to Stripe billing portal" do
+    sign_in_as :mike
+    @account.create_subscription!(
+      stripe_customer_id: "cus_test_portal",
+      stripe_subscription_id: "sub_test_portal",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    post saas.customer_portal_path(script_name: @account.slug)
+
+    assert_response :redirect
+    assert_match %r{\Ahttps://billing\.stripe\.com}, response.location
+  end
+
+  test "non-admins cannot access checkout" do
+    @account.users.create!(
+      identity: identities(:jz),
+      role: :member,
+      name: "Regular Member"
+    )
+    sign_in_as :jz
+
+    post saas.checkout_path(script_name: @account.slug)
+    assert_response :forbidden
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..b463020
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @endpoint_secret = "whsec_dev_only_secret"
+    ENV["STRIPE_WEBHOOK_SECRET"] = @endpoint_secret
+  end
+
+  def generate_signature(payload, secret = @endpoint_secret)
+    timestamp = Time.now.to_i
+    signed_payload = "#{timestamp}.#{payload}"
+    signature = OpenSSL::HMAC.hexdigest("sha256", secret, signed_payload)
+    "t=#{timestamp},v1=#{signature}"
+  end
+
+  test "checkout.session.completed creates subscription for account" do
+    payload = {
+      id: "evt_test_checkout",
+      type: "checkout.session.completed",
+      data: {
+        object: {
+          id: "cs_test_123",
+          customer: "cus_new_123",
+          subscription: "sub_new_123",
+          client_reference_id: @account.id,
+          metadata: {
+            account_id: @account.id,
+            plan_key: "unlimited"
+          }
+        }
+      }
+    }.to_json
+
+    untenanted do
+      post saas.stripe_webhooks_path,
+        params: payload,
+        headers: { "Stripe-Signature" => generate_signature(payload), "Content-Type" => "application/json" }
+    end
+
+    assert_response :ok
+    assert @account.reload.paid?
+    assert_equal "unlimited", @account.subscription.plan_key
+    assert_equal "cus_new_123", @account.subscription.stripe_customer_id
+    assert_equal "sub_new_123", @account.subscription.stripe_subscription_id
+    assert_equal "active", @account.subscription.status
+  end
+
+  test "customer.subscription.updated updates subscription plan and status" do
+    sub = @account.create_subscription!(
+      stripe_customer_id: "cus_existing",
+      stripe_subscription_id: "sub_existing",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    payload = {
+      id: "evt_test_sub_update",
+      type: "customer.subscription.updated",
+      data: {
+        object: {
+          id: "sub_existing",
+          customer: "cus_existing",
+          status: "active",
+          current_period_end: 1.month.from_now.to_i,
+          items: {
+            data: [
+              {
+                price: {
+                  id: "price_unlimited_plus_extra"
+                }
+              }
+            ]
+          },
+          metadata: {
+            account_id: @account.id
+          }
+        }
+      }
+    }.to_json
+
+    untenanted do
+      post saas.stripe_webhooks_path,
+        params: payload,
+        headers: { "Stripe-Signature" => generate_signature(payload), "Content-Type" => "application/json" }
+    end
+
+    assert_response :ok
+    assert_equal "unlimited_plus", sub.reload.plan_key
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "customer.subscription.deleted marks subscription as canceled" do
+    sub = @account.create_subscription!(
+      stripe_customer_id: "cus_existing_cancel",
+      stripe_subscription_id: "sub_existing_cancel",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    payload = {
+      id: "evt_test_sub_deleted",
+      type: "customer.subscription.deleted",
+      data: {
+        object: {
+          id: "sub_existing_cancel",
+          customer: "cus_existing_cancel",
+          status: "canceled"
+        }
+      }
+    }.to_json
+
+    untenanted do
+      post saas.stripe_webhooks_path,
+        params: payload,
+        headers: { "Stripe-Signature" => generate_signature(payload), "Content-Type" => "application/json" }
+    end
+
+    assert_response :ok
+    assert_equal "canceled", sub.reload.status
+    assert_not @account.paid?
+    assert_equal "Free", @account.plan.name
+  end
+
+  test "invalid webhook signature is rejected" do
+    payload = { type: "checkout.session.completed" }.to_json
+
+    untenanted do
+      post saas.stripe_webhooks_path,
+        params: payload,
+        headers: { "Stripe-Signature" => "invalid_signature", "Content-Type" => "application/json" }
+    end
+
+    assert_response :bad_request
+  end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..9abdc5c
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,102 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free account has default free plan with 1000 cards and 1 GB storage" do
+    assert_equal "Free", @account.plan.name
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+    assert_not @account.paid?
+    assert_not @account.comped?
+  end
+
+  test "card count and nearing card limit countdown" do
+    @account.update_column(:cards_count, 0)
+    assert_equal 1000, @account.cards_left
+    assert_not @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 950)
+    assert_equal 50, @account.cards_left
+    assert @account.nearing_card_limit?
+    assert_not @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 1000)
+    assert_equal 0, @account.cards_left
+    assert_not @account.nearing_card_limit?
+    assert @account.exceeding_card_limit?
+
+    @account.update_column(:cards_count, 1005)
+    assert_equal 0, @account.cards_left
+    assert @account.exceeding_card_limit?
+  end
+
+  test "overridden limit overrides card count and bytes used" do
+    @account.update_column(:cards_count, 10)
+    assert_equal 10, @account.cards_count
+
+    override = @account.create_overridden_limit!(card_count: 950, bytes_used: 800.megabytes)
+    assert_equal 950, @account.cards_count
+    assert_equal 800.megabytes, @account.bytes_used
+    assert_equal 50, @account.cards_left
+    assert @account.nearing_card_limit?
+
+    override.destroy
+    @account.reload
+    assert_equal 10, @account.cards_count
+  end
+
+  test "comp and uncomp" do
+    assert_not @account.comped?
+
+    @account.comp!
+    assert @account.comped?
+
+    @account.update_column(:cards_count, 5000)
+    Account.any_instance.stubs(:bytes_used).returns(10.gigabytes)
+
+    assert_nil @account.card_limit
+    assert_not @account.exceeding_card_limit?
+    assert_not @account.exceeding_storage_limit?
+
+    @account.uncomp!
+    assert_not @account.comped?
+    assert_equal 1000, @account.card_limit
+    assert @account.exceeding_card_limit?
+  end
+
+  test "paid subscription brings its own storage allowance" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_test_unlimited",
+      stripe_subscription_id: "sub_test_unlimited",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    assert @account.paid?
+    assert_equal "Unlimited", @account.plan.name
+    assert_nil @account.card_limit
+    assert_not @account.exceeding_card_limit?
+    assert_equal 5.gigabytes, @account.storage_limit
+
+    @account.subscription.update!(plan_key: "unlimited_plus")
+    assert_equal "Unlimited+", @account.plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "storage exception overrides plan storage limit" do
+    @account.create_subscription!(
+      stripe_customer_id: "cus_test_unlimited2",
+      stripe_subscription_id: "sub_test_unlimited2",
+      plan_key: "unlimited",
+      status: "active"
+    )
+
+    assert_equal 5.gigabytes, @account.storage_limit
+    @account.add_storage_exception(10.gigabytes)
+    assert_equal 10.gigabytes, @account.storage_limit
+  end
+end
