+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @draft = cards(:unfinished_thoughts)
+  end
+
+  test "can draft cards via HTML when card limit is exceeded" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1000)
+    @board.cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "cannot create cards via API when card limit is exceeded" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "API Card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "cannot publish cards when card limit is exceeded" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1000)
+
+    post card_publish_path(@draft, script_name: @account.slug)
+
+    assert_response :forbidden
+    assert @draft.reload.drafted?
+  end
+
+  test "staff can create via API and publish when card limit is exceeded" do
+    sign_in_as :mike
+    Identity.any_instance.stubs(:staff?).returns(true)
+    @account.update_column(:cards_count, 1000)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "Staff Card" } },
+        as: :json
+    end
+
+    assert_response :created
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+
+  test "paid plan can create via API and publish with 1000+ cards" do
+    sign_in_as :mike
+    @account.create_subscription!(
+      stripe_customer_id: "cus_test_unlimited",
+      stripe_subscription_id: "sub_test_unlimited",
+      plan_key: "unlimited",
+      status: "active"
+    )
+    @account.update_column(:cards_count, 1000)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "Unlimited Card" } },
+        as: :json
+    end
+
+    assert_response :created
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+
+  test "comped account can create via API and publish with 1000+ cards" do
+    sign_in_as :mike
+    @account.comp!
+    @account.update_column(:cards_count, 1000)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug),
+        params: { card: { title: "Comped Card" } },
+        as: :json
+    end
+
+    assert_response :created
+
+    post card_publish_path(@draft, script_name: @account.slug)
+    assert_response :redirect
+    assert @draft.reload.published?
+  end
+
+  test "draft footer shows 50 cards left countdown when nearing limit" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 950)
+
+    get card_draft_path(@draft, script_name: @account.slug)
+
+    assert_response :success
+    assert_includes response.body, "50 cards left"
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+
+  test "draft footer replaces create buttons with Upgrade pitch when limit reached" do
+    sign_in_as :mike
+    @account.update_column(:cards_count, 1000)
+
+    get card_draft_path(@draft, script_name: @account.slug)
+
+    assert_response :success
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+    assert_select "a", text: "Upgrade"
+    assert_includes response.body, "Upgrade"
+  end
+end
