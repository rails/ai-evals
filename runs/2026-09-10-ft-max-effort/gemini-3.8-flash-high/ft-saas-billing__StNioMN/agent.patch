+
+    <div class="flex flex-column gap-half margin-block-half">
+      <div>Name: <strong><%= @account.name %></strong></div>
+      <div>ID: <strong>#<%= @account.external_account_id %></strong></div>
+      <div>Plan: <strong><%= @account.plan %></strong></div>
+      <div>Comped: <strong><%= @account.comped? ? "Yes" : "No" %></strong></div>
+      <div>Cards: <strong><%= number_with_delimiter(@account.cards_count) %></strong></div>
+      <div>Storage used: <strong><%= number_to_human_size(@account.bytes_used) %></strong></div>
+      <% if @account.overridden_limit.present? %>
+        <div class="txt-ink-medium txt-small">
+          Override active: Card count = <%= @account.overridden_limit.card_count.inspect %>, Bytes used = <%= @account.overridden_limit.bytes_used.inspect %>
+        </div>
+      <% end %>
+    </div>
+
+    <div class="flex gap-half margin-block">
+      <%= button_to "Comp", saas.comp_admin_account_path(@account), method: :post, class: "btn" %>
+      <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account), method: :post, class: "btn btn--reversed" %>
+    </div>
+
+    <header class="margin-block-start">
+      <h2 class="divider txt-medium">Override limits</h2>
+    </header>
+
+    <%= form_with url: saas.override_admin_account_path(@account), method: :post, class: "flex flex-column gap margin-block-half" do |f| %>
+      <div class="flex flex-column gap-quarter">
+        <label for="card_count">Card count</label>
+        <input type="number" id="card_count" name="card_count" value="<%= @account.overridden_limit&.card_count %>" class="input">
+      </div>
+
+      <div class="flex flex-column gap-quarter">
+        <label for="bytes_used">Bytes used</label>
+        <input type="number" id="bytes_used" name="bytes_used" value="<%= @account.overridden_limit&.bytes_used %>" class="input">
+      </div>
+
+      <div class="flex gap-half">
+        <%= f.submit "Override", class: "btn" %>
+      </div>
+    <% end %>
+
+    <div class="margin-block-start-half">
+      <%= button_to "Reset", saas.reset_admin_account_path(@account), method: :post, class: "btn btn--negative" %>
+    </div>
+  </div>
+</section>
