diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..8817ad1
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,149 @@
+class Notification::Bundle < ApplicationRecord
+  self.table_name = "notification_bundles"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :items, class_name: "Notification::Bundle::Item", dependent: :destroy
+  has_many :notifications, through: :items
+
+  enum :status, %w[ open delivered ].index_by(&:itself), default: :open
+
+  scope :open, -> { where(status: :open) }
+  scope :delivered, -> { where(status: :delivered) }
+  scope :due, -> { open.where("ends_at <= ?", Time.current) }
+
+  validates :starts_at, :ends_at, presence: true
+  validate :starts_before_ends
+  validate :no_overlapping_windows
+
+  class << self
+    def add(notification)
+      user = notification.user
+      return unless eligible_for_bundle?(notification)
+
+      user.with_lock do
+        window = open_window_for(user, notification)
+        window.add_notification(notification)
+        window
+      end
+    end
+
+    def deliver_due
+      due.find_each(&:deliver_now)
+    end
+
+    private
+      def eligible_for_bundle?(notification)
+        user = notification.user
+        user.present? &&
+          user.bundling_notifications? &&
+          user.active? &&
+          notification.account.active? &&
+          !notification.creator&.system?
+      end
+
+      def open_window_for(user, notification)
+        notification_time = notification.created_at || Time.current
+        open_window = user.notification_bundles.open.order(:starts_at).last
+
+        if open_window.present?
+          if open_window.ends_at <= notification_time
+            open_window.deliver_now
+            open_window = nil
+          end
+        end
+
+        if open_window.present?
+          open_window
+        else
+          create_window_for(user, notification)
+        end
+      end
+
+      def create_window_for(user, notification)
+        notification_time = notification.created_at || Time.current
+        last_bundle = user.notification_bundles.order(:ends_at).last
+
+        start_time = if last_bundle.present?
+          [ notification_time, last_bundle.ends_at ].max
+        else
+          notification_time
+        end
+
+        end_time = start_time + user.bundle_email_duration
+
+        bundle = user.notification_bundles.create!(
+          account: user.account,
+          starts_at: start_time,
+          ends_at: end_time,
+          status: :open
+        )
+
+        bundle.schedule_delivery
+        bundle
+      end
+  end
+
+  def add_notification(notification)
+    items.find_or_create_by!(
+      account: account,
+      notification: notification
+    )
+    notification.update_columns(bundle_id: id) if notification.respond_to?(:bundle_id)
+  end
+
+  def schedule_delivery
+    Notification::Bundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver
+    deliver_now
+  end
+
+  def deliver_now
+    return if delivered?
+    return unless user.active? && account.active?
+    return if user.bundle_email_frequency == "never"
+
+    transaction do
+      update!(status: :delivered, delivered_at: Time.current)
+      if notifications.any?
+        NotificationMailer.digest(self).deliver_now
+      end
+    end
+  end
+
+  def deliver_later
+    Notification::Bundle::DeliveryJob.perform_later(self)
+  end
+
+  def due?
+    ends_at <= Time.current
+  end
+
+  def duration
+    ends_at - starts_at
+  end
+
+  private
+    def starts_before_ends
+      if starts_at.present? && ends_at.present? && starts_at >= ends_at
+        errors.add(:ends_at, "must be after start time")
+      end
+    end
+
+    def no_overlapping_windows
+      return unless starts_at.present? && ends_at.present? && user.present?
+
+      overlapping = user.notification_bundles
+        .where.not(id: id)
+        .where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+
+      if overlapping.exists?
+        errors.add(:base, "cannot overlap with another window")
+      end
+    end
+end
+
+NotificationBundle = Notification::Bundle
