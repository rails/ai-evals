@@ -0,0 +1,21 @@
+class NotificationMailer < ApplicationMailer
+  helper AvatarsHelper, HtmlHelper, NotificationsHelper
+
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.includes(:creator, :card, :source)
+
+    mail(
+      to: @user.identity&.email_address,
+      subject: "Your Fizzy notification digest"
+    )
+  end
+
+  def bundle(bundle)
+    digest(bundle)
+    render :digest
+  end
+end
+
+Notification::BundleMailer = NotificationMailer
