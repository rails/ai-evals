diff --git a/test/mailers/notification_mailer_test.rb b/test/mailers/notification_mailer_test.rb
new file mode 100644
index 0000000..01c0af4
--- /dev/null
+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:david)
+    @card = cards(:logo)
+    @notification = notifications(:logo_assignment_kevin)
+    @bundle = Notification::Bundle.create!(
+      account: @user.account,
+      user: @user,
+      starts_at: 1.hour.ago,
+      ends_at: 3.hours.from_now,
+      status: :open
+    )
+    @bundle.add_notification(@notification)
+  end
+
+  test "digest sends to user email address" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+  end
+
+  test "digest includes notification details" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert_match @notification.card.board.name, email.body.encoded
+    assert_match @notification.card.number.to_s, email.body.encoded
+  end
+
+  test "digest has both HTML and text parts" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert email.html_part.present?, "Email should have HTML part"
+    assert email.text_part.present?, "Email should have text part"
+  end
+
+  test "digest has correct subject" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert_match /notification/i, email.subject
+    assert_match /digest/i, email.subject
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..aa9ba6a
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,400 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:david)
+    @creator = users(:kevin)
+    @card = cards(:logo)
+    @card2 = cards(:layout)
+    @user.notification_bundles.destroy_all
+    @user.notifications.destroy_all
+  end
+
+  test "bundle_email_frequency choices and default" do
+    assert_equal "never", @user.bundle_email_frequency
+    assert_not @user.bundling_notifications?
+
+    %w[ every_few_hours daily weekly ].each do |freq|
+      @user.settings.update!(bundle_email_frequency: freq)
+      assert_equal freq, @user.bundle_email_frequency
+      assert @user.bundling_notifications?
+    end
+
+    assert_raises(ArgumentError) do
+      @user.settings.update!(bundle_email_frequency: "monthly")
+    end
+  end
+
+  test "does not bundle when frequency is never" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      create_notification(@user, @card)
+    end
+  end
+
+  test "the clock starts when the first notification lands with every_few_hours" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    start_time = Time.zone.parse("2026-06-01 10:00:00")
+
+    travel_to start_time do
+      notification = create_notification(@user, @card)
+
+      assert_equal 1, @user.notification_bundles.count
+      bundle = @user.notification_bundles.first
+
+      assert_equal start_time, bundle.starts_at
+      assert_equal start_time + 4.hours, bundle.ends_at
+      assert bundle.open?
+      assert_includes bundle.notifications, notification
+      assert_equal bundle, notification.bundle
+    end
+  end
+
+  test "window duration matches frequency setting" do
+    start_time = Time.zone.parse("2026-06-01 10:00:00")
+
+    # daily = 1 day (24 hours)
+    @user.settings.update!(bundle_email_frequency: "daily")
+    travel_to start_time do
+      create_notification(@user, @card)
+      bundle = @user.notification_bundles.first
+      assert_equal start_time + 1.day, bundle.ends_at
+    end
+
+    @user.notification_bundles.destroy_all
+    @user.notifications.destroy_all
+
+    # weekly = 1 week (7 days)
+    @user.settings.update!(bundle_email_frequency: "weekly")
+    travel_to start_time do
+      create_notification(@user, @card)
+      bundle = @user.notification_bundles.first
+      assert_equal start_time + 1.week, bundle.ends_at
+    end
+  end
+
+  test "subsequent notifications belong in the already opened window without resetting the clock" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    t0 = Time.zone.parse("2026-06-01 10:00:00")
+    t1 = Time.zone.parse("2026-06-01 11:30:00")
+    t2 = Time.zone.parse("2026-06-01 13:00:00")
+
+    travel_to t0 do
+      create_notification(@user, @card)
+    end
+
+    bundle = @user.notification_bundles.first
+    assert_equal t0, bundle.starts_at
+    assert_equal t0 + 4.hours, bundle.ends_at
+
+    travel_to t1 do
+      n2 = create_notification(@user, @card2)
+      assert_equal 1, @user.notification_bundles.count
+      assert_includes bundle.reload.notifications, n2
+      assert_equal t0 + 4.hours, bundle.ends_at
+    end
+
+    travel_to t2 do
+      # comment on card 1 creates another notification
+      event = @card.board.events.create!(action: "card_published", creator: @creator, eventable: @card)
+      n3 = Notification.find_by(user: @user, card: @card)
+      n3.update!(source: event)
+
+      assert_equal 1, @user.notification_bundles.count
+      assert_includes bundle.reload.notifications, n3
+      assert_equal t0 + 4.hours, bundle.ends_at
+    end
+  end
+
+  test "late-arriving notifications belong in the window that has already opened" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    t0 = Time.zone.parse("2026-06-01 10:00:00")
+    t_late = Time.zone.parse("2026-06-01 11:00:00")
+
+    travel_to t0 do
+      create_notification(@user, @card)
+    end
+
+    bundle = @user.notification_bundles.first
+
+    # Notification created with earlier timestamp arrives while window is open
+    travel_to t_late do
+      late_notification = create_notification(@user, @card2, created_at: t0 - 10.minutes)
+
+      assert_equal 1, @user.notification_bundles.count
+      assert_includes bundle.reload.notifications, late_notification
+      assert_equal t0, bundle.starts_at
+      assert_equal t0 + 4.hours, bundle.ends_at
+    end
+  end
+
+  test "delivery sends one email per window and marks bundle delivered" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    t0 = Time.zone.parse("2026-06-01 10:00:00")
+
+    travel_to t0 do
+      create_notification(@user, @card)
+      create_notification(@user, @card2)
+    end
+
+    bundle = @user.notification_bundles.first
+    assert_equal 2, bundle.notifications.count
+
+    travel_to t0 + 4.hours do
+      assert_emails 1 do
+        bundle.deliver_now
+      end
+
+      assert bundle.delivered?
+      assert_not bundle.open?
+      assert_equal t0 + 4.hours, bundle.delivered_at
+    end
+  end
+
+  test "nobody ends up with two overlapping windows when notifications arrive after window completes" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    t0 = Time.zone.parse("2026-06-01 10:00:00")
+    w1_end = t0 + 4.hours
+
+    travel_to t0 do
+      create_notification(@user, @card)
+    end
+
+    bundle1 = @user.notification_bundles.first
+    assert_equal t0, bundle1.starts_at
+    assert_equal w1_end, bundle1.ends_at
+
+    # Deliver window 1
+    travel_to w1_end do
+      bundle1.deliver_now
+    end
+
+    # Notification arrives after window 1 delivery
+    t1 = Time.zone.parse("2026-06-01 15:00:00")
+    travel_to t1 do
+      create_notification(@user, @card2)
+    end
+
+    assert_equal 2, @user.notification_bundles.count
+    bundle2 = @user.notification_bundles.order(:starts_at).last
+
+    assert_equal t1, bundle2.starts_at
+    assert_equal t1 + 4.hours, bundle2.ends_at
+
+    # Ensure no overlap
+    assert bundle1.ends_at <= bundle2.starts_at
+    assert_not windows_overlap?(bundle1, bundle2)
+  end
+
+  test "nobody ends up with two overlapping windows when late notification arrives after previous window delivered" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    t0 = Time.zone.parse("2026-06-01 10:00:00")
+    w1_end = t0 + 4.hours
+
+    travel_to t0 do
+      create_notification(@user, @card)
+    end
+
+    bundle1 = @user.notification_bundles.first
+
+    # Deliver window 1 at 14:00
+    travel_to w1_end do
+      bundle1.deliver_now
+    end
+
+    # Late notification created at 13:50 arrives at 14:05 (after window 1 delivery)
+    travel_to w1_end + 5.minutes do
+      create_notification(@user, @card2, created_at: w1_end - 10.minutes)
+    end
+
+    assert_equal 2, @user.notification_bundles.count
+    bundle2 = @user.notification_bundles.order(:starts_at).last
+
+    # Window 2 must not start before Window 1 ended
+    assert bundle2.starts_at >= bundle1.ends_at
+    assert_not windows_overlap?(bundle1, bundle2)
+  end
+
+  test "validation prevents overlapping windows" do
+    t0 = Time.zone.parse("2026-06-01 10:00:00")
+    bundle1 = @user.notification_bundles.create!(
+      account: @user.account,
+      starts_at: t0,
+      ends_at: t0 + 4.hours,
+      status: :open
+    )
+
+    # Overlapping: starts inside window 1
+    bundle_overlap = @user.notification_bundles.build(
+      account: @user.account,
+      starts_at: t0 + 2.hours,
+      ends_at: t0 + 6.hours,
+      status: :open
+    )
+    assert_not bundle_overlap.valid?
+    assert_includes bundle_overlap.errors[:base], "cannot overlap with another window"
+
+    # Non-overlapping: starts exactly when window 1 ends
+    bundle_adjacent = @user.notification_bundles.build(
+      account: @user.account,
+      starts_at: t0 + 4.hours,
+      ends_at: t0 + 8.hours,
+      status: :open
+    )
+    assert bundle_adjacent.valid?
+  end
+
+  test "delivery job delivers the bundle" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    t0 = Time.zone.parse("2026-06-01 10:00:00")
+
+    travel_to t0 do
+      create_notification(@user, @card)
+    end
+
+    bundle = @user.notification_bundles.first
+
+    travel_to bundle.ends_at do
+      assert_emails 1 do
+        perform_enqueued_jobs only: Notification::Bundle::DeliveryJob
+      end
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "system user notifications do not create bundles" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    system_user = users(:system)
+
+    event = @card.board.events.create!(action: "card_assigned", creator: system_user, eventable: @card)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      Notification.create!(
+        account: @user.account,
+        user: @user,
+        card: @card,
+        source: event,
+        creator: system_user,
+        unread_count: 1
+      )
+    end
+  end
+
+  test "inactive user notifications do not create bundles" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    @user.deactivate
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      create_notification(@user, @card)
+    end
+  end
+
+  test "delivering with PushTarget::Email works" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    t0 = Time.zone.parse("2026-06-01 10:00:00")
+
+    travel_to t0 do
+      notification = create_notification(@user, @card)
+      # Re-process via PushTarget::Email
+      Notification::PushTarget::Email.process(notification)
+
+      assert_equal 1, @user.notification_bundles.count
+      bundle = @user.notification_bundles.first
+      assert_includes bundle.notifications, notification
+    end
+  end
+
+  test "deliver_due delivers all expired bundles" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    t0 = Time.zone.parse("2026-06-01 10:00:00")
+
+    travel_to t0 do
+      create_notification(@user, @card)
+    end
+
+    bundle = @user.notification_bundles.first
+
+    # Before ends_at, deliver_due does not deliver
+    travel_to t0 + 2.hours do
+      assert_no_emails do
+        Notification::Bundle.deliver_due
+      end
+      assert bundle.reload.open?
+    end
+
+    # After ends_at, deliver_due delivers
+    travel_to t0 + 4.hours do
+      assert_emails 1 do
+        Notification::Bundle.deliver_due
+      end
+      assert bundle.reload.delivered?
+    end
+  end
+
+  test "changing frequency to never suppresses email delivery" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    t0 = Time.zone.parse("2026-06-01 10:00:00")
+
+    travel_to t0 do
+      create_notification(@user, @card)
+    end
+
+    bundle = @user.notification_bundles.first
+
+    # User turns off digests
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    travel_to t0 + 4.hours do
+      assert_no_emails do
+        bundle.deliver_now
+      end
+    end
+  end
+
+test "concurrent notifications do not create overlapping windows" do
+  @user.settings.update!(bundle_email_frequency: "every_few_hours")
+  t0 = Time.zone.parse("2026-06-01 10:00:00")
+
+  column = boards(:writebook).columns.first
+    cards = [ cards(:logo), cards(:layout), cards(:buy_domain) ]
+
+  travel_to t0 do
+    threads = cards.map do |card|
+      Thread.new do
+        ActiveRecord::Base.connection_pool.with_connection do
+          create_notification(@user, card)
+        end
+      end
+    end
+    threads.each(&:join)
+  end
+
+  assert_equal 1, @user.notification_bundles.count
+  bundle = @user.notification_bundles.first
+  assert_equal 3, bundle.notifications.count
+  assert_equal t0, bundle.starts_at
+  assert_equal t0 + 4.hours, bundle.ends_at
+end
+
+  private
+    def create_notification(user, card, created_at: Time.current)
+      event = card.board.events.create!(action: "card_assigned", creator: @creator, eventable: card)
+      Notification.create!(
+        account: user.account,
+        user: user,
+        card: card,
+        source: event,
+        creator: @creator,
+        unread_count: 1,
+        created_at: created_at
+      )
+    end
+
+    def windows_overlap?(w1, w2)
+      w1.starts_at < w2.ends_at && w2.starts_at < w1.ends_at
+    end
+end
