diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..dde5f02
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,301 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+    @board = @card.board
+    @board.auto_postpone_period_in_days = 30
+  end
+
+  test "card gets a burst when someone is assigned to it" do
+    assert_not @card.bursted?
+
+    @card.toggle_assignment(users(:david))
+
+    assert @card.reload.bursted?
+  end
+
+  test "card gets a burst when it is reopened" do
+    @card.close(user: users(:david))
+    assert @card.closed?
+    @card.update_columns(bursted_at: nil)
+
+    @card.reopen(user: users(:david))
+
+    assert @card.reload.open?
+    assert @card.bursted?
+  end
+
+  test "card gets a burst when 3 comments from at least 2 people land within 1/3 of auto-close period" do
+    assert_not @card.bursted?
+
+    # writebook board auto-close period is set to 30 days in setup, 1/3 is 10 days
+    assert_equal 30.days.to_i, @board.auto_close_period
+
+    # Comment 1 by David
+    @card.comments.create!(creator: users(:david), body: "First comment")
+    assert_not @card.reload.bursted?
+
+    # Comment 2 by Kevin
+    @card.comments.create!(creator: users(:kevin), body: "Second comment")
+    assert_not @card.reload.bursted?
+
+    # Comment 3 by David
+    @card.comments.create!(creator: users(:david), body: "Third comment")
+    assert @card.reload.bursted?
+  end
+
+  test "card does not get a burst when 3 comments are from only 1 person" do
+    assert_not @card.bursted?
+
+    3.times do |i|
+      @card.comments.create!(creator: users(:david), body: "Comment #{i}")
+    end
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "card does not get a burst when only 2 comments land" do
+    @card.comments.create!(creator: users(:david), body: "First comment")
+    @card.comments.create!(creator: users(:kevin), body: "Second comment")
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "card does not get a burst when 3 comments from 2 people span longer than 1/3 of auto-close period" do
+    # First comment 15 days ago (outside the 10-day window)
+    travel_to 15.days.ago do
+      @card.comments.create!(creator: users(:david), body: "Old comment")
+    end
+
+    @card.comments.create!(creator: users(:kevin), body: "Recent comment 1")
+    @card.comments.create!(creator: users(:david), body: "Recent comment 2")
+
+    # Only 2 comments within the 10-day window
+    assert_not @card.reload.bursted?
+  end
+
+  test "system comments do not count toward burst" do
+    system_user = @card.account.system_user
+
+    @card.comments.create!(creator: users(:david), body: "Human comment 1")
+    @card.comments.create!(creator: system_user, body: "System comment 1")
+    @card.comments.create!(creator: system_user, body: "System comment 2")
+    @card.comments.create!(creator: users(:david), body: "Human comment 2")
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "card with a custom board auto-close period uses 1/3 of that period" do
+    # Set board auto-close period to 90 days (1/3 is 30 days)
+    @board.auto_postpone_period_in_days = 90
+
+    travel_to 20.days.ago do
+      @card.comments.create!(creator: users(:david), body: "Comment 1")
+    end
+
+    @card.comments.create!(creator: users(:kevin), body: "Comment 2")
+    @card.comments.create!(creator: users(:david), body: "Comment 3")
+
+    # Within 30 days, so it is a burst!
+    assert @card.reload.bursted?
+  end
+
+  test "card that had a burst and sees no activity for two weeks is stalled" do
+    @card.burst
+    @card.update_columns(bursted_at: 15.days.ago, last_active_at: 15.days.ago)
+
+    assert @card.stalled?
+  end
+
+  test "card that had a burst but has activity within two weeks is not stalled" do
+    @card.burst
+    @card.update_columns(bursted_at: 15.days.ago, last_active_at: 1.week.ago)
+
+    assert_not @card.stalled?
+  end
+
+  test "card that never had a burst is not stalled even with no activity for two weeks" do
+    @card.update_columns(bursted_at: nil, last_active_at: 1.month.ago)
+
+    assert_not @card.stalled?
+  end
+
+  test "closed card is not stalled" do
+    @card.burst
+    @card.update_columns(bursted_at: 15.days.ago, last_active_at: 15.days.ago)
+    assert @card.stalled?
+
+    @card.close(user: users(:david))
+
+    assert_not @card.reload.stalled?
+  end
+
+  test "postponed card is not stalled" do
+    @card.burst
+    @card.update_columns(bursted_at: 15.days.ago, last_active_at: 15.days.ago)
+    assert @card.stalled?
+
+    @card.postpone(user: users(:david))
+
+    assert_not @card.reload.stalled?
+  end
+
+  test "comment activity resets stalled card" do
+    @card.burst
+    @card.update_columns(bursted_at: 15.days.ago, last_active_at: 15.days.ago)
+    assert @card.stalled?
+
+    @card.comments.create!(creator: users(:david), body: "Resuming work")
+
+    assert_not @card.reload.stalled?
+    assert_not @card.bursted?
+  end
+
+  test "title change activity resets stalled card" do
+    @card.burst
+    @card.update_columns(bursted_at: 15.days.ago, last_active_at: 15.days.ago)
+    assert @card.stalled?
+
+    @card.update!(title: "New title")
+
+    assert_not @card.reload.stalled?
+    assert_not @card.bursted?
+  end
+
+  test "assignment activity resets stalled card and gives it a new burst" do
+    @card.burst
+    @card.update_columns(bursted_at: 15.days.ago, last_active_at: 15.days.ago)
+    assert @card.stalled?
+
+    @card.toggle_assignment(users(:david))
+
+    assert_not @card.reload.stalled?
+    assert @card.bursted?
+    assert_in_delta Time.current, @card.bursted_at, 2.seconds
+  end
+
+  test "unassignment activity resets stalled card" do
+    @card.toggle_assignment(users(:david))
+    @card.update_columns(bursted_at: 15.days.ago, last_active_at: 15.days.ago)
+    assert @card.stalled?
+
+    @card.toggle_assignment(users(:david))
+
+    assert_not @card.reload.stalled?
+    assert_not @card.bursted?
+  end
+
+  test "comments from before stall reset do not count toward a new burst" do
+    # Card had 3 comments 20 days ago and was bursted
+    travel_to 20.days.ago do
+      @card.comments.create!(creator: users(:david), body: "1")
+      @card.comments.create!(creator: users(:kevin), body: "2")
+      @card.comments.create!(creator: users(:david), body: "3")
+    end
+    assert @card.reload.bursted?
+
+    # Becomes stalled at 15 days ago
+    @card.update_columns(bursted_at: 20.days.ago, last_active_at: 20.days.ago)
+    assert @card.stalled?
+
+    # Single comment resets it
+    @card.comments.create!(creator: users(:kevin), body: "Ping")
+    assert_not @card.reload.stalled?
+    assert_not @card.bursted?
+  end
+
+  test "stalled scope returns only stalled cards" do
+    stalled_card = @card
+    stalled_card.burst
+    stalled_card.update_columns(bursted_at: 15.days.ago, last_active_at: 15.days.ago)
+
+    unstalled_card = cards(:logo)
+    unstalled_card.update_columns(bursted_at: nil, last_active_at: 15.days.ago)
+
+    active_bursted_card = cards(:shipping)
+    active_bursted_card.burst
+    active_bursted_card.update_columns(bursted_at: 1.day.ago, last_active_at: 1.day.ago)
+
+    assert_includes Card.stalled, stalled_card
+    assert_not_includes Card.stalled, unstalled_card
+    assert_not_includes Card.stalled, active_bursted_card
+  end
+
+  test "indexed_by stalled returns stalled cards" do
+    stalled_card = @card
+    stalled_card.burst
+    stalled_card.update_columns(bursted_at: 15.days.ago, last_active_at: 15.days.ago)
+
+    assert_includes Card.indexed_by("stalled"), stalled_card
+  end
+
+  test "activity between burst and two weeks resets the inactivity timer" do
+    @card.burst
+    # Card bursted 16 days ago
+    @card.update_columns(bursted_at: 16.days.ago, last_active_at: 16.days.ago)
+
+    # Activity happened 5 days ago (e.g. title update)
+    @card.update_columns(last_active_at: 5.days.ago)
+
+    # bursted 16 days ago, but last active 5 days ago: NOT stalled!
+    assert_not @card.stalled?
+
+    # Now travel to 10 days later (15 days after last_active_at)
+    travel 10.days do
+      assert @card.stalled?
+    end
+  end
+
+  test "adding a reaction resets stalled card" do
+    @card.burst
+    @card.update_columns(bursted_at: 15.days.ago, last_active_at: 15.days.ago)
+    assert @card.stalled?
+
+    @card.reactions.create!(reacter: users(:david), content: "👍")
+
+    assert_not @card.reload.stalled?
+    assert_not @card.bursted?
+  end
+
+  test "board with 7 day auto-close period has 56 hour burst window" do
+    @board.auto_postpone_period_in_days = 7
+
+    # 3 comments within 40 hours -> burst
+    travel_to 40.hours.ago do
+      @card.comments.create!(creator: users(:david), body: "1")
+    end
+    travel_to 20.hours.ago do
+      @card.comments.create!(creator: users(:kevin), body: "2")
+    end
+    @card.comments.create!(creator: users(:david), body: "3")
+
+    assert @card.reload.bursted?
+  end
+
+  test "board with 7 day auto-close period does not burst if comments span 60 hours" do
+    @board.auto_postpone_period_in_days = 7
+
+    # 3 comments spanning 60 hours (> 56 hours) -> no burst
+    travel_to 60.hours.ago do
+      @card.comments.create!(creator: users(:david), body: "1")
+    end
+    travel_to 20.hours.ago do
+      @card.comments.create!(creator: users(:kevin), body: "2")
+    end
+    @card.comments.create!(creator: users(:david), body: "3")
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "cache_version changes when card becomes stalled" do
+    version_before = @card.cache_version
+
+    @card.burst
+    @card.update_columns(bursted_at: 15.days.ago, last_active_at: 15.days.ago)
+
+    assert_not_equal version_before, @card.cache_version
+    assert_includes @card.cache_version, "true"
+  end
+end
