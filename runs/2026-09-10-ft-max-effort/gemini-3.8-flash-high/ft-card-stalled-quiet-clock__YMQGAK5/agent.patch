diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..c434d7e
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,46 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> do
+      cutoff = STALL_PERIOD.ago
+      active
+        .where.not(bursted_at: nil)
+        .where("cards.bursted_at <= ?", cutoff)
+        .where("cards.last_active_at <= ?", cutoff)
+    end
+
+    before_update :reset_stall_on_activity, if: -> { was_stalled? && !will_save_change_to_bursted_at? }
+  end
+
+  def burst
+    update!(bursted_at: Time.current)
+  end
+  alias_method :burst!, :burst
+
+  def bursted?
+    bursted_at.present?
+  end
+  alias_method :burst?, :bursted?
+
+  def stalled?
+    active? && bursted? && bursted_at <= STALL_PERIOD.ago && last_active_at <= STALL_PERIOD.ago
+  end
+
+  def was_stalled?
+    active? && bursted? && bursted_at <= STALL_PERIOD.ago && (last_active_at_was || last_active_at) <= STALL_PERIOD.ago
+  end
+
+  def reset_stall
+    update!(bursted_at: nil, burst_reset_at: Time.current)
+  end
+  alias_method :reset_stall!, :reset_stall
+
+  private
+    def reset_stall_on_activity
+      self.bursted_at = nil
+      self.burst_reset_at = Time.current
+    end
+end
