   scope :by_system, -> { joins(:creator).where(creator: { role: :system }) }
   scope :by_user, -> { joins(:creator).where.not(creator: { role: :system }) }
 
+  after_create :register_card_activity
+  after_create :check_card_burst
   after_create_commit :watch_card_by_creator
 
   delegate :publicly_accessible?, :accessible_to?, :board, :watch_by, to: :card
@@ -24,6 +26,24 @@ class Comment < ApplicationRecord
   end
 
   private
+    def register_card_activity
+      card.touch_last_active_at
+    end
+
+    def check_card_burst
+      return if creator&.system?
+
+      burst_window = (card.board.auto_postpone_period / 3.0).seconds
+      window_end = created_at || Time.current
+      earliest_start = window_end - burst_window
+      window_start = [ earliest_start, card.burst_reset_at ].compact.max
+
+      recent_comments = card.comments.by_user.where(created_at: window_start..window_end)
+      if recent_comments.count >= 3 && recent_comments.distinct.count(:creator_id) >= 2
+        card.burst
+      end
+    end
+
     def card_is_commentable
       errors.add(:card, "does not allow comments") unless card.commentable?
     end
