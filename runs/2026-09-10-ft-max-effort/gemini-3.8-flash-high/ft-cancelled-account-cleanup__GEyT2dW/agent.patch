diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..9a8b87c
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    @other_account = accounts(:initech)
+    @other_user = users(:mike)
+  end
+
+  test "permanently removes data for accounts canceled more than 30 days ago" do
+    card = @account.cards.first
+    card.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+    export = @account.exports.create!(user: @user)
+    export.file.attach(io: StringIO.new("fake zip"), filename: "export.zip", content_type: "application/zip")
+
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: 31.days.ago)
+
+    @other_account.cancel(initiated_by: @other_user)
+    @other_account.cancellation.update_columns(created_at: 10.days.ago)
+
+    account_id = @account.id
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account_id)
+    assert Account.exists?(@other_account.id)
+
+    tables_with_account_id = ActiveRecord::Base.connection.tables.select do |table|
+      ActiveRecord::Base.connection.columns(table).any? { |c| c.name == "account_id" }
+    end
+
+    tables_with_account_id.each do |table|
+      count = ActiveRecord::Base.connection.select_value(
+        "SELECT COUNT(*) FROM #{table} WHERE account_id = #{ActiveRecord::Base.connection.quote(ActiveRecord::Type::Uuid.new.serialize(account_id))}"
+      )
+      assert_equal 0, count, "Expected 0 records in #{table} for incinerated account #{account_id}, but found #{count}"
+    end
+  end
+
+  test "does not incinerate active or reactivated accounts" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: 31.days.ago)
+    @account.reactivate
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(@account.id)
+    assert Account.exists?(@other_account.id)
+  end
+
+  test "is configured as recurring task in recurring.yml" do
+    config_file = Rails.root.join("config/recurring.yml")
+    erb = ERB.new(File.read(config_file))
+    erb.filename = config_file.to_s
+    config = YAML.load(erb.result, aliases: true)
+
+    production_tasks = config["production"]
+    matching_task = production_tasks.find { |_, task_config| task_config["class"] == "Account::IncinerateDueJob" }
+
+    assert_not_nil matching_task, "Expected Account::IncinerateDueJob to be configured in config/recurring.yml"
+    assert_predicate matching_task.last["schedule"], :present?, "Expected schedule to be configured"
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..70c9186
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "due_for_incineration scope includes accounts canceled more than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: 31.days.ago)
+
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes accounts canceled less than 30 days ago" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: 29.days.ago)
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes active accounts" do
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration scope excludes reactivated accounts" do
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: 31.days.ago)
+    @account.reactivate
+
+    assert_not_includes Account.due_for_incineration, @account
+  end
+
+  test "due_for_incineration? returns true only when canceled more than 30 days ago" do
+    assert_not @account.due_for_incineration?
+
+    @account.cancel(initiated_by: @user)
+    assert_not @account.due_for_incineration?
+
+    @account.cancellation.update_columns(created_at: 31.days.ago)
+    assert @account.reload.due_for_incineration?
+  end
+
+  test "incinerate permanently removes account and all associated data" do
+    card = @account.cards.first
+    card.image.attach(io: File.open(file_fixture("moon.jpg")), filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = @account.exports.create!(user: @user)
+    export.file.attach(io: StringIO.new("fake zip"), filename: "export.zip", content_type: "application/zip")
+
+    account_id = @account.id
+    @account.cancel(initiated_by: @user)
+
+    assert_difference -> { Account.count }, -1 do
+      @account.incinerate
+    end
+
+    assert_not Account.exists?(account_id)
+
+    tables_with_account_id = ActiveRecord::Base.connection.tables.select do |table|
+      ActiveRecord::Base.connection.columns(table).any? { |c| c.name == "account_id" }
+    end
+
+    tables_with_account_id.each do |table|
+      count = ActiveRecord::Base.connection.select_value(
+        "SELECT COUNT(*) FROM #{table} WHERE account_id = #{ActiveRecord::Base.connection.quote(ActiveRecord::Type::Uuid.new.serialize(account_id))}"
+      )
+      assert_equal 0, count, "Expected 0 records in #{table} for account #{account_id}, but found #{count}"
+    end
+
+    assert_equal 0, Storage::Total.where(owner_type: "Account", owner_id: account_id).count
+  end
+
+  test "incinerate runs callbacks" do
+    callback_run = false
+    Account.set_callback(:incinerate, :before) { callback_run = true }
+
+    @account.cancel(initiated_by: @user)
+    @account.incinerate
+
+    assert callback_run
+  ensure
+    Account.reset_callbacks(:incinerate)
+  end
+
+  test "incinerate_due removes only accounts canceled more than 30 days ago" do
+    other_account = accounts(:initech)
+    other_user = users(:mike)
+
+    @account.cancel(initiated_by: @user)
+    @account.cancellation.update_columns(created_at: 31.days.ago)
+
+    other_account.cancel(initiated_by: other_user)
+    other_account.cancellation.update_columns(created_at: 10.days.ago)
+
+    Account.incinerate_due
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(other_account.id)
+  end
+
+  test "incinerate_due_later enqueues Account::IncinerateDueJob" do
+    assert_enqueued_with(job: Account::IncinerateDueJob) do
+      Account.incinerate_due_later
+    end
+  end
+end
