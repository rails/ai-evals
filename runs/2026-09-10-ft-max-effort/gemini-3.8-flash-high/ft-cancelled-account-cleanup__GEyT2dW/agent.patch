diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..e1908ae 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,44 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :due_for_incineration, -> { joins(:cancellation).where(account_cancellations: { created_at: ..INCINERATION_GRACE_PERIOD.ago }) }
+    scope :incinerable, -> { due_for_incineration }
+
+    define_callbacks :incinerate
+
+    after_destroy_commit :incinerate_associated_data
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+    alias_method :incinerate_all_due, :incinerate_due
+
+    def incinerate_due_later
+      Account::IncinerateDueJob.perform_later
+    end
+  end
+
+  def incinerate
+    run_callbacks :incinerate do
+      destroy!
+    end
+  end
+
+  def due_for_incineration?
+    cancelled? && cancellation.created_at <= INCINERATION_GRACE_PERIOD.ago
+  end
+  alias_method :incinerable?, :due_for_incineration?
+
+  private
+    def incinerate_associated_data
+      ActiveStorage::Attachment.where(account_id: id).find_each(&:destroy)
+      ActiveStorage::Blob.where(account_id: id).find_each(&:purge)
+      ActionText::RichText.where(account_id: id).destroy_all
+      Search::Record.for(id).where(account_id: id).destroy_all
+    end
 end
