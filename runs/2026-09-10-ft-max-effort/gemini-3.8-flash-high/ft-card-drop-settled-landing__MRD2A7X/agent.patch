diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..9525b56
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,229 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  connect() {
+    this.mediaQuery = window.matchMedia(this.desktopBreakpointValue)
+    this.#disableImageDragging()
+  }
+
+  dragStart(event) {
+    if (!this.#isDesktop) {
+      event.preventDefault()
+      return
+    }
+
+    const card = event.target.closest(".card")
+    if (!card || !this.element.contains(card)) return
+
+    const column = card.closest(".cards")
+    if (!column) return
+
+    this.draggedCard = card
+    this.sourceColumn = column
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+
+    this.#disableImageDragging()
+
+    requestAnimationFrame(() => {
+      if (this.draggedCard) {
+        this.draggedCard.classList.add("drag-and-drop__dragged-item")
+      }
+    })
+  }
+
+  dragOver(event) {
+    if (!this.draggedCard) return
+
+    const column = event.target.closest(".cards")
+    if (!column || !this.element.contains(column) || column === this.sourceColumn) {
+      this.#clearHover()
+      return
+    }
+
+    event.preventDefault()
+    event.dataTransfer.dropEffect = "move"
+
+    if (column !== this.hoveredColumn) {
+      this.#clearHover()
+      this.hoveredColumn = column
+      column.classList.add("drag-and-drop__hover-container")
+    }
+  }
+
+  dragLeave(event) {
+    if (this.hoveredColumn && (!event.relatedTarget || !this.hoveredColumn.contains(event.relatedTarget))) {
+      this.#clearHover()
+    }
+  }
+
+  async drop(event) {
+    if (!this.draggedCard) return
+
+    event.preventDefault()
+
+    const targetColumn = event.target.closest(".cards")
+    const card = this.draggedCard
+    const sourceColumn = this.sourceColumn
+
+    this.#cleanup()
+
+    if (!targetColumn || targetColumn === sourceColumn) return
+
+    const originalNextSibling = card.nextElementSibling
+
+    this.#insertCardIntoColumn(card, targetColumn)
+    this.#updateCardState(card, targetColumn)
+    this.#updateExpanderCount(sourceColumn, -1)
+    this.#updateExpanderCount(targetColumn, 1)
+
+    await this.#save(card, targetColumn, sourceColumn, originalNextSibling)
+  }
+
+  dragEnd(event) {
+    this.#cleanup()
+  }
+
+  // Private
+
+  get #isDesktop() {
+    return this.mediaQuery?.matches
+  }
+
+  #cleanup() {
+    if (this.draggedCard) {
+      this.draggedCard.classList.remove("drag-and-drop__dragged-item")
+      this.draggedCard = null
+    }
+    this.sourceColumn = null
+    this.#clearHover()
+  }
+
+  #clearHover() {
+    if (this.hoveredColumn) {
+      this.hoveredColumn.classList.remove("drag-and-drop__hover-container")
+      this.hoveredColumn = null
+    }
+    this.element.querySelectorAll(".drag-and-drop__hover-container").forEach(el => {
+      el.classList.remove("drag-and-drop__hover-container")
+    })
+  }
+
+  #insertCardIntoColumn(card, targetColumn) {
+    const isGolden = card.classList.contains("golden-effect")
+    const existingCards = Array.from(targetColumn.querySelectorAll(".card")).filter(c => c !== card)
+
+    if (existingCards.length > 0) {
+      if (isGolden) {
+        existingCards[0].before(card)
+      } else {
+        const firstNonGoldenCard = existingCards.find(c => !c.classList.contains("golden-effect"))
+        if (firstNonGoldenCard) {
+          firstNonGoldenCard.before(card)
+        } else {
+          existingCards[existingCards.length - 1].after(card)
+        }
+      }
+    } else {
+      const container = targetColumn.querySelector("turbo-frame[id*='pagination-contents']") ||
+                        targetColumn.querySelector(".cards__list")
+      if (container) {
+        container.prepend(card)
+      }
+    }
+  }
+
+  #updateCardState(card, targetColumn) {
+    if (targetColumn.id === "not-now") {
+      card.classList.add("card--postponed")
+      card.classList.remove("card--active")
+    } else if (targetColumn.id === "closed-cards") {
+      card.classList.remove("card--postponed", "card--active")
+    } else {
+      card.classList.add("card--active")
+      card.classList.remove("card--postponed")
+    }
+
+    if (targetColumn.id !== "not-now" && targetColumn.id !== "closed-cards") {
+      card.querySelector(".card__closed")?.remove()
+    }
+
+    if (targetColumn.id === "not-now" || targetColumn.id === "closed-cards" || targetColumn.id === "maybe") {
+      card.querySelector(".card__header .card__column-name--current")?.remove()
+    } else if (targetColumn.dataset.columnId) {
+      const currentName = card.querySelector(".card__header .card__column-name--current span")
+      if (currentName) {
+        currentName.textContent = targetColumn.dataset.columnName
+      }
+    }
+  }
+
+  #updateExpanderCount(column, delta) {
+    const countElement = column.querySelector(".cards__expander-count")
+    if (!countElement) return
+
+    const currentText = countElement.textContent.trim()
+    if (currentText === "99+" && delta < 0) return
+
+    const currentCount = parseInt(currentText, 10)
+    if (!isNaN(currentCount)) {
+      const newCount = Math.max(0, currentCount + delta)
+      countElement.textContent = newCount > 99 ? "99+" : newCount
+    }
+  }
+
+  async #save(card, targetColumn, sourceColumn, originalNextSibling) {
+    let response
+    try {
+      if (targetColumn.id === "not-now") {
+        response = await post(card.dataset.cardNotNowUrl, { responseKind: "json" })
+      } else if (targetColumn.id === "maybe") {
+        response = await destroy(card.dataset.cardTriageUrl, { responseKind: "json" })
+      } else if (targetColumn.id === "closed-cards") {
+        response = await post(card.dataset.cardClosureUrl, { responseKind: "json" })
+      } else {
+        const columnId = targetColumn.dataset.columnId || targetColumn.id.replace(/^column_/, "")
+        response = await post(card.dataset.cardTriageUrl, {
+          body: { column_id: columnId },
+          query: { column_id: columnId },
+          responseKind: "json"
+        })
+      }
+
+      if (!response || !response.ok) {
+        this.#revert(card, sourceColumn, originalNextSibling)
+      }
+    } catch (error) {
+      this.#revert(card, sourceColumn, originalNextSibling)
+    }
+  }
+
+  #revert(card, sourceColumn, originalNextSibling) {
+    if (originalNextSibling && originalNextSibling.parentElement) {
+      originalNextSibling.before(card)
+    } else {
+      const container = sourceColumn.querySelector("turbo-frame[id*='pagination-contents']") ||
+                        sourceColumn.querySelector(".cards__list")
+      if (container) {
+        container.appendChild(card)
+      }
+    }
+    this.#updateCardState(card, sourceColumn)
+    this.#updateExpanderCount(sourceColumn, 1)
+
+    const currentColumn = card.closest(".cards")
+    if (currentColumn && currentColumn !== sourceColumn) {
+      this.#updateExpanderCount(currentColumn, -1)
+    }
+  }
+
+  #disableImageDragging() {
+    this.element.querySelectorAll(".card img").forEach(img => img.draggable = false)
+  }
+}
