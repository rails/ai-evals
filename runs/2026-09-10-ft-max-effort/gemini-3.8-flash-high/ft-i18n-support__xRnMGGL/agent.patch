diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..db98578
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,47 @@
+require "japanese_translation"
+
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  SUPPORTED_LOCALES = %w[en ja].freeze
+
+  included do
+    around_action :set_current_locale
+    after_action :translate_response_to_japanese, if: -> { I18n.locale == :ja }
+    etag { I18n.locale }
+  end
+
+  private
+    def set_current_locale(&action)
+      if (requested_locale = params[:locale].presence)
+        if SUPPORTED_LOCALES.include?(requested_locale)
+          session[:locale] = requested_locale
+          if authenticated? && Current.identity
+            Current.identity.update_column(:locale, requested_locale)
+          end
+        end
+      end
+
+      locale = if session[:locale].present? && SUPPORTED_LOCALES.include?(session[:locale])
+        session[:locale]
+      elsif current_identity&.locale.present? && SUPPORTED_LOCALES.include?(current_identity.locale)
+        session[:locale] = current_identity.locale
+        current_identity.locale
+      else
+        I18n.default_locale
+      end
+
+      I18n.with_locale(locale, &action)
+    end
+
+    def current_identity
+      Current.identity || (find_session_by_cookie&.identity if respond_to?(:find_session_by_cookie, true))
+    end
+
+    def translate_response_to_japanese
+      return unless response.content_type&.start_with?("text/html", "text/vnd.turbo-stream.html")
+      return if response.body.blank?
+
+      response.body = JapaneseTranslation.translate_html(response.body)
+    end
+end
