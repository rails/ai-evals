diff --git a/test/integration/internationalization_test.rb b/test/integration/internationalization_test.rb
new file mode 100644
index 0000000..86f876a
--- /dev/null
+++ b/test/integration/internationalization_test.rb
@@ -0,0 +1,187 @@
+require "test_helper"
+
+class InternationalizationTest < ActionDispatch::IntegrationTest
+  test "default locale is English for users who never chose anything" do
+    untenanted do
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_select "h1", text: "Get into Fizzy"
+      assert_select "input[placeholder=?]", "Enter your email address…"
+    end
+  end
+
+  test "opening page with ?locale=ja switches to Japanese and choice sticks for rest of session" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "Fizzyを始める"
+      assert_select "input[placeholder=?]", "メールアドレスを入力…"
+
+      # Subsequent request without locale param remains in Japanese
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "Fizzyを始める"
+      assert_select "input[placeholder=?]", "メールアドレスを入力…"
+    end
+  end
+
+  test "opening page with unsupported locale does not break and does not switch anything" do
+    untenanted do
+      get new_session_path, params: { locale: "xx" }
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_select "h1", text: "Get into Fizzy"
+
+      # Switch to ja
+      get new_session_path, params: { locale: "ja" }
+      assert_response :success
+      assert_select "html[lang=ja]"
+
+      # Request with xx does not break and does not switch away from ja
+      get new_session_path, params: { locale: "xx" }
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "Fizzyを始める"
+    end
+  end
+
+  test "switching back to en works and sticks" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      assert_response :success
+      assert_select "html[lang=ja]"
+
+      get new_session_path, params: { locale: "en" }
+      assert_response :success
+      assert_select "html[lang=en]"
+
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=en]"
+    end
+  end
+
+  test "signed in user who chose Japanese has choice stick across clean browser session" do
+    # Sign in as david
+    sign_in_as :david
+    get root_path
+    assert_response :success
+
+    # Switch to Japanese
+    get root_path, params: { locale: "ja" }
+    assert_response :success
+    assert_select "html[lang=ja]"
+
+    david = identities(:david)
+    assert_equal "ja", david.reload.locale
+
+    # Simulate clean browser: clear cookies and session completely
+    cookies.delete(:session_token)
+    reset!
+
+    # Clean browser initially visits without session -> default English
+    untenanted do
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=en]"
+    end
+
+    # David signs in again from clean browser
+    david.send_magic_link
+    magic_link = david.magic_links.order(id: :desc).first
+
+    untenanted do
+      post session_path, params: { email_address: david.email_address }
+      post session_magic_link_url, params: { code: magic_link.code }
+    end
+
+    assert_response :redirect
+
+    # After sign-in, David is back in Japanese!
+    get root_path
+    assert_response :success
+    assert_select "html[lang=ja]"
+
+    # Further navigation sticks in Japanese
+    board = users(:david).boards.first
+    get board_path(board)
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "screens in Japanese translate UI text, screen reader text, and attributes" do
+    sign_in_as :david
+    board = users(:david).boards.first
+
+    get board_path(board), params: { locale: "ja" }
+    assert_response :success
+    assert_select "html[lang=ja]"
+
+    # Skip to navigation text
+    assert_select ".header__skip-navigation", text: "メインコンテンツへスキップ"
+
+    # Screen reader texts
+    assert_select ".for-screen-reader", text: /#{board.name}の設定|Webhook/
+  end
+
+  test "emails sent to Japanese user are in Japanese" do
+    david = identities(:david)
+    david.update_column(:locale, "ja")
+    user = users(:david)
+
+    # 1. Magic link email
+    magic_link = david.magic_links.create!
+    mail = MagicLinkMailer.sign_in_instructions(magic_link)
+    assert_match "Fizzyの確認コードは #{magic_link.code} です", mail.subject
+    assert_match "Fizzyの確認コード", mail.html_part.body.to_s
+    assert_match "Fizzyのサインインページで、以下の6文字の確認コードを入力してください:", mail.text_part.body.to_s
+
+    # 2. Account cancellation email
+    cancellation = Account::Cancellation.new(account: david.accounts.first, initiated_by: user)
+    mail = AccountMailer.cancellation(cancellation)
+    assert_equal "Fizzyアカウントがキャンセルされました", mail.subject
+    assert_match "今後の予定", mail.html_part.body.to_s
+    assert_match "今後の予定", mail.text_part.body.to_s
+
+    # 3. Export completed email
+    export = user.data_exports.create!(account: user.account)
+    mail = ExportMailer.completed(export)
+    assert_equal "Fizzyデータのエクスポートがダウンロード可能です", mail.subject
+    assert_match "Fizzyデータをダウンロード", mail.html_part.body.to_s
+    assert_match "データをダウンロード:", mail.text_part.body.to_s
+
+    # 4. Import completed and failed emails
+    account = david.accounts.first
+    mail = ImportMailer.completed(david, account)
+    assert_equal "Fizzyアカウントのインポートが完了しました", mail.subject
+    assert_match "#{account.name} のインポートが完了しました！", mail.html_part.body.to_s
+
+    import = Account::Import.new(identity: david, account: account)
+    mail = ImportMailer.failed(import)
+    assert_equal "Fizzyアカウントのインポートに失敗しました", mail.subject
+    assert_match "申し訳ありませんが、Fizzyアカウントのインポートができませんでした。", mail.html_part.body.to_s
+
+    # 5. User email change confirmation
+    mail = UserMailer.email_change_confirmation(email_address: "new@example.com", token: "token123", user: user)
+    assert_equal "新しいメールアドレスを確認してください", mail.subject
+    assert_match "メールアドレス変更の確認", mail.html_part.body.to_s
+    assert_match "メールアドレス変更の確認", mail.text_part.body.to_s
+  end
+
+  test "static error pages render in both English and Japanese" do
+    %w[400.html 404.html 406-unsupported-browser.html 422.html 500.html].each do |file|
+      content = File.read(Rails.root.join("public", file))
+
+      # Contains English
+      assert_match(/Bad request|Sorry, that page|upgrade your browser|Unprocessable entity|Internal server error/, content, "Expected #{file} to contain English error")
+      assert_match(/Back home/, content, "Expected #{file} to contain 'Back home'")
+
+      # Contains Japanese
+      assert_match(/不正なリクエスト|ページが見つかりません|ブラウザのアップグレードが必要です|処理できません|サーバーエラー/, content, "Expected #{file} to contain Japanese error")
+      assert_match(/ホームへ戻る/, content, "Expected #{file} to contain 'ホームへ戻る'")
+    end
+  end
+end
