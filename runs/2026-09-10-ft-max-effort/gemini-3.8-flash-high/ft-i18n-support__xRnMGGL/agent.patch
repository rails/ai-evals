diff --git a/lib/japanese_translation.rb b/lib/japanese_translation.rb
new file mode 100644
index 0000000..788eaa4
--- /dev/null
+++ b/lib/japanese_translation.rb
@@ -0,0 +1,165 @@
+# frozen_string_literal: true
+
+require "nokogiri"
+require_relative "japanese_translation/dictionary"
+
+module JapaneseTranslation
+  # Skips elements where content should not be translated
+  SKIPPED_SELECTORS = [
+    "script",
+    "style",
+    "textarea",
+    "pre",
+    "code",
+    # Rich text editor & ActionText
+    "[data-controller*='lexxy']",
+    ".lexxy-editor",
+    ".lexxy-content",
+    "lexxy-prompt",
+    "action-text-attachment",
+    "trix-editor",
+    ".trix-content",
+    ".rich-text",
+    # User content
+    ".card__title",
+    ".card-perma__title",
+    ".card-perma__description",
+    ".comment__body",
+    ".step__name",
+    ".board__title",
+    ".board-selector__title"
+  ].join(", ").freeze
+
+  TRANSLATABLE_ATTRIBUTES = %w[
+    placeholder
+    title
+    aria-label
+    aria-description
+    data-tooltip
+    data-turbo-confirm
+    data-validation-message
+    data-boards-form-self-removal-prompt-message-value
+    data-multi-selection-combobox-no-selection-label-value
+  ].freeze
+
+  class << self
+    def translate_html(html)
+      return html if html.blank?
+
+      is_full_doc = html.include?("<!DOCTYPE") || html.include?("<html")
+      doc = is_full_doc ? Nokogiri::HTML5.parse(html) : Nokogiri::HTML5.fragment(html)
+
+      # 1. Update <html lang="ja"> if full document
+      if is_full_doc && (html_el = doc.at_css("html"))
+        html_el["lang"] = "ja"
+      end
+
+      # 2. Translate text nodes
+      doc.xpath(".//text()").each do |node|
+        next if node_inside_skipped_element?(node)
+
+        text = node.text
+        next if text.blank?
+
+        translated = translate_phrase(text)
+        node.content = translated if translated != text
+      end
+
+      # 3. Translate attributes
+      doc.xpath(".//*[@*]").each do |element|
+        next if element_inside_skipped_element?(element)
+
+        TRANSLATABLE_ATTRIBUTES.each do |attr|
+          if (val = element[attr]).present?
+            translated = translate_phrase(val)
+            element[attr] = translated if translated != val
+          end
+        end
+
+        # Handle submit / button input value
+        if element.name == "input" && %w[submit button].include?(element["type"]&.downcase)
+          if (val = element["value"]).present?
+            translated = translate_phrase(val)
+            element["value"] = translated if translated != val
+          end
+        end
+
+        # Handle img alt attribute (unless avatar)
+        if element.name == "img" && !element["class"]&.include?("avatar")
+          if (val = element["alt"]).present?
+            translated = translate_phrase(val)
+            element["alt"] = translated if translated != val
+          end
+        end
+      end
+
+      is_full_doc ? doc.to_html : doc.to_html
+    end
+
+    def translate_text(text)
+      return text if text.blank?
+
+      text.split("\n").map do |line|
+        translate_phrase(line)
+      end.join("\n")
+    end
+
+    def translate_phrase(str)
+      return str if str.blank?
+
+      leading_ws = str[/\A\s*/]
+      trailing_ws = str[/\s*\z/]
+      core = str.strip
+      return str if core.empty?
+
+      # 1. Exact match with original core
+      if (ja = DICTIONARY[core])
+        return "#{leading_ws}#{ja}#{trailing_ws}"
+      end
+
+      # 2. Match with normalized key (handling quotes, entities, ellipsis)
+      norm = normalize_key(core)
+      if (ja = DICTIONARY[norm])
+        return "#{leading_ws}#{ja}#{trailing_ws}"
+      end
+
+      # 3. Dynamic patterns
+      PATTERNS.each do |pattern, replacement|
+        if core =~ pattern
+          result = if replacement.respond_to?(:call)
+            replacement.call(Regexp.last_match)
+          else
+            core.sub(pattern, replacement)
+          end
+          return "#{leading_ws}#{result}#{trailing_ws}"
+        end
+      end
+
+      str
+    end
+
+    private
+
+    def normalize_key(str)
+      str.to_s
+         .gsub("\u00A0", " ")
+         .gsub(/[‘’]/, "'")
+         .gsub(/[“”]/, '"')
+         .gsub("…", "...")
+         .strip
+    end
+
+    def node_inside_skipped_element?(node)
+      # Check if node is inside any skipped element
+      node.ancestors(SKIPPED_SELECTORS).any? ||
+        # Don't translate user name unless it is "You"
+        (node.ancestors(".user__name").any? && node.text.strip != "You") ||
+        # Don't translate tags
+        (node.ancestors(".tag").any? && !node.ancestors(".tag--create").any?)
+    end
+
+    def element_inside_skipped_element?(element)
+      element.matches?(SKIPPED_SELECTORS) || element.ancestors(SKIPPED_SELECTORS).any?
+    end
+  end
+end
