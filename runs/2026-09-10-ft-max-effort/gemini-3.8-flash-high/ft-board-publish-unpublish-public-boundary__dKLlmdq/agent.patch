index 0000000..638bb07
--- /dev/null
+++ b/test/controllers/public/boards/cards_controller_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication_key
+    @card = cards(:text) # published card on writebook board
+  end
+
+  test "unauthenticated visitor can view published card" do
+    untenanted do
+      get public_board_card_path(@key, @card.number)
+      assert_response :success
+      assert_select "h1", text: @card.title
+    end
+  end
+
+  test "unauthenticated visitor can view published card using publication object in helper" do
+    untenanted do
+      get public_board_card_path(@board.publication, @card)
+      assert_response :success
+      assert_select "h1", text: @card.title
+    end
+  end
+
+  test "unauthenticated visitor can view published card as JSON" do
+    untenanted do
+      get public_board_card_path(@key, @card.number), as: :json
+      assert_response :success
+      assert_equal @card.title, @response.parsed_body["title"]
+      assert_equal "http://www.example.com/public/boards/#{@key}", @response.parsed_body["board"]["public_url"]
+    end
+  end
+
+  test "drafted card on published board returns 404" do
+    draft_card = Current.set(account: accounts("37s"), user: users(:kevin)) do
+      @board.cards.create!(title: "Draft", status: :drafted)
+    end
+
+    untenanted do
+      get public_board_card_path(@key, draft_card.number)
+      assert_response :not_found
+    end
+  end
+
+  test "only cards belonging to this board are accessed" do
+    untenanted do
+      get public_board_card_path(@key, 1)
+      assert_response :success
+      assert_select "h1", text: cards(:logo).title
+      assert_not_equal cards(:radio).title, cards(:logo).title
+    end
+  end
+
+  test "non-existent card number returns 404" do
+    untenanted do
+      get public_board_card_path(@key, 9999999)
+      assert_response :not_found
+    end
+  end
+
+  test "card on unpublished board returns 404" do
+    @board.unpublish
+
+    untenanted do
+      get public_board_card_path(@key, @card.number)
+      assert_response :not_found
+    end
+  end
+
+  test "closed card on published board can be viewed" do
+    @card.close(user: users(:kevin))
+    assert @card.closed?
+    assert @card.published?
+
+    untenanted do
+      get public_board_card_path(@key, @card.number)
+      assert_response :success
+      assert_select "h1", text: @card.title
+    end
+  end
+end
