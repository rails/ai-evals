diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..708eea6
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,46 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy, class_name: "Board::Publication"
+
+    scope :published, -> { joins(:publication) }
+    scope :unpublished, -> { where.missing(:publication) }
+  end
+
+  def published?
+    publication.present? && publication.persisted?
+  end
+
+  def publish
+    transaction do
+      if publication&.persisted?
+        publication
+      else
+        create_publication!.tap { touch }
+      end
+    end
+  end
+
+  def unpublish
+    transaction do
+      if publication
+        publication.destroy
+        reset_publication
+        touch
+      end
+    end
+  end
+
+  def publication_key
+    publication&.key if published?
+  end
+
+  def public_url(**options)
+    if published?
+      options[:script_name] = nil
+      options[:host] ||= Rails.application.routes.default_url_options[:host] || "example.com"
+      Rails.application.routes.url_helpers.public_board_url(publication_key, **options)
+    end
+  end
+end
