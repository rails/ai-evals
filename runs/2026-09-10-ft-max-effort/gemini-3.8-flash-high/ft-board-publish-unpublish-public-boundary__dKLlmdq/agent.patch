diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..c998066
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,109 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "admin can publish board" do
+    assert_not @board.published?
+
+    assert_difference -> { Board::Publication.count }, +1 do
+      post board_publication_path(@board)
+    end
+
+    assert_response :redirect
+    assert @board.reload.published?
+    assert_not_nil @board.publication_key
+  end
+
+  test "admin can publish board as JSON" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert @board.reload.published?
+    assert_equal @response.parsed_body["public_url"], @board.public_url(host: "www.example.com")
+  end
+
+  test "admin can unpublish board" do
+    @board.publish
+    assert @board.published?
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board)
+    end
+
+    assert_response :redirect
+    assert_not @board.reload.published?
+    assert_nil @board.public_url
+  end
+
+  test "admin can unpublish board as JSON" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "post and delete using /boards/:id/publication path" do
+    post "#{integration_session.default_url_options[:script_name]}/boards/#{@board.id}/publication"
+    assert_response :redirect
+    assert @board.reload.published?
+
+    delete "#{integration_session.default_url_options[:script_name]}/boards/#{@board.id}/publication"
+    assert_response :redirect
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin cannot publish board" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board)
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "non-admin cannot unpublish board" do
+    @board.publish
+
+    logout_and_sign_in_as :jz
+
+    delete board_publication_path(@board)
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "board creator who is not admin cannot publish board" do
+    assert_equal users(:david), @board.creator
+    assert_not users(:david).admin?
+
+    logout_and_sign_in_as :david
+
+    post board_publication_path(@board)
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "owner can publish and unpublish board" do
+    logout_and_sign_in_as :jason
+
+    post board_publication_path(@board)
+    assert_response :redirect
+    assert @board.reload.published?
+
+    delete board_publication_path(@board)
+    assert_response :redirect
+    assert_not @board.reload.published?
+  end
+
+  test "unauthenticated visitor cannot publish or unpublish" do
+    sign_out
+
+    post board_publication_path(@board)
+    assert_response :redirect
+    assert_match %r{session/menu|session/new|sign_in}, response.redirect_url
+  end
+end
