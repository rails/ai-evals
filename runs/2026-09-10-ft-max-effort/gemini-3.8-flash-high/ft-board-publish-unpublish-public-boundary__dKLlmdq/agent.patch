diff --git a/test/models/board/publication_test.rb b/test/models/board/publication_test.rb
new file mode 100644
index 0000000..acc5ae9
--- /dev/null
+++ b/test/models/board/publication_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Board::PublicationTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "board is not published by default" do
+    assert_not @board.published?
+    assert_nil @board.publication
+    assert_nil @board.publication_key
+    assert_nil @board.public_url
+  end
+
+  test "publish creates publication with secure token key" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      @board.publish
+    end
+
+    assert @board.published?
+    assert_not_nil @board.publication
+    assert_equal 24, @board.publication_key.length
+    assert_equal @board.account, @board.publication.account
+    assert_equal "http://example.com/public/boards/#{@board.publication_key}", @board.public_url
+  end
+
+  test "publish is idempotent" do
+    @board.publish
+    original_key = @board.publication_key
+
+    assert_no_difference -> { Board::Publication.count } do
+      @board.publish
+    end
+
+    assert_equal original_key, @board.publication_key
+  end
+
+  test "unpublish destroys publication" do
+    @board.publish
+    assert @board.published?
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+    assert_nil @board.publication
+    assert_nil @board.publication_key
+    assert_nil @board.public_url
+  end
+
+  test "destroying board destroys publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy
+    end
+  end
+
+  test "to_param returns key" do
+    @board.publish
+    assert_equal @board.publication_key, @board.publication.to_param
+  end
+
+  test "published and unpublished scopes" do
+    assert_includes Board.unpublished, @board
+    assert_not_includes Board.published, @board
+
+    @board.publish
+
+    assert_not_includes Board.unpublished, @board
+    assert_includes Board.published, @board
+  end
+end
