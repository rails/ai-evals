--- /dev/null
+++ b/app/controllers/boards/publications_controller.rb
@@ -0,0 +1,27 @@
+class Boards::PublicationsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_board
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_back_or_to @board }
+      format.json { render "boards/show", status: :created }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_back_or_to @board }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_board
+      @board = Current.account.boards.find(params[:board_id] || params[:id])
+    end
+end
diff --git a/app/controllers/concerns/public_board_scoped.rb b/app/controllers/concerns/public_board_scoped.rb
new file mode 100644
index 0000000..e1d0b43
--- /dev/null
+++ b/app/controllers/concerns/public_board_scoped.rb
@@ -0,0 +1,23 @@
+module PublicBoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    layout "public"
+
+    skip_before_action :require_account
+    allow_unauthenticated_access
+
+    before_action :set_board
+  end
+
+  private
+    def set_board
+      key = params[:board_key] || params[:key]
+      @publication = Board::Publication.find_by!(key: key)
+      @board = @publication.board
+      raise ActiveRecord::RecordNotFound unless @board.account.active?
+
+      Current.account = @board.account
+      Current.user = Current.identity&.users&.find_by(account: Current.account)
+    end
+end
