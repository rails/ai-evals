new file mode 100644
index 0000000..ad37ead
--- /dev/null
+++ b/docs/deployment.md
@@ -0,0 +1,69 @@
+## Deployment
+
+Fizzy comes configured for single-server deployments with [Kamal](https://kamal-deploy.org/): a single Linux server running Docker, SQLite for data storage, everything inside one container, automatic SSL certificate provisioning via `kamal-proxy`, and background jobs running on the box.
+
+### Prerequisites
+
+1. **A Linux server**: An Ubuntu or Debian server accessible via SSH (as `root` or a user with sudo privileges).
+2. **A domain or hostname**: DNS records (A/AAAA) pointing your hostname (e.g. `fizzy.example.com`) to the server's public IP address.
+3. **A container registry**: An account on Docker Hub, GitHub Container Registry (ghcr.io), or any other Docker registry where your built image will be pushed.
+4. **An SMTP mail server**: Credentials for sending outbound emails (magic link login codes and notifications), such as Postmark, SendGrid, Amazon SES, or your own mail server.
+
+### 1. Configure `config/deploy.yml`
+
+Edit `config/deploy.yml` to fill in your deployment details:
+
+- **Hostname**: Under `proxy:`, set `host:` to your domain name (e.g. `fizzy.example.com`).
+- **Server IP**: Under `servers: web:`, replace `192.168.0.1` with your server's IP address.
+- **Registry**: Under `registry:`, set your registry `username` (and `server` if using a registry other than Docker Hub).
+- **Image**: Set `image:` to your registry path (e.g. `your-user/fizzy` or `ghcr.io/your-user/fizzy`).
+- **Mail server**: Under `env: clear:`, set `SMTP_ADDRESS`, `SMTP_PORT`, `SMTP_USERNAME`, and optionally `MAILER_FROM_ADDRESS`.
+
+### 2. Configure secrets in `.kamal/secrets`
+
+Generate a secret key base for Rails:
+
+```sh
+bin/rails secret
+```
+
+Then configure `.kamal/secrets` by setting the environment variables in your local shell or by writing them directly into the file:
+
+- `KAMAL_REGISTRY_PASSWORD`: Your container registry password or personal access token.
+- `SECRET_KEY_BASE`: The secret key generated by `bin/rails secret`.
+- `SMTP_PASSWORD`: The password for your SMTP mail server.
+
+For example, export them in your shell:
+
+```sh
+export KAMAL_REGISTRY_PASSWORD="your-registry-token"
+export SECRET_KEY_BASE="your-generated-secret-key-base"
+export SMTP_PASSWORD="your-smtp-password"
+```
+
+### 3. Deploy with `kamal setup`
+
+Run the setup command to bootstrap the server and launch Fizzy:
+
+```sh
+bin/kamal setup
+```
+
+This will:
+1. Ensure Docker is installed on your server.
+2. Build and push the application Docker image.
+3. Start `kamal-proxy` on ports 80 and 443 with automatic Let's Encrypt SSL certification for your hostname.
+4. Create the persistent `fizzy_storage` Docker volume.
+5. Boot the container, run database migrations (`bin/rails db:prepare`), and launch Puma with Solid Queue.
+
+Once finished, your Fizzy instance will be live at `https://your-host`!
+
+### Subsequent Deploys
+
+To deploy application updates after committing changes:
+
+```sh
+bin/kamal deploy
+```
+
+All SQLite databases and uploaded files live in `/rails/storage` and are stored on the persistent `fizzy_storage` volume, surviving redeployments and container restarts. Background jobs will continue to run inside the web container on the server.
diff --git a/test/deploy_config_test.rb b/test/deploy_config_test.rb
new file mode 100644
index 0000000..3a7eb1a
--- /dev/null
+++ b/test/deploy_config_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+require "kamal"
+
+class DeployConfigTest < ActiveSupport::TestCase
+  setup do
+    @deploy_config_path = Rails.root.join("config/deploy.yml")
+    @secrets_path = Rails.root.join(".kamal/secrets")
+  end
+
+  test "deploy.yml exists and is valid Kamal configuration" do
+    assert File.exist?(@deploy_config_path), "config/deploy.yml must exist"
+    assert File.exist?(@secrets_path), ".kamal/secrets must exist"
+
+    config = Kamal::Configuration.create_from(config_file: @deploy_config_path, destination: nil)
+
+    assert_equal "fizzy", config.service
+    assert_equal [ "web" ], config.roles.map(&:name)
+    assert_equal [ "fizzy_storage:/rails/storage" ], config.raw_config["volumes"]
+    assert_equal "/rails/public/assets", config.raw_config["asset_path"]
+    assert_equal [ "amd64" ], config.builder.arches
+  end
+
+  test "deploy.yml configures SSL from proxy" do
+    config = Kamal::Configuration.create_from(config_file: @deploy_config_path, destination: nil)
+
+    assert config.proxy.ssl?, "Proxy SSL should be enabled"
+    assert config.proxy.hosts.present?, "Proxy host should be configured"
+  end
+
+  test "deploy.yml runs background jobs on the box in puma" do
+    config = Kamal::Configuration.create_from(config_file: @deploy_config_path, destination: nil)
+    host = config.primary_host
+    clear_env = config.role(:web).env(host).clear
+
+    assert_equal true, clear_env["SOLID_QUEUE_IN_PUMA"], "Background jobs must run in Puma"
+    assert_nil config.raw_config.dig("servers", "jobs"), "Jobs role must not be a separate container"
+  end
+
+  test "deploy.yml provides host, mail server and secret placeholders" do
+    config = Kamal::Configuration.create_from(config_file: @deploy_config_path, destination: nil)
+    host = config.primary_host
+    clear_env = config.role(:web).env(host).clear
+
+    assert clear_env.key?("APP_HOST"), "APP_HOST should be in clear env"
+    assert_equal config.proxy.hosts.first, clear_env["APP_HOST"], "APP_HOST should match proxy host"
+
+    assert clear_env.key?("SMTP_ADDRESS"), "SMTP_ADDRESS should be present"
+    assert clear_env.key?("SMTP_PORT"), "SMTP_PORT should be present"
+    assert clear_env.key?("SMTP_USERNAME"), "SMTP_USERNAME should be present"
+
+    secrets = config.role(:web).env(host).secrets.to_h
+    assert secrets.key?("SECRET_KEY_BASE"), "SECRET_KEY_BASE should be in secrets"
+    assert secrets.key?("SMTP_PASSWORD"), "SMTP_PASSWORD should be in secrets"
+    assert secrets.key?("KAMAL_REGISTRY_PASSWORD"), "KAMAL_REGISTRY_PASSWORD should be in secrets"
+  end
+
+  test "production boot configures URL options and SMTP settings from ENV" do
+    runner_code = <<~'RUBY'
+      puts "host=#{Rails.application.routes.default_url_options[:host]}"
+      puts "protocol=#{Rails.application.routes.default_url_options[:protocol]}"
+      puts "smtp_address=#{ActionMailer::Base.smtp_settings[:address]}"
+      puts "smtp_port=#{ActionMailer::Base.smtp_settings[:port]}"
+      puts "smtp_user=#{ActionMailer::Base.smtp_settings[:user_name]}"
+      puts "smtp_pw=#{ActionMailer::Base.smtp_settings[:password]}"
+      puts "smtp_auth=#{ActionMailer::Base.smtp_settings[:authentication]}"
+      puts "smtp_starttls=#{ActionMailer::Base.smtp_settings[:enable_starttls_auto]}"
+    RUBY
+
+    env_vars = {
+      "APP_HOST" => "fizzy.example.com",
+      "SMTP_ADDRESS" => "smtp.example.com",
+      "SMTP_PORT" => "587",
+      "SMTP_USERNAME" => "user",
+      "SMTP_PASSWORD" => "secret",
+      "SECRET_KEY_BASE" => "11111111111111111111111111111111",
+      "RAILS_ENV" => "production"
+    }
+
+    output, status = Open3.capture2(env_vars, "bin/rails", "runner", runner_code)
+    assert status.success?, "Process failed with output: #{output}"
+
+    assert_includes output, "host=fizzy.example.com"
+    assert_includes output, "protocol=https"
+    assert_includes output, "smtp_address=smtp.example.com"
+    assert_includes output, "smtp_port=587"
+    assert_includes output, "smtp_user=user"
+    assert_includes output, "smtp_pw=secret"
+    assert_includes output, "smtp_auth=plain"
+    assert_includes output, "smtp_starttls=true"
+  end
+
+  test "production boot handles empty secret strings without ArgumentError" do
+    env_vars = {
+      "RAILS_MASTER_KEY" => "",
+      "SECRET_KEY_BASE" => "11111111111111111111111111111111",
+      "RAILS_ENV" => "production"
+    }
+
+    output, status = Open3.capture2(env_vars, "bin/rails", "runner", 'puts "secret_ok"')
+    assert status.success?, "Process failed with output: #{output}"
+    assert_includes output, "secret_ok"
+  end
+end
