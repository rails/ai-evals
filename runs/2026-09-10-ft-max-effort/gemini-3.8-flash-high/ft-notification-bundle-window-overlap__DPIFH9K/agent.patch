+<tr>
+  <td>
+    <h1 class="title">Here’s what happened</h1>
+    <p class="subtitle"><%= pluralize(@notifications.size, "notification") %> in <%= @account.name %></p>
+
+    <% @notifications.group_by { |n| n.card.board }.each_with_index do |(board, notifications), index| %>
+      <% if index > 0 %>
+        <hr class="notification__board-separator">
+      <% end %>
+
+      <h2 class="notification__board">
+        <%= link_to board.name, board_url(board) %>
+      </h2>
+
+      <% notifications.each do |notification| %>
+        <div class="notification">
+          <table style="width: 100%">
+            <tr>
+              <td class="avatar__container">
+                <%= mail_avatar_tag notification.creator %>
+              </td>
+              <td>
+                <p class="card__title">
+                  <%= link_to notification.card.title.presence || "Card ##{notification.card.number}", card_url(notification.card) %>
+                </p>
+                <p class="notification__details">
+                  <%= notification.payload.body %>
+                </p>
+                <p class="notification__author">
+                  <%= notification.creator.name %> &bull; <%= time_ago_in_words(notification.created_at) %> ago
+                </p>
+              </td>
+            </tr>
+          </table>
+        </div>
+      <% end %>
+    <% end %>
+
+    <div class="footer">
+      <p class="txt-small">
+        You’re receiving this digest based on your notification settings.
+        <%= link_to "Change notification frequency", notifications_settings_url %>
+      </p>
+    </div>
+  </td>
+</tr>
