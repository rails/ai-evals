+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @settings = @user.settings
+  end
+
+  test "default bundle_email_frequency is never" do
+    assert_equal "never", @settings.bundle_email_frequency
+    assert @settings.never?
+    assert_not @settings.bundles_emails?
+  end
+
+  test "can set bundle_email_frequency to every_few_hours" do
+    @settings.update!(bundle_email_frequency: "every_few_hours")
+    assert_equal "every_few_hours", @settings.bundle_email_frequency
+    assert @settings.every_few_hours?
+    assert @settings.bundles_emails?
+    assert_equal 4.hours, @settings.bundle_duration
+  end
+
+  test "can set bundle_email_frequency to daily" do
+    @settings.update!(bundle_email_frequency: "daily")
+    assert_equal "daily", @settings.bundle_email_frequency
+    assert @settings.daily?
+    assert @settings.bundles_emails?
+    assert_equal 1.day, @settings.bundle_duration
+  end
+
+  test "can set bundle_email_frequency to weekly" do
+    @settings.update!(bundle_email_frequency: "weekly")
+    assert_equal "weekly", @settings.bundle_email_frequency
+    assert @settings.weekly?
+    assert @settings.bundles_emails?
+    assert_equal 1.week, @settings.bundle_duration
+  end
+
+  test "rejects invalid bundle_email_frequency" do
+    assert_raises(ArgumentError) do
+      @settings.bundle_email_frequency = "monthly"
+    end
+  end
+
+  test "delegated to user" do
+    assert_equal "never", @user.bundle_email_frequency
+    @user.bundle_email_frequency = "daily"
+    @user.settings.save!
+    assert_equal "daily", @user.reload.bundle_email_frequency
+  end
+
+  test "changing frequency to never cancels pending bundles" do
+    @settings.update!(bundle_email_frequency: "every_few_hours")
+    Notification::Bundle.create!(
+      account: @user.account,
+      user: @user,
+      starts_at: Time.current,
+      ends_at: 4.hours.from_now,
+      frequency: "every_few_hours"
+    )
+
+    assert_equal 1, @user.notification_bundles.pending.count
+
+    @settings.update!(bundle_email_frequency: "never")
+
+    assert_equal 0, @user.notification_bundles.pending.count
+  end
+
+  test "changing frequency extends ends_at of pending bundles" do
+    now = Time.current
+    @settings.update!(bundle_email_frequency: "every_few_hours")
+    bundle = Notification::Bundle.create!(
+      account: @user.account,
+      user: @user,
+      starts_at: now,
+      ends_at: now + 4.hours,
+      frequency: "every_few_hours"
+    )
+
+    @settings.update!(bundle_email_frequency: "daily")
+
+    bundle.reload
+    assert_in_delta (now + 1.day).to_i, bundle.ends_at.to_i, 2
+    assert_equal "daily", bundle.frequency
+  end
+end
