+++ b/app/models/card/searchable.rb
@@ -0,0 +1,38 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def search_by(query)
+      words = query.to_s.scan(/"([^"]+)"|(\S+)/).flatten.compact.map(&:strip).reject(&:blank?)
+      if words.empty?
+        none
+      else
+        words.reduce(all) do |scope, word|
+          scope.search_by_word(word)
+        end
+      end
+    end
+
+    def search_by_word(word)
+      pattern = "%#{ActiveRecord::Base.sanitize_sql_like(word)}%"
+
+      matching_descriptions = ActionText::RichText
+        .where(record_type: "Card", name: "description")
+        .where("LOWER(body) LIKE LOWER(?) ESCAPE '\\'", pattern)
+        .select(:record_id)
+
+      matching_comments = ActionText::RichText
+        .where(record_type: "Comment", name: "body")
+        .where("LOWER(body) LIKE LOWER(?) ESCAPE '\\'", pattern)
+        .select(:record_id)
+
+      matching_comment_cards = Comment
+        .where(id: matching_comments)
+        .select(:card_id)
+
+      where("LOWER(cards.title) LIKE LOWER(?) ESCAPE '\\'", pattern)
+        .or(where(id: matching_descriptions))
+        .or(where(id: matching_comment_cards))
+    end
+  end
+end
