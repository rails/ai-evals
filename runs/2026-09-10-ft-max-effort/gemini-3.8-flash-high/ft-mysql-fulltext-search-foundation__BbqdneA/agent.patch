index 0000000..ac0482e
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,60 @@
+module SearchesHelper
+  def highlight_search_title(card, query)
+    title_html = card_html_title(card)
+    if query.blank? || title_html.blank?
+      title_html
+    else
+      highlight(title_html, highlight_phrases(query))
+    end
+  end
+
+  def highlight_search_excerpt(content, query, radius: 100)
+    if content.blank?
+      ""
+    else
+      plain_text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+      plain_text = plain_text.gsub(/\s+/, " ").strip
+      phrases = highlight_phrases(query)
+
+      if phrases.empty?
+        ERB::Util.html_escape(plain_text.truncate(radius * 2))
+      else
+        match_phrase = phrases.find { |p| plain_text.match?(/#{Regexp.escape(p)}/i) }
+
+        if match_phrase
+          snip = excerpt(plain_text, match_phrase, radius: radius) || plain_text.truncate(radius * 2)
+          highlight(ERB::Util.html_escape(snip), phrases)
+        else
+          ERB::Util.html_escape(plain_text.truncate(radius * 2))
+        end
+      end
+    end
+  end
+
+  def matching_comments_for(card, query)
+    if query.blank?
+      []
+    else
+      phrases = highlight_phrases(query)
+      if phrases.empty?
+        []
+      else
+        pattern = /(#{phrases.map { |p| Regexp.escape(p) }.join("|")})/i
+        card.comments.select do |comment|
+          comment.body.to_plain_text.match?(pattern)
+        end
+      end
+    end
+  end
+
+  private
+    def highlight_phrases(query)
+      if query.blank?
+        []
+      else
+        phrases = query.to_s.scan(/"([^"]+)"|(\S+)/).flatten.compact.map(&:strip).reject(&:blank?)
+        words = query.to_s.scan(/\S+/).map { |w| w.gsub(/["'\\]/, "") }.reject(&:blank?)
+        (phrases + words).uniq
+      end
+    end
+end
