@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    Current.account = accounts("37s")
+    @board = boards(:writebook)
+  end
+
+  test "search_by returns none when query is blank" do
+    assert_equal 0, Card.search_by("").count
+    assert_equal 0, Card.search_by("   ").count
+    assert_equal 0, Card.search_by(nil).count
+  end
+
+  test "search_by finds cards by title" do
+    card = cards(:logo)
+    results = @board.cards.search_by("logo")
+
+    assert_includes results, card
+  end
+
+  test "search_by finds cards by description" do
+    card = cards(:text)
+    card.update! description: "Detailed description with keyword banana inside"
+
+    results = @board.cards.search_by("banana")
+    assert_includes results, card
+  end
+
+  test "search_by finds cards by comment body" do
+    card = cards(:layout)
+    # layout_overflowing_david has "The text is overflowing the container."
+    results = @board.cards.search_by("overflowing")
+    assert_includes results, card
+  end
+
+  test "search_by is case-insensitive" do
+    card = cards(:logo)
+
+    assert_includes @board.cards.search_by("LOGO"), card
+    assert_includes @board.cards.search_by("logo"), card
+  end
+
+  test "search_by matches multiple words" do
+    card = cards(:shipping) # "We need to ship the app"
+    results = @board.cards.search_by("ship app")
+
+    assert_includes results, card
+  end
+
+  test "search_by does not match when a word is missing" do
+    card = cards(:shipping) # "We need to ship the app"
+    results = @board.cards.search_by("ship nonexistentword")
+
+    assert_not_includes results, card
+  end
+
+  test "search_by handles quoted phrases" do
+    card = cards(:shipping)
+    results = @board.cards.search_by('"ship the app"')
+
+    assert_includes results, card
+  end
+
+  test "search_by handles special LIKE characters safely" do
+    card = @board.cards.create!(
+      creator: users(:kevin),
+      title: "Special 100% discount",
+      status: :published
+    )
+
+    assert_includes @board.cards.search_by("100%"), card
+    assert_empty @board.cards.search_by("50%")
+  end
+end
