+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,195 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+    Current.account = accounts("37s")
+  end
+
+  test "show without query renders search page with search input" do
+    get search_path
+    assert_response :success
+    assert_select "input[type=search][name=q]"
+    assert_select ".card", count: 0
+  end
+
+  test "show with blank query renders search page without results" do
+    get search_path(q: "   ")
+    assert_response :success
+    assert_select "input[type=search][name=q]"
+    assert_select ".card", count: 0
+  end
+
+  test "search by title wraps matched word in mark" do
+    get search_path(q: "logo")
+    assert_response :success
+
+    assert_select "mark", text: "logo"
+    assert_select "#article_card_#{cards(:logo).id}"
+    assert_select ".card h3 mark", text: "logo"
+    assert_select ".card h3", text: /The logo isn['’]t big enough/
+  end
+
+  test "search by description wraps matched word in mark" do
+    card = cards(:text)
+    card.update! description: "We need to prepare for the rocket launch next month."
+
+    get search_path(q: "launch")
+    assert_response :success
+
+    assert_select "mark", text: "launch"
+    assert_select "#article_card_#{card.id}"
+    assert_select ".card .card__search-excerpt mark", text: "launch"
+  end
+
+  test "search by comment body wraps matched word in mark" do
+    # layout_overflowing_david comment has body "The text is overflowing the container." on cards(:layout)
+    get search_path(q: "overflowing")
+    assert_response :success
+
+    assert_select "mark", text: "overflowing"
+    assert_select "#article_card_#{cards(:layout).id}"
+    assert_select ".card .card__search-comments mark", text: "overflowing"
+  end
+
+  test "search results are ordered newest first" do
+    board = boards(:writebook)
+    older_card = board.cards.create!(
+      creator: users(:kevin),
+      title: "Older deploysync card",
+      created_at: 2.days.ago,
+      status: :published
+    )
+    newer_card = board.cards.create!(
+      creator: users(:kevin),
+      title: "Newer deploysync card",
+      created_at: 1.hour.ago,
+      status: :published
+    )
+
+    get search_path(q: "deploysync")
+    assert_response :success
+
+    card_ids = css_select(".card").map { |el| el["id"] }
+    assert_equal [ "article_card_#{newer_card.id}", "article_card_#{older_card.id}" ], card_ids
+  end
+
+  test "draft cards never turn up when matched by title" do
+    board = boards(:writebook)
+    board.cards.create!(
+      creator: users(:kevin),
+      title: "Draft card with secretqueryword",
+      status: :drafted
+    )
+
+    get search_path(q: "secretqueryword")
+    assert_response :success
+    assert_select ".card", count: 0
+  end
+
+  test "draft cards never turn up when matched by description" do
+    board = boards(:writebook)
+    board.cards.create!(
+      creator: users(:kevin),
+      title: "Draft card",
+      description: "Draft description with secretqueryword",
+      status: :drafted
+    )
+
+    get search_path(q: "secretqueryword")
+    assert_response :success
+    assert_select ".card", count: 0
+  end
+
+  test "comments on draft cards never turn up" do
+    board = boards(:writebook)
+    card = board.cards.create!(
+      creator: users(:kevin),
+      title: "Temporary card",
+      status: :published
+    )
+    card.comments.create!(creator: users(:kevin), body: "Comment with secretqueryword")
+    card.update_column(:status, "drafted")
+
+    get search_path(q: "secretqueryword")
+    assert_response :success
+    assert_select ".card", count: 0
+  end
+
+  test "people only see results from boards they currently have access to" do
+    # cards(:radio) is on miltons_wish_list which Kevin cannot access
+    get search_path(q: "radio")
+    assert_response :success
+    assert_select ".card", count: 0
+
+    # cards(:text) is on writebook which Kevin can access
+    get search_path(q: "small")
+    assert_response :success
+    assert_select "#article_card_#{cards(:text).id}"
+  end
+
+  test "revoking access hides cards from search" do
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "#article_card_#{cards(:logo).id}"
+
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "#article_card_#{cards(:logo).id}", count: 0
+  end
+
+  test "search with multiple words highlights each matched word" do
+    get search_path(q: "logo big")
+    assert_response :success
+
+    assert_select "mark", text: "logo"
+    assert_select "mark", text: "big"
+  end
+
+  test "search preserves original casing inside mark tag" do
+    get search_path(q: "LOGO")
+    assert_response :success
+
+    # Original text is "logo", so mark contains "logo"
+    assert_select "mark", text: "logo"
+  end
+
+  test "search displays multiple matching comments on the same card" do
+    card = cards(:text)
+    card.comments.create!(creator: users(:kevin), body: "First comment mentions xylophone")
+    card.comments.create!(creator: users(:david), body: "Second comment also mentions xylophone")
+
+    get search_path(q: "xylophone")
+    assert_response :success
+
+    assert_select "#article_card_#{card.id}"
+    assert_select ".card__search-comment", count: 2
+    assert_select "mark", text: "xylophone", count: 2
+  end
+
+  test "search non-matching query shows blank slate" do
+    get search_path(q: "nonexistentquery12345")
+    assert_response :success
+
+    assert_select ".card", count: 0
+    assert_select ".blank-slate", text: "No cards match that search"
+  end
+
+  test "unauthenticated user is redirected to login" do
+    sign_out
+
+    get search_path(q: "logo")
+    assert_response :redirect
+  end
+
+  test "search as json" do
+    get search_path(q: "logo", format: :json)
+    assert_response :success
+
+    assert_equal [ cards(:logo).number ], @response.parsed_body.pluck("number")
+  end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
