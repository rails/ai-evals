+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @page_title %></span>
+  </h1>
+<% end %>
+
+<div class="search center full-width margin-block-start" style="max-inline-size: var(--main-width); margin-inline: auto; padding-inline: 1ch;">
+  <%= form_with url: search_path, method: :get, class: "flex gap-half margin-block-end", data: { turbo_action: "advance" } do |form| %>
+    <%= form.search_field :q,
+          value: @query,
+          placeholder: "Search cards by title, description, or comment…",
+          autofocus: true,
+          class: "input input--transparent full-width",
+          autocomplete: "off" %>
+    <%= form.submit "Search", class: "btn btn--primary" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <%= turbo_frame_tag :cards_container do %>
+      <section class="cards cards--grid">
+        <div class="cards__list hide-scrollbar">
+          <%= with_automatic_pagination :cards_paginated_container, @page do %>
+            <%= render partial: "searches/card", collection: @cards, as: :card, locals: { query: @query } %>
+          <% end %>
+          <div class="blank-slate">No cards match that search</div>
+        </div>
+      </section>
+    <% end %>
+  <% end %>
+</div>
