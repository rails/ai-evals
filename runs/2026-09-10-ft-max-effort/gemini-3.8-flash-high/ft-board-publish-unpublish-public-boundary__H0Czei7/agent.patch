@@ -0,0 +1,29 @@
+class Boards::PublicationsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_board
+
+  def create
+    @board.publish
+
+    respond_to do |format|
+      format.html { redirect_back_or_to edit_board_path(@board) }
+      format.turbo_stream
+      format.json { render "boards/show", status: :created }
+    end
+  end
+
+  def destroy
+    @board.unpublish
+
+    respond_to do |format|
+      format.html { redirect_back_or_to edit_board_path(@board) }
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_board
+      @board = Current.account.boards.find(params[:board_id] || params[:id])
+    end
+end
