diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..88afa58
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,42 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :published, -> { where.not(publication_key: nil) }
+    scope :unpublished, -> { where(publication_key: nil) }
+  end
+
+  def publish
+    unless published?
+      self.publication_key = generate_publication_key
+      save!
+    end
+  end
+
+  def unpublish
+    if published?
+      update!(publication_key: nil)
+    end
+  end
+
+  def published?
+    publication_key.present?
+  end
+
+  def public_url(**options)
+    if published?
+      default_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        { host: "localhost" }
+      Rails.application.routes.url_helpers.public_board_url(publication_key, **default_options.merge(script_name: nil).merge(options))
+    end
+  end
+
+  private
+    def generate_publication_key
+      loop do
+        candidate = self.class.generate_unique_secure_token(length: 24)
+        break candidate unless self.class.exists?(publication_key: candidate)
+      end
+    end
+end
