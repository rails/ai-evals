+require "test_helper"
+
+class Public::RichCardRenderingTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+
+    @card = cards(:logo)
+    @card.steps.create!(content: "Step 1", completed: false)
+    @card.steps.create!(content: "Step 2", completed: true)
+    @card.comments.create!(creator: users(:kevin), body: "A helpful public comment")
+    @column = columns(:writebook_in_progress)
+  end
+
+  test "renders board with columns and cards" do
+    untenanted do
+      get public_board_path(@board.publication_key)
+      assert_response :success
+      assert_select "h1", text: @board.name
+      assert_select "a[href=?]", public_board_column_path(@board.publication_key, @column)
+    end
+  end
+
+  test "renders column with cards" do
+    untenanted do
+      get public_board_column_path(@board.publication_key, @column)
+      assert_response :success
+      assert_select "h1", text: "Column: #{@column.name}"
+    end
+  end
+
+  test "renders card with steps and comments" do
+    untenanted do
+      get public_board_card_path(@board.publication_key, @card.number)
+      assert_response :success
+      assert_select "h1", text: @card.title
+      assert_select ".step", count: 2
+      assert_select ".step__content", text: "Step 1"
+      assert_select ".step__content", text: "Step 2"
+      assert_select ".comments", count: 1
+      assert_includes response.body, "A helpful public comment"
+    end
+  end
+
+  test "renders closed card stamp" do
+    @card.close(user: users(:kevin))
+
+    untenanted do
+      get public_board_card_path(@board.publication_key, @card.number)
+      assert_response :success
+      assert_select ".card__closed-title", text: "Done"
+    end
+  end
+
+  test "renders golden card" do
+    @card.gild
+
+    untenanted do
+      get public_board_card_path(@board.publication_key, @card.number)
+      assert_response :success
+      assert_select ".golden-effect"
+    end
+  end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..b956aa2
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are unpublished by default" do
+    assert_not @board.published?
+    assert_nil @board.publication_key
+    assert_nil @board.public_url
+  end
+
+  test "publish generates publication key and marks board as published" do
+    @board.publish
+
+    assert @board.published?
+    assert @board.publication_key.present?
+    assert_includes Board.published, @board
+    assert_not_includes Board.unpublished, @board
+    assert_equal "http://example.com/public/boards/#{@board.publication_key}", @board.public_url
+  end
+
+  test "publishing an already published board preserves existing key" do
+    @board.publish
+    key = @board.publication_key
+
+    @board.publish
+    assert_equal key, @board.publication_key
+  end
+
+  test "unpublish clears publication key and marks board as unpublished" do
+    @board.publish
+    assert @board.published?
+
+    @board.unpublish
+    assert_not @board.published?
+    assert_nil @board.publication_key
+    assert_nil @board.public_url
+    assert_includes Board.unpublished, @board
+    assert_not_includes Board.published, @board
+  end
+end
