diff --git a/test/controllers/public/boards/cards_controller_test.rb b/test/controllers/public/boards/cards_controller_test.rb
new file mode 100644
index 0000000..64d8985
--- /dev/null
+++ b/test/controllers/public/boards/cards_controller_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @card = cards(:logo)
+  end
+
+  test "anyone can view a published card of a published board without authentication" do
+    untenanted do
+      get public_board_card_path(@board.publication_key, @card.number)
+      assert_response :success
+      assert_includes response.body, CGI.escapeHTML(@card.title)
+      assert_select "a[href=?]", public_board_path(@board.publication_key)
+    end
+  end
+
+  test "authenticated user can view a public card" do
+    sign_in_as :kevin
+
+    get public_board_card_path(@board.publication_key, @card.number)
+    assert_response :success
+    assert_includes response.body, CGI.escapeHTML(@card.title)
+  end
+
+  test "view public card as JSON" do
+    untenanted do
+      get public_board_card_path(@board.publication_key, @card.number), as: :json
+      assert_response :success
+      assert_equal @card.title, @response.parsed_body["title"]
+      assert_equal @card.number, @response.parsed_body["number"]
+    end
+  end
+
+  test "drafted card cannot be opened on a public board" do
+    draft_card = Current.set(account: @board.account, user: users(:david)) do
+      @board.cards.create!(creator: users(:david), status: "drafted")
+    end
+
+    untenanted do
+      get public_board_card_path(@board.publication_key, draft_card.number)
+      assert_response :not_found
+    end
+  end
+
+  test "card on unpublished board returns 404" do
+    key = @board.publication_key
+    @board.unpublish
+
+    untenanted do
+      get "/public/boards/#{key}/cards/#{@card.number}"
+      assert_response :not_found
+    end
+  end
+
+  test "card from another board returns 404" do
+    other_board = boards(:private)
+    other_card = Current.set(account: accounts("37s"), user: users(:kevin)) do
+      other_board.cards.create!(creator: users(:kevin), title: "Private card", status: "published")
+    end
+
+    untenanted do
+      get public_board_card_path(@board.publication_key, other_card.number)
+      assert_response :not_found
+    end
+  end
+
+  test "non-existent card number returns 404" do
+    untenanted do
+      get public_board_card_path(@board.publication_key, 99999999)
+      assert_response :not_found
+    end
+  end
+end
