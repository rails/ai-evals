+
+    assert @card.stalled?
+  end
+
+  test "card that had a burst but has recent activity is not stalled" do
+    @card.burst!(at: 1.week.ago)
+    @card.update_columns(last_active_at: 1.week.ago)
+
+    assert_not @card.stalled?
+  end
+
+  test "card that had no burst is not stalled even after two weeks of inactivity" do
+    @card.update_columns(burst_at: nil, last_active_at: 3.weeks.ago)
+
+    assert_not @card.stalled?
+  end
+
+  test "closed card is not stalled" do
+    @card.burst!(at: 3.weeks.ago)
+    @card.update_columns(last_active_at: 3.weeks.ago)
