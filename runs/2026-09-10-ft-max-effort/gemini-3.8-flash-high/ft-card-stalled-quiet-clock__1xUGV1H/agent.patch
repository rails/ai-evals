+  end
+
+  test "reaction activity resets stalled card" do
+    @card.burst!(at: 3.weeks.ago)
+    @card.update_columns(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.reactions.create!(reacter: users(:david), content: "👍")
+
+    assert_not @card.reload.stalled?
+    assert_nil @card.burst_at
+  end
+
+  test "assignment activity resets stalled card and gives it a new burst" do
+    @card.burst!(at: 3.weeks.ago)
+    @card.update_columns(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.assign(users(:kevin))
+
+    assert_not @card.reload.stalled?
