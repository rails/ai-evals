+    end
+  end
+
+  test "stalled scope returns stalled cards" do
+    stalled_card = cards(:logo)
+    stalled_card.burst!(at: 3.weeks.ago)
+    stalled_card.update_columns(last_active_at: 3.weeks.ago)
+
+    active_card = cards(:text)
+    active_card.burst!(at: 1.day.ago)
+    active_card.update_columns(last_active_at: 1.day.ago)
+
+    old_quiet_card = cards(:shipping)
+    old_quiet_card.update_columns(burst_at: nil, last_active_at: 3.weeks.ago)
+
+    assert_includes Card.stalled, stalled_card
+    assert_not_includes Card.stalled, active_card
+    assert_not_includes Card.stalled, old_quiet_card
+  end
+end
