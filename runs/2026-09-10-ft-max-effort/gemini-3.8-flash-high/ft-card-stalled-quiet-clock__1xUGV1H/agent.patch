+
+    @card.taggings.create!(tag: tags(:mobile))
+
+    assert_not @card.reload.stalled?
+    assert_nil @card.burst_at
+  end
+
+  test "card reset by activity does not stall again two weeks later without a new burst" do
+    @card.burst!(at: 3.weeks.ago)
+    @card.update_columns(last_active_at: 3.weeks.ago)
+    assert @card.stalled?
+
+    @card.comments.create!(creator: users(:david), body: "Just checking in")
