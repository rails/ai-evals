diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..c2672db
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,239 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:logo)
+    @card.comments.delete_all
+    @card.assignments.delete_all
+    @card.update!(burst_at: nil, last_active_at: Time.current)
+  end
+
+  test "card gets a burst when assigned" do
+    assert_not @card.burst?
+
+    assert_changes -> { @card.reload.burst? }, to: true do
+      @card.assign(users(:david))
+    end
+  end
+
+  test "card gets a burst when reopened" do
+    @card.close(user: users(:david))
+    @card.update_columns(burst_at: nil)
+    assert_not @card.burst?
+
+    assert_changes -> { @card.reload.burst? }, to: true do
+      @card.reopen(user: users(:david))
+    end
+  end
+
+  test "card gets a burst when three comments from at least two people land within 1/3 of board auto-close period" do
+    # writebook board auto-close is 30 days, so 1/3 is 10 days
+    assert_not @card.burst?
+
+    travel_to 5.days.ago do
+      @card.comments.create!(creator: users(:david), body: "First comment")
+    end
+    assert_not @card.reload.burst?
+
+    travel_to 3.days.ago do
+      @card.comments.create!(creator: users(:kevin), body: "Second comment")
+    end
+    assert_not @card.reload.burst?
+
+    travel_to 1.day.ago do
+      @card.comments.create!(creator: users(:david), body: "Third comment")
+    end
+    assert @card.reload.burst?
+  end
+
+  test "three comments from the same person do not trigger a burst" do
+    travel_to 5.days.ago do
+      @card.comments.create!(creator: users(:david), body: "First comment")
+    end
+    travel_to 3.days.ago do
+      @card.comments.create!(creator: users(:david), body: "Second comment")
+    end
+    travel_to 1.day.ago do
+      @card.comments.create!(creator: users(:david), body: "Third comment")
+    end
+
+    assert_not @card.reload.burst?
+  end
+
+  test "two comments from two people do not trigger a burst" do
+    travel_to 3.days.ago do
+      @card.comments.create!(creator: users(:david), body: "First comment")
+    end
+    travel_to 1.day.ago do
+      @card.comments.create!(creator: users(:kevin), body: "Second comment")
+    end
+
+    assert_not @card.reload.burst?
+  end
+
+  test "three comments from two people outside 1/3 of auto-close period do not trigger a burst" do
+    # writebook board auto-close is 90 days, so 1/3 is 30 days
+    travel_to 35.days.ago do
+      @card.comments.create!(creator: users(:david), body: "First comment")
+    end
+    travel_to 3.days.ago do
+      @card.comments.create!(creator: users(:kevin), body: "Second comment")
+    end
+    travel_to Time.current do
+      @card.comments.create!(creator: users(:david), body: "Third comment")
+    end
+
+    # First comment is 35 days ago, more than 30 days before the third comment
+    assert_not @card.reload.burst?
+  end
+
+  test "system comments do not count toward comment burst" do
+    system_user = accounts("37s").system_user
+
+    travel_to 5.days.ago do
+      @card.comments.create!(creator: system_user, body: "System comment")
+    end
+    travel_to 3.days.ago do
+      @card.comments.create!(creator: users(:david), body: "David comment")
+    end
+    travel_to 1.day.ago do
+      @card.comments.create!(creator: users(:kevin), body: "Kevin comment")
+    end
+
+    assert_not @card.reload.burst?
+  end
+
+  test "card that had a burst and sees no activity for two weeks is stalled" do
+    @card.burst!(at: 2.weeks.ago - 1.hour)
