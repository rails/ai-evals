diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..b4bd530
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,53 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_THRESHOLD = 2.weeks
+
+  included do
+    scope :stalled, -> { active.where.not(burst_at: nil).where(last_active_at: ..STALL_THRESHOLD.ago).where(burst_at: ..STALL_THRESHOLD.ago) }
+
+    before_save :reset_burst_if_stalled, if: :will_save_change_to_last_active_at?
+    after_touch :touch_last_active_at, if: :stalled?
+  end
+
+  def burst!(at: Time.current)
+    update!(burst_at: at)
+  end
+
+  def burst?
+    burst_at.present?
+  end
+  alias_method :had_burst?, :burst?
+
+  def stalled?
+    active? && burst? && last_active_at <= STALL_THRESHOLD.ago && burst_at <= STALL_THRESHOLD.ago
+  end
+
+  def reset_stall
+    update!(burst_at: nil)
+  end
+
+  def check_for_comments_burst(comment)
+    return if comment.creator&.system?
+    return unless published?
+
+    window = (board.auto_postpone_period / 3.0).seconds
+    cutoff = comment.created_at - window
+    recent_comments = comments.by_user.where(created_at: cutoff..comment.created_at)
+
+    if recent_comments.count >= 3 && recent_comments.distinct.count("comments.creator_id") >= 2
+      burst!(at: comment.created_at)
+    end
+  end
+
+  private
+    def reset_burst_if_stalled
+      if was_stalled? && !will_save_change_to_burst_at? && (last_active_at_was && last_active_at > last_active_at_was)
+        self.burst_at = nil
+      end
+    end
+
+    def was_stalled?
+      active? && burst? && (last_active_at_was || last_active_at) <= STALL_THRESHOLD.ago && burst_at <= STALL_THRESHOLD.ago
+    end
+end
