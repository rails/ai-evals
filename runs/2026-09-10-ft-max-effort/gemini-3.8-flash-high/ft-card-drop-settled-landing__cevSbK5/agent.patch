diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..509b07b
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,317 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+  end
+
+  test "dragging a card to another column changes its column instantly and persists" do
+    visit board_url(@board)
+    page.execute_script("localStorage.clear()")
+
+    card = cards(:logo)
+    source_column = columns(:writebook_triage)
+    target_column = columns(:writebook_in_progress)
+
+    expand_column(source_column)
+
+    card_element = find("##{dom_id(card, :article)}")
+    target_element = find("##{dom_id(target_column)}")
+
+    source_count_before = source_column.cards.active.count
+    target_count_before = target_column.cards.active.count
+
+    card_element.drag_to(target_element)
+
+    # Immediately in target column DOM
+    within("##{dom_id(target_column)}") do
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+    end
+
+    # Database updated
+    assert_equal target_column, card.reload.column
+
+    # Counts updated
+    assert_equal (source_count_before - 1).to_s, find("##{dom_id(source_column)} .cards__expander-count", visible: :all).text(:all)
+    assert_equal (target_count_before + 1).to_s, find("##{dom_id(target_column)} .cards__expander-count", visible: :all).text(:all)
+  end
+
+  test "dragging card dims and target column lights up" do
+    visit board_url(@board)
+    page.execute_script("localStorage.clear()")
+
+    card = cards(:logo)
+    source_column = columns(:writebook_triage)
+    target_column = columns(:writebook_in_progress)
+
+    expand_column(source_column)
+
+    card_element = find("##{dom_id(card, :article)}")
+    target_element = find("##{dom_id(target_column)}")
+
+    # Test dragstart adds .drag-and-drop__dragged-item
+    page.execute_script(<<~JS, card_element)
+      const dt = new DataTransfer();
+      arguments[0].dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer: dt }));
+    JS
+
+    assert card_element[:class].include?("drag-and-drop__dragged-item")
+
+    # Test dragover on target column adds .drag-and-drop__hover-container
+    page.execute_script(<<~JS, target_element)
+      const dt = new DataTransfer();
+      arguments[0].dispatchEvent(new DragEvent("dragover", { bubbles: true, dataTransfer: dt }));
+    JS
+
+    assert target_element[:class].include?("drag-and-drop__hover-container")
+
+    # Test dragend cleans up classes
+    page.execute_script(<<~JS, card_element)
+      arguments[0].dispatchEvent(new DragEvent("dragend", { bubbles: true }));
+    JS
+
+    assert_not card_element[:class].include?("drag-and-drop__dragged-item")
+    assert_not target_element[:class].include?("drag-and-drop__hover-container")
+  end
+
+  test "dragging within the same column does nothing" do
+    visit board_url(@board)
+    page.execute_script("localStorage.clear()")
+
+    card = cards(:logo)
+    source_column = columns(:writebook_triage)
+
+    expand_column(source_column)
+
+    card_element = find("##{dom_id(card, :article)}")
+    source_element = find("##{dom_id(source_column)}")
+
+    # Hovering over same column does not light up
+    page.execute_script(<<~JS, card_element)
+      const dt = new DataTransfer();
+      arguments[0].dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer: dt }));
+    JS
+
+    page.execute_script(<<~JS, source_element)
+      const dt = new DataTransfer();
+      arguments[0].dispatchEvent(new DragEvent("dragover", { bubbles: true, dataTransfer: dt }));
+    JS
+
+    assert_not source_element[:class].include?("drag-and-drop__hover-container")
+
+    # Dropping on same column
+    card_element.drag_to(source_element)
+
+    assert_equal source_column, card.reload.column
+  end
+
+  test "dragging card to Maybe? (stream)" do
+    visit board_url(@board)
+    page.execute_script("localStorage.clear()")
+
+    card = cards(:logo)
+    source_column = columns(:writebook_triage)
+    maybe_column = find("#maybe")
+
+    expand_column(source_column)
+
+    card_element = find("##{dom_id(card, :article)}")
+    card_element.drag_to(maybe_column)
+
+    within("#maybe") do
+      assert_selector "##{dom_id(card, :article)}"
+    end
+
+    assert card.reload.awaiting_triage?
+    assert_nil card.column
+  end
+
+  test "dragging card to Not Now" do
+    visit board_url(@board)
+    page.execute_script("localStorage.clear()")
+
+    card = cards(:logo)
+    source_column = columns(:writebook_triage)
+    not_now_column = find("#not-now")
+
+    expand_column(source_column)
+
+    card_element = find("##{dom_id(card, :article)}")
+    card_element.drag_to(not_now_column)
+
+    within("#not-now") do
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+    end
+
+    assert card.reload.postponed?
+  end
+
+  test "dragging card to Done (closed)" do
+    visit board_url(@board)
+    page.execute_script("localStorage.clear()")
+
+    card = cards(:logo)
+    source_column = columns(:writebook_triage)
+    done_column = find("#closed-cards")
+
+    expand_column(source_column)
+
+    card_element = find("##{dom_id(card, :article)}")
+    card_element.drag_to(done_column)
+
+    within("#closed-cards") do
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+    end
+
+    assert card.reload.closed?
+  end
+
+  test "dragging card from Done to a column reopens it" do
+    card = cards(:shipping) # closed in fixtures
+    assert card.closed?
+
+    visit board_url(@board)
+    page.execute_script("localStorage.clear()")
+
+    target_column = columns(:writebook_in_progress)
+
+    expand_column(find("#closed-cards"))
+
+    card_element = find("##{dom_id(card, :article)}")
+    target_element = find("##{dom_id(target_column)}")
+
+    card_element.drag_to(target_element)
+
+    within("##{dom_id(target_column)}") do
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+    end
+
+    assert_not card.reload.closed?
+    assert_equal target_column, card.column
+  end
+
+  test "golden cards remain at top when non-golden card is dropped into column" do
+    target_column = columns(:writebook_in_progress)
+    golden_card = cards(:text)
+    golden_card.gild
+    assert golden_card.golden?
+
+    card = cards(:layout)
+    assert_not card.golden?
+    source_column = columns(:writebook_triage)
+
+    visit board_url(@board)
+    page.execute_script("localStorage.clear()")
+
+    expand_column(source_column)
+
+    card_element = find("##{dom_id(card, :article)}")
+    target_element = find("##{dom_id(target_column)}")
+
+    card_element.drag_to(target_element)
+
+    cards_in_target = all("##{dom_id(target_column)} .card", visible: :all).map { |el| el[:id] }
+    assert_equal dom_id(golden_card, :article), cards_in_target.first
+    assert_equal dom_id(card, :article), cards_in_target.second
+  end
+
+  test "moving a card into an empty column" do
+    empty_column = @board.columns.create!(name: "Testing QA", color: "var(--color-card-1)")
+    card = cards(:text)
+    source_column = columns(:writebook_in_progress)
+
+    visit board_url(@board)
+    page.execute_script("localStorage.clear()")
+
+    expand_column(source_column)
+
+    card_element = find("##{dom_id(card, :article)}")
+    target_element = find("##{dom_id(empty_column)}")
+
+    card_element.drag_to(target_element)
+
+    within("##{dom_id(empty_column)}") do
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+    end
+
+    assert_equal empty_column, card.reload.column
+  end
+
+  test "clicking a card navigates to it without being blocked by drag and drop" do
+    visit board_url(@board)
+    page.execute_script("localStorage.clear()")
+
+    card = cards(:logo)
+    source_column = columns(:writebook_triage)
+
+    expand_column(source_column)
+
+    click_on card.title
+
+    assert_current_path card_path(card)
+  end
+
+  test "moving a golden card to a column with an existing golden card places it at the top" do
+    target_column = columns(:writebook_in_progress)
+    existing_golden = cards(:text)
+    existing_golden.gild
+
+    moving_golden = cards(:logo)
+    assert moving_golden.golden?
+    source_column = columns(:writebook_triage)
+
+    visit board_url(@board)
+    page.execute_script("localStorage.clear()")
+
+    expand_column(source_column)
+
+    card_element = find("##{dom_id(moving_golden, :article)}")
+    target_element = find("##{dom_id(target_column)}")
+
+    card_element.drag_to(target_element)
+
+    cards_in_target = all("##{dom_id(target_column)} .card", visible: :all).map { |el| el[:id] }
+    assert_equal dom_id(moving_golden, :article), cards_in_target.first
+    assert_equal dom_id(existing_golden, :article), cards_in_target.second
+  end
+
+  test "rollback if server returns an error" do
+    visit board_url(@board)
+    page.execute_script("localStorage.clear()")
+
+    card = cards(:logo)
+    source_column = columns(:writebook_triage)
+    target_column = columns(:writebook_in_progress)
+
+    expand_column(source_column)
+
+    card_element = find("##{dom_id(card, :article)}")
+    target_element = find("##{dom_id(target_column)}")
+
+    source_count_before = find("##{dom_id(source_column)} .cards__expander-count", visible: :all).text(:all)
+
+    # Corrupt triage url so the request fails
+    page.execute_script("arguments[0].dataset.cardTriageUrl = '/cards/invalid/triage'", card_element)
+
+    card_element.drag_to(target_element)
+
+    # Card should rollback to source column
+    within("##{dom_id(source_column)}") do
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+    end
+
+    # Count restored
