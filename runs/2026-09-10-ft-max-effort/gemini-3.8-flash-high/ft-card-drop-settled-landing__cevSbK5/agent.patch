diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..b1a9a5e
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,251 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "column" ]
+
+  connect() {
+    this.draggedCard = null
+    this.sourceColumn = null
+    this.hoveredColumn = null
+    this.isDragging = false
+  }
+
+  dragstart(event) {
+    const card = event.target.closest(".card")
+    if (!card || !this.element.contains(card)) return
+
+    this.draggedCard = card
+    this.sourceColumn = card.closest(".cards")
+    this.isDragging = true
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id)
+    }
+
+    card.classList.add("drag-and-drop__dragged-item")
+  }
+
+  dragover(event) {
+    if (!this.draggedCard) return
+
+    const column = event.target.closest(".cards")
+    if (column && column !== this.sourceColumn && this.element.contains(column)) {
+      event.preventDefault()
+      if (event.dataTransfer) {
+        event.dataTransfer.dropEffect = "move"
+      }
+
+      if (this.hoveredColumn !== column) {
+        this.hoveredColumn?.classList.remove("drag-and-drop__hover-container")
+        this.hoveredColumn = column
+        this.hoveredColumn.classList.add("drag-and-drop__hover-container")
+      }
+    } else {
+      if (this.hoveredColumn) {
+        this.hoveredColumn.classList.remove("drag-and-drop__hover-container")
+        this.hoveredColumn = null
+      }
+    }
+  }
+
+  dragenter(event) {
+    if (!this.draggedCard) return
+
+    const column = event.target.closest(".cards")
+    if (column && column !== this.sourceColumn && this.element.contains(column)) {
+      event.preventDefault()
+      if (this.hoveredColumn !== column) {
+        this.hoveredColumn?.classList.remove("drag-and-drop__hover-container")
+        this.hoveredColumn = column
+        this.hoveredColumn.classList.add("drag-and-drop__hover-container")
+      }
+    }
+  }
+
+  dragleave(event) {
+    const column = event.target.closest(".cards")
+    if (column && (!event.relatedTarget || !column.contains(event.relatedTarget))) {
+      column.classList.remove("drag-and-drop__hover-container")
+      if (this.hoveredColumn === column) {
+        this.hoveredColumn = null
+      }
+    }
+  }
+
+  async drop(event) {
+    event.preventDefault()
+
+    const targetColumn = event.target.closest(".cards")
+    const card = this.draggedCard
+    const sourceColumn = this.sourceColumn
+
+    this.clearHoverHighlights()
+
+    if (!card || !targetColumn || targetColumn === sourceColumn || !this.element.contains(targetColumn)) {
+      return
+    }
+
+    card.classList.remove("drag-and-drop__dragged-item")
+
+    // Save previous position & state for rollback if server request fails
+    const originalParent = card.parentElement
+    const originalNextSibling = card.nextElementSibling
+    const originalClasses = Array.from(card.classList)
+
+    // Optimistically update DOM immediately
+    this.insertCardIntoColumn(card, targetColumn)
+    this.updateCardClasses(card, targetColumn)
+    this.updateCounts(sourceColumn, targetColumn)
+
+    // Persist changes to server
+    try {
+      const success = await this.persistCardMove(card, targetColumn)
+      if (!success) {
+        this.rollback(card, originalParent, originalNextSibling, originalClasses, sourceColumn, targetColumn)
+      }
+    } catch (error) {
+      console.error("Failed to move card:", error)
+      this.rollback(card, originalParent, originalNextSibling, originalClasses, sourceColumn, targetColumn)
+    }
+  }
+
+  dragend(event) {
+    if (this.draggedCard) {
+      this.draggedCard.classList.remove("drag-and-drop__dragged-item")
+    }
+    this.clearHoverHighlights()
+    this.draggedCard = null
+    this.sourceColumn = null
+
+    setTimeout(() => {
+      this.isDragging = false
+    }, 50)
+  }
+
+  preventClickDuringDrag(event) {
+    if (this.isDragging) {
+      event.preventDefault()
+      event.stopPropagation()
+    }
+  }
+
+  clearHoverHighlights() {
+    if (this.hoveredColumn) {
+      this.hoveredColumn.classList.remove("drag-and-drop__hover-container")
+      this.hoveredColumn = null
+    }
+    if (this.hasColumnTargets) {
+      this.columnTargets.forEach(el => {
+        el.classList.remove("drag-and-drop__hover-container")
+      })
+    } else {
+      this.element.querySelectorAll(".drag-and-drop__hover-container").forEach(el => {
+        el.classList.remove("drag-and-drop__hover-container")
+      })
+    }
+  }
+
+  insertCardIntoColumn(card, targetColumn) {
+    const list = targetColumn.querySelector(".cards__list") || targetColumn
+    const existingCards = Array.from(list.querySelectorAll(".card")).filter(c => c !== card)
+
+    const isGolden = card.classList.contains("golden-effect")
+    const isTargetStreamOrColumn = targetColumn.id === "maybe" || !!targetColumn.dataset.columnId
+
+    if (isTargetStreamOrColumn && !isGolden) {
+      const goldenCards = existingCards.filter(c => c.classList.contains("golden-effect"))
+      if (goldenCards.length > 0) {
+        goldenCards[goldenCards.length - 1].after(card)
+        return
+      }
+    }
+
+    if (existingCards.length > 0) {
+      existingCards[0].before(card)
+    } else {
+      list.prepend(card)
+    }
+  }
+
+  updateCardClasses(card, targetColumn) {
+    card.removeAttribute("aria-selected")
+    card.blur()
+
+    if (targetColumn.id === "not-now") {
+      card.classList.add("card--postponed")
+      card.classList.remove("card--active")
+    } else if (targetColumn.id === "closed-cards") {
+      card.classList.remove("card--postponed")
+      card.classList.remove("card--active")
+    } else {
+      card.classList.add("card--active")
+      card.classList.remove("card--postponed")
+    }
+
+    const badgeText = card.querySelector(".card__column-name--current .overflow-ellipsis")
+    if (targetColumn.dataset.columnId && targetColumn.dataset.columnName && badgeText) {
+      badgeText.textContent = targetColumn.dataset.columnName
+    } else if (targetColumn.id === "maybe" || targetColumn.id === "not-now" || targetColumn.id === "closed-cards") {
+      card.querySelector(".card__column-name--current")?.remove()
+    }
+  }
+
+  updateCounts(sourceColumn, targetColumn) {
+    this.adjustCount(sourceColumn, -1)
+    this.adjustCount(targetColumn, 1)
+  }
+
+  adjustCount(column, delta) {
+    const countElement = column.querySelector(".cards__expander-count")
+    if (countElement) {
+      const current = parseInt(countElement.textContent, 10)
+      if (!isNaN(current)) {
+        countElement.textContent = Math.max(0, current + delta)
+      }
+    }
+  }
+
+  async persistCardMove(card, targetColumn) {
+    const columnId = targetColumn.dataset.columnId
+
+    if (columnId) {
+      const url = card.dataset.cardTriageUrl
+      if (!url) return false
+      const response = await post(url, {
+        body: { column_id: columnId },
+        responseKind: "json"
+      })
+      return response.ok
+    } else if (targetColumn.id === "maybe") {
+      const url = card.dataset.cardTriageUrl
+      if (!url) return false
+      const response = await destroy(url, { responseKind: "json" })
+      return response.ok
+    } else if (targetColumn.id === "not-now") {
+      const url = card.dataset.cardNotNowUrl
+      if (!url) return false
+      const response = await post(url, { responseKind: "json" })
+      return response.ok
+    } else if (targetColumn.id === "closed-cards") {
+      const url = card.dataset.cardClosureUrl
+      if (!url) return false
+      const response = await post(url, { responseKind: "json" })
+      return response.ok
+    }
+
+    return false
+  }
+
+  rollback(card, originalParent, originalNextSibling, originalClasses, sourceColumn, targetColumn) {
+    if (originalNextSibling && originalParent.contains(originalNextSibling)) {
+      originalNextSibling.before(card)
+    } else {
+      originalParent.appendChild(card)
+    }
+    card.className = originalClasses.join(" ")
+    this.adjustCount(sourceColumn, 1)
+    this.adjustCount(targetColumn, -1)
+  }
+}
