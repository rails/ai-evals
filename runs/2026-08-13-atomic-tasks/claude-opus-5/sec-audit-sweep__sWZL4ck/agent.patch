diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..c93e657
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "show finds matching pages in readable books" do
+    get library_search_path(q: "Welcome")
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+  end
+
+  test "show without a query lists nothing" do
+    get library_search_path
+
+    assert_response :success
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "show only returns results from books the searcher can read" do
+    books(:manual).press Page.new(body: "Secret"), title: "Welcome to The Manual!"
+
+    get library_search_path(q: "Welcome")
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+    assert_not_in_body "Welcome to The Manual!"
+  end
+
+  test "show returns published books when signed out" do
+    books(:manual).press Page.new(body: "Public"), title: "Welcome to The Manual!"
+    books(:manual).update! published: true
+    sign_out
+
+    get library_search_path(q: "Welcome")
+
+    assert_response :success
+    assert_in_body "Welcome to The Manual!"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "show does not leak books via SQL injection in the query" do
+    get library_search_path(q: "%' or 1=1 --")
+
+    assert_response :success
+    assert_not_in_body "Manual"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "show treats punctuation as data rather than raising" do
+    [ "it's", "\"quoted\"", "100%", "a\\b", ";drop table books;--", "_" ].each do |query|
+      get library_search_path(q: query)
+
+      assert_response :success, "searching #{query.inspect} did not succeed"
+    end
+  end
+
+  test "show treats a per cent sign as a literal character, not a wildcard" do
+    books(:handbook).press Page.new(body: "Discount"), title: "Save 50% off"
+
+    get library_search_path(q: "Save 50% off")
+    assert_response :success
+    assert_in_body "Save 50% off"
+
+    get library_search_path(q: "%")
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "show treats an underscore as a literal character, not a wildcard" do
+    books(:handbook).press Page.new(body: "Naming"), title: "snake_case names"
+
+    get library_search_path(q: "_")
+
+    assert_response :success
+    assert_in_body "snake_case names"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+end
