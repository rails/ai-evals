-        { title: title, published: published },
-        expires_in: Rails.application.config.x.recap.expires_in
+      if recap = recap_of_record
+        Rails.cache.write recap_cache_key, recap,
+          expires_in: Rails.application.config.x.recap.expires_in
+      end
+    end
+
+    # Read the committed values so a stale instance can never cache outdated data.
+    def recap_of_record
+      title, published = self.class.where(id: id).pick(:title, :published)
+      { title: title, published: published } unless title.nil? && published.nil?
     end
 end
