diff --git a/test/controllers/books/reports_controller_test.rb b/test/controllers/books/reports_controller_test.rb
new file mode 100644
index 0000000..75743eb
--- /dev/null
+++ b/test/controllers/books/reports_controller_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class Books::ReportsControllerTest < ActionDispatch::IntegrationTest
+  setup { sign_in :david }
+
+  test "show" do
+    books(:handbook).update! updated_at: Time.utc(2024, 3, 5, 14, 23, 45)
+
+    get book_report_path(books(:handbook))
+
+    assert_response :success
+    assert_in_body "Last updated March 05, 2024"
+  end
+
+  test "show reports the summary with a delimited character count" do
+    get book_report_path(books(:handbook))
+
+    assert_response :success
+    assert_in_body "#{books(:handbook).markable.length} characters"
+  end
+
+  test "show as text sends the card with a timestamped filename" do
+    books(:handbook).update! updated_at: Time.utc(2024, 3, 5, 14, 23, 45)
+
+    get book_report_path(books(:handbook), format: :text)
+
+    assert_response :success
+    assert_equal "text/plain", response.media_type
+    assert_includes response.headers["Content-Disposition"], "shelf-report-20240305142345.txt"
+  end
+end
