+      Turbo::StreamsChannel.signed_stream_name([ leaves(:welcome_page).being_edited_stream_for(user) ])
+    end
+
+    def assert_being_edited_broadcasts(count, to:)
+      stream = leaves(:welcome_page).being_edited_stream_for(to)
+
+      if count.zero?
+        assert_no_turbo_stream_broadcasts stream
+      else
+        assert_turbo_stream_broadcasts stream, count: count
+      end
+    end
+
     def sample_page_leaf(markdown)
