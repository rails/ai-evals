diff --git a/test/test_helpers/cache_test_helper.rb b/test/test_helpers/cache_test_helper.rb
new file mode 100644
index 0000000..9b4b0d6
--- /dev/null
+++ b/test/test_helpers/cache_test_helper.rb
@@ -0,0 +1,13 @@
+module CacheTestHelper
+  def with_memory_cache
+    previous_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    yield Rails.cache
+  ensure
+    Rails.cache = previous_cache
+  end
+
+  def cache_entry_for(key)
+    Rails.cache.send :read_entry, Rails.cache.send(:normalize_key, key, {}), **{}
+  end
+end
