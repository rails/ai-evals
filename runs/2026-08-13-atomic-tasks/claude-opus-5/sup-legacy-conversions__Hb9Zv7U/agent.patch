+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly lists published books with a short edited date" do
+    books(:handbook).update! published: true
+
+    mail = ReportDigestMailer.weekly(users(:david))
+
+    assert_includes mail.body.to_s,
+      "* Handbook, last edited #{books(:handbook).updated_at.to_date.to_fs(:short)}"
+  end
+end
diff --git a/test/models/book/reportable_test.rb b/test/models/book/reportable_test.rb
new file mode 100644
index 0000000..4ace574
--- /dev/null
+++ b/test/models/book/reportable_test.rb
@@ -0,0 +1,17 @@
+require "test_helper"
+
+class Book::ReportableTest < ActiveSupport::TestCase
+  test "report_summary delimits the character count" do
+    book = books(:handbook)
+
+    assert_equal "#{book.title} — #{book.markable.length.to_fs(:delimited)} characters",
+      book.report_summary
+  end
+
+  test "report_summary delimits thousands with commas" do
+    book = books(:manual)
+    book.press Page.new(body: "a" * 12345), title: "Long page"
+
+    assert_equal "Manual — 12,345 characters", book.report_summary
+  end
+end
