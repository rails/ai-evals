+require "test_helper"
+
+class Book::ReportableTest < ActiveSupport::TestCase
+  test "report_summary delimits the character count" do
+    book = books(:handbook)
+
+    assert_equal "#{book.title} — #{book.markable.length.to_fs(:delimited)} characters",
+      book.report_summary
+  end
+
+  test "report_summary delimits large character counts with commas" do
+    book = books(:handbook)
+    def book.markable = "x" * 1234567
+
+    assert_equal "Handbook — 1,234,567 characters", book.report_summary
+  end
+end
