-    helper_method :signed_in?
+    helper_method :signed_in?, :requested_return_to_url
 
     protect_from_forgery with: :exception, unless: -> { authenticated_by.bot_key? }
   end
@@ -68,7 +68,14 @@ module Authentication
     end
 
     def post_authenticating_url
-      session.delete(:return_to_after_authenticating) || root_url
+      requested_return_to_url || session.delete(:return_to_after_authenticating) || root_url
+    end
+
+    # Never follow a return_to that points off this host: it would let anyone hand out
+    # a sign-in link that drops the reader on someone elses copy of our sign-in page.
+    def requested_return_to_url
+      return_to = params[:return_to]
+      url_from(return_to) if return_to.is_a?(String)
     end
 
     def set_authentication_cookie(session)
