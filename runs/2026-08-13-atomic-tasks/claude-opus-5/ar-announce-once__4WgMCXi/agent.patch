diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..3d6fc5a 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,32 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_save :record_publication, if: :published_by_this_save?
+    after_commit :announce_publication, if: :publication_recorded?
+    after_rollback :forget_publication
   end
 
   private
+    # Recorded while still inside the transaction: later writes in the same
+    # transaction (a touch from a new leaf, say) wipe out +saved_changes+.
+    def published_by_this_save?
+      published? && saved_change_to_published?
+    end
+
+    def record_publication
+      @publication_recorded = true
+    end
+
+    def publication_recorded?
+      @publication_recorded.present?
+    end
+
+    def forget_publication
+      @publication_recorded = false
+    end
+
     def announce_publication
-      AnnouncePublicationJob.perform_later self
+      forget_publication
+      AnnouncePublicationJob.perform_later self if published?
     end
 end
