diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..52efd89 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -4,6 +4,8 @@ require "rails/test_help"
 
 module ActiveSupport
   class TestCase
+    SHOW_EXCEPTIONS_KEY = "action_dispatch.show_exceptions" # :nodoc:
+
     # Run tests in parallel with specified workers
     parallelize(workers: :number_of_processors)
 
@@ -12,12 +14,30 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Inside the block, a controller error reaches the test as the raised exception.
+    # Outside of it, error pages render as usual — no matter what ran before or
+    # after in the same process.
+    #
+    # Rails snapshots config.action_dispatch.show_exceptions into the memoized
+    # Rails.application.env_config the first time a request env is built. So
+    # toggling the config here would either be a no-op (when a request already
+    # ran in this process) or would leak :none into every later request (when
+    # this ran first) — which is exactly how the parallel suite went flaky.
+    # Overriding the rack env entry that gets merged into every test request is
+    # what actually takes effect, and it is reliably reversible.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      env_config = Rails.application.env_config
+      had_key = env_config.key?(SHOW_EXCEPTIONS_KEY)
+      previous = env_config[SHOW_EXCEPTIONS_KEY]
+      env_config[SHOW_EXCEPTIONS_KEY] = :none
+
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      if had_key
+        env_config[SHOW_EXCEPTIONS_KEY] = previous
+      else
+        env_config.delete(SHOW_EXCEPTIONS_KEY)
+      end
     end
   end
 end
