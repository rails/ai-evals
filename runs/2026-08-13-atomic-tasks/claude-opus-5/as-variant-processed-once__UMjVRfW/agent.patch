diff --git a/lib/rails_ext/active_storage_stable_variation_digest.rb b/lib/rails_ext/active_storage_stable_variation_digest.rb
new file mode 100644
index 0000000..7525a55
--- /dev/null
+++ b/lib/rails_ext/active_storage_stable_variation_digest.rb
@@ -0,0 +1,27 @@
+# Variants are identified in the database by ActiveStorage::Variation#digest, which
+# marshals the transformations hash. But a variation makes a round-trip through the
+# signed, JSON-encoded variation key embedded in representation URLs, and JSON has no
+# symbols: `format: :webp` comes back as `format: "webp"`.
+#
+# That means a variant derived up-front (by the CreateVariants/Transform jobs, straight
+# from the named variant's transformations) got a different digest than the same variant
+# looked up when serving a representation URL. The lookup missed, so the first reader to
+# open the page derived the image a second time and stored a duplicate copy forever.
+#
+# Normalizing the transformations the same way the variation key does makes both paths
+# agree on one digest, so an upload is derived once and kept once. The transformations
+# themselves are untouched, so the processed image is byte-for-byte the same.
+module ActiveStorage::StableVariationDigest
+  def digest
+    OpenSSL::Digest::SHA1.base64digest Marshal.dump(normalized_transformations)
+  end
+
+  private
+    def normalized_transformations
+      JSON.parse(transformations.to_json).deep_symbolize_keys
+    end
+end
+
+ActiveSupport.on_load :active_storage_blob do
+  ActiveStorage::Variation.prepend ActiveStorage::StableVariationDigest
+end
diff --git a/test/integration/picture_variants_test.rb b/test/integration/picture_variants_test.rb
new file mode 100644
index 0000000..978f071
--- /dev/null
+++ b/test/integration/picture_variants_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class PictureVariantsTest < ActionDispatch::IntegrationTest
+  setup do
+    @leaf = leaves(:reading_picture)
+    @picture = @leaf.picture
+
+    perform_enqueued_jobs do
+      @picture.image.attach io: file_fixture("white-rabbit.webp").open,
+        filename: "white-rabbit.webp", content_type: "image/webp"
+    end
+
+    @blob = @picture.reload.image.blob
+
+    sign_in :kevin
+  end
+
+  test "the background job derives the picture once" do
+    assert_equal 1, derived_copies
+  end
+
+  test "reading a picture page after the background job does no image processing" do
+    assert_no_image_processing do
+      get leafable_slug_path(@leaf)
+      assert_response :success
+
+      get representation_path_from_response
+      assert_response :redirect
+    end
+  end
+
+  test "exactly one derived copy is kept, no matter how many readers open the book" do
+    3.times do
+      get leafable_slug_path(@leaf)
+      get representation_path_from_response
+    end
+
+    assert_equal 1, derived_copies
+  end
+
+  test "readers are served the derived picture the background job stored" do
+    expected = @picture.large_image.download
+
+    get leafable_slug_path(@leaf)
+    get representation_path_from_response
+    follow_redirect!
+
+    assert_response :success
+    assert_equal expected, response.body
+  end
+
+  private
+    def derived_copies
+      @blob.variant_records.reload.count
+    end
+
+    def representation_path_from_response
+      CGI.unescapeHTML response.body[%r{/rails/active_storage/representations[^"]+}]
+    end
+
+    def assert_no_image_processing
+      processed = 0
+      subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { processed += 1 }
+
+      yield
+
+      assert_equal 0, processed, "expected no image processing, but #{processed} image(s) were processed"
+    ensure
+      ActiveSupport::Notifications.unsubscribe subscriber
+    end
+end
diff --git a/test/models/picture_test.rb b/test/models/picture_test.rb
index 18a2a56..5f7fc9a 100644
--- a/test/models/picture_test.rb
+++ b/test/models/picture_test.rb
@@ -23,4 +23,25 @@ class PictureTest < ActiveSupport::TestCase
 
     assert_equal picture.image, picture.large_image
   end
+
+  test "the large variant has one digest, whether it is derived up front or looked up from a representation URL" do
+    variation = ActiveStorage::Variation.wrap(large_variant_transformations)
+
+    assert_equal variation.digest, ActiveStorage::Variation.decode(variation.key).digest
+  end
+
+  test "variation digests ignore whether transformations are spelled with symbols or strings" do
+    assert_equal ActiveStorage::Variation.new(resize_to_limit: [ 1500, 1500 ], format: :webp).digest,
+      ActiveStorage::Variation.new("resize_to_limit" => [ 1500, 1500 ], "format" => "webp").digest
+  end
+
+  test "variation digests still differ for different transformations" do
+    assert_not_equal ActiveStorage::Variation.new(resize_to_limit: [ 1500, 1500 ], format: :webp).digest,
+      ActiveStorage::Variation.new(resize_to_limit: [ 500, 500 ], format: :webp).digest
+  end
+
+  private
+    def large_variant_transformations
+      Picture.reflect_on_attachment(:image).named_variants[:large].transformations
+    end
 end
