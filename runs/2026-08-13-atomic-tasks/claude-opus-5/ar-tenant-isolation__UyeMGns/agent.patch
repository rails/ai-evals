@@ -0,0 +1,50 @@
+class AddTenants < ActiveRecord::Migration[8.0]
+  class MigrationTenant < ActiveRecord::Base
+    self.table_name = "tenants"
+  end
+
+  class MigrationUser < ActiveRecord::Base
+    self.table_name = "users"
+  end
+
+  class MigrationBook < ActiveRecord::Base
+    self.table_name = "books"
+  end
+
+  class MigrationAccount < ActiveRecord::Base
+    self.table_name = "accounts"
+  end
+
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, null: true, index: true, foreign_key: true
+    add_reference :books, :tenant, null: true, index: true, foreign_key: true
+
+    sweep_existing_records_into_one_tenant
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+
+    drop_table :tenants
+  end
+
+  private
+    def sweep_existing_records_into_one_tenant
+      return if MigrationUser.none? && MigrationBook.none?
+
+      tenant = MigrationTenant.create!(name: existing_tenant_name)
+
+      MigrationUser.update_all tenant_id: tenant.id
+      MigrationBook.update_all tenant_id: tenant.id
+    end
+
+    def existing_tenant_name
+      MigrationAccount.first&.name.presence || "Writebook"
+    end
+end
