diff --git a/app/models/concerns/tenanted.rb b/app/models/concerns/tenanted.rb
new file mode 100644
index 0000000..f2e6db0
--- /dev/null
+++ b/app/models/concerns/tenanted.rb
@@ -0,0 +1,15 @@
+# Records that belong to a tenant. Rows without a tenant (nil) form their own
+# implicit tenant, so installs that predate tenanting keep working as before.
+module Tenanted
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+
+    scope :in_tenant, ->(tenant) { where(tenant_id: Tenant.id_for(tenant)) }
+  end
+
+  def same_tenant_as?(record)
+    record.present? && tenant_id == record.tenant_id
+  end
+end
