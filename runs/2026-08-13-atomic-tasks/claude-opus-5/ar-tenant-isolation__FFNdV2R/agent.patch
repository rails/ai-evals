@@ -0,0 +1,14 @@
+module User::Tenanted
+  extend ActiveSupport::Concern
+  include ::Tenanted
+
+  # Books and leaves reachable by this user, always narrowed to their own
+  # tenant so a stray access row can never reach across tenants.
+  def tenant_books
+    books.in_tenant(tenant_id)
+  end
+
+  def tenant_leaves
+    Leaf.where(book: tenant_books)
+  end
+end
diff --git a/db/migrate/20241001000000_add_tenants.rb b/db/migrate/20241001000000_add_tenants.rb
new file mode 100644
index 0000000..bffbe7d
--- /dev/null
+++ b/db/migrate/20241001000000_add_tenants.rb
@@ -0,0 +1,56 @@
+class AddTenants < ActiveRecord::Migration[8.0]
+  DEFAULT_TENANT_NAME = "Writebook"
+
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    sweep_existing_records_into_one_tenant
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+
+    drop_table :tenants
+  end
+
+  private
+    def sweep_existing_records_into_one_tenant
+      return unless existing_records?
+
+      tenant_id = create_tenant
+
+      execute "UPDATE users SET tenant_id = #{tenant_id} WHERE tenant_id IS NULL"
+      execute "UPDATE books SET tenant_id = #{tenant_id} WHERE tenant_id IS NULL"
+    end
+
+    def existing_records?
+      count_of("users") > 0 || count_of("books") > 0
+    end
+
+    def create_tenant
+      now = quote(Time.current)
+
+      execute "INSERT INTO tenants (name, created_at, updated_at) VALUES (#{quote(tenant_name)}, #{now}, #{now})"
+      select_value("SELECT MAX(id) FROM tenants").to_i
+    end
+
+    def tenant_name
+      select_value("SELECT name FROM accounts ORDER BY id LIMIT 1").presence || DEFAULT_TENANT_NAME
+    end
+
+    def count_of(table)
+      select_value("SELECT COUNT(*) FROM #{table}").to_i
+    end
+
+    def quote(value)
+      connection.quote(value)
+    end
+end
