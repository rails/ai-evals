+require "test_helper"
+
+class TenantTest < ActiveSupport::TestCase
+  setup do
+    @customer_a = Tenant.create!(name: "Customer A")
+    @customer_b = Tenant.create!(name: "Customer B")
+  end
+
+  test "name is required" do
+    assert_not Tenant.new.valid?
+  end
+
+  test "in_tenant accepts a tenant or an id" do
+    users(:kevin).update! tenant: @customer_a
+
+    assert_equal [ users(:kevin) ], User.in_tenant(@customer_a).to_a
+    assert_equal [ users(:kevin) ], User.in_tenant(@customer_a.id).to_a
+  end
+
+  test "records without a tenant form their own implicit tenant" do
+    assert_nil users(:kevin).tenant_id
+    assert_nil books(:handbook).tenant_id
+
+    assert books(:handbook).accessable?(user: users(:jz))
+    assert books(:handbook).editable?(user: users(:kevin))
+    assert_includes Book.accessable_or_published(user: users(:kevin)), books(:handbook)
+  end
+
+  test "a book is not accessable or editable across tenants" do
+    users(:kevin).update! tenant: @customer_a
+    books(:handbook).update! tenant: @customer_b
+
+    assert Access.exists?(user: users(:kevin), book: books(:handbook))
+
+    assert_not books(:handbook).accessable?(user: users(:kevin))
+    assert_not books(:handbook).editable?(user: users(:kevin))
+  end
+
+  test "administrators do not get edit rights across tenants" do
+    users(:david).update! tenant: @customer_a
+    books(:handbook).update! tenant: @customer_b
+
+    assert users(:david).administrator?
+    assert_not books(:handbook).editable?(user: users(:david))
+  end
+
+  test "accessable_or_published only returns books from the user's tenant" do
+    users(:kevin).update! tenant: @customer_a
+    books(:handbook).update! tenant: @customer_a
+    books(:manual).update! tenant: @customer_b, published: true
+
+    assert_equal [ books(:handbook) ], Book.accessable_or_published(user: users(:kevin)).to_a
+  end
+
+  test "signed out visitors see published books from every tenant" do
+    books(:handbook).update! tenant: @customer_a, published: true
+    books(:manual).update! tenant: @customer_b, published: true
+
+    assert_equal [ books(:handbook), books(:manual) ].sort_by(&:id),
+      Book.accessable_or_published(user: nil).order(:id).to_a
+  end
+
+  test "a new book is created in its creator's tenant" do
+    users(:kevin).update! tenant: @customer_a
+    Current.user = users(:kevin)
+
+    assert_equal @customer_a, Book.create!(title: "Fresh Book").tenant
+  ensure
+    Current.reset
+  end
+
+  test "an explicit tenant wins over the creator's" do
+    users(:kevin).update! tenant: @customer_a
+    Current.user = users(:kevin)
+
+    assert_equal @customer_b, Book.create!(title: "Fresh Book", tenant: @customer_b).tenant
+  ensure
+    Current.reset
+  end
+
+  test "update_access ignores people from other tenants" do
+    users(:kevin).update! tenant: @customer_a
+    users(:jz).update! tenant: @customer_b
+    books(:handbook).update! tenant: @customer_a, everyone_access: false
+
+    books(:handbook).update_access editors: [ users(:kevin).id ], readers: [ users(:jz).id ]
+
+    assert_equal [ users(:kevin).id ], books(:handbook).accesses.pluck(:user_id)
+  end
+
+  test "everyone access only sprays readers within the tenant" do
+    users(:kevin).update! tenant: @customer_a
+    users(:jz).update! tenant: @customer_b
+    books(:handbook).update! tenant: @customer_a, everyone_access: true
+
+    books(:handbook).update_access editors: [ users(:kevin).id ], readers: []
+
+    assert_equal [ users(:kevin).id ], books(:handbook).accesses.pluck(:user_id)
+  end
+
+  test "tenant_books and tenant_leaves stay inside the tenant" do
+    users(:kevin).update! tenant: @customer_a
+    books(:handbook).update! tenant: @customer_a
+    books(:manual).update! tenant: @customer_b
+
+    assert_equal [ books(:handbook) ], users(:kevin).tenant_books.to_a
+    assert_equal books(:handbook).leaves.sort_by(&:id), users(:kevin).tenant_leaves.order(:id).to_a
+  end
+
+  test "a new user is only granted everyone books from their own tenant" do
+    books(:handbook).update! tenant: @customer_a, everyone_access: true
+    books(:manual).update! tenant: @customer_b, everyone_access: true
+
+    user = User.create! name: "Fresh", email_address: "fresh@example.com",
+      password: "secret123456", tenant: @customer_a
+
+    assert_equal [ books(:handbook).id ], user.accesses.pluck(:book_id)
+  end
+end
