diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..5bc18ce
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "Roster book", everyone_access: false)
+  end
+
+  test "imports every grant and notifies each person" do
+    result = nil
+
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob do
+      result = import(grant(users(:kevin), :editor), grant(users(:jz), :reader))
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal [ users(:kevin).id, users(:jz).id ], result.accesses.map(&:user_id)
+    assert_equal %w[ editor reader ], result.accesses.map(&:level)
+    assert result.accesses.all?(&:persisted?)
+  end
+
+  test "imports a big roster in the same number of queries as a small one" do
+    small = Book.create!(title: "Small", everyone_access: false)
+    large = Book.create!(title: "Large", everyone_access: false)
+    few, many = roster(4), roster(16)
+
+    baseline = count_queries { Book::AccessImport.new(small, few).import }
+    assert_queries_count baseline do
+      Book::AccessImport.new(large, many).import
+    end
+  end
+
+  test "rejects a roster in the same number of queries regardless of its size" do
+    duplicate = grant(users(:kevin), :reader)
+    @book.accesses.create!(duplicate)
+    few, many = roster(4) + [ duplicate ], roster(16) + [ duplicate ]
+
+    baseline = count_queries { Book::AccessImport.new(@book, few).import }
+    assert_queries_count baseline do
+      Book::AccessImport.new(@book, many).import
+    end
+  end
+
+  test "rejects a duplicate grant without importing or notifying anyone" do
+    @book.accesses.create!(grant(users(:kevin), :reader))
+    result = nil
+
+    assert_no_difference -> { Access.count } do
+      assert_no_enqueued_jobs do
+        result = import(grant(users(:jz), :reader), grant(users(:kevin), :editor))
+      end
+    end
+
+    assert_empty result.accesses
+    assert_equal 1, result.duplicate_index
+  end
+
+  test "rejects a grant duplicated within the roster" do
+    result = nil
+
+    assert_no_difference -> { Access.count } do
+      assert_no_enqueued_jobs do
+        result = import(grant(users(:jz), :reader), grant(users(:jz), :editor))
+      end
+    end
+
+    assert_empty result.accesses
+    assert_equal 1, result.duplicate_index
+  end
+
+  test "rejects an unknown level like any other bad row" do
+    result = nil
+
+    assert_no_difference -> { Access.count } do
+      assert_no_enqueued_jobs do
+        result = import(grant(users(:jz), :reader), grant(users(:kevin), :wizard))
+      end
+    end
+
+    assert_empty result.accesses
+    assert_equal 1, result.duplicate_index
+  end
+
+  test "imports nothing when there's nothing to import" do
+    result = import
+
+    assert_empty result.accesses
+    assert_nil result.duplicate_index
+  end
+
+  private
+    def import(*grants)
+      Book::AccessImport.new(@book, grants).import
+    end
+
+    def grant(user, level)
+      { user_id: user.id, level: level.to_s }
+    end
+
+    def roster(size)
+      size.times.map do |index|
+        token = SecureRandom.hex(6)
+        grant User.create!(name: "User #{token}", email_address: "user-#{token}@example.com",
+          password: "secret123456", role: "member"), :reader
+      end
+    end
+
+    def count_queries(&block)
+      queries = 0
+      counter = ->(*, payload) { queries += 1 unless payload[:name] == "SCHEMA" || payload[:cached] }
+      ActiveSupport::Notifications.subscribed(counter, "sql.active_record", &block)
+      queries
+    end
+end
