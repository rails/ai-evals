+++ b/test/models/job_checkpoint_test.rb
@@ -0,0 +1,16 @@
+require "test_helper"
+
+class JobCheckpointTest < ActiveSupport::TestCase
+  test "for starts at zero and is reused across lookups" do
+    checkpoint = JobCheckpoint.for("title_cleanup")
+
+    assert_equal 0, checkpoint.cursor
+    assert_equal checkpoint, JobCheckpoint.for("title_cleanup")
+  end
+
+  test "advance_to records progress durably" do
+    JobCheckpoint.for("title_cleanup").advance_to(42)
+
+    assert_equal 42, JobCheckpoint.for("title_cleanup").cursor
+  end
+end
