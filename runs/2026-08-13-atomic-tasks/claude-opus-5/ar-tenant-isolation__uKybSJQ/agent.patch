diff --git a/db/migrate/20241015000000_create_tenants.rb b/db/migrate/20241015000000_create_tenants.rb
new file mode 100644
index 0000000..ed6d8e3
--- /dev/null
+++ b/db/migrate/20241015000000_create_tenants.rb
@@ -0,0 +1,49 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  DEFAULT_TENANT_NAME = "Writebook"
+
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    sweep_existing_records_into_a_single_tenant
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+
+    drop_table :tenants
+  end
+
+  private
+    def sweep_existing_records_into_a_single_tenant
+      return unless existing_users_or_books?
+
+      tenant_id = create_tenant
+
+      execute "UPDATE users SET tenant_id = #{tenant_id} WHERE tenant_id IS NULL"
+      execute "UPDATE books SET tenant_id = #{tenant_id} WHERE tenant_id IS NULL"
+    end
+
+    def existing_users_or_books?
+      select_value("SELECT COUNT(*) FROM users").to_i.positive? ||
+        select_value("SELECT COUNT(*) FROM books").to_i.positive?
+    end
+
+    def create_tenant
+      now = quote(Time.current)
+      execute "INSERT INTO tenants (name, created_at, updated_at) VALUES (#{quote(tenant_name)}, #{now}, #{now})"
+
+      select_value("SELECT id FROM tenants ORDER BY id LIMIT 1")
+    end
+
+    def tenant_name
+      select_value("SELECT name FROM accounts ORDER BY id LIMIT 1").presence || DEFAULT_TENANT_NAME
+    end
+end
