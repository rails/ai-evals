diff --git a/config/initializers/runner_logging.rb b/config/initializers/runner_logging.rb
new file mode 100644
index 0000000..7cd3999
--- /dev/null
+++ b/config/initializers/runner_logging.rb
@@ -0,0 +1,17 @@
+# The runner is how the runbook drives one-off scripts (`bin/rails runner ...`), and
+# those scripts report through Rails.logger. Outside of production the logger only
+# writes to the environment's log file, so a runner script looks like it did nothing
+# at all on the terminal.
+#
+# Mirror the log to the terminal for the duration of the runner, the same way
+# `rails server` does in development: STDOUT gets added to the broadcast, so every
+# line is still written to the log file for our log tooling to pick up.
+Rails.application.runner do
+  unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT, STDERR)
+    console = ActiveSupport::Logger.new(STDOUT)
+    console.formatter = Rails.logger.formatter
+    console.level = Rails.logger.level
+
+    Rails.logger.broadcast_to console
+  end
+end
diff --git a/test/lib/runner_logging_test.rb b/test/lib/runner_logging_test.rb
new file mode 100644
index 0000000..1b3450e
--- /dev/null
+++ b/test/lib/runner_logging_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class RunnerLoggingTest < ActiveSupport::TestCase
+  test "runner scripts log to stdout as well as to the environment's log file" do
+    log_file = Rails.root.join("log/#{Rails.env}.log")
+    offset = File.exist?(log_file) ? File.size(log_file) : 0
+
+    message = "Runner logging test #{SecureRandom.hex(4)}"
+    output = run_runner %(Rails.logger.info "#{message}")
+
+    assert_includes output, message
+    assert_includes appended_log(log_file, offset), message
+  end
+
+  private
+    def run_runner(code)
+      out = IO.popen([ { "RAILS_ENV" => Rails.env }, Rails.root.join("bin/rails").to_s, "runner", code ], err: :err, &:read)
+      assert_predicate $?, :success?, "bin/rails runner failed: #{out}"
+      out
+    end
+
+    def appended_log(log_file, offset)
+      File.open(log_file) { |file| file.seek(offset); file.read }
+    end
+end
