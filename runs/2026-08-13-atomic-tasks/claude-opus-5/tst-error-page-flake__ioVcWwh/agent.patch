diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..c157055 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,22 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    SHOW_EXCEPTIONS_KEY = "action_dispatch.show_exceptions"
+
+    # Makes controller errors reach the test as raised exceptions inside the block,
+    # while error pages keep rendering normally outside of it.
+    #
+    # `Rails.application.env_config` is memoized the first time a request is made,
+    # so assigning `config.action_dispatch.show_exceptions` here would only take
+    # effect if no request had been made yet in this process. Write the Rack env
+    # that requests actually read instead, and restore it afterwards.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      env_config = Rails.application.env_config
+      previous = env_config[SHOW_EXCEPTIONS_KEY]
+      env_config[SHOW_EXCEPTIONS_KEY] = :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env_config[SHOW_EXCEPTIONS_KEY] = previous
     end
   end
 end
