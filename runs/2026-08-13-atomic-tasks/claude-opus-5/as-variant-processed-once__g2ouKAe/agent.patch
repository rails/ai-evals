diff --git a/lib/rails_ext/active_storage_variation_digest.rb b/lib/rails_ext/active_storage_variation_digest.rb
new file mode 100644
index 0000000..ff30300
--- /dev/null
+++ b/lib/rails_ext/active_storage_variation_digest.rb
@@ -0,0 +1,30 @@
+# Active Storage identifies a tracked variant by digesting the variation's
+# transformations with Marshal, which is sensitive to the difference between
+# symbols and strings.
+#
+# Transformations reach us two ways: straight from the named variant declared on
+# the model (`format: :webp`), and decoded from the signed variation key in the
+# image URL. That key is serialized as JSON, so symbols come back as strings
+# (`format: "webp"`). Both describe the same image, but they used to digest
+# differently, so the preprocessing job and the first request for the picture
+# each stored their own copy of it.
+#
+# Digest a JSON-normalized copy of the transformations instead, so both paths
+# resolve to the same variant record. The transformations themselves are left
+# untouched, so the processed image is byte for byte what it was before, and the
+# digest matches the one the URL-decoded path has always produced, so variants
+# already in storage stay in use.
+module ActiveStorage::NormalizedVariationDigest
+  def digest
+    @digest ||= OpenSSL::Digest::SHA1.base64digest Marshal.dump(normalized_transformations)
+  end
+
+  private
+    def normalized_transformations
+      ActiveSupport::JSON.decode(ActiveSupport::JSON.encode(transformations)).deep_symbolize_keys
+    end
+end
+
+ActiveSupport.on_load :active_storage_blob do
+  ActiveStorage::Variation.prepend ActiveStorage::NormalizedVariationDigest
+end
diff --git a/test/integration/picture_variant_processing_test.rb b/test/integration/picture_variant_processing_test.rb
new file mode 100644
index 0000000..49198fe
--- /dev/null
+++ b/test/integration/picture_variant_processing_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class PictureVariantProcessingTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+
+    @leaf = leaves(:reading_picture)
+    @picture = @leaf.leafable
+    @picture.image.attach io: file_fixture("white-rabbit.webp").open,
+      filename: "white-rabbit.webp", content_type: "image/webp"
+    @blob = @picture.image.blob
+
+    perform_background_work
+  end
+
+  test "background work derives the picture exactly once" do
+    assert_equal 1, @blob.variant_records.reload.count
+  end
+
+  test "reading the book page and fetching its picture does no image processing" do
+    assert_no_image_processing do
+      get leafable_slug_path(@leaf)
+      assert_response :success
+
+      fetch_picture
+      assert_response :success
+    end
+  end
+
+  test "only one derived copy is kept in storage" do
+    get leafable_slug_path(@leaf)
+    fetch_picture
+
+    assert_equal 1, @blob.variant_records.reload.count
+  end
+
+  test "the reader is served the same picture the background work derived" do
+    derived = @picture.large_image.download
+
+    get leafable_slug_path(@leaf)
+    fetch_picture
+
+    assert_response :success
+    assert_equal derived, response.body
+  end
+
+  private
+    # CreateVariantsJob enqueues a TransformJob, so drain the queue the way a
+    # real worker does before looking at what ended up in storage.
+    def perform_background_work
+      perform_enqueued_jobs while enqueued_jobs.any?
+    end
+
+    # The picture the page links to is served through a redirect to the
+    # storage service, so follow it to get at the bytes a reader receives.
+    def fetch_picture
+      get css_select("figure img").first["src"]
+      follow_redirect! while response.redirect?
+    end
+
+    def assert_no_image_processing
+      transforms = 0
+      subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { transforms += 1 }
+      yield
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+      assert_equal 0, transforms, "Expected no image processing, but #{transforms} happened"
+    end
+end
