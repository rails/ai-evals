diff --git a/test/integration/user_erasure_test.rb b/test/integration/user_erasure_test.rb
new file mode 100644
index 0000000..8c82b37
--- /dev/null
+++ b/test/integration/user_erasure_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class UserErasureTest < ActionDispatch::IntegrationTest
+  # Most erasure requests we owe are for people someone already "removed" the old
+  # way: deactivated, with their email address rewritten.
+  test "erasing someone who was already removed the old way leaves nothing behind" do
+    Leaf.reindex_all
+    alice = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    Current.user = alice
+    private_book = Book.create!(title: "Alice Diary", creator: alice, everyone_access: false)
+    private_book.press Section.new(body: "alicesecretstuff"), title: "Diary"
+    shared = Book.create!(title: "Alice Guide", author: "Alice Smith", creator: alice, everyone_access: true)
+    shared.press Section.new(body: "aliceguidecontent"), title: "Guide"
+    (shared.leaves + private_book.leaves).each(&:reindex)
+    shared.update_access(editors: [ alice.id ], readers: User.active.ids)
+    alice.sessions.create!(user_agent: "F", ip_address: "9.9.9.9")
+    ReadingMark.remember leaves(:welcome_page), user: alice
+    Current.user = nil
+
+    # someone "removed" her the old way
+    alice.deactivate
+    assert_match(/alice-deactivated-.*@example.com/, alice.reload.email_address)
+
+    # now the erasure request comes in via the UI
+    sign_in :david
+    delete user_url(alice)
+    assert_redirected_to users_url
+
+    # nothing of hers left anywhere
+    assert_nil User.find_by(id: alice.id)
+    assert_empty Session.where(user_id: alice.id)
+    assert_empty Access.where(user_id: alice.id)
+    assert_empty ReadingMark.where(user_id: alice.id)
+    assert_empty SignInEvent.where("email_address like ?", "alice%")
+    assert_nil Book.find_by(id: private_book.id)
+    assert_empty Leaf.search("alicesecretstuff")
+    assert_equal 0, Leaf.connection.select_value("select count(*) from leaf_search_index where rowid not in (select id from leaves)")
+    assert_equal 0, User.connection.select_value("select count(*) from users where name = 'Alice'")
+
+    # her everyone-book still works, bylined as Deleted author
+    shared.reload
+    assert_nil shared.creator_id
+    assert_equal "Deleted author", shared.author
+    assert_predicate Leaf.search("aliceguidecontent"), :any?
+    get book_slug_path(shared)
+    assert_response :success
+    assert_in_body "Deleted author"
+    assert_not_in_body "Alice Smith"
+  end
+end
diff --git a/test/models/user/erasable_test.rb b/test/models/user/erasable_test.rb
new file mode 100644
index 0000000..20aa4d8
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,125 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  setup do
+    Leaf.reindex_all
+    @user = users(:kevin)
+  end
+
+  test "erase removes the user and everything belonging to them" do
+    @user.sessions.create! user_agent: "Firefox", ip_address: "1.2.3.4"
+    ReadingMark.remember leaves(:welcome_page), user: @user
+    email_address = @user.email_address
+
+    assert_predicate SignInEvent.for_address(email_address), :any?
+
+    @user.erase
+
+    assert_nil User.find_by(id: @user.id)
+    assert_empty Session.where(user_id: @user.id)
+    assert_empty Access.where(user_id: @user.id)
+    assert_empty ReadingMark.where(user_id: @user.id)
+    assert_empty SignInEvent.for_address(email_address)
+  end
+
+  test "erase destroys books they created that aren't shared with everyone" do
+    book = Book.create! title: "Kevin's Diary", creator: @user, everyone_access: false
+    book.press Section.new(body: "onlyforkevin"), title: "Secret"
+
+    assert_predicate Leaf.search("onlyforkevin"), :any?
+
+    @user.erase
+
+    assert_nil Book.find_by(id: book.id)
+    assert_empty Leaf.where(book_id: book.id)
+    assert_empty Leaf.search("onlyforkevin")
+  end
+
+  test "erase leaves no orphaned search index entries behind" do
+    book = Book.create! title: "Kevin's Diary", creator: @user, everyone_access: false
+    book.press Section.new(body: "onlyforkevin"), title: "Secret"
+
+    @user.erase
+
+    assert_equal 0, Leaf.connection.select_value(
+      "select count(*) from leaf_search_index where rowid not in (select id from leaves)")
+  end
+
+  test "erase keeps books they created that are shared with everyone, bylined as deleted author" do
+    book = Book.create! title: "Kevin's Book", author: "Kevin", creator: @user, everyone_access: true
+    book.press Section.new(body: "everyonecanreadthis"), title: "Chapter"
+
+    @user.erase
+
+    book.reload
+    assert_nil book.creator_id
+    assert_equal "Deleted author", book.author
+    assert_equal 1, book.leaves.count
+    assert_predicate Leaf.search("everyonecanreadthis"), :any?
+  end
+
+  test "books shared with everyone keep their deleted author byline when saved again" do
+    book = Book.create! title: "Kevin's Book", author: "Kevin", creator: @user, everyone_access: true
+
+    @user.erase
+
+    Current.user = users(:david)
+    book.reload.update! subtitle: "Second edition"
+
+    assert_nil book.reload.creator_id
+    assert_equal "Deleted author", book.author
+  end
+
+  test "erase removes sign in events recorded before the user was deactivated" do
+    original_email_address = @user.email_address
+    @user.sessions.create! user_agent: "Firefox", ip_address: "1.2.3.4"
+
+    @user.deactivate
+    assert_not_equal original_email_address, @user.reload.email_address
+
+    @user.erase
+
+    assert_nil User.find_by(id: @user.id)
+    assert_empty SignInEvent.for_address(original_email_address)
+  end
+
+  test "sign in email addresses include every address the user signed in with" do
+    original_email_address = @user.email_address
+
+    @user.deactivate
+    @user.deactivate
+
+    assert_includes @user.sign_in_email_addresses, original_email_address
+    assert_includes @user.sign_in_email_addresses, @user.email_address
+  end
+
+  test "sign in email addresses is just the current address for an active user" do
+    assert_equal [ @user.email_address ], @user.sign_in_email_addresses
+  end
+
+  test "erase does not touch other people's data" do
+    ReadingMark.remember leaves(:welcome_page), user: users(:david)
+
+    assert_difference -> { ReadingMark.count }, 0 do
+      @user.erase
+    end
+
+    assert_predicate users(:david).reload, :persisted?
+    assert_predicate Access.where(user_id: users(:david).id), :any?
+  end
+
+  test "erase keeps sign in events belonging to whoever reclaimed the old address" do
+    original_email_address = @user.email_address
+    @user.sessions.create! user_agent: "Firefox", ip_address: "1.2.3.4"
+    @user.deactivate
+
+    travel 1.hour
+    newcomer = User.create! name: "Kevin Again", email_address: original_email_address, password: "secret123456"
+    newcomer.sessions.create! user_agent: "Firefox", ip_address: "1.2.3.4"
+
+    @user.erase
+
+    assert_equal 1, SignInEvent.for_address(original_email_address).count
+    assert_predicate newcomer.reload, :persisted?
+  end
+end
