+    # Snapshot the access list before the associated accesses are destroyed,
+    # so the archive can be written once the book is actually gone.
+    def capture_access_list
+      @captured_access_list = accesses.includes(:user).map do |access|
+        {
           book_id: id,
           book_title: title,
           user_id: access.user_id,
-          user_name: access.user.name,
+          user_name: access.user&.name,
           level: access.level
-        )
+        }
       end
     end
+
+    def archive_access_list
+      Array(@captured_access_list).each { |attributes| AccessArchive.create!(**attributes) }
+      @captured_access_list = nil
+    end
 end
diff --git a/test/controllers/books_controller_test.rb b/test/controllers/books_controller_test.rb
index 81d5f48..141667e 100644
--- a/test/controllers/books_controller_test.rb
+++ b/test/controllers/books_controller_test.rb
@@ -114,4 +114,16 @@ class BooksControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
     assert_select "link[rel=\"alternate\"][type=\"text/markdown\"][href=\"#{book_slug_path(books(:handbook), format: :md)}\"]"
   end
+
+  test "destroy archives who had access" do
+    book = books(:handbook)
+    expected = book.accesses.map { |access| [ access.user_id, access.level ] }.sort
+
+    delete book_path(book)
+
+    assert_redirected_to root_url
+    assert_not Book.exists?(book.id)
+    assert_equal 0, Access.where(book_id: book.id).count
+    assert_equal expected, AccessArchive.where(book_id: book.id).map { |archive| [ archive.user_id, archive.level ] }.sort
+  end
 end
diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..3d538f7 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,47 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "destroying a book archives the access list" do
+    book = books(:handbook)
+    expected = book.accesses.map { |access| [ access.user_id, access.level ] }.sort
+
+    assert_difference -> { AccessArchive.count }, expected.size do
+      book.destroy
+    end
+
+    archives = AccessArchive.where(book_id: book.id)
+    assert_equal expected, archives.map { |archive| [ archive.user_id, archive.level ] }.sort
+    assert_equal [ "Handbook" ], archives.map(&:book_title).uniq
+    assert_equal 0, Access.where(book_id: book.id).count
+  end
+
+  test "destroying a book does not archive revoked accesses" do
+    book = books(:handbook)
+    book.accesses.find_by(user: users(:jz)).destroy
+
+    book.destroy
+
+    assert_not_includes AccessArchive.where(book_id: book.id).pluck(:user_id), users(:jz).id
+  end
+
+  test "destroying a book nobody has access to archives nothing" do
+    book = Book.create!(title: "Nobody's book")
+    book.accesses.delete_all
+
+    assert_no_difference -> { AccessArchive.count } do
+      book.destroy
+    end
+
+    assert_not Book.exists?(book.id)
+  end
+
+  test "rolling back a destroy archives nothing" do
+    assert_no_difference -> { AccessArchive.count } do
+      Book.transaction do
+        books(:handbook).destroy
+        raise ActiveRecord::Rollback
+      end
+    end
+  end
 end
