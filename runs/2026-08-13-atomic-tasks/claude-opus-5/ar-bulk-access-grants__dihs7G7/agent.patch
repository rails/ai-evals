diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..9338f89
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper, ActiveRecord::Assertions::QueryAssertions
+
+  setup do
+    @book = Book.create!(title: "New book", everyone_access: false)
+    @users = 16.times.map { |i| User.create!(name: "User #{i}", email_address: "user#{i}@example.com", password: "secret123456") }
+  end
+
+  test "imports every grant and notifies each person" do
+    result = nil
+
+    assert_enqueued_jobs 4, only: Book::AccessNotificationJob do
+      result = import(grants(4))
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal @users.first(4).map(&:id), result.accesses.map(&:user_id)
+    assert result.accesses.all?(&:persisted?)
+    assert_equal 4, @book.accesses.count
+  end
+
+  test "imports mixed levels" do
+    result = import [ grant(@users.first, :editor), grant(@users.second, "reader") ]
+
+    assert_equal %w[ editor reader ], result.accesses.map(&:level)
+  end
+
+  test "importing does not cost more writes as the roster grows" do
+    small = queries(@book, grants(4)).grep(/INSERT/i)
+    large = queries(Book.create!(title: "Another book", everyone_access: false), grants(16)).grep(/INSERT/i)
+
+    assert_equal 1, small.size
+    assert_equal small.size, large.size
+  end
+
+  test "rejecting does not cost more queries as the roster grows" do
+    import [ grant(@users.last) ]
+
+    assert_equal queries(@book, grants(4) + [ grant(@users.last) ]).size,
+      queries(@book, grants(15) + [ grant(@users.last) ]).size
+  end
+
+  test "a rejected roster notifies nobody and grants nothing" do
+    import [ grant(@users.first) ]
+
+    result = nil
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = import [ grant(@users.second, :editor), grant(@users.first) ]
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal 1, @book.accesses.count
+  end
+
+  test "a duplicate within the roster is rejected" do
+    result = import [ grant(@users.first), grant(@users.first) ]
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "an unknown level is turned down instead of blowing up" do
+    result = nil
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = import [ grant(@users.first), grant(@users.second, "wizard") ]
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "an empty roster is a no-op" do
+    result = nil
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = import []
+    end
+
+    assert_empty result.accesses
+    assert_nil result.duplicate_index
+  end
+
+  private
+    def import(grants)
+      Book::AccessImport.new(@book, grants).import
+    end
+
+    def grant(user, level = :reader)
+      { user_id: user.id, level: level }
+    end
+
+    def grants(count, level: :reader)
+      @users.first(count).map { |user| grant(user, level) }
+    end
+
+    def queries(book, grants)
+      ActiveRecord::Base.lease_connection.materialize_transactions
+
+      counter = ActiveRecord::Assertions::QueryAssertions::SQLCounter.new
+      ActiveSupport::Notifications.subscribed(counter, "sql.active_record") do
+        Book::AccessImport.new(book, grants).import
+      end
+      counter.log
+    end
+end
