diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..03161c5 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,22 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Make controller errors surface as raised exceptions inside the block, and render
+    # error pages again afterwards.
+    #
+    # Note that we can't flip config.action_dispatch.show_exceptions here: the config is
+    # only read once, when Rails.application.env_config is first built (it's memoized),
+    # and every request is then handled with that snapshot. Toggling the config after the
+    # first request of the process has no effect, and toggling it before would leak into
+    # every later request. So we toggle the already-built rack env instead, which is what
+    # ActionDispatch::ShowExceptions actually consults on each request.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      env_config = Rails.application.env_config
+      previous = env_config["action_dispatch.show_exceptions"]
+      env_config["action_dispatch.show_exceptions"] = :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env_config["action_dispatch.show_exceptions"] = previous
     end
   end
 end
