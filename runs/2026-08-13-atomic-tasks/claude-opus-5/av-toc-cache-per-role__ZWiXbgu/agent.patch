diff --git a/test/integration/perf_probe_test.rb b/test/integration/perf_probe_test.rb
new file mode 100644
index 0000000..fc99340
--- /dev/null
+++ b/test/integration/perf_probe_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+class PerfProbeTest < ActionDispatch::IntegrationTest
+  test "query count does not scale per leaf" do
+    book = books(:handbook)
+    # Grow the book to a few hundred entries, like the biggest books here.
+    300.times { |i| book.press Page.new(body: "body #{i}"), { title: "Page #{i}" } }
+    total = book.leaves.active.count
+    puts "leaves: #{total}"
+
+    store = ActiveSupport::Cache::MemoryStore.new
+    ActionController::Base.perform_caching = true
+    ActionController::Base.cache_store = store
+    ActionView::PartialRenderer.collection_cache = store
+
+    sign_in :kevin
+
+    [ "cold", "warm" ].each do |label|
+      queries = 0
+      sub = ActiveSupport::Notifications.subscribe("sql.active_record") do |*, p|
+        queries += 1 unless p[:name].to_s =~ /SCHEMA|TRANSACTION/
+      end
+      t = Time.now
+      get book_slug_path(book)
+      elapsed = Time.now - t
+      ActiveSupport::Notifications.unsubscribe(sub)
+      assert_response :success
+      puts "#{label}: #{queries} queries, #{(elapsed * 1000).round}ms  (#{(queries.to_f / total).round(3)} per leaf)"
+    end
+
+    # Reads should be one multi-get, not a lookup per entry.
+    reads = 0
+    sub = ActiveSupport::Notifications.subscribe(/cache_read_multi|cache_read\./) { reads += 1 }
+    get book_slug_path(book)
+    ActiveSupport::Notifications.unsubscribe(sub)
+    puts "cache read events on warm render: #{reads}"
+  end
+end
