diff --git a/app/helpers/leaves_helper.rb b/app/helpers/leaves_helper.rb
index 042921c..10f4b70 100644
--- a/app/helpers/leaves_helper.rb
+++ b/app/helpers/leaves_helper.rb
@@ -1,4 +1,19 @@
 module LeavesHelper
+  # The single source of truth for a leaf's table of contents cache key.
+  #
+  # Both the per-leaf `cache` block in leaves/_leaf and the `cached:` option of
+  # the collection render must agree on this key. When they disagree, the
+  # collection cache keys each entry by the leaf alone and that one entry is
+  # shared between readers and editors: whoever renders the book first decides
+  # whether everyone after them sees edit controls.
+  #
+  # Including `editable?` keeps readers and editors on separate entries, while
+  # the leaf and book records keep the key changing whenever a leaf is renamed
+  # or the book itself is touched.
+  def leaf_cache_key(leaf)
+    [ leaf, leaf.book, leaf.book.editable? ]
+  end
+
   def leaf_item_tag(leaf, **, &)
     tag.li class: "arrangement__item toc__leaf toc__leaf--#{leaf.leafable_name}",
       id: dom_id(leaf),
