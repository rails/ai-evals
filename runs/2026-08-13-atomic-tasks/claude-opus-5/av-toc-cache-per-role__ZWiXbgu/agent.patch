+++ b/test/integration/probe_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+class ProbeTest < ActionDispatch::IntegrationTest
+  test "probe keys" do
+    store = ActiveSupport::Cache::MemoryStore.new
+    ActionController::Base.perform_caching = true
+    ActionController::Base.cache_store = store
+    ActionView::PartialRenderer.collection_cache = store
+
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    kevin_keys = store.instance_variable_get(:@data).keys.grep(/leaves\/_leaf/).sort
+
+    sign_out; sign_in :jz
+    get book_slug_path(books(:handbook))
+    jz_keys = store.instance_variable_get(:@data).keys.grep(/leaves\/_leaf/).sort
+
+    puts "leaf entries after editor:  #{kevin_keys.size}"
+    puts "leaf entries after +reader: #{jz_keys.size}  (no new entries => shared/leaked)"
+    puts kevin_keys.first
+  end
+end
