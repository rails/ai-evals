diff --git a/app/controllers/books/searches_controller.rb b/app/controllers/books/searches_controller.rb
index 5268c55..9f51f6c 100644
--- a/app/controllers/books/searches_controller.rb
+++ b/app/controllers/books/searches_controller.rb
@@ -1,9 +1,23 @@
 class Books::SearchesController < ApplicationController
   allow_unauthenticated_access
 
+  SEARCHES_PER_MINUTE = 30
+
+  # Searching runs a full-text query and needs no sign-in, which makes it an easy
+  # way to hammer the server. Limit each address before any book lookup happens,
+  # and let the limit expire on its own so nothing has to be unblocked.
+  rate_limit to: SEARCHES_PER_MINUTE, within: 1.minute,
+    store: RateLimitCache, with: :refuse_excessive_searching
+
   include BookScoped
 
   def create
     @leaves = @book.leaves.active.search(params[:search]).favoring_title.limit(50)
   end
+
+  private
+    def refuse_excessive_searching
+      response.set_header "Retry-After", 1.minute.to_i.to_s
+      render "books/searches/too_many_requests", status: :too_many_requests
+    end
 end
