diff --git a/config/initializers/rate_limiting.rb b/config/initializers/rate_limiting.rb
new file mode 100644
index 0000000..de92023
--- /dev/null
+++ b/config/initializers/rate_limiting.rb
@@ -0,0 +1,8 @@
+# Rate limit counters live in a process-local store when no shared cache is
+# configured (development and test), so clear them between tests to keep each
+# test isolated from the requests made by the others.
+if Rails.env.test?
+  ActiveSupport.on_load(:active_support_test_case) do
+    setup { RateLimitCache.reset }
+  end
+end
diff --git a/lib/rate_limit_cache.rb b/lib/rate_limit_cache.rb
new file mode 100644
index 0000000..ce1aa56
--- /dev/null
+++ b/lib/rate_limit_cache.rb
@@ -0,0 +1,40 @@
+# Counts requests for rate limiting.
+#
+# Rate limits have to be enforced even when the application isn't caching, so
+# counters are kept in whichever cache store is configured, falling back to an
+# in-memory store when that store doesn't count (like the null store used in
+# development and test).
+module RateLimitCache
+  extend self
+
+  FALLBACK_STORE = ActiveSupport::Cache::MemoryStore.new
+
+  def increment(...)
+    store.increment(...)
+  end
+
+  def read(...)
+    store.read(...)
+  end
+
+  def write(...)
+    store.write(...)
+  end
+
+  def delete(...)
+    store.delete(...)
+  end
+
+  def store
+    counting_store(Rails.cache) || counting_store(ActionController::Base.cache_store) || FALLBACK_STORE
+  end
+
+  def reset
+    FALLBACK_STORE.clear
+  end
+
+  private
+    def counting_store(store)
+      store if store.respond_to?(:increment) && !store.is_a?(ActiveSupport::Cache::NullStore)
+    end
+end
diff --git a/test/controllers/books/searches_controller_test.rb b/test/controllers/books/searches_controller_test.rb
index b48726d..34cd1f1 100644
--- a/test/controllers/books/searches_controller_test.rb
+++ b/test/controllers/books/searches_controller_test.rb
@@ -241,4 +241,75 @@ class Books::SearchesControllerTest < ActionDispatch::IntegrationTest
       end
     end
   end
+
+  test "create refuses searches from an address that exceeds the rate limit" do
+    sign_out
+    books(:handbook).update!(published: true)
+
+    Books::SearchesController::SEARCHES_PER_MINUTE.times do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }
+      assert_response :success
+    end
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" }
+    assert_response :too_many_requests
+  end
+
+  test "create still serves other addresses while one is being refused" do
+    sign_out
+    books(:handbook).update!(published: true)
+
+    exceed_search_rate_limit
+
+    post book_search_path(books(:handbook)), params: { search: "Thanks" },
+      headers: { "REMOTE_ADDR" => "10.0.0.99" }
+
+    assert_response :success
+    assert_select "a", text: /Thanks for reading/i
+  end
+
+  test "create serves a refused address again after the limit window passes" do
+    sign_out
+    books(:handbook).update!(published: true)
+
+    exceed_search_rate_limit
+
+    travel 5.minutes do
+      post book_search_path(books(:handbook)), params: { search: "Thanks" }
+      assert_response :success
+    end
+  end
+
+  test "create keeps serving the rest of a refused address's requests" do
+    sign_out
+    books(:handbook).update!(published: true)
+
+    exceed_search_rate_limit
+
+    get book_slug_path(books(:handbook))
+    assert_response :success
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+  end
+
+  test "create tells a refused address when to try again instead of running the search" do
+    sign_out
+    books(:handbook).update!(published: true)
+
+    exceed_search_rate_limit
+
+    assert_equal "60", response.headers["Retry-After"]
+    assert_in_body "Too many searches"
+    assert_not_in_body "Thanks for reading"
+  end
+
+  private
+    def exceed_search_rate_limit
+      (Books::SearchesController::SEARCHES_PER_MINUTE + 1).times do
+        post book_search_path(books(:handbook)), params: { search: "Thanks" }
+      end
+
+      assert_response :too_many_requests
+    end
 end
