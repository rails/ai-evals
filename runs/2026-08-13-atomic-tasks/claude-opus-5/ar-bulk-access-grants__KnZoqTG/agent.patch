diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..476672c
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+    @users = 20.times.map do |i|
+      User.create! name: "User #{i}", email_address: "user-#{i}@example.com",
+        password: "secret123456", role: :member
+    end
+    revoke_batch
+  end
+
+  test "imports every grant and notifies each one" do
+    result = nil
+
+    assert_enqueued_jobs 3, only: Book::AccessNotificationJob do
+      result = import grants(@users.first(2)) + grants(@users.last(1), level: :editor)
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal [ @users[0].id, @users[1].id, @users[19].id ], result.accesses.map(&:user_id)
+    assert_equal %w[ reader reader editor ], result.accesses.map(&:level)
+    assert result.accesses.all?(&:persisted?)
+    assert_equal [ @book ], result.accesses.map(&:book).uniq
+  end
+
+  test "imports nothing for an empty roster" do
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = import []
+
+      assert_equal [], result.accesses
+      assert_nil result.duplicate_index
+    end
+  end
+
+  test "costs the same number of queries regardless of roster size" do
+    small = queries { import grants(@users.first(4)) }
+    revoke_batch
+    large = queries { import grants(@users.first(16)) }
+
+    assert_equal small, large
+  end
+
+  test "costs the same number of queries when the roster is turned down" do
+    taken = @book.accesses.create! user_id: @users.last.id, level: :reader
+
+    assert_equal queries { import grants(@users.first(3)) + grants([ taken.user ]) },
+      queries { import grants(@users.first(15)) + grants([ taken.user ]) }
+  end
+
+  test "turns down a roster naming an access the book already has" do
+    taken = @book.accesses.create! user_id: @users.last.id, level: :editor
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = import grants(@users.first(2)) + grants([ taken.user ])
+
+      assert_equal [], result.accesses
+      assert_equal 2, result.duplicate_index
+    end
+
+    assert_equal [ taken.user_id ], batch_accesses.pluck(:user_id)
+    assert_equal "editor", taken.reload.level
+  end
+
+  test "turns down a roster naming the same person twice" do
+    result = import grants(@users.first(2)) + grants([ @users.first ], level: :editor)
+
+    assert_equal [], result.accesses
+    assert_equal 2, result.duplicate_index
+    assert_empty batch_accesses
+  end
+
+  test "turns down a roster naming an unknown level instead of blowing up" do
+    result = nil
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      assert_nothing_raised do
+        result = import grants(@users.first(2)) + [ { user_id: @users[2].id, level: "overlord" } ] + grants(@users.last(1))
+      end
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 2, result.duplicate_index
+    assert_empty batch_accesses
+  end
+
+  test "turns down a roster naming no level at all" do
+    result = import [ { user_id: @users.first.id, level: nil } ]
+
+    assert_equal [], result.accesses
+    assert_equal 0, result.duplicate_index
+    assert_empty batch_accesses
+  end
+
+  private
+    def import(grants)
+      Book::AccessImport.new(@book, grants).import
+    end
+
+    def grants(users, level: :reader)
+      users.map { { user_id: it.id, level: level } }
+    end
+
+    def batch_accesses
+      @book.accesses.where(user_id: @users.map(&:id))
+    end
+
+    def revoke_batch
+      batch_accesses.delete_all
+    end
+
+    def queries
+      count = 0
+      counter = ->(*, payload) { count += 1 unless payload[:name] == "SCHEMA" }
+
+      ActiveSupport::Notifications.subscribed(counter, "sql.active_record") { yield }
+      count
+    end
+end
