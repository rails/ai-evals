diff --git a/test/models/user/erasable_test.rb b/test/models/user/erasable_test.rb
new file mode 100644
index 0000000..2ec96ce
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,169 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @user = users(:kevin)
+  end
+
+  test "erasing removes the user row" do
+    @user.erase
+
+    assert_not User.exists?(@user.id)
+  end
+
+  test "erasing removes accesses, reading marks and sessions" do
+    ReadingMark.remember(leaves(:welcome_page), user: @user)
+    @user.sessions.start!(user_agent: "Chrome", ip_address: "1.2.3.4")
+
+    assert_difference -> { Access.count }, -1 do
+      @user.erase
+    end
+
+    assert_empty Access.where(user_id: @user.id)
+    assert_empty ReadingMark.where(user_id: @user.id)
+    assert_empty Session.where(user_id: @user.id)
+  end
+
+  test "erasing removes their sign in events" do
+    @user.sessions.start!(user_agent: "Chrome", ip_address: "1.2.3.4").destroy!
+    assert_equal 2, SignInEvent.for_address(@user.email_address).count
+
+    @user.erase
+
+    assert_empty SignInEvent.for_address("kevin@example.com")
+  end
+
+  test "erasing doesn't record a sign out event on the way out" do
+    @user.sessions.start!(user_agent: "Chrome", ip_address: "1.2.3.4")
+
+    @user.erase
+
+    assert_empty SignInEvent.for_address("kevin@example.com")
+  end
+
+  test "erasing leaves other people's sign in events alone" do
+    users(:david).sessions.start!(user_agent: "Chrome", ip_address: "1.2.3.4")
+
+    @user.erase
+
+    assert_equal 1, SignInEvent.for_address(users(:david).email_address).count
+  end
+
+  test "erasing destroys the books they created" do
+    book = Book.create!(title: "Kevin's Notes", everyone_access: false, creator: @user)
+    book.press Page.new(body: "Private thoughts"), title: "Private"
+    leaf = book.leaves.sole
+
+    @user.erase
+
+    assert_not Book.exists?(book.id)
+    assert_not Leaf.exists?(leaf.id)
+    assert_empty Page.where(id: leaf.leafable_id)
+    assert_empty Access.where(book_id: book.id)
+  end
+
+  test "erasing removes their books from the search index" do
+    book = Book.create!(title: "Kevin's Notes", everyone_access: false, creator: @user)
+    book.press Page.new(body: "vindaloo"), title: "Recipes"
+    book.press Section.new(body: "vindaloo section"), title: "Chapter"
+    Leaf.reindex_all
+
+    assert_not_empty Leaf.search("vindaloo").to_a
+
+    @user.erase
+
+    assert_empty Leaf.search("vindaloo").to_a
+  end
+
+  test "erasing keeps books they created that are shared with everyone, bylined as a deleted author" do
+    book = Book.create!(title: "The Handbook Of Kevin", author: "Kevin", everyone_access: true, creator: @user)
+    book.update_access(editors: [ @user.id ], readers: [])
+    book.press Page.new(body: "Everyone reads this"), title: "Intro"
+    Leaf.reindex_all
+
+    assert book.accessable?(user: users(:david))
+
+    @user.erase
+
+    book.reload
+    assert_nil book.creator_id
+    assert_equal User::Erasable::DELETED_AUTHOR, book.author
+    assert_not_empty Leaf.search("Everyone reads this").to_a
+    assert book.accessable?(user: users(:david))
+  end
+
+  test "erasing purges the files they uploaded" do
+    book = Book.create!(title: "Kevin's Snapshots", everyone_access: false, creator: @user)
+    book.cover.attach io: file_fixture("reading.webp").open, filename: "cover.webp"
+    page = Page.new(body: "See this")
+    book.press page, title: "Snapshot"
+    page.body.uploads.attach io: file_fixture("reading.webp").open, filename: "upload.webp"
+    page.body.save!
+
+    perform_enqueued_jobs do
+      @user.erase
+    end
+
+    assert_empty ActiveStorage::Blob.where(filename: %w[ cover.webp upload.webp ])
+  end
+
+  test "erasing leaves other people's files alone" do
+    books(:handbook).cover.attach io: file_fixture("reading.webp").open, filename: "keeper.webp"
+
+    perform_enqueued_jobs do
+      @user.erase
+    end
+
+    assert_predicate books(:handbook).reload.cover, :attached?
+    assert_not_empty ActiveStorage::Blob.where(filename: "keeper.webp")
+  end
+
+  test "erasing a user who was deactivated by the old removal also erases their sign in events" do
+    @user.sessions.start!(user_agent: "Chrome", ip_address: "1.2.3.4")
+    deactivate_the_old_way @user
+
+    User.with_email_address("kevin@example.com").sole.erase
+
+    assert_not User.exists?(@user.id)
+    assert_empty SignInEvent.for_address("kevin@example.com")
+  end
+
+  test "with_email_address finds active and deactivated users" do
+    assert_equal @user, User.with_email_address("kevin@example.com").sole
+
+    deactivate_the_old_way @user
+
+    assert_equal @user, User.with_email_address("kevin@example.com").sole
+  end
+
+  test "with_email_address doesn't match other people" do
+    assert_empty User.with_email_address("nobody@example.com")
+    assert_empty User.with_email_address("kevin@example.org")
+  end
+
+  test "original_email_address strips the deactivation suffix" do
+    assert_equal "kevin@example.com", @user.original_email_address
+
+    deactivate_the_old_way @user
+
+    assert_equal "kevin@example.com", @user.original_email_address
+  end
+
+  test "erasing a deactivated user keeps sign in events of someone who reclaimed their address" do
+    deactivate_the_old_way @user
+    reclaimer = User.create!(name: "New Kevin", email_address: "kevin@example.com", password: "secret123456")
+    reclaimer.sessions.start!(user_agent: "Chrome", ip_address: "1.2.3.4")
+
+    @user.erase
+
+    assert_equal 1, SignInEvent.for_address("kevin@example.com").count
+  end
+
+  private
+    def deactivate_the_old_way(user)
+      user.update! active: false,
+        email_address: user.email_address.sub("@", "-deactivated-#{SecureRandom.uuid}@")
+    end
+end
