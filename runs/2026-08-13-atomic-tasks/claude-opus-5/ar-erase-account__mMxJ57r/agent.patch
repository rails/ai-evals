diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..e8472a3
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,94 @@
+# Honors an erasure request by permanently removing a person and everything of
+# theirs: their user row, accesses, reading marks, sessions, sign-in log
+# entries, and the books they created — down to the files those books held and
+# the entries they left in the search index.
+#
+# The one exception is a book they created that's shared with everyone: other
+# people are reading it, so the book keeps working, but every reference to its
+# former creator is dropped and it's bylined DELETED_AUTHOR instead.
+#
+# Erasure also has to work for people who were "removed" by an earlier version
+# that merely deactivated them and rewrote their email address to
+# alice-deactivated-<uuid>@example.com. Their sign-in log entries were recorded
+# under the address they actually signed in with, so those are erased under the
+# original address too.
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  DELETED_AUTHOR = "Deleted author"
+  DEACTIVATED_INFIX = /-deactivated-\h{8}-\h{4}-\h{4}-\h{4}-\h{12}(?=@[^@]*\z)/
+
+  included do
+    before_destroy :prepare_erasure, prepend: true
+    after_destroy  :erase_sign_in_events
+    after_destroy_commit :erase_orphaned_files
+  end
+
+  class_methods do
+    # Finds people by the address they signed up with, including anyone whose
+    # address was rewritten when they were deactivated.
+    def with_email_address(email_address)
+      local_part, _, domain = email_address.to_s.rpartition("@")
+      deactivated = "#{sanitize_sql_like(local_part)}-deactivated-%@#{sanitize_sql_like(domain)}"
+
+      where(email_address: email_address)
+        .or(where("email_address LIKE ? ESCAPE ?", deactivated, "\\"))
+    end
+  end
+
+  # The address this person actually signed in with, which is what their
+  # sign-in log entries are recorded under.
+  def original_email_address
+    email_address&.sub(DEACTIVATED_INFIX, "")
+  end
+
+  def erase
+    destroy!
+  end
+
+  private
+    def prepare_erasure
+      release_created_books_shared_with_everyone
+      remember_erasable_details
+      erase_sessions_without_auditing
+      reading_marks.delete_all
+    end
+
+    def release_created_books_shared_with_everyone
+      created_books.with_everyone_access.each do |book|
+        book.update_columns creator_id: nil, author: DELETED_AUTHOR, updated_at: Time.now
+      end
+
+      created_books.reset
+    end
+
+    # Sign out without logging it: the whole point is to leave no trace.
+    def erase_sessions_without_auditing
+      sessions.delete_all
+      sessions.reset
+    end
+
+    # Captured before the records go away, since we can't look them up after.
+    def remember_erasable_details
+      @erasable_email_addresses = [ email_address, unclaimed_original_email_address ].compact.uniq
+      @previously_attached_blob_ids = ActiveStorage::Attachment.distinct.pluck(:blob_id)
+    end
+
+    # Only erase log entries under the original address while nobody else has
+    # reclaimed it in the meantime.
+    def unclaimed_original_email_address
+      return if original_email_address == email_address
+
+      original_email_address unless self.class.where.not(id: id).exists?(email_address: original_email_address)
+    end
+
+    def erase_sign_in_events
+      SignInEvent.for_address(@erasable_email_addresses).delete_all
+    end
+
+    # Files uploaded into a page they wrote outlive the page itself, since
+    # revisions of a page share a blob. Purge the ones nothing points at anymore.
+    def erase_orphaned_files
+      ActiveStorage::Blob.where(id: @previously_attached_blob_ids).unattached.each(&:purge_later)
+    end
+end
diff --git a/script/admin/erase-user b/script/admin/erase-user
new file mode 100755
index 0000000..6bc6da9
--- /dev/null
+++ b/script/admin/erase-user
@@ -0,0 +1,20 @@
+#!/usr/bin/env ruby
+require File.expand_path("../../config/environment", File.dirname(__FILE__))
+
+abort "Usage: #{$0} <email-address>" unless ARGV.length == 1
+
+email_address = ARGV.first
+
+# Matches people who were deactivated by an older version of Writebook too:
+# their address was rewritten to alice-deactivated-<uuid>@example.com.
+users = User.with_email_address(email_address).to_a
+
+if users.empty?
+  puts "User not found"
+  exit(-1)
+else
+  users.each do |user|
+    user.erase
+    puts "Erased #{user.name} <#{email_address}>"
+  end
+end
