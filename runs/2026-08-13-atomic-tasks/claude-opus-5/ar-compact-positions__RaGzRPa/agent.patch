+    leaves.active.count
   end
 end
diff --git a/test/models/book/maintenance_test.rb b/test/models/book/maintenance_test.rb
new file mode 100644
index 0000000..02c8291
--- /dev/null
+++ b/test/models/book/maintenance_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+  end
+
+  test "compacting closes the gaps left by deletions" do
+    leaves(:welcome_section).update_columns(position_score: 5)
+    leaves(:welcome_page).update_columns(position_score: 20)
+    leaves(:summary_page).update_columns(position_score: 21.5)
+    leaves(:reading_picture).update_columns(position_score: 900)
+
+    @book.compact_positions!
+
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.reload.positioned.pluck(:position_score)
+  end
+
+  test "compacting preserves the hand-arranged ordering" do
+    leaves(:reading_picture).move_to_position(0)
+    arrangement = @book.leaves.positioned.pluck(:id)
+
+    @book.compact_positions!
+
+    assert_equal arrangement, @book.leaves.reload.positioned.pluck(:id)
+  end
+
+  test "compacting keeps ordering that runs against creation order" do
+    @book.leaves.order(id: :desc).each.with_index(1) do |leaf, index|
+      leaf.update_columns(position_score: index * 10)
+    end
+    arrangement = @book.leaves.positioned.pluck(:id)
+
+    @book.compact_positions!
+
+    assert_equal arrangement, @book.leaves.reload.positioned.pluck(:id)
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.reload.positioned.pluck(:position_score)
+  end
+
+  test "compacting keeps trashed leaves in place so they restore where they were" do
+    leaves(:summary_page).trashed!
+    arrangement = @book.leaves.order(:position_score, :id).pluck(:id)
+
+    @book.compact_positions!
+    leaves(:summary_page).active!
+
+    assert_equal arrangement, @book.leaves.reload.order(:position_score, :id).pluck(:id)
+    assert_equal leaves(:summary_page), leaves(:welcome_page).reload.next
+  end
+
+  test "compacting only touches the book's own leaves" do
+    other = books(:manual).press Page.new(body: "Elsewhere"), title: "Elsewhere"
+    other.update_columns(position_score: 500)
+
+    @book.compact_positions!
+
+    assert_equal 500, other.reload.position_score
+  end
+
+  test "compacting a book without leaves is a no-op" do
+    assert_nothing_raised { books(:manual).compact_positions! }
+  end
+
+  test "live leaf count excludes trashed leaves" do
+    assert_equal 4, @book.live_leaf_count
+
+    leaves(:summary_page).trashed!
+    assert_equal 3, @book.reload.live_leaf_count
+  end
+
+  test "live leaf count is zero for a book without leaves" do
+    assert_equal 0, books(:manual).live_leaf_count
+  end
+end
