diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..d4682a9
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  test "show finds matching pages in readable books" do
+    sign_in :kevin
+
+    get library_search_path(q: "Welcome")
+
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+  end
+
+  test "show does not return pages from books the user cannot read" do
+    sign_in :kevin
+    books(:manual).press Page.new(body: "secret"), title: "Secret Manual Page"
+
+    get library_search_path(q: "Secret")
+
+    assert_response :success
+    assert_not_in_body "Secret Manual Page"
+    assert_in_body "No matches"
+  end
+
+  test "show only returns published books when signed out" do
+    books(:handbook).update!(published: true)
+
+    get library_search_path(q: "Welcome")
+    assert_response :success
+    assert_in_body "Welcome to The Handbook!"
+
+    books(:handbook).update!(published: false)
+
+    get library_search_path(q: "Welcome")
+    assert_response :success
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "show treats the query as data, not SQL" do
+    sign_in :kevin
+    books(:manual).press Page.new(body: "secret"), title: "Secret Manual Page"
+
+    get library_search_path(q: "%' or 1=1 --")
+
+    assert_response :success
+    assert_not_in_body "Secret Manual Page"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "show handles punctuation without erroring" do
+    sign_in :kevin
+
+    [ "it's", "\"", "\\", "\\%", "a' union select 1 --", "50%" ].each do |query|
+      get library_search_path(q: query)
+      assert_response :success, "searching for #{query.inspect} failed"
+    end
+  end
+
+  test "show matches per cent and underscore literally" do
+    sign_in :kevin
+    books(:handbook).press Page.new(body: "cheap"), title: "Save 50% off"
+    books(:handbook).press Page.new(body: "snake"), title: "snake_case tricks"
+
+    get library_search_path(q: "Save 50% off")
+    assert_response :success
+    assert_in_body "Save 50% off"
+
+    get library_search_path(q: "%")
+    assert_response :success
+    assert_in_body "Save 50% off"
+    assert_not_in_body "Welcome to The Handbook!"
+
+    get library_search_path(q: "_")
+    assert_response :success
+    assert_in_body "snake_case tricks"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+end
diff --git a/test/controllers/users/profiles_controller_test.rb b/test/controllers/users/profiles_controller_test.rb
index 7564f7d..e64e2ff 100644
--- a/test/controllers/users/profiles_controller_test.rb
+++ b/test/controllers/users/profiles_controller_test.rb
@@ -38,4 +38,35 @@ class Users::ProfilesControllerTest < ActionDispatch::IntegrationTest
     assert_response :forbidden
     assert_equal "Kevin", users(:kevin).reload.name
   end
+
+  test "update cannot change the current user's own role" do
+    sign_in :kevin
+
+    put user_profile_url(users(:kevin)), params: { user: { name: "Kev", role: "administrator" } }
+
+    assert_redirected_to users_url
+    assert_equal "Kev", users(:kevin).reload.name
+    assert_not users(:kevin).reload.administrator?
+  end
+
+  test "update cannot change another user's role" do
+    sign_in :kevin
+
+    put user_profile_url(users(:jz)), params: { user: { role: "administrator" } }
+
+    assert_response :forbidden
+    assert_not users(:jz).reload.administrator?
+  end
+
+  test "update changes name, email address and password for the current user" do
+    sign_in :jz
+
+    put user_profile_url(users(:jz)), params: { user: { name: "Zed", email_address: "zed@example.com", password: "newpassword123" } }
+
+    assert_redirected_to users_url
+    jz = users(:jz).reload
+    assert_equal "Zed", jz.name
+    assert_equal "zed@example.com", jz.email_address
+    assert jz.authenticate("newpassword123")
+  end
 end
