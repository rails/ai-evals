diff --git a/config/initializers/runner_logging.rb b/config/initializers/runner_logging.rb
new file mode 100644
index 0000000..d64d903
--- /dev/null
+++ b/config/initializers/runner_logging.rb
@@ -0,0 +1,17 @@
+# `bin/rails runner` has no terminal output of its own: everything the script
+# logs goes to the environment's log file only, which made runbook steps like
+# script/library_report.rb look like they did nothing at all.
+#
+# Mirror the log to STDOUT for the duration of the run, the same way
+# `bin/rails server` does, so the operator sees the output while the log file
+# keeps the full record. Environments that already log to the terminal
+# (production logs to STDOUT) are left alone so lines aren't printed twice.
+Rails.application.runner do
+  unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT, STDERR)
+    console = ActiveSupport::Logger.new(STDOUT)
+    console.formatter = Rails.logger.formatter
+    console.level = Rails.logger.level
+
+    Rails.logger.broadcast_to(console)
+  end
+end
diff --git a/test/lib/runner_logging_test.rb b/test/lib/runner_logging_test.rb
new file mode 100644
index 0000000..b82661a
--- /dev/null
+++ b/test/lib/runner_logging_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+require "open3"
+
+# `bin/rails runner` logs to the environment's log file only, which made runbook steps such as
+# script/library_report.rb look like they printed nothing at all. The runner hook in
+# config/initializers/runner_logging.rb mirrors the log to STDOUT for the run, so the operator
+# sees the report while the log file keeps the whole record.
+class RunnerLoggingTest < ActiveSupport::TestCase
+  test "runner logs to STDOUT as well as the environment log file" do
+    token = "runner-logging-#{SecureRandom.hex(6)}"
+
+    stdout = run_runner %(Rails.logger.info "info #{token}"; Rails.logger.warn "warn #{token}")
+
+    assert_includes stdout, "info #{token}"
+    assert_includes stdout, "warn #{token}"
+    assert_includes log_file_contents, "info #{token}"
+    assert_includes log_file_contents, "warn #{token}"
+  end
+
+  test "runner logs each line to STDOUT only once" do
+    token = "runner-logging-#{SecureRandom.hex(6)}"
+
+    stdout = run_runner %(Rails.logger.info "once #{token}")
+
+    assert_equal 1, stdout.scan("once #{token}").size
+  end
+
+  private
+    def run_runner(code)
+      stdout, stderr, status = Open3.capture3(
+        { "RAILS_ENV" => nil }, Rails.root.join("bin/rails").to_s, "runner", "-e", "test", code,
+        chdir: Rails.root.to_s
+      )
+
+      assert_predicate status, :success?, "bin/rails runner failed: #{stderr}"
+      stdout
+    end
+
+    def log_file_contents
+      Rails.root.join("log/test.log").read
+    end
+end
