diff --git a/test/controllers/tenant_scoping_test.rb b/test/controllers/tenant_scoping_test.rb
new file mode 100644
index 0000000..3a2370a
--- /dev/null
+++ b/test/controllers/tenant_scoping_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class TenantScopingTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Tenant A")
+    @tenant_b = Tenant.create!(name: "Tenant B")
+
+    @user_a = User.create!(name: "Alice", email_address: "alice@example.com", password_digest: BCrypt::Password.create("secret123456"), role: :member, tenant: @tenant_a)
+    @user_b = User.create!(name: "Bob", email_address: "bob@example.com", password_digest: BCrypt::Password.create("secret123456"), role: :member, tenant: @tenant_b)
+
+    @book_a = Book.create!(title: "Book A", slug: "book-a", tenant: @tenant_a, everyone_access: true, published: true)
+    @book_a.update_access(editors: [ @user_a.id ], readers: [])
+    @book_b = Book.create!(title: "Book B", slug: "book-b", tenant: @tenant_b, everyone_access: true, published: false)
+    @book_b.update_access(editors: [ @user_b.id ], readers: [])
+
+
+    @leaf_a = @book_a.press(Page.new(body: "My content"), title: "My Page")
+    @leaf_a.edit leafable_params: { body: "My edit content" }
+    @leaf_b = @book_b.press(Page.new(body: "Secret content"), title: "Secret Page")
+    @leaf_b.edit leafable_params: { body: "Secret edit content" }
+    @edit_b = @leaf_b.edits.last
+  end
+
+  test "new books created land in their creator's tenant" do
+    sign_in @user_a
+    assert_equal @tenant_a.id, @user_a.tenant_id
+    post books_url, params: { book: { title: "New Book", everyone_access: true } }
+    assert_equal @tenant_a.id, Book.last.tenant_id
+  end
+
+  test "another tenant's books are absent from library" do
+    sign_in @user_a
+    get root_url
+    assert_response :success
+    assert_in_body "Book A"
+    assert_not_in_body "Book B"
+  end
+
+  test "another tenant's book, page, and edit history all answer 404" do
+    sign_in @user_a
+
+    get book_slug_url(@book_b)
+    assert_response :not_found
+
+    get leafable_slug_url(@leaf_b)
+    assert_response :not_found
+
+    get page_edit_url(@leaf_b, @edit_b)
+    assert_response :not_found
+  end
+
+  test "own tenant book, page, and edit history keep working" do
+    sign_in @user_a
+
+    get book_slug_url(@book_a)
+    assert_response :success
+
+    get leafable_slug_url(@leaf_a)
+    assert_response :success
+
+    get page_edit_url(@leaf_a, @leaf_a.edits.last)
+    assert_response :success
+  end
+
+  test "signed-out visitors still see published books from any tenant" do
+    @book_b.update!(published: true)
+    sign_out
+
+    get root_url
+    assert_response :success
+    assert_in_body "Book A"
+    assert_in_body "Book B"
+  end
+end
