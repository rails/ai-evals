diff --git a/lib/search_rate_limiter.rb b/lib/search_rate_limiter.rb
new file mode 100644
index 0000000..54728e1
--- /dev/null
+++ b/lib/search_rate_limiter.rb
@@ -0,0 +1,35 @@
+class SearchRateLimiter
+  LIMIT = 30
+  WINDOW_SECONDS = 60
+
+  class << self
+    # Returns +true+ when an address is still allowed to run a search.
+    def allowed?(address)
+      increment(counter_key(address)) <= LIMIT
+    end
+
+    private
+      # A fixed one-minute window keyed by address. Once the minute rolls over
+      # the counter starts from zero again, so a quiet address recovers by
+      # itself (within the window) with no intervention required.
+      def counter_key(address)
+        window = Time.current.to_i / WINDOW_SECONDS
+        "books_search:#{address}:#{window}"
+      end
+
+      def increment(key)
+        store.increment(key, 1, expires_in: 2 * WINDOW_SECONDS) || 1
+      end
+
+      # Production uses a shared cache (redis) so every puma worker counts the
+      # same requests. The test environment uses a null store, so fall back to
+      # an in-memory store there to keep the limiter observable.
+      def store
+        if Rails.cache.is_a?(ActiveSupport::Cache::NullStore)
+          @memory_store ||= ActiveSupport::Cache::MemoryStore.new
+        else
+          Rails.cache
+        end
+      end
+  end
+end
