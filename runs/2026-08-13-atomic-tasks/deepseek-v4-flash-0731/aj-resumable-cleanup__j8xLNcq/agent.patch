+require "test_helper"
+
+class TitleCleanupJobTest < ActiveSupport::TestCase
+  test "cleans the stray wrapping quotes from leaf titles exactly once" do
+    book = books(:handbook)
+    simple_page = Page.create!
+    quoted_leaf = leaves(:welcome_page)
+    quoted_leaf.update!(title: %("Welcome to The Handbook!"))
+
+    quoted_inner_page = Page.create!
+    inner_quote_leaf = Leaf.create!(
+      book: book,
+      leafable: quoted_inner_page,
+      title: %("She said "hi" and left"),
+      position_score: 5,
+      status: :active
+    )
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "Welcome to The Handbook!", leaves(:welcome_page).reload.title
+    assert_equal %(She said "hi" and left), inner_quote_leaf.reload.title
+    assert_not_nil leaves(:welcome_page).reload.title_cleaned_at
+    assert_not_nil inner_quote_leaf.reload.title_cleaned_at
+  end
+
+  test "resumes from where it left off and does not re-clean already cleaned leaves" do
+    book = books(:handbook)
+    first_page = Page.create!
+    first_leaf = Leaf.create!(
+      book: book,
+      leafable: first_page,
+      title: %("First title"),
+      position_score: 6,
+      status: :active,
+      title_cleaned_at: Time.current
+    )
+
+    second_page = Page.create!
+    second_leaf = Leaf.create!(
+      book: book,
+      leafable: second_page,
+      title: %("Second title"),
+      position_score: 7,
+      status: :active
+    )
+
+    # The first leaf was already cleaned and marked before an interruption.
+    TitleCleanupJob.perform_now
+
+    # The already-cleaned leaf must not be touched again...
+    assert_equal %("First title"), first_leaf.reload.title
+    # ...while the remaining leaf gets cleaned.
+    assert_equal "Second title", second_leaf.reload.title
+    assert_not_nil second_leaf.reload.title_cleaned_at
+  end
+
+  test "a leaf that legitimately starts and ends with quotes is not mangled by a rerun" do
+    book = books(:handbook)
+    legit_page = Page.create!
+    legit_leaf = Leaf.create!(
+      book: book,
+      leafable: legit_page,
+      title: %("Quoted phrase"),
+      position_score: 8,
+      status: :active
+    )
+
+    # First run: the exporter's outer wrapping quotes are removed,
+    # leaving the legitimate quotes intact.
+    TitleCleanupJob.perform_now
+    assert_equal %(Quoted phrase), legit_leaf.reload.title
+
+    # A rerun (e.g. after an interruption) must not strip those legitimate quotes,
+    # because the leaf is already marked as cleaned.
+    TitleCleanupJob.perform_now
+    assert_equal %(Quoted phrase), legit_leaf.reload.title
+  end
+end
