@@ -0,0 +1,39 @@
+require "test_helper"
+
+class MarkdownUploadsCleanupTest < ActiveSupport::TestCase
+  setup do
+    ActiveJob::Base.queue_adapter = :inline
+  end
+
+  test "destroying a page purges the image files embedded in its markdown" do
+    page = pages(:welcome)
+    page.body.uploads.attach(io: File.open(file_fixture("reading.webp")), filename: "reading.webp", content_type: "image/webp")
+    page.body.save!
+
+    attachment = page.body.uploads.last
+    blob = attachment.blob
+    file_path = blob.service.path_for(blob.key)
+
+    assert File.exist?(file_path)
+
+    page.leaf.destroy!
+
+    refute ActiveStorage::Attachment.where(id: attachment.id).exists?
+    refute ActiveStorage::Blob.where(id: blob.id).exists?
+    refute File.exist?(file_path)
+  end
+
+  test "destroying a page purges images without breaking unrelated images" do
+    keeper = pictures(:reading)
+    keeper_blob = keeper.image.blob
+
+    page = pages(:welcome)
+    page.body.uploads.attach(io: File.open(file_fixture("reading.webp")), filename: "reading.webp", content_type: "image/webp")
+    page.body.save!
+
+    page.leaf.destroy!
+
+    assert keeper.image.attached?
+    assert keeper_blob.present?
+  end
+end
