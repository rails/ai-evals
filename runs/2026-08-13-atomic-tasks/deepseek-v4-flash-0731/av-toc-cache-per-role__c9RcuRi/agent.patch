diff --git a/test/controllers/books_toc_permissions_test.rb b/test/controllers/books_toc_permissions_test.rb
new file mode 100644
index 0000000..1890f35
--- /dev/null
+++ b/test/controllers/books_toc_permissions_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class BooksTocPermissionsTest < ActionDispatch::IntegrationTest
+  # Editor controls in the table of contents (Move handles, Delete buttons,
+  # Edit links) must only ever appear for people who can edit the book. The
+  # reader/editor fragments are cached separately (keyed on editability), so a
+  # reader must never see editor controls regardless of who opened the book
+  # before them, and an editor must always see them.
+
+  test "a reader never receives editor controls" do
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+
+    assert_response :success
+    assert_not_in_body "Move "
+    assert_not_in_body "Delete "
+    assert_not_in_body "Edit Welcome to The Handbook!"
+    assert_in_body "Open Welcome to The Handbook!"
+  end
+
+  test "an editor always sees editor controls" do
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+
+    assert_response :success
+    assert_in_body "Move Welcome to The Handbook!"
+    assert_in_body "Delete Welcome to The Handbook!"
+    assert_in_body "Edit Welcome to The Handbook!"
+  end
+
+  test "a renamed entry still shows its new title" do
+    leaves(:welcome_page).update!(title: "Renamed Welcome")
+
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+
+    assert_in_body "Renamed Welcome"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "rendering the table of contents does not do a lookup per entry" do
+    sign_in :kevin
+
+    queries = 0
+    counter = ->(*, payload) {
+      sql = payload[:sql]
+      queries += 1 if sql =~ /accesses|books/i && sql !~ /use_transaction|begin|commit/
+    }
+
+    ActiveSupport::Notifications.subscribed(counter, "sql.active_record") do
+      get book_slug_path(books(:handbook))
+    end
+
+    assert_response :success
+    # A per-entry approach would issue one access query for every entry in the
+    # list. Fetching editability once per book keeps this constant, well below
+    # the number of entries.
+    assert_operator queries, :<=, 8, "expected no per-entry access lookups, got #{queries} queries"
+  end
+end
