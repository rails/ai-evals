diff --git a/lib/rails_ext/action_text_markdown.rb b/lib/rails_ext/action_text_markdown.rb
index fa0a622..29f40ae 100644
--- a/lib/rails_ext/action_text_markdown.rb
+++ b/lib/rails_ext/action_text_markdown.rb
@@ -29,7 +29,7 @@ module ActionText::Markdown::Uploads
   extend ActiveSupport::Concern
 
   included do
-    has_many_attached :uploads, dependent: :destroy
+    has_many_attached :uploads, dependent: :purge_later
   end
 end
 
diff --git a/test/controllers/action_text/markdown/uploads_controller_test.rb b/test/controllers/action_text/markdown/uploads_controller_test.rb
index 48141c1..336c91c 100644
--- a/test/controllers/action_text/markdown/uploads_controller_test.rb
+++ b/test/controllers/action_text/markdown/uploads_controller_test.rb
@@ -31,4 +31,24 @@ class ActionText::Markdown::UploadsControllerTest < ActionDispatch::IntegrationT
     assert_response :redirect
     assert_match /\/rails\/active_storage\/.*\/reading\.webp/, @response.redirect_url
   end
+
+  test "destroying a page purges embedded images and their blobs" do
+    markdown = pages(:welcome).body.tap(&:save!)
+    blob = markdown.uploads.attach(fixture_file_upload("reading.webp", "image/webp")).first.blob
+    key = blob.key
+    file_path = ActiveStorage::Blob.service.path_for(key)
+
+    assert ActiveStorage::Blob.exists?(key: key)
+    assert File.exist?(file_path)
+
+    # Run any background work the destruction triggers as it is enqueued.
+    ActiveJob::Base.queue_adapter.perform_enqueued_jobs = true
+    ActiveJob::Base.queue_adapter.enqueued_jobs = []
+    ActiveJob::Base.queue_adapter.performed_jobs = []
+
+    pages(:welcome).destroy!
+
+    assert_not ActiveStorage::Blob.exists?(key: key)
+    assert_not File.exist?(file_path)
+  end
 end
