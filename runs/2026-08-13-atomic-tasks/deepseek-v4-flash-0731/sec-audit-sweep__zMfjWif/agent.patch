diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..1a27396
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "ordinary searches still find results" do
+    get library_search_path, params: { q: "Welcome" }
+    assert_response :success
+    assert_includes response.body, "Welcome to The Handbook!"
+  end
+
+  test "PT03: searches with an apostrophe do not error and return results" do
+    books(:handbook).press(Section.new(body: "content"), title: "O'Brien's Guide")
+    get library_search_path, params: { q: "O'Brien" }
+    assert_response :success
+    assert_includes response.body, "O&#39;Brien"
+  end
+
+  test "PT03: injection cannot draw back pages from unreadable books" do
+    books(:manual).press(Section.new(body: "classified content"), title: "SecretManualPage")
+    get library_search_path, params: { q: "%' OR books.id = #{books(:manual).id} -- " }
+    assert_response :success
+    assert_not_includes response.body, "SecretManualPage"
+  end
+
+  test "PT04: percent sign is treated literally, not as a wildcard" do
+    books(:handbook).press(Section.new(body: "discount content"), title: "Save 50% off")
+    # searching % should find only the page with %, not act as a wildcard
+    get library_search_path, params: { q: "%" }
+    assert_response :success
+    assert_includes response.body, "Save 50% off"
+    assert_not_includes response.body, "The Welcome Section"
+  end
+
+  test "PT04: underscore is treated literally, not as a wildcard" do
+    books(:handbook).press(Section.new(body: "code content"), title: "foo_bar")
+    get library_search_path, params: { q: "_" }
+    assert_response :success
+    assert_includes response.body, "foo_bar"
+    assert_not_includes response.body, "The Welcome Section"
+  end
+
+  test "PT04: per cent title stays findable by its full title" do
+    books(:handbook).press(Section.new(body: "discount content"), title: "Save 50% off")
+    get library_search_path, params: { q: "Save 50% off" }
+    assert_response :success
+    assert_includes response.body, "Save 50% off"
+  end
+
+  test "signed out search only returns published books" do
+    books(:handbook).update!(published: true)
+    books(:manual).update!(published: true)
+    sign_out
+    get library_search_path, params: { q: "" }
+    assert_response :success
+  end
+end
diff --git a/test/controllers/security_regressions_test.rb b/test/controllers/security_regressions_test.rb
new file mode 100644
index 0000000..408c208
--- /dev/null
+++ b/test/controllers/security_regressions_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class SecurityRegressionsTest < ActionDispatch::IntegrationTest
+  test "PT01: member cannot escalate own role via profile update" do
+    sign_in :kevin
+    put user_profile_url(users(:kevin)), params: { user: { role: "administrator" } }
+    assert_not users(:kevin).reload.administrator?
+  end
+
+  test "PT01: member cannot escalate another member role via profile update" do
+    sign_in :kevin
+    put user_profile_url(users(:jz)), params: { user: { role: "administrator" } }
+    assert_response :forbidden
+    assert_not users(:jz).reload.administrator?
+  end
+
+  test "PT02: reader cannot destroy a book" do
+    sign_in :kevin
+    books(:handbook).access_for(user: users(:kevin)).update! level: :reader
+    assert_no_difference -> { Book.count } do
+      delete book_url(books(:handbook))
+    end
+    assert_response :forbidden
+  end
+
+  test "PT02: editor can still destroy a book" do
+    sign_in :kevin
+    assert_difference -> { Book.count }, -1 do
+      delete book_url(books(:handbook))
+    end
+    assert_response :redirect
+  end
+
+  test "PT05: page from an unreadable book cannot render under a readable book id" do
+    secret = books(:manual).press(Page.new(body: "SECRET CONTENT"), title: "SecretManualPage")
+    sign_in :kevin
+    # kevin cannot open manual, but CAN open handbook.
+    # URL uses handbook id but manual's page id
+    get "/#{books(:handbook).id}/handbook/#{secret.id}/secret-manual-page"
+    assert_response :not_found
+  end
+
+  test "PT05: page from a readable book remains readable under its own book id" do
+    sign_in :kevin
+    get leafable_slug_url(leaves(:welcome_page))
+    assert_response :success
+  end
+end
