diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..9ae4a87 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -13,11 +13,32 @@ module ActiveSupport
     include SessionTestHelper
 
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      app = Rails.application
+      config = app.config.action_dispatch
+      previous = config.show_exceptions
+
+      # The value that actually drives request handling is memoized in the
+      # application's env_config, keyed on `action_dispatch.show_exceptions`.
+      # Changing `config` alone is not enough (and is order-dependent, since
+      # env_config snapshots it on first use). Capture the state of that memo
+      # so we can restore it faithfully afterwards.
+      env_built = app.instance_variable_defined?(:@app_env_config)
+      previous_env = app.env_config["action_dispatch.show_exceptions"] if env_built
+
+      config.show_exceptions = :none
+      app.env_config["action_dispatch.show_exceptions"] = :none
+
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      config.show_exceptions = previous
+      if env_built
+        app.env_config["action_dispatch.show_exceptions"] = previous_env
+      elsif app.instance_variable_defined?(:@app_env_config)
+        # We built the memo for the first time inside the block, so it now
+        # holds the `:none` value. Drop it so it is rebuilt from the restored
+        # config on the next request.
+        app.remove_instance_variable(:@app_env_config)
+      end
     end
   end
 end
