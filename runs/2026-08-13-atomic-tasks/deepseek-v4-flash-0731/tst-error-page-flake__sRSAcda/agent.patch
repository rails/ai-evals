diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..8d75ee9 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -15,9 +15,23 @@ module ActiveSupport
     def with_raised_exceptions
       previous = Rails.application.config.action_dispatch.show_exceptions
       Rails.application.config.action_dispatch.show_exceptions = :none
+      reset_exceptions_app_env!
       yield
     ensure
       Rails.application.config.action_dispatch.show_exceptions = previous
+      reset_exceptions_app_env!
     end
+
+    private
+      # Rails memoizes the value of `action_dispatch.show_exceptions` into the
+      # application-level env config on the first dispatched request. Toggling
+      # the global config alone isn't enough: once memoized, the middleware keeps
+      # using the stale value regardless of what we set. Drop the memoized hash
+      # so the next request is built from the *current* config. This keeps the
+      # promise of `with_raised_exceptions` true for every caller, no matter what
+      # ran before or runs after in the same process.
+      def reset_exceptions_app_env!
+        Rails.application.instance_variable_set(:@app_env_config, nil)
+      end
   end
 end
