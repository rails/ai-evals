diff --git a/lib/rails_ext/raised_exceptions.rb b/lib/rails_ext/raised_exceptions.rb
new file mode 100644
index 0000000..aa610bd
--- /dev/null
+++ b/lib/rails_ext/raised_exceptions.rb
@@ -0,0 +1,32 @@
+# frozen_string_literal: true
+
+module Writebook
+  # Per-request override of `action_dispatch.show_exceptions` so tests can force
+  # exceptions to be raised for a single request regardless of the globally
+  # cached app `env_config`.
+  #
+  # This must run before ActionDispatch::ShowExceptions (which reads the
+  # `action_dispatch.show_exceptions` key out of the request env).
+  class RaisedExceptions
+    THREAD_KEY = :_writebook_raised_exceptions_override
+
+    def self.with_override(value)
+      previous = Thread.current[THREAD_KEY]
+      Thread.current[THREAD_KEY] = value
+      yield
+    ensure
+      Thread.current[THREAD_KEY] = previous
+    end
+
+    def initialize(app)
+      @app = app
+    end
+
+    def call(env)
+      if (override = Thread.current[THREAD_KEY])
+        env["action_dispatch.show_exceptions"] = override
+      end
+      @app.call(env)
+    end
+  end
+end
