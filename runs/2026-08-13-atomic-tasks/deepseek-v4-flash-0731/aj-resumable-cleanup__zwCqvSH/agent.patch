diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..6138d79
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveSupport::TestCase
+  test "strips only the stray outer quotes once, keeping inner quotes" do
+    plain = create_leaf("\"The Welcome Section\"")
+    quoted_opening = create_leaf("\"\"Hello\" world\"")
+    embedded = create_leaf("\"The \"Introduction\" Chapter\"")
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "The Welcome Section", plain.reload.title
+    assert_equal "\"Hello\" world", quoted_opening.reload.title
+    assert_equal "The \"Introduction\" Chapter", embedded.reload.title
+  end
+
+  test "is resumable: already-cleaned leaves are skipped, pending leaves are picked up" do
+    done = create_leaf("\"Summary\"")
+    pending = create_leaf("\"\"Part One\" - The Beginning\"")
+
+    # Simulate a first run that was interrupted after committing this leaf.
+    done.update!(title: "\"Part One\" - The Beginning", title_cleaned: true)
+
+    TitleCleanupJob.perform_now
+
+    # The completed leaf is not touched again.
+    assert_equal "\"Part One\" - The Beginning", done.reload.title
+    assert done.reload.title_cleaned?
+    # The pending leaf is cleaned exactly once.
+    assert_equal "\"Part One\" - The Beginning", pending.reload.title
+    assert pending.reload.title_cleaned?
+  end
+
+  test "is idempotent across repeated runs" do
+    leaf = create_leaf("\"The Welcome Section\"")
+    2.times { TitleCleanupJob.perform_now }
+    assert_equal "The Welcome Section", leaf.reload.title
+  end
+
+  test "re-processing an already-cleaned title is safe (keeps inner quotes)" do
+    already_clean = create_leaf("\"Hello\" world")
+    already_clean.update!(title_cleaned: false)
+
+    TitleCleanupJob.perform_now
+
+    assert_equal "\"Hello\" world", already_clean.reload.title
+  end
+
+  private
+    def create_leaf(title)
+      Leaf.create!(book: books(:handbook), title: title, leafable: Section.create!, position_score: 0, status: "active")
+    end
+end
