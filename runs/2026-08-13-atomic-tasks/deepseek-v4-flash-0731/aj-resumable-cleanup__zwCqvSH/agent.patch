--- a/app/jobs/title_cleanup_job.rb
+++ b/app/jobs/title_cleanup_job.rb
@@ -1,12 +1,20 @@
 class TitleCleanupJob < ApplicationJob
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    Leaf.where(title_cleaned: false).find_each do |leaf|
+      leaf.with_lock do
+        next if leaf.title_cleaned?
+
+        leaf.update!(title: cleaned(leaf.title), title_cleaned: true)
+      end
     end
   end
 
   private
     def cleaned(title)
-      title.delete_prefix('"').delete_suffix('"')
+      # The legacy exporter wrapped every title in quotes, so a title that
+      # still needs cleaning has both a leading and trailing quote. Only strip
+      # the wrapper when both are present: this keeps inner quotes intact and
+      # makes the transform idempotent so re-processing is safe.
+      title.start_with?('"') && title.end_with?('"') ? title.delete_prefix('"').delete_suffix('"') : title
     end
 end
