diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..48e3ce2
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  def import(book, grants)
+    Book::AccessImport.new(book, grants).import
+  end
+
+  def grant(user, level = :reader)
+    { user_id: user.id, level: level.to_s }
+  end
+
+  test "accepts a roster, creates each access and notifies every person" do
+    book = Book.create!(title: "My new book", everyone_access: false)
+    users = [ users(:david), users(:jason), users(:kevin) ]
+    grants = users.map { |u| grant(u) }
+
+    result = nil
+    assert_enqueued_jobs users.size, only: Book::AccessNotificationJob do
+      result = import(book, grants)
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal users.size, result.accesses.size
+    assert_equal users.size, book.accesses.count
+    users.each { |u| assert book.accessable?(user: u) }
+  end
+
+  test "rejects a roster naming a duplicate and notifies nobody" do
+    book = Book.create!(title: "My new book", everyone_access: false)
+    grants = [ grant(users(:david)), grant(users(:david)) ]
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = import(book, grants)
+      assert_equal 1, result.duplicate_index
+      assert_empty result.accesses
+    end
+
+    assert_equal 0, book.accesses.count
+  end
+
+  test "rejects a roster where a user already has access and notifies nobody" do
+    book = Book.create!(title: "My new book", everyone_access: false)
+    book.accesses.create!(user: users(:david), level: :reader)
+    grants = [ grant(users(:kevin)), grant(users(:david)) ]
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = import(book, grants)
+      assert_equal 1, result.duplicate_index
+      assert_empty result.accesses
+    end
+
+    assert_equal 1, book.accesses.count
+  end
+
+  test "turns down a roster with an unknown level instead of blowing up" do
+    book = Book.create!(title: "My new book", everyone_access: false)
+    grants = [ grant(users(:david)), { user_id: users(:kevin).id, level: "owner" } ]
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = import(book, grants)
+      assert_equal 1, result.duplicate_index
+      assert_empty result.accesses
+    end
+
+    assert_equal 0, book.accesses.count
+  end
+
+  test "query count does not grow with roster size" do
+    book = Book.create!(title: "My new book", everyone_access: false)
+
+    users = Array.new(10) { User.create!(name: "User#{_1}", email_address: "u#{_1}@example.com", password: "secret123456", role: "member") }
+    grants = users.map { |u| grant(u) }
+
+    queries = 0
+    counter = ->(_name, _started, _finished, _id, payload) do
+      sql = payload[:sql].to_s
+      queries += 1 if payload[:name] == "SQL" && sql !~ /\A\s*BEGIN|\A\s*COMMIT|\A\s*SAVEPOINT|\A\s*RELEASE/
+    end
+    ActiveSupport::Notifications.subscribed(counter, "sql.active_record") do
+      import(book, grants)
+    end
+    assert_operator queries, :<=, 3, "expected a constant small number of queries, got #{queries}"
+  end
+end
