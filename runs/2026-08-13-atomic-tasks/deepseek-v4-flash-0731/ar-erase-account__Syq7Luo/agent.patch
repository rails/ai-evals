diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..e04cf3c
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,40 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  DELETED_AUTHOR = "Deleted author"
+  DEACTIVATED_EMAIL_PATTERN = /-deactivated-[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}@/
+
+  def erase
+    transaction do
+      erase_sign_in_events
+      sessions.delete_all
+      accesses.delete_all
+      reading_marks.delete_all
+      dispose_of_created_books
+      destroy!
+    end
+  end
+
+  private
+    def erase_sign_in_events
+      SignInEvent.where(email_address: sign_in_email_addresses).delete_all
+    end
+
+    def sign_in_email_addresses
+      [ email_address, original_email_address ].compact.uniq
+    end
+
+    def original_email_address
+      email_address&.sub(DEACTIVATED_EMAIL_PATTERN, "@")
+    end
+
+    def dispose_of_created_books
+      created_books.find_each do |book|
+        if book.everyone_access?
+          book.update!(author: DELETED_AUTHOR, creator: nil)
+        else
+          book.destroy
+        end
+      end
+    end
+end
diff --git a/test/controllers/users_controller_test.rb b/test/controllers/users_controller_test.rb
index e0ca8db..e91dc70 100644
--- a/test/controllers/users_controller_test.rb
+++ b/test/controllers/users_controller_test.rb
@@ -78,4 +78,32 @@ class UsersControllerTest < ActionDispatch::IntegrationTest
     delete user_url(users(:david))
     assert_response :forbidden
   end
+
+  test "destroy erases an already-deactivated user via the controller" do
+    sign_in :david
+
+    user = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    user.sessions.create!(user_agent: "ua", ip_address: "1.2.3.4")
+    user.deactivate
+    assert_equal 1, SignInEvent.for_address("alice@example.com").count
+
+    assert_difference -> { User.count }, -1 do
+      delete user_url(user)
+    end
+
+    assert_redirected_to users_url
+    assert_nil User.find_by(id: user.id)
+    assert_equal 0, SignInEvent.for_address("alice@example.com").count
+  end
+
+  test "index lists deactivated users so they can be erased" do
+    sign_in :david
+
+    user = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    user.deactivate
+
+    get users_url
+    assert_response :success
+    assert_in_body user.name
+  end
 end
diff --git a/test/models/user/erasable_test.rb b/test/models/user/erasable_test.rb
new file mode 100644
index 0000000..0710e9b
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,90 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  test "erase removes the user row and all associated rows" do
+    user = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    session = user.sessions.create!(user_agent: "ua", ip_address: "1.2.3.4")
+    book = Book.create!(title: "Shared", author: "Alice", everyone_access: true)
+    book.update_access(editors: [ user.id ], readers: [])
+    reading_mark = ReadingMark.create!(user: user, leaf: leaves(:welcome_page), last_read_at: Time.now)
+    access = user.accesses.find_by(book: book)
+
+    assert_difference -> { User.count }, -1 do
+      user.erase
+    end
+
+    assert_raises(ActiveRecord::RecordNotFound) { session.reload }
+    assert_raises(ActiveRecord::RecordNotFound) { reading_mark.reload }
+    assert_raises(ActiveRecord::RecordNotFound) { access.reload }
+    assert_equal 0, SignInEvent.for_address("alice@example.com").count
+  end
+
+  test "erase keeps everyone-shared created books and bylines Deleted author" do
+    user = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    shared = Book.create!(title: "Shared", author: "Alice", everyone_access: true, creator: user)
+    shared.press Page.new(body: "Hello world"), title: "Page"
+
+    user.erase
+
+    assert_nil User.find_by(id: user.id)
+    shared.reload
+    assert_equal "Deleted author", shared.author
+    assert_nil shared.creator_id
+    assert shared.persisted?
+  end
+
+  test "erase destroys created books that are not shared with everyone" do
+    user = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    secret = Book.create!(title: "Secret", author: "Alice", everyone_access: false, creator: user)
+    secret_leaf = secret.press Page.new(body: "secret stuff"), title: "Secret Page"
+
+    user.erase
+
+    assert_raises(ActiveRecord::RecordNotFound) { secret.reload }
+    assert_raises(ActiveRecord::RecordNotFound) { secret_leaf.reload }
+  end
+
+  test "erase works for an already-deactivated user and clears sign in events under original email" do
+    user = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    user.sessions.create!(user_agent: "ua", ip_address: "1.2.3.4")
+    assert_equal 1, SignInEvent.for_address("alice@example.com").count
+
+    user.deactivate
+    assert_equal 0, user.sessions.count
+
+    # a later sign-in event under the original address must also be removed
+    SignInEvent.create!(action: :signed_in, email_address: "alice@example.com")
+    assert_equal 2, SignInEvent.for_address("alice@example.com").count
+
+    user.erase
+
+    assert_nil User.find_by(id: user.id)
+    assert_equal 0, SignInEvent.for_address("alice@example.com").count
+  end
+
+  test "erase removes non-shared created book content from the search index" do
+    Leaf.reindex_all
+    user = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    secret = Book.create!(title: "Secret", author: "Alice", everyone_access: false, creator: user)
+    leaf = secret.press Page.new(body: "uniqueerasuresecret content"), title: "Secret Page"
+    leaf.reindex
+
+    assert_includes Leaf.search("uniqueerasuresecret"), leaf
+
+    user.erase
+
+    assert_empty Leaf.search("uniqueerasuresecret")
+  end
+
+  test "erase keeps everyone-shared created book searchable" do
+    Leaf.reindex_all
+    user = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    shared = Book.create!(title: "Shared", author: "Alice", everyone_access: true, creator: user)
+    leaf = shared.press Page.new(body: "keptsharedcontent remains"), title: "Shared Page"
+    leaf.reindex
+
+    user.erase
+
+    assert_includes Leaf.search("keptsharedcontent"), leaf.reload
+  end
+end
