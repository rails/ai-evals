diff --git a/test/controllers/action_text/markdown/uploads_controller_test.rb b/test/controllers/action_text/markdown/uploads_controller_test.rb
index 48141c1..eefa9a8 100644
--- a/test/controllers/action_text/markdown/uploads_controller_test.rb
+++ b/test/controllers/action_text/markdown/uploads_controller_test.rb
@@ -31,4 +31,18 @@ class ActionText::Markdown::UploadsControllerTest < ActionDispatch::IntegrationT
     assert_response :redirect
     assert_match /\/rails\/active_storage\/.*\/reading\.webp/, @response.redirect_url
   end
+
+  test "destroying a page purges the files and records backing its inline images" do
+    markdown = pages(:welcome).body.tap(&:save!)
+    markdown.uploads.attach fixture_file_upload("reading.webp", "image/webp")
+
+    blob = pages(:welcome).body.uploads.blobs.first
+    assert ActiveStorage::Blob.service.exist?(blob.key)
+
+    pages(:welcome).leaf.destroy!
+    perform_enqueued_jobs
+
+    assert_nil ActiveStorage::Blob.find_by(id: blob.id)
+    refute ActiveStorage::Blob.service.exist?(blob.key)
+  end
 end
