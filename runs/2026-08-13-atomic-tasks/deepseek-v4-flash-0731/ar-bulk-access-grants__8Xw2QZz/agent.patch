diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..9c24bf7
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    ActiveJob::Base.queue_adapter = :test
+    @book = books(:manual)  # manual has david/jason/jz, not kevin
+    @book.update!(everyone_access: false)
+  end
+
+  test "imports valid grants and notifies each person" do
+    user1 = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    user2 = User.create!(name: "Bob", email_address: "bob@example.com", password: "secret123456")
+
+    grants = [
+      { user_id: user1.id, level: "reader" },
+      { user_id: user2.id, level: "editor" }
+    ]
+
+    result = nil
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal 2, result.accesses.size
+    assert_equal [ "reader", "editor" ], result.accesses.map(&:level)
+    assert_equal 2, @book.accesses.where(user_id: [ user1.id, user2.id ]).count
+  end
+
+  test "rejected duplicate roster does not notify anyone" do
+    # kevin is valid on manual (index 0); david already has editor on manual (duplicate, index 1)
+    grants = [
+      { user_id: users(:kevin).id, level: "reader" },
+      { user_id: users(:david).id, level: "reader" }
+    ]
+
+    manual_before = @book.accesses.count
+
+    result = nil
+    assert_enqueued_jobs 0, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal manual_before, @book.accesses.count  # nothing added
+  end
+
+  test "invalid level is turned down, not raised" do
+    user = User.create!(name: "Carol", email_address: "carol@example.com", password: "secret123456")
+    grants = [
+      { user_id: user.id, level: "reader" },
+      { user_id: users(:david).id, level: "superadmin" }
+    ]
+
+    result = nil
+    assert_nothing_raised do
+      assert_enqueued_jobs 0, only: Book::AccessNotificationJob do
+        result = Book::AccessImport.new(@book, grants).import
+      end
+    end
+
+    assert_not_nil result.duplicate_index
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal 0, @book.accesses.where(user_id: user.id).count
+  end
+
+  test "accepts symbol levels" do
+    user = User.create!(name: "Dan", email_address: "dan@example.com", password: "secret123456")
+
+    result = Book::AccessImport.new(@book, [ { user_id: user.id, level: :reader } ]).import
+
+    assert_nil result.duplicate_index
+    assert_equal 1, result.accesses.size
+    assert_equal "reader", result.accesses.first.level
+  end
+
+  test "rejects duplicate row within the roster" do
+    user = User.create!(name: "Eve", email_address: "eve@example.com", password: "secret123456")
+    grants = [
+      { user_id: user.id, level: "reader" },
+      { user_id: user.id, level: "editor" }
+    ]
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_equal 1, result.duplicate_index
+    assert_empty result.accesses
+    assert_equal 0, @book.accesses.where(user_id: user.id).count
+  end
+end
