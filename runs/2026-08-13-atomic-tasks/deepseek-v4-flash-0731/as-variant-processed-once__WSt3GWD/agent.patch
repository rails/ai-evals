diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
index 675541b..4c33b87 100644
--- a/config/initializers/active_storage.rb
+++ b/config/initializers/active_storage.rb
@@ -1,5 +1,60 @@
+require "json"
+
 ActiveSupport.on_load(:active_storage_blob) do
   ActiveStorage::DiskController.after_action only: :show do
     expires_in 1.year, public: true
   end
 end
+
+# === One derived copy per image variant ===
+#
+# A Picture's named variant (`:large`) uses `process: :later`, so uploading a
+# photograph derives the copy in a background job. A reader's browser then
+# fetches the picture through a signed URL whose variation key is produced by
+# `ActiveStorage::Variation#key`. That key round-trips the transformations
+# through a JSON-serializing verifier, which turns symbol values into strings
+# and does not preserve the original hash key order.
+#
+# ActiveStorage keys each derived copy by `ActiveStorage::Variation#digest`,
+# which was previously `OpenSSL::SHA1(Marshal.dump(transformations))`. Because
+# `Marshal.dump` is sensitive to both key ordering and the symbol/string
+# identity (and even string encoding) of values, the upload background job and
+# the on-demand representations controller computed two *different* digests
+# for the same logical transformations. Each digest got its own VariantRecord
+# and stored file, so the first reader to open the book created a second
+# derived copy that was then kept forever.
+#
+# The fix makes the digest canonical: transformations are normalized (keys
+# sorted and stringified, symbols converted to strings) and serialized with
+# JSON, which is order- and encoding-stable. Any code path -- the upload
+# background job or a reader's on-demand fetch -- now resolves the same
+# logical transformations to a single, shared derived copy. Once the
+# background work has run, a reader simply retrieves that existing copy
+# instead of deriving a duplicate.
+Rails.application.config.after_initialize do
+  ActiveStorage::Variation # ensure the real (autoloaded) class is loaded first
+
+  ActiveStorage::Variation.class_eval do
+    def digest
+      OpenSSL::Digest::SHA1.base64digest canonical_json(transformations)
+    end
+
+    private
+      def canonical_json(value)
+        canonicalize(value).to_json
+      end
+
+      def canonicalize(value)
+        case value
+        when Hash
+          value.map { |key, val| [ canonicalize(key), canonicalize(val) ] }.sort.to_h
+        when Array
+          value.map { |item| canonicalize(item) }
+        when Symbol
+          value.to_s
+        else
+          value
+        end
+      end
+  end
+end
diff --git a/test/models/picture_test.rb b/test/models/picture_test.rb
index 18a2a56..821aabc 100644
--- a/test/models/picture_test.rb
+++ b/test/models/picture_test.rb
@@ -23,4 +23,73 @@ class PictureTest < ActiveSupport::TestCase
 
     assert_equal picture.image, picture.large_image
   end
+
+  test "an upload is derived exactly once even after a reader fetches it" do
+    picture = build_picture_with_image
+    blob = picture.image.blob
+    transformations = picture.attachment_reflections["image"].named_variants[:large].transformations
+
+    # Background work (the "process: :later" job) derives the copy.
+    ActiveStorage::TransformJob.perform_now(blob, transformations)
+    assert_equal 1, blob.variant_records.count
+
+    # A reader then opens the book page and fetches the picture's signed URL.
+    fetch_via_representations_controller(picture)
+
+    assert_equal 1, blob.variant_records.count,
+      "the reader's fetch should reuse the derived copy instead of creating a second one"
+    assert_equal 1, derived_file_keys(blob).uniq.size
+  end
+
+  test "a first reader fetch does not create a second copy when the background job runs later" do
+    picture = build_picture_with_image
+    blob = picture.image.blob
+    transformations = picture.attachment_reflections["image"].named_variants[:large].transformations
+
+    # Reader races ahead of the background job.
+    fetch_via_representations_controller(picture)
+    assert_equal 1, blob.variant_records.count
+
+    # The background job catches up and must reuse the same derived copy.
+    ActiveStorage::TransformJob.perform_now(blob, transformations)
+    assert_equal 1, blob.variant_records.count
+    assert_equal 1, derived_file_keys(blob).uniq.size
+  end
+
+  test "the derived copy a reader is served is byte-identical to the background job's copy" do
+    picture = build_picture_with_image
+    blob = picture.image.blob
+    transformations = picture.attachment_reflections["image"].named_variants[:large].transformations
+
+    ActiveStorage::TransformJob.perform_now(blob, transformations)
+    background_bytes = blob.variant_records.first.image.blob.download
+
+    fetch_via_representations_controller(picture)
+    reader_bytes = blob.variant_records.first.image.blob.download
+
+    assert_equal background_bytes, reader_bytes,
+      "a reader should be served the exact same derived file the background job produced"
+  end
+
+  private
+    def build_picture_with_image
+      Picture.new(caption: "A photo").tap do |picture|
+        picture.image.attach io: file_fixture("reading.webp").open,
+          filename: "reading.webp", content_type: "image/webp"
+        picture.save!
+      end
+    end
+
+    # Simulate a reader's browser requesting the signed representation URL, which
+    # is what the representations controller ultimately processes.
+    def fetch_via_representations_controller(picture)
+      representation = picture.large_image
+      url = Rails.application.routes.url_helpers.rails_representation_path(representation, only_path: true)
+      variation_key = url.split("/")[-2]
+      representation.blob.representation(variation_key).processed
+    end
+
+    def derived_file_keys(blob)
+      blob.variant_records.map { |vr| vr.image.attached? ? vr.image.blob.key : nil }
+    end
 end
