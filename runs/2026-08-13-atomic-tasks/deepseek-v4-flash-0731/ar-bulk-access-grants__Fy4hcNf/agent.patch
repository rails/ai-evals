@@ -0,0 +1,22 @@
+require "test_helper"
+
+class Book::AccessNotificationJobTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "a single enqueued job notifies every newly granted access" do
+    book = Book.create!(title: "Job book", everyone_access: false)
+    a = User.create!(name: "A", email_address: "aj@example.com", password: "secret123456")
+    b = User.create!(name: "B", email_address: "bj@example.com", password: "secret123456")
+
+    assert_enqueued_jobs 1, only: Book::AccessNotificationJob do
+      Book::AccessImport.new(book, [
+        { user_id: a.id, level: "reader" },
+        { user_id: b.id, level: "editor" },
+      ]).import
+    end
+
+    assert_performed_jobs 1, only: Book::AccessNotificationJob do
+      perform_enqueued_jobs only: Book::AccessNotificationJob
+    end
+  end
+end
diff --git a/test/models/book/access_import_scale_test.rb b/test/models/book/access_import_scale_test.rb
new file mode 100644
index 0000000..e94d1e1
--- /dev/null
+++ b/test/models/book/access_import_scale_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Book::AccessImportScaleTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  def inserts_for
+    inserts = 0
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*args|
+      payload = args.last
+      inserts += 1 if payload[:sql].match?(/\AINSERT/i)
+    end
+    yield
+    inserts
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber)
+  end
+
+  test "insert count does not grow with roster size" do
+    small = Book.create!(title: "small", everyone_access: false)
+    big = Book.create!(title: "big", everyone_access: false)
+    small_users = 4.times.map { |i| User.create!(name: "s#{i}", email_address: "s#{i}_#{SecureRandom.hex(4)}@e.com", password: "secret123456") }
+    big_users = 16.times.map { |i| User.create!(name: "b#{i}", email_address: "b#{i}_#{SecureRandom.hex(4)}@e.com", password: "secret123456") }
+
+    small_inserts = inserts_for do
+      Book::AccessImport.new(small, small_users.map { |u| { user_id: u.id, level: "reader" } }).import
+    end
+    big_inserts = inserts_for do
+      Book::AccessImport.new(big, big_users.map { |u| { user_id: u.id, level: "reader" } }).import
+    end
+
+    assert_equal 1, small_inserts
+    assert_equal 1, big_inserts
+  end
+
+  test "a rejected roster performs no inserts and notify nobody" do
+    book = Book.create!(title: "reject", everyone_access: false)
+    a = User.create!(name: "A", email_address: "ra_#{SecureRandom.hex(4)}@e.com", password: "secret123456")
+    grants = [ { user_id: a.id, level: "nope" } ]
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      insert_count = inserts_for do
+        result = Book::AccessImport.new(book, grants).import
+        assert_equal 0, result.duplicate_index
+        assert_equal [], result.accesses
+      end
+      assert_equal 0, insert_count
+    end
+  end
+end
diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..1be6f1c
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  def make_book
+    Book.create!(title: "Fresh book #{SecureRandom.hex(4)}", everyone_access: false)
+  end
+
+  def make_user(name)
+    User.create!(name: name, email_address: "#{name}#{SecureRandom.hex(4)}@example.com", password: "secret123456")
+  end
+
+  test "adds all grants and returns created accesses" do
+    book = make_book
+    a = make_user("A")
+    b = make_user("B")
+    grants = [
+      { user_id: a.id, level: "editor" },
+      { user_id: b.id, level: "reader" },
+    ]
+
+    result = Book::AccessImport.new(book, grants).import
+
+    assert_nil result.duplicate_index
+    assert_equal 2, result.accesses.length
+    result.accesses.each do |access|
+      assert access.persisted?
+      assert_equal book.id, access.book_id
+    end
+    assert_equal %w[editor reader].sort, result.accesses.map(&:level).sort
+    assert_equal 2, book.accesses.count
+  end
+
+  test "rejects roster when a user already has access and notifies nobody" do
+    book = make_book
+    a = make_user("A")
+    b = make_user("B")
+    book.accesses.create!(user: a, level: "editor")
+    grants = [
+      { user_id: a.id, level: "reader" },
+      { user_id: b.id, level: "reader" },
+    ]
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, grants).import
+      assert_equal 0, result.duplicate_index
+      assert_equal [], result.accesses
+      assert_equal 0, book.accesses.where(user_id: b.id).count
+    end
+  end
+
+  test "rejects roster on a duplicate row within the sheet and notifies nobody" do
+    book = make_book
+    a = make_user("A")
+    grants = [
+      { user_id: a.id, level: "reader" },
+      { user_id: a.id, level: "editor" },
+    ]
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, grants).import
+      assert_equal 1, result.duplicate_index
+      assert_equal [], result.accesses
+      assert_equal 0, book.accesses.count
+    end
+  end
+
+  test "rejects roster with unknown level and notifies nobody" do
+    book = make_book
+    a = make_user("A")
+    b = make_user("B")
+    grants = [
+      { user_id: a.id, level: "admin" },
+      { user_id: b.id, level: "reader" },
+    ]
+
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(book, grants).import
+      assert_equal 0, result.duplicate_index
+      assert_equal [], result.accesses
+      assert_equal 0, book.accesses.count
+    end
+  end
+
+  test "a bad row later in the sheet turns down the whole roster" do
+    book = make_book
+    a = make_user("A")
+    b = make_user("B")
+    grants = [
+      { user_id: a.id, level: "reader" },
+      { user_id: b.id, level: "bogus" },
+    ]
+
+    result = Book::AccessImport.new(book, grants).import
+
+    assert_equal 1, result.duplicate_index
+    assert_equal [], result.accesses
+    assert_equal 0, book.accesses.count
+  end
+
+  test "enqueues exactly one notification job covering all new accesses on success" do
+    book = make_book
+    a = make_user("A")
+    b = make_user("B")
+    grants = [
+      { user_id: a.id, level: "reader" },
+      { user_id: b.id, level: "editor" },
+    ]
+
+    assert_enqueued_jobs 1, only: Book::AccessNotificationJob do
+      Book::AccessImport.new(book, grants).import
+    end
+  end
+end
