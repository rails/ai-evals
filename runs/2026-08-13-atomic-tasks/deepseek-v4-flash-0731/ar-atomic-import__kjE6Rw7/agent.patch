diff --git a/app/models/concerns/batched.rb b/app/models/concerns/batched.rb
index 55a53e7..4139622 100644
--- a/app/models/concerns/batched.rb
+++ b/app/models/concerns/batched.rb
@@ -6,7 +6,12 @@ module Batched
     # lands or none of it does. The manifest importer goes through here so
     # that a rejected manifest leaves the book exactly as it was before the
     # attempt.
+    #
+    # A nested transaction (savepoint) is used so that, when the importer runs
+    # inside another transaction (e.g. the nightly bulk importer), a rejected
+    # manifest rolls back only its own work and leaves the surrounding
+    # transaction's other work intact.
     def as_one_batch(&block)
-      self.class.transaction(&block)
+      self.class.transaction(requires_new: true, &block)
     end
 end
diff --git a/test/models/book_import_test.rb b/test/models/book_import_test.rb
new file mode 100644
index 0000000..fdf5180
--- /dev/null
+++ b/test/models/book_import_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class BookImportTest < ActiveSupport::TestCase
+  test "invalid entry partway through imports nothing" do
+    book = Book.create!(title: "Book")
+    entries = [
+      { title: "One", body: "body one" },
+      { title: nil, body: "bad" },  # invalid
+      { title: "Three", body: "body three" }
+    ]
+    result = book.import_manifest(entries)
+    assert_not result, "expected falsy return from import"
+    assert_equal 0, book.leaves.count, "expected no leaves to remain"
+  end
+
+  test "invalid entry at the start imports nothing" do
+    book = Book.create!(title: "Book")
+    entries = [
+      { title: "One", body: "" }, # invalid (empty body)
+      { title: "Two", body: "two" }
+    ]
+    result = book.import_manifest(entries)
+    assert_not result
+    assert_equal 0, book.leaves.count
+  end
+
+  test "duplicate title is a rejection, not a crash" do
+    book = Book.create!(title: "Book")
+    book.import_manifest([ { title: "One", body: "one" } ])
+    assert_equal 1, book.leaves.count
+    result = book.import_manifest([ { title: "One", body: "another" } ])
+    assert_not result, "expected falsy return for duplicate"
+    assert_equal 1, book.leaves.count, "duplicate should not add a leaf"
+  end
+
+  test "duplicate title within one manifest imports nothing" do
+    book = Book.create!(title: "Book")
+    entries = [
+      { title: "One", body: "one" },
+      { title: "Two", body: "two" },
+      { title: "One", body: "duplicate" }
+    ]
+    result = book.import_manifest(entries)
+    assert_not result
+    assert_equal 0, book.leaves.count
+  end
+
+  test "valid manifest imports all in order" do
+    book = Book.create!(title: "Book")
+    entries = [
+      { title: "One", body: "one" },
+      { title: "Two", body: "two" },
+      { title: "Three", body: "three" }
+    ]
+    assert book.import_manifest(entries)
+    assert_equal %w[One Two Three], book.leaves.active.positioned.pluck(:title)
+  end
+
+  test "rejected manifest leaves nothing of itself behind inside bulk import, other work survives" do
+    book = Book.create!(title: "Book")
+
+    good_entries = [
+      { title: "Good One", body: "g1" },
+      { title: "Good Two", body: "g2" }
+    ]
+    bad_entries = [
+      { title: "Bad One", body: "b1" },
+      { title: nil, body: "bad" },
+      { title: "Bad Three", body: "b3" }
+    ]
+
+    imported, rejected = [], []
+    Book.transaction do
+      result = book.import_manifest(good_entries)
+      imported << result
+      rejected << book.import_manifest(bad_entries)
+    end
+
+    assert_equal [ true, false ], imported + [ rejected[0] ? nil : false ], "good should import, bad should reject"
+    assert_equal %w[Good\ One Good\ Two], book.leaves.active.positioned.pluck(:title), "only good work should remain"
+  end
+end
diff --git a/test/models/bulk_import_test.rb b/test/models/bulk_import_test.rb
new file mode 100644
index 0000000..45af345
--- /dev/null
+++ b/test/models/bulk_import_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class BulkImportTest < ActiveSupport::TestCase
+  test "rejected manifest leaves nothing of itself, other manifests survive" do
+    book_a = Book.create!(title: "A")
+    book_b = Book.create!(title: "B")
+
+    result = BulkImport.new(
+      book_a => [
+        { title: "Good One", body: "g1" },
+        { title: "Good Two", body: "g2" }
+      ],
+      book_b => [
+        { title: "Bad", body: "" },      # invalid
+        { title: "Also Bad", body: "x" }
+      ]
+    ).run
+
+    assert_equal [ book_a ], result.imported
+    assert_equal [ book_b ], result.rejected
+
+    book_a.reload
+    book_b.reload
+    assert_equal %w[Good\ One Good\ Two], book_a.leaves.active.positioned.pluck(:title)
+    assert_equal 0, book_b.leaves.count
+  end
+
+  test "rejection of one book does not roll back another book's import" do
+    book_a = Book.create!(title: "A")
+    book_b = Book.create!(title: "B")
+
+    result = BulkImport.new(
+      book_a => [ { title: "Keep Me", body: "x" } ],
+      book_b => [ { title: nil, body: "bad" } ]
+    ).run
+
+    assert_equal [ book_a ], result.imported
+    assert_equal [ book_b ], result.rejected
+    book_a.reload
+    assert_equal %w[Keep\ Me], book_a.leaves.active.positioned.pluck(:title)
+  end
+end
