@@ -26,6 +26,30 @@ class SessionsController < ApplicationController
       redirect_to first_run_url if User.none?
     end
 
+    def safe_return_to
+      return post_authenticating_url if params[:return_to].blank?
+
+      uri = URI.parse(params[:return_to])
+
+      # Allow only local destinations: a same-host absolute URL or a rooted,
+      # non-protocol-relative path. Anything else falls back to the default.
+      if same_host?(uri) || rooted_local_path?(params[:return_to], uri)
+        params[:return_to]
+      else
+        post_authenticating_url
+      end
+    rescue URI::InvalidURIError
+      post_authenticating_url
+    end
+
+    def same_host?(uri)
+      uri.absolute? && uri.host.present? && uri.host == request.host
+    end
+
+    def rooted_local_path?(raw_url, uri)
+      uri.relative? && raw_url.start_with?("/") && !raw_url.start_with?("//")
+    end
+
     def render_rejection(status)
       flash[:alert] = "Too many requests or unauthorized."
       render :new, status: status
