+# Mirror the report to the terminal while still recording every line in the
+# environment's log file (which is what our log tooling reads). The broadcast
+# keeps the existing file sink untouched and simply adds STDOUT as another one.
+# The report is logged at info/warn, so we raise the STDOUT sink's level to
+# INFO to keep the terminal free of debug-level (e.g. SQL) noise.
+require "active_support/broadcast_logger"
+require "active_support/logger"
+
+unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, $stdout)
+  stdout_logger = ActiveSupport::Logger.new($stdout)
+  stdout_logger.formatter = ActiveSupport::Logger::SimpleFormatter.new
+  stdout_logger.level = Logger::INFO
+
+  if Rails.logger.respond_to?(:broadcast_to)
+    Rails.logger.broadcast_to(stdout_logger)
+  else
+    Rails.logger = ActiveSupport::BroadcastLogger.new(Rails.logger, stdout_logger)
+  end
+end
+
 books = Book.order(:id).to_a
 
 Rails.logger.info "Library report: #{books.size} books"
