diff --git a/test/models/book_announceable_test.rb b/test/models/book_announceable_test.rb
new file mode 100644
index 0000000..08c6765
--- /dev/null
+++ b/test/models/book_announceable_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class BookAnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "publishing a book while adding a page announces exactly once" do
+    @book = books(:manual)
+
+    assert_enqueued_with(job: AnnouncePublicationJob, args: [ @book ]) do
+      @book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), title: "New page"
+      end
+    end
+  end
+
+  test "unpublishing a live book does not announce" do
+    @book = books(:manual)
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "saving an already-live book does not announce again" do
+    @book = books(:manual)
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! slug: "still-live"
+    end
+  end
+
+  test "saving a draft book does not announce" do
+    @book = books(:manual)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! slug: "still-draft"
+    end
+  end
+
+  test "a failing sitting that marked the book live leaves a draft and does not announce" do
+    @book = books(:manual)
+
+    assert_raises(RuntimeError) do
+      @book.transaction do
+        @book.update! published: true
+        raise "boom"
+      end
+    end
+
+    @book.reload
+    assert_not @book.published?
+    assert_no_enqueued_jobs only: AnnouncePublicationJob
+  end
+end
