+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  test "compact_positions! preserves hand-arranged order, not creation order" do
+    book = Book.create!(title: "Handbook")
+    first  = book.press Page.new(body: "one"),   title: "one"
+    second = book.press Page.new(body: "two"),   title: "two"
+    third  = book.press Page.new(body: "three"), title: "three"
+
+    # Hand-arrange so desired order differs from creation order.
+    third.update!(position_score: 1.0)
+    first.update!(position_score: 2.0)
+    second.update!(position_score: 3.0)
+
+    book.compact_positions!
+
+    order = book.leaves.active.order(:position_score, :id).pluck(:id)
+    assert_equal [third.id, first.id, second.id], order
+    assert_equal [1, 2, 3], book.leaves.active.order(:position_score, :id).pluck(:position_score)
+  end
+
+  test "compact_positions! keeps trashed leaves in place so active ones stay in relative order" do
+    book = Book.create!(title: "Handbook")
+    first  = book.press Page.new(body: "one"),   title: "one"
+    second = book.press Page.new(body: "two"),   title: "two"
+    third  = book.press Page.new(body: "three"), title: "three"
+
+    second.trashed!
+
+    book.compact_positions!
+
+    assert_equal [first.id, third.id], book.leaves.active.order(:position_score, :id).pluck(:id)
+  end
+
+  test "live_leaf_count returns number of non-trashed leaves" do
+    book = Book.create!(title: "Handbook")
+    book.press Page.new(body: "one"),   title: "one"
+    trashed = book.press Page.new(body: "two"),   title: "two"
+    book.press Page.new(body: "three"), title: "three"
+
+    assert_equal 3, book.live_leaf_count
+
+    trashed.trashed!
+    assert_equal 2, book.live_leaf_count
+  end
+end
