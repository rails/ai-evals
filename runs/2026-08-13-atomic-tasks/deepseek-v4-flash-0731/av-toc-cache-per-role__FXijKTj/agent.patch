diff --git a/test/controllers/book_caching_test.rb b/test/controllers/book_caching_test.rb
new file mode 100644
index 0000000..15850cd
--- /dev/null
+++ b/test/controllers/book_caching_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class BookCachingTest < ActionDispatch::IntegrationTest
+  setup do
+    @store = ActiveSupport::Cache::MemoryStore.new
+    ActionController::Base.cache_store = [@store]
+    ActionView::PartialRenderer.collection_cache = @store
+    ActionController::Base.perform_caching = true
+  end
+
+  teardown do
+    ActionController::Base.perform_caching = false
+  end
+
+  test "reader does not get editor controls even if editor loaded first" do
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_in_body 'for-screen-reader">Move Welcome to The Handbook'
+    assert_in_body 'leaf__delete'
+
+    sign_out
+    sign_in :jz
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_not_in_body 'for-screen-reader">Move '
+    assert_not_in_body 'leaf__delete'
+    # reader still sees the entry title
+    assert_in_body 'Welcome to The Handbook'
+  end
+
+  test "editor always gets editor controls even if reader loaded first" do
+    sign_in :jz
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_not_in_body 'for-screen-reader">Move '
+
+    sign_out
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_in_body 'for-screen-reader">Move Welcome to The Handbook'
+    assert_in_body 'leaf__delete'
+    assert_in_body 'for-screen-reader">Edit Welcome to The Handbook'
+  end
+
+  test "renamed entry shows new title to next person" do
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: "Brand New Entry Title")
+
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_in_body "Brand New Entry Title"
+  end
+end
