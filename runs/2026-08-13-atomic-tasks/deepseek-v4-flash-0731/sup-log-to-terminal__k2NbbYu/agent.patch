+# Mirror the report to the terminal as well as the environment's log file.
+#
+# Rails.logger is an ActiveSupport::BroadcastLogger whose single broadcast writes
+# to the environment log (e.g. log/development.log). Add STDOUT as an additional
+# broadcast so the runbook actually sees the report on screen, while every line
+# is still recorded in the log file for our log tooling.
+#
+# The STDOUT broadcast only surfaces the report lines (rather than every SQL log
+# line too), using the same simple formatter so the wording matches the log.
+class LibraryReportFormatter < ActiveSupport::Logger::SimpleFormatter
+  def call(severity, timestamp, progname, msg)
+    message = msg2str(msg)
+    return "" unless message.start_with?("Library report:")
+    super
+  end
+end
+
+stdout_logger = ActiveSupport::Logger.new($stdout)
+stdout_logger.formatter = LibraryReportFormatter.new
+Rails.logger.broadcast_to(stdout_logger)
+
 books = Book.order(:id).to_a
 
 Rails.logger.info "Library report: #{books.size} books"
