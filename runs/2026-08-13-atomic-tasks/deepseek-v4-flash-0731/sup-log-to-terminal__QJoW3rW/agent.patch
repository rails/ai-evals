@@ -1,3 +1,22 @@
+# Mirror the report to the terminal (stdout) while keeping every line recorded
+# in the environment's log file (e.g. log/development.log), which is what the
+# log tooling reads. The report itself is unchanged.
+class LibraryReportStdoutLogger < ActiveSupport::Logger
+  def add(severity, message = nil, progname = nil, &block)
+    if progname.nil?
+      progname = @progname
+    end
+    if message.nil?
+      message = block ? block.call : progname
+      progname = @progname
+    end
+    return true unless message.to_s.start_with?("Library report:")
+    super(severity, message, progname)
+  end
+end
+
+Rails.logger.broadcast_to(LibraryReportStdoutLogger.new($stdout))
+
 books = Book.order(:id).to_a
 
 Rails.logger.info "Library report: #{books.size} books"
