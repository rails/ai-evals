+
+class UserLibraryDigestTest < ActiveSupport::TestCase
+  setup do
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  teardown do
+    Rails.cache = @original_cache
+  end
+
+  test "library_digest is scoped per user so users never see each other's books" do
+    book_a = Book.create!(title: "Alice-only", slug: "alice-only", everyone_access: false)
+    book_b = Book.create!(title: "Bob-only",   slug: "bob-only",   everyone_access: false)
+
+    alice = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    bob   = User.create!(name: "Bob",   email_address: "bob@example.com",   password: "secret123456")
+
+    book_a.accesses.create!(user: alice, level: :reader)
+    book_b.accesses.create!(user: bob, level: :reader)
+
+    # Prime the cache with Alice's overview first.
+    alice_digest = alice.library_digest
+    assert_includes alice_digest.map { |d| d[:title] }, "Alice-only"
+    refute_includes alice_digest.map { |d| d[:title] }, "Bob-only"
+
+    # Bob must only ever see his own books, regardless of who went first.
+    bob_digest = bob.library_digest
+    bob_titles = bob_digest.map { |d| d[:title] }
+    assert_includes bob_titles, "Bob-only"
+    refute_includes bob_titles, "Alice-only"
+  end
+
+  test "library_digest keeps shape and caches per user" do
+    book = Book.create!(title: "Carol-only", slug: "carol-only", everyone_access: false)
+    user = User.create!(name: "Carol", email_address: "carol@example.com", password: "secret123456")
+    book.accesses.create!(user: user, level: :reader)
+
+    digest = user.library_digest
+    assert_includes digest.map { |d| d[:title] }, "Carol-only"
+    digest.each do |entry|
+      assert_equal [:id, :leaf_count, :title], entry.keys.sort
+      assert Integer === entry[:leaf_count]
+    end
+
+    # Asking twice must not build it twice (second call is a cache hit).
+    assert_equal digest, user.library_digest
+  end
+end
