@@ -0,0 +1,24 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, null: true, foreign_key: true
+    add_reference :books, :tenant, null: true, foreign_key: true
+
+    reversible do |dir|
+      dir.up do
+        # Sweep existing users and books into a single tenant so running
+        # installs upgrade in place.
+        if User.any? || Book.any?
+          tenant = Tenant.create!(name: "Default")
+          User.update_all(tenant_id: tenant.id)
+          Book.update_all(tenant_id: tenant.id)
+        end
+      end
+    end
+  end
+end
