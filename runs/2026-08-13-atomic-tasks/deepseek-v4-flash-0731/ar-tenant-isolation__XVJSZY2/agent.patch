diff --git a/test/controllers/book_tenant_integration_test.rb b/test/controllers/book_tenant_integration_test.rb
new file mode 100644
index 0000000..433633e
--- /dev/null
+++ b/test/controllers/book_tenant_integration_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class BookTenantIntegrationTest < ActionDispatch::IntegrationTest
+  setup do
+    @acme = Tenant.create!(name: "Acme")
+    @globex = Tenant.create!(name: "Globex")
+  end
+
+  test "new books land in their creator's tenant" do
+    alice = User.create!(name: "Alice", email_address: "alice@acme.com", password: "secret123456", tenant: @acme)
+    post session_url, params: { email_address: "alice@acme.com", password: "secret123456" }
+
+    assert_difference -> { Book.count }, +1 do
+      post books_url, params: { book: { title: "Alice's Book", everyone_access: false } }
+    end
+
+    assert_equal @acme, Book.last.tenant
+  end
+
+  test "other tenants' books and their edit histories are 404 but the user stays signed in" do
+    alice = User.create!(name: "Alice", email_address: "alice@acme.com", password: "secret123456", tenant: @acme)
+    bob = User.create!(name: "Bob", email_address: "bob@globex.com", password: "secret123456", tenant: @globex)
+
+    secret_book = Book.create!(title: "Secret Book", tenant: @globex, everyone_access: true, published: true)
+    leaf = secret_book.press Page.new(body: "Secret"), title: "Secret Page"
+    leaf.edit leafable_params: { body: "Secret edited" }
+
+    post session_url, params: { email_address: "alice@acme.com", password: "secret123456" }
+
+    # Library hides the other tenant's published book
+    get root_url
+    assert_response :success
+    assert_not_includes response.body, "Secret Book"
+
+    # Book itself is 404
+    get book_slug_url(secret_book)
+    assert_response :not_found
+
+    # Edit history of its pages is 404
+    get page_edit_url(leaf, leaf.edits.last)
+    assert_response :not_found
+
+    # Still signed in
+    get root_url
+    assert_response :success
+  end
+
+  test "signed-out visitors still see every published book regardless of tenant" do
+    Book.create!(title: "Acme Published", tenant: @acme, published: true, everyone_access: true)
+    Book.create!(title: "Globex Published", tenant: @globex, published: true, everyone_access: true)
+
+    get root_url
+    assert_response :success
+    assert_includes response.body, "Acme Published"
+    assert_includes response.body, "Globex Published"
+  end
+end
diff --git a/test/models/book/tenant_test.rb b/test/models/book/tenant_test.rb
new file mode 100644
index 0000000..ff22747
--- /dev/null
+++ b/test/models/book/tenant_test.rb
@@ -0,0 +1,46 @@
+require "test_helper"
+
+class Book::TenantTest < ActiveSupport::TestCase
+  test "new books without a creator stay tenantless" do
+    book = Book.create!(title: "Lonely")
+    assert_nil book.tenant
+  end
+
+  test "books in one tenant are invisible to another tenant's users" do
+    acme = Tenant.create!(name: "Acme")
+    globex = Tenant.create!(name: "Globex")
+
+    alice = User.create!(name: "Alice", email_address: "alice@acme.com", password: "secret123456", tenant: acme)
+    bob = User.create!(name: "Bob", email_address: "bob@globex.com", password: "secret123456", tenant: globex)
+
+    acme_book = Book.create!(title: "Acme Book", tenant: acme, everyone_access: true, published: true)
+    globex_book = Book.create!(title: "Globex Book", tenant: globex, everyone_access: true, published: true)
+
+    assert_includes Book.accessable_or_published(user: alice), acme_book
+    assert_not_includes Book.accessable_or_published(user: alice), globex_book
+
+    assert_includes Book.accessable_or_published(user: bob), globex_book
+    assert_not_includes Book.accessable_or_published(user: bob), acme_book
+  end
+
+  test "sharing with everyone only sprays reader rows within the book's tenant" do
+    acme = Tenant.create!(name: "Acme")
+    globex = Tenant.create!(name: "Globex")
+
+    alice = User.create!(name: "Alice", email_address: "alice2@acme.com", password: "secret123456", tenant: acme)
+    bob = User.create!(name: "Bob", email_address: "bob2@globex.com", password: "secret123456", tenant: globex)
+
+    acme_book = Book.create!(title: "Acme Shared", tenant: acme, everyone_access: true)
+    globex_book = Book.create!(title: "Globex Shared", tenant: globex, everyone_access: true)
+
+    # A new acme user only gets reader rows for acme's everyone books
+    carol = User.create!(name: "Carol", email_address: "carol@acme.com", password: "secret123456", tenant: acme)
+    assert acme_book.accessable?(user: carol)
+    assert_not globex_book.accessable?(user: carol)
+
+    # Re-granting everyone access on a book still only reaches its own tenant
+    acme_book.update_access(editors: [ carol.id ], readers: [])
+    assert_not globex_book.accessable?(user: carol)
+    assert_not bob.accesses.exists?(book: acme_book)
+  end
+end
