diff --git a/test/controllers/leaves/being_edited_broadcast_test.rb b/test/controllers/leaves/being_edited_broadcast_test.rb
new file mode 100644
index 0000000..b4d2c2b
--- /dev/null
+++ b/test/controllers/leaves/being_edited_broadcast_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+require "turbo/broadcastable/test_helper"
+
+class LeavesBeingEditedBroadcastTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+  include Turbo::Broadcastable::TestHelper
+
+  setup do
+    sign_in :kevin
+    @leaf = leaves(:welcome_page)
+    @book = books(:handbook)
+  end
+
+  test "update broadcasts being edited indicator to collaborators with edit access" do
+    accesses(:jz_handbook).update! level: :editor
+
+    perform_enqueued_jobs do
+      put leafable_path(@leaf), params: { leaf: { title: "Welcome" }, page: { body: "Hi" } }
+      assert_response :no_content
+    end
+
+    streams = capture_turbo_stream_broadcasts [ @leaf, users(:jz), :being_edited ]
+    assert streams.present?, "expected a being-edited broadcast for a current editor"
+    assert_includes streams.map(&:to_html).join, "Kevin"
+  end
+
+  test "update does not broadcast being edited indicator to removed collaborators" do
+    accesses(:jz_handbook).update! level: :editor
+    # jz opens the editor (subscribes), then gets removed from the book
+    @book.accesses.where(user: users(:jz)).delete_all
+
+    perform_enqueued_jobs do
+      put leafable_path(@leaf), params: { leaf: { title: "Welcome" }, page: { body: "Hi" } }
+      assert_response :no_content
+    end
+
+    assert_no_turbo_stream_broadcasts [ @leaf, users(:jz), :being_edited ]
+  end
+
+  test "update does not broadcast being edited indicator on the shared unauthorized stream" do
+    perform_enqueued_jobs do
+      put leafable_path(@leaf), params: { leaf: { title: "Welcome" }, page: { body: "Hi" } }
+      assert_response :no_content
+    end
+
+    assert_no_turbo_stream_broadcasts [ @leaf, :being_edited ]
+  end
+
+  test "update does not broadcast being edited indicator to readers" do
+    perform_enqueued_jobs do
+      put leafable_path(@leaf), params: { leaf: { title: "Welcome" }, page: { body: "Hi" } }
+      assert_response :no_content
+    end
+
+    assert_no_turbo_stream_broadcasts [ @leaf, users(:jz), :being_edited ]
+  end
+end
