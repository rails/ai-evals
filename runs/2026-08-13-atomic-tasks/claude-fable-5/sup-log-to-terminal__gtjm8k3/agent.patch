diff --git a/config/application.rb b/config/application.rb
index d5e4fd0..3dd5ee6 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -29,5 +29,16 @@ module Writebook
 
     # Opt in to 8.0 timezone behavior
     config.active_support.to_time_preserves_timezone = :zone
+
+    # Runbook scripts run via `bin/rails runner` (like script/library_report.rb)
+    # report through Rails.logger. Echo those lines to the terminal for the
+    # operator while the environment's log file keeps recording every line.
+    runner do
+      unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT)
+        console = ActiveSupport::Logger.new(STDOUT)
+        console.level = Rails.logger.level
+        Rails.logger.broadcast_to(console)
+      end
+    end
   end
 end
