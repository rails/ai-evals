diff --git a/test/controllers/being_edited_broadcast_test.rb b/test/controllers/being_edited_broadcast_test.rb
new file mode 100644
index 0000000..45b95c2
--- /dev/null
+++ b/test/controllers/being_edited_broadcast_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class BeingEditedBroadcastTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:handbook)
+    @leaf = leaves(:welcome_page)
+    sign_in :david
+  end
+
+  test "collaborators with edit access receive the being edited indicator" do
+    assert_changes -> { broadcasts_to(users(:kevin)).size }, "kevin should receive presence payloads while he has access" do
+      save_page
+    end
+    assert_includes broadcasts_to(users(:kevin)).last, "David"
+  end
+
+  test "administrators keep receiving the being edited indicator" do
+    assert_changes -> { broadcasts_to(users(:jason)).size } do
+      save_page
+    end
+  end
+
+  test "removed collaborator no longer receives the being edited indicator" do
+    @book.update_access editors: [ users(:david).id, users(:jason).id ], readers: [ users(:jz).id ]
+    assert_not @book.editable?(user: users(:kevin))
+
+    assert_no_changes -> { broadcasts_to(users(:kevin)).size }, "kevin must not receive presence payloads after removal" do
+      save_page
+    end
+  end
+
+  test "collaborator downgraded to reader no longer receives the being edited indicator" do
+    accesses(:kevin_handbook).update! level: :reader
+
+    assert_no_changes -> { broadcasts_to(users(:kevin)).size } do
+      save_page
+    end
+  end
+
+  private
+    def save_page
+      perform_enqueued_jobs do
+        patch book_page_path(@book, @leaf, format: :turbo_stream),
+          params: { leaf: { title: @leaf.title }, page: { body: "Updated body #{SecureRandom.hex(4)}" } }
+        assert_response :success
+      end
+    end
+
+    def broadcasts_to(user)
+      stream_names_for(user).flat_map { |name| ActionCable.server.pubsub.broadcasts(name) }
+    end
+
+    def stream_names_for(user)
+      [
+        Turbo::StreamsChannel.send(:stream_name_from, [ @leaf, :being_edited ]),
+        Turbo::StreamsChannel.send(:stream_name_from, [ @leaf, :being_edited, user ])
+      ]
+    end
+end
