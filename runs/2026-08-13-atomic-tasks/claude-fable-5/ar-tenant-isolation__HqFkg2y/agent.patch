diff --git a/test/integration/tenant_isolation_test.rb b/test/integration/tenant_isolation_test.rb
new file mode 100644
index 0000000..4e35559
--- /dev/null
+++ b/test/integration/tenant_isolation_test.rb
@@ -0,0 +1,169 @@
+require "test_helper"
+
+class TenantIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Customer A")
+    @tenant_b = Tenant.create!(name: "Customer B")
+
+    users(:kevin).update!(tenant: @tenant_a)
+    users(:david).update!(tenant: @tenant_a)
+    users(:jz).update!(tenant: @tenant_b)
+
+    books(:handbook).update!(tenant: @tenant_a)
+    books(:manual).update!(tenant: @tenant_b)
+  end
+
+  test "another tenant's unpublished book 404s like a missing book" do
+    sign_in :jz
+
+    get slugged_book_path(books(:handbook), books(:handbook).slug)
+    assert_response :not_found
+
+    get slugged_book_path(999999, "nope")
+    assert_response :not_found
+  end
+
+  test "another tenant's published book is gone from the library and 404s" do
+    books(:handbook).update!(published: true)
+    sign_in :jz
+
+    get root_path
+    assert_response :success
+    assert_select "h2", text: "Handbook", count: 0
+    assert_select "h2", text: "Manual"
+
+    get slugged_book_path(books(:handbook), books(:handbook).slug)
+    assert_response :not_found
+  end
+
+  test "an access row does not buy a way into another tenant's book" do
+    # jz holds a reader access row for handbook via fixtures
+    assert books(:handbook).accessable?(user: users(:jz))
+
+    sign_in :jz
+    get slugged_book_path(books(:handbook), books(:handbook).slug)
+    assert_response :not_found
+  end
+
+  test "pages inside another tenant's book 404 everywhere" do
+    books(:handbook).update!(published: true)
+    sign_in :jz
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :not_found
+
+    get book_page_path(books(:handbook), leaves(:welcome_page))
+    assert_response :not_found
+
+    get edit_book_page_path(books(:handbook), leaves(:welcome_page))
+    assert_response :not_found
+
+    get book_search_path(books(:handbook)), params: { search: "great" }
+    assert_response :not_found
+
+    get book_bookmark_path(books(:handbook))
+    assert_response :not_found
+
+    get book_publication_path(books(:handbook))
+    assert_response :not_found
+  end
+
+  test "edit history of a page in another tenant's book 404s despite an access row" do
+    leaves(:welcome_page).edit leafable_params: { body: "New content" }
+
+    sign_in :jz
+    get page_edit_path(leaves(:welcome_page), leaves(:welcome_page).edits.last)
+    assert_response :not_found
+
+    get page_edit_path(leaves(:welcome_page), "latest")
+    assert_response :not_found
+  end
+
+  test "user stays signed in after cross-tenant 404s" do
+    sign_in :jz
+    get slugged_book_path(books(:handbook), books(:handbook).slug)
+    assert_response :not_found
+
+    get root_path
+    assert_response :success
+    assert_select "h2", text: "Manual"
+  end
+
+  test "own tenant books, pages and edit history keep working" do
+    leaves(:welcome_page).edit leafable_params: { body: "New content" }
+    sign_in :kevin
+
+    get root_path
+    assert_select "h2", text: "Handbook"
+
+    get slugged_book_path(books(:handbook), books(:handbook).slug)
+    assert_response :success
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+
+    get page_edit_path(leaves(:welcome_page), "latest")
+    assert_response :success
+  end
+
+  test "signed-out visitors see every published book, whatever tenant" do
+    books(:handbook).update!(published: true)
+    books(:manual).update!(published: true)
+
+    get root_path
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+    assert_select "h2", text: "Manual"
+
+    get slugged_book_path(books(:handbook), books(:handbook).slug)
+    assert_response :success
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+  end
+
+  test "new books land in their creator's tenant" do
+    sign_in :kevin
+    post books_path, params: { book: { title: "Kevin's Book", everyone_access: false } }
+
+    assert_equal @tenant_a, Book.find_by(title: "Kevin's Book").tenant
+  end
+
+  test "sharing with everyone only sprays access rows within the tenant" do
+    book = Book.create!(title: "Shared A", tenant: @tenant_a, everyone_access: true)
+    book.update_access(editors: [], readers: [])
+
+    assert book.accessable?(user: users(:kevin))
+    assert book.accessable?(user: users(:david))
+    assert_not book.accessable?(user: users(:jz))
+  end
+
+  test "new users only get reader rows for everyone books in their tenant" do
+    a_book = Book.create!(title: "Everyone A", tenant: @tenant_a, everyone_access: true)
+    b_book = Book.create!(title: "Everyone B", tenant: @tenant_b, everyone_access: true)
+
+    user = User.create!(name: "Newbie", email_address: "newbie@example.com", password: "secret123456", tenant: @tenant_a)
+
+    assert a_book.accessable?(user: user)
+    assert_not b_book.accessable?(user: user)
+  end
+
+  test "/users still names everyone on the install" do
+    sign_in :jz
+    get users_path
+
+    assert_response :success
+    assert_in_body "Kevin"
+    assert_in_body "JZ"
+  end
+
+  test "existing rows without a tenant behave as before" do
+    users(:jason).update!(tenant: nil)
+    book = Book.create!(title: "Legacy", tenant: nil, published: false)
+    book.update_access(editors: [ users(:jason).id ], readers: [])
+
+    sign_in :jason
+    get slugged_book_path(book, book.slug)
+    assert_response :success
+  end
+end
