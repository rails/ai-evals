diff --git a/app/models/concerns/tenantable.rb b/app/models/concerns/tenantable.rb
new file mode 100644
index 0000000..d664bc3
--- /dev/null
+++ b/app/models/concerns/tenantable.rb
@@ -0,0 +1,15 @@
+module Tenantable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+
+    scope :in_tenant_of, ->(record) do
+      if record&.tenant_id
+        where(tenant_id: [ nil, record.tenant_id ])
+      else
+        all
+      end
+    end
+  end
+end
