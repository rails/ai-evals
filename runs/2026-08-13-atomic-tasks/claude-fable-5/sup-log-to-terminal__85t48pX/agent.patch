diff --git a/config/application.rb b/config/application.rb
index d5e4fd0..9bcf3d0 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -27,6 +27,20 @@ module Writebook
     # config.time_zone = "Central Time (US & Canada)"
     # config.eager_load_paths << Rails.root.join("extras")
 
+    # `bin/rails runner` scripts (like the import runbook's library report) log
+    # through Rails.logger, which only writes to the environment's log file.
+    # Mirror those lines to the terminal so the on-call can read the report,
+    # while every line is still recorded in the log file.
+    runner do
+      console = ActiveSupport::Logger.new(STDOUT)
+      console.formatter = Rails.logger.formatter
+      console.level = Rails.logger.level
+
+      unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT, STDERR)
+        Rails.logger.broadcast_to(console)
+      end
+    end
+
     # Opt in to 8.0 timezone behavior
     config.active_support.to_time_preserves_timezone = :zone
   end
