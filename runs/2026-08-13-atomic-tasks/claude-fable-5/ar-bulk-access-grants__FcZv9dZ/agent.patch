diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..dcb2711
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,138 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:handbook)
+    @book.accesses.delete_all
+    @users = User.all.to_a
+  end
+
+  test "imports grants and notifies" do
+    grants = [
+      { user_id: users(:david).id, level: "editor" },
+      { user_id: users(:jz).id, level: "reader" }
+    ]
+
+    result = nil
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal 2, result.accesses.size
+    assert result.accesses.all?(&:persisted?)
+    assert @book.accesses.exists?(user_id: users(:david).id, level: "editor")
+    assert @book.accesses.exists?(user_id: users(:jz).id, level: "reader")
+  end
+
+  test "rejected roster does not notify or persist" do
+    @book.accesses.create!(user: users(:jz), level: "reader")
+
+    grants = [
+      { user_id: users(:david).id, level: "editor" },
+      { user_id: users(:jz).id, level: "reader" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_equal [], result.accesses
+    assert_not @book.accesses.exists?(user_id: users(:david).id)
+  end
+
+  test "duplicate within the sheet is rejected" do
+    grants = [
+      { user_id: users(:david).id, level: "editor" },
+      { user_id: users(:david).id, level: "reader" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_equal [], result.accesses
+    assert_not @book.accesses.exists?(user_id: users(:david).id)
+  end
+
+  test "unknown level is turned down like any other bad row" do
+    grants = [
+      { user_id: users(:david).id, level: "reader" },
+      { user_id: users(:jz).id, level: "overlord" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs do
+      assert_nothing_raised do
+        result = Book::AccessImport.new(@book, grants).import
+      end
+    end
+
+    assert_equal 1, result.duplicate_index
+    assert_equal [], result.accesses
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "write query count does not scale with roster size" do
+    grants_for = ->(n) { @users.first(n).collect { |u| { user_id: u.id, level: "reader" } } }
+
+    writes_small = count_writes { Book::AccessImport.new(@book, grants_for.(2)).import }
+    @book.accesses.delete_all
+    writes_large = count_writes { Book::AccessImport.new(@book, grants_for.(@users.size)).import }
+
+    assert_operator @users.size, :>, 2
+    assert_equal writes_small, writes_large, "writes should not scale with roster size"
+  end
+
+  test "write query count constant when rejected" do
+    @book.accesses.create!(user: @users.first, level: "reader")
+    grants = @users.collect { |u| { user_id: u.id, level: "reader" } }
+
+    writes = count_writes { Book::AccessImport.new(@book, grants).import }
+    assert_operator writes, :<=, 1
+  end
+
+  test "empty grants import cleanly" do
+    result = Book::AccessImport.new(@book, []).import
+    assert_equal [], result.accesses
+    assert_nil result.duplicate_index
+  end
+
+  test "symbol levels are accepted" do
+    result = Book::AccessImport.new(@book, [ { user_id: users(:david).id, level: :editor } ]).import
+    assert_nil result.duplicate_index
+    assert @book.accesses.find_by(user: users(:david)).editor?
+  end
+
+  test "missing level is turned down" do
+    result = nil
+    assert_nothing_raised do
+      result = Book::AccessImport.new(@book, [ { user_id: users(:david).id, level: nil } ]).import
+    end
+    assert_equal 0, result.duplicate_index
+    assert_equal [], result.accesses
+  end
+
+  test "returned accesses preserve grant order" do
+    grants = @users.collect { |u| { user_id: u.id, level: "reader" } }
+    result = Book::AccessImport.new(@book, grants).import
+    assert_equal @users.collect(&:id), result.accesses.collect(&:user_id)
+  end
+
+  private
+    def count_writes(&block)
+      writes = 0
+      counter = ->(*, payload) do
+        sql = payload[:sql].to_s
+        writes += 1 if sql.match?(/\A\s*(INSERT|UPDATE|DELETE)/i)
+      end
+      ActiveSupport::Notifications.subscribed(counter, "sql.active_record", &block)
+      writes
+    end
+end
