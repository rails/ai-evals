diff --git a/config/application.rb b/config/application.rb
index d5e4fd0..7e0ba5f 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -27,6 +27,18 @@ module Writebook
     # config.time_zone = "Central Time (US & Canada)"
     # config.eager_load_paths << Rails.root.join("extras")
 
+    # `bin/rails runner` is used interactively (e.g. the import runbook's
+    # script/library_report.rb), so echo the log to the terminal while still
+    # writing every line to the environment's log file.
+    runner do
+      unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT)
+        stdout_logger = ActiveSupport::Logger.new(STDOUT)
+        stdout_logger.formatter = Rails.logger.formatter
+        stdout_logger.level = Rails.logger.level
+        Rails.logger.broadcast_to(stdout_logger)
+      end
+    end
+
     # Opt in to 8.0 timezone behavior
     config.active_support.to_time_preserves_timezone = :zone
   end
