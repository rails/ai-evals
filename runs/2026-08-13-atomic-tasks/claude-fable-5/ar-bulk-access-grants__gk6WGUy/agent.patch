diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..2c15801
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "Import test", everyone_access: false)
+    @users = [ users(:david), users(:jason), users(:jz), users(:kevin) ]
+  end
+
+  test "imports grants and notifies each recipient" do
+    grants = [
+      { user_id: users(:david).id, level: "editor" },
+      { user_id: users(:jz).id, level: "reader" }
+    ]
+
+    result = nil
+    assert_enqueued_jobs 2, only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal [ users(:david).id, users(:jz).id ], result.accesses.map(&:user_id)
+    assert_equal %w[ editor reader ], result.accesses.map(&:level)
+    assert result.accesses.all?(&:persisted?)
+  end
+
+  test "database queries do not scale with roster size" do
+    queries_for = ->(book, grants) do
+      count = 0
+      counter = ->(*, payload) do
+        count += 1 unless payload[:name] == "SCHEMA" || payload[:sql].match?(/\A(BEGIN|COMMIT|SAVEPOINT|RELEASE)/i)
+      end
+      ActiveSupport::Notifications.subscribed(counter, "sql.active_record") do
+        Book::AccessImport.new(book, grants).import
+      end
+      count
+    end
+
+    small_book = Book.create!(title: "Small roster", everyone_access: false)
+    small_queries = queries_for.call(small_book, @users.first(2).map { |u| { user_id: u.id, level: "reader" } })
+
+    big_book = Book.create!(title: "Big roster", everyone_access: false)
+    big_queries = queries_for.call(big_book, @users.map { |u| { user_id: u.id, level: "reader" } })
+
+    assert_equal small_queries, big_queries
+  end
+
+  test "duplicate grant rejects the whole roster without notifying" do
+    grants = [
+      { user_id: users(:david).id, level: "reader" },
+      { user_id: users(:david).id, level: "editor" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_empty result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_empty @book.accesses
+  end
+
+  test "grant duplicating an existing access rejects the roster" do
+    @book.accesses.create!(user: users(:david), level: "reader")
+
+    grants = [
+      { user_id: users(:jz).id, level: "reader" },
+      { user_id: users(:david).id, level: "editor" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      result = Book::AccessImport.new(@book, grants).import
+    end
+
+    assert_empty result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_equal 1, @book.accesses.count
+  end
+
+  test "unknown level is turned down like any other bad row" do
+    grants = [
+      { user_id: users(:jz).id, level: "reader" },
+      { user_id: users(:david).id, level: "warlord" }
+    ]
+
+    result = nil
+    assert_no_enqueued_jobs only: Book::AccessNotificationJob do
+      assert_nothing_raised do
+        result = Book::AccessImport.new(@book, grants).import
+      end
+    end
+
+    assert_empty result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_empty @book.accesses
+  end
+
+  test "empty roster imports nothing" do
+    result = Book::AccessImport.new(@book, []).import
+
+    assert_empty result.accesses
+    assert_nil result.duplicate_index
+  end
+end
