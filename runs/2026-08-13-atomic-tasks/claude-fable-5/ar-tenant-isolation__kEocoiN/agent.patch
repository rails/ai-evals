diff --git a/app/models/concerns/tenantable.rb b/app/models/concerns/tenantable.rb
new file mode 100644
index 0000000..b417165
--- /dev/null
+++ b/app/models/concerns/tenantable.rb
@@ -0,0 +1,9 @@
+module Tenantable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+
+    scope :in_tenant_of, ->(user) { user&.tenant_id ? where(tenant_id: [ nil, user.tenant_id ]) : all }
+  end
+end
