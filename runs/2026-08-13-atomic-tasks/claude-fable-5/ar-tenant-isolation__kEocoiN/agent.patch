+      t.datetime :created_at, null: false
+      t.datetime :updated_at, null: false
+    end
+
+    add_column :users, :tenant_id, :integer
+    add_column :books, :tenant_id, :integer
+    add_index :users, :tenant_id
+    add_index :books, :tenant_id
+
+    if select_value("SELECT COUNT(*) FROM users").to_i > 0 || select_value("SELECT COUNT(*) FROM books").to_i > 0
+      name = select_value("SELECT name FROM accounts ORDER BY id LIMIT 1") || "Writebook"
+      now = quote(Time.now.utc.strftime("%Y-%m-%d %H:%M:%S.%6N"))
+      execute "INSERT INTO tenants (name, created_at, updated_at) VALUES (#{quote(name)}, #{now}, #{now})"
+      tenant_id = select_value("SELECT id FROM tenants ORDER BY id DESC LIMIT 1")
+      execute "UPDATE users SET tenant_id = #{tenant_id}"
+      execute "UPDATE books SET tenant_id = #{tenant_id}"
+    end
+  end
+
+  def down
+    remove_index :users, :tenant_id
+    remove_index :books, :tenant_id
+    remove_column :users, :tenant_id
+    remove_column :books, :tenant_id
+    drop_table :tenants
+  end
+end
