diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..0daed68 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,35 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_save :track_publication_change, if: :saved_change_to_published?
+    after_commit :announce_publication_if_newly_published
+    after_rollback :reset_publication_tracking
   end
 
   private
-    def announce_publication
-      AnnouncePublicationJob.perform_later self
+    # Remember whether the book was live before this sitting (transaction)
+    # first changed its publication state, so that later saves within the
+    # same sitting can't hide or duplicate the announcement. Announcing only
+    # after commit ensures a failed sitting announces nothing.
+    def track_publication_change
+      unless @publication_change_tracked
+        @publication_change_tracked = true
+        @published_before_sitting = published_before_last_save.present?
+      end
+    end
+
+    def newly_published?
+      @publication_change_tracked && published? && !@published_before_sitting
+    end
+
+    def announce_publication_if_newly_published
+      AnnouncePublicationJob.perform_later self if newly_published?
+    ensure
+      reset_publication_tracking
+    end
+
+    def reset_publication_tracking
+      @publication_change_tracked = false
+      @published_before_sitting = nil
     end
 end
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..29b12d9
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "going live announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      books(:manual).update!(published: true)
+    end
+  end
+
+  test "going live and adding a page in the same sitting announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        books(:manual).update!(published: true)
+        books(:manual).press Page.new(body: ""), { title: "New page" }
+      end
+    end
+  end
+
+  test "going live with other changes to the book itself announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        books(:manual).update!(published: true)
+        books(:manual).update!(title: "Renamed")
+      end
+    end
+  end
+
+  test "taking a live book down announces nothing" do
+    books(:manual).update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      books(:manual).update!(published: false)
+    end
+  end
+
+  test "saving an already-live book again does not announce again" do
+    books(:manual).update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      books(:manual).update!(title: "Renamed")
+      books(:manual).touch
+      books(:manual).update!(published: true)
+    end
+  end
+
+  test "a save that does not take the book live announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      books(:manual).update!(title: "Renamed")
+    end
+  end
+
+  test "a sitting that fails after the book was marked live leaves a draft and no announcement" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      assert_raises RuntimeError do
+        Book.transaction do
+          books(:manual).update!(published: true)
+          raise "boom"
+        end
+      end
+    end
+
+    assert_not books(:manual).reload.published?
+  end
+
+  test "going live then back down in the same sitting announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        books(:manual).update!(published: true)
+        books(:manual).update!(published: false)
+      end
+    end
+  end
+
+  test "taking down then putting back live in the same sitting announces nothing" do
+    books(:manual).update!(published: true)
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        books(:manual).update!(published: false)
+        books(:manual).update!(published: true)
+      end
+    end
+  end
+
+  test "a failed sitting does not poison a later successful one" do
+    assert_raises RuntimeError do
+      Book.transaction do
+        books(:manual).update!(published: true)
+        raise "boom"
+      end
+    end
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      books(:manual).reload.update!(published: true)
+    end
+  end
+
+  test "creating a book already live announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.create!(title: "Fresh", published: true)
+    end
+  end
+
+  test "creating a draft book announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.create!(title: "Fresh")
+    end
+  end
+end
