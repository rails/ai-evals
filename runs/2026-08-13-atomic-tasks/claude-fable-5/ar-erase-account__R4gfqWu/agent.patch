diff --git a/test/models/user/erasable_test.rb b/test/models/user/erasable_test.rb
new file mode 100644
index 0000000..267b7b0
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+  end
+
+  test "erase removes the user row entirely" do
+    @user.erase
+    assert_not User.exists?(@user.id)
+  end
+
+  test "erase removes sessions, accesses and reading marks" do
+    @user.sessions.create!(user_agent: "TestAgent", ip_address: "127.0.0.1")
+    ReadingMark.remember leaves(:welcome_page), user: @user
+    assert Access.where(user: @user).exists?
+
+    @user.erase
+
+    assert_empty Session.where(user_id: @user.id)
+    assert_empty Access.where(user_id: @user.id)
+    assert_empty ReadingMark.where(user_id: @user.id)
+  end
+
+  test "erase removes sign in events recorded under the user's email address" do
+    @user.sessions.create!(user_agent: "TestAgent", ip_address: "127.0.0.1")
+    assert SignInEvent.for_address(@user.email_address).exists?
+
+    @user.erase
+
+    assert_empty SignInEvent.for_address("kevin@example.com")
+  end
+
+  test "erase removes sign in events for previously deactivated users recorded under their original address" do
+    @user.sessions.create!(user_agent: "TestAgent", ip_address: "127.0.0.1")
+    @user.deactivate
+    @user.reload
+
+    assert_match(/-deactivated-/, @user.email_address)
+    assert SignInEvent.for_address("kevin@example.com").exists?
+
+    @user.erase
+
+    assert_empty SignInEvent.for_address("kevin@example.com")
+  end
+
+  test "erase destroys created books that are not shared with everyone, including search index entries" do
+    Current.user = @user
+    book = Book.create!(title: "Kevin's Private Book", author: @user.name, everyone_access: false, creator: @user)
+    book.press Page.new(body: "clandestine xylophone notes"), { title: "Private page" }
+
+    assert_not_empty Leaf.search("xylophone").to_a
+
+    @user.erase
+
+    assert_not Book.exists?(book.id)
+    assert_empty Leaf.search("xylophone").to_a
+  ensure
+    Current.user = nil
+  end
+
+  test "erase destroys edit history of created books that are not shared with everyone" do
+    Current.user = @user
+    book = Book.create!(title: "Kevin's Private Book", everyone_access: false, creator: @user)
+    leaf = book.press Page.new(body: "current version"), { title: "Private page" }
+    leaf.edits.revision.create!(leafable: Page.create!(body: "old version"))
+    revision_page_ids = leaf.edits.map(&:leafable_id)
+
+    @user.erase
+
+    assert_empty Edit.where(leaf_id: leaf.id)
+    assert_empty Page.where(id: revision_page_ids)
+  ensure
+    Current.user = nil
+  end
+
+  test "erase keeps created books shared with everyone, bylined as Deleted author" do
+    Current.user = @user
+    book = Book.create!(title: "Kevin's Public Book", author: @user.name, everyone_access: true, creator: @user)
+    book.press Page.new(body: "communal quokka wisdom"), { title: "Public page" }
+
+    @user.erase
+
+    book.reload
+    assert_equal "Deleted author", book.author
+    assert_nil book.creator_id
+    assert_not_empty Leaf.search("quokka").to_a
+  ensure
+    Current.user = nil
+  end
+
+  test "erase leaves other users' data untouched" do
+    users(:jz).sessions.create!(user_agent: "TestAgent", ip_address: "127.0.0.1")
+    ReadingMark.remember leaves(:welcome_page), user: users(:jz)
+
+    @user.erase
+
+    assert User.exists?(users(:jz).id)
+    assert SignInEvent.for_address(users(:jz).email_address).exists?
+    assert Session.where(user: users(:jz)).exists?
+    assert Access.where(user: users(:jz)).exists?
+    assert ReadingMark.where(user: users(:jz)).exists?
+  end
+end
