diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..4876ed0
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,46 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  DEACTIVATED_EMAIL_ADDRESS_PATTERN = /-deactivated-\h{8}-(?:\h{4}-){3}\h{12}@/
+  DELETED_AUTHOR_BYLINE = "Deleted author"
+
+  def erase
+    transaction do
+      sessions.delete_all
+      erase_sign_in_events
+      byline_created_books_shared_with_everyone
+      erase_created_book_edits
+      destroy!
+    end
+  end
+
+  private
+    # Sessions are audited under the address the user actually signed in with,
+    # which for previously-deactivated users is not the scrambled address
+    # currently on the record. Erase events under every address we know about.
+    def erase_sign_in_events
+      SignInEvent.for_address(known_email_addresses).delete_all
+    end
+
+    def known_email_addresses
+      addresses = [ email_address ]
+
+      while (unscrambled = addresses.last&.sub(DEACTIVATED_EMAIL_ADDRESS_PATTERN, "@")) != addresses.last
+        addresses << unscrambled
+      end
+
+      addresses.compact.uniq
+    end
+
+    # Books shared with everyone remain readable, but without the author's name.
+    def byline_created_books_shared_with_everyone
+      created_books.with_everyone_access.update_all(creator_id: nil, author: DELETED_AUTHOR_BYLINE)
+      created_books.reset
+    end
+
+    # Edits are `dependent: :delete_all`, which would orphan the leafable
+    # revisions (and their content) of the books we're about to destroy.
+    def erase_created_book_edits
+      Edit.where(leaf_id: Leaf.where(book: created_books).select(:id)).find_each(&:destroy)
+    end
+end
