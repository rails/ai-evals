diff --git a/test/integration/tenant_isolation_test.rb b/test/integration/tenant_isolation_test.rb
new file mode 100644
index 0000000..810cec3
--- /dev/null
+++ b/test/integration/tenant_isolation_test.rb
@@ -0,0 +1,159 @@
+require "test_helper"
+
+class TenantIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Customer A")
+    @tenant_b = Tenant.create!(name: "Customer B")
+
+    # kevin/jz -> tenant A ; david/jason -> tenant B
+    users(:kevin).update!(tenant: @tenant_a)
+    users(:jz).update!(tenant: @tenant_a)
+    users(:david).update!(tenant: @tenant_b)
+    users(:jason).update!(tenant: @tenant_b)
+
+    # handbook -> tenant A ; manual -> tenant B
+    books(:handbook).update!(tenant: @tenant_a)
+    books(:manual).update!(tenant: @tenant_b)
+  end
+
+  test "cross-tenant book is 404 even with an access row" do
+    sign_in :david # tenant B, has editor access row on handbook (tenant A)
+    assert Access.exists?(user: users(:david), book: books(:handbook))
+
+    get book_slug_url(books(:handbook))
+    assert_response :not_found
+
+    get edit_book_url(books(:handbook))
+    assert_response :not_found
+
+    get book_publication_url(books(:handbook))
+    assert_response :not_found
+
+    post book_search_url(books(:handbook)), params: { search: "great" }
+    assert_response :not_found
+  end
+
+  test "cross-tenant published book is 404 for signed-in user in another tenant" do
+    books(:handbook).update!(published: true)
+    sign_in :david
+
+    get book_slug_url(books(:handbook))
+    assert_response :not_found
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :not_found
+  end
+
+  test "cross-tenant pages and edit history are 404" do
+    leaves(:welcome_page).edit leafable_params: { body: "New content" }
+    sign_in :david
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :not_found
+
+    get book_page_url(books(:handbook), leaves(:welcome_page))
+    assert_response :not_found
+
+    get page_edit_url(leaves(:welcome_page), leaves(:welcome_page).edits.last)
+    assert_response :not_found
+
+    get page_edit_url(leaves(:welcome_page), "latest")
+    assert_response :not_found
+  end
+
+  test "cross-tenant books, published or not, are absent from library" do
+    books(:handbook).update!(published: true)
+    sign_in :david
+
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Handbook", count: 0
+    assert_select "h2", text: "Manual"
+  end
+
+  test "own tenant books keep working" do
+    sign_in :kevin
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+
+    get book_slug_url(books(:handbook))
+    assert_response :success
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+
+    leaves(:welcome_page).edit leafable_params: { body: "New content" }
+    get page_edit_url(leaves(:welcome_page), "latest")
+    assert_response :success
+  end
+
+  test "signed-out visitors see every published book regardless of tenant" do
+    books(:handbook).update!(published: true)
+    books(:manual).update!(published: true)
+
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+    assert_select "h2", text: "Manual"
+
+    get book_slug_url(books(:handbook))
+    assert_response :success
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+  end
+
+  test "new books land in creator's tenant" do
+    sign_in :kevin
+    post books_url, params: { book: { title: "Tenant A Book" } }
+    book = Book.find_by(title: "Tenant A Book")
+    assert_equal @tenant_a.id, book.tenant_id
+  end
+
+  test "sharing with everyone only grants access within the tenant" do
+    sign_in :kevin
+    post books_url, params: { book: { title: "Everyone Book", everyone_access: true } }
+    book = Book.find_by(title: "Everyone Book")
+
+    assert book.accessable?(user: users(:jz))
+    assert_not book.accessable?(user: users(:david))
+  end
+
+  test "new user gets everyone-book access only in own tenant" do
+    books(:handbook).update!(everyone_access: true)
+    books(:manual).update!(everyone_access: true)
+
+    newbie = User.create!(name: "Newbie", email_address: "newbie@example.com", password: "secret123456", tenant: @tenant_a)
+
+    assert books(:handbook).accessable?(user: newbie)
+    assert_not books(:manual).accessable?(user: newbie)
+  end
+
+  test "users index still names everyone" do
+    sign_in :david
+    get users_url
+    assert_response :success
+    assert_match "Kevin", response.body
+    assert_match "David", response.body
+  end
+
+  test "cross-tenant user stays signed in when hitting a hidden book" do
+    sign_in :david
+    get book_slug_url(books(:handbook))
+    assert_response :not_found
+
+    get root_url
+    assert_response :success
+    assert_select "h2", text: "Manual"
+  end
+
+  test "tenantless rows behave as before" do
+    books(:handbook).update!(tenant: nil)
+    users(:david).update!(tenant: nil)
+
+    sign_in :david
+    get book_slug_url(books(:handbook))
+    assert_response :success
+  end
+end
