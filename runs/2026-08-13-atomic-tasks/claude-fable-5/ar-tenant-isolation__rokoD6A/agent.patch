diff --git a/db/migrate/20251103000000_create_tenants.rb b/db/migrate/20251103000000_create_tenants.rb
new file mode 100644
index 0000000..44032ab
--- /dev/null
+++ b/db/migrate/20251103000000_create_tenants.rb
@@ -0,0 +1,33 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    sweep_existing_records_into_one_tenant
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+    drop_table :tenants
+  end
+
+  private
+    def sweep_existing_records_into_one_tenant
+      return unless select_value("SELECT COUNT(*) FROM users").to_i > 0 || select_value("SELECT COUNT(*) FROM books").to_i > 0
+
+      name = select_value("SELECT name FROM accounts ORDER BY id LIMIT 1") || "Writebook"
+      now = quote(Time.now.utc.strftime("%Y-%m-%d %H:%M:%S.%6N"))
+
+      execute "INSERT INTO tenants (name, created_at, updated_at) VALUES (#{quote(name)}, #{now}, #{now})"
+      tenant_id = select_value("SELECT id FROM tenants ORDER BY id DESC LIMIT 1")
+
+      execute "UPDATE users SET tenant_id = #{quote(tenant_id)}"
+      execute "UPDATE books SET tenant_id = #{quote(tenant_id)}"
+    end
+end
