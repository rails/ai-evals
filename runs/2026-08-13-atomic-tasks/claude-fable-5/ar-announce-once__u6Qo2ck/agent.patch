diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..2994415 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,28 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :note_publication_change
+    after_commit :announce_publication, if: :went_live?
+    after_commit :reset_publication_tracking
+    after_rollback :reset_publication_tracking
   end
 
   private
+    def note_publication_change
+      if saved_change_to_published? && @published_before_sitting.nil?
+        @published_before_sitting = published_before_last_save || false
+      end
+    end
+
+    def went_live?
+      @published_before_sitting == false && published?
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
     end
+
+    def reset_publication_tracking
+      @published_before_sitting = nil
+    end
 end
diff --git a/test/controllers/books/publication_announce_test.rb b/test/controllers/books/publication_announce_test.rb
new file mode 100644
index 0000000..db72c93
--- /dev/null
+++ b/test/controllers/books/publication_announce_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class PublicationAnnounceTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+    sign_in :david
+  end
+
+  test "publishing while adding a page announces once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: { book: { published: "1" }, added_pages: [ "Intro" ] }
+    end
+    assert @book.reload.published?
+    assert @book.leaves.exists?(title: "Intro")
+  end
+
+  test "unpublishing a live book announces nothing" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: { book: { published: "0" } }
+    end
+    assert_not @book.reload.published?
+  end
+
+  test "re-saving a live book as published announces nothing" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: { book: { published: "1" } }
+    end
+  end
+
+  test "sitting that fails after publishing leaves a draft and no announcement" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_url(@book), params: { book: { published: "1" }, trashed_page_ids: [ "999999" ] }
+      assert_response :not_found
+    end
+    assert_not @book.reload.published?
+  end
+end
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..9317b23
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,112 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+  end
+
+  test "publishing announces exactly once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "publishing and adding a page in the same transaction announces exactly once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), { title: "New Page" }
+      end
+    end
+  end
+
+  test "unpublishing does not announce" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "saving an already-published book does not announce again" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Renamed"
+      @book.update! published: true
+    end
+  end
+
+  test "saving without publishing does not announce" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "Renamed"
+    end
+  end
+
+  test "rolled back publication does not announce and stays a draft" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        raise ActiveRecord::Rollback
+      end
+    end
+    assert_not @book.reload.published?
+  end
+
+  test "failed sitting after publication does not leak an announcement into a later save" do
+    @book.transaction do
+      @book.update! published: true
+      raise ActiveRecord::Rollback
+    end
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.reload.update! title: "Renamed"
+    end
+  end
+
+  test "publishing after a failed sitting announces once" do
+    @book.transaction do
+      @book.update! published: true
+      raise ActiveRecord::Rollback
+    end
+
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.reload.update! published: true
+    end
+  end
+
+  test "publish then unpublish in one sitting announces nothing" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+      end
+    end
+  end
+
+  test "unpublish then republish a live book in one sitting announces nothing" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: false
+        @book.update! published: true
+      end
+    end
+  end
+
+  test "touching a live book does not announce" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.touch
+    end
+  end
+end
