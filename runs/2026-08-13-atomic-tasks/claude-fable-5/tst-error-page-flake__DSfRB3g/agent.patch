diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..27e9b8d 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -13,11 +13,19 @@ module ActiveSupport
     include SessionTestHelper
 
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      # Rails memoizes env_config (including "action_dispatch.show_exceptions")
+      # the first time a request is dispatched, so mutating
+      # Rails.application.config after boot has no effect once any request has
+      # run — and whether one had run depended on test order, making the suite
+      # flaky. Mutate the memoized env_config directly and restore it in
+      # ensure, so exceptions are raised inside the block and error pages
+      # render normally outside it, regardless of what ran before.
+      env_config = Rails.application.env_config
+      previous = env_config["action_dispatch.show_exceptions"]
+      env_config["action_dispatch.show_exceptions"] = :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      Rails.application.env_config["action_dispatch.show_exceptions"] = previous
     end
   end
 end
