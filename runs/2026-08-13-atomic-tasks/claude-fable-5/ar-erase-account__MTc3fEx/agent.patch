diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..bf39c64
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,52 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  DELETED_AUTHOR_BYLINE = "Deleted author"
+  DEACTIVATED_EMAIL_SUFFIX = /(?:-deactivated-\h{8}-\h{4}-\h{4}-\h{4}-\h{12})+(?=@)/
+
+  # Permanently erases the user for GDPR-style removal requests. Nothing of
+  # theirs remains: the user row, sessions, accesses, reading marks, sign-in
+  # events and any books they created (along with their leaves, revisions and
+  # search index entries) are all removed.
+  #
+  # The one exception is books they created that are shared with everyone:
+  # those keep working for their readers, but are detached from the user and
+  # bylined "Deleted author".
+  #
+  # Also works for users who were previously deactivated (email rewritten to
+  # `name-deactivated-<uuid>@...`), whose sign-in events are recorded under
+  # the address they actually signed in with.
+  def erase
+    transaction do
+      relinquish_books_shared_with_everyone
+
+      addresses = sign_in_email_addresses
+      sessions.delete_all # avoid recording signed_out events while erasing
+      destroy!
+
+      SignInEvent.where(email_address: addresses).delete_all
+    end
+  end
+
+  private
+    def relinquish_books_shared_with_everyone
+      created_books.with_everyone_access.find_each do |book|
+        book.update! author: DELETED_AUTHOR_BYLINE
+        # Detach without triggering the creator default (Current.user), which
+        # would otherwise reattach the book to whoever performs the erasure.
+        book.update_column :creator_id, nil
+      end
+      created_books.reset
+    end
+
+    def sign_in_email_addresses
+      [ email_address, original_email_address ].compact.uniq
+    end
+
+    # Users removed the old way had their email rewritten to
+    # `name-deactivated-<uuid>@host`, but their sign-in events still sit
+    # under the address they actually signed in with.
+    def original_email_address
+      email_address&.sub(DEACTIVATED_EMAIL_SUFFIX, "")
+    end
+end
diff --git a/test/models/user/erasable_test.rb b/test/models/user/erasable_test.rb
new file mode 100644
index 0000000..66aa7ae
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  setup do
+    @user = User.create!(name: "Erased Person", email_address: "erased@example.com", password: "secret123456")
+    @original_email = @user.email_address
+
+    @user.sessions.create!(user_agent: "TestAgent", ip_address: "1.2.3.4") # records a signed_in event
+
+    Current.user = @user
+
+    @shared_book = Book.create!(title: "Shared Wisdom", author: "Erased Person", everyone_access: true, creator: @user)
+    @shared_book.update_access(editors: [ @user.id ], readers: [])
+
+    @private_book = Book.create!(title: "Private Musings", author: "Erased Person", everyone_access: false, creator: @user)
+    @private_book.update_access(editors: [ @user.id ], readers: [])
+    @private_book.press Page.new(body: "extremely xyzzyfying content"), title: "Xyzzyfying Chapter"
+
+    @private_leaf = @private_book.leaves.reload.first
+    ReadingMark.remember @private_leaf, user: @user
+  ensure
+    Current.user = nil
+  end
+
+  teardown do
+    Current.user = nil
+  end
+
+  test "erase removes the user row entirely" do
+    @user.erase
+
+    assert_nil User.find_by(id: @user.id)
+  end
+
+  test "erase removes sessions, accesses and reading marks" do
+    @user.erase
+
+    assert_empty Session.where(user_id: @user.id)
+    assert_empty Access.where(user_id: @user.id)
+    assert_empty ReadingMark.where(user_id: @user.id)
+  end
+
+  test "erase removes sign in events" do
+    assert SignInEvent.for_address(@original_email).any?
+
+    @user.erase
+
+    assert_empty SignInEvent.for_address(@original_email)
+  end
+
+  test "erase removes sign in events for users removed the old way" do
+    @user.deactivate
+    @user.reload
+
+    assert_match(/-deactivated-/, @user.email_address)
+    assert SignInEvent.for_address(@original_email).any?, "sign in events sit under the address they signed in with"
+
+    @user.erase
+
+    assert_empty SignInEvent.for_address(@original_email)
+    assert_nil User.find_by(id: @user.id)
+  end
+
+  test "erase destroys their private books along with leaves and revisions" do
+    @user.erase
+
+    assert_not Book.exists?(@private_book.id)
+    assert_empty Leaf.where(book_id: @private_book.id)
+    assert_empty Edit.where(leaf_id: @private_leaf.id)
+  end
+
+  test "erase destroys revision snapshots of their pages" do
+    Current.user = @user
+    travel 1.hour do
+      @private_leaf.edit leafable_params: { body: "revised xyzzyfying content" }
+    end
+
+    snapshot_page_ids = Edit.where(leaf_id: @private_leaf.id).where(leafable_type: "Page").pluck(:leafable_id)
+    assert snapshot_page_ids.any?
+
+    @user.erase
+
+    assert_empty Page.where(id: snapshot_page_ids)
+  end
+
+  test "erase leaves no stale search hits" do
+    @private_leaf.reindex
+
+    assert Leaf.search("xyzzyfying").to_a.any?
+
+    @user.erase
+
+    assert_empty Leaf.search("xyzzyfying").to_a
+  end
+
+  test "erase keeps books shared with everyone, bylined Deleted author" do
+    @user.erase
+
+    assert Book.exists?(@shared_book.id)
+    @shared_book.reload
+    assert_equal "Deleted author", @shared_book.author
+    assert_nil @shared_book.creator_id
+  end
+
+  test "erase does not reattach relinquished books to whoever performs the erasure" do
+    Current.user = users(:david)
+
+    @user.erase
+
+    assert_nil @shared_book.reload.creator_id
+  end
+
+  test "erase does not record sign out events for the erased sessions" do
+    @user.erase
+
+    assert_empty SignInEvent.for_address(@original_email).where(action: :signed_out)
+  end
+
+  test "other readers keep access to books shared with everyone" do
+    assert @shared_book.accessable?(user: users(:kevin))
+
+    @user.erase
+
+    assert @shared_book.reload.accessable?(user: users(:kevin))
+  end
+end
