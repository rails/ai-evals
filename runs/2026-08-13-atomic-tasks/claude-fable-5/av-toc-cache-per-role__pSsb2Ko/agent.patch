diff --git a/test/integration/book_toc_caching_test.rb b/test/integration/book_toc_caching_test.rb
new file mode 100644
index 0000000..711cc7d
--- /dev/null
+++ b/test/integration/book_toc_caching_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class BookTocCachingTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_perform_caching = ActionController::Base.perform_caching
+    @original_cache_store = ActionController::Base.cache_store
+    @original_collection_cache = ActionView::PartialRenderer.collection_cache
+
+    @store = ActiveSupport::Cache::MemoryStore.new
+    ActionController::Base.perform_caching = true
+    ActionController::Base.cache_store = @store
+    ActionView::PartialRenderer.collection_cache = @store
+  end
+
+  teardown do
+    @store.clear
+    ActionController::Base.perform_caching = @original_perform_caching
+    ActionController::Base.cache_store = @original_cache_store
+    ActionView::PartialRenderer.collection_cache = @original_collection_cache
+  end
+
+  test "reader never receives editor controls, even when an editor warmed the cache" do
+    sign_in :kevin # editor of handbook
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "menu.toc a[href=?]", edit_leafable_path(leaves(:welcome_page))
+
+    sign_out
+    sign_in :jz # reader of handbook
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "menu.toc a[href=?]", edit_leafable_path(leaves(:welcome_page)), count: 0
+    assert_select "menu.toc form.leaf__delete", count: 0
+    # Reader still gets the plain reading links
+    assert_select "menu.toc a[href=?]", leafable_slug_path(leaves(:welcome_page))
+  end
+
+  test "editor always receives editor controls, even when a reader warmed the cache" do
+    sign_in :jz # reader of handbook
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "menu.toc a[href=?]", edit_leafable_path(leaves(:welcome_page)), count: 0
+
+    sign_out
+    sign_in :kevin # editor of handbook
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "menu.toc a[href=?]", edit_leafable_path(leaves(:welcome_page))
+    assert_select "menu.toc form.leaf__delete"
+  end
+
+  test "a renamed entry shows its new title to the next visitor" do
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "menu.toc", text: /Welcome to The Handbook!/
+
+    leaves(:welcome_page).update!(title: "A Brand New Title")
+
+    sign_out
+    sign_in :jz
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "menu.toc", text: /A Brand New Title/
+    assert_select "menu.toc", text: /Welcome to The Handbook!/, count: 0
+  end
+
+  test "unauthenticated reader of a published book never receives editor controls" do
+    books(:handbook).update!(published: true)
+
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "menu.toc a[href=?]", edit_leafable_path(leaves(:welcome_page))
+
+    sign_out
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "menu.toc a[href=?]", edit_leafable_path(leaves(:welcome_page)), count: 0
+    assert_select "menu.toc form.leaf__delete", count: 0
+  end
+  test "a rename via turbo stream update is visible to the next visitor" do
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_response :success
+
+    # Editor renames the page through the leafable update endpoint.
+    put leafable_path(leaves(:welcome_page)),
+      params: { leaf: { title: "Renamed via Stream" }, page: { body: leaves(:welcome_page).leafable.body.content } },
+      as: :turbo_stream
+    assert_response :success
+
+    sign_out
+    sign_in :jz
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_select "menu.toc", text: /Renamed via Stream/
+    assert_select "menu.toc a[href=?]", edit_leafable_path(leaves(:welcome_page)), count: 0
+  end
+end
diff --git a/test/integration/toc_cache_fetch_count_test.rb b/test/integration/toc_cache_fetch_count_test.rb
new file mode 100644
index 0000000..c289318
--- /dev/null
+++ b/test/integration/toc_cache_fetch_count_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class TocCacheFetchCountTest < ActionDispatch::IntegrationTest
+  class CountingStore < ActiveSupport::Cache::MemoryStore
+    attr_accessor :read_multi_calls, :read_calls
+
+    def initialize(*)
+      super
+      reset_counters
+    end
+
+    def reset_counters
+      @read_multi_calls = 0
+      @read_calls = 0
+    end
+
+    def read_multi(*names, **options)
+      @read_multi_calls += 1
+      super
+    end
+
+    def read(name, options = nil)
+      @read_calls += 1
+      super
+    end
+  end
+
+  setup do
+    @original_perform_caching = ActionController::Base.perform_caching
+    @original_cache_store = ActionController::Base.cache_store
+    @original_collection_cache = ActionView::PartialRenderer.collection_cache
+
+    @store = CountingStore.new
+    ActionController::Base.perform_caching = true
+    ActionController::Base.cache_store = @store
+    ActionView::PartialRenderer.collection_cache = @store
+  end
+
+  teardown do
+    @store.clear
+    ActionController::Base.perform_caching = @original_perform_caching
+    ActionController::Base.cache_store = @original_cache_store
+    ActionView::PartialRenderer.collection_cache = @original_collection_cache
+  end
+
+  test "warm requests never turn into a lookup per entry" do
+    leaves_count = books(:handbook).leaves.active.count
+    assert leaves_count > 1, "need multiple leaves for a meaningful check"
+
+    # Cold: first editor warms the cache.
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_response :success
+
+    # Warm, same permission level (another editor): served from the outer
+    # fragment; no per-entry lookups at all.
+    sign_out
+    sign_in :david
+    @store.reset_counters
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_operator @store.read_calls, :<, leaves_count,
+      "warm editor request must not read once per entry"
+
+    # Cold variant (first reader): the leaf collection must still be fetched
+    # in one go, via a single multi-read.
+    sign_out
+    sign_in :jz
+    @store.reset_counters
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_operator @store.read_multi_calls, :<=, 1,
+      "the TOC collection must be fetched with at most one multi-get"
+
+    # Warm reader request: again no per-entry lookups.
+    sign_out
+    sign_in :jz
+    @store.reset_counters
+    get book_slug_url(books(:handbook))
+    assert_response :success
+    assert_operator @store.read_calls, :<, leaves_count,
+      "warm reader request must not read once per entry"
+    assert_operator @store.read_multi_calls, :<=, 1
+  end
+end
