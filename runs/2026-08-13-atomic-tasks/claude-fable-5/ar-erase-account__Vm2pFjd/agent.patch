diff --git a/test/models/user/erasable_test.rb b/test/models/user/erasable_test.rb
new file mode 100644
index 0000000..8827d72
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,110 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  setup do
+    @user = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456")
+    Current.user = @user
+  end
+
+  teardown do
+    Current.reset
+  end
+
+  test "erase removes the user row entirely" do
+    @user.erase
+
+    assert_not User.exists?(@user.id)
+  end
+
+  test "erase removes sessions, accesses and reading marks" do
+    @user.sessions.create!(user_agent: "test", ip_address: "1.2.3.4")
+    # signup already granted access to everyone books; ensure at least one exists
+    assert Access.where(user_id: @user.id).exists?
+    ReadingMark.remember(leaves(:welcome_page), user: @user)
+
+    @user.erase
+
+    assert_not Session.where(user_id: @user.id).exists?
+    assert_not Access.where(user_id: @user.id).exists?
+    assert_not ReadingMark.where(user_id: @user.id).exists?
+  end
+
+  test "erase removes the sign-in log" do
+    session = @user.sessions.create!(user_agent: "test", ip_address: "1.2.3.4")
+    assert SignInEvent.for_address("alice@example.com").exists?
+
+    @user.erase
+
+    assert_not SignInEvent.for_address("alice@example.com").exists?
+  end
+
+  test "erase removes sign-in events recorded under the pre-deactivation address" do
+    @user.sessions.create!(user_agent: "test", ip_address: "1.2.3.4")
+    @user.deactivate
+    assert SignInEvent.for_address("alice@example.com").exists?
+
+    @user.reload.erase
+
+    assert_not SignInEvent.for_address("alice@example.com").exists?
+    assert_not SignInEvent.where("email_address LIKE ?", "alice-deactivated-%").exists?
+  end
+
+  test "erase destroys books the user created that are not shared with everyone" do
+    book = Book.create!(title: "Private thoughts", author: @user.name, everyone_access: false, creator: @user)
+    page = Page.new
+    leaf = book.press(page, { title: "Notes" })
+
+    @user.erase
+
+    assert_not Book.exists?(book.id)
+    assert_not Leaf.exists?(leaf.id)
+    assert_not Page.exists?(page.id)
+  end
+
+  test "erase purges edit history of destroyed books, leaving no orphaned revisions" do
+    book = Book.create!(title: "Private thoughts", everyone_access: false, creator: @user)
+    page = Page.new
+    leaf = book.press(page, { title: "Notes" })
+    page.update!(body: "first version")
+    leaf.reload.edit(leafable_params: { body: "second version" })
+    revision_page_ids = leaf.edits.where(leafable_type: "Page").pluck(:leafable_id)
+    assert revision_page_ids.any?
+
+    @user.erase
+
+    assert_not Edit.where(leaf_id: leaf.id).exists?
+    assert_not Page.where(id: revision_page_ids).exists?
+  end
+
+  test "erase keeps books shared with everyone, detaching the creator and bylining Deleted author" do
+    book = Book.create!(title: "For everyone", author: @user.name, everyone_access: true, published: true, creator: @user)
+
+    @user.erase
+
+    book.reload
+    assert_nil book.creator_id
+    assert_equal "Deleted author", book.author
+  end
+
+  test "erase works for users already deactivated the old way" do
+    book = Book.create!(title: "For everyone", author: @user.name, everyone_access: true, creator: @user)
+    @user.deactivate
+
+    @user.reload.erase
+
+    assert_not User.exists?(@user.id)
+    assert_equal "Deleted author", book.reload.author
+  end
+
+  test "erase does not touch books created by other users" do
+    other_user = users(:david)
+    other = Book.create!(title: "Someone elses book", author: other_user.name, everyone_access: true, creator: other_user)
+
+    @user.erase
+
+    other.reload
+    assert Book.exists?(other.id)
+    assert_equal other_user.id, other.creator_id
+    assert_equal other_user.name, other.author
+  end
+end
