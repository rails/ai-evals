diff --git a/test/integration/toc_permission_caching_test.rb b/test/integration/toc_permission_caching_test.rb
new file mode 100644
index 0000000..be9ec6b
--- /dev/null
+++ b/test/integration/toc_permission_caching_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class TocPermissionCachingTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_perform_caching = ActionController::Base.perform_caching
+    @original_cache = Rails.cache
+    @original_collection_cache = ActionView::PartialRenderer.collection_cache
+
+    ActionController::Base.perform_caching = true
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    ActionView::PartialRenderer.collection_cache = Rails.cache
+  end
+
+  teardown do
+    ActionController::Base.perform_caching = @original_perform_caching
+    Rails.cache = @original_cache
+    ActionView::PartialRenderer.collection_cache = @original_collection_cache
+  end
+
+  test "reader does not get editor controls after an editor warmed the cache" do
+    sign_in :jason # editor on handbook
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body "Edit Welcome to The Handbook!"
+
+    sign_out
+    sign_in :jz # reader on handbook
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_not_in_body "Edit Welcome to The Handbook!"
+    assert_in_body "Open Welcome to The Handbook!"
+  end
+
+  test "editor still gets editor controls after a reader warmed the cache" do
+    sign_in :jz # reader
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_not_in_body "Edit Welcome to The Handbook!"
+
+    sign_out
+    sign_in :jason # editor
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body "Edit Welcome to The Handbook!"
+  end
+
+  test "renamed leaf shows its new title to the next visitor" do
+    sign_in :jason
+    get book_slug_path(books(:handbook))
+    assert_in_body "Welcome to The Handbook!"
+
+    leaves(:welcome_page).update!(title: "A Fresh Title")
+
+    sign_out
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_in_body "A Fresh Title"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+end
diff --git a/test/integration/toc_query_count_test.rb b/test/integration/toc_query_count_test.rb
new file mode 100644
index 0000000..5d8d335
--- /dev/null
+++ b/test/integration/toc_query_count_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class TocQueryCountTest < ActionDispatch::IntegrationTest
+  setup do
+    ActionController::Base.perform_caching = true
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    ActionView::PartialRenderer.collection_cache = Rails.cache
+  end
+
+  teardown do
+    ActionController::Base.perform_caching = false
+    Rails.cache = ActiveSupport::Cache::NullStore.new
+    ActionView::PartialRenderer.collection_cache = Rails.cache
+  end
+
+  test "toc rendering does not perform a query per leaf" do
+    book = books(:handbook)
+    # add many leaves
+    30.times do |i|
+      book.press Page.new(body: "Body #{i}"), title: "Extra Page #{i}"
+    end
+
+    sign_in :jason
+
+    queries = []
+    callback = ->(_name, _s, _f, _id, payload) {
+      queries << payload[:sql] unless payload[:name] == "SCHEMA" || payload[:sql] =~ /\A(BEGIN|COMMIT)/
+    }
+    ActiveSupport::Notifications.subscribed(callback, "sql.active_record") do
+      get book_slug_path(book)
+    end
+    assert_response :success
+
+    leaf_count = book.leaves.active.count
+    access_queries = queries.grep(/FROM "accesses"/)
+    assert_operator access_queries.size, :<=, 3, "too many access queries: #{access_queries.size}"
+    assert_operator queries.size, :<, leaf_count, "query count (#{queries.size}) should not scale with leaves (#{leaf_count}):\n#{queries.tally.sort_by { |_, c| -c }.first(5)}"
+  end
+end
