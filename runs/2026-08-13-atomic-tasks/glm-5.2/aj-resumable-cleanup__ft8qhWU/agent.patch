+++ b/app/jobs/title_cleanup_job.rb
@@ -1,7 +1,15 @@
 class TitleCleanupJob < ApplicationJob
+  # Strips the stray wrapping quotes the legacy exporter added around every
+  # leaf title.  Idempotent across interruptions: each leaf is cleaned inside a
+  # transaction that also stamps +title_cleaned_at+.  If the process is killed
+  # mid-leaf the transaction rolls back — the title is untouched and the
+  # timestamp stays +nil+ — so the next run picks that leaf up again and cleans
+  # it exactly once.  Already-cleaned leaves are skipped entirely.
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
-      leaf.update!(title: cleaned(leaf.title))
+    Leaf.where(title_cleaned_at: nil).find_each do |leaf|
+      Leaf.transaction do
+        leaf.update!(title: cleaned(leaf.title), title_cleaned_at: Time.current)
+      end
     end
   end
 
