diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..7a7fd79
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveSupport::TestCase
+  fixtures :all
+
+  def setup
+    # Give every fixture leaf a legacy wrapped title so we can verify cleanup.
+    Leaf.update_all("title = '\"' || title || '\"'")
+    Leaf.update_all(title_cleaned_at: nil)
+  end
+
+  test "cleans wrapping quotes from every leaf title" do
+    TitleCleanupJob.perform_now
+
+    Leaf.find_each do |leaf|
+      assert_not leaf.title.start_with?('"'), "#{leaf.title} still starts with a quote"
+      assert_not leaf.title.end_with?('"'),   "#{leaf.title} still ends with a quote"
+      assert_not_nil leaf.title_cleaned_at
+    end
+  end
+
+  test "preserves inner quotes in titles that legitimately open with a quoted phrase" do
+    leaf = leaves(:welcome_page)
+    # Legacy exporter wrapped the already-quoted title: "Welcome" → ""Welcome""
+    leaf.update!(title: '"Welcome to The Handbook!"', title_cleaned_at: nil)
+
+    TitleCleanupJob.perform_now
+
+    leaf.reload
+    assert_equal 'Welcome to The Handbook!', leaf.title
+  end
+
+  test "does not re-clean already processed leaves" do
+    TitleCleanupJob.perform_now
+
+    # Tamper with one cleaned title so a second run would mangle it if it
+    # touched already-cleaned leaves.
+    leaf = leaves(:welcome_page)
+    leaf.update!(title: '"Still good"')
+
+    TitleCleanupJob.perform_now
+
+    leaf.reload
+    assert_equal '"Still good"', leaf.title, "should not touch already-cleaned leaves"
+  end
+
+  test "is resumable — skips cleaned leaves and processes the rest" do
+    # Process just the first leaf, simulating a run that was interrupted after
+    # completing one leaf.
+    first = Leaf.order(:id).first
+    Leaf.transaction do
+      first.update!(title: TitleCleanupJob.new.send(:cleaned, first.title),
+                     title_cleaned_at: Time.current)
+    end
+
+    remaining = Leaf.where(title_cleaned_at: nil).count
+    assert remaining > 0, "there should be unprocessed leaves left"
+
+    # Now run the job — it should skip the first and clean the rest.
+    TitleCleanupJob.perform_now
+
+    assert_equal 0, Leaf.where(title_cleaned_at: nil).count
+    first.reload
+    assert_not first.title.start_with?('"'), "first leaf should still be clean"
+  end
+
+  test "interrupted leaf transaction rolls back so title is cleaned exactly once" do
+    leaf = leaves(:welcome_page)
+    # Title that legitimately opens with a quoted phrase, double-wrapped by
+    # the legacy exporter: "Quote" stuff → ""Quote" stuff"
+    leaf.update!(title: '""Quote" stuff"', title_cleaned_at: nil)
+
+    # Simulate a crash mid-transaction: the job updates the leaf inside a
+    # transaction, so if it raises the whole transaction rolls back.
+    assert_raises(RuntimeError) do
+      Leaf.transaction do
+        leaf.update!(title: leaf.title.delete_prefix('"').delete_suffix('"'),
+                     title_cleaned_at: Time.current)
+        raise "simulated crash before commit"
+      end
+    end
+
+    # After the crash the title should be unchanged (transaction rolled back).
+    assert_equal '""Quote" stuff"', leaf.reload.title
+    assert_nil leaf.title_cleaned_at
+
+    # Second run cleans exactly once.
+    TitleCleanupJob.perform_now
+
+    leaf.reload
+    assert_equal '"Quote" stuff', leaf.title, "inner quotes must survive a single clean"
+    assert_not_nil leaf.title_cleaned_at
+  end
+end
