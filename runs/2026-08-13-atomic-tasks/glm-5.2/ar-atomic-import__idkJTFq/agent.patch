--- a/app/models/concerns/batched.rb
+++ b/app/models/concerns/batched.rb
@@ -5,8 +5,11 @@ module Batched
     # Runs a batch of writes as a single unit of work: either the whole batch
     # lands or none of it does. The manifest importer goes through here so
     # that a rejected manifest leaves the book exactly as it was before the
-    # attempt.
+    # attempt — even when the import is nested inside a larger transaction
+    # (e.g. the nightly bulk importer). `requires_new: true` forces a real
+    # sub-transaction (a savepoint when nested) so a rollback here only
+    # undoes this batch, never the surrounding work.
     def as_one_batch(&block)
-      self.class.transaction(&block)
+      self.class.transaction(requires_new: true, &block)
     end
 end
diff --git a/test/models/import_manifest_test.rb b/test/models/import_manifest_test.rb
new file mode 100644
index 0000000..176a8cf
--- /dev/null
+++ b/test/models/import_manifest_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class ImportManifestTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:manual)
+  end
+
+  test "fully valid manifest imports all entries in order" do
+    entries = [
+      { title: "First",  body: "Body one" },
+      { title: "Second", body: "Body two" },
+      { title: "Third",  body: "Body three" }
+    ]
+
+    assert @book.import_manifest(entries), "valid manifest should return truthy"
+
+    titles = @book.leaves.order(:id).map(&:title).last(3)
+    assert_equal %w[ First Second Third ], titles
+  end
+
+  test "manifest with bad entry partway through imports nothing" do
+    entries = [
+      { title: "Alpha", body: "Body a" },
+      { title: "",      body: "Bad" },
+      { title: "Gamma", body: "Body c" }
+    ]
+
+    assert_not @book.import_manifest(entries), "invalid manifest should return falsy"
+
+    assert_not_includes @book.leaves.map(&:title), "Alpha"
+    assert_not_includes @book.leaves.map(&:title), "Gamma"
+    assert @book.leaves.count.zero?, "no sections should be left behind"
+  end
+
+  test "manifest with a duplicate title is a rejection, not a crash" do
+    @book.import_manifest([{ title: "Unique", body: "first" }])
+
+    entries = [
+      { title: "Other",  body: "ok" },
+      { title: "Unique", body: "dup" }
+    ]
+
+    assert_not @book.import_manifest(entries)
+
+    titles = @book.leaves.map(&:title)
+    assert_includes titles, "Unique"
+    assert_not_includes titles, "Other"
+  end
+
+  test "bulk importer keeps other books' work when one manifest is rejected" do
+    good_book = books(:manual)
+    bad_book  = books(:handbook)
+
+    good_entries = [{ title: "Nightly", body: "ok" }]
+    bad_entries  = [
+      { title: "One", body: "fine" },
+      { title: "",    body: "bad" }
+    ]
+
+    result = BulkImport.new(good_book => good_entries, bad_book => bad_entries).run
+
+    assert_includes result.imported, good_book
+    assert_includes result.rejected, bad_book
+
+    assert_includes good_book.leaves.map(&:title), "Nightly"
+    assert bad_book.leaves.where(title: "One").none?, "rejected manifest left a section behind"
+  end
+end
