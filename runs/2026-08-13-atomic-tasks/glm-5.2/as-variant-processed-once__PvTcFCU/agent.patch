diff --git a/test/models/picture_test.rb b/test/models/picture_test.rb
index 18a2a56..cef5311 100644
--- a/test/models/picture_test.rb
+++ b/test/models/picture_test.rb
@@ -23,4 +23,20 @@ class PictureTest < ActiveSupport::TestCase
 
     assert_equal picture.image, picture.large_image
   end
+
+  test "large variant is not processed twice after background job runs" do
+    picture = pictures(:reading)
+    blob = picture.image.blob
+
+    # Simulate the background job processing the variant
+    blob.representation(picture.image.variant(:large).variation.transformations).processed
+
+    assert_equal 1, blob.variant_records.count, "Background job creates one variant record"
+
+    # Simulate what the representations controller does when a reader requests the image
+    variation_key = picture.large_image.variation.key
+    blob.representation(variation_key).processed
+
+    assert_equal 1, blob.variant_records.count, "Reader request should not create a duplicate variant record"
+  end
 end
