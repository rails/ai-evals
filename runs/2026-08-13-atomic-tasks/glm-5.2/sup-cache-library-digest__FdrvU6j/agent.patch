+require "test_helper"
+
+class User::LibraryDigestTest < ActiveSupport::TestCase
+  def setup
+    @old_store = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    Rails.cache.clear
+  end
+
+  def teardown
+    Rails.cache = @old_store
+  end
+
+  test "library_digest does not leak between users" do
+    david_digest = users(:david).library_digest
+    kevin_digest = users(:kevin).library_digest
+
+    assert_includes david_digest.map { |b| b[:id] }, books(:manual).id
+    assert_not_includes kevin_digest.map { |b| b[:id] }, books(:manual).id,
+                        "Kevin should not see books he has no access to"
+  end
+
+  test "library_digest is cached per user" do
+    user = users(:david)
+    digest1 = user.library_digest
+
+    call_count = 0
+    user.define_singleton_method(:books) do
+      call_count += 1
+      super()
+    end
+
+    digest2 = user.library_digest
+
+    assert_equal digest1, digest2
+    assert_equal 0, call_count, "digest should be served from cache, not rebuilt"
+  end
+
+  test "library_digest entries have id, title, and leaf_count" do
+    digest = users(:david).library_digest
+
+    digest.each do |entry|
+      assert_equal [:id, :title, :leaf_count].sort, entry.keys.sort
+    end
+  end
+
+  test "library_digest reflects access changes after cache expiry" do
+    david = users(:david)
+    assert_includes david.library_digest.map { |b| b[:id] }, books(:manual).id
+
+    accesses(:david_manual).destroy
+
+    assert_includes david.library_digest.map { |b| b[:id] }, books(:manual).id,
+                    "cache should still hold old data within the hour"
+
+    Rails.cache.clear
+
+    assert_not_includes david.library_digest.map { |b| b[:id] }, books(:manual).id,
+                        "after cache expiry, digest should reflect new access"
+  end
+end
