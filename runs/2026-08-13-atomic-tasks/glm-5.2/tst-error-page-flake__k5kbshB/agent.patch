diff --git a/config/application.rb b/config/application.rb
index 8cbd4c6..274063e 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -26,5 +26,18 @@ module Writebook
 
     # Opt in to 8.0 timezone behavior
     config.active_support.to_time_preserves_timezone = :zone
+
+    # Allow `action_dispatch.show_exceptions` to be overridden per-thread so
+    # that tests (which run in parallel threads) can temporarily force
+    # exceptions to be raised instead of rendered without leaking state to
+    # other threads.  See `with_raised_exceptions` in test_helper.rb.
+    def env_config
+      @app_env_config_without_show_exceptions ||=
+        super.except("action_dispatch.show_exceptions")
+      @app_env_config_without_show_exceptions.merge(
+        "action_dispatch.show_exceptions" =>
+          Thread.current[:action_dispatch_show_exceptions] || config.action_dispatch.show_exceptions
+      )
+    end
   end
 end
diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..10bb9b6 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -13,11 +13,11 @@ module ActiveSupport
     include SessionTestHelper
 
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      previous = Thread.current[:action_dispatch_show_exceptions]
+      Thread.current[:action_dispatch_show_exceptions] = :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      Thread.current[:action_dispatch_show_exceptions] = previous
     end
   end
 end
