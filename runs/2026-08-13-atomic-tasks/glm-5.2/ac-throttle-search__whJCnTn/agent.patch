--- /dev/null
+++ b/lib/rate_limiter.rb
@@ -0,0 +1,35 @@
+class RateLimiter
+  def initialize(limit:, window:)
+    @limit = limit
+    @window = window
+    @hits = {}
+    @mutex = Mutex.new
+  end
+
+  def throttle?(key)
+    now = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+    cutoff = now - @window
+
+    @mutex.synchronize do
+      times = @hits[key]
+      times&.reject! { |t| t <= cutoff }
+
+      if times && times.size >= @limit
+        true
+      else
+        (@hits[key] ||= []) << now
+        false
+      end
+    end
+  end
+
+  def reset(key = nil)
+    @mutex.synchronize do
+      if key
+        @hits.delete(key)
+      else
+        @hits.clear
+      end
+    end
+  end
+end
