diff --git a/app/controllers/searches_controller.rb b/app/controllers/searches_controller.rb
index 153d542..d387a8d 100644
--- a/app/controllers/searches_controller.rb
+++ b/app/controllers/searches_controller.rb
@@ -11,11 +11,20 @@ class SearchesController < ApplicationController
   private
     def matching_leaves
       Leaf.active.joins(:book)
-        .where("books.id in (#{readable_book_ids.join(",")}) and leaves.title like '%#{@query}%'")
+        .where("books.id IN (?) AND leaves.title LIKE ? ESCAPE '\\'", readable_book_ids, "%#{escaped_query}%")
         .order("books.title", "leaves.position_score")
         .limit(RESULT_LIMIT)
     end
 
+    # Escape LIKE pattern syntax so % and _ are treated as literal characters,
+    # not wildcards. Backslash is the escape character (ESCAPE '\' in the SQL).
+    def escaped_query
+      @query
+        .gsub("\\") { "\\\\" }
+        .gsub("%")  { "\\%"  }
+        .gsub("_")  { "\\_"  }
+    end
+
     def readable_book_ids
       Book.accessable_or_published.ids.presence || [ 0 ]
     end
