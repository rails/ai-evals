diff --git a/test/controllers/security_fixes_test.rb b/test/controllers/security_fixes_test.rb
new file mode 100644
index 0000000..dcd975e
--- /dev/null
+++ b/test/controllers/security_fixes_test.rb
@@ -0,0 +1,135 @@
+require "test_helper"
+
+class SecurityFixesTest < ActionDispatch::IntegrationTest
+  # PT-01: Privilege escalation — member cannot grant themselves administrator role
+  test "PT-01: member cannot escalate role via profile update" do
+    sign_in :kevin
+
+    put user_profile_url(users(:kevin)), params: { user: { name: "Kevin", role: "administrator" } }
+
+    assert_redirected_to users_url
+    assert_equal "member", users(:kevin).reload.role
+  end
+
+  test "PT-01: profile update still allows name, email, password changes" do
+    sign_in :kevin
+
+    put user_profile_url(users(:kevin)), params: { user: { name: "New Name", email_address: "new@example.com", password: "newpassword123" } }
+
+    assert_redirected_to users_url
+    assert_equal "New Name", users(:kevin).reload.name
+    assert_equal "new@example.com", users(:kevin).email_address
+  end
+
+  # PT-02: Missing authorisation — reader cannot destroy a book
+  test "PT-02: reader cannot destroy a book" do
+    sign_in :jz  # jz is a reader of handbook
+
+    delete book_url(books(:handbook))
+
+    assert_response :forbidden
+    assert Book.exists?(books(:handbook).id)
+  end
+
+  test "PT-02: editor can still destroy a book" do
+    sign_in :kevin  # kevin is an editor of handbook
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_url(books(:handbook))
+    end
+  end
+
+  # PT-03: SQL injection in library search — apostrophe should not cause error
+  test "PT-03: apostrophe in search does not cause server error" do
+    books(:manual).update!(published: true)
+    sign_in :kevin
+
+    get library_search_url, params: { q: "it's" }
+
+    assert_response :success
+  end
+
+  test "PT-03: search results only include readable books" do
+    books(:manual).update!(published: false)
+    sign_in :kevin  # kevin has no access to manual
+
+    # Search for something that matches manual's leaves but kevin can't read
+    Leaf.create!(book: books(:manual), title: "Secret Manual Page", leafable: Page.new(body: "secret content"))
+
+    get library_search_url, params: { q: "Secret" }
+
+    assert_response :success
+    assert_not_in_body "Secret Manual Page"
+  end
+
+  # PT-04: LIKE wildcards — % and _ should be treated as literals
+  test "PT-04: percent sign is treated as literal, not wildcard" do
+    sign_in :kevin
+    special_leaf = Leaf.create!(book: books(:handbook), title: "Save 50% off", leafable: Page.new(body: "content"))
+
+    get library_search_url, params: { q: "50%" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+
+    # A percent alone should find it
+    get library_search_url, params: { q: "%" }
+    assert_response :success
+    assert_in_body "Save 50% off"
+
+    special_leaf.destroy
+  end
+
+  test "PT-04: percent sign does not act as wildcard matching everything" do
+    sign_in :kevin
+    special_leaf = Leaf.create!(book: books(:handbook), title: "Save 50% off", leafable: Page.new(body: "content"))
+
+    # Searching for just % should only match pages with % in the title, not everything
+    get library_search_url, params: { q: "%" }
+    assert_response :success
+    # Should find the page with % in title
+    assert_in_body "Save 50% off"
+    # Should NOT find pages without % in title
+    assert_not_in_body "Welcome to The Handbook"
+
+    special_leaf.destroy
+  end
+
+  test "PT-04: underscore is treated as literal, not wildcard" do
+    sign_in :kevin
+    special_leaf = Leaf.create!(book: books(:handbook), title: "under_score", leafable: Page.new(body: "content"))
+
+    get library_search_url, params: { q: "under_score" }
+    assert_response :success
+    assert_in_body "under_score"
+
+    special_leaf.destroy
+  end
+
+  # PT-05: IDOR — cannot read pages from inaccessible books via different book id
+  test "PT-05: page from inaccessible book is not readable via different book id" do
+    sign_in :kevin  # kevin has no access to manual
+
+    # Try to access manual's page under handbook's book_id
+    manual_page = leaves(:welcome_page)  # belongs to handbook, kevin has access
+    manual_leaf = Leaf.create!(book: books(:manual), title: "Manual Secret", leafable: Page.new(body: "secret"))
+
+    # Access a manual leaf using handbook's book_id in URL
+    get book_page_url(books(:handbook), manual_leaf)
+
+    assert_response :not_found
+  end
+
+  test "PT-05: page from accessible book is still readable" do
+    sign_in :kevin  # kevin is editor of handbook
+
+    get book_page_url(books(:handbook), leaves(:welcome_page))
+    assert_response :success
+  end
+
+  test "PT-05: pages readable when signed out for published books" do
+    books(:handbook).update!(published: true)
+
+    get book_page_url(books(:handbook), leaves(:welcome_page))
+    assert_response :success
+  end
+end
