diff --git a/test/models/user_erasure_test.rb b/test/models/user_erasure_test.rb
new file mode 100644
index 0000000..4da709d
--- /dev/null
+++ b/test/models/user_erasure_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class UserErasureTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+  end
+
+  test "erase! removes the user row entirely" do
+    @user.erase!
+
+    assert_nil User.find_by(id: @user.id)
+  end
+
+  test "erase! removes sessions and accesses" do
+    Session.create!(user: @user, token: "abc", last_active_at: Time.now, user_agent: "ua", ip_address: "1.1.1.1")
+
+    assert_difference -> { Session.where(user_id: @user.id).count }, -1 do
+      @user.erase!
+    end
+
+    assert_empty Access.where(user_id: @user.id)
+  end
+
+  test "erase! removes reading marks" do
+    leaf = leaves(:welcome_page)
+    ReadingMark.create!(user: @user, leaf: leaf, last_read_at: Time.now)
+
+    @user.erase!
+
+    assert_empty ReadingMark.where(user_id: @user.id)
+  end
+
+  test "erase! destroys private created books and their search index entries" do
+    private_book = Book.create!(title: "Kevin's secret", author: "Kevin", everyone_access: false, creator: @user)
+    leaf = private_book.leaves.create!(title: "Secret page", leafable: Page.create!, position_score: 1, status: :active)
+    leaf.reindex
+
+    assert Leaf.connection.execute("select rowid from leaf_search_index where rowid = #{leaf.id}").present?
+
+    @user.erase!
+
+    assert_nil Book.find_by(id: private_book.id)
+    assert_nil Leaf.find_by(id: leaf.id)
+    assert_empty Leaf.connection.execute("select rowid from leaf_search_index where rowid = #{leaf.id}")
+  end
+
+  test "erase! keeps everyone-access books but bylines them as Deleted author and nullifies creator" do
+    public_book = Book.create!(title: "Kevin's shared", author: "Kevin", everyone_access: true, creator: @user)
+
+    @user.erase!
+
+    public_book.reload
+    assert_equal "Deleted author", public_book.author
+    assert_nil public_book.creator_id
+  end
+
+  test "erase! removes sign-in events for the user's email address" do
+    SignInEvent.create!(email_address: @user.email_address, action: :signed_in, ip_address: "1.1.1.1", user_agent: "ua")
+
+    @user.erase!
+
+    assert_empty SignInEvent.for_address(@user.email_address)
+  end
+
+  test "erase! works for a previously deactivated user and clears sign-in events under their original address" do
+    original_address = @user.email_address
+    SignInEvent.create!(email_address: original_address, action: :signed_in, ip_address: "1.1.1.1", user_agent: "ua")
+
+    @user.deactivate
+    scrambled = @user.reload.email_address
+    assert_not_equal original_address, scrambled
+
+    @user.erase!
+
+    assert_nil User.find_by(id: @user.id)
+    assert_empty SignInEvent.for_address(original_address)
+    assert_empty SignInEvent.for_address(scrambled)
+  end
+end
