@@ -33,4 +49,35 @@ class User < ApplicationRecord
       all_accesses = Book.with_everyone_access.ids.collect { |id| { book_id: id, level: :reader } }
       accesses.insert_all(all_accesses)
     end
+
+    def erase_created_books!
+      created_books.each do |book|
+        if book.everyone_access?
+          book.update!(creator: nil, author: DELETED_AUTHOR_BYLINE)
+        else
+          book.destroy
+        end
+      end
+      # Clear the cached association so the dependent: :destroy callback on
+      # destroy! does not revisit books we chose to keep.
+      created_books.reset
+    end
+
+    def erase_sign_in_events!
+      SignInEvent.for_address(email_addresses_to_erase).delete_all
+    end
+
+    def email_addresses_to_erase
+      addresses = [ email_address ]
+      addresses << original_email_address if deactivated_email?
+      addresses
+    end
+
+    def deactivated_email?
+      email_address&.match?(DEACTIVATED_EMAIL_PATTERN)
+    end
+
+    def original_email_address
+      email_address.sub(DEACTIVATED_EMAIL_PATTERN, "@")
+    end
 end
