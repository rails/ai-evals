+require "test_helper"
+
+class LibraryDigestCrossContaminationTest < ActiveSupport::TestCase
+  def setup
+    # Use a real cache store so caching is exercised
+    @original_cache = Rails.cache
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+  end
+
+  def teardown
+    Rails.cache = @original_cache
+  end
+
+  test "library_digest does not leak between users" do
+    david = users(:david)
+    jz    = users(:jz)
+
+    # David has handbook and manual; JZ has handbook and manual too.
+    # Let's give david a book that jz does NOT have access to.
+    secret_book = Book.create!(title: "Secret Book", slug: "secret")
+    Access.create!(user: david, book: secret_book, level: :editor)
+
+    # David opens his overview first
+    david_digest = david.library_digest
+    david_ids = david_digest.map { |b| b[:id] }
+
+    # Now JZ opens his overview — should NOT see david's secret book
+    jz_digest = jz.library_digest
+    jz_ids = jz_digest.map { |b| b[:id] }
+
+    assert_not_includes jz_ids, secret_book.id,
+      "JZ should not see David's secret book in their library digest"
+    assert_includes david_ids, secret_book.id,
+      "David should see his secret book"
+  end
+
+  test "library_digest is cached for the same user" do
+    david = users(:david)
+    Rails.cache.clear
+
+    # First call populates cache
+    first = david.library_digest
+    # Delete all books to ensure second call uses cache, not DB
+    Book.destroy_all
+
+    second = david.library_digest
+    assert_equal first, second, "Second call should return cached result"
+  end
+end
