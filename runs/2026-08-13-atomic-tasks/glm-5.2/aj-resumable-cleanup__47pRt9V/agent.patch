--- /dev/null
+++ b/db/migrate/20260807211601_add_title_cleanup_tracking_to_leaves.rb
@@ -0,0 +1,8 @@
+class AddTitleCleanupTrackingToLeaves < ActiveRecord::Migration[8.2]
+  def change
+    add_column :leaves, :title_cleaned_at, :datetime
+    # Speeds up resuming the cleanup job, which only ever queries for
+    # leaves whose titles have not been cleaned yet.
+    add_index :leaves, :title_cleaned_at, where: "title_cleaned_at IS NULL"
+  end
+end
