@@ -2,11 +2,30 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    before_update :remember_was_published, unless: :was_published_remembered?
+    after_update_commit :announce_publication, if: :newly_published?
+    after_update_commit :forget_was_published
+    after_rollback :forget_was_published
   end
 
   private
     def announce_publication
       AnnouncePublicationJob.perform_later self
     end
+
+    def newly_published?
+      defined?(@was_published) && !@was_published && published?
+    end
+
+    def remember_was_published
+      @was_published = published_was
+    end
+
+    def was_published_remembered?
+      defined?(@was_published)
+    end
+
+    def forget_was_published
+      remove_instance_variable(:@was_published) if defined?(@was_published)
+    end
 end
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..a709b63
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:manual)
+    @book.update!(published: false)
+    @book.reload
+  end
+
+  def track_announcements
+    announcements = []
+    original = AnnouncePublicationJob.method(:perform_later)
+    AnnouncePublicationJob.define_singleton_method(:perform_later) do |book|
+      announcements << book
+    end
+    yield
+    announcements
+  ensure
+    AnnouncePublicationJob.define_singleton_method(:perform_later, &original) if original
+  end
+
+  test "publishing a book announces exactly once" do
+    announcements = track_announcements do
+      @book.update!(published: true)
+    end
+    assert_equal [@book], announcements
+  end
+
+  test "publishing a book and adding a page in the same sitting announces exactly once" do
+    announcements = track_announcements do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.press Page.new(body: ""), { title: "New Page" }
+      end
+    end
+    assert_equal [@book], announcements
+  end
+
+  test "unpublishing a live book does not announce" do
+    @book.update!(published: true)
+    @book.reload
+
+    announcements = track_announcements do
+      @book.update!(published: false)
+    end
+    assert_equal [], announcements
+  end
+
+  test "saving an already-live book does not announce again" do
+    @book.update!(published: true)
+    @book.reload
+
+    announcements = track_announcements do
+      @book.update!(title: "Updated Title")
+    end
+    assert_equal [], announcements
+  end
+
+  test "saving an already-live book with page changes does not announce" do
+    @book.update!(published: true)
+    @book.reload
+
+    announcements = track_announcements do
+      @book.transaction do
+        @book.press Page.new(body: ""), { title: "Another Page" }
+      end
+    end
+    assert_equal [], announcements
+  end
+
+  test "a sitting that fails after marking live leaves a draft and no announcement" do
+    announcements = track_announcements do
+      assert_raises(RuntimeError) do
+        @book.transaction do
+          @book.update!(published: true)
+          raise "something went wrong"
+        end
+      end
+    end
+    assert_not @book.reload.published?
+    assert_equal [], announcements
+  end
+
+  test "a draft saved without publishing announces nothing" do
+    announcements = track_announcements do
+      @book.update!(title: "Draft Title Change")
+    end
+    assert_equal [], announcements
+  end
+  test "publishing a book and adding multiple pages in the same sitting announces exactly once" do
+    announcements = track_announcements do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.press Page.new(body: ""), { title: "Page One" }
+        @book.press Page.new(body: ""), { title: "Page Two" }
+        @book.press Page.new(body: ""), { title: "Page Three" }
+      end
+    end
+    assert_equal [@book], announcements
+  end
+
+  test "publishing and then unpublishing in the same sitting announces nothing" do
+    announcements = track_announcements do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.update!(published: false)
+      end
+    end
+    assert_equal [], announcements
+  end
+
+  test "unpublishing and then re-publishing an already-live book in the same sitting announces nothing" do
+    @book.update!(published: true)
+    @book.reload
+
+    announcements = track_announcements do
+      @book.transaction do
+        @book.update!(published: false)
+        @book.update!(published: true)
+      end
+    end
+    assert_equal [], announcements
+  end
+end
