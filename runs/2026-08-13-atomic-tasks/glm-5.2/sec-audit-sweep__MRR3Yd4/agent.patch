+
+    # Escape LIKE pattern syntax so % and _ are treated as literal characters,
+    # not wildcards. The escape character itself must be escaped first.
+    def escape_like_pattern(term)
+      term.to_s.gsub(LIKE_ESCAPE_CHARACTER, LIKE_ESCAPE_CHARACTER * 2)
+          .gsub("%", "#{LIKE_ESCAPE_CHARACTER}%")
+          .gsub("_", "#{LIKE_ESCAPE_CHARACTER}_")
+    end
 end
