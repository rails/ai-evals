diff --git a/test/controllers/books_caching_test.rb b/test/controllers/books_caching_test.rb
new file mode 100644
index 0000000..e4d4a58
--- /dev/null
+++ b/test/controllers/books_caching_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class BooksCachingTest < ActionDispatch::IntegrationTest
+  def with_caching
+    old_caching = ActionController::Base.perform_caching
+    ActionController::Base.perform_caching = true
+    old_store = Rails.cache
+    cache_store = ActiveSupport::Cache::MemoryStore.new
+    Rails.cache = cache_store
+    old_collection_cache = ActionView::PartialRenderer.collection_cache
+    ActionView::PartialRenderer.collection_cache = cache_store
+    Rails.cache.clear
+    yield
+  ensure
+    ActionController::Base.perform_caching = old_caching
+    Rails.cache = old_store
+    ActionView::PartialRenderer.collection_cache = old_collection_cache
+    Rails.cache.clear
+  end
+
+  test "reader does not see editor controls after an editor opened the book" do
+    with_caching do
+      # Editor opens the book first — caches the leaf partials with edit controls
+      sign_in :kevin
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_in_body "Edit Welcome to The Handbook!"
+      sign_out
+
+      # Reader opens the same book — should NOT see edit controls
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_not_in_body "Edit Welcome to The Handbook!"
+      assert_in_body "Open Welcome to The Handbook!"
+    end
+  end
+
+  test "editor sees controls after a reader opened the book" do
+    with_caching do
+      # Reader opens the book first — caches without edit controls
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_not_in_body "Edit Welcome to The Handbook!"
+      assert_in_body "Open Welcome to The Handbook!"
+      sign_out
+
+      # Editor opens the same book — should see edit controls
+      sign_in :kevin
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_in_body "Edit Welcome to The Handbook!"
+    end
+  end
+
+  test "renamed entry shows its new title to the next person" do
+    with_caching do
+      # Editor opens and caches the book
+      sign_in :kevin
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_in_body "Welcome to The Handbook!"
+      sign_out
+
+      # Editor renames a leaf
+      sign_in :kevin
+      patch leafable_path(leaves(:welcome_page), format: :turbo_stream), params: {
+        leaf: { title: "Brand New Title" }, page: { body: "This is such a great handbook." }
+      }
+      assert_response :success
+      sign_out
+
+      # Reader opens the book — should see the new title
+      sign_in :jz
+      get book_slug_path(books(:handbook))
+      assert_response :success
+      assert_in_body "Brand New Title"
+      assert_not_in_body "Welcome to The Handbook!"
+    end
+  end
+end
