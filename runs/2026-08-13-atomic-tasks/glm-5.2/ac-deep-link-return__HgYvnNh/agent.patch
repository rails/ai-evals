+
+    def safe_return_to
+      return_to = params[:return_to].presence
+      return unless return_to
+
+      uri = URI.parse(return_to)
+      # Only allow relative paths (starting with a single /) or URLs
+      # pointing at our own host. Reject everything else to prevent
+      # open-redirect attacks.
+      if uri.host.present?
+        return_to if uri.host == request.host
+      elsif return_to.start_with?("/") && !return_to.start_with?("//")
+        return_to
+      end
+    rescue URI::InvalidURIError
+      nil
+    end
 end
