diff --git a/test/controllers/being_edited_broadcast_test.rb b/test/controllers/being_edited_broadcast_test.rb
new file mode 100644
index 0000000..1cc93d1
--- /dev/null
+++ b/test/controllers/being_edited_broadcast_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class BeingEditedBroadcastTest < ActionDispatch::IntegrationTest
+  include ActionCable::TestHelper
+
+  setup do
+    sign_in :kevin
+  end
+
+  def stream_name_for(leaf, user)
+    Turbo::StreamsChannel.signed_stream_name([ leaf, :being_edited, user ]).then do |signed|
+      Turbo::StreamsChannel.verified_stream_name(signed)
+    end
+  end
+
+  test "being_edited indicator broadcasts to each user with access individually" do
+    leaf = leaves(:welcome_page)
+    book = books(:handbook)
+
+    book.accesses.includes(:user).each do |access|
+      user = access.user
+      name = stream_name_for(leaf, user)
+
+      assert_broadcasts(name, 1) do
+        perform_enqueued_jobs(only: Turbo::Streams::BroadcastJob) do
+          put leafable_path(leaf), params: { leaf: { title: "Updated" }, page: { body: "New body" } }
+        end
+      end
+    end
+  end
+
+  test "being_edited indicator does not broadcast to a removed collaborator" do
+    leaf = leaves(:welcome_page)
+    book = books(:handbook)
+    jz = users(:jz)
+
+    # JZ currently has reader access to the handbook
+    assert book.accessable?(user: jz)
+
+    # Remove JZ's access entirely
+    book.accesses.where(user: jz).delete_all
+    assert_not book.accessable?(user: jz)
+
+    # The stream JZ would be listening on should NOT receive a broadcast
+    jz_stream = stream_name_for(leaf, jz)
+
+    assert_broadcasts(jz_stream, 0) do
+      perform_enqueued_jobs(only: Turbo::Streams::BroadcastJob) do
+        put leafable_path(leaf), params: { leaf: { title: "Updated again" }, page: { body: "Newer body" } }
+      end
+    end
+  end
+
+  test "being_edited indicator broadcasts to administrators without access records" do
+    # Use a book without everyone_access so admins don't auto-get access records
+    book = Book.create!(title: "Admin Test Book", everyone_access: false)
+    leaf = book.leaves.create!(title: "Test Page", leafable: Page.new(body: "Hello"))
+    admin = User.create!(name: "Admin Test", email_address: "admin_test@example.com",
+                          password: "secret123456", role: :administrator)
+
+    assert_not book.accessable?(user: admin)
+    assert admin.administrator?
+    assert book.editable?(user: admin)
+
+    admin_stream = stream_name_for(leaf, admin)
+
+    # Sign in as the book creator to edit
+    sign_in :david
+    # Give david editor access
+    book.update_access(editors: [ users(:david).id ], readers: [])
+
+    assert_broadcasts(admin_stream, 1) do
+      perform_enqueued_jobs(only: Turbo::Streams::BroadcastJob) do
+        put leafable_path(leaf), params: { leaf: { title: "Updated by admin" }, page: { body: "Admin body" } }
+      end
+    end
+  end
+
+  test "edit page includes current user in the being_edited turbo stream subscription" do
+    leaf = leaves(:welcome_page)
+    kevin = users(:kevin)
+
+    get edit_leafable_path(leaf)
+
+    assert_response :success
+    assert_select "turbo-cable-stream-source" do |elements|
+      signed_stream = elements.first["signed-stream-name"]
+      assert signed_stream.present?
+      decoded = Turbo::StreamsChannel.verified_stream_name(signed_stream)
+      assert_includes decoded, kevin.to_gid_param
+    end
+  end
+end
