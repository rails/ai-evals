diff --git a/test/controllers/books_caching_test.rb b/test/controllers/books_caching_test.rb
new file mode 100644
index 0000000..a567074
--- /dev/null
+++ b/test/controllers/books_caching_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class BooksCachingTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_perform_caching = ActionController::Base.perform_caching
+    @original_cache_store = Rails.cache
+    @original_collection_cache = ActionView::PartialRenderer.collection_cache
+    ActionController::Base.perform_caching = true
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    ActionView::PartialRenderer.collection_cache = Rails.cache
+  end
+
+  teardown do
+    ActionController::Base.perform_caching = @original_perform_caching
+    Rails.cache = @original_cache_store
+    ActionView::PartialRenderer.collection_cache = @original_collection_cache
+  end
+
+  test "reader does not see editor controls after an editor opened the book" do
+    # Editor opens the book first
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    # Editor should see edit controls (2 per leaf: thumbnail + title)
+    assert_select "a[href='#{edit_leafable_path(leaves(:welcome_page))}']", count: 2
+
+    # Now a reader opens the same book
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    # Reader should NOT see edit controls
+    assert_select "a[href='#{edit_leafable_path(leaves(:welcome_page))}']", count: 0
+  end
+
+  test "editor sees controls after a reader opened the book" do
+    # Reader opens the book first
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    # Reader should NOT see edit controls
+    assert_select "a[href='#{edit_leafable_path(leaves(:welcome_page))}']", count: 0
+
+    # Now an editor opens the same book
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    # Editor should see edit controls
+    assert_select "a[href='#{edit_leafable_path(leaves(:welcome_page))}']", count: 2
+  end
+
+  test "renamed entry shows new title to the next person" do
+    sign_in :kevin
+    # Rename a leaf
+    patch leafable_path(leaves(:welcome_page), format: :turbo_stream), params: {
+      leaf: { title: "New Welcome Title" }
+    }
+    assert_response :success
+
+    # Clear caches to simulate a fresh page load
+    Rails.cache.clear
+
+    # Another user opens the book
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    # Should see the new title
+    assert_select "span.overflow-ellipsis", text: "New Welcome Title"
+  end
+end
