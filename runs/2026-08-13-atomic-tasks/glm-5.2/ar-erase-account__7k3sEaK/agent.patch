diff --git a/test/models/user_erasure_test.rb b/test/models/user_erasure_test.rb
new file mode 100644
index 0000000..1ddadb9
--- /dev/null
+++ b/test/models/user_erasure_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class UserErasureTest < ActiveSupport::TestCase
+  setup do
+    Leaf.reindex_all
+  end
+
+  test "erase removes the user row entirely" do
+    kevin = users(:kevin)
+    kevin.erase!
+
+    assert_nil User.find_by(id: kevin.id)
+  end
+
+  test "erase removes sessions" do
+    kevin = users(:kevin)
+    kevin.sessions.create!(user_agent: "Test", ip_address: "127.0.0.1")
+
+    kevin.erase!
+
+    assert_empty Session.where(user_id: kevin.id)
+  end
+
+  test "erase removes accesses" do
+    kevin = users(:kevin)
+    kevin.erase!
+
+    assert_empty Access.where(user_id: kevin.id)
+  end
+
+  test "erase removes reading marks" do
+    kevin = users(:kevin)
+    ReadingMark.remember(leaves(:welcome_page), user: kevin)
+
+    kevin.erase!
+
+    assert_empty ReadingMark.where(user_id: kevin.id)
+  end
+
+  test "erase removes sign-in events under the user's email" do
+    kevin = users(:kevin)
+    SignInEvent.create!(action: :signed_in, email_address: kevin.email_address, ip_address: "127.0.0.1", user_agent: "Test")
+
+    kevin.erase!
+
+    assert_empty SignInEvent.for_address(kevin.email_address)
+  end
+
+  test "erase removes sign-in events under the original email for already-deactivated users" do
+    kevin = users(:kevin)
+    original_email = kevin.email_address
+    SignInEvent.create!(action: :signed_in, email_address: original_email, ip_address: "127.0.0.1", user_agent: "Test")
+
+    # Simulate old-style deactivation
+    kevin.update!(active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com")
+
+    kevin.reload.erase!
+
+    assert_empty SignInEvent.for_address(original_email)
+  end
+
+  test "erase destroys non-everyone books created by the user" do
+    kevin = users(:kevin)
+    private_book = Book.create!(title: "Kevin's Secret", creator: kevin, everyone_access: false)
+    section = Section.new(body: "private content to search")
+    private_book.press(section, title: "Private Page")
+
+    kevin.erase!
+
+    assert_nil Book.find_by(id: private_book.id)
+    assert_empty Leaf.search("private content")
+  end
+
+  test "erase keeps everyone-access books but anonymizes the creator and byline" do
+    kevin = users(:kevin)
+    shared_book = Book.create!(title: "Kevin's Shared Book", creator: kevin, everyone_access: true, author: "Kevin")
+    shared_book.reload
+
+    kevin.erase!
+
+    shared_book.reload
+    assert_nil shared_book.creator_id
+    assert_equal "Deleted author", shared_book.author
+  end
+
+  test "erase leaves no stale search hits from destroyed books" do
+    kevin = users(:kevin)
+    private_book = Book.create!(title: "UniqueBook", creator: kevin, everyone_access: false)
+    section = Section.new(body: "veryuniquesearchterm")
+    private_book.press(section, title: "Unique Page")
+
+    assert_not_empty Leaf.search("veryuniquesearchterm")
+
+    kevin.erase!
+
+    assert_empty Leaf.search("veryuniquesearchterm")
+  end
+end
