 class User < ApplicationRecord
   include Authoring, Role, Transferable
 
+  DELETED_AUTHOR_BYLINE = "Deleted author"
+  DEACTIVATED_EMAIL_PATTERN = /-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}@/
+
   has_many :sessions, dependent: :destroy
   has_secure_password validations: false
 
@@ -17,16 +20,50 @@ class User < ApplicationRecord
     self == Current.user
   end
 
-  def deactivate
+  def erase!
     transaction do
+      # Books shared with everyone keep working — take the name off and
+      # byline them as a deleted author instead of destroying them.
+      shared_books = created_books.with_everyone_access
+      shared_books.update_all(creator_id: nil, author: DELETED_AUTHOR_BYLINE)
+
+      # Everything else the user created is erased entirely. Destroying the
+      # books cascades to their leaves and purges the FTS search index.
+      created_books.destroy_all
+
+      # Remove sessions without firing callbacks so no sign-out events are
+      # recorded for a user we're about to erase.
       sessions.delete_all
-      update! active: false, email_address: deactived_email_address
+
+      # Reading marks, accesses, and remaining sessions are cleaned up.
+      reading_marks.delete_all
+      accesses.delete_all
+
+      # Sign-in events are keyed by email address, not user id. For users who
+      # were previously "removed" the old way the events sit under the address
+      # they actually signed in with, which is now mangled — recover it.
+      SignInEvent.for_address(known_email_addresses).delete_all
+
+      destroy!
     end
   end
 
   private
-    def deactived_email_address
-      email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
+    # All email addresses this user may have sign-in events recorded under:
+    # the current address, plus the original address if the user was already
+    # deactivated the old way (email rewritten to alice-deactivated-<uuid>@…).
+    def known_email_addresses
+      addresses = [ email_address ].compact
+      if original = original_email_address
+        addresses << original
+      end
+      addresses
+    end
+
+    def original_email_address
+      if email_address&.match?(DEACTIVATED_EMAIL_PATTERN)
+        email_address.sub(DEACTIVATED_EMAIL_PATTERN, "@")
+      end
     end
 
     def grant_access_to_everyone_books
