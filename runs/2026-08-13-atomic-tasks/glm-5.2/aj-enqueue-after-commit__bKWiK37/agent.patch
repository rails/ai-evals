       book_batch.each do |id, attributes|
         Book.accessable_or_published.find(id).apply_edit(attributes)
       end
-    rescue StandardError => error
-      Books::ImportFailureJob.perform_later(Current.user.id, error.message)
-      raise
     end
 
     redirect_to root_url
+  rescue StandardError => error
+    # The batch is all-or-nothing: by the time control reaches here the
+    # transaction has been rolled back and the edit jobs (deferred to
+    # `after_commit`) were never handed off. The operator must still hear
+    # that the import did not go through, so this notification is handed
+    # off outside the abandoned transaction.
+    Books::ImportFailureJob.perform_later(Current.user.id, error.message)
+    raise
   end
 
