diff --git a/app/models/book/import.rb b/app/models/book/import.rb
index 6d049dd..588535f 100644
--- a/app/models/book/import.rb
+++ b/app/models/book/import.rb
@@ -1,27 +1,43 @@
 module Book::Import
   extend ActiveSupport::Concern
 
+  # Raised from inside the batch to signal that an entry was turned away,
+  # either because it failed validation or because the book rejected it
+  # (e.g. a duplicate title). It is raised *inside* the transaction so the
+  # transaction rolls back every entry pressed so far, then rescued by
+  # import_manifest so callers see a falsy return value instead of a crash.
+  class Rejected < StandardError
+    def initialize(entry)
+      super("import rejected at #{entry.inspect}")
+    end
+  end
+
   # Imports a manifest — an array of { title:, body: } entries — into the
   # book as sections, in manifest order. Imports are all-or-nothing: a book
-  # must never be left holding part of a manifest.
+  # must never be left holding part of a manifest. A manifest carrying any
+  # invalid or rejected entry imports nothing at all and returns a falsy
+  # value; a fully valid manifest imports every entry, exactly once, and
+  # returns a truthy value.
   def import_manifest(entries)
     as_one_batch do
       entries.each do |entry|
-        return rejected(entry) unless entry_valid?(entry)
+        raise Rejected, entry unless entry_valid?(entry)
 
         press(Section.new(body: entry[:body]), title: entry[:title])
+      rescue ActiveRecord::RecordInvalid
+        # The book turned the entry away (e.g. a duplicate title). Treat it
+        # as a rejection, not a crash, so the whole manifest is rolled back.
+        raise Rejected, entry
       end
     end
     true
+  rescue Rejected => error
+    Rails.logger.warn error.message
+    false
   end
 
   private
     def entry_valid?(entry)
       entry[:title].present? && entry[:body].present?
     end
-
-    def rejected(entry)
-      Rails.logger.warn "import rejected at #{entry.inspect}"
-      false
-    end
 end
diff --git a/app/models/concerns/batched.rb b/app/models/concerns/batched.rb
index 55a53e7..5dd6140 100644
--- a/app/models/concerns/batched.rb
+++ b/app/models/concerns/batched.rb
@@ -2,11 +2,14 @@ module Batched
   extend ActiveSupport::Concern
 
   private
-    # Runs a batch of writes as a single unit of work: either the whole batch
-    # lands or none of it does. The manifest importer goes through here so
-    # that a rejected manifest leaves the book exactly as it was before the
-    # attempt.
+    # Runs a batch of writes as a single, independently rollback-able unit of
+    # work: either the whole batch lands or none of it does. `requires_new`
+    # forces a savepoint when this is nested inside another transaction, so a
+    # rejected batch is rolled back on its own without taking the surrounding
+    # transaction's work down with it. The manifest importer goes through here
+    # so that a rejected manifest leaves the book exactly as it was before the
+    # attempt — even when the import is part of something larger.
     def as_one_batch(&block)
-      self.class.transaction(&block)
+      self.class.transaction(requires_new: true, &block)
     end
 end
diff --git a/test/models/book/import_test.rb b/test/models/book/import_test.rb
new file mode 100644
index 0000000..add4305
--- /dev/null
+++ b/test/models/book/import_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Book::ImportTest < ActiveSupport::TestCase
+  setup { @book = Book.create!(title: "Import Test Book") }
+
+  test "imports every entry as a section, in manifest order" do
+    entries = [
+      { title: "First", body: "one" },
+      { title: "Second", body: "two" },
+      { title: "Third", body: "three" }
+    ]
+
+    assert @book.import_manifest(entries)
+    assert_equal 3, @book.leaves.count
+    assert_equal %w[First Second Third], @book.leaves.order(:position_score).map(&:title)
+    assert @book.leaves.all? { |leaf| leaf.leafable.is_a?(Section) }
+  end
+
+  test "returns a truthy value for a fully valid manifest" do
+    assert @book.import_manifest([{ title: "Solo", body: "only" }])
+  end
+
+  test "an empty manifest imports nothing and is truthy" do
+    assert @book.import_manifest([])
+    assert_equal 0, @book.leaves.count
+  end
+
+  test "a bad entry partway through imports nothing at all" do
+    entries = [
+      { title: "First", body: "one" },
+      { title: "", body: "bad" },
+      { title: "Third", body: "three" }
+    ]
+
+    assert_not @book.import_manifest(entries)
+    assert_equal 0, @book.leaves.count
+  end
+
+  test "a bad entry at the start imports nothing" do
+    assert_not @book.import_manifest([{ title: "", body: "bad" }, { title: "Good", body: "ok" }])
+    assert_equal 0, @book.leaves.count
+  end
+
+  test "a bad entry at the end imports nothing" do
+    assert_not @book.import_manifest([{ title: "Good", body: "ok" }, { title: "Bad", body: nil }])
+    assert_equal 0, @book.leaves.count
+  end
+
+  test "an entry duplicating an existing title is rejected, not a crash" do
+    @book.press Section.new(body: "already here"), title: "Existing"
+
+    assert_not @book.import_manifest([{ title: "Existing", body: "dup" }, { title: "Other", body: "ok" }])
+    assert_equal 1, @book.leaves.count
+    assert_equal "already here", @book.leaves.first.leafable.body
+  end
+
+  test "duplicate titles within one manifest are rejected wholesale" do
+    assert_not @book.import_manifest([{ title: "Dup", body: "a" }, { title: "Dup", body: "b" }])
+    assert_equal 0, @book.leaves.count
+  end
+
+  test "a rejected manifest can be re-run without duplicates once fixed" do
+    entries = [{ title: "First", body: "one" }, { title: "", body: "bad" }]
+    assert_not @book.import_manifest(entries)
+    assert_equal 0, @book.leaves.count
+
+    fixed = [{ title: "First", body: "one" }, { title: "Second", body: "two" }]
+    assert @book.import_manifest(fixed)
+    assert_equal %w[First Second], @book.leaves.order(:position_score).map(&:title)
+  end
+end
diff --git a/test/models/bulk_import_test.rb b/test/models/bulk_import_test.rb
new file mode 100644
index 0000000..a18bdbc
--- /dev/null
+++ b/test/models/bulk_import_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class BulkImportTest < ActiveSupport::TestCase
+  setup do
+    @good_book   = Book.create!(title: "Good Book")
+    @bad_book    = Book.create!(title: "Bad Book")
+    @other_book  = Book.create!(title: "Other Book")
+  end
+
+  test "reports imported and rejected books separately" do
+    manifests = {
+      @good_book  => [{ title: "G1", body: "g1" }],
+      @bad_book   => [{ title: "B1", body: "b1" }, { title: "", body: "bad" }],
+      @other_book => [{ title: "O1", body: "o1" }]
+    }
+
+    result = BulkImport.new(manifests).run
+
+    assert_equal [@good_book, @other_book], result.imported
+    assert_equal [@bad_book], result.rejected
+  end
+
+  test "a rejected manifest leaves nothing behind, even nested in the importer's transaction" do
+    manifests = {
+      @good_book  => [{ title: "G1", body: "g1" }],
+      @bad_book   => [{ title: "B1", body: "b1" }, { title: "", body: "bad" }, { title: "B3", body: "b3" }],
+      @other_book => [{ title: "O1", body: "o1" }]
+    }
+
+    BulkImport.new(manifests).run
+
+    assert_equal 0, @bad_book.leaves.count, "rejected book should have no sections"
+    assert_equal %w[G1], @good_book.leaves.map(&:title)
+    assert_equal %w[O1], @other_book.leaves.map(&:title)
+  end
+
+  test "a duplicate-title manifest is rejected, not a crash, and leaves nothing" do
+    @bad_book.press Section.new(body: "pre-existing"), title: "B1"
+
+    manifests = { @bad_book => [{ title: "B1", body: "dup" }, { title: "B2", body: "ok" }] }
+
+    result = BulkImport.new(manifests).run
+
+    assert_equal [@bad_book], result.rejected
+    assert_equal 1, @bad_book.leaves.count
+    assert_equal "pre-existing", @bad_book.leaves.first.leafable.body
+  end
+end
