+
+    # Escape LIKE pattern metacharacters so the search term is treated as
+    # literal data: `%` and `_` no longer act as wildcards, and the escape
+    # character itself is escaped.
+    def escape_like(term)
+      term.gsub(/[\\%_]/) { |char| "#{LIKE_ESCAPE}#{char}" }
+    end
 end
