diff --git a/test/controllers/books_caching_test.rb b/test/controllers/books_caching_test.rb
new file mode 100644
index 0000000..6e52b3d
--- /dev/null
+++ b/test/controllers/books_caching_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class BooksCachingTest < ActionDispatch::IntegrationTest
+  setup do
+    @original_perform_caching = ActionController::Base.perform_caching
+    @original_cache_store = Rails.cache
+    @original_collection_cache = ActionView::PartialRenderer.collection_cache
+
+    ActionController::Base.perform_caching = true
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    ActionView::PartialRenderer.collection_cache = Rails.cache
+  end
+
+  teardown do
+    ActionController::Base.perform_caching = @original_perform_caching
+    Rails.cache = @original_cache_store
+    ActionView::PartialRenderer.collection_cache = @original_collection_cache
+  end
+
+  test "reader does not see editor controls after an editor has cached the page" do
+    # Editor views first, caching the leaves with editor controls
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body "Edit #{leaves(:welcome_page).title}"
+
+    sign_out
+
+    # Reader views — should NOT see editor controls
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_not_in_body "Edit #{leaves(:welcome_page).title}"
+  end
+
+  test "editor sees editor controls after a reader has cached the page" do
+    # Reader views first, caching the leaves without editor controls
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_not_in_body "Edit #{leaves(:welcome_page).title}"
+
+    sign_out
+
+    # Editor views — should see editor controls
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body "Edit #{leaves(:welcome_page).title}"
+  end
+
+  test "entry renamed shows its new title to the next viewer" do
+    # Editor views first, caching the leaves with old title
+    sign_in :kevin
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body leaves(:welcome_page).title
+
+    sign_out
+
+    # Rename the leaf
+    leaves(:welcome_page).update!(title: "Brand New Title")
+
+    # Reader views — should see the new title
+    sign_in :jz
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_in_body "Brand New Title"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+end
