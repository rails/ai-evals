+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly renders without error" do
+    user = users(:david)
+    mail = ReportDigestMailer.weekly(user)
+    assert_equal "Your Writebook digest", mail.subject
+    assert_match(/Hi David/, mail.body.encoded)
+  end
+end
