diff --git a/config/environments/development.rb b/config/environments/development.rb
index e1c3d90..7888cbe 100644
--- a/config/environments/development.rb
+++ b/config/environments/development.rb
@@ -71,4 +71,14 @@ Rails.application.configure do
 
   # Apply autocorrection by RuboCop to files generated by `bin/rails generate`.
   config.generators.apply_rubocop_autocorrect_after_generate!
+
+  # Also mirror the log to STDOUT so that scripts run via `bin/rails runner`
+  # (such as script/library_report.rb) print their output to the terminal in
+  # addition to the environment log file.
+  config.after_initialize do
+    stdout_logger = ActiveSupport::Logger.new($stdout)
+    stdout_logger.formatter = config.log_formatter
+    stdout_logger.level = [Rails.logger.broadcasts.first.level, Logger::INFO].max
+    Rails.logger.broadcast_to(stdout_logger)
+  end
 end
