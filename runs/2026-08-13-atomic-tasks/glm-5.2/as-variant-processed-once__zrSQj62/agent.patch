diff --git a/test/debug_digest_test.rb b/test/debug_digest_test.rb
new file mode 100644
index 0000000..b37403e
--- /dev/null
+++ b/test/debug_digest_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class DebugDigestTest < ActionDispatch::IntegrationTest
+  test "debug variation digest mismatch" do
+    sign_in :kevin
+
+    picture = pictures(:reading)
+    blob = picture.image.blob
+
+    # Path 1: Background job uses the raw transformations hash
+    transformations_hash = { resize_to_limit: [1500, 1500], format: :webp }
+    variant_from_hash = blob.representation(transformations_hash)
+    puts "=== From hash (background job) ==="
+    puts "transformations: #{variant_from_hash.variation.transformations.inspect}"
+    puts "digest: #{variant_from_hash.variation.digest}"
+    puts "key: #{variant_from_hash.variation.key[0..30]}..."
+    puts "Marshal: #{Marshal.dump(variant_from_hash.variation.transformations).inspect}"
+
+    # Path 2: The view generates the variant via the named variant, then encodes it
+    variant_from_named = picture.image.variant(:large)
+    puts "\n=== From named variant (view) ==="
+    puts "transformations: #{variant_from_named.variation.transformations.inspect}"
+    puts "digest: #{variant_from_named.variation.digest}"
+    puts "key: #{variant_from_named.variation.key[0..30]}..."
+    puts "Marshal: #{Marshal.dump(variant_from_named.variation.transformations).inspect}"
+
+    # Path 3: Reader decodes the variation key
+    variation_key = variant_from_named.variation.key
+    variant_from_key = blob.representation(variation_key)
+    puts "\n=== From variation key (reader/controller) ==="
+    puts "transformations: #{variant_from_key.variation.transformations.inspect}"
+    puts "digest: #{variant_from_key.variation.digest}"
+    puts "key: #{variant_from_key.variation.key[0..30]}..."
+    puts "Marshal: #{Marshal.dump(variant_from_key.variation.transformations).inspect}"
+
+    puts "\n=== Comparison ==="
+    puts "hash digest == named digest: #{variant_from_hash.variation.digest == variant_from_named.variation.digest}"
+    puts "named digest == key digest: #{variant_from_named.variation.digest == variant_from_key.variation.digest}"
+    puts "hash digest == key digest: #{variant_from_hash.variation.digest == variant_from_key.variation.digest}"
+  end
+end
diff --git a/test/reproduce_concurrent_test.rb b/test/reproduce_concurrent_test.rb
new file mode 100644
index 0000000..205c061
--- /dev/null
+++ b/test/reproduce_concurrent_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class ReproduceConcurrentTest < ActionDispatch::IntegrationTest
+  test "concurrent processing does not create duplicate variants" do
+    sign_in :kevin
+
+    # Upload a picture
+    picture = Picture.create!(caption: "Test picture")
+    Leaf.create!(book: books(:handbook), leafable: picture, title: "Test", status: :active)
+    picture.image.attach(io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp")
+
+    blob = picture.image.blob
+    blob.reload
+
+    # Simulate the background job processing the variant
+    puts "\n=== Simulating background job processing ==="
+    variant1 = blob.representation({ resize_to_limit: [1500, 1500], format: :webp })
+    puts "variant1 digest: #{variant1.variation.digest}"
+    puts "variant1 processed? before: #{variant1.processed?}"
+    variant1.processed
+    puts "variant1 processed? after: #{variant1.processed?}"
+
+    # Simulate the reader's request processing the variant (same time as background job)
+    puts "\n=== Simulating reader processing ==="
+    variant2 = blob.representation(variant1.variation.key)
+    puts "variant2 digest: #{variant2.variation.digest}"
+    puts "variant2 processed? before: #{variant2.processed?}"
+    variant2.processed
+    puts "variant2 processed? after: #{variant2.processed?}"
+
+    blob.reload
+    variant_records = ActiveStorage::VariantRecord.where(blob: blob).to_a
+    puts "\n=== Results ==="
+    puts "Variant records count: #{variant_records.count}"
+    variant_records.each do |vr|
+      puts "  id=#{vr.id} digest=#{vr.variation_digest} image.attached?=#{vr.image.attached?} image.blob.key=#{vr.image.blob&.key}"
+    end
+
+    assert_equal 1, variant_records.count, "Duplicate variant records!"
+  end
+end
diff --git a/test/reproduce_duplicate_variant_test.rb b/test/reproduce_duplicate_variant_test.rb
new file mode 100644
index 0000000..e7e18c2
--- /dev/null
+++ b/test/reproduce_duplicate_variant_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class ReproduceDuplicateVariantTest < ActionDispatch::IntegrationTest
+  test "variant is not processed twice after background job runs" do
+    sign_in :kevin
+
+    # Upload a picture
+    picture = Picture.create!(caption: "Test picture")
+    Leaf.create!(book: books(:handbook), leafable: picture, title: "Test", status: :active)
+    picture.image.attach(io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp")
+
+    blob = picture.image.blob
+    blob.reload
+
+    puts "\n=== After attach ==="
+    puts "Variant records count: #{ActiveStorage::VariantRecord.where(blob: blob).count}"
+
+    # Run pending jobs
+    ActiveJob::Base.queue_adapter.enqueued_jobs.each do |job|
+      puts "Job: #{job.inspect}"
+    end
+
+    # Use perform_enqueued_jobs approach
+    ActiveJob::Base.queue_adapter.perform_enqueued_jobs = true
+    ActiveJob::Base.queue_adapter.perform_enqueued_at_jobs = true
+
+    # Manually perform each enqueued job
+    ActiveJob::Base.queue_adapter.enqueued_jobs.dup.each do |job_data|
+      job = ActiveJob::Base.deserialize(job_data)
+      job.perform_now
+    end
+
+    blob.reload
+    puts "\n=== After background job ==="
+    puts "Variant records count: #{ActiveStorage::VariantRecord.where(blob: blob).count}"
+    vr = ActiveStorage::VariantRecord.where(blob: blob).first
+    if vr
+      puts "  VariantRecord id=#{vr.id} digest=#{vr.variation_digest} image_attached=#{vr.image.attached?}"
+    end
+
+    # Now simulate reader opening the page and fetching the variant
+    puts "\n=== Simulating reader request ==="
+    variant = picture.image.variant(:large)
+    puts "Variation digest: #{variant.variation.digest}"
+    puts "processed? before: #{variant.processed?}"
+
+    if !variant.processed?
+      puts "!!! Background job did not create the variant - processing now"
+      variant.processed
+    else
+      puts "Variant already processed by background job - no processing needed"
+    end
+
+    blob.reload
+    puts "\n=== After reader request ==="
+    puts "Variant records count: #{ActiveStorage::VariantRecord.where(blob: blob).count}"
+    ActiveStorage::VariantRecord.where(blob: blob).each do |v|
+      puts "  VariantRecord id=#{v.id} digest=#{v.variation_digest} image_attached=#{v.image.attached?}"
+    end
+
+    assert_equal 1, ActiveStorage::VariantRecord.where(blob: blob).count, "Duplicate variant records found!"
+  end
+end
