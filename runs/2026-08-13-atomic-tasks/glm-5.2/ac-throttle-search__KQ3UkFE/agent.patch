index 0000000..441e3a8
--- /dev/null
+++ b/lib/search_rate_limiter.rb
@@ -0,0 +1,47 @@
+class SearchRateLimiter
+  LIMIT = 30
+  WINDOW = 60 # seconds — one minute
+
+  @mutex = Mutex.new
+  @requests = Hash.new { |h, k| h[k] = [] }
+  @last_cleanup = 0.0
+
+  class << self
+    # Returns true when the request should be served, false when it exceeds
+    # the per-window limit and should be refused.
+    def allow?(ip)
+      return true if ip.blank?
+
+      now = Time.now.to_f
+
+      @mutex.synchronize do
+        timestamps = @requests[ip]
+        timestamps.reject! { |t| t <= now - WINDOW }
+
+        if timestamps.size >= LIMIT
+          false
+        else
+          timestamps << now
+          cleanup(now) if now - @last_cleanup > WINDOW
+          true
+        end
+      end
+    end
+
+    # Clear all tracked state — useful for tests.
+    def reset
+      @mutex.synchronize do
+        @requests.clear
+        @last_cleanup = 0.0
+      end
+    end
+
+    private
+      def cleanup(now)
+        @last_cleanup = now
+        @requests.reject! do |_ip, timestamps|
+          timestamps.empty? || timestamps.last <= now - WINDOW
+        end
+      end
+  end
+end
