diff --git a/app/channels/being_edited_channel.rb b/app/channels/being_edited_channel.rb
new file mode 100644
index 0000000..a117742
--- /dev/null
+++ b/app/channels/being_edited_channel.rb
@@ -0,0 +1,28 @@
+class BeingEditedChannel < Turbo::StreamsChannel
+  def subscribed
+    if verified_stream_name_from_params.present? && still_editable?
+      stream_from verified_stream_name_from_params do |message|
+        transmit message if still_editable?
+      end
+    else
+      reject
+    end
+  end
+
+  private
+    def still_editable?
+      leaf = leaf_from_stream_name
+      return false unless leaf && current_user
+
+      leaf.book.editable?(user: current_user)
+    end
+
+    def leaf_from_stream_name
+      stream_name = verified_stream_name_from_params
+      return unless stream_name
+
+      stream_name.split(":").filter_map { |part| GlobalID::Locator.locate(part) }.find { Leaf === _1 }
+    rescue
+      nil
+    end
+end
