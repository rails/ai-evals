diff --git a/test/channels/being_edited_channel_test.rb b/test/channels/being_edited_channel_test.rb
new file mode 100644
index 0000000..131528b
--- /dev/null
+++ b/test/channels/being_edited_channel_test.rb
@@ -0,0 +1,84 @@
+require "test_helper"
+
+class BeingEditedChannelTest < ActionCable::Channel::TestCase
+  tests BeingEditedChannel
+
+  setup do
+    @leaf = leaves(:welcome_page)
+    @signed_stream_name = Turbo::StreamsChannel.signed_stream_name([ @leaf, :being_edited ])
+  end
+
+  test "subscribes as an editor" do
+    stub_connection(current_user: users(:kevin))
+    subscribe signed_stream_name: @signed_stream_name
+
+    assert subscription.confirmed?
+    assert_has_stream stream_name_from([ @leaf, :being_edited ])
+  end
+
+  test "subscribes as an administrator" do
+    stub_connection(current_user: users(:david))
+    subscribe signed_stream_name: @signed_stream_name
+
+    assert subscription.confirmed?
+  end
+
+  test "rejects subscription from a reader" do
+    stub_connection(current_user: users(:jz))
+    subscribe signed_stream_name: @signed_stream_name
+
+    assert subscription.rejected?
+  end
+
+  test "rejects subscription from a removed collaborator" do
+    users(:kevin).accesses.find_by(book: books(:handbook)).destroy!
+
+    stub_connection(current_user: users(:kevin))
+    subscribe signed_stream_name: @signed_stream_name
+
+    assert subscription.rejected?
+  end
+
+  test "stops transmitting after access is removed mid-session" do
+    stub_connection(current_user: users(:kevin))
+    subscribe signed_stream_name: @signed_stream_name
+    assert subscription.confirmed?
+
+    assert subscription.send(:still_editable?)
+
+    users(:kevin).accesses.find_by(book: books(:handbook)).destroy!
+
+    assert_not subscription.send(:still_editable?)
+  end
+
+  test "stops transmitting after demotion from editor to reader" do
+    stub_connection(current_user: users(:kevin))
+    subscribe signed_stream_name: @signed_stream_name
+    assert subscription.confirmed?
+
+    assert subscription.send(:still_editable?)
+
+    users(:kevin).accesses.find_by(book: books(:handbook)).update!(level: :reader)
+
+    assert_not subscription.send(:still_editable?)
+  end
+
+  test "rejects subscription without a signed stream name" do
+    stub_connection(current_user: users(:kevin))
+    subscribe
+
+    assert subscription.rejected?
+  end
+
+  test "rejects subscription with an unverifiable stream name" do
+    stub_connection(current_user: users(:kevin))
+    subscribe signed_stream_name: "tampered"
+
+    assert subscription.rejected?
+  end
+
+  private
+    def stream_name_from(streamables)
+      streamables.map { |s| s.try(:to_gid_param) || s.to_param }.join(":")
+    end
+end
