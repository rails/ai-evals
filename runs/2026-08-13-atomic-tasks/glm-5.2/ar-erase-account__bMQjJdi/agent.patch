diff --git a/test/controllers/users_controller_test.rb b/test/controllers/users_controller_test.rb
index e0ca8db..9a757da 100644
--- a/test/controllers/users_controller_test.rb
+++ b/test/controllers/users_controller_test.rb
@@ -78,4 +78,37 @@ class UsersControllerTest < ActionDispatch::IntegrationTest
     delete user_url(users(:david))
     assert_response :forbidden
   end
+
+  test "destroy erases the user completely" do
+    sign_in :david
+    kevin = users(:kevin)
+
+    SignInEvent.create!(email_address: kevin.email_address, action: :signed_in, ip_address: "127.0.0.1", user_agent: "Test")
+
+    assert_difference -> { User.count }, -1 do
+      delete user_url(kevin)
+    end
+
+    assert_redirected_to users_url
+    assert_nil User.find_by(id: kevin.id)
+    assert_empty SignInEvent.for_address(kevin.email_address)
+  end
+
+  test "destroy can erase a previously deactivated user" do
+    sign_in :david
+    kevin = users(:kevin)
+    original_email = kevin.email_address
+
+    # Simulate old-style deactivation
+    kevin.update!(active: false, email_address: kevin.email_address.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@"))
+
+    # Sign-in events are under the original email
+    SignInEvent.create!(email_address: original_email, action: :signed_in, ip_address: "127.0.0.1", user_agent: "Test")
+
+    delete user_url(kevin)
+
+    assert_redirected_to users_url
+    assert_nil User.find_by(id: kevin.id)
+    assert_empty SignInEvent.for_address(original_email)
+  end
 end
diff --git a/test/models/user_erasure_test.rb b/test/models/user_erasure_test.rb
new file mode 100644
index 0000000..84fed1c
--- /dev/null
+++ b/test/models/user_erasure_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class UserErasureTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+  end
+
+  test "erasing a user destroys the user record" do
+    assert_difference -> { User.count }, -1 do
+      @user.erase
+    end
+  end
+
+  test "erasing destroys the user's sessions" do
+    @user.sessions.create!(user_agent: "Test", ip_address: "127.0.0.1")
+
+    assert_difference -> { Session.where(user_id: @user.id).count }, -1 do
+      @user.erase
+    end
+  end
+
+  test "erasing destroys the user's accesses" do
+    assert_difference -> { Access.where(user_id: @user.id).count }, -1 do
+      @user.erase
+    end
+  end
+
+  test "erasing destroys the user's reading marks" do
+    leaf = leaves(:welcome_page)
+    ReadingMark.create!(user: @user, leaf: leaf, last_read_at: Time.now)
+
+    assert_difference -> { ReadingMark.where(user_id: @user.id).count }, -1 do
+      @user.erase
+    end
+  end
+
+  test "erasing deletes sign-in events for the user's email" do
+    SignInEvent.create!(email_address: @user.email_address, action: :signed_in, ip_address: "127.0.0.1", user_agent: "Test")
+
+    assert_difference -> { SignInEvent.for_address(@user.email_address).count }, -1 do
+      @user.erase
+    end
+  end
+
+  test "erasing destroys private books created by the user" do
+    private_book = Book.create!(title: "Kevin's Secret Book", everyone_access: false, creator: @user)
+    private_book.press(Page.new, title: "A page")
+
+    assert_difference -> { Book.where(id: private_book.id).count }, -1 do
+      @user.erase
+    end
+  end
+
+  test "erasing destroys private book leaves and removes them from the search index" do
+    private_book = Book.create!(title: "Kevin's Secret Book", everyone_access: false, creator: @user)
+    leaf = private_book.press(Page.new(body: "Some content"), title: "A page")
+
+    @user.erase
+
+    assert_nil Leaf.find_by(id: leaf.id)
+    assert_nil ActiveRecord::Base.connection.execute("SELECT rowid FROM leaf_search_index WHERE rowid = #{leaf.id}").first
+  end
+
+  test "erasing keeps shared books but nullifies creator and bylines Deleted author" do
+    shared_book = Book.create!(title: "Kevin's Shared Book", everyone_access: true, creator: @user, author: "Kevin")
+
+    @user.erase
+
+    shared_book.reload
+    assert shared_book.persisted?
+    assert_nil shared_book.creator_id
+    assert_equal "Deleted author", shared_book.author
+  end
+
+  test "erasing a previously deactivated user deletes sign-in events under the original email" do
+    original_email = @user.email_address
+    @user.update!(active: false, email_address: @user.email_address.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@"))
+
+    SignInEvent.create!(email_address: original_email, action: :signed_in, ip_address: "127.0.0.1", user_agent: "Test")
+
+    assert_difference -> { SignInEvent.for_address(original_email).count }, -1 do
+      @user.erase
+    end
+  end
+
+  test "erasing leaves no trace of the user anywhere" do
+    # Set up data
+    @user.sessions.create!(user_agent: "Test", ip_address: "127.0.0.1")
+    SignInEvent.create!(email_address: @user.email_address, action: :signed_in, ip_address: "127.0.0.1", user_agent: "Test")
+    leaf = leaves(:welcome_page)
+    ReadingMark.create!(user: @user, leaf: leaf, last_read_at: Time.now)
+    private_book = Book.create!(title: "Private", everyone_access: false, creator: @user)
+    shared_book = Book.create!(title: "Shared", everyone_access: true, creator: @user, author: "Kevin")
+    private_book.press(Page.new(body: "content"), title: "Page")
+
+    @user.erase
+
+    user_id = @user.id
+    assert_nil User.find_by(id: user_id)
+    assert_empty Session.where(user_id: user_id)
+    assert_empty Access.where(user_id: user_id)
+    assert_empty ReadingMark.where(user_id: user_id)
+    assert_empty SignInEvent.for_address(@user.email_address)
+    assert_nil Book.find_by(id: private_book.id)
+    assert Book.exists?(shared_book.id)
+  end
+end
