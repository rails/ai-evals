@@ -23,4 +25,31 @@ class PictureTest < ActiveSupport::TestCase
 
     assert_equal picture.image, picture.large_image
   end
+
+  test "large variant is derived once and not reprocessed when reader requests it" do
+    picture = Picture.new(caption: "Upload test")
+    perform_enqueued_jobs do
+      picture.image.attach io: file_fixture("white-rabbit.webp").open, filename: "white-rabbit.webp", content_type: "image/webp"
+      picture.save!
+    end
+
+    blob = picture.image.blob
+
+    assert_equal 1, ActiveStorage::VariantRecord.where(blob_id: blob.id).count,
+      "background job should create exactly one variant record"
+
+    initial_blob_count = ActiveStorage::Blob.count
+
+    # Simulate what the ActiveStorage representations controller does:
+    # it decodes the signed variation key from the URL and calls .processed
+    variant = picture.large_image
+    signed_key = variant.variation.key
+    controller_representation = blob.representation(signed_key)
+    controller_representation.processed
+
+    assert_equal 1, ActiveStorage::VariantRecord.where(blob_id: blob.id).count,
+      "reader request should not create a duplicate variant record"
+    assert_equal initial_blob_count, ActiveStorage::Blob.count,
+      "reader request should not create a duplicate blob"
+  end
 end
