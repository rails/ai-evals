diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..02b2c5c 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,34 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    # Track the *final* published state across all saves in a transaction.
+    # Using +saved_change_to_published?+ in +after_commit+ directly is
+    # unreliable because a +touch+ from an associated record (e.g. adding a
+    # page within the same sitting) clears the saved-change data before the
+    # transaction commits.
+    after_save :record_publication_change, if: :saved_change_to_published?
+    after_commit :announce_publication, if: :publication_announcement_pending?
+    after_rollback :clear_publication_announcement
   end
 
   private
+    def record_publication_change
+      # Capture the final published value. If the book is published and then
+      # unpublished within the same transaction, the last write wins and the
+      # value becomes +false+, so no announcement is sent.
+      @publication_announcement_pending = published?
+    end
+
+    def publication_announcement_pending?
+      @publication_announcement_pending
+    end
+
+    def clear_publication_announcement
+      @publication_announcement_pending = false
+    end
+
     def announce_publication
+      @publication_announcement_pending = false
       AnnouncePublicationJob.perform_later self
     end
 end
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..ab92ad7
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+require "active_job/test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = books(:manual)
+    @book.update!(published: false)
+    clear_enqueued_jobs
+  end
+
+  test "going live announces exactly once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.update!(published: true)
+    end
+  end
+
+  test "going live and adding a page in the same sitting announces" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.press Page.new(body: ""), title: "New Page"
+      end
+    end
+  end
+
+  test "taking a live book back down does not announce" do
+    @book.update!(published: true)
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs(only: AnnouncePublicationJob) do
+      @book.update!(published: false)
+    end
+  end
+
+  test "saving an already-live book does not announce again" do
+    @book.update!(published: true)
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs(only: AnnouncePublicationJob) do
+      @book.update!(slug: "updated-slug")
+    end
+  end
+
+  test "a save that does not take a book live announces nothing" do
+    assert_no_enqueued_jobs(only: AnnouncePublicationJob) do
+      @book.update!(slug: "some-slug")
+    end
+  end
+
+  test "a sitting that fails after the book was marked live leaves a draft and no announcement" do
+    assert_no_enqueued_jobs(only: AnnouncePublicationJob) do
+      assert_raises ActiveRecord::RecordInvalid do
+        @book.transaction do
+          @book.update!(published: true)
+          @book.leaves.create!(title: nil)
+        end
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+
+  test "publish then unpublish in same sitting does not announce" do
+    assert_no_enqueued_jobs(only: AnnouncePublicationJob) do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.update!(published: false)
+      end
+    end
+  end
+
+  test "publish, unpublish, republish in same sitting announces exactly once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update!(published: true)
+        @book.update!(published: false)
+        @book.update!(published: true)
+      end
+    end
+  end
+end
