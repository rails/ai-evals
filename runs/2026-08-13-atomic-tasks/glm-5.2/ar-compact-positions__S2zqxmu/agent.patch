+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:handbook)
+    # Fixtures insert leaves in this order: welcome_section, welcome_page,
+    # summary_page, reading_picture (rowid order). Give them a hand-arranged
+    # score order that is deliberately *different* from the insertion order so
+    # that any rowid-based ordering would be detectable.
+    #   logical order: summary_page < welcome_page < reading_picture < welcome_section
+    leaves(:summary_page).update!(position_score: 10)
+    leaves(:welcome_page).update!(position_score: 20)
+    leaves(:reading_picture).update!(position_score: 30)
+    leaves(:welcome_section).update!(position_score: 40)
+  end
+
+  test "compact_positions! preserves the hand-arranged order (not creation order)" do
+    expected = [ leaves(:summary_page), leaves(:welcome_page), leaves(:reading_picture), leaves(:welcome_section) ]
+
+    @book.compact_positions!
+
+    assert_equal expected, @book.leaves.positioned
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compact_positions! keeps a trashed leaf's relative place so it restores correctly" do
+    leaves(:welcome_page).update!(status: :trashed)
+
+    @book.compact_positions!
+
+    # All leaves (active + trashed) are densified together by position_score,
+    # so the trashed leaf retains its slot between summary_page and reading_picture.
+    assert_equal [ 1, 2, 3, 4 ], @book.leaves.order(:position_score).pluck(:position_score)
+
+    # Restoring the trashed leaf brings it back to its original position.
+    leaves(:welcome_page).update!(status: :active)
+    assert_equal(
+      [ leaves(:summary_page), leaves(:welcome_page), leaves(:reading_picture), leaves(:welcome_section) ],
+      @book.leaves.active.positioned
+    )
+  end
+
+  test "live_leaf_count returns the number of non-trashed leaves" do
+    assert_equal 4, @book.live_leaf_count
+    leaves(:welcome_page).update!(status: :trashed)
+    assert_equal 3, @book.live_leaf_count
+  end
+end
