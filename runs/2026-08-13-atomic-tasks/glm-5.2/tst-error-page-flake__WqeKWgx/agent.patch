diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..6906c44 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -2,6 +2,40 @@ ENV["RAILS_ENV"] ||= "test"
 require_relative "../config/environment"
 require "rails/test_help"
 
+# Per-request override of action_dispatch.show_exceptions.
+#
+# The ShowExceptions middleware reads the value from the request env
+# (env["action_dispatch.show_exceptions"]), which Rails populates from the
+# memoized @app_env_config in Rails::Application#env_config.  That hash is
+# built once (lazily, on the first request) and then frozen in the cache, so
+# mutating Rails.application.config.action_dispatch.show_exceptions at runtime
+# has no reliable effect:
+#
+#   * If the cache was already built the change is silently ignored.
+#   * If the cache has not been built yet the new value (:none) gets
+#     permanently stuck in @app_env_config even after the ensure block
+#     restores the config.
+#
+# Both outcomes produce order-dependent flakiness when tests run in parallel.
+#
+# Instead we set a thread-local flag and override env_config to merge
+# "action_dispatch.show_exceptions" => :none on top of the cached hash for
+# every request made inside the block.  This is completely local to the
+# calling thread, so it cannot leak to other tests—regardless of run order or
+# parallelism—and the global config is never touched.
+module WithRaisedExceptions
+  def env_config
+    config = super
+    if Thread.current[:_with_raised_exceptions]
+      config.merge("action_dispatch.show_exceptions" => :none)
+    else
+      config
+    end
+  end
+end
+
+Rails::Application.prepend(WithRaisedExceptions)
+
 module ActiveSupport
   class TestCase
     # Run tests in parallel with specified workers
@@ -13,11 +47,11 @@ module ActiveSupport
     include SessionTestHelper
 
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      previous = Thread.current[:_with_raised_exceptions]
+      Thread.current[:_with_raised_exceptions] = true
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      Thread.current[:_with_raised_exceptions] = previous
     end
   end
 end
