diff --git a/test/integration/tenant_isolation_test.rb b/test/integration/tenant_isolation_test.rb
new file mode 100644
index 0000000..3fe24c5
--- /dev/null
+++ b/test/integration/tenant_isolation_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+
+class TenantIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Customer A")
+    @tenant_b = Tenant.create!(name: "Customer B")
+
+    @user_a = User.create!(name: "Alice", email_address: "alice@a.com", password: "secret123456", tenant: @tenant_a)
+    @user_b = User.create!(name: "Bob", email_address: "bob@b.com", password: "secret123456", tenant: @tenant_b)
+
+    @book_a = Book.create!(title: "Book A", tenant: @tenant_a, everyone_access: false)
+    @book_b = Book.create!(title: "Book B", tenant: @tenant_b, everyone_access: false)
+
+    # Give user_a direct editor access
+    @book_a.update_access(editors: [ @user_a.id ], readers: [])
+    @book_b.update_access(editors: [ @user_b.id ], readers: [])
+
+    # Spray an access row for book_b onto user_a (simulating cross-tenant sharing bug)
+    Access.create!(user: @user_a, book: @book_b, level: :reader)
+  end
+
+  test "signed-in user does not see other tenant's books in library, even if published" do
+    @book_b.update!(published: true)
+
+    sign_in_as(@user_a)
+    get root_url
+
+    assert_response :success
+    assert_select "h2", text: "Book A"
+    assert_select "h2", text: "Book B", count: 0
+  end
+
+  test "signed-in user gets 404 for other tenant's book show page" do
+    sign_in_as(@user_a)
+    get book_slug_url(@book_b)
+
+    assert_response :not_found
+  end
+
+  test "signed-in user with access row still gets 404 for other tenant's book" do
+    sign_in_as(@user_a)
+    # Even though user_a has an access row for book_b, they should get 404
+    assert @book_b.accessable?(user: @user_a), "user_a should have access row"
+    get book_slug_url(@book_b)
+
+    assert_response :not_found
+  end
+
+  test "signed-out visitor sees published books from all tenants" do
+    @book_a.update!(published: true)
+    @book_b.update!(published: true)
+
+    get root_url
+
+    assert_response :success
+    assert_select "h2", text: "Book A"
+    assert_select "h2", text: "Book B"
+  end
+
+  test "new books land in their creator's tenant" do
+    sign_in_as(@user_a)
+    post books_url, params: { book: { title: "New Book A", everyone_access: false } }
+
+    assert_redirected_to book_slug_url(Book.last)
+    assert_equal @tenant_a.id, Book.last.tenant_id
+  end
+
+  test "everyone access only sprays to same-tenant users" do
+    book = Book.create!(title: "Everyone Book", tenant: @tenant_a, everyone_access: true)
+    book.update_access(editors: [ @user_a.id ], readers: [])
+
+    # user_a (same tenant) should have access
+    assert book.accessable?(user: @user_a)
+
+    # user_b (different tenant) should NOT have access
+    assert_not book.accessable?(user: @user_b)
+  end
+
+  test "new user only gets access to everyone books in their tenant" do
+    everyone_a = Book.create!(title: "Everyone A", tenant: @tenant_a, everyone_access: true)
+    everyone_b = Book.create!(title: "Everyone B", tenant: @tenant_b, everyone_access: true)
+    everyone_a.update_access(editors: [], readers: [])
+    everyone_b.update_access(editors: [], readers: [])
+
+    new_user = User.create!(name: "New", email_address: "new@a.com", password: "secret123456", tenant: @tenant_a)
+
+    assert everyone_a.accessable?(user: new_user)
+    assert_not everyone_b.accessable?(user: new_user)
+  end
+
+  test "edit history of page in other tenant's book returns 404" do
+    leaf = @book_b.press(Page.new(body: "Secret content"), title: "Secret Page")
+    leaf.edit(leafable_params: { body: "Updated secret" })
+
+    sign_in_as(@user_a)
+    get page_edit_url(leaf, leaf.edits.last)
+
+    assert_response :not_found
+  end
+
+  private
+    def sign_in_as(user)
+      post session_url, params: { email_address: user.email_address, password: "secret123456" }
+    end
+end
diff --git a/test/integration/tenant_public_access_test.rb b/test/integration/tenant_public_access_test.rb
new file mode 100644
index 0000000..534edea
--- /dev/null
+++ b/test/integration/tenant_public_access_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class TenantPublicAccessTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Customer A")
+    @tenant_b = Tenant.create!(name: "Customer B")
+
+    @user_a = User.create!(name: "Alice", email_address: "alice2@a.com", password: "secret123456", tenant: @tenant_a)
+
+    @book_a = Book.create!(title: "Book Alpha", tenant: @tenant_a, published: true, everyone_access: false)
+    @book_b = Book.create!(title: "Book Beta", tenant: @tenant_b, published: true, everyone_access: false)
+
+    @book_a.update_access(editors: [ @user_a.id ], readers: [])
+    @book_b.update_access(editors: [], readers: [])
+
+    @leaf_a = @book_a.press(Page.new(body: "Alpha content"), title: "Alpha Page")
+    @leaf_b = @book_b.press(Page.new(body: "Beta content"), title: "Beta Page")
+  end
+
+  test "signed-out visitor sees published books from all tenants" do
+    get root_url
+
+    assert_response :success
+    assert_select "h2", text: "Book Alpha"
+    assert_select "h2", text: "Book Beta"
+  end
+
+  test "signed-out visitor can view leaf in published book from any tenant" do
+    get leafable_slug_path(@leaf_b)
+
+    assert_response :success
+    assert_in_body "Beta content"
+  end
+
+  test "signed-in user cannot view leaf in other tenant's published book" do
+    sign_in_as(@user_a)
+
+    get leafable_slug_path(@leaf_b)
+
+    assert_response :not_found
+  end
+
+  test "signed-in user can view leaf in their own tenant's published book" do
+    sign_in_as(@user_a)
+
+    get leafable_slug_path(@leaf_a)
+
+    assert_response :success
+    assert_in_body "Alpha content"
+  end
+
+  test "signed-out visitor can search published book from any tenant" do
+    Leaf.reindex_all
+    post book_search_path(@book_b), params: { search: "Beta" }
+
+    assert_response :success
+  end
+
+  test "signed-in user cannot search other tenant's book" do
+    sign_in_as(@user_a)
+
+    get book_slug_url(@book_b)
+    assert_response :not_found
+  end
+
+  private
+    def sign_in_as(user)
+      post session_url, params: { email_address: user.email_address, password: "secret123456" }
+    end
+end
