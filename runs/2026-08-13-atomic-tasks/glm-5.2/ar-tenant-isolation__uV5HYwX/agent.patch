diff --git a/test/integration/tenant_isolation_test.rb b/test/integration/tenant_isolation_test.rb
new file mode 100644
index 0000000..7e16482
--- /dev/null
+++ b/test/integration/tenant_isolation_test.rb
@@ -0,0 +1,157 @@
+require "test_helper"
+
+class TenantIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Customer A")
+    @tenant_b = Tenant.create!(name: "Customer B")
+
+    # Users in tenant A
+    @alice = User.create!(name: "Alice", email_address: "alice@example.com", password: "secret123456", tenant: @tenant_a, role: :administrator)
+    @bob = User.create!(name: "Bob", email_address: "bob@example.com", password: "secret123456", tenant: @tenant_a)
+
+    # Users in tenant B
+    @carol = User.create!(name: "Carol", email_address: "carol@example.com", password: "secret123456", tenant: @tenant_b, role: :administrator)
+    @dave = User.create!(name: "Dave", email_address: "dave@example.com", password: "secret123456", tenant: @tenant_b)
+
+    # Book in tenant A (everyone_access: true)
+    @book_a = Book.create!(title: "Tenant A Book", everyone_access: true, tenant: @tenant_a)
+    @book_a.update_access(editors: [@alice.id], readers: [])
+
+    # Book in tenant B (published: true, everyone_access: true)
+    @book_b = Book.create!(title: "Tenant B Book", published: true, everyone_access: true, tenant: @tenant_b)
+    @book_b.update_access(editors: [@carol.id], readers: [])
+
+    # A page in book_b
+    @leaf_b = @book_b.press Page.new(body: "Secret tenant B content"), title: "Secret Page"
+    @leaf_b.edit leafable_params: { body: "Updated secret content" }
+  end
+
+  test "signed-in user does not see other tenant's published books in library" do
+    sign_in @alice
+    get root_url
+
+    assert_response :success
+    assert_select "h2", text: "Tenant A Book"
+    assert_select "h2", text: "Tenant B Book", count: 0
+  end
+
+  test "signed-in user gets 404 for other tenant's book show" do
+    sign_in @alice
+    get book_slug_url(@book_b)
+
+    assert_response :not_found
+  end
+
+  test "signed-in user gets 404 for other tenant's book pages" do
+    sign_in @alice
+    get leafable_slug_url(@leaf_b)
+
+    assert_response :not_found
+  end
+
+  test "signed-in user gets 404 for other tenant's page edit history" do
+    sign_in @alice
+    get page_edit_url(@leaf_b, @leaf_b.edits.last)
+
+    assert_response :not_found
+  end
+
+  test "signed-in user stays signed in when denied access to other tenant" do
+    sign_in @alice
+    get book_slug_url(@book_b)
+
+    assert_response :not_found
+    assert_signed_in
+  end
+
+  test "signed-out visitor sees all published books across tenants" do
+    get root_url
+
+    assert_response :success
+    assert_select "h2", text: "Tenant B Book"
+  end
+
+  test "signed-out visitor can access published book in any tenant" do
+    get book_slug_url(@book_b)
+
+    assert_response :success
+  end
+
+  test "signed-out visitor can see pages in published books across tenants" do
+    get leafable_slug_url(@leaf_b)
+
+    assert_response :success
+  end
+
+  test "new books land in creator's tenant" do
+    sign_in @alice
+    post books_url, params: { book: { title: "Alice's New Book", everyone_access: false } }
+
+    book = Book.find_by(title: "Alice's New Book")
+    assert_equal @tenant_a, book.tenant
+  end
+
+  test "everyone_access only sprays within the same tenant" do
+    # Alice has access to book_a (tenant A)
+    assert @book_a.accessable?(user: @alice)
+    # Carol should NOT have access to book_a even though everyone_access is true
+    assert_not @book_a.accessable?(user: @carol)
+    # Dave should NOT have access to book_a
+    assert_not @book_a.accessable?(user: @dave)
+    # Bob SHOULD have access to book_a (same tenant, everyone_access)
+    assert @book_a.accessable?(user: @bob)
+  end
+
+  test "new user only gets access to everyone books in their tenant" do
+    # Create a new user in tenant B
+    eve = User.create!(name: "Eve", email_address: "eve@example.com", password: "secret123456", tenant: @tenant_b)
+
+    # Eve should have access to book_b (tenant B, everyone_access)
+    assert @book_b.accessable?(user: eve)
+    # Eve should NOT have access to book_a (tenant A, everyone_access)
+    assert_not @book_a.accessable?(user: eve)
+  end
+
+  test "users index still shows everyone across all tenants" do
+    sign_in @alice
+    get users_url
+
+    assert_response :success
+    assert_select "a, span", text: "Alice"
+    assert_select "a, span", text: "Carol"
+    assert_select "a, span", text: "Dave"
+  end
+
+  test "inside a tenant, own books and pages work normally" do
+    sign_in @alice
+    get book_slug_url(@book_a)
+
+    assert_response :success
+    assert_select "h1", text: "Tenant A Book"
+  end
+
+  test "book form only shows users in the same tenant" do
+    sign_in @alice
+    get new_book_url
+
+    assert_response :success
+    # Alice and Bob are in tenant A
+    assert_in_body "Alice"
+    assert_in_body "Bob"
+    # Carol and Dave are in tenant B — should not appear
+    assert_not_in_body "Carol"
+    assert_not_in_body "Dave"
+  end
+
+  test "search in other tenant's book returns 404 for signed-in user" do
+    sign_in @alice
+    post book_search_url(@book_b), params: { search: "secret" }
+
+    assert_response :not_found
+  end
+
+  private
+    def assert_signed_in
+      assert cookies[:session_token].present?
+    end
+end
