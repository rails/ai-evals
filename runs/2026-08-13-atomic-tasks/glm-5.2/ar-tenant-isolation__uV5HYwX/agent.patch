+class CreateTenants < ActiveRecord::Migration[8.0]
+  def change
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    reversible do |dir|
+      dir.up do
+        now = connection.quote(Time.current)
+        connection.execute <<~SQL
+          INSERT INTO tenants (name, created_at, updated_at)
+          VALUES ('Default', #{now}, #{now})
+        SQL
+
+        tenant_id = connection.select_value("SELECT last_insert_rowid()")
+        connection.execute "UPDATE users SET tenant_id = #{tenant_id} WHERE tenant_id IS NULL"
+        connection.execute "UPDATE books SET tenant_id = #{tenant_id} WHERE tenant_id IS NULL"
+      end
+
+      dir.down do
+        connection.execute "UPDATE users SET tenant_id = NULL"
+        connection.execute "UPDATE books SET tenant_id = NULL"
+      end
+    end
+  end
+end
