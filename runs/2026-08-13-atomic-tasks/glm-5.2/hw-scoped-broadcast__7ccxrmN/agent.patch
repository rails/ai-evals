diff --git a/test/controllers/being_edited_broadcast_test.rb b/test/controllers/being_edited_broadcast_test.rb
new file mode 100644
index 0000000..a0fbcdc
--- /dev/null
+++ b/test/controllers/being_edited_broadcast_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+require "turbo/broadcastable/test_helper"
+
+class BeingEditedBroadcastTest < ActionDispatch::IntegrationTest
+  include Turbo::Broadcastable::TestHelper
+
+  setup do
+    sign_in :kevin
+  end
+
+  test "being edited indicator broadcasts to users with editor access" do
+    leaf = leaves(:welcome_page)
+    kevin = users(:kevin)
+    david = users(:david)
+
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: { leaf: { title: "Updated" }, page: { body: "New body" } }
+    end
+
+    assert_turbo_stream_broadcasts [leaf, :being_edited, kevin]
+    assert_turbo_stream_broadcasts [leaf, :being_edited, david]
+  end
+
+  test "being edited indicator does not broadcast to removed collaborators" do
+    leaf = leaves(:welcome_page)
+    kevin = users(:kevin)
+
+    # Kevin had the edit page open, then was removed as editor
+    books(:handbook).access_for(user: kevin).update!(level: :reader)
+
+    # David (still an editor) saves the page
+    sign_in :david
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: { leaf: { title: "Updated" }, page: { body: "New body" } }
+    end
+
+    # Kevin should NOT receive the broadcast on his per-user stream
+    assert_no_turbo_stream_broadcasts [leaf, :being_edited, kevin]
+    # David should still receive it
+    assert_turbo_stream_broadcasts [leaf, :being_edited, users(:david)]
+  end
+
+  test "being edited indicator broadcasts to administrators" do
+    leaf = leaves(:welcome_page)
+    jason = users(:jason)
+
+    perform_enqueued_jobs do
+      put leafable_path(leaf), params: { leaf: { title: "Updated" }, page: { body: "New body" } }
+    end
+
+    assert_turbo_stream_broadcasts [leaf, :being_edited, jason]
+  end
+end
