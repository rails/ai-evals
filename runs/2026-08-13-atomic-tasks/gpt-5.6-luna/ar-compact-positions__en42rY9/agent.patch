@@ -0,0 +1,35 @@
+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  test "compacts active leaves in position order" do
+    book = books(:handbook)
+    leaves(:welcome_section).update_columns(position_score: 30)
+    leaves(:welcome_page).update_columns(position_score: 10)
+    leaves(:summary_page).update_columns(position_score: 20)
+    leaves(:reading_picture).update_columns(position_score: 40)
+
+    book.compact_positions!
+
+    assert_equal [
+      [ leaves(:welcome_page), 1 ],
+      [ leaves(:summary_page), 2 ],
+      [ leaves(:welcome_section), 3 ],
+      [ leaves(:reading_picture), 4 ]
+    ], book.leaves.reload.positioned.map { |leaf| [ leaf, leaf.position_score ] }
+  end
+
+  test "compacts trashed leaves without changing the live count" do
+    book = books(:handbook)
+    trashed = leaves(:summary_page)
+    trashed.trashed!
+    leaves(:welcome_section).update_columns(position_score: 30)
+    leaves(:welcome_page).update_columns(position_score: 10)
+    leaves(:reading_picture).update_columns(position_score: 20)
+
+    book.compact_positions!
+
+    assert_equal [ 1, 2, 3, 4 ], book.leaves.reload.positioned.pluck(:position_score)
+    assert_equal 3, book.live_leaf_count
+    assert_equal 1, trashed.reload.position_score
+  end
+end
