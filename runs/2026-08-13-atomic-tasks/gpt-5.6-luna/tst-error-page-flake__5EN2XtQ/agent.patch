diff --git a/lib/with_raised_exceptions_middleware.rb b/lib/with_raised_exceptions_middleware.rb
new file mode 100644
index 0000000..74c4592
--- /dev/null
+++ b/lib/with_raised_exceptions_middleware.rb
@@ -0,0 +1,27 @@
+# frozen_string_literal: true
+
+# Applies the exception behavior requested by with_raised_exceptions to only
+# the request being made by the current test worker.
+class WithRaisedExceptionsMiddleware
+  THREAD_KEY = :writebook_show_exceptions
+
+  def self.with_raised_exceptions
+    previous = Thread.current[THREAD_KEY]
+    Thread.current[THREAD_KEY] = :none
+    yield
+  ensure
+    Thread.current[THREAD_KEY] = previous
+  end
+
+  def initialize(app)
+    @app = app
+  end
+
+  def call(env)
+    if (show_exceptions = Thread.current[THREAD_KEY])
+      env["action_dispatch.show_exceptions"] = show_exceptions
+    end
+
+    @app.call(env)
+  end
+end
