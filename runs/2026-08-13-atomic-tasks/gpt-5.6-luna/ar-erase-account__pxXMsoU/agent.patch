@@ -17,6 +17,37 @@ class User < ApplicationRecord
     self == Current.user
   end
 
+  # Permanently erase this user and all data that belongs to them. Public
+  # books are the one deliberate exception: they remain readable, but no
+  # longer identify their creator.
+  def erase!
+    transaction do
+      addresses = sign_in_addresses_for_erasure
+      public_books = created_books.where(everyone_access: true).to_a
+      private_books = created_books.where(everyone_access: false).to_a
+
+      public_books.each { |book| book.update!(creator: nil, author: "Deleted author") }
+
+      # Remove FTS rows explicitly before destroying private books. This keeps
+      # erasure correct even when callbacks are bypassed by dependent deletes.
+      private_books.each do |book|
+        book.leaves.pluck(:id).each do |leaf_id|
+          Leaf.connection.execute(
+            Leaf.sanitize_sql_array(["delete from leaf_search_index where rowid = ?", leaf_id])
+          )
+        end
+        book.destroy!
+      end
+
+      reading_marks.delete_all
+      sessions.delete_all
+      SignInEvent.where(email_address: addresses).delete_all
+      destroy!
+    end
+  end
+
+  alias erase erase!
+
   def deactivate
     transaction do
       sessions.delete_all
@@ -25,6 +56,14 @@ class User < ApplicationRecord
   end
 
   private
+    def sign_in_addresses_for_erasure
+      addresses = [ email_address ]
+      if (match = email_address.to_s.match(/\A(.+)-deactivated-([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(@.+)\z/i))
+        addresses << "#{match[1]}#{match[3]}"
+      end
+      addresses
+    end
+
     def deactived_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
