+  def erase
+    transaction do
+      addresses = [ email_address, original_email_address ].compact.uniq
+      preserved = created_books.with_everyone_access.to_a
+      doomed = created_books.where.not(id: preserved.map(&:id)).to_a
+      Leaf.where(book_id: doomed.map(&:id)).pluck(:id).each { |leaf_id| connection.execute sanitize_sql([ "delete from leaf_search_index where rowid = ?", leaf_id ]) }
+      preserved.each { |book| book.update!(creator: nil, author: "Deleted author") }
+      doomed.each(&:destroy!)
+      sessions.delete_all
+      SignInEvent.where(email_address: addresses).delete_all
+      reading_marks.delete_all
+      accesses.delete_all
+      destroy!
+    end
+  end
+
   private
     def deactived_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
 
+    def original_email_address
+      email_address.to_s.sub(/-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?=@)/i, "")
+    end
