diff --git a/lib/writebook/test_exception_handling.rb b/lib/writebook/test_exception_handling.rb
new file mode 100644
index 0000000..721b216
--- /dev/null
+++ b/lib/writebook/test_exception_handling.rb
@@ -0,0 +1,36 @@
+# frozen_string_literal: true
+
+# Provides a request-local way for tests to ask Rails to re-raise controller
+# exceptions. The application configuration is deliberately not changed: it is
+# shared by all test workers and requests.
+module Writebook
+  module TestExceptionHandling
+    KEY = :writebook_raise_controller_exceptions
+
+    def self.with_raised_exceptions
+      stack = Thread.current[KEY] ||= []
+      stack.push(true)
+      yield
+    ensure
+      stack&.pop
+      Thread.current[KEY] = nil if stack&.empty?
+    end
+
+    def self.raise_controller_exceptions?
+      Thread.current[KEY]&.any?
+    end
+
+    class Middleware
+      def initialize(app)
+        @app = app
+      end
+
+      def call(env)
+        if TestExceptionHandling.raise_controller_exceptions?
+          env["action_dispatch.show_exceptions"] = :none
+        end
+        @app.call(env)
+      end
+    end
+  end
+end
