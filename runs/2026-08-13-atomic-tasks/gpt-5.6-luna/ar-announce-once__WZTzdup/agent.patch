diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..db6b326 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,10 +2,33 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :remember_publication_state
+    after_commit :announce_publication, if: :publication_transitioned_to_live?
+    after_rollback :forget_publication_state
   end
 
   private
+    def remember_publication_state
+      # A book can be saved more than once in one transaction (for example,
+      # when its pages are changed too). Keep the state from the first save;
+      # saved_change_to_published? only describes the most recent save.
+      if !instance_variable_defined?(:@publication_state_at_transaction_start)
+        @publication_state_at_transaction_start = published_before_last_save
+      end
+    end
+
+    def publication_transitioned_to_live?
+      transitioned = instance_variable_defined?(:@publication_state_at_transaction_start) &&
+        !@publication_state_at_transaction_start && published?
+      forget_publication_state
+      transitioned
+    end
+
+    def forget_publication_state
+      remove_instance_variable(:@publication_state_at_transaction_start) if
+        instance_variable_defined?(:@publication_state_at_transaction_start)
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
     end
diff --git a/test/controllers/books/publications_controller_test.rb b/test/controllers/books/publications_controller_test.rb
index 8761ea8..77f12ce 100644
--- a/test/controllers/books/publications_controller_test.rb
+++ b/test/controllers/books/publications_controller_test.rb
@@ -17,6 +17,45 @@ class Books::PublicationsTest < ActionDispatch::IntegrationTest
     assert_equal "manual", @book.slug
   end
 
+test "publishing with page changes announces once" do
+  assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+    patch book_publication_url(@book), params: {
+      book: { published: "1" },
+      added_pages: ["A new page"]
+    }
+  end
+end
+
+test "saving an already-live book does not announce" do
+  @book.update! published: true
+
+  assert_no_enqueued_jobs only: AnnouncePublicationJob do
+    patch book_publication_url(@book), params: {
+      book: { published: "1" },
+      added_pages: ["A new page"]
+    }
+  end
+end
+
+test "unpublishing does not announce" do
+  @book.update! published: true
+
+  assert_no_enqueued_jobs only: AnnouncePublicationJob do
+    patch book_publication_url(@book), params: { book: { published: "0" } }
+  end
+end
+
+test "a failed sitting does not announce or publish" do
+  assert_no_enqueued_jobs only: AnnouncePublicationJob do
+    @book.transaction do
+      @book.update! published: true
+      raise ActiveRecord::Rollback
+    end
+  end
+
+  assert_not @book.reload.published?
+end
+
   test "edit book slug" do
