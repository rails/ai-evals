@@ -0,0 +1,60 @@
+# Limits expensive unauthenticated searches without coupling the limit to a book
+# or to a signed-in session.
+class SearchRateLimiter
+  LIMIT = 30
+  WINDOW = 60.0
+  BLOCK_DURATION = 300.0
+
+  Entry = Struct.new(:requests, :blocked_until, :last_seen_at)
+
+  class << self
+    def allowed?(key, now: monotonic_time)
+      mutex.synchronize do
+        remove_expired_entries(now)
+
+        entry = entries[key] ||= Entry.new([], nil, now)
+        entry.last_seen_at = now
+
+        if entry.blocked_until && now < entry.blocked_until
+          false
+        else
+          entry.blocked_until = nil
+          entry.requests.reject! { |timestamp| timestamp <= now - WINDOW }
+
+          if entry.requests.length >= LIMIT
+            entry.blocked_until = now + BLOCK_DURATION
+            false
+          else
+            entry.requests << now
+            true
+          end
+        end
+      end
+    end
+
+    # Useful for isolated test processes and for explicitly clearing state after
+    # an application reload. Production code has no reason to call this.
+    def reset!
+      mutex.synchronize { entries.clear }
+    end
+
+    private
+      def entries
+        @entries ||= {}
+      end
+
+      def mutex
+        @mutex ||= Mutex.new
+      end
+
+      def monotonic_time
+        Process.clock_gettime(Process::CLOCK_MONOTONIC)
+      end
+
+      def remove_expired_entries(now)
+        entries.delete_if do |_key, entry|
+          now - entry.last_seen_at >= BLOCK_DURATION
+        end
+      end
+  end
+end
