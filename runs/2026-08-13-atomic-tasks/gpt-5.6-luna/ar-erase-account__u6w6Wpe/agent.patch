diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..97fabbc 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -24,7 +24,51 @@ class User < ApplicationRecord
     end
   end
 
+  # Permanently remove this user and every record owned by or identifying them.
+  # Books deliberately published to everyone are the one exception: their
+  # content remains available, but no longer points at this user.
+  def erase!
+    transaction do
+      retained_books = created_books.with_everyone_access
+      retained_books.update_all(creator_id: nil, author: "Deleted author")
+
+      books_to_remove = created_books.where.not(id: retained_books.select(:id))
+      books_to_remove.find_each do |book|
+        # Erasure is synchronous: do not leave private book files for a job
+        # that may not run before the request is considered complete.
+        book.cover.purge if book.cover.attached?
+        book.leaves.includes(:leafable).each do |leaf|
+          leaf.leafable.image.purge if leaf.leafable.is_a?(Picture) && leaf.leafable.image.attached?
+        end
+
+        # FTS is a virtual table and has no foreign key, so remove its rows
+        # explicitly before the associated leaves are destroyed.
+        Leaf.where(book_id: book.id).pluck(:id).each do |leaf_id|
+          Leaf.connection.execute(
+            Leaf.sanitize_sql_array([ "delete from leaf_search_index where rowid = ?", leaf_id ])
+          )
+        end
+        book.destroy!
+      end
+
+      # delete_all avoids creating signed-out audit events while erasing.
+      sessions.delete_all
+      accesses.delete_all
+      reading_marks.delete_all
+      SignInEvent.where(email_address: sign_in_addresses).delete_all
+      destroy!
+    end
+  end
+
   private
+    def sign_in_addresses
+      addresses = [ email_address ]
+      if (match = email_address.to_s.match(/\A(.+)-deactivated-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(@.+)\z/i))
+        addresses << "#{match[1]}#{match[2]}"
+      end
+      addresses
+    end
+
     def deactived_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
