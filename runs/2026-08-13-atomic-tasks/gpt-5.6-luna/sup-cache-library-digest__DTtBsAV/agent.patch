+
+  test "library digests are cached per user" do
+    Rails.cache.clear
+
+    assert_equal [ books(:handbook).id, books(:manual).id ].sort, users(:jz).library_digest.map { |book| book[:id] }.sort
+    assert_equal [ books(:handbook).id ], users(:kevin).library_digest.map { |book| book[:id] }
