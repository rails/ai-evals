+  test "library digest is reused for the same user" do
+    Rails.cache.clear
+    user = users(:kevin)
+
+    first = user.library_digest
+    user.accesses.create!(book: books(:manual), level: :reader)
+
+    assert_equal first, user.library_digest
+  end
+
+  test "library digest reflects access changes after its cache expires" do
+    Rails.cache.clear
+    user = users(:kevin)
+
+    user.library_digest
+    user.accesses.create!(book: books(:manual), level: :reader)
+    Rails.cache.delete("users/#{user.id}/library_digest")
+
+    assert_equal [ books(:handbook).id, books(:manual).id ].sort, user.library_digest.map { |book| book[:id] }.sort
