diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..52c9bb5 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,22 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    before_update :remember_publication
+    after_commit :announce_publication, on: :update, if: -> { @was_published && published? }
+    after_rollback :forget_publication, on: :update
   end
 
   private
+    def remember_publication
+      @was_published = true if will_save_change_to_published? && published?
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
+      forget_publication
+    end
+
+    def forget_publication
+      @was_published = false
     end
 end
