diff --git a/test/jobs/title_cleanup_job_test.rb b/test/jobs/title_cleanup_job_test.rb
new file mode 100644
index 0000000..49fc025
--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  self.use_transactional_tests = false
+
+  teardown do
+    TitleCleanupProgress.delete_all
+    Leaf.delete_all
+    Page.delete_all
+  end
+  setup do
+    TitleCleanupProgress.delete_all
+    Leaf.delete_all
+  end
+
+  test "resumes after the last committed leaf" do
+    leaves = 3.times.map do |index|
+      Leaf.create!(book: books(:handbook), title: %Q("Title #{index + 1}"),
+        leafable: Page.create!, position_score: index + 1)
+    end
+
+    calls = 0
+    job_class = Class.new(TitleCleanupJob) do
+      define_method(:cleaned) do |title|
+        calls += 1
+        raise "interrupted" if calls == 3
+        title.delete_prefix('"').delete_suffix('"')
+      end
+    end
+    assert_raises(RuntimeError) { job_class.new.perform }
+
+    assert_equal [ "Title 1", "Title 2", '"Title 3"' ], leaves.map { _1.reload.title }
+    assert_equal leaves[1].id, TitleCleanupProgress.first.last_leaf_id
+
+    TitleCleanupJob.perform_now
+
+    assert_equal [ "Title 1", "Title 2", "Title 3" ], leaves.map { _1.reload.title }
+    assert_equal leaves[2].id, TitleCleanupProgress.first.last_leaf_id
+  end
+
+  test "keeps quotes inside a title" do
+    leaf = Leaf.create!(book: books(:handbook), title: %q("A "quoted" phrase"),
+      leafable: Page.create!, position_score: 10)
+
+    TitleCleanupJob.perform_now
+
+    assert_equal %q(A "quoted" phrase), leaf.reload.title
+  end
+end
