diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..182c803 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -40,4 +40,20 @@ class BookTest < ActiveSupport::TestCase
   test "markable returns empty string for book with no leaves" do
     assert_equal "", books(:manual).markable
   end
+
+  test "compacts positions without changing their order" do
+    book = books(:handbook)
+    leaves(:welcome_section).update!(position_score: 30)
+    leaves(:welcome_page).update!(position_score: 10)
+    leaves(:summary_page).update!(position_score: 40)
+    leaves(:reading_picture).update!(position_score: 20)
+    leaves(:summary_page).trashed!
+
+    book.compact_positions!
+
+    assert_equal [ leaves(:welcome_page), leaves(:reading_picture), leaves(:welcome_section), leaves(:summary_page) ],
+      book.leaves.reload.positioned
+    assert_equal [ 1, 2, 3, 4 ], book.leaves.positioned.pluck(:position_score)
+    assert_equal 3, book.live_leaf_count
+  end
 end
