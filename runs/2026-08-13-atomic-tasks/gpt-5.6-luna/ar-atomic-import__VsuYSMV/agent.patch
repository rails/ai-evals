diff --git a/test/models/book_import_test.rb b/test/models/book_import_test.rb
new file mode 100644
index 0000000..c8a9aba
--- /dev/null
+++ b/test/models/book_import_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class BookImportTest < ActiveSupport::TestCase
+  test "rejecting an invalid entry rolls back entries before it" do
+    book = Book.create!(title: "Import book")
+
+    assert_not book.import_manifest([
+      { title: "First", body: "first" },
+      { title: "Invalid", body: nil },
+      { title: "Last", body: "last" }
+    ])
+    assert_empty book.reload.leaves
+  end
+
+  test "rejecting an invalid first entry imports nothing" do
+    book = Book.create!(title: "Import book")
+
+    assert_not book.import_manifest([
+      { title: nil, body: "body" },
+      { title: "Last", body: "last" }
+    ])
+    assert_empty book.reload.leaves
+  end
+
+  test "a valid manifest imports sections in order" do
+    book = Book.create!(title: "Import book")
+
+    assert book.import_manifest([
+      { title: "First", body: "first" },
+      { title: "Last", body: "last" }
+    ])
+    assert_equal [ "First", "Last" ], book.reload.leaves.order(:position_score).pluck(:title)
+    assert_equal [ "first", "last" ], book.leaves.order(:position_score).map { |leaf| leaf.leafable.body }
+  end
+
+  test "a duplicate title rejects the whole manifest" do
+    book = Book.create!(title: "Import book")
+    book.press(Section.new(body: "existing"), title: "Existing")
+
+    assert_not book.import_manifest([
+      { title: "New", body: "new" },
+      { title: "Existing", body: "duplicate" }
+    ])
+    assert_equal [ "Existing" ], book.reload.leaves.pluck(:title)
+  end
+
+  test "a rejected manifest rolls back only its savepoint in a bulk import" do
+    good_book = Book.create!(title: "Good book")
+    bad_book = Book.create!(title: "Bad book")
+
+    result = BulkImport.new(
+      good_book => [ { title: "Good", body: "body" } ],
+      bad_book => [ { title: "Bad first", body: "body" }, { title: "Bad", body: nil } ]
+    ).run
+
+    assert_equal [ good_book ], result.imported
+    assert_equal [ bad_book ], result.rejected
+    assert_equal [ "Good" ], good_book.reload.leaves.pluck(:title)
+    assert_empty bad_book.reload.leaves
+  end
+end
