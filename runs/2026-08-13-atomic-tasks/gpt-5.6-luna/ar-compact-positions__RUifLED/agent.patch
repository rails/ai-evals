+require "test_helper"
+
+class Book::MaintenanceTest < ActiveSupport::TestCase
+  test "compacting positions preserves the existing order" do
+    book = books(:handbook)
+    ordered_leaves = book.leaves.positioned.to_a
+
+    ordered_leaves.each_with_index do |leaf, index|
+      leaf.update_columns(position_score: (index + 1) * 10)
+    end
+
+    book.compact_positions!
+
+    assert_equal ordered_leaves.map(&:id), book.leaves.positioned.pluck(:id)
+    assert_equal [ 1, 2, 3, 4 ], book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "live leaf count excludes trashed leaves after compaction" do
+    book = books(:handbook)
+    leaves(:welcome_page).trashed!
+
+    book.compact_positions!
+
+    assert_equal 3, book.live_leaf_count
+  end
+end
