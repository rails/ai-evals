diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..fcfc833 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,26 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    before_update :remember_publication
+    after_update_commit :announce_publication, if: :published_for_first_time?
+    after_rollback :forget_publication
   end
 
   private
+    def remember_publication
+      @published_for_first_time ||= will_save_change_to_published? && published_change_to_be_saved == [ false, true ]
+    end
+
+    def published_for_first_time?
+      @published_for_first_time && published?
+    end
+
+    def forget_publication
+      @published_for_first_time = false
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
+      @published_for_first_time = false
     end
 end
