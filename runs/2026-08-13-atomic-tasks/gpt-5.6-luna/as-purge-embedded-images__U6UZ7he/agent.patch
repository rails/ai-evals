@@ -26,4 +27,21 @@ class PageTest < ActiveSupport::TestCase
     assert_includes page.searchable_content, "5 &lt; 10 &amp; 10 &gt; 5"
     assert page.searchable_content.html_safe?
   end
+
+  test "destroying a page purges its markdown uploads" do
+    page = pages(:welcome)
+    markdown = page.body.tap(&:save!)
+    markdown.uploads.attach File.open(Rails.root.join("test/fixtures/files/reading.webp"))
+    attachment = markdown.uploads.last
+    blob = attachment.blob
+    file_path = blob.service.path_for(blob.key)
+
+    assert File.exist?(file_path)
+
+    perform_enqueued_jobs { page.destroy! }
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not File.exist?(file_path)
+  end
 end
