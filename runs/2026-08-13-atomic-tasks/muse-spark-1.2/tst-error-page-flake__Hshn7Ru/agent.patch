 require_relative "../config/environment"
 require "rails/test_help"
 
+# Fix flaky with_raised_exceptions:
+# - Rails.application.env_config is memoized at first request, so toggling only
+#   Rails.application.config.action_dispatch.show_exceptions left the request
+#   env stale and caused order-dependent failures (404 pages vs raised RecordNotFound).
+# - Using a global flag also breaks under threaded parallelization.
+# Drive ActionDispatch::ExceptionWrapper via IsolatedExecutionState (thread/fiber local)
+# so with_raised_exceptions is isolated per execution and independent of memoization.
+module WithRaisedExceptionsIsolation
+  def show?(request)
+    return false if ActiveSupport::IsolatedExecutionState[:with_raised_exceptions]
+    super
+  end
+end
+ActionDispatch::ExceptionWrapper.prepend(WithRaisedExceptionsIsolation)
+
 module ActiveSupport
   class TestCase
-    # Run tests in parallel with specified workers
     parallelize(workers: :number_of_processors)
-
-    # Setup all fixtures in test/fixtures/*.yml for all tests in alphabetical order.
     fixtures :all
-
     include SessionTestHelper
 
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      previous = ActiveSupport::IsolatedExecutionState[:with_raised_exceptions]
+      ActiveSupport::IsolatedExecutionState[:with_raised_exceptions] = true
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      ActiveSupport::IsolatedExecutionState[:with_raised_exceptions] = previous
     end
   end
 end
