diff --git a/app/channels/book_streams_channel.rb b/app/channels/book_streams_channel.rb
new file mode 100644
index 0000000..7415391
--- /dev/null
+++ b/app/channels/book_streams_channel.rb
@@ -0,0 +1,30 @@
+class BookStreamsChannel < Turbo::StreamsChannel
+  def subscribed
+    if (stream_name = verified_stream_name_from_params).present? && authorized?(stream_name)
+      stream_from stream_name
+    else
+      reject
+    end
+  end
+
+  private
+
+  def authorized?(stream_name)
+    book = extract_book_from_stream_name(stream_name)
+    return false unless book
+
+    book.editable?(user: current_user)
+  end
+
+  def extract_book_from_stream_name(stream_name)
+    stream_name.split(":").each do |part|
+      begin
+        record = GlobalID::Locator.locate(part)
+        return record if record.is_a?(Book)
+      rescue
+        next
+      end
+    end
+    nil
+  end
+end
