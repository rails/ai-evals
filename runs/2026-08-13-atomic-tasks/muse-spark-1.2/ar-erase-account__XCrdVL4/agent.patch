diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..7c69156 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -18,9 +18,47 @@ class User < ApplicationRecord
   end
 
   def deactivate
+    erase
+  end
+
+  def erase
     transaction do
-      sessions.delete_all
-      update! active: false, email_address: deactived_email_address
+      user_id = id
+      emails_to_purge = [ email_address ].compact
+      if email_address&.include?("-deactivated-")
+        original = email_address.sub(/-deactivated-.*@/, "@")
+        emails_to_purge << original if original != email_address && original.present?
+      end
+
+      # Handle authored books
+      authored_books = Book.where(creator_id: user_id).to_a
+      authored_books.each do |book|
+        if book.everyone_access?
+          # Bypass belongs_to default (Current.user) by using update_all
+          Book.where(id: book.id).update_all(author: "Deleted author", creator_id: nil)
+        else
+          leaf_ids = book.leaves.pluck(:id)
+          unless leaf_ids.empty?
+            placeholders = leaf_ids.map { "?" }.join(",")
+            self.class.connection.execute(
+              self.class.sanitize_sql([ "delete from leaf_search_index where rowid in (#{placeholders})", *leaf_ids ])
+            )
+          end
+          book.destroy!
+        end
+      end
+
+      Access.where(user_id: user_id).delete_all
+      Session.where(user_id: user_id).delete_all
+      ReadingMark.where(user_id: user_id).delete_all
+      SignInEvent.where(email_address: emails_to_purge).delete_all
+
+      association(:created_books).reset
+      association(:accesses).reset
+      association(:sessions).reset
+
+      self.class.where(id: user_id).delete_all
+      freeze
     end
   end
 
