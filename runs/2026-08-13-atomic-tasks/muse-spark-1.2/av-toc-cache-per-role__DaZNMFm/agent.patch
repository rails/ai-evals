+#!/usr/bin/env ruby
+# Reproduce caching issue
+ENV['RAILS_ENV'] = 'development'
+require_relative 'config/environment'
+
+# Enable caching for reproduction
+Rails.application.config.action_controller.perform_caching = true
+Rails.application.config.cache_store = :memory_store
+ActionController::Base.perform_caching = true
+Rails.cache = ActiveSupport::Cache::MemoryStore.new
+# Clear cache
+Rails.cache.clear
+
+# Get books and users
+Book.destroy_all
+User.destroy_all
+Access.destroy_all
+Leaf.destroy_all
+Page.destroy_all
+Section.destroy_all
+
+# Create users
+kevin = User.create!(name: "Kevin", email_address: "kevin@example.com", password: "secret123456", role: :member)
+jz = User.create!(name: "JZ", email_address: "jz@example.com", password: "secret123456", role: :member)
+
+# Create book
+book = Book.create!(title: "Test Book", slug: "test-book", published: false)
+# Give kevin editor, jz reader
+book.accesses.create!(user: kevin, level: :editor)
+book.accesses.create!(user: jz, level: :reader)
+
+# Create leaves
+page = Page.create!(body: "Hello")
+leaf1 = book.leaves.create!(title: "Original Title", leafable: page, position_score: 1, status: :active)
+page2 = Page.create!(body: "Second")
+leaf2 = book.leaves.create!(title: "Second Page", leafable: page2, position_score: 2, status: :active)
+
+puts "Book editable for kevin? #{book.editable?(user: kevin)}" # expect true
+puts "Book editable for jz? #{book.editable?(user: jz)}" # expect false
+
+leaves = book.leaves.active.with_leafables.positioned.to_a
+# Simulate what _leaf cache does: cache [leaf, leaf.book, leaf.book.editable?]
+Rails.cache.clear
+Current.user = kevin
+editable_kevin = book.editable?(user: kevin)
+puts "editable kevin: #{editable_kevin}"
+Current.user = jz
+editable_jz = book.editable?(user: jz)
+puts "editable jz: #{editable_jz}"
+
+# Now test fragment cache keys for leaf
+controller = BooksController.new
+controller.request = ActionDispatch::TestRequest.create
+controller.response = ActionDispatch::TestResponse.new
+Current.user = kevin
+view = controller.view_context
+key_kevin = view.cache_fragment_name([leaves.first, leaves.first.book, leaves.first.book.editable?])
+puts "cache key for leaf as kevin: #{key_kevin.inspect}"
+Current.user = jz
+key_jz = view.cache_fragment_name([leaves.first, leaves.first.book, leaves.first.book.editable?])
+puts "cache key for leaf as jz: #{key_jz.inspect}"
+puts "keys equal? #{key_kevin == key_jz}"
+puts "keys differ? #{key_kevin != key_jz}"
+
+view2 = controller.view_context
+key_coll_kevin = view2.cache_fragment_name(leaves.first, digest_path: view2.digest_path_from_template(view2.lookup_context.find_template("leaves/_leaf", [], true, {}, {})))
+puts "collection cache key (identity) for leaf: #{key_coll_kevin.inspect}"
+
+puts "\n--- Trying integration render ---"
+Rails.cache = ActiveSupport::Cache::MemoryStore.new
+ActionController::Base.perform_caching = true
+
+class CacheReproTest < ActionDispatch::IntegrationTest
+  def test_cache_leak
+    Rails.cache.clear
+    ActionController::Base.perform_caching = true
+    Rails.application.config.action_controller.perform_caching = true
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+
+    kevin = User.find_by(email_address: "kevin@example.com")
+    jz = User.find_by(email_address: "jz@example.com")
+    book = Book.find_by(slug: "test-book")
+
+    post session_url, params: { email_address: kevin.email_address, password: "secret123456" }
+    puts "kevin login status: #{response.status}"
+    get book_slug_path(book)
+    body_kevin_first = response.body
+    has_edit_kevin_first = body_kevin_first.include?("hide_from_reading_mode") || body_kevin_first.include?("edit-")
+    puts "kevin first render has edit controls? #{has_edit_kevin_first}"
+    puts "kevin body snippet: #{body_kevin_first[0..3000].gsub(/\n/, ' ')}"
+
+    delete session_url
+    post session_url, params: { email_address: jz.email_address, password: "secret123456" }
+    puts "jz login status: #{response.status}"
+    get book_slug_path(book)
+    body_jz = response.body
+    has_edit_jz = body_jz.include?("hide_from_reading_mode")
+    puts "jz render has edit controls? #{has_edit_jz} (should be false for reader)"
+    if has_edit_jz
+      puts "BUG REPRODUCED: reader got editor controls after editor viewed"
+    else
+      puts "No bug: reader correctly has no edit controls"
+    end
+
+    Rails.cache.clear
+    delete session_url
+    post session_url, params: { email_address: jz.email_address, password: "secret123456" }
+    get book_slug_path(book)
+    body_jz_first = response.body
+    has_edit_jz_first = body_jz_first.include?("hide_from_reading_mode")
+    puts "jz first render has edit controls? #{has_edit_jz_first} (should be false)"
+
+    delete session_url
+    post session_url, params: { email_address: kevin.email_address, password: "secret123456" }
+    get book_slug_path(book)
+    body_kevin_second = response.body
+    has_edit_kevin_second = body_kevin_second.include?("hide_from_reading_mode")
+    puts "kevin second render has edit controls? #{has_edit_kevin_second} (should be true)"
+    if !has_edit_kevin_second
+      puts "BUG REPRODUCED: editor lost controls after reader viewed"
+    else
+      puts "No bug: editor correctly has controls"
+    end
+
+    Rails.cache.clear
+    delete session_url
+    post session_url, params: { email_address: kevin.email_address, password: "secret123456" }
+    get book_slug_path(book)
+    leaf = book.leaves.first
+    leaf.update!(title: "RENAMED TITLE")
+    puts "leaf updated title to #{leaf.title}, book updated_at #{book.reload.updated_at}"
+    delete session_url
+    post session_url, params: { email_address: jz.email_address, password: "secret123456" }
+    get book_slug_path(book)
+    body_jz_rename = response.body
+    has_new_title = body_jz_rename.include?("RENAMED TITLE")
+    puts "jz sees renamed title? #{has_new_title} (should be true)"
+    if !has_new_title
+      puts "BUG: renamed title not visible"
+    else
+      puts "Rename visible"
+    end
+  end
+end
+
+test = CacheReproTest.new("test_cache_leak")
+test.test_cache_leak
