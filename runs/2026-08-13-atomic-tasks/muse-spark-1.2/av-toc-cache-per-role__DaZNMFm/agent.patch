+require "test_helper"
+
+class CacheBug2Test < ActionDispatch::IntegrationTest
+  def setup
+    @original_cache_store = Rails.cache
+    @original_perform_caching = ActionController::Base.perform_caching
+    @original_config_perform_caching = Rails.application.config.action_controller.perform_caching
+    @original_collection_cache = ActionView::PartialRenderer.collection_cache
+
+    cache = ActiveSupport::Cache::MemoryStore.new
+    Rails.cache = cache
+    ActionView::PartialRenderer.collection_cache = cache
+    ActionController::Base.perform_caching = true
+    Rails.application.config.action_controller.perform_caching = true
+    Rails.cache.clear
+  end
+
+  def teardown
+    Rails.cache = @original_cache_store
+    ActionView::PartialRenderer.collection_cache = @original_collection_cache
+    ActionController::Base.perform_caching = @original_perform_caching
+    Rails.application.config.action_controller.perform_caching = @original_config_perform_caching
+    Rails.cache.clear
+  end
+
+  def test_reader_after_editor
+    book = books(:handbook)
+    sign_in :kevin
+    get book_slug_path(book)
+    assert body_has_edit?
+
+    sign_out
+    sign_in :jz
+    get book_slug_path(book)
+    has_edit = body_has_edit?
+    puts "Reader after editor has edit? #{has_edit} (expect false) -> #{has_edit ? 'BUG' : 'OK'}"
+    assert_not has_edit, "Reader got editor controls"
+  end
+
+  def test_editor_after_reader
+    Rails.cache.clear
+    ActionView::PartialRenderer.collection_cache.clear if ActionView::PartialRenderer.collection_cache.respond_to?(:clear)
+    book = books(:handbook)
+    sign_in :jz
+    get book_slug_path(book)
+    assert_not body_has_edit?
+
+    sign_out
+    sign_in :kevin
+    get book_slug_path(book)
+    has_edit = body_has_edit?
+    puts "Editor after reader has edit? #{has_edit} (expect true) -> #{has_edit ? 'OK' : 'BUG'}"
+    assert has_edit, "Editor lost controls"
+  end
+
+  def test_rename
+    Rails.cache.clear
+    ActionView::PartialRenderer.collection_cache.clear if ActionView::PartialRenderer.collection_cache.respond_to?(:clear)
+    book = books(:handbook)
+    leaf = leaves(:welcome_page)
+    sign_in :kevin
+    get book_slug_path(book)
+    new_title = "Renamed #{rand(100000)}"
+    leaf.update!(title: new_title)
+    book.touch # ensure book updated_at changes if needed?
+    sign_out
+    sign_in :jz
+    get book_slug_path(book)
+    has_new = response.body.include?(new_title)
+    puts "Rename visible? #{has_new} (expect true)"
+    assert has_new
+  end
+
+  private
+    def body_has_edit?
+      response.body.include?('hide_from_reading_mode')
+    end
+end
