@@ -0,0 +1,79 @@
+require "test_helper"
+
+class CacheBugTest < ActionDispatch::IntegrationTest
+  def setup
+    # Enable fragment caching with memory store
+    @original_cache_store = Rails.cache
+    @original_perform_caching = ActionController::Base.perform_caching
+    @original_config_perform_caching = Rails.application.config.action_controller.perform_caching
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    ActionController::Base.perform_caching = true
+    Rails.application.config.action_controller.perform_caching = true
+    Rails.cache.clear
+    # Ensure view cache is cleared as well
+  end
+
+  def teardown
+    Rails.cache = @original_cache_store
+    ActionController::Base.perform_caching = @original_perform_caching
+    Rails.application.config.action_controller.perform_caching = @original_config_perform_caching
+    Rails.cache.clear
+  end
+
+  def test_reader_gets_editor_controls_after_editor_viewed
+    book = books(:handbook)
+    # kevin is editor via access, jz is reader
+    sign_in :kevin
+    get book_slug_path(book)
+    assert_response :success
+    body_editor = response.body
+    assert body_editor.include?('hide_from_reading_mode'), "editor should have edit controls"
+
+    # without clearing cache, reader visits
+    sign_out
+    sign_in :jz
+    get book_slug_path(book)
+    assert_response :success
+    body_reader = response.body
+    has_edit = body_reader.include?('hide_from_reading_mode')
+    puts "Reader after editor has edit? #{has_edit} (should be false)"
+    assert_not has_edit, "Reader got editor controls after editor viewed!"
+  end
+
+  def test_editor_loses_controls_after_reader_viewed
+    Rails.cache.clear
+    book = books(:handbook)
+    sign_in :jz
+    get book_slug_path(book)
+    body_reader = response.body
+    assert_not body_reader.include?('hide_from_reading_mode'), "reader should not have edit controls"
+
+    sign_out
+    sign_in :kevin
+    get book_slug_path(book)
+    body_editor = response.body
+    has_edit = body_editor.include?('hide_from_reading_mode')
+    puts "Editor after reader has edit? #{has_edit} (should be true)"
+    assert has_edit, "Editor lost controls after reader viewed!"
+  end
+
+  def test_rename_shows
+    Rails.cache.clear
+    book = books(:handbook)
+    leaf = leaves(:welcome_page)
+    sign_in :kevin
+    get book_slug_path(book)
+    assert response.body.include?(leaf.title)
+    new_title = "Brand New Title #{Time.now.to_i}"
+    leaf.update!(title: new_title)
+    # touch should update book, but ensure book reload
+    book.reload
+    puts "book updated_at after rename: #{book.updated_at}"
+
+    sign_out
+    sign_in :jz
+    get book_slug_path(book)
+    puts "reader body includes new title? #{response.body.include?(new_title)}"
+    assert response.body.include?(new_title), "Renamed title not visible to next person"
+  end
+end
