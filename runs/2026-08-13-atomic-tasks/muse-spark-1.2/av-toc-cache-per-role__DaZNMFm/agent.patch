@@ -0,0 +1,91 @@
+ENV['RAILS_ENV'] = 'test'
+require_relative 'config/environment'
+require 'rails/test_help'
+# Enable caching for test
+Rails.application.config.action_controller.perform_caching = true
+ActionController::Base.perform_caching = true
+Rails.cache = ActiveSupport::Cache::MemoryStore.new
+Rails.cache.clear
+
+class CacheBugTest < ActionDispatch::IntegrationTest
+  # disable parallel?
+  self.use_transactional_tests = false
+
+  def setup
+    Rails.cache.clear
+  end
+
+  def test_reader_after_editor
+    Rails.cache.clear
+    book = books(:handbook)
+    # Ensure kevin is editor, jz is reader
+    # kevin is member but has editor access; jz is reader
+    sign_in :kevin
+    get book_slug_path(book)
+    assert_response :success
+    body_editor = response.body
+    has_edit_editor = body_editor.include?('hide_from_reading_mode')
+    puts "EDITOR first has edit? #{has_edit_editor} (expect true)"
+    # Now as reader, without clearing cache
+    sign_out
+    sign_in :jz
+    get book_slug_path(book)
+    body_reader = response.body
+    has_edit_reader = body_reader.include?('hide_from_reading_mode')
+    puts "READER after editor has edit? #{has_edit_reader} (expect false)"
+    if has_edit_reader
+      puts "BUG 1 REPRODUCED: reader got editor controls"
+    else
+      puts "BUG 1 NOT reproduced"
+    end
+    assert_not has_edit_reader, "Reader should not have edit controls after editor visited"
+  end
+
+  def test_editor_after_reader
+    Rails.cache.clear
+    book = books(:handbook)
+    sign_in :jz
+    get book_slug_path(book)
+    body_reader = response.body
+    has_edit_reader = body_reader.include?('hide_from_reading_mode')
+    puts "READER first has edit? #{has_edit_reader} (expect false)"
+    sign_out
+    sign_in :kevin
+    get book_slug_path(book)
+    body_editor = response.body
+    has_edit_editor = body_editor.include?('hide_from_reading_mode')
+    puts "EDITOR after reader has edit? #{has_edit_editor} (expect true)"
+    if !has_edit_editor
+      puts "BUG 2 REPRODUCED: editor lost controls after reader visited"
+    else
+      puts "BUG 2 NOT reproduced"
+    end
+    assert has_edit_editor, "Editor should have edit controls after reader visited"
+  end
+
+  def test_rename
+    Rails.cache.clear
+    book = books(:handbook)
+    leaf = leaves(:welcome_page)
+    sign_in :kevin
+    get book_slug_path(book)
+    # rename leaf
+    leaf.update!(title: "RENAMED_#{Time.now.to_i}")
+    puts "Renamed leaf to #{leaf.title}"
+    sign_out
+    sign_in :jz
+    get book_slug_path(book)
+    has_new = response.body.include?(leaf.title)
+    puts "Reader sees renamed title? #{has_new} (expect true)"
+    if !has_new
+      puts "BUG 3 REPRODUCED: rename not visible"
+    else
+      puts "BUG 3 NOT reproduced"
+    end
+    assert has_new
+  end
+end
+
+# Run
+require 'minitest'
+Minitest.run
