diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..691aa96 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -18,9 +18,43 @@ class User < ApplicationRecord
   end
 
   def deactivate
+    erase!
+  end
+
+  def erase!
     transaction do
-      sessions.delete_all
-      update! active: false, email_address: deactived_email_address
+      current_email = email_address
+      original = original_email_address
+      emails = [ current_email, original ].compact.uniq
+
+      # Keep shared books, anonymize them
+      created_books.where(everyone_access: true).update_all(author: "Deleted author", creator_id: nil)
+      # Private books are fully removed (leaves + search index handled via callbacks)
+      created_books.where(everyone_access: false).find_each(&:destroy!)
+
+      # Reset association so dependent: :destroy doesn't try to re-destroy shared books
+      association(:created_books).reset
+
+      # Remove sessions without triggering sign_out events
+      Session.where(user_id: id).delete_all
+
+      ReadingMark.where(user_id: id).delete_all
+
+      SignInEvent.where(email_address: emails).delete_all if emails.any?
+
+      destroy!
+
+      # Double-clean in case callbacks created stray events
+      SignInEvent.where(email_address: emails).delete_all if emails.any?
+    end
+  end
+
+  def original_email_address
+    return nil if email_address.blank?
+    if email_address.include?("-deactivated-")
+      email_address.sub(/-deactivated-[^@]*@/, "@")
+    else
+      email_address
     end
   end
 
