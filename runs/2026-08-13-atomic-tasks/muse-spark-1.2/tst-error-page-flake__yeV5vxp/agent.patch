+# Make with_raised_exceptions reliable even when env_config is memoized and
+# when tests run in parallel (processes or threads). The original helper only
+# mutated config, but requests read from Rails.application.env_config which is
+# cached after first use. We keep both in sync and use a thread-local flag as
+# a safety net for threaded parallelization.
+module ActionDispatch
+  class ExceptionWrapper
+    alias_method :__show_without_thread_override?, :show?
+    def show?(request)
+      return false if Thread.current[:__with_raised_exceptions__]
+      __show_without_thread_override?(request)
+    end
+  end
+end
+
