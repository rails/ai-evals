+ENV["RAILS_ENV"]="test"
+require_relative "config/environment"
+require "rails/test_help"
+# patch to instrument
+module ActiveSupport
+ class TestCase
+   alias_method :orig_with, :with_raised_exceptions if method_defined?(:with_raised_exceptions)
+   def with_raised_exceptions
+     puts "[with_raised_exceptions] enter config=#{Rails.application.config.action_dispatch.show_exceptions.inspect} env=#{Rails.application.env_config['action_dispatch.show_exceptions'].inspect}"
+     previous = Rails.application.config.action_dispatch.show_exceptions
+     Rails.application.config.action_dispatch.show_exceptions = :none
+     puts "[with_raised_exceptions] inside config=#{Rails.application.config.action_dispatch.show_exceptions.inspect} env=#{Rails.application.env_config['action_dispatch.show_exceptions'].inspect}"
+     yield
+   ensure
+     Rails.application.config.action_dispatch.show_exceptions = previous
+     puts "[with_raised_exceptions] exit config=#{Rails.application.config.action_dispatch.show_exceptions.inspect} env=#{Rails.application.env_config['action_dispatch.show_exceptions'].inspect}"
+   end
+ end
+end
+# Simulate two tests sequentially in same process
+class DummyTest < ActionDispatch::IntegrationTest
+ def test1
+   puts "test1 start env=#{Rails.application.env_config['action_dispatch.show_exceptions'].inspect}"
+   with_raised_exceptions do
+     assert_raises ActiveRecord::RecordNotFound do
+       get "/books/manual"
+     end
+   end
+   puts "test1 end"
+ end
+ def test2
+   puts "test2 start env=#{Rails.application.env_config['action_dispatch.show_exceptions'].inspect} config=#{Rails.application.config.action_dispatch.show_exceptions.inspect}"
+   get "/books/manual"
+   puts "test2 status=#{response.status}"
+ end
+end
