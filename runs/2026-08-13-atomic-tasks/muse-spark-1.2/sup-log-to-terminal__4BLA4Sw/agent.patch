diff --git a/config/initializers/stdout_broadcast.rb b/config/initializers/stdout_broadcast.rb
new file mode 100644
index 0000000..2b64951
--- /dev/null
+++ b/config/initializers/stdout_broadcast.rb
@@ -0,0 +1,36 @@
+# Ensure Rails.logger broadcasts to both STDOUT and the environment log file,
+# so `bin/rails runner` shows output on the terminal while still recording
+# every line in the environment's log file (e.g. log/development.log).
+Rails.application.config.after_initialize do
+  next unless defined?(Rails.logger) && Rails.logger
+  unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT)
+    stdout_logger = ActiveSupport::Logger.new(STDOUT)
+    stdout_logger.formatter = Rails.logger.formatter if Rails.logger.respond_to?(:formatter) && Rails.logger.formatter
+    begin
+      stdout_logger.level = Rails.logger.level
+    rescue
+    end
+    stdout_logger = ActiveSupport::TaggedLogging.new(stdout_logger)
+    if Rails.logger.is_a?(ActiveSupport::BroadcastLogger)
+      Rails.logger.broadcast_to(stdout_logger)
+    else
+      Rails.logger = ActiveSupport::BroadcastLogger.new(Rails.logger, stdout_logger)
+    end
+  end
+  log_path = Rails.root.join("log", "#{Rails.env}.log").to_s
+  unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, log_path)
+    FileUtils.mkdir_p(File.dirname(log_path))
+    file_logger = ActiveSupport::Logger.new(log_path)
+    file_logger.formatter = Rails.logger.formatter if Rails.logger.respond_to?(:formatter) && Rails.logger.formatter
+    begin
+      file_logger.level = Rails.logger.level
+    rescue
+    end
+    file_logger = ActiveSupport::TaggedLogging.new(file_logger)
+    if Rails.logger.is_a?(ActiveSupport::BroadcastLogger)
+      Rails.logger.broadcast_to(file_logger)
+    else
+      Rails.logger = ActiveSupport::BroadcastLogger.new(Rails.logger, file_logger)
+    end
+  end
+end
