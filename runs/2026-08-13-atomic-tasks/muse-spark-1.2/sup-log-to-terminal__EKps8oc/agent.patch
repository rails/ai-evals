diff --git a/config/initializers/broadcast_stdout.rb b/config/initializers/broadcast_stdout.rb
new file mode 100644
index 0000000..e8855c5
--- /dev/null
+++ b/config/initializers/broadcast_stdout.rb
@@ -0,0 +1,33 @@
+# Ensure every log line is both persisted to the environment's log file and
+# visible on the terminal. `bin/rails runner` normally only writes to the
+# file, so the library report was invisible.
+Rails.application.config.after_initialize do
+  # Ensure STDOUT broadcasting
+  unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDOUT, STDERR, $stdout)
+    console = ActiveSupport::Logger.new(STDOUT)
+    src_formatter = Rails.logger.formatter rescue nil
+    src_formatter ||= Rails.logger.broadcasts.first.formatter if Rails.logger.is_a?(ActiveSupport::BroadcastLogger) && Rails.logger.broadcasts.first
+    console.formatter = src_formatter if src_formatter
+    src_level = Rails.logger.level rescue nil
+    console.level = src_level if src_level
+    console = ActiveSupport::TaggedLogging.new(console) unless console.respond_to?(:tagged)
+    Rails.logger.broadcast_to(console)
+  end
+
+  # Ensure file broadcasting (covers envs like production that override logger to STDOUT)
+  log_path = Rails.root.join("log", "#{Rails.env}.log").to_s
+  unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, log_path)
+    begin
+      file_logger = ActiveSupport::Logger.new(log_path)
+      src_formatter = Rails.logger.formatter rescue nil
+      src_formatter ||= Rails.logger.broadcasts.first.formatter if Rails.logger.is_a?(ActiveSupport::BroadcastLogger) && Rails.logger.broadcasts.first
+      file_logger.formatter = src_formatter if src_formatter
+      src_level = Rails.logger.level rescue nil
+      file_logger.level = src_level if src_level
+      file_logger = ActiveSupport::TaggedLogging.new(file_logger)
+      Rails.logger.broadcast_to(file_logger)
+    rescue StandardError => e
+      warn "Unable to broadcast to log file #{log_path}: #{e.message}"
+    end
+  end
+end
