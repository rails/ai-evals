  [1m[36mLeaf Create (0.1ms)[0m  [1m[32mINSERT INTO "leaves" ("book_id", "leafable_type", "leafable_id", "position_score", "status", "created_at", "updated_at", "title") VALUES (?, ?, ?, ?, ?, ?, ?, ?) RETURNING "id"[0m  [["book_id", 1057022144], ["leafable_type", "Page"], ["leafable_id", 936075708], ["position_score", 9.0], ["status", "active"], ["created_at", "2026-08-10 13:43:33.039386"], ["updated_at", "2026-08-10 13:43:33.039386"], ["title", "Publishing on the web"]]
