+require "fileutils"
+
 class TitleCleanupJob < ApplicationJob
+  CHECKPOINT_PATH = Rails.root.join("tmp", "title_cleanup_checkpoint")
+
   def perform
-    Leaf.find_each(order: :asc) do |leaf|
+    last_id = read_checkpoint
+    scope = last_id ? Leaf.where("id > ?", last_id).order(:id) : Leaf.order(:id)
+
+    scope.find_each do |leaf|
       leaf.update!(title: cleaned(leaf.title))
+      write_checkpoint(leaf.id)
     end
+
+    clear_checkpoint
   end
 
   private
+
     def cleaned(title)
-      title.delete_prefix('"').delete_suffix('"')
+      return title unless title.start_with?('"') && title.end_with?('"') && title.length >= 2
+      title[1...-1]
+    end
+
+    def read_checkpoint
+      return nil unless File.exist?(CHECKPOINT_PATH)
+      content = File.read(CHECKPOINT_PATH).to_s.strip
+      return nil if content.empty?
+      Integer(content)
+    rescue
+      nil
+    end
+
+    def write_checkpoint(id)
+      FileUtils.mkdir_p(File.dirname(CHECKPOINT_PATH))
+      File.write(CHECKPOINT_PATH, id.to_s)
+    end
+
+    def clear_checkpoint
+      File.delete(CHECKPOINT_PATH) if File.exist?(CHECKPOINT_PATH)
+    rescue
+      nil
     end
