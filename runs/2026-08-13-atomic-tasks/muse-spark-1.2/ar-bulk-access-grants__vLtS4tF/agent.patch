@@ -6,20 +6,106 @@ class Book::AccessImport
   end
 
   def import
+    # --- Find earliest invalid level ---
+    invalid_index = nil
+    @grants.each_with_index do |grant, index|
+      level = grant[:level]
+      unless Access.levels.key?(level.to_s)
+        invalid_index = index
+        break
+      end
+    end
+
+    # --- Find earliest duplicate within the sheet ---
+    intra_dup_index = nil
+    seen = {}
+    @grants.each_with_index do |grant, index|
+      uid = grant[:user_id]
+      if seen.key?(uid)
+        intra_dup_index = index
+        break
+      end
+      seen[uid] = true
+    end
+
+    # --- Find earliest duplicate against DB (single read) ---
+    existing_dup_index = nil
+    if @grants.any?
+      user_ids = @grants.map { |g| g[:user_id] }
+      existing_ids = @book.accesses.where(user_id: user_ids).pluck(:user_id).to_set
+      @grants.each_with_index do |grant, index|
+        if existing_ids.include?(grant[:user_id])
+          existing_dup_index = index
+          break
+        end
+      end
+    end
+
+    # Earliest bad row wins (like sequential create! would)
+    bad_index = [invalid_index, intra_dup_index, existing_dup_index].compact.min
+    return Result.new([], bad_index) if bad_index
+
+    return Result.new([], nil) if @grants.empty?
+
+    # --- Bulk insert (single round-trip for writes) -----------------------
+    now = Time.current
+    user_ids = @grants.map { |g| g[:user_id] }
+    records = @grants.map do |grant|
+      {
+        book_id: @book.id,
+        user_id: grant[:user_id],
+        level: grant[:level].to_s,
+        created_at: now,
+        updated_at: now
+      }
+    end
+
     accesses = []
     duplicate_index = nil
 
     Access.transaction do
-      @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
+      begin
+        Access.insert_all!(records)
+        inserted = @book.accesses.where(user_id: user_ids).to_a
+        by_user = inserted.index_by(&:user_id)
+        accesses = @grants.map { |g| by_user[g[:user_id]] }.compact
       rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
+        existing_ids = @book.accesses.where(user_id: user_ids).pluck(:user_id).to_set
+        @grants.each_with_index do |grant, index|
+          if existing_ids.include?(grant[:user_id])
+            duplicate_index = index
+            break
+          end
+        end
+        if duplicate_index.nil?
+          seen2 = {}
+          @grants.each_with_index do |grant, index|
+            if seen2.key?(grant[:user_id])
+              duplicate_index = index
+              break
+            end
+            seen2[grant[:user_id]] = true
+          end
+        end
+        duplicate_index ||= 0
+        raise ActiveRecord::Rollback
+      rescue ArgumentError
+        @grants.each_with_index do |grant, index|
+          unless Access.levels.key?(grant[:level].to_s)
+            duplicate_index = index
+            break
+          end
+        end
+        duplicate_index ||= 0
         raise ActiveRecord::Rollback
       end
     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
+    if duplicate_index
+      Result.new([], duplicate_index)
+    else
+      accesses.each { |access| Book::AccessNotificationJob.perform_later(access) }
+      Result.new(accesses, nil)
+    end
   end
 end
