diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..3e1a25b 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -2,6 +2,33 @@ ENV["RAILS_ENV"] ||= "test"
 require_relative "../config/environment"
 require "rails/test_help"
 
+# Make with_raised_exceptions thread- and process-safe.
+# ShowExceptions reads ActionDispatch::ExceptionWrapper#show? which checks
+# the request header "action_dispatch.show_exceptions" (populated from
+# Rails.application.env_config). Mutating Rails.application.config/env_config
+# globally leaks between sequential tests in the same worker and races between
+# parallel threads. Instead we keep a thread-local override and make the wrapper
+# respect it.
+module ActionDispatchExceptionWrapperShowPatch
+  def show?(request)
+    if Thread.current.key?(:action_dispatch_show_exceptions_override)
+      override = Thread.current[:action_dispatch_show_exceptions_override]
+      unless override.nil?
+        case override
+        when :none
+          return false
+        when :rescuable
+          return rescue_response?
+        else
+          return true
+        end
+      end
+    end
+    super
+  end
+end
+ActionDispatch::ExceptionWrapper.prepend ActionDispatchExceptionWrapperShowPatch
+
 module ActiveSupport
   class TestCase
     # Run tests in parallel with specified workers
@@ -13,11 +40,11 @@ module ActiveSupport
     include SessionTestHelper
 
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      previous = Thread.current[:action_dispatch_show_exceptions_override]
+      Thread.current[:action_dispatch_show_exceptions_override] = :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      Thread.current[:action_dispatch_show_exceptions_override] = previous
     end
   end
 end
