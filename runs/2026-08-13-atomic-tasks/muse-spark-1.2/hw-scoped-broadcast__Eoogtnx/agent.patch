diff --git a/app/channels/being_edited_channel.rb b/app/channels/being_edited_channel.rb
new file mode 100644
index 0000000..50e1f7f
--- /dev/null
+++ b/app/channels/being_edited_channel.rb
@@ -0,0 +1,30 @@
+class BeingEditedChannel < ApplicationCable::Channel
+  extend Turbo::Streams::StreamName
+  include Turbo::Streams::StreamName::ClassMethods
+
+  def subscribed
+    if (stream_name = verified_stream_name_from_params) && authorized?(stream_name)
+      stream_from stream_name
+    else
+      reject
+    end
+  end
+
+  private
+
+  def authorized?(stream_name)
+    # stream_name is like "gid://writebook/Book/42:gid://writebook/Leaf/99:being_edited"
+    book_id = stream_name[/\/Book\/(\d+)/, 1]
+    return false unless book_id
+
+    book = Book.find_by(id: book_id)
+    return false unless book
+
+    user = connection.current_user
+    return false unless user
+
+    book.editable?(user: user)
+  rescue => _e
+    false
+  end
+end
