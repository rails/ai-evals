diff --git a/app/models/leaf/editable.rb b/app/models/leaf/editable.rb
index d00f2a6..cb9be98 100644
--- a/app/models/leaf/editable.rb
+++ b/app/models/leaf/editable.rb
@@ -61,6 +61,20 @@ module Leaf::Editable
 
     def record_moved_to_trash
       edits.trash.create!(leafable: leafable)
+      purge_leafable_attachments_later
+    end
+
+    def purge_leafable_attachments_later
+      if leafable.is_a?(Page) && leafable.body.uploads.attached?
+        leafable.body.uploads.purge_later
+      elsif leafable.respond_to?(:image) && leafable.image.attached?
+        leafable.image.purge_later
+      else
+        leafable.attachment_reflections.each do |name, _|
+          attachment = leafable.public_send(name)
+          attachment.purge_later if attachment.respond_to?(:attached?) && attachment.attached?
+        end
+      end
     end
 
     def was_trashed?
