diff --git a/test/controllers/pages_controller_test.rb b/test/controllers/pages_controller_test.rb
index 0b0ccec..30b38d5 100644
--- a/test/controllers/pages_controller_test.rb
+++ b/test/controllers/pages_controller_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class PagesControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -79,8 +81,66 @@ class PagesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "With even more interesting words.", updated_page.body.content
   end
 
+  test "edit subscribes to a being-edited stream scoped to the current user" do
+    get edit_leafable_path(leaves(:welcome_page))
+
+    assert_response :ok
+    assert_select "turbo-cable-stream-source[signed-stream-name=?]",
+      Turbo::StreamsChannel.signed_stream_name([ users(:kevin), leaves(:welcome_page), :being_edited ])
+  end
+
+  test "update broadcasts being-edited indicator to current editors only" do
+    leaf = leaves(:welcome_page)
+
+    put leafable_path(leaf), params: { page: { body: "Kevin was here." } }
+    assert_response :no_content
+
+    streams = enqueued_being_edited_streams
+
+    # Everyone who can currently edit the handbook: kevin (editor), david and jason (administrators)
+    assert_includes streams, being_edited_stream(users(:kevin), leaf), "saving editor should get the broadcast"
+    assert_includes streams, being_edited_stream(users(:david), leaf)
+    assert_includes streams, being_edited_stream(users(:jason), leaf)
+
+    # jz is a reader: no presence payloads for him
+    assert_not_includes streams, being_edited_stream(users(:jz), leaf)
+
+    # Nothing may go out on the old shared stream that lingering subscribers could still be listening on
+    assert_not_includes streams, being_edited_stream(leaf)
+  end
+
+  test "update does not broadcast being-edited indicator to a removed collaborator" do
+    leaf = leaves(:welcome_page)
+    removed = users(:kevin)
+    removed_users_stream = being_edited_stream(removed, leaf)
+    legacy_shared_stream = being_edited_stream(leaf)
+
+    sign_out
+    sign_in :jason
+    books(:handbook).access_for(user: removed).destroy!
+
+    put leafable_path(leaf), params: { page: { body: "Jason was here." } }
+    assert_response :no_content
+
+    streams = enqueued_being_edited_streams
+    assert_not_includes streams, removed_users_stream, "removed collaborator's stream must get no payload"
+    assert_not_includes streams, legacy_shared_stream, "legacy shared stream must get no payload"
+
+    # Remaining editors still see who is editing
+    assert_includes streams, being_edited_stream(users(:jason), leaf)
+    assert_includes streams, being_edited_stream(users(:david), leaf)
+  end
+
   private
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
     end
+
+    def enqueued_being_edited_streams
+      enqueued_jobs.select { |job| job[:job] == Turbo::Streams::BroadcastJob }.map { |job| job[:args].first }
+    end
+
+    def being_edited_stream(*streamables)
+      Turbo::StreamsChannel.send(:stream_name_from, [ *streamables, :being_edited ])
+    end
 end
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
