@@ -0,0 +1,17 @@
+module RateLimiting
+  extend ActiveSupport::Concern
+
+  class_methods do
+    # Refuses requests over +to+ per +within+ from any one remote address with
+    # a bare 429 Too Many Requests -- no error page, no redirect. Other
+    # addresses are unaffected, and a refused address is served again once its
+    # burst falls out of the window.
+    def rate_limit(to:, within:, only: nil)
+      limiter = RateLimiter.new name, limit: to, within: within
+
+      before_action only: only do
+        head :too_many_requests if limiter.throttled?(request.remote_ip)
+      end
+    end
+  end
+end
diff --git a/app/models/rate_limiter.rb b/app/models/rate_limiter.rb
