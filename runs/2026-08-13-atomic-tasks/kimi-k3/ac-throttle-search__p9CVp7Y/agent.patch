index 0000000..713fb1e
--- /dev/null
+++ b/app/models/rate_limiter.rb
@@ -0,0 +1,52 @@
+# Fast, in-memory rate limiting with a sliding window. Keys (like IP
+# addresses) are tracked in plain process memory -- nothing touches the
+# database -- so limits are enforced per app process.
+#
+#   limiter = RateLimiter.new :search, limit: 30, within: 1.minute
+#
+#   limiter.throttled? "203.0.113.1" # => false, recording the hit
+#   # ... after 30 hits inside a minute ...
+#   limiter.throttled? "203.0.113.1" # => true
+#
+# Only served hits count against the limit, so a refused key is served again
+# as soon as its earlier hits age out of the window. Nothing to unblock, and
+# nothing persists past the window.
+class RateLimiter
+  # Forget keys that have gone quiet every this many calls, to bound memory.
+  SWEEP_AFTER_CALLS = 100
+
+  def initialize(name, limit:, within:)
+    @name, @limit, @within = name, limit, within.to_f
+    @hits = {}
+    @calls_since_sweep = 0
+    @mutex = Mutex.new
+  end
+
+  # Records a hit for +key+ and returns true when +key+ has already exhausted
+  # its allotment within the trailing window. Refused hits don't count.
+  def throttled?(key)
+    now = Time.now.to_f
+
+    @mutex.synchronize do
+      hits = @hits.fetch(key, []).select { |hit| hit > now - @within }
+
+      (hits.size >= @limit).tap do |throttled|
+        @hits[key] = throttled ? hits : hits.push(now)
+        sweep_stale_keys now
+      end
+    end
+  end
+
+  def clear
+    @mutex.synchronize { @hits.clear }
+  end
+
+  private
+    def sweep_stale_keys(now)
+      if (@calls_since_sweep += 1) >= SWEEP_AFTER_CALLS
+        @calls_since_sweep = 0
+        cutoff = now - @within
+        @hits.delete_if { |key, hits| hits.empty? || hits.last < cutoff }
+      end
+    end
+end
diff --git a/test/models/rate_limiter_test.rb b/test/models/rate_limiter_test.rb
new file mode 100644
index 0000000..2ce4cca
--- /dev/null
+++ b/test/models/rate_limiter_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class RateLimiterTest < ActiveSupport::TestCase
+  setup do
+    @limiter = RateLimiter.new :test, limit: 3, within: 1.minute
+  end
+
+  test "serves up to the limit within the window, then throttles" do
+    3.times do |i|
+      assert_not @limiter.throttled?("key"), "hit ##{i + 1} should be served"
+    end
+
+    assert @limiter.throttled?("key")
+    assert @limiter.throttled?("key")
+  end
+
+  test "tracks keys independently" do
+    3.times { @limiter.throttled? "key" }
+
+    assert @limiter.throttled?("key")
+    assert_not @limiter.throttled?("other key")
+  end
+
+  test "throttled hits do not count against the limit" do
+    travel_to Time.current
+
+    3.times { @limiter.throttled? "key" }
+
+    travel 30.seconds
+    10.times { assert @limiter.throttled?("key") }
+
+    travel 31.seconds
+    assert_not @limiter.throttled?("key")
+  end
+
+  test "hits age out of the window individually" do
+    travel_to Time.current
+
+    2.times { @limiter.throttled? "key" }
+
+    travel 30.seconds
+    @limiter.throttled? "key"
+    assert @limiter.throttled?("key")
+
+    travel 31.seconds
+    assert_not @limiter.throttled?("key"), "the two oldest hits should have aged out"
+  end
+
+  test "clear forgets everything" do
+    3.times { @limiter.throttled? "key" }
+    @limiter.clear
+
+    assert_not @limiter.throttled?("key")
+  end
+end
