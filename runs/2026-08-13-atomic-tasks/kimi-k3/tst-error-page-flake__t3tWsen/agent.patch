diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..2966845 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,33 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Runs the block with controller exceptions propagating to the caller
+    # instead of being turned into rendered error pages, then restores normal
+    # error page rendering -- no matter which tests ran before or run after in
+    # the same process.
+    #
+    # The exception-handling middleware reads "action_dispatch.show_exceptions"
+    # from each request's env, which is populated from
+    # Rails.application.env_config. That hash is memoized the first time it is
+    # accessed, so assigning Rails.application.config.action_dispatch.show_exceptions
+    # alone only has an effect until the process' first request -- and if that
+    # first request happens to occur inside this block, the :none value leaks
+    # into every later request in the process. Toggle the live env_config value
+    # (and the config attribute, so any future rebuild stays consistent) and
+    # restore both afterwards.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
+      env_config = Rails.application.env_config
+
+      previous_config_value = Rails.application.config.action_dispatch.show_exceptions
+      previous_env_value = env_config["action_dispatch.show_exceptions"]
+
       Rails.application.config.action_dispatch.show_exceptions = :none
+      env_config["action_dispatch.show_exceptions"] = :none
+
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      Rails.application.config.action_dispatch.show_exceptions = previous_config_value
+      env_config["action_dispatch.show_exceptions"] = previous_env_value
     end
   end
 end
