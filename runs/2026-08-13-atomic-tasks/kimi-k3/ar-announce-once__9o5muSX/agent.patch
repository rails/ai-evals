diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..5bddc66 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,30 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    # A sitting saves the book and its leaves together, and each save resets
+    # +saved_changes+ (pressing a page touches the book). So note whether the
+    # book went live as it happens, then announce once the sitting commits.
+    after_update :track_publication, if: :saved_change_to_published?
+    after_commit :announce_publication, if: :publication_tracked?
+    after_rollback :untrack_publication
   end
 
   private
+    def track_publication
+      @publication_tracked = published?
+    end
+
+    def publication_tracked?
+      @publication_tracked || false
+    end
+
+    def untrack_publication
+      @publication_tracked = false
+    end
+
     def announce_publication
       AnnouncePublicationJob.perform_later self
+    ensure
+      untrack_publication
     end
 end
