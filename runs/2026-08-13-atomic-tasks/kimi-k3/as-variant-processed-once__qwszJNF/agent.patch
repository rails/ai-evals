diff --git a/test/controllers/pictures_controller_test.rb b/test/controllers/pictures_controller_test.rb
index 1c439a4..43fd9d1 100644
--- a/test/controllers/pictures_controller_test.rb
+++ b/test/controllers/pictures_controller_test.rb
@@ -1,6 +1,8 @@
 require "test_helper"
 
 class PicturesControllerTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
   setup do
     sign_in :kevin
   end
@@ -38,4 +40,43 @@ class PicturesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "New caption", updated_picture.caption
     assert_equal "reading.webp", updated_picture.image.filename.to_s
   end
+
+  test "large variant is derived once" do
+    put leafable_path(leaves(:reading_picture)), params: {
+      picture: {
+        image: fixture_file_upload("white-rabbit.webp", "image/webp")
+      } }
+
+    assert_response :no_content
+
+    picture = Picture.last
+
+    perform_enqueued_jobs # CreateVariantsJob, which enqueues…
+    perform_enqueued_jobs # …TransformJob, which derives the large variant
+
+    variant_record = picture.image.blob.variant_records.sole
+
+    # A reader opening the book page and fetching the linked picture must not
+    # derive the variant again or store a second copy of it.
+    transforms = 0
+    subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { transforms += 1 }
+
+    get slugged_leafable_path(picture.leaf.book, picture.leaf.book.slug, picture.leaf, picture.leaf.slug)
+    assert_response :ok
+    assert_in_body "rails/active_storage/representations/redirect"
+
+    assert_no_difference -> { ActiveStorage::VariantRecord.count } do
+      get url_for(picture.large_image)
+      assert_response :redirect
+
+      get response.redirect_url
+      assert_response :ok
+    end
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber)
+
+    assert_equal 0, transforms
+    assert_equal "image/webp", response.media_type
+    assert_equal variant_record.image.download, response.body
+  end
 end
