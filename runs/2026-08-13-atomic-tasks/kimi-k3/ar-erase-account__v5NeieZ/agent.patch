diff --git a/test/models/user/erasable_test.rb b/test/models/user/erasable_test.rb
new file mode 100644
index 0000000..bc93fbb
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,111 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  test "erase removes the user and everything attached to them" do
+    user = users(:kevin)
+    user.sessions.start!(user_agent: "test", ip_address: "10.0.0.1")
+    ReadingMark.remember(leaves(:summary_page), user: user)
+
+    assert SignInEvent.for_address(user.email_address).exists?
+
+    user.erase
+
+    assert_not User.exists?(user.id)
+    assert_not Session.exists?(user: user)
+    assert_not Access.exists?(user: user)
+    assert_not ReadingMark.exists?(user: user)
+    assert_not SignInEvent.for_address(user.email_address).exists?
+  end
+
+  test "erase destroys books that are not shared with everyone, along with their search index entries" do
+    user = users(:kevin)
+    book = Book.create!(title: "Kevin's Private Book", everyone_access: false, creator: user)
+    book.press Page.new(body: "innermost zebra thoughts"), title: "Diary"
+
+    assert Leaf.search("zebra").exists?
+
+    user.erase
+
+    assert_not Book.exists?(book.id)
+    assert_not Leaf.search("zebra").exists?
+  end
+
+  test "erase keeps books shared with everyone, bylined to Deleted author" do
+    user = users(:kevin)
+    book = Book.create!(title: "Kevin's Shared Book", author: "Kevin", everyone_access: true, creator: user)
+    book.press Page.new(body: "shared unicorn content"), title: "Chapter One"
+
+    user.erase
+
+    book.reload
+    assert_equal "Deleted author", book.author
+    assert_nil book.creator
+    assert Leaf.search("unicorn").exists?
+  end
+
+  test "erase does not touch anyone else's data" do
+    user = users(:kevin)
+    other = users(:jz)
+    other.sessions.start!(user_agent: "test", ip_address: "10.0.0.2")
+    other_book = Book.create!(title: "JZ's Book", everyone_access: true, creator: other)
+
+    user.erase
+
+    assert User.exists?(other.id)
+    assert Book.exists?(other_book.id)
+    assert_equal other, other_book.reload.creator
+    assert SignInEvent.for_address(other.email_address).exists?
+  end
+
+  test "erase removes sign-in history filed under the address a deactivated user signed in with" do
+    user = users(:kevin)
+    user.sessions.start!(user_agent: "test", ip_address: "10.0.0.1")
+
+    # Removed the old way: sessions deleted, deactivated, email scrambled.
+    user.sessions.delete_all
+    user.update! active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com"
+
+    assert_difference -> { User.count }, -1 do
+      user.erase
+    end
+
+    assert_not SignInEvent.for_address("kevin@example.com").exists?
+    assert_not SignInEvent.for_address(user.email_address).exists?
+  end
+
+  test "erase does not remove unrelated sign-in history that shares a deactivated local part" do
+    user = users(:kevin)
+    user.update! active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com"
+    SignInEvent.create! action: :signed_in, email_address: "kevin@example.org"
+
+    user.erase
+
+    assert SignInEvent.for_address("kevin@example.org").exists?
+  end
+
+  test "erase keeps shared books even when the association was loaded beforehand" do
+    user = users(:kevin)
+    shared = Book.create!(title: "Shared", author: "Kevin", everyone_access: true, creator: user)
+    private_book = Book.create!(title: "Private", everyone_access: false, creator: user)
+
+    user.created_books.load
+
+    user.erase
+
+    assert Book.exists?(shared.id)
+    assert_equal "Deleted author", shared.reload.author
+    assert_not Book.exists?(private_book.id)
+  end
+
+  test "erase is all or nothing" do
+    user = users(:kevin)
+    user.sessions.start!(user_agent: "test", ip_address: "10.0.0.1")
+
+    def user.erase_sign_in_events = raise("database is gone")
+
+    assert_raises(RuntimeError) { user.erase }
+
+    assert User.exists?(user.id)
+    assert SignInEvent.for_address(user.email_address).exists?
+  end
+end
