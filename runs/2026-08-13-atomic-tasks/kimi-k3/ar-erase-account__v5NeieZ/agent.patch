--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,43 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  # Byline for books shared with everyone once the person who created them
+  # has been erased.
+  DELETED_AUTHOR_NAME = "Deleted author"
+
+  # People "removed" before erasure was possible had their email address
+  # rewritten to "alice-deactivated-<uuid>@example.com". Their sign-in
+  # history is still filed under the address they actually signed in with.
+  DEACTIVATED_EMAIL_PATTERN = /-deactivated-\h{8}-\h{4}-\h{4}-\h{4}-\h{12}(?=@)/
+
+  # Erases every trace of the person: their user record, sessions, accesses,
+  # reading marks, and sign-in history, along with the books they created.
+  # Books they created that are shared with everyone keep working for their
+  # readers, bylined "Deleted author" with no creator attached.
+  def erase
+    transaction do
+      anonymize_books_shared_with_everyone
+      sessions.delete_all
+      destroy!
+      erase_sign_in_events
+    end
+  end
+
+  private
+    def anonymize_books_shared_with_everyone
+      created_books.with_everyone_access.update_all creator_id: nil, author: DELETED_AUTHOR_NAME
+      created_books.reset
+    end
+
+    def erase_sign_in_events
+      SignInEvent.where(email_address: sign_in_email_addresses).delete_all
+    end
+
+    def sign_in_email_addresses
+      [ email_address, original_email_address ].compact.uniq
+    end
+
+    def original_email_address
+      email_address&.sub(DEACTIVATED_EMAIL_PATTERN, "")
+    end
+end
