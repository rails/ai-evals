diff --git a/app/models/book/announceable.rb b/app/models/book/announceable.rb
index 442f5bc..c55aeeb 100644
--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,34 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :note_pending_announcement, if: :became_published?
+    after_update_commit :announce_pending_publication
+    after_rollback :forget_pending_announcement, on: :update
   end
 
   private
-    def announce_publication
-      AnnouncePublicationJob.perform_later self
+    # Whether the book just went live must be captured at save time: another
+    # save in the same sitting (like the touch from a newly pressed page)
+    # would clobber +saved_changes+ before the commit callback evaluates it.
+    def became_published?
+      published? && saved_change_to_published?
+    end
+
+    def note_pending_announcement
+      @publication_announcement_pending = true
+    end
+
+    def forget_pending_announcement
+      @publication_announcement_pending = false
+    end
+
+    def announce_pending_publication
+      # May run several times per sitting (once per save/touch of the book),
+      # so announce only for the save that took the book live, and only once.
+      if @publication_announcement_pending && published?
+        AnnouncePublicationJob.perform_later self
+      end
+
+      forget_pending_announcement
     end
 end
diff --git a/test/controllers/books/publications_controller_test.rb b/test/controllers/books/publications_controller_test.rb
index 8761ea8..d9901f1 100644
--- a/test/controllers/books/publications_controller_test.rb
+++ b/test/controllers/books/publications_controller_test.rb
@@ -30,3 +30,46 @@ class Books::PublicationsTest < ActionDispatch::IntegrationTest
     assert_equal "new-slug", @book.slug
   end
 end
+
+class Books::PublicationsAnnouncementTest < ActionDispatch::IntegrationTest
+  setup do
+    @book = books(:manual)
+
+    sign_in :david
+  end
+
+  test "publishing a book announces it exactly once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "1" } }
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "publishing a book and adding pages in the same sitting announces it exactly once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "1" }, added_pages: [ "A brand new page" ] }
+    end
+
+    assert @book.reload.published?
+    assert_equal "A brand new page", @book.leaves.last.title
+  end
+
+  test "saving an already-live book again does not announce it again" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "1" } }
+    end
+  end
+
+  test "taking a live book down does not announce anything" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      patch book_publication_path(@book), params: { book: { published: "0" } }
+    end
+
+    assert_not @book.reload.published?
+  end
+end
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..f68178b
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+  setup do
+    @book = books(:manual)
+  end
+
+  test "announce when a book goes live" do
+    assert_enqueued_with job: AnnouncePublicationJob do
+      @book.update! published: true
+    end
+  end
+
+  test "announce exactly once when a sitting takes a book live and presses pages" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), title: "A brand new page"
+      end
+    end
+
+    assert @book.reload.published?
+  end
+
+  test "do not announce again when an already-live book is saved" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! title: "A new title"
+        @book.press Page.new(body: ""), title: "Another page"
+      end
+    end
+  end
+
+  test "do not announce when a live book is taken down" do
+    @book.update! published: true
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "do not announce when a save does not take a book live" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! title: "A new title"
+    end
+  end
+
+  test "do not announce when the sitting fails after the book was marked live" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      Book.transaction do
+        @book.update! published: true
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not @book.reload.published?
+  end
+end
