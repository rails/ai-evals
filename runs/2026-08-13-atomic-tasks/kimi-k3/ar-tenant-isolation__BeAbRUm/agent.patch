diff --git a/app/models/concerns/tenanted.rb b/app/models/concerns/tenanted.rb
new file mode 100644
index 0000000..b3e3a65
--- /dev/null
+++ b/app/models/concerns/tenanted.rb
@@ -0,0 +1,15 @@
+# Multi-tenant scoping. Records can optionally belong to a tenant; a signed-in
+# user only ever sees records from their own tenant.
+#
+# Records without a tenant (legacy rows, fixtures) are shared: they remain
+# visible to everyone, exactly as before tenants existed. Users without a
+# tenant are shared too: they keep seeing the whole install.
+module Tenanted
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+
+    scope :in_tenant, ->(tenant) { tenant.present? ? where(tenant_id: [ tenant.id, nil ]) : all }
+  end
+end
