diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..4636864 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,22 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Makes controller errors reach the test as raised exceptions inside the
+    # block, while error pages render like normal outside of it.
+    #
+    # `Rails.application.env_config` is memoized and merged into every
+    # request's env, so this mutates that hash directly. Changing
+    # `config.action_dispatch.show_exceptions` instead would either be a
+    # no-op (if env_config was already memoized by an earlier test) or leak
+    # for the rest of the process (if this is the first request), which is
+    # order-dependent and flaky under parallel test runs.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      env_config = Rails.application.env_config
+      previous = env_config["action_dispatch.show_exceptions"]
+      env_config["action_dispatch.show_exceptions"] = :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env_config["action_dispatch.show_exceptions"] = previous
     end
   end
 end
