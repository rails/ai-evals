@@ -0,0 +1,22 @@
+require "test_helper"
+
+class JobCheckpointTest < ActiveSupport::TestCase
+  test "[] finds or creates a checkpoint by name" do
+    checkpoint = JobCheckpoint["some_job"]
+
+    assert_equal 0, checkpoint.last_processed_id
+    assert_equal checkpoint.id, JobCheckpoint["some_job"].id
+  end
+
+  test "advance_to! stores the last processed id" do
+    JobCheckpoint["some_job"].advance_to! 42
+
+    assert_equal 42, JobCheckpoint["some_job"].last_processed_id
+  end
+
+  test "checkpoints are independent per job" do
+    JobCheckpoint["job_a"].advance_to! 1
+
+    assert_equal 0, JobCheckpoint["job_b"].last_processed_id
+  end
+end
