+require "test_helper"
+
+class Book::ReportableTest < ActiveSupport::TestCase
+  test "report summary includes a delimited character count" do
+    book = books(:handbook)
+
+    assert_equal "#{book.title} — #{book.markable.length.to_fs(:delimited)} characters", book.report_summary
+  end
+
+  test "report summary delimits thousands" do
+    book = books(:handbook)
+    book.define_singleton_method(:markable) { "a" * 12_345 }
+
+    assert_includes book.report_summary, "12,345 characters"
+  end
+end
