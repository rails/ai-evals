diff --git a/test/models/user/erasable_test.rb b/test/models/user/erasable_test.rb
new file mode 100644
index 0000000..211ae76
--- /dev/null
+++ b/test/models/user/erasable_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class User::ErasableTest < ActiveSupport::TestCase
+  test "erase removes the user and every trace of their data" do
+    user = users(:kevin)
+    user.sessions.start!(user_agent: "test", ip_address: "1.2.3.4")
+
+    book = Book.create!(title: "Kevin's private notes", everyone_access: false, creator: user)
+    leaf = book.press Page.new(body: "kevinsecretdiary v1"), title: "Diary"
+    leaf.edit leafable_params: { body: "kevinsecretdiary v2" }
+    trashed_leaf = book.press Page.new(body: "kevinsecretdiary trashed"), title: "Old"
+    trashed_leaf.trashed!
+    ReadingMark.remember(leaf, user: user)
+
+    assert Leaf.search("kevinsecretdiary").exists?
+
+    user.erase
+
+    assert_not User.exists?(user.id)
+    assert_not Session.where(user_id: user.id).exists?
+    assert_not Access.where(user_id: user.id).exists?
+    assert_not ReadingMark.where(user_id: user.id).exists?
+    assert_not SignInEvent.for_address("kevin@example.com").exists?
+
+    assert_not Book.exists?(book.id)
+    assert_not Leaf.where(book: book).exists?
+    assert_not Page.joins(:markdown_body).where("action_text_markdowns.content LIKE ?", "%kevinsecretdiary%").exists?
+    assert_not Leaf.search("kevinsecretdiary").exists?
+    assert_no_stale_search_index_rows
+  end
+
+  test "erase does not record signed_out events for the erased sessions" do
+    user = users(:kevin)
+    user.sessions.start!(user_agent: "test", ip_address: "1.2.3.4")
+
+    user.erase
+
+    assert_empty SignInEvent.where("email_address LIKE ?", "%kevin%")
+  end
+
+  test "erase keeps books shared with everyone, anonymized and bylined Deleted author" do
+    user = users(:kevin)
+    book = Book.create!(title: "Kevin's cookbook", everyone_access: true, creator: user, author: "Kevin")
+    leaf = book.press Page.new(body: "pancake recipe for all"), title: "Pancakes"
+    book.update_access(editors: [ user.id ], readers: [])
+
+    user.erase
+
+    assert book.reload.persisted?
+    assert_nil book.creator_id
+    assert_equal "Deleted author", book.author
+    assert book.everyone_access?
+    assert Leaf.exists?(leaf.id)
+    assert_includes Leaf.search("pancake"), leaf
+    assert book.accessable?(user: users(:david))
+  end
+
+  test "erase destroys books that are not shared with everyone" do
+    user = users(:kevin)
+    book = Book.create!(title: "Kevin's limited book", everyone_access: false, creator: user)
+    book.update_access(editors: [ user.id ], readers: [ users(:david).id ])
+
+    user.erase
+
+    assert_not Book.exists?(book.id)
+  end
+
+  test "erase works for users deactivated the old way and clears events under their real address" do
+    user = users(:kevin)
+    user.sessions.start!(user_agent: "test", ip_address: "1.2.3.4") # recorded under kevin@example.com
+
+    user.update! active: false, email_address: "kevin-deactivated-#{SecureRandom.uuid}@example.com"
+    scrambled_address = user.email_address
+
+    user.erase
+
+    assert_not User.exists?(user.id)
+    assert_not SignInEvent.for_address("kevin@example.com").exists?
+    assert_not SignInEvent.for_address(scrambled_address).exists?
+  end
+
+  test "erase does not touch other users or their books" do
+    users(:kevin).erase
+
+    assert users(:david).reload.persisted?
+    assert books(:handbook).reload.persisted?
+    assert books(:handbook).accessable?(user: users(:david))
+  end
+
+  private
+    def assert_no_stale_search_index_rows
+      stale = ActiveRecord::Base.connection.execute(
+        "SELECT rowid FROM leaf_search_index WHERE rowid NOT IN (SELECT id FROM leaves)").to_a
+      assert_empty stale
+    end
+end
