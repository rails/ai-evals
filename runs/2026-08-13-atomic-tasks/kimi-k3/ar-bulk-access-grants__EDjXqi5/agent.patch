diff --git a/app/models/book/access_import.rb b/app/models/book/access_import.rb
index 4d920cf..58e6ead 100644
--- a/app/models/book/access_import.rb
+++ b/app/models/book/access_import.rb
@@ -6,20 +6,59 @@ class Book::AccessImport
   end
 
   def import
-    accesses = []
-    duplicate_index = nil
+    loop do
+      if bad_row_index = find_bad_row_index
+        return Result.new([], bad_row_index)
+      end
 
-    Access.transaction do
-      @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
+      begin
+        Access.transaction { Access.insert_all!(access_rows) }
+        break
       rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
-        raise ActiveRecord::Rollback
+        # Access was granted to someone on the sheet between our check and our
+        # insert. Check again to find and report the duplicate row.
       end
     end
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
+    accesses = imported_accesses
+    ActiveJob.perform_all_later(accesses.collect { |access| Book::AccessNotificationJob.new(access) })
+
+    Result.new(accesses, nil)
   end
+
+  private
+    def find_bad_row_index
+      taken_user_ids = @book.accesses.where(user_id: user_ids).pluck(:user_id).to_set
+      seen_user_ids = Set.new
+
+      @grants.each_with_index do |grant, index|
+        user_id = user_id_for(grant)
+
+        return index unless Access.levels.key?(grant[:level].to_s)
+        return index if taken_user_ids.include?(user_id) || seen_user_ids.include?(user_id)
+
+        seen_user_ids << user_id
+      end
+
+      nil
+    end
+
+    def access_rows
+      @grants.collect do |grant|
+        { book_id: @book.id, user_id: user_id_for(grant), level: grant[:level].to_s }
+      end
+    end
+
+    def imported_accesses
+      accesses_by_user_id = @book.accesses.where(user_id: user_ids).index_by(&:user_id)
+      @grants.collect { |grant| accesses_by_user_id.fetch(user_id_for(grant)) }
+    end
+
+    def user_ids
+      @grants.collect { |grant| user_id_for(grant) }
+    end
+
+    def user_id_for(grant)
+      Access.type_for_attribute("user_id").cast(grant[:user_id])
+    end
 end
diff --git a/test/models/book/access_import_edge_test.rb b/test/models/book/access_import_edge_test.rb
new file mode 100644
index 0000000..00054c0
--- /dev/null
+++ b/test/models/book/access_import_edge_test.rb
@@ -0,0 +1,151 @@
+require "test_helper"
+
+class Book::AccessImportEdgeTest < ActiveSupport::TestCase
+  setup do
+    @book = Book.create!(title: "Edge Book", everyone_access: false)
+    ActiveJob::Base.queue_adapter = :test
+    ActiveJob::Base.queue_adapter.enqueued_jobs.clear
+  end
+
+  def make_users(n)
+    (1..n).map { |i| User.create!(name: "Edge U#{i} #{SecureRandom.hex(4)}", email_address: "edge-u#{i}-#{SecureRandom.hex(4)}@example.com", password: "secret123456") }
+  end
+
+  def count_queries(&block)
+    queries = []
+    counter = ->(name, started, finished, id, payload) do
+      unless payload[:name].to_s =~ /SCHEMA|TRANSACTION/ || payload[:sql].to_s =~ /\A\s*(PRAGMA|BEGIN|COMMIT|ROLLBACK)/i
+        queries << payload[:sql]
+      end
+    end
+    ActiveSupport::Notifications.subscribed(counter, "sql.active_record", &block)
+    queries
+  end
+
+  test "large roster of 300: constant queries, all imported, all notified" do
+    users = make_users(300)
+    grants = users.each_with_index.map { |u, i| { user_id: u.id, level: i.even? ? "editor" : "reader" } }
+
+    queries = count_queries { @result = Book::AccessImport.new(@book, grants).import }
+
+    assert_operator queries.size, :<=, 5, "expected a handful of queries, got #{queries.size}"
+    assert_equal 300, @book.accesses.count
+    assert_equal 300, @result.accesses.size
+    assert_equal users.map(&:id), @result.accesses.map(&:user_id)
+    assert_equal 300, ActiveJob::Base.queue_adapter.enqueued_jobs.size
+    assert_equal "editor", @book.accesses.find_by(user: users[0]).level
+    assert_equal "reader", @book.accesses.find_by(user: users[1]).level
+  end
+
+  test "string user ids and symbol levels work like create! did" do
+    users = make_users(3)
+    grants = [
+      { user_id: users[0].id.to_s, level: :editor },
+      { user_id: users[1].id.to_s, level: :reader },
+      { user_id: users[2].id,      level: "reader" }
+    ]
+
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_equal 3, result.accesses.size
+    assert_equal "editor", @book.accesses.find_by(user: users[0]).level
+    assert_nil result.duplicate_index
+  end
+
+  test "string id duplicate of an existing access is still caught" do
+    users = make_users(2)
+    Access.create!(book: @book, user: users[0], level: :reader)
+
+    result = Book::AccessImport.new(@book, [ { user_id: users[1].id, level: "reader" }, { user_id: users[0].id.to_s, level: "editor" } ]).import
+
+    assert_equal [], result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_equal 1, @book.accesses.count
+    assert_equal 0, ActiveJob::Base.queue_adapter.enqueued_jobs.size
+  end
+
+  test "empty sheet succeeds with nothing" do
+    result = Book::AccessImport.new(@book, []).import
+    assert_equal [], result.accesses
+    assert_nil result.duplicate_index
+    assert_equal 0, @book.accesses.count
+    assert_equal 0, ActiveJob::Base.queue_adapter.enqueued_jobs.size
+  end
+
+  test "first bad row wins: duplicate earlier than an unknown level" do
+    users = make_users(3)
+    Access.create!(book: @book, user: users[0], level: :reader)
+    grants = [
+      { user_id: users[0].id, level: "reader" },    # duplicate at 0
+      { user_id: users[1].id, level: "superuser" }  # bad level at 1
+    ]
+
+    result = Book::AccessImport.new(@book, grants).import
+    assert_equal [], result.accesses
+    assert_equal 0, result.duplicate_index
+    assert_equal 1, @book.accesses.count
+  end
+
+  test "first bad row wins: unknown level earlier than a duplicate" do
+    users = make_users(3)
+    Access.create!(book: @book, user: users[1], level: :reader)
+    grants = [
+      { user_id: users[0].id, level: "superuser" }, # bad level at 0
+      { user_id: users[1].id, level: "reader" }     # duplicate at 1
+    ]
+
+    result = Book::AccessImport.new(@book, grants).import
+    assert_equal [], result.accesses
+    assert_equal 0, result.duplicate_index
+    assert_equal 1, @book.accesses.count
+  end
+
+  test "nil level is a bad row, not an exception" do
+    users = make_users(2)
+    result = Book::AccessImport.new(@book, [ { user_id: users[0].id, level: nil } ]).import
+    assert_equal [], result.accesses
+    assert_equal 0, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "rejected at first row, large sheet: nothing written, constant queries" do
+    users = make_users(200)
+    Access.create!(book: @book, user: users[0], level: :reader)
+    grants = users.map { |u| { user_id: u.id, level: "reader" } }
+
+    queries = count_queries { @result = Book::AccessImport.new(@book, grants).import }
+
+    assert_operator queries.size, :<=, 2
+    assert_equal [], @result.accesses
+    assert_equal 0, @result.duplicate_index
+    assert_equal 1, @book.accesses.count
+    assert_equal 0, ActiveJob::Base.queue_adapter.enqueued_jobs.size
+  end
+end
+
+class Book::AccessImportRaceTest < ActiveSupport::TestCase
+  test "a duplicate surfacing only at insert time is reported, not raised" do
+    ActiveJob::Base.queue_adapter = :test
+    book = Book.create!(title: "Race Book", everyone_access: false)
+    users = (1..3).map { |i| User.create!(name: "R#{i} #{SecureRandom.hex(3)}", email_address: "r#{i}-#{SecureRandom.hex(3)}@example.com", password: "secret123456") }
+    grants = users.map { |u| { user_id: u.id, level: "reader" } }
+
+    # Simulates a grant committed after the imports check but before its insert.
+    Access.create!(book: book, user: users[1], level: :reader)
+
+    importer = Book::AccessImport.new(book, grants)
+    checks = 0
+    importer.define_singleton_method(:find_bad_row_index) do
+      checks += 1
+      checks == 1 ? nil : super()
+    end
+
+    result = importer.import
+
+    assert_equal [], result.accesses
+    assert_equal 1, result.duplicate_index
+    assert_equal 1, book.accesses.count
+    assert_equal 2, checks
+    assert_equal 0, ActiveJob::Base.queue_adapter.enqueued_jobs.size
+  end
+end
