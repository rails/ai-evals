@@ -1,6 +1,22 @@
 class Books::SearchesController < ApplicationController
   allow_unauthenticated_access
 
+  # Backing store for the search rate limit. File-backed in production and
+  # development so the limit is shared across processes without needing the
+  # database; in-memory in test so each test process starts fresh.
+  RATE_LIMIT_STORE =
+    if Rails.env.test?
+      ActiveSupport::Cache::MemoryStore.new
+    else
+      ActiveSupport::Cache::FileStore.new(Rails.root.join("tmp/rate_limits"))
+    end
+
+  # Refuse addresses that search more than 30 times in a minute with
+  # 429 Too Many Requests. The limit is per address and lifts on its own
+  # once the minute window expires.
+  rate_limit to: 30, within: 1.minute, only: :create,
+    store: RATE_LIMIT_STORE, with: -> { head :too_many_requests }
+
   include BookScoped
 
   def create
diff --git a/config/initializers/rate_limit_store_reset.rb b/config/initializers/rate_limit_store_reset.rb
new file mode 100644
index 0000000..4d47727
--- /dev/null
+++ b/config/initializers/rate_limit_store_reset.rb
@@ -0,0 +1,7 @@
+# Reset rate limit counters between tests so that limits exercised in one
+# test never leak into another.
+if Rails.env.test?
+  ActiveSupport.on_load(:action_dispatch_integration_test) do
+    setup { Books::SearchesController::RATE_LIMIT_STORE.clear }
+  end
+end
