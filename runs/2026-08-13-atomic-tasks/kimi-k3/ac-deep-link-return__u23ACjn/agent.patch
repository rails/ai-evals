diff --git a/test/controllers/open_redirect_edge_test.rb b/test/controllers/open_redirect_edge_test.rb
new file mode 100644
index 0000000..5c22772
--- /dev/null
+++ b/test/controllers/open_redirect_edge_test.rb
@@ -0,0 +1,70 @@
+require "test_helper"
+
+class OpenRedirectEdgeTest < ActionDispatch::IntegrationTest
+  def attempt(return_to)
+    post session_url, params: {
+      email_address: "david@example.com",
+      password: "secret123456",
+      return_to: return_to
+    }
+    response.location
+  end
+
+  test "subdomain spoof is rejected" do
+    assert_equal root_url, attempt("https://www.example.com.evil.net/phish")
+  end
+
+  test "userinfo spoof is rejected" do
+    assert_equal root_url, attempt("https://www.example.com@evil.net/phish")
+  end
+
+  test "fragment spoof is rejected" do
+    assert_equal root_url, attempt("https://evil.net#www.example.com")
+  end
+
+  test "encoded protocol-relative is rejected" do
+    assert_equal root_url, attempt("%2f%2fevil.net/phish")
+  end
+
+  test "uppercase same-host url falls back safely (fail-closed)" do
+    assert_equal root_url, attempt("HTTP://WWW.EXAMPLE.COM/account/edit")
+  end
+
+  test "blank return_to falls back to root" do
+    assert_equal root_url, attempt("")
+  end
+
+  test "whitespace-padded evil url falls back safely" do
+    assert_equal root_url, attempt("  https://evil.net/phish  ")
+  end
+
+  test "tab/newline injected url falls back safely" do
+    location = attempt("https://evil.net/phish\n.evil")
+    assert_no_match(/[\r\n]/, location)
+    assert_not_equal "evil.net", URI.parse(location).host
+  end
+
+  test "triple-slash url falls back safely" do
+    assert_equal root_url, attempt("///evil.net/phish")
+  end
+
+  test "same-host deep link with query string is preserved" do
+    assert_equal "http://www.example.com/account/edit?tab=profile", attempt("/account/edit?tab=profile")
+  end
+
+  test "same-host absolute https url is preserved" do
+    assert_equal "https://www.example.com/1/handbook", attempt("https://www.example.com/1/handbook")
+  end
+end
+
+class OpenRedirectEdgeTest
+  test "non-string return_to does not crash and falls back safely" do
+    post session_url, params: {
+      email_address: "david@example.com",
+      password: "secret123456",
+      return_to: [ "https://evil.net" ]
+    }
+    assert_response :redirect
+    assert_equal root_url, response.location
+  end
+end
diff --git a/test/controllers/open_redirect_repro_test.rb b/test/controllers/open_redirect_repro_test.rb
new file mode 100644
index 0000000..a374076
--- /dev/null
+++ b/test/controllers/open_redirect_repro_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class OpenRedirectReproTest < ActionDispatch::IntegrationTest
+  test "REPRO: return_to pointing at another host must not be honored" do
+    post session_url, params: {
+      email_address: "david@example.com",
+      password: "secret123456",
+      return_to: "https://evil.example.net/phishing"
+    }
+
+    assert_response :redirect
+    location = response.location
+    assert_not_equal "evil.example.net", URI.parse(location).host,
+      "VULNERABLE: reader was redirected to an attacker's host"
+  end
+
+  test "protocol-relative return_to must not be honored" do
+    post session_url, params: {
+      email_address: "david@example.com",
+      password: "secret123456",
+      return_to: "//evil.example.net/phishing"
+    }
+
+    assert_response :redirect
+    assert_not_equal "evil.example.net", URI.parse(response.location).host
+  end
+
+  test "deep link: same-host absolute return_to keeps working" do
+    target = slugged_book_url(id: books(:handbook).id, slug: books(:handbook).slug)
+    post session_url, params: {
+      email_address: "david@example.com",
+      password: "secret123456",
+      return_to: target
+    }
+
+    assert_redirected_to target
+  end
+
+  test "deep link: relative path return_to keeps working" do
+    post session_url, params: {
+      email_address: "david@example.com",
+      password: "secret123456",
+      return_to: "/account/edit"
+    }
+
+    assert_redirected_to "/account/edit"
+  end
+
+  test "no return_to falls back to root" do
+    post session_url, params: { email_address: "david@example.com", password: "secret123456" }
+    assert_redirected_to root_url
+  end
+
+  test "garbage return_to falls back safely" do
+    [ "javascript:alert(1)", "http://", "\\\\evil.example.net", "not a url at all %", "data:text/html,<script>alert(1)</script>" ].each do |junk|
+      post session_url, params: {
+        email_address: "david@example.com",
+        password: "secret123456",
+        return_to: junk
+      }
+
+      assert_response :redirect
+      host = begin
+        URI.parse(response.location).host
+      rescue URI::InvalidURIError
+        nil
+      end
+      assert [ nil, "www.example.com" ].include?(host), "unsafe redirect to #{response.location.inspect} for input #{junk.inspect}"
+    end
+  end
+end
