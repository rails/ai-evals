diff --git a/app/models/book/access_import.rb b/app/models/book/access_import.rb
index 4d920cf..070ccca 100644
--- a/app/models/book/access_import.rb
+++ b/app/models/book/access_import.rb
@@ -6,20 +6,49 @@ class Book::AccessImport
   end
 
   def import
-    accesses = []
-    duplicate_index = nil
-
-    Access.transaction do
-      @grants.each_with_index do |grant, index|
-        access = @book.accesses.create!(user_id: grant[:user_id], level: grant[:level])
-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
-      rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
-        raise ActiveRecord::Rollback
-      end
-    end
+    return Result.new([], nil) if @grants.empty?
 
-    duplicate_index ? Result.new([], duplicate_index) : Result.new(accesses, nil)
+    if (index = rejected_index)
+      Result.new([], index)
+    else
+      accesses = insert_and_reload_accesses
+      accesses.each { |access| Book::AccessNotificationJob.perform_later(access) }
+      Result.new(accesses, nil)
+    end
   end
+
+  private
+    # Index of the first bad row -- a level nobody has heard of, a name listed
+    # twice on the sheet, or a name already on the book -- or nil when the
+    # sheet is clean. Only the check against the book touches the database,
+    # and it is a single read no matter how long the roster is.
+    def rejected_index
+      in_sheet_rejected_index || against_book_rejected_index
+    end
+
+    def in_sheet_rejected_index
+      seen = Set.new
+      @grants.index { |grant| unknown_level?(grant) || !seen.add?(grant[:user_id]) }
+    end
+
+    def unknown_level?(grant)
+      !Access.levels.key?(grant[:level].to_s)
+    end
+
+    def against_book_rejected_index
+      taken_user_ids = @book.accesses.where(user_id: user_ids).pluck(:user_id).to_set
+      @grants.index { |grant| taken_user_ids.include?(grant[:user_id]) }
+    end
+
+    # One insert for the whole sheet, then one read to hand back the records.
+    # Notifications only go out once every row is in, so a turned-down sheet
+    # never tells anyone about access they never got.
+    def insert_and_reload_accesses
+      @book.accesses.insert_all(@grants.map { |grant| { user_id: grant[:user_id], level: grant[:level] } })
+      @book.accesses.where(user_id: user_ids).index_by(&:user_id).values_at(*user_ids)
+    end
+
+    def user_ids
+      @grants.map { |grant| grant[:user_id] }
+    end
 end
diff --git a/test/models/book/access_import_test.rb b/test/models/book/access_import_test.rb
new file mode 100644
index 0000000..e451d47
--- /dev/null
+++ b/test/models/book/access_import_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class Book::AccessImportTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "Imported book", everyone_access: false)
+    @extra_users = 16.times.map do |i|
+      User.create!(name: "Extra #{i}", email_address: "extra#{i}@example.com", password: "secret123456")
+    end
+  end
+
+  def grants_for(count, level: :reader)
+    @extra_users.first(count).map { |user| { user_id: user.id, level: level } }
+  end
+
+  def count_queries
+    count = 0
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*, payload|
+      count += 1 unless payload[:name].in?(%w[ SCHEMA TRANSACTION ])
+    end
+    yield
+    count
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber)
+  end
+
+  test "successful import grants access and notifies each user" do
+    result = nil
+    assert_enqueued_jobs(4, only: Book::AccessNotificationJob) do
+      result = Book::AccessImport.new(@book, grants_for(4, level: :editor)).import
+    end
+
+    assert_nil result.duplicate_index
+    assert_equal 4, result.accesses.size
+    assert result.accesses.all?(&:persisted?)
+    assert result.accesses.all?(&:editor?)
+    assert_equal @extra_users.first(4).map(&:id), result.accesses.map(&:user_id)
+  end
+
+  test "query count does not scale with roster size when the sheet is taken" do
+    small = count_queries { Book::AccessImport.new(@book, grants_for(4)).import }
+
+    big_book = Book.create!(title: "Another book", everyone_access: false)
+    large = count_queries { Book::AccessImport.new(big_book, grants_for(16)).import }
+
+    assert_equal small, large
+  end
+
+  test "query count does not scale with roster size when the sheet is turned down" do
+    small_book = Book.create!(title: "Small", everyone_access: false)
+    small_book.accesses.create!(user: @extra_users[3], level: :reader)
+    small = count_queries do
+      Book::AccessImport.new(small_book, grants_for(3) + [ { user_id: @extra_users[3].id, level: :reader } ]).import
+    end
+
+    big_book = Book.create!(title: "Big", everyone_access: false)
+    big_book.accesses.create!(user: @extra_users[15], level: :reader)
+    large = count_queries do
+      Book::AccessImport.new(big_book, grants_for(15) + [ { user_id: @extra_users[15].id, level: :reader } ]).import
+    end
+
+    assert_equal small, large
+  end
+
+  test "a turned-down sheet notifies no one and grants nothing" do
+    @book.accesses.create!(user: @extra_users[3], level: :reader)
+
+    result = nil
+    assert_no_enqueued_jobs(only: Book::AccessNotificationJob) do
+      result = Book::AccessImport.new(@book, grants_for(4)).import
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 3, result.duplicate_index
+    assert_equal 1, @book.accesses.count
+  end
+
+  test "a sheet duplicated within itself is turned down" do
+    grants = grants_for(2) + grants_for(1)
+    result = Book::AccessImport.new(@book, grants).import
+
+    assert_equal [], result.accesses
+    assert_equal 2, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+
+  test "an unknown level turns down the sheet instead of blowing up" do
+    grants = grants_for(2) + [ { user_id: @extra_users[2].id, level: :overlord } ]
+
+    result = nil
+    assert_no_enqueued_jobs(only: Book::AccessNotificationJob) do
+      assert_nothing_raised { result = Book::AccessImport.new(@book, grants).import }
+    end
+
+    assert_equal [], result.accesses
+    assert_equal 2, result.duplicate_index
+    assert_equal 0, @book.accesses.count
+  end
+end
