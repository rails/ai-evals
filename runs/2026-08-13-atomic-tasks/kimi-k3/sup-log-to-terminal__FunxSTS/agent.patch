diff --git a/config/application.rb b/config/application.rb
index d5e4fd0..4bda8ad 100644
--- a/config/application.rb
+++ b/config/application.rb
@@ -29,5 +29,20 @@ module Writebook
 
     # Opt in to 8.0 timezone behavior
     config.active_support.to_time_preserves_timezone = :zone
+
+    # `bin/rails runner` (how the import runbook runs script/library_report.rb)
+    # only writes to the environment's log file, unlike `rails server` which
+    # also echoes to the terminal. Mirror the log lines to the terminal as
+    # well, keeping the log file as the canonical record. Debug chatter (SQL
+    # queries, etc.) stays in the log file only.
+    runner do
+      unless ActiveSupport::Logger.logger_outputs_to?(Rails.logger, STDERR, STDOUT)
+        console = ActiveSupport::Logger.new($stdout)
+        console.formatter = Rails.logger.formatter
+        console.level = [ Rails.logger.level, ActiveSupport::Logger::INFO ].max
+
+        Rails.logger.broadcast_to(console)
+      end
+    end
   end
 end
