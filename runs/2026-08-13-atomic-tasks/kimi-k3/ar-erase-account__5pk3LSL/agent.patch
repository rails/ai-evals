diff --git a/test/models/book_destroy_probe_test.rb b/test/models/book_destroy_probe_test.rb
new file mode 100644
index 0000000..b4a9a40
--- /dev/null
+++ b/test/models/book_destroy_probe_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class BookDestroyProbeTest < ActiveSupport::TestCase
+  test "destroying a book with a trashed leaf (trash edit aliases current leafable)" do
+    book = Book.create!(title: "Probe book", creator: users(:kevin), everyone_access: false)
+    leaf = book.press(Page.new(body: "original probe content"), title: "Probe page")
+    leaf.edit leafable_params: { body: "revised probe content" }
+    leaf.trashed!
+
+    assert_nothing_raised do
+      book.destroy!
+    end
+
+    assert_equal 0, Leaf.where(book_id: book.id).count
+    assert_equal 0, Edit.where(leaf_id: leaf.id).count
+    assert_equal 0, Page.where("body IS NULL AND id IN (SELECT record_id FROM action_text_markdowns WHERE content LIKE '%probe content%')").count rescue nil
+    assert_equal 0, ActionText::Markdown.where("content LIKE '%probe content%'").count
+  end
+
+  test "destroying a leaf directly with edits and trashed state" do
+    book = Book.create!(title: "Probe book 2", creator: users(:kevin), everyone_access: false)
+    leaf = book.press(Page.new(body: "leaf destroy probe"), title: "Probe page")
+    leaf.edit leafable_params: { body: "leaf destroy probe revised" }
+    leaf.trashed!
+
+    assert_nothing_raised { leaf.reload.destroy! }
+    assert_equal 0, ActionText::Markdown.where("content LIKE '%leaf destroy probe%'").count
+  end
+end
diff --git a/test/models/user_erase_repro_test.rb b/test/models/user_erase_repro_test.rb
new file mode 100644
index 0000000..0a40b7b
--- /dev/null
+++ b/test/models/user_erase_repro_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class UserEraseReproTest < ActionDispatch::IntegrationTest
+  setup do
+    Leaf.reindex_all
+  end
+
+  def search_index_count
+    ActiveRecord::Base.connection.execute("select count(*) as c from leaf_search_index").first["c"]
+  end
+
+  test "removing a user actually erases their data" do
+    sign_in :david
+
+    # Kevin creates a private book with a searchable page and an everyone book
+    private_book = Book.create!(title: "Kevin Private", creator: users(:kevin), everyone_access: false, author: "Kevin")
+    private_book.update_access(editors: [ users(:kevin).id ], readers: [])
+    private_page = private_book.press(Page.new(body: "kevinsecretword here"), title: "Kevin secret page")
+
+    shared_book = Book.create!(title: "Kevin Shared", creator: users(:kevin), everyone_access: true, author: "Kevin")
+    shared_page = shared_book.press(Page.new(body: "kevinsharedword here"), title: "Kevin shared page")
+
+    # Kevin reads something, creating a reading mark
+    ReadingMark.remember(leaves(:welcome_page), user: users(:kevin))
+
+    # Kevin has sessions and sign-in events
+    users(:kevin).sessions.start!(user_agent: "test", ip_address: "1.2.3.4")
+    assert SignInEvent.for_address("kevin@example.com").any?
+
+    # baseline
+    assert Leaf.search("kevinsecretword").any?, "search should find the private page before erase"
+
+    # Now "Remove" kevin via the current UI flow
+    delete user_url(users(:kevin))
+
+    puts "User row gone?            #{User.where(id: users(:kevin).id).none?}"
+    puts "Sessions remaining:       #{Session.where(user_id: users(:kevin).id).count}"
+    puts "Accesses remaining:       #{Access.where(user_id: users(:kevin).id).count}"
+    puts "Reading marks remaining:  #{ReadingMark.where(user_id: users(:kevin).id).count}"
+    puts "Sign-in events remaining: #{SignInEvent.for_address('kevin@example.com').count}"
+    puts "Private book exists?      #{Book.where(id: private_book.id).any?}"
+    puts "Private page searchable?  #{Leaf.search('kevinsecretword').any?}"
+    puts "Search index rows:        #{search_index_count}"
+    puts "Shared book exists?       #{Book.where(id: shared_book.id).any?}"
+    puts "Shared book creator:      #{Book.find_by(id: shared_book.id)&.creator_id.inspect}"
+    puts "Shared book author:       #{Book.find_by(id: shared_book.id)&.author.inspect}"
+  end
+end
