--- /dev/null
+++ b/test/jobs/title_cleanup_job_test.rb
@@ -0,0 +1,117 @@
+require "test_helper"
+
+class TitleCleanupJobTest < ActiveSupport::TestCase
+  class InterruptibleJob < TitleCleanupJob
+    Interrupted = Class.new(StandardError)
+
+    attr_accessor :interrupt_after
+
+    private
+      def cleaned(title)
+        @calls = @calls.to_i + 1
+        raise Interrupted, "simulated deploy interruption" if interrupt_after && @calls > interrupt_after
+        super
+      end
+  end
+
+  setup do
+    @book = books(:handbook)
+    @other_leaf_count = Leaf.count # fixture leaves are visited first, their titles need no cleaning
+
+    @leaves = [
+      press(%q("Alpha")),
+      press(%q(""Getting Started" Guide")), # legitimately opens with a quoted phrase
+      press(%q("Beta")),
+      press(%q("Meet "The Team"")),         # legitimately closes with a quoted phrase
+      press(%q("Zulu"))
+    ]
+  end
+
+  test "strips the stray wrapping quotes from every leaf title" do
+    TitleCleanupJob.perform_now
+
+    assert_cleaned_titles
+    assert_equal "Welcome to The Handbook!", leaves(:welcome_page).reload.title
+  end
+
+  test "clears its checkpoint once finished" do
+    assert_difference "TitleCleanupState.count", 0 do
+      TitleCleanupJob.perform_now
+    end
+  end
+
+  test "resumes after an interruption instead of starting over" do
+    interrupt after: @other_leaf_count + 2
+
+    assert_equal @leaves[1].id, TitleCleanupState.first.last_leaf_id
+    assert_equal %q(Alpha), @leaves[0].reload.title
+    assert_equal %q("Getting Started" Guide), @leaves[1].reload.title
+    assert_equal %q("Beta"), @leaves[2].reload.title
+    assert_equal %q("Meet "The Team""), @leaves[3].reload.title
+    assert_equal %q("Zulu"), @leaves[4].reload.title
+
+    TitleCleanupJob.perform_now
+
+    assert_cleaned_titles
+    assert_equal 0, TitleCleanupState.count
+  end
+
+  test "survives repeated interruptions" do
+    interrupt after: @other_leaf_count + 1
+    assert_equal @leaves[0].id, TitleCleanupState.first.last_leaf_id
+
+    interrupt after: 1
+    assert_equal @leaves[1].id, TitleCleanupState.first.last_leaf_id
+    assert_equal %q("Beta"), @leaves[2].reload.title
+
+    interrupt after: 2
+    assert_equal @leaves[3].id, TitleCleanupState.first.last_leaf_id
+    assert_equal %q("Zulu"), @leaves[4].reload.title
+
+    TitleCleanupJob.perform_now
+
+    assert_cleaned_titles
+    assert_equal 0, TitleCleanupState.count
+  end
+
+  test "interruption on the very first leaf resumes from the beginning" do
+    interrupt after: 0
+
+    assert_nil TitleCleanupState.first.last_leaf_id
+    assert_equal %q("Alpha"), @leaves[0].reload.title
+
+    TitleCleanupJob.perform_now
+
+    assert_cleaned_titles
+  end
+
+  test "interruption on the final leaf only redoes that leaf" do
+    interrupt after: @other_leaf_count + @leaves.size - 1
+
+    assert_equal @leaves[-2].id, TitleCleanupState.first.last_leaf_id
+    assert_equal %q("Zulu"), @leaves[-1].reload.title
+
+    TitleCleanupJob.perform_now
+
+    assert_cleaned_titles
+  end
+
+  private
+    def press(title)
+      @book.press(Page.new, title: title)
+    end
+
+    def interrupt(after:)
+      job = InterruptibleJob.new
+      job.interrupt_after = after
+      assert_raises(InterruptibleJob::Interrupted) { job.perform_now }
+    end
+
+    def assert_cleaned_titles
+      assert_equal %q(Alpha), @leaves[0].reload.title
+      assert_equal %q("Getting Started" Guide), @leaves[1].reload.title
+      assert_equal %q(Beta), @leaves[2].reload.title
+      assert_equal %q(Meet "The Team"), @leaves[3].reload.title
+      assert_equal %q(Zulu), @leaves[4].reload.title
+    end
+end
