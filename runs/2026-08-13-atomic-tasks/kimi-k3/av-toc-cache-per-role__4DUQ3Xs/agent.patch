diff --git a/test/controllers/books_controller_caching_test.rb b/test/controllers/books_controller_caching_test.rb
new file mode 100644
index 0000000..0caddb7
--- /dev/null
+++ b/test/controllers/books_controller_caching_test.rb
@@ -0,0 +1,157 @@
+require "test_helper"
+
+# Regression tests for fragment caching of the table of contents. The TOC
+# renders edit controls for editors only, so cached fragments must be keyed
+# by the viewer's ability to edit the book — otherwise the first viewer
+# determines what everyone else sees.
+class BooksControllerCachingTest < ActionDispatch::IntegrationTest
+  setup do
+    # SessionsController captures the cache store for its rate limiter when it
+    # is loaded, so make sure that happens before swapping cache stores.
+    SessionsController
+
+    @cache = ActiveSupport::Cache::MemoryStore.new
+
+    @previous_perform_caching = ActionController::Base.perform_caching
+    @previous_cache_store = ActionController::Base.cache_store
+    @previous_collection_cache = ActionView::PartialRenderer.collection_cache
+
+    ActionController::Base.perform_caching = true
+    ActionController::Base.cache_store = @cache
+    ActionView::PartialRenderer.collection_cache = @cache
+  end
+
+  teardown do
+    ActionController::Base.perform_caching = @previous_perform_caching
+    ActionController::Base.cache_store = @previous_cache_store
+    ActionView::PartialRenderer.collection_cache = @previous_collection_cache
+  end
+
+  test "reader does not see edit controls cached for an editor" do
+    sign_in_as_editor
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_toc_edit_controls_present
+
+    sign_in_as_reader
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_toc_edit_controls_absent
+  end
+
+  test "editor sees edit controls even when a reader visited first" do
+    sign_in_as_reader
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_toc_edit_controls_absent
+
+    sign_in_as_editor
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_toc_edit_controls_present
+  end
+
+  test "anonymous visitor of a published book does not receive cached editor controls" do
+    books(:handbook).update!(published: true)
+
+    sign_in_as_editor
+    get book_slug_path(books(:handbook))
+    assert_toc_edit_controls_present
+
+    sign_out
+    get book_slug_path(books(:handbook))
+    assert_response :success
+    assert_toc_edit_controls_absent
+
+    sign_in_as_editor
+    get book_slug_path(books(:handbook))
+    assert_toc_edit_controls_present
+  end
+
+  test "renamed entry shows its new title to the next reader" do
+    sign_in_as_editor
+    get book_slug_path(books(:handbook))
+    assert_in_body "Welcome to The Handbook!"
+
+    leaves(:welcome_page).update!(title: "Welcome, friends!")
+
+    sign_in_as_reader
+    get book_slug_path(books(:handbook))
+    assert_in_body "Welcome, friends!"
+    assert_not_in_body "Welcome to The Handbook!"
+  end
+
+  test "entries are fetched in one go, without a lookup per entry" do
+    sign_in_as_editor
+    get book_slug_path(books(:handbook)) # Warm the cached fragments.
+
+    books(:handbook).touch # Force a re-render around the warm fragments.
+
+    baseline = capture_sql { get book_slug_path(books(:handbook)) }.size
+
+    5.times { |i| books(:handbook).press Page.new(body: "Page #{i}"), title: "Page #{i}" }
+    get book_slug_path(books(:handbook)) # Warm the fragments for the new entries.
+
+    books(:handbook).touch # Force a re-render around the warm fragments.
+
+    with_more_entries = capture_sql { get book_slug_path(books(:handbook)) }.size
+
+    assert_equal baseline, with_more_entries
+  end
+
+  test "entry renamed through the editor shows its new title to the next person in" do
+    sign_in_as_editor
+    get book_slug_path(books(:handbook))
+    assert_in_body "Welcome to The Handbook!"
+
+    patch book_page_path(books(:handbook), leaves(:welcome_page)), params: { leaf: { title: "Welcome, friends!" } }, as: :turbo_stream
+    assert_response :success
+
+    sign_in_as_reader
+    get book_slug_path(books(:handbook))
+    assert_in_body "Welcome, friends!"
+    assert_not_in_body "Welcome to The Handbook!"
+    assert_toc_edit_controls_absent
+
+    sign_in_as_editor
+    get book_slug_path(books(:handbook))
+    assert_in_body "Welcome, friends!"
+    assert_toc_edit_controls_present
+  end
+
+  private
+    def sign_in_as_editor
+      sign_out if cookies[:session_token].present?
+      sign_in :kevin
+    end
+
+    def sign_in_as_reader
+      sign_out if cookies[:session_token].present?
+      sign_in :jz
+    end
+
+    def toc_edit_path
+      edit_leafable_path(leaves(:welcome_page))
+    end
+
+    def assert_toc_edit_controls_present
+      assert_in_body toc_edit_path
+      assert_in_body "hide_from_reading_mode"
+    end
+
+    def assert_toc_edit_controls_absent
+      assert_not_in_body toc_edit_path
+      assert_not_in_body "hide_from_reading_mode"
+    end
+
+    def capture_sql(&)
+      queries = []
+      subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*, payload|
+        queries << payload[:sql] unless %w[ SCHEMA TRANSACTION ].include?(payload[:name])
+      end
+      yield
+      queries
+    ensure
+      ActiveSupport::Notifications.unsubscribe(subscriber)
+    end
+end
