diff --git a/lib/rails_ext/active_storage_variation_format.rb b/lib/rails_ext/active_storage_variation_format.rb
new file mode 100644
index 0000000..1af16b1
--- /dev/null
+++ b/lib/rails_ext/active_storage_variation_format.rb
@@ -0,0 +1,29 @@
+# Keep ActiveStorage::Variation digests stable for symbol format values.
+#
+# Named variants are declared with symbol values, e.g.:
+#
+#   attachable.variant :large, resize_to_limit: [ 1500, 1500 ], format: :webp, process: :later
+#
+# Those symbols survive background job serialization intact, so the transform
+# job records the derived variant under a digest computed from `format: :webp`.
+# But when a variant is served on demand, its signed variation key is JSON
+# encoded and decoded, which turns the symbol into a string ("webp"). Because
+# ActiveStorage::Variation#digest is computed with Marshal.dump, the symbol and
+# string forms digest differently: the on-demand lookup misses the record the
+# background job already created, the image is transformed a second time, and
+# a duplicate derived file is stored alongside the first one forever.
+#
+# Normalizing the format to a symbol makes every entry point (named variant
+# definition, background job payload, decoded variation key) digest identically.
+# The transformed output is unaffected: the format is always used as a string.
+module ActiveStorageVariationFormatNormalization
+  def initialize(transformations)
+    super(transformations.deep_symbolize_keys.tap do |transformations|
+      transformations[:format] = transformations[:format].to_sym if transformations[:format]
+    end)
+  end
+end
+
+ActiveSupport.on_load :active_storage_blob do
+  ActiveStorage::Variation.prepend ActiveStorageVariationFormatNormalization
+end
diff --git a/test/integration/picture_derivation_test.rb b/test/integration/picture_derivation_test.rb
new file mode 100644
index 0000000..e58bd3b
--- /dev/null
+++ b/test/integration/picture_derivation_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class PictureDerivationTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    @book = Book.create!(title: "Derivation Book", everyone_access: true, published: true)
+    @picture = Picture.new(
+      image: { io: File.open(file_fixture("reading.webp")), filename: "reading.webp", content_type: "image/webp" },
+      caption: "A picture")
+    @leaf = @book.press @picture, title: "Picture"
+  end
+
+  test "reading the book does no image processing once the background job derived the upload" do
+    perform_enqueued_jobs while enqueued_jobs.any?
+    assert_equal 1, ActiveStorage::VariantRecord.count
+
+    derived_bytes = ActiveStorage::VariantRecord.sole.image.download
+
+    get leafable_slug_path(@leaf)
+    assert_response :ok
+    img_src = response.body[/<img[^>]*src="([^"]*active_storage[^"]*)"/, 1]
+    assert img_src, "expected the page to link to a derived image"
+
+    transforms = count_transforms { get img_src }
+    assert_response :redirect
+    follow_redirect!
+    assert_response :ok
+
+    assert_equal 0, transforms, "expected no image processing when the reader fetches the picture"
+    assert_equal 1, ActiveStorage::VariantRecord.count, "expected exactly one derived copy in storage"
+    assert_equal derived_bytes, response.body, "expected the reader to be served the derived copy"
+  end
+
+  test "background job reuses the variant derived by an earlier reader visit" do
+    get leafable_slug_path(@leaf)
+    img_src = response.body[/<img[^>]*src="([^"]*active_storage[^"]*)"/, 1]
+    get img_src
+    assert_equal 1, ActiveStorage::VariantRecord.count
+
+    transforms = count_transforms { perform_enqueued_jobs while enqueued_jobs.any? }
+
+    assert_equal 0, transforms, "expected the background job not to derive the upload again"
+    assert_equal 1, ActiveStorage::VariantRecord.count, "expected exactly one derived copy in storage"
+  end
+
+  private
+    def count_transforms(&block)
+      count = 0
+      ActiveSupport::Notifications.subscribed(->(*) { count += 1 }, "transform.active_storage", &block)
+      count
+    end
+end
