@@ -7,12 +7,17 @@ module Book::Import
   def import_manifest(entries)
     as_one_batch do
       entries.each do |entry|
-        return rejected(entry) unless entry_valid?(entry)
+        reject_and_rollback(entry) unless entry_valid?(entry)
 
-        press(Section.new(body: entry[:body]), title: entry[:title])
+        begin
+          press(Section.new(body: entry[:body]), title: entry[:title])
+        rescue ActiveRecord::RecordInvalid
+          reject_and_rollback(entry)
+        end
       end
+
+      true
     end
-    true
   end
 
   private
@@ -20,8 +25,12 @@ module Book::Import
       entry[:title].present? && entry[:body].present?
     end
 
-    def rejected(entry)
+    # Logs the rejection, then aborts the batch by rolling its transaction
+    # back to where it began, so nothing from the manifest stays behind.
+    # The rollback is swallowed by the transaction block, which then returns
+    # nil — import_manifest's falsy "failed" for the caller.
+    def reject_and_rollback(entry)
       Rails.logger.warn "import rejected at #{entry.inspect}"
-      false
+      raise ActiveRecord::Rollback
     end
