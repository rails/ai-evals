diff --git a/app/models/concerns/batched.rb b/app/models/concerns/batched.rb
index 55a53e7..5668cdd 100644
--- a/app/models/concerns/batched.rb
+++ b/app/models/concerns/batched.rb
@@ -6,7 +6,12 @@ module Batched
     # lands or none of it does. The manifest importer goes through here so
     # that a rejected manifest leaves the book exactly as it was before the
     # attempt.
+    #
+    # The batch always gets a transaction of its own (requires_new), never
+    # joining one the caller may already have open. That way rolling a batch
+    # back undoes only the batch — via a savepoint when nested, like under
+    # the nightly bulk importer — and the surrounding work survives.
     def as_one_batch(&block)
-      self.class.transaction(&block)
+      self.class.transaction(requires_new: true, &block)
     end
 end
diff --git a/test/models/book/import_test.rb b/test/models/book/import_test.rb
new file mode 100644
index 0000000..0db8a24
--- /dev/null
+++ b/test/models/book/import_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class Book::ImportTest < ActiveSupport::TestCase
+  test "valid manifest presses every entry once, in manifest order, and is truthy" do
+    book = Book.create!(title: "Importable")
+    entries = [
+      { title: "One",   body: "first"  },
+      { title: "Two",   body: "second" },
+      { title: "Three", body: "third"  }
+    ]
+
+    assert book.import_manifest(entries)
+
+    leaves = book.leaves.reload.positioned
+    assert_equal %w[ One Two Three ], leaves.map(&:title)
+    assert leaves.all? { |leaf| leaf.leafable.is_a?(Section) }
+    assert_equal "first", leaves.first.leafable.body.to_s.chomp
+  end
+
+  test "manifest with an invalid entry partway through imports nothing and is falsy" do
+    book = Book.create!(title: "All Or Nothing")
+    entries = [
+      { title: "One",   body: "first" },
+      { title: "",      body: "no title" },
+      { title: "Three", body: "third" }
+    ]
+
+    assert_not book.import_manifest(entries)
+    assert_equal 0, book.leaves.reload.count
+  end
+
+  test "invalid entries at either end of the manifest import nothing" do
+    book = Book.create!(title: "Edges")
+
+    assert_not book.import_manifest([ { title: nil, body: "x" }, { title: "T", body: "b" } ])
+    assert_not book.import_manifest([ { title: "T", body: "b" }, { title: "T2", body: "" } ])
+    assert_equal 0, book.leaves.reload.count
+  end
+
+  test "a rejected manifest can be fixed and re-imported exactly once" do
+    book = Book.create!(title: "Retry")
+
+    assert_not book.import_manifest([ { title: "One", body: "1" }, { title: "", body: "oops" } ])
+    assert book.import_manifest([ { title: "One", body: "1" }, { title: "Two", body: "2" } ])
+
+    assert_equal %w[ One Two ], book.leaves.reload.positioned.map(&:title)
+  end
+
+  test "entry duplicating a title already in the book rejects rather than crashes" do
+    book = Book.create!(title: "Duplicates")
+    book.press(Section.new(body: "original"), title: "Kept")
+
+    result = assert_nothing_raised do
+      book.import_manifest([ { title: "New", body: "n" }, { title: "Kept", body: "dupe" } ])
+    end
+
+    assert_not result
+    assert_equal %w[ Kept ], book.leaves.reload.map(&:title)
+    assert_equal "original", book.leaves.first.leafable.body.to_s.chomp
+  end
+
+  test "duplicate titles within one manifest reject the whole manifest" do
+    book = Book.create!(title: "Self Duplicate")
+
+    assert_not book.import_manifest([ { title: "Same", body: "one" }, { title: "Same", body: "two" } ])
+    assert_equal 0, book.leaves.reload.count
+  end
+
+  test "empty manifest is a truthy no-op" do
+    book = Book.create!(title: "Empty")
+
+    assert book.import_manifest([])
+    assert_equal 0, book.leaves.reload.count
+  end
+end
diff --git a/test/models/bulk_import_test.rb b/test/models/bulk_import_test.rb
new file mode 100644
index 0000000..eb4d26d
--- /dev/null
+++ b/test/models/bulk_import_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class BulkImportTest < ActiveSupport::TestCase
+  test "a rejected manifest leaves nothing behind and the rest of the run survives" do
+    good_book = Book.create!(title: "Bulk Good")
+    bad_book  = Book.create!(title: "Bulk Bad")
+
+    result = BulkImport.new(
+      good_book => [ { title: "G1", body: "g1" }, { title: "G2", body: "g2" } ],
+      bad_book  => [ { title: "B1", body: "b1" }, { title: "",   body: "bad" } ]
+    ).run
+
+    assert_equal [ good_book ], result.imported
+    assert_equal [ bad_book ],  result.rejected
+    assert_equal %w[ G1 G2 ], good_book.leaves.reload.positioned.map(&:title)
+    assert_equal 0, bad_book.leaves.reload.count
+  end
+
+  test "manifests after a rejected one still import" do
+    bad_book  = Book.create!(title: "Bulk Bad First")
+    good_book = Book.create!(title: "Bulk Good Second")
+
+    result = BulkImport.new(
+      bad_book  => [ { title: "", body: "bad" } ],
+      good_book => [ { title: "G1", body: "g1" } ]
+    ).run
+
+    assert_equal [ good_book ], result.imported
+    assert_equal [ bad_book ],  result.rejected
+    assert_equal %w[ G1 ], good_book.leaves.reload.map(&:title)
+  end
+
+  test "a manifest duplicating a title already in its book rejects cleanly mid-run" do
+    book  = Book.create!(title: "Bulk Dup")
+    book.press(Section.new(body: "original"), title: "Kept")
+    other = Book.create!(title: "Bulk Other")
+
+    result = BulkImport.new(
+      book  => [ { title: "New", body: "n" }, { title: "Kept", body: "dupe" } ],
+      other => [ { title: "Fine", body: "f" } ]
+    ).run
+
+    assert_equal [ other ], result.imported
+    assert_equal [ book ],  result.rejected
+    assert_equal %w[ Kept ], book.leaves.reload.map(&:title)
+    assert_equal %w[ Fine ], other.leaves.reload.map(&:title)
+  end
+end
