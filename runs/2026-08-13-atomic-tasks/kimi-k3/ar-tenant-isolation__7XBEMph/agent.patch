new file mode 100644
index 0000000..8dec144
--- /dev/null
+++ b/db/migrate/20250808000000_create_tenants.rb
@@ -0,0 +1,43 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_reference :users, :tenant, foreign_key: true
+    add_reference :books, :tenant, foreign_key: true
+
+    sweep_existing_records_into_one_tenant
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+
+    drop_table :tenants
+  end
+
+  private
+    # Running installs upgrade in place: everything that already exists
+    # belongs to a single shared tenant.
+    def sweep_existing_records_into_one_tenant
+      if MigrationUser.any? || MigrationBook.any?
+        tenant = MigrationTenant.create!(name: "Default")
+        MigrationUser.in_batches.update_all(tenant_id: tenant.id)
+        MigrationBook.in_batches.update_all(tenant_id: tenant.id)
+      end
+    end
+
+    class MigrationTenant < ActiveRecord::Base
+      self.table_name = "tenants"
+    end
+
+    class MigrationUser < ActiveRecord::Base
+      self.table_name = "users"
+    end
+
+    class MigrationBook < ActiveRecord::Base
+      self.table_name = "books"
+    end
+end
