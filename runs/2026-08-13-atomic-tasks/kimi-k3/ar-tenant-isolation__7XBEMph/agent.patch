diff --git a/test/controllers/tenancy_test.rb b/test/controllers/tenancy_test.rb
new file mode 100644
index 0000000..3d1f92e
--- /dev/null
+++ b/test/controllers/tenancy_test.rb
@@ -0,0 +1,175 @@
+require "test_helper"
+
+class TenancyTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Customer A")
+    @tenant_b = Tenant.create!(name: "Customer B")
+
+    @user_a = users(:kevin).tap { it.update!(tenant: @tenant_a) }
+    @user_b = users(:jason).tap { it.update!(tenant: @tenant_b) }
+
+    @book_a = books(:handbook).tap { it.update!(tenant: @tenant_a) }
+    @book_b = books(:manual).tap { it.update!(tenant: @tenant_b) }
+
+    @leaf_b = @book_b.press(Page.new(body: "Customer B secrets"), title: "B Secrets")
+    @leaf_b.edit leafable_params: { body: "Customer B secrets v2" }
+
+    # Sharing with everyone sprays reader rows across the whole install
+    @book_b.update!(everyone_access: true)
+    @book_b.update_access(editors: [ @user_b.id ], readers: [])
+
+    sign_in :kevin
+  end
+
+  test "sharing with everyone still leaves an access row across tenants" do
+    assert Access.exists?(user: @user_a, book: @book_b)
+  end
+
+  test "library excludes other tenants' books, published or not" do
+    get root_path
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+    assert_select "h2", text: "Manual", count: 0
+
+    @book_b.update!(published: true)
+    get root_path
+    assert_response :success
+    assert_select "h2", text: "Manual", count: 0
+  end
+
+  test "another tenant's book is 404, published or not, and the session survives" do
+    get book_slug_path(@book_b)
+    assert_response :not_found
+
+    @book_b.update!(published: true)
+    get book_slug_path(@book_b)
+    assert_response :not_found
+
+    get book_path(@book_b)
+    assert_response :not_found
+
+    # Still signed in
+    get root_path
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+  end
+
+  test "another tenant's book cannot be edited, destroyed, published, or added to" do
+    patch book_path(@book_b), params: { book: { title: "Hijacked" } }
+    assert_response :not_found
+    assert_equal "Manual", @book_b.reload.title
+
+    delete book_path(@book_b)
+    assert_response :not_found
+    assert Book.exists?(@book_b.id)
+
+    patch book_publication_path(@book_b), params: { book: { published: true } }
+    assert_response :not_found
+    assert_not @book_b.reload.published?
+
+    post book_pages_path(@book_b), params: { leaf: { title: "Sneaky" }, page: { body: "x" } }
+    assert_response :not_found
+    assert_equal 1, @book_b.leaves.count
+  end
+
+  test "pages in another tenant's book are 404 even with an access row" do
+    get leafable_slug_path(@leaf_b)
+    assert_response :not_found
+
+    get book_page_path(@book_b, @leaf_b)
+    assert_response :not_found
+  end
+
+  test "edit histories in another tenant's book are 404 even with an access row" do
+    get page_edit_path(@leaf_b, "latest")
+    assert_response :not_found
+
+    get page_edit_path(@leaf_b, @leaf_b.edits.last)
+    assert_response :not_found
+  end
+
+  test "search in another tenant's book is 404" do
+    post book_search_path(@book_b), params: { search: "secrets" }
+    assert_response :not_found
+  end
+
+  test "own tenant is unaffected: book, pages, edit history, search" do
+    leaves(:welcome_page).edit leafable_params: { body: "Updated own content" }
+
+    get book_slug_path(@book_a)
+    assert_response :success
+
+    get leafable_slug_path(leaves(:welcome_page))
+    assert_response :success
+
+    get page_edit_path(leaves(:welcome_page), "latest")
+    assert_response :success
+
+    post book_search_path(@book_a), params: { search: "welcome" }
+    assert_response :success
+  end
+
+  test "signed-out visitors see every published book, whatever the tenant" do
+    @book_b.update!(published: true)
+    sign_out
+
+    get root_path
+    assert_response :success
+    assert_select "h2", text: "Manual"
+
+    get book_slug_path(@book_b)
+    assert_response :success
+
+    get leafable_slug_path(@leaf_b)
+    assert_response :success
+  end
+
+  test "new books land in their creator's tenant" do
+    post books_path, params: { book: { title: "A New Book", everyone_access: false } }
+
+    book = Book.find_by(title: "A New Book")
+    assert_equal @tenant_a.id, book.tenant_id
+  end
+
+  test "sharing with everyone keeps working inside a tenant" do
+    users(:jz).update!(tenant: @tenant_a)
+
+    post books_path, params: { book: { title: "Shared A Book", everyone_access: true } }
+    book = Book.find_by(title: "Shared A Book")
+
+    sign_in :jz
+    get book_slug_path(book)
+    assert_response :success
+  end
+
+  test "books without a tenant behave as they do today" do
+    @book_b.update!(tenant: nil)
+
+    get book_slug_path(@book_b)
+    assert_response :success
+
+    get leafable_slug_path(@leaf_b)
+    assert_response :success
+  end
+
+  test "users without a tenant behave as they do today" do
+    @user_a.update!(tenant: nil)
+
+    get book_slug_path(@book_b)
+    assert_response :success
+
+    get root_path
+    assert_response :success
+    assert_select "h2", text: "Manual"
+    assert_select "h2", text: "Handbook"
+  end
+
+  test "/users still names everyone on the install" do
+    get users_path
+    assert_response :success
+    assert_in_body "Kevin"
+    assert_in_body "Jason"
+    assert_in_body "David"
+    assert_in_body "JZ"
+  end
+end
