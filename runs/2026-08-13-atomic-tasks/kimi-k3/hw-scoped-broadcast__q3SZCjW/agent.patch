     assert_response :forbidden
   end
+
+  test "update pushes the being-edited indicator to everyone who can edit the book" do
+    leaf = leaves(:welcome_page)
+
+    kevins_stream = being_edited_stream_served_to users(:kevin), leaf
+    davids_stream = being_edited_stream_served_to users(:david), leaf
+
+    sign_in :david
+
+    assert_broadcasts kevins_stream, 1 do
+      assert_broadcasts davids_stream, 1 do
+        save_page leaf
+      end
+    end
+  end
+
+  test "update does not push the being-edited indicator to a collaborator removed from the book" do
+    leaf = leaves(:welcome_page)
+
+    removed_collaborators_stream = being_edited_stream_served_to users(:kevin), leaf
+
+    books(:handbook).access_for(user: users(:kevin)).destroy!
+
+    sign_in :david
+
+    assert_no_broadcasts removed_collaborators_stream do
+      save_page leaf
+    end
+  end
+
+  test "update does not push the being-edited indicator to a collaborator demoted to reader" do
+    leaf = leaves(:welcome_page)
+
+    demoted_collaborators_stream = being_edited_stream_served_to users(:kevin), leaf
+
+    books(:handbook).access_for(user: users(:kevin)).update! level: :reader
+
+    sign_in :david
+
+    assert_no_broadcasts demoted_collaborators_stream do
+      save_page leaf
+    end
+  end
+
+  test "update does not push the being-edited indicator to readers" do
+    leaf = leaves(:welcome_page)
+
+    readers_stream = Turbo::StreamsChannel.verified_stream_name \
+      Turbo::StreamsChannel.signed_stream_name([ users(:jz), leaf, :being_edited ])
+
+    sign_in :david
+
+    assert_no_broadcasts readers_stream do
+      save_page leaf
+    end
+  end
+
+  test "update pushes the being-edited indicator to administrators without explicit access" do
+    leaf = leaves(:welcome_page)
+
+    books(:handbook).update! published: true
+
+    administrators_stream = being_edited_stream_served_to users(:david), leaf
+
+    books(:handbook).access_for(user: users(:david)).destroy!
+
+    sign_in :kevin
+
+    assert_broadcasts administrators_stream, 1 do
+      save_page leaf
+    end
+  end
+
+  test "being-edited payload reveals who is editing" do
+    leaf = leaves(:welcome_page)
+
+    kevins_stream = being_edited_stream_served_to users(:kevin), leaf
+
+    sign_in :david
+
+    broadcasts(kevins_stream).clear
+    save_page leaf
+
+    assert_includes broadcasts(kevins_stream).last, users(:david).name
+  end
+
+  private
+    def save_page(leaf)
+      perform_enqueued_jobs do
+        patch book_page_path(leaf.book, leaf, format: :turbo_stream), params: {
+          leaf: { title: leaf.title }, page: { body: "Updated words." }
+        }
+
+        assert_response :success
+      end
+    end
+
+    # Returns the raw name of the stream the edit page subscribes +user+ to --
+    # i.e. the channel that user keeps listening on while the editor is open.
+    def being_edited_stream_served_to(user, leaf)
+      sign_in user
+
+      get edit_leafable_path(leaf)
+      assert_response :success
+
+      signed_stream_name = Nokogiri::HTML(response.body)
+        .at_css(%(turbo-cable-stream-source[channel="Turbo::StreamsChannel"]))
+        &.attribute("signed-stream-name")&.value
+
+      assert signed_stream_name.present?, "expected the edit page to subscribe to a being-edited stream"
+
+      Turbo::StreamsChannel.verified_stream_name(signed_stream_name)
+    ensure
+      sign_out if cookies[:session_token].present?
+    end
 end
