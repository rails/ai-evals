diff --git a/test/test_helper.rb b/test/test_helper.rb
index 296ac3e..87bc7e7 100644
--- a/test/test_helper.rb
+++ b/test/test_helper.rb
@@ -12,12 +12,27 @@ module ActiveSupport
 
     include SessionTestHelper
 
+    # Inside the block, controller errors propagate to the test as raised
+    # exceptions instead of being rendered as error pages; outside the
+    # block, error pages render as usual.
+    #
+    # NOTE: whether an exception is shown or raised is decided per request
+    # from the "action_dispatch.show_exceptions" entry of
+    # Rails.application.env_config (merged into the env by
+    # Rails::Engine#call). That hash is memoized the first time it is
+    # built, so toggling config.action_dispatch.show_exceptions alone only
+    # works until the process has served its first request -- which made
+    # this helper order-dependent and flaky under the parallel test suite.
+    # Toggle the memoized env_config entry (the value that is actually
+    # read) and restore it, so the promise holds no matter what ran before
+    # or runs after in this process.
     def with_raised_exceptions
-      previous = Rails.application.config.action_dispatch.show_exceptions
-      Rails.application.config.action_dispatch.show_exceptions = :none
+      env_config = Rails.application.env_config
+      previous = env_config["action_dispatch.show_exceptions"]
+      env_config["action_dispatch.show_exceptions"] = :none
       yield
     ensure
-      Rails.application.config.action_dispatch.show_exceptions = previous
+      env_config["action_dispatch.show_exceptions"] = previous
     end
   end
 end
