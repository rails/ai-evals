+++ b/test/mailers/report_digest_mailer_test.rb
@@ -0,0 +1,12 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest lists published books with their last edited date" do
+    books(:handbook).update! published: true
+
+    mail = ReportDigestMailer.weekly(users(:david))
+
+    assert_equal "Your Writebook digest", mail.subject
+    assert_includes mail.body.encoded, "Handbook, last edited #{books(:handbook).updated_at.to_date.to_fs(:short)}"
+  end
+end
diff --git a/test/models/book/reportable_test.rb b/test/models/book/reportable_test.rb
new file mode 100644
index 0000000..b2ce327
--- /dev/null
+++ b/test/models/book/reportable_test.rb
@@ -0,0 +1,21 @@
+require "test_helper"
+
+class Book::ReportableTest < ActiveSupport::TestCase
+  test "report summary delimits the character count" do
+    book = books(:manual)
+    book.press Page.new(body: "a" * 1_234), title: "Long Page"
+
+    assert_equal "Manual — 1,234 characters", book.report_summary
+  end
+
+  test "last edited at is the most recent leaf update" do
+    leaf = leaves(:welcome_page)
+    leaf.touch
+
+    assert_equal leaf.reload.updated_at, books(:handbook).last_edited_at
+  end
+
+  test "last edited at is nil for a book with no leaves" do
+    assert_nil books(:manual).last_edited_at
+  end
+end
