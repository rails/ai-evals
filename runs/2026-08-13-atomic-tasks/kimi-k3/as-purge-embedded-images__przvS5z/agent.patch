+++ b/test/integration/page_upload_lifecycle_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class PageUploadLifecycleTest < ActionDispatch::IntegrationTest
+  include ActiveJob::TestHelper
+
+  setup do
+    sign_in :kevin
+  end
+
+  test "upload into markdown, fetch it, destroy page, everything is gone" do
+    page = pages(:welcome)
+    page.body.save!
+
+    # 1. Upload an image into the page's markdown, as the editor does
+    assert_changes -> { ActiveStorage::Attachment.count }, 1 do
+      post action_text_markdown_uploads_path, params: {
+        record_gid: page.to_signed_global_id.to_s,
+        attribute_name: "body",
+        file: fixture_file_upload("reading.webp", "image/webp")
+      }, as: :xhr
+    end
+    assert_response :created
+
+    file_url = JSON.parse(response.body)["fileUrl"]
+    attachment = page.body.reload.uploads.attachments.last
+    blob = attachment.blob
+    blob_path = blob.service.path_for(blob.key)
+    assert File.exist?(blob_path)
+
+    # 2. Fetch the image back from the URL the app handed us
+    get file_url
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_equal file_fixture("reading.webp").binread.b, response.body.b
+
+    # 3. Delete the page (controller trashes the leaf; then it's permanently destroyed)
+    delete book_page_path(books(:handbook), leaves(:welcome_page))
+    assert_redirected_to book_slug_url(books(:handbook))
+
+    # uploads still around while only trashed
+    assert ActiveStorage::Blob.exists?(blob.id)
+
+    leaves(:welcome_page).reload.destroy
+
+    # 4. Run background work the destruction set off
+    perform_enqueued_jobs
+
+    # 5. Neither file nor tracking records exist anywhere
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not File.exist?(blob_path)
+    assert_not ActionText::Markdown.where(record: page).exists?
+
+    # and the upload URL no longer resolves
+    get file_url
+    assert_response :not_found
+  end
+end
diff --git a/test/models/page_uploads_test.rb b/test/models/page_uploads_test.rb
new file mode 100644
index 0000000..682b53d
--- /dev/null
+++ b/test/models/page_uploads_test.rb
@@ -0,0 +1,75 @@
+require "test_helper"
+
+class PageUploadsTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  setup do
+    @page = pages(:welcome)
+    @markdown = @page.body.tap(&:save!)
+    @markdown.uploads.attach io: file_fixture("reading.webp").open, filename: "reading.webp", content_type: "image/webp"
+    @markdown.save!
+
+    @attachment = @markdown.uploads.attachments.last
+    @blob = @attachment.blob
+    @blob_path = @blob.service.path_for(@blob.key)
+  end
+
+  test "destroying a page purges its markdown uploads from the database and disk" do
+    assert File.exist?(@blob_path)
+
+    @page.destroy
+    perform_enqueued_jobs
+
+    assert_upload_purged
+  end
+
+  test "destroying a page purges multiple markdown uploads" do
+    @markdown.uploads.attach io: file_fixture("reading.webp").open, filename: "reading-2.webp", content_type: "image/webp"
+    @markdown.save!
+
+    blobs = @markdown.uploads.blobs.to_a
+    paths = blobs.map { |blob| blob.service.path_for(blob.key) }
+    assert_equal 2, blobs.size
+
+    @page.destroy
+    perform_enqueued_jobs
+
+    blobs.each { |blob| assert_not ActiveStorage::Blob.exists?(blob.id) }
+    paths.each { |path| assert_not File.exist?(path) }
+    assert_empty ActiveStorage::Attachment.where(blob_id: blobs.map(&:id))
+  end
+
+  test "destroying a trashed leaf purges its page uploads" do
+    leaf = leaves(:welcome_page)
+    leaf.trashed!
+    leaf.reload.destroy
+    perform_enqueued_jobs
+
+    assert_upload_purged
+  end
+
+  test "destroying a book purges uploads embedded in its pages" do
+    books(:handbook).destroy
+    perform_enqueued_jobs
+
+    assert_upload_purged
+  end
+
+  test "destroying a revision edit purges the previous page uploads" do
+    leaf = leaves(:welcome_page)
+    leaf.edits.destroy_all # force the next edit to be recorded as a revision
+    leaf.edit leafable_params: { body: "Brand new body" }
+
+    leaf.edits.revision.sorted.first.destroy
+    perform_enqueued_jobs
+
+    assert_upload_purged
+  end
+
+  private
+    def assert_upload_purged
+      assert_not ActiveStorage::Attachment.exists?(@attachment.id), "attachment record should be gone"
+      assert_not ActiveStorage::Blob.exists?(@blob.id), "blob record should be gone"
+      assert_not File.exist?(@blob_path), "file should be gone from disk"
+    end
+end
