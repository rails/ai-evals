diff --git a/app/models/concerns/tenantable.rb b/app/models/concerns/tenantable.rb
new file mode 100644
index 0000000..2b32446
--- /dev/null
+++ b/app/models/concerns/tenantable.rb
@@ -0,0 +1,19 @@
+# Records can belong to a Tenant. Tenants are walled off from one another:
+# a member of one tenant cannot see records belonging to another.
+#
+# Records without a tenant are shared by everyone, which is how installs that
+# predate tenants keep behaving exactly as they did. By the same token, a
+# tenant-less viewer sees every record, just like before tenants existed.
+module Tenantable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :tenant, optional: true
+
+    scope :in_tenant, ->(tenant) { tenant.present? ? where(tenant: [ nil, tenant ]) : all }
+  end
+
+  def in_tenant?(tenant)
+    tenant.nil? || self.tenant.nil? || self.tenant == tenant
+  end
+end
