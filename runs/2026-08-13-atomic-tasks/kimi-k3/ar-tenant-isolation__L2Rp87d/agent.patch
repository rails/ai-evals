index 0000000..9498a46
--- /dev/null
+++ b/db/migrate/20250804120000_create_tenants.rb
@@ -0,0 +1,43 @@
+class CreateTenants < ActiveRecord::Migration[8.0]
+  def up
+    create_table :tenants do |t|
+      t.string :name, null: false
+      t.timestamps
+    end
+
+    add_column :users, :tenant_id, :integer
+    add_column :books, :tenant_id, :integer
+
+    add_index :users, :tenant_id
+    add_index :books, :tenant_id
+
+    add_foreign_key :users, :tenants
+    add_foreign_key :books, :tenants
+
+    sweep_existing_records_into_a_single_tenant
+  end
+
+  def down
+    remove_reference :books, :tenant, foreign_key: true
+    remove_reference :users, :tenant, foreign_key: true
+
+    drop_table :tenants
+  end
+
+  private
+    # Running installs upgrade in place: every user and book already on the
+    # install lands in one shared tenant, so nothing about who can see what
+    # changes until more tenants are created.
+    def sweep_existing_records_into_a_single_tenant
+      if User.exists? || Book.exists?
+        tenant = Tenant.create!(name: default_tenant_name)
+
+        User.where(tenant_id: nil).update_all(tenant_id: tenant.id)
+        Book.where(tenant_id: nil).update_all(tenant_id: tenant.id)
+      end
+    end
+
+    def default_tenant_name
+      Account.first&.name.presence || "Default"
+    end
+end
