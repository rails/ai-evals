+
+  test "destroy archives everyone with access and removes the book and grants" do
+    book = books(:handbook)
+    access_count = book.accesses.count
+
+    assert_difference -> { AccessArchive.where(book_id: book.id).count }, access_count do
+      delete book_url(book)
+    end
