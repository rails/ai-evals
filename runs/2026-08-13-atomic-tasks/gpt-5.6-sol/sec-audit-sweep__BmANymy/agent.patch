diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..446eba9
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+
+    @apostrophe = books(:handbook).press Page.new, title: "Editor's guide"
+    @percent = books(:handbook).press Page.new, title: "Save 50% off"
+    @underscore = books(:handbook).press Page.new, title: "Under_score"
+    @ordinary = books(:handbook).press Page.new, title: "Ordinary guide"
+    @secret = books(:manual).press Page.new, title: "Secret percent guide"
+  end
+
+  test "search treats apostrophes as data and only returns readable books" do
+    get library_search_path, params: { q: "'" }
+
+    assert_response :success
+    assert_select ".search__result", text: /#{Regexp.escape(@apostrophe.title)}/
+    assert_not_in_body @secret.title
+
+    get library_search_path, params: { q: "' OR 1=1 --" }
+
+    assert_response :success
+    assert_not_in_body @secret.title
+  end
+
+  test "search treats percent as a literal character" do
+    get library_search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_in_body @percent.title
+    assert_not_in_body @ordinary.title
+  end
+
+  test "search treats underscore as a literal character" do
+    get library_search_path, params: { q: "_" }
+
+    assert_response :success
+    assert_in_body @underscore.title
+    assert_not_in_body @ordinary.title
+  end
+
+test "signed-out search returns published books only" do
+  books(:handbook).update!(published: true)
+  sign_out
+
+  get library_search_path, params: { q: "guide" }
+
+  assert_response :success
+  assert_select ".search__result", text: /#{Regexp.escape(@apostrophe.title)}/
+  assert_in_body @ordinary.title
+  assert_not_in_body @secret.title
+end
+
+  test "ordinary search still finds readable matching titles only" do
+    get library_search_path, params: { q: "guide" }
+
+    assert_response :success
+    assert_select ".search__result", text: /#{Regexp.escape(@apostrophe.title)}/
+    assert_in_body @ordinary.title
+    assert_not_in_body @secret.title
+  end
+end
