+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "formats each book's last edited date" do
+    book = books(:handbook)
+    book.update_columns published: true, updated_at: Time.zone.local(2026, 2, 3, 4, 5, 6)
+
+    body = ReportDigestMailer.weekly(users(:david)).body.to_s
+
+    assert_includes body, "* Handbook, last edited 03 Feb"
+  end
+end
