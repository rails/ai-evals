diff --git a/test/controllers/books_caching_test.rb b/test/controllers/books_caching_test.rb
new file mode 100644
index 0000000..10b0904
--- /dev/null
+++ b/test/controllers/books_caching_test.rb
@@ -0,0 +1,82 @@
+require "test_helper"
+
+class BooksCachingTest < ActionDispatch::IntegrationTest
+  setup do
+    @old_cache = Rails.cache
+    @old_controller_cache = ActionController::Base.cache_store
+    @old_perform_caching = ActionController::Base.perform_caching
+    Rails.cache = ActiveSupport::Cache::MemoryStore.new
+    ActionController::Base.cache_store = Rails.cache
+    ActionController::Base.perform_caching = true
+  end
+
+  teardown do
+    Rails.cache.clear
+    Rails.cache = @old_cache
+    ActionController::Base.cache_store = @old_controller_cache
+    ActionController::Base.perform_caching = @old_perform_caching
+  end
+
+  test "table of contents caches editor controls separately from reader entries" do
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_entry_edit_links leaves(:welcome_page), count: 2
+
+    books(:handbook).touch
+    sign_out
+    sign_in :jz
+    get book_slug_url(books(:handbook))
+    assert_entry_edit_links leaves(:welcome_page), count: 0
+  end
+
+  test "table of contents gives editors controls after a reader warmed the cache" do
+    sign_in :jz
+    get book_slug_url(books(:handbook))
+    assert_entry_edit_links leaves(:welcome_page), count: 0
+
+    books(:handbook).touch
+    sign_out
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_entry_edit_links leaves(:welcome_page), count: 2
+  end
+
+  test "table of contents does not check edit permission per entry" do
+    sign_in :kevin
+    20.times do |index|
+      books(:handbook).press(Page.create!, title: "Extra page #{index}")
+    end
+
+    calls = 0
+    original = Book.instance_method(:editable?)
+    Book.define_method(:editable?) do |**arguments|
+      calls += 1
+      original.bind_call(self, **arguments)
+    end
+
+    get book_slug_url(books(:handbook))
+
+    assert_response :success
+    assert_equal 2, calls
+  ensure
+    Book.define_method(:editable?, original) if original
+  end
+
+  test "table of contents cache is invalidated when an entry is renamed" do
+    sign_in :kevin
+    get book_slug_url(books(:handbook))
+    assert_select ".toc__title", text: leaves(:welcome_page).title
+
+    leaves(:welcome_page).update!(title: "A newly renamed page")
+
+    sign_out
+    sign_in :jz
+    get book_slug_url(books(:handbook))
+    assert_select ".toc__title", text: "A newly renamed page"
+  end
+
+  private
+    def assert_entry_edit_links(leaf, count:)
+      assert_select "a[href='#{edit_leafable_path(leaf)}']", count: count
+    end
+end
