diff --git a/test/jobs/being_edited_broadcast_job_test.rb b/test/jobs/being_edited_broadcast_job_test.rb
new file mode 100644
index 0000000..d93113d
--- /dev/null
+++ b/test/jobs/being_edited_broadcast_job_test.rb
@@ -0,0 +1,19 @@
+require "test_helper"
+
+class BeingEditedBroadcastJobTest < ActiveJob::TestCase
+  test "checks editor access when the queued broadcast is delivered" do
+    leaf = leaves(:welcome_page)
+    saver = users(:kevin)
+    removed_editor = users(:jz)
+    book = books(:handbook)
+    book.access_for(user: removed_editor).update!(level: :editor)
+    removed_editor_stream = Turbo::StreamsChannel.send(:stream_name_from, [ leaf, :being_edited, removed_editor ])
+
+    BeingEditedBroadcastJob.perform_later leaf, saver
+    book.access_for(user: removed_editor).destroy!
+
+    assert_no_broadcasts removed_editor_stream do
+      perform_enqueued_jobs
+    end
+  end
+end
