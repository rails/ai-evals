diff --git a/test/controllers/tenant_isolation_test.rb b/test/controllers/tenant_isolation_test.rb
new file mode 100644
index 0000000..8b1ac4b
--- /dev/null
+++ b/test/controllers/tenant_isolation_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class TenantIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Customer A")
+    @tenant_b = Tenant.create!(name: "Customer B")
+    @user = users(:kevin)
+    @user.update!(tenant: @tenant_a)
+    @foreign_book = books(:manual)
+    @foreign_book.update!(tenant: @tenant_b, published: true)
+    Access.create!(user: @user, book: @foreign_book, level: :reader)
+    @foreign_leaf = @foreign_book.press Page.new(body: "Foreign content"), title: "Foreign page"
+    @foreign_leaf.edit leafable_params: { body: "Secret edit" }
+    sign_in @user
+  end
+
+  test "signed-in users cannot discover another tenant's published book" do
+    get root_path
+    assert_response :success
+    assert_not_in_body @foreign_book.title
+
+    get book_slug_path(@foreign_book)
+    assert_response :not_found
+  end
+
+  test "signed-in users get not found for another tenant's pages and history" do
+    get leafable_path(@foreign_leaf)
+    assert_response :not_found
+
+    get page_edit_path(@foreign_leaf, @foreign_leaf.edits.last)
+    assert_response :not_found
+  end
+
+  test "new books belong to their creator's tenant" do
+    post books_path, params: { book: { title: "Tenant A book", everyone_access: false } }
+
+    assert_equal @tenant_a, Book.find_by!(title: "Tenant A book").tenant
+  end
+
+  test "sharing with everyone only grants users in the book's tenant" do
+    local_user = users(:jz)
+    local_user.update!(tenant: @tenant_a)
+    @foreign_book.update!(tenant: @tenant_a, everyone_access: true)
+
+    @foreign_book.update_access(editors: [ @user.id ], readers: [])
+
+    assert @foreign_book.accessable?(user: local_user)
+    assert_not @foreign_book.accesses.exists?(user: users(:jason))
+  end
+
+  test "signed-out visitors can read published books in every tenant" do
+    sign_out
+    get book_slug_path(@foreign_book)
+    assert_response :success
+  end
+end
