--- a/app/models/book/announceable.rb
+++ b/app/models/book/announceable.rb
@@ -2,11 +2,24 @@ module Book::Announceable
   extend ActiveSupport::Concern
 
   included do
-    after_update_commit :announce_publication, if: :saved_change_to_published?
+    after_update :mark_publication_for_announcement, if: -> { saved_change_to_published?(from: false, to: true) }
+    after_update_commit :announce_publication_if_pending
+    after_rollback :clear_publication_announcement
   end
 
   private
-    def announce_publication
-      AnnouncePublicationJob.perform_later self
+    def mark_publication_for_announcement
+      @publication_announcement_pending = true
+    end
+
+    def announce_publication_if_pending
+      announce = @publication_announcement_pending && published?
+      clear_publication_announcement
+
+      AnnouncePublicationJob.perform_later self if announce
+    end
+
+    def clear_publication_announcement
+      @publication_announcement_pending = false
     end
 end
