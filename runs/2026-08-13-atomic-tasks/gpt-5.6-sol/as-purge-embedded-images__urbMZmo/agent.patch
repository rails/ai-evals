@@ -26,4 +28,28 @@ class PageTest < ActiveSupport::TestCase
     assert_includes page.searchable_content, "5 &lt; 10 &amp; 10 &gt; 5"
     assert page.searchable_content.html_safe?
   end
+
+  test "destroying a page purges its embedded image" do
+    ActiveStorage::Attachment # Load the hook that adds uploads to Markdown.
+
+    page = Page.create!(body: "![Image](/image.png)")
+    page.body.save!
+    page.body.uploads.attach(
+      io: StringIO.new("image contents"),
+      filename: "image.png",
+      content_type: "image/png"
+    )
+
+    attachment = page.body.uploads.attachments.last
+    blob = attachment.blob
+    service = blob.service
+
+    assert service.exist?(blob.key)
+
+    perform_enqueued_jobs { page.destroy! }
+
+    assert_not ActiveStorage::Attachment.exists?(attachment.id)
+    assert_not ActiveStorage::Blob.exists?(blob.id)
+    assert_not service.exist?(blob.key)
+  end
 end
