diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..4215da7 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -41,3 +41,51 @@ class BookTest < ActiveSupport::TestCase
     assert_equal "", books(:manual).markable
   end
 end
+
+class BookImportTest < ActiveSupport::TestCase
+  setup do
+    @book = Book.create!(title: "Import target")
+  end
+
+  test "imports every valid entry once in manifest order" do
+    manifest = [
+      { title: "First", body: "First body" },
+      { title: "Second", body: "Second body" },
+      { title: "Third", body: "Third body" }
+    ]
+
+    assert @book.import_manifest(manifest)
+    assert_equal %w[First Second Third], @book.leaves.positioned.pluck(:title)
+    assert_equal [ "First body", "Second body", "Third body" ],
+      @book.leaves.positioned.map { |leaf| leaf.leafable.body }
+  end
+
+  test "an invalid entry anywhere rolls back the entire manifest" do
+    valid = { title: "Valid", body: "Body" }
+    invalid = { title: "Invalid", body: "" }
+
+    [ [ invalid, valid ], [ valid, invalid, valid.merge(title: "Also valid") ], [ valid, invalid ] ].each do |manifest|
+      assert_not @book.import_manifest(manifest)
+      assert_empty @book.leaves.reload
+    end
+  end
+
+  test "a title already in the book rejects and rolls back the manifest" do
+    @book.press(Section.new(body: "Existing body"), title: "Existing")
+    original_leaf_ids = @book.leaf_ids
+
+    assert_not @book.import_manifest([
+      { title: "New", body: "New body" },
+      { title: "Existing", body: "Duplicate body" }
+    ])
+    assert_equal original_leaf_ids, @book.leaves.reload.ids
+  end
+
+  test "a duplicate title within a manifest rejects and rolls back the manifest" do
+    assert_not @book.import_manifest([
+      { title: "Repeated", body: "First body" },
+      { title: "Repeated", body: "Second body" }
+    ])
+    assert_empty @book.leaves.reload
+  end
+end
diff --git a/test/models/bulk_import_test.rb b/test/models/bulk_import_test.rb
new file mode 100644
index 0000000..ad6dda6
--- /dev/null
+++ b/test/models/bulk_import_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class BulkImportTest < ActiveSupport::TestCase
+  test "a rejected manifest rolls itself back without rolling back other outer transaction work" do
+    rejected_book = Book.create!(title: "Rejected import")
+    imported_book = Book.create!(title: "Imported import")
+    outside_book = nil
+
+    result = Book.transaction do
+      outside_book = Book.create!(title: "Other outer work")
+      BulkImport.new(
+        rejected_book => [
+          { title: "Would otherwise remain", body: "Body" },
+          { title: "Bad", body: nil }
+        ],
+        imported_book => [
+          { title: "One", body: "First body" },
+          { title: "Two", body: "Second body" }
+        ]
+      ).run
+    end
+
+    assert_equal [ imported_book ], result.imported
+    assert_equal [ rejected_book ], result.rejected
+    assert_empty rejected_book.leaves.reload
+    assert_equal %w[One Two], imported_book.leaves.reload.positioned.pluck(:title)
+    assert Book.exists?(outside_book.id)
+  end
+end
