diff --git a/test/models/user_erasure_test.rb b/test/models/user_erasure_test.rb
new file mode 100644
index 0000000..70b3739
--- /dev/null
+++ b/test/models/user_erasure_test.rb
@@ -0,0 +1,53 @@
+require "test_helper"
+
+class UserErasureTest < ActiveSupport::TestCase
+  test "erases a user and their private data while anonymizing everyone books" do
+    user = users(:kevin)
+    original_email = user.email_address
+    public_book = Book.create!(title: "Public legacy", author: user.name, everyone_access: true, creator: user)
+    private_book = Book.create!(title: "Private legacy", author: user.name, everyone_access: false, creator: user)
+    public_leaf = public_book.press Section.new(body: "public survives"), title: "Public page"
+    private_leaf = private_book.press Section.new(body: "private vanishes"), title: "Private page"
+    Leaf.reindex_all
+    user.sessions.create!(token: SecureRandom.hex, ip_address: "192.0.2.1", user_agent: "Personal Browser", last_active_at: Time.current)
+    ReadingMark.create!(user: user, leaf: public_leaf, last_read_at: Time.current)
+    SignInEvent.create!(email_address: original_email, action: "signed_in", ip_address: "192.0.2.1", user_agent: "Personal Browser")
+
+    user.erase
+
+    assert_nil User.find_by(id: user.id)
+    assert_nil Book.find_by(id: private_book.id)
+    assert_nil Leaf.find_by(id: private_leaf.id)
+    assert_not Leaf.with_search_results_for("private").exists?
+    assert_equal 0, search_index_entries_for(private_leaf.id)
+    assert_equal "Deleted author", public_book.reload.author
+    assert_nil public_book.creator_id
+    assert Leaf.exists?(public_leaf.id)
+    assert Leaf.with_search_results_for("public").exists?
+    assert_not Access.exists?(user_id: user.id)
+    assert_not Session.exists?(user_id: user.id)
+    assert_not ReadingMark.exists?(user_id: user.id)
+    assert_not SignInEvent.exists?(email_address: original_email)
+  end
+
+  test "erases legacy deactivated user sign in events under original address" do
+    user = users(:kevin)
+    original_email = user.email_address
+    user.deactivate
+    SignInEvent.create!(email_address: original_email, action: "signed_in")
+    SignInEvent.create!(email_address: user.email_address, action: "signed_out")
+
+    user.erase
+
+    assert_not SignInEvent.exists?(email_address: original_email)
+    assert_not SignInEvent.exists?(email_address: user.email_address)
+    assert_not User.exists?(user.id)
+  end
+
+  private
+    def search_index_entries_for(leaf_id)
+      Leaf.connection.select_value(
+        Leaf.sanitize_sql_array([ "select count(*) from leaf_search_index where rowid = ?", leaf_id ])
+      )
+    end
+end
