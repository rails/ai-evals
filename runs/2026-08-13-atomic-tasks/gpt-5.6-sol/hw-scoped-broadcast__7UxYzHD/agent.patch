@@ -79,6 +85,27 @@ class PagesControllerTest < ActionDispatch::IntegrationTest
     assert_equal "With even more interesting words.", updated_page.body.content
   end
 
+  test "presence broadcasts do not target a removed collaborator's channel" do
+    leaf = leaves(:welcome_page)
+    removed_access = accesses(:kevin_handbook)
+    removed_stream = Turbo::StreamsChannel.send(:stream_name_from, [ leaf, :being_edited, removed_access ])
+    removed_access.destroy!
+    sign_out
+    sign_in :jason
+
+    clear_enqueued_jobs
+    put leafable_path(leaf), params: { page: { body: "Changed by Jason" } }
+
+    broadcast_streams = enqueued_jobs
+      .select { |job| job[:job] == Turbo::Streams::BroadcastJob }
+      .map { |job| job[:args].first }
+    active_stream = Turbo::StreamsChannel.send(:stream_name_from, [ leaf, :being_edited, users(:jason) ])
+
+    assert_response :no_content
+    assert_not_includes broadcast_streams, removed_stream
+    assert_includes broadcast_streams, active_stream
+  end
+
   private
     def sample_page_leaf(markdown)
       books(:handbook).press Page.new(body: markdown), title: "Sample"
diff --git a/test/models/book/accessable_test.rb b/test/models/book/accessable_test.rb
index 4b080d4..f13416b 100644
--- a/test/models/book/accessable_test.rb
+++ b/test/models/book/accessable_test.rb
@@ -33,4 +33,18 @@ class Book::AccessableTest < ActiveSupport::TestCase
     book.update_access(editors: [ users(:kevin).id ], readers: [])
     assert_equal 1, book.accesses.size
   end
+  test "editing streams use revocable access records for member editors" do
+    book = books(:handbook)
+
+    assert_equal accesses(:kevin_handbook), book.editing_stream_for(user: users(:kevin))
+    assert_nil book.editing_stream_for(user: users(:jz))
+  end
+
+  test "editing streams use users for administrators" do
+    book = books(:handbook)
+
+    assert_equal users(:david), book.editing_stream_for(user: users(:david))
+    assert_includes book.editing_streams, users(:david)
+    assert_not_includes book.editing_streams, accesses(:david_handbook)
+  end
 end
