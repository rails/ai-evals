@@ -0,0 +1,12 @@
+require "test_helper"
+
+class ReportDigestMailerTest < ActionMailer::TestCase
+  test "weekly digest formats each book's date" do
+    book = books(:handbook)
+    book.update_columns(published: true, updated_at: Time.zone.parse("2025-01-02 03:04:05"))
+
+    message = ReportDigestMailer.weekly(users(:kevin))
+
+    assert_includes message.body.encoded, "Handbook, last edited 02 Jan"
+  end
+end
