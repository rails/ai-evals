diff --git a/test/models/user_test.rb b/test/models/user_test.rb
index 26df9ac..3a8a606 100644
--- a/test/models/user_test.rb
+++ b/test/models/user_test.rb
@@ -18,3 +18,55 @@ class UserTest < ActiveSupport::TestCase
     assert_not other_book.accessable?(user: bob)
   end
 end
+
+class UserErasureTest < ActiveSupport::TestCase
+  test "erase removes personal data and private books without leaving stale search entries" do
+    user = users(:kevin)
+    original_email = user.email_address
+    session = user.sessions.create!(user_agent: "Identifying browser", ip_address: "192.0.2.1")
+
+    private_book = Book.create!(title: "Private", author: user.name, everyone_access: false, creator: user)
+    private_book.accesses.create!(user: user, level: :editor)
+    private_leaf = private_book.press Section.new(body: "uniquepersonalphrase"), title: "Private notes"
+    ReadingMark.create!(user: user, leaf: private_leaf, last_read_at: Time.current)
+
+    shared_book = Book.create!(title: "Shared", author: user.name, everyone_access: true, creator: user)
+    shared_leaf = shared_book.press Section.new(body: "still available"), title: "Public notes"
+
+    assert Leaf.search("uniquepersonalphrase").exists?(private_leaf.id)
+    assert SignInEvent.for_address(original_email).exists?
+
+    user.erase
+
+    assert_not User.exists?(user.id)
+    assert_not Session.exists?(session.id)
+    assert_not Access.exists?(user_id: user.id)
+    assert_not ReadingMark.exists?(user_id: user.id)
+    assert_not SignInEvent.for_address(original_email).exists?
+    assert_not SignInEvent.where(email_address: [ original_email, user.email_address ]).exists?
+    assert_not Book.exists?(private_book.id)
+    assert_not Leaf.exists?(private_leaf.id)
+    assert_not Leaf.search("uniquepersonalphrase").exists?
+    assert_nil Leaf.connection.select_value("select rowid from leaf_search_index where rowid = #{private_leaf.id}")
+
+    assert Book.exists?(shared_book.id)
+    assert Leaf.exists?(shared_leaf.id)
+    assert_nil shared_book.reload.creator_id
+    assert_equal "Deleted author", shared_book.author
+  end
+
+  test "erase removes sign in events recorded before legacy deactivation" do
+    user = users(:kevin)
+    original_email = user.email_address
+    deactivated_email = "kevin-deactivated-123e4567-e89b-12d3-a456-426614174000@example.com"
+    SignInEvent.create!(action: :signed_in, email_address: original_email, ip_address: "192.0.2.1", user_agent: "Browser")
+    SignInEvent.create!(action: :signed_in, email_address: deactivated_email, ip_address: "192.0.2.2", user_agent: "Browser")
+    user.update!(active: false, email_address: deactivated_email)
+
+    user.erase
+
+    assert_not User.exists?(user.id)
+    assert_not SignInEvent.for_address(original_email).exists?
+    assert_not SignInEvent.for_address(deactivated_email).exists?
+  end
+end
