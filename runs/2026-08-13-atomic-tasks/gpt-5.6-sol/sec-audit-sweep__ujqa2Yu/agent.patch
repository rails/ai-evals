diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..96f7f0b
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :kevin
+  end
+
+  test "search finds authorized titles and excludes unauthorized titles" do
+    books(:handbook).press(Page.new(body: ""), title: "Visible needle")
+    books(:manual).press(Page.new(body: ""), title: "Secret needle")
+
+    get library_search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search__result", text: /Visible needle/
+    assert_select ".search__result", text: /Secret needle/, count: 0
+  end
+
+  test "signed-out search only finds titles in published books" do
+    books(:handbook).update!(published: true)
+    books(:handbook).press(Page.new(body: ""), title: "Public needle")
+    books(:manual).press(Page.new(body: ""), title: "Private needle")
+    sign_out
+
+    get library_search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select ".search__result", text: /Public needle/
+    assert_select ".search__result", text: /Private needle/, count: 0
+  end
+
+  test "search treats apostrophes as data" do
+    books(:handbook).press(Page.new(body: ""), title: "Reader's guide")
+
+    get library_search_path, params: { q: "Reader's" }
+
+    assert_response :success
+    assert_select ".search__result", text: /Reader's guide/
+  end
+
+  test "search treats percent signs as literal data" do
+    books(:handbook).press(Page.new(body: ""), title: "Save 50% off")
+    books(:handbook).press(Page.new(body: ""), title: "Save full price")
+
+    get library_search_path, params: { q: "%" }
+
+    assert_response :success
+    assert_select ".search__result", text: /Save 50% off/
+    assert_select ".search__result", text: /Save full price/, count: 0
+  end
+
+  test "search treats the SQL escape character as literal data" do
+    books(:handbook).press(Page.new(body: ""), title: "Bang! title")
+    books(:handbook).press(Page.new(body: ""), title: "Bang title")
+
+    get library_search_path, params: { q: "!" }
+
+    assert_response :success
+    assert_select ".search__result", text: /Bang! title/
+    assert_select ".search__result", text: /Bang title/, count: 0
+  end
+
+  test "search treats underscores as literal data" do
+    books(:handbook).press(Page.new(body: ""), title: "under_score")
+    books(:handbook).press(Page.new(body: ""), title: "underXscore")
+
+    get library_search_path, params: { q: "_" }
+
+    assert_response :success
+    assert_select ".search__result", text: /under_score/
+    assert_select ".search__result", text: /underXscore/, count: 0
+  end
+end
