diff --git a/app/models/book/accessable.rb b/app/models/book/accessable.rb
index aa3dcf1..eecede9 100644
--- a/app/models/book/accessable.rb
+++ b/app/models/book/accessable.rb
@@ -28,6 +28,15 @@ module Book::Accessable
     access_for(user: user)&.editor? || user&.administrator?
   end
 
+  def editors
+    active_users = User.active
+    editors = active_users.where(id: accesses.editor.select(:user_id))
+    administrators = active_users.where(role: :administrator)
+    administrators = administrators.where(id: accesses.select(:user_id)) unless published?
+
+    editors.or(administrators)
+  end
+
   def access_for(user: Current.user)
     accesses.find_by(user: user)
   end
