@@ -1,4 +1,8 @@
 class ApplicationJob < ActiveJob::Base
+  # Records handed to a worker from an open transaction may not exist there yet,
+  # and may never exist if that transaction rolls back.
+  self.enqueue_after_transaction_commit = true
