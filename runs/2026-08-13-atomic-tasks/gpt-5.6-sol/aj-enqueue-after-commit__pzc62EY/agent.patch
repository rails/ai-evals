diff --git a/app/jobs/books/import_failure_job.rb b/app/jobs/books/import_failure_job.rb
index 0bfd478..c918dd4 100644
--- a/app/jobs/books/import_failure_job.rb
+++ b/app/jobs/books/import_failure_job.rb
@@ -1,4 +1,8 @@
 class Books::ImportFailureJob < ApplicationJob
+  # This job is enqueued while the failed import transaction is being unwound,
+  # so it must not be discarded with the work it reports on.
+  self.enqueue_after_transaction_commit = false
+
   def perform(user_id, message)
     Rails.cache.write("import_failure/#{user_id}", message)
   end
diff --git a/script/reproduce_transactional_job_handoff.rb b/script/reproduce_transactional_job_handoff.rb
new file mode 100644
index 0000000..b10cdf9
--- /dev/null
+++ b/script/reproduce_transactional_job_handoff.rb
@@ -0,0 +1,37 @@
+# Run with: bin/rails runner script/reproduce_transactional_job_handoff.rb
+
+ActiveJob::Base.queue_adapter = :test
+adapter = ActiveJob::Base.queue_adapter
+book = Book.create!(title: "Transactional job handoff reproduction")
+
+assert = ->(description, condition) do
+  raise "FAILED: #{description}" unless condition
+  puts "PASS: #{description}"
+end
+
+begin
+  adapter.enqueued_jobs.clear
+  Book.transaction do
+    book.apply_edit(title: "Committed edit")
+    assert.call("edit work is not handed off while the outer transaction is open", adapter.enqueued_jobs.empty?)
+  end
+  assert.call("edit work is handed off after the outer transaction commits",
+    adapter.enqueued_jobs.map { |job| job[:job] } == [ Book::SearchIndexJob ])
+
+  adapter.enqueued_jobs.clear
+  Book.transaction do
+    book.apply_edit(title: "Abandoned edit")
+    raise ActiveRecord::Rollback
+  end
+  assert.call("edit work is discarded when the outer transaction rolls back", adapter.enqueued_jobs.empty?)
+
+  adapter.enqueued_jobs.clear
+  Book.transaction do
+    Books::ImportFailureJob.perform_later(123, "batch failed")
+    raise ActiveRecord::Rollback
+  end
+  assert.call("import failure notification survives the batch rollback",
+    adapter.enqueued_jobs.map { |job| job[:job] } == [ Books::ImportFailureJob ])
+ensure
+  book.destroy!
+end
diff --git a/test/jobs/transactional_handoff_test.rb b/test/jobs/transactional_handoff_test.rb
new file mode 100644
index 0000000..011cd6c
--- /dev/null
+++ b/test/jobs/transactional_handoff_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class TransactionalHandoffTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  # These tests need to observe a real outermost commit and rollback.
+  self.use_transactional_tests = false
+
+  setup do
+    clear_enqueued_jobs
+  end
+
+  test "book edit jobs wait for the outer transaction to commit" do
+    assert Book::SearchIndexJob.enqueue_after_transaction_commit
+    assert Book::CoverProcessingJob.enqueue_after_transaction_commit
+
+    Book.transaction do
+      Book::SearchIndexJob.perform_later(books(:manual))
+      Book::CoverProcessingJob.perform_later(books(:manual))
+
+      assert_no_enqueued_jobs
+    end
+
+    assert_enqueued_jobs 2
+  end
+
+  test "book edit jobs are discarded with a rolled back outer transaction" do
+    Book.transaction do
+      Book::SearchIndexJob.perform_later(books(:manual))
+      Book::CoverProcessingJob.perform_later(books(:manual))
+      raise ActiveRecord::Rollback
+    end
+
+    assert_no_enqueued_jobs
+  end
+
+  test "import failure reporting survives the failed transaction" do
+    Book.transaction do
+      Books::ImportFailureJob.perform_later(users(:kevin).id, "Import failed")
+
+      assert_enqueued_with(job: Books::ImportFailureJob)
+      raise ActiveRecord::Rollback
+    end
+
+    assert_enqueued_with(job: Books::ImportFailureJob)
+  end
+end
