@@ -0,0 +1,31 @@
+require "test_helper"
+require "active_job/continuation/test_helper"
+
+class TitleCleanupJobTest < ActiveJob::TestCase
+  include ActiveJob::Continuation::TestHelper
+
+  test "resumes from the first uncleaned leaf after an interruption" do
+    leaves = Leaf.order(:id).to_a
+    titles = [
+      '"First"',
+      '"Second"',
+      '""Quoted" opening"',
+      '"Last"'
+    ]
+    leaves.zip(titles).each { |leaf, title| leaf.update!(title: title) }
+
+    TitleCleanupJob.perform_later
+
+    interrupt_job_during_step(
+      TitleCleanupJob,
+      :clean_titles,
+      cursor: leaves.third.id.next
+    ) { perform_enqueued_jobs }
+
+    assert_equal [ "First", "Second", '"Quoted" opening', '"Last"' ], leaves.map { |leaf| leaf.reload.title }
+
+    perform_enqueued_jobs
+
+    assert_equal [ "First", "Second", '"Quoted" opening', "Last" ], leaves.map { |leaf| leaf.reload.title }
+  end
+end
