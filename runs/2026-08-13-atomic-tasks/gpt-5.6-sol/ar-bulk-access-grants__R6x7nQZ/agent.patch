-        Book::AccessNotificationJob.perform_later(access)
-        accesses << access
-      rescue ActiveRecord::RecordNotUnique
-        duplicate_index = index
-        raise ActiveRecord::Rollback
+        user_id = user_id_type.cast(grant[:user_id])
+        level = grant[:level].to_s
+
+        if !Access.levels.key?(level) || existing_user_ids.include?(user_id) || seen_user_ids.include?(user_id)
+          return [ [], index ]
+        end
+
+        seen_user_ids << user_id
+        rows << { user_id: user_id, level: level }
       end
