+        inserted_accesses(rows)
+      end
+    rescue ActiveRecord::RecordNotUnique
+      nil
+    end
+
+    def enqueue_notifications(accesses)
+      jobs = accesses.map { |access| Book::AccessNotificationJob.new(access) }
+      ActiveJob.perform_all_later(jobs)
+    end
+
+    def first_existing_index
+      existing_user_ids = @book.accesses.where(user_id: @grants.pluck(:user_id)).pluck(:user_id).to_set
+      @grants.index { |grant| existing_user_ids.include?(Access.type_for_attribute("user_id").cast(grant[:user_id])) }
