+  test "show serves a preprocessed picture without processing it again" do
+    picture = pictures(:reading)
+    transformations = 0
+    subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { transformations += 1 }
+
+    perform_enqueued_jobs do
+      picture.image.attach io: file_fixture("white-rabbit.webp").open,
+        filename: "white-rabbit.webp", content_type: "image/webp"
+    end
+
+    derived_image = picture.image.variant(:large).image
+    expected_bytes = derived_image.download
+    assert_equal 1, transformations
+
+    assert_no_changes -> { transformations } do
+      get book_slug_path(books(:handbook))
+      assert_response :success
+
+      image_path = css_select(".toc__leaf--picture .toc__thumbnail > img").first["src"]
+      assert_includes image_path, "/blobs/redirect/"
+      assert_not_includes image_path, "/representations/"
+
+      get image_path
+      follow_redirect!
+      assert_response :success
+      assert_equal expected_bytes, response.body
+    end
+
+    assert_equal 1, picture.image.blob.variant_records.count
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+  end
 end
