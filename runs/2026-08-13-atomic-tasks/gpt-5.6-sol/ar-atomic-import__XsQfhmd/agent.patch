diff --git a/test/models/book/import_test.rb b/test/models/book/import_test.rb
new file mode 100644
index 0000000..720c4d8
--- /dev/null
+++ b/test/models/book/import_test.rb
@@ -0,0 +1,72 @@
+require "test_helper"
+
+class Book::ImportTest < ActiveSupport::TestCase
+  setup do
+    @book = books(:manual)
+    @valid_manifest = [
+      { title: "First", body: "First body" },
+      { title: "Second", body: "Second body" },
+      { title: "Third", body: "Third body" }
+    ]
+  end
+
+  test "imports every entry once as sections in manifest order" do
+    assert @book.import_manifest(@valid_manifest)
+
+    leaves = @book.leaves.positioned
+    assert_equal %w[First Second Third], leaves.pluck(:title)
+    assert_equal [ "First body", "Second body", "Third body" ], leaves.map { it.section.body }
+    assert leaves.all?(&:section?)
+  end
+
+  test "an invalid entry at any position imports nothing" do
+    @valid_manifest.each_index do |index|
+      manifest = @valid_manifest.map(&:dup)
+      manifest[index][:body] = ""
+
+      assert_not @book.import_manifest(manifest)
+      assert_empty @book.leaves.reload
+    end
+  end
+
+  test "duplicate titles within a manifest reject the whole manifest" do
+    manifest = [
+      { title: "Repeated", body: "First body" },
+      { title: "Repeated", body: "Second body" }
+    ]
+
+    assert_not @book.import_manifest(manifest)
+    assert_empty @book.leaves.reload
+  end
+
+  test "a malformed entry rejects the whole manifest" do
+    assert_not @book.import_manifest([ @valid_manifest.first, "not an entry" ])
+    assert_empty @book.leaves.reload
+  end
+
+
+  test "a duplicate title rejects the whole manifest without raising" do
+    manifest = [
+      { title: "New title", body: "New body" },
+      { title: leaves(:welcome_section).title, body: "Duplicate body" }
+    ]
+
+    assert_not books(:handbook).import_manifest(manifest)
+    assert_not books(:handbook).leaves.exists?(title: "New title")
+  end
+
+  test "a rejected import rolls back only its work inside an outer transaction" do
+    Book.transaction do
+      other_book = Book.create!(title: "Other transaction work")
+
+      assert_not @book.import_manifest([
+        { title: "Before rejection", body: "Body" },
+        { title: "Rejected", body: nil }
+      ])
+      assert other_book.persisted?
+    end
+
+    assert_empty @book.leaves.reload
+    assert Book.exists?(title: "Other transaction work")
+  end
+end
diff --git a/test/models/bulk_import_test.rb b/test/models/bulk_import_test.rb
new file mode 100644
index 0000000..4a11c39
--- /dev/null
+++ b/test/models/bulk_import_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class BulkImportTest < ActiveSupport::TestCase
+  test "a rejected manifest leaves nothing behind without rolling back other manifests" do
+    accepted_book = books(:handbook)
+    rejected_book = books(:manual)
+    original_accepted_titles = accepted_book.leaves.positioned.pluck(:title)
+
+    result = BulkImport.new(
+      accepted_book => [
+        { title: "Nightly first", body: "First body" },
+        { title: "Nightly second", body: "Second body" }
+      ],
+      rejected_book => [
+        { title: "Before bad entry", body: "Body" },
+        { title: "Bad entry", body: "" }
+      ]
+    ).run
+
+    assert_equal [ accepted_book ], result.imported
+    assert_equal [ rejected_book ], result.rejected
+    assert_equal original_accepted_titles + [ "Nightly first", "Nightly second" ], accepted_book.leaves.reload.positioned.pluck(:title)
+    assert_empty rejected_book.leaves.reload
+  end
+end
