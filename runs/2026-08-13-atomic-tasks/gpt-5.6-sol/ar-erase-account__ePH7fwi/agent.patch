+    private_book = create_book_with_page(user, title: "Private", everyone_access: false, content: "private secretphrase")
+    public_book.cover.attach(io: StringIO.new("public cover"), filename: "public.txt", content_type: "text/plain")
+    private_book.cover.attach(io: StringIO.new("private cover"), filename: "private.txt", content_type: "text/plain")
