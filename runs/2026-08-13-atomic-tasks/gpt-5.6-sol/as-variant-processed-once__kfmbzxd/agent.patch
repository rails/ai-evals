diff --git a/script/reproduce_duplicate_picture.rb b/script/reproduce_duplicate_picture.rb
new file mode 100644
index 0000000..e22ee5d
--- /dev/null
+++ b/script/reproduce_duplicate_picture.rb
@@ -0,0 +1,56 @@
+# Run with: RAILS_ENV=test bin/rails runner script/reproduce_duplicate_picture.rb
+require "active_job/test_helper"
+require "action_dispatch/testing/integration"
+
+include ActiveJob::TestHelper
+
+picture = nil
+subscriber = nil
+begin
+  picture = Picture.create!
+  picture.image.attach(
+    io: Rails.root.join("test/fixtures/files/reading.webp").open,
+    filename: "reading.webp",
+    content_type: "image/webp"
+  )
+
+  transforms = 0
+  subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { transforms += 1 }
+  2.times { perform_enqueued_jobs }
+  variant = picture.reload.large_image
+  before_bytes = variant.download
+  before_blobs = ActiveStorage::Blob.count
+  before_records = ActiveStorage::VariantRecord.count
+  before_files = Dir.glob(Rails.root.join("tmp/storage/**/*")).count { |path| File.file?(path) }
+
+  puts({ prepared: { blobs: before_blobs, variant_records: before_records, files: before_files, transforms: transforms } }.inspect)
+  session = ActionDispatch::Integration::Session.new(Rails.application)
+  session.get Rails.application.routes.url_helpers.rails_representation_path(variant, only_path: true)
+  raise "representation redirect failed: #{session.response.status}" unless session.response.redirect?
+  session.get URI(session.response.location).request_uri
+  raise "variant fetch failed: #{session.response.status}" unless session.response.successful?
+
+  after = {
+    transforms: transforms,
+    blobs: ActiveStorage::Blob.count,
+    variant_records: ActiveStorage::VariantRecord.count,
+    files: Dir.glob(Rails.root.join("tmp/storage/**/*")).count { |path| File.file?(path) },
+    bytes_unchanged: session.response.body.b == before_bytes
+  }
+  expected = {
+    transforms: 1,
+    blobs: before_blobs,
+    variant_records: before_records,
+    files: before_files,
+    bytes_unchanged: true
+  }
+  raise "duplicate picture derived: #{after.inspect}" unless after == expected
+
+  puts({ before: { blobs: before_blobs, variant_records: before_records, files: before_files }, after: after }.inspect)
+ensure
+  ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+  clear_enqueued_jobs
+  picture&.image&.purge
+  picture&.destroy!
+  clear_enqueued_jobs
+end
diff --git a/test/models/picture_test.rb b/test/models/picture_test.rb
index 18a2a56..8ec03d1 100644
--- a/test/models/picture_test.rb
+++ b/test/models/picture_test.rb
@@ -24,3 +24,49 @@ class PictureTest < ActiveSupport::TestCase
     assert_equal picture.image, picture.large_image
   end
 end
+
+class PictureVariantTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  test "large image has one derived copy after background processing and fetching" do
+    picture = Picture.create!
+    transforms = 0
+    subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { transforms += 1 }
+
+    perform_enqueued_jobs do
+      picture.image.attach(
+        io: file_fixture("reading.webp").open,
+        filename: "reading.webp",
+        content_type: "image/webp"
+      )
+    end
+
+    blob = picture.image.blob
+    variant = picture.reload.large_image
+    derived_bytes = variant.download
+    assert_equal 1, transforms
+    assert_equal 1, blob.variant_records.count
+    assert_equal 1, blob.variant_records.joins(:image_blob).count
+
+    transforms = 0
+    request_variation = ActiveStorage::Variation.decode(variant.variation.key)
+    fetched_bytes = blob.representation(request_variation).processed.download
+
+    assert_equal 0, transforms
+    assert_equal 1, blob.variant_records.count
+    assert_equal 1, blob.variant_records.joins(:image_blob).count
+    assert_equal derived_bytes, fetched_bytes
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+    picture&.destroy!
+  end
+
+  test "large variant keeps its identity through job and URL serialization" do
+    declared = Picture.attachment_reflections["image"].named_variants[:large].transformations
+    job = ActiveJob::Arguments.deserialize(ActiveJob::Arguments.serialize([ declared ])).first
+    url = ActiveStorage::Variation.decode(ActiveStorage::Variation.encode(declared)).transformations
+
+    digests = [ declared, job, url ].map { |transformations| ActiveStorage::Variation.new(transformations).digest }
+    assert_equal 1, digests.uniq.size
+  end
+end
