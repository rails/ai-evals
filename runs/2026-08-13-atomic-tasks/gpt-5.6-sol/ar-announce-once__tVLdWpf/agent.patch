diff --git a/script/reproduce_launch_announcements.rb b/script/reproduce_launch_announcements.rb
new file mode 100644
index 0000000..ffbf0f3
--- /dev/null
+++ b/script/reproduce_launch_announcements.rb
@@ -0,0 +1,36 @@
+# Run with: RAILS_ENV=test bin/rails runner script/reproduce_launch_announcements.rb
+ActiveJob::Base.queue_adapter = :test
+
+book = Book.create!(title: "Announcement regression #{SecureRandom.hex(4)}")
+queue = ActiveJob::Base.queue_adapter
+enqueued_count = -> { queue.enqueued_jobs.count { |job| job[:job] == AnnouncePublicationJob } }
+assert_change = ->(label, amount, &block) do
+  before = enqueued_count.call
+  block.call
+  actual = enqueued_count.call - before
+  raise "#{label}: expected #{amount} announcement(s), got #{actual}" unless actual == amount
+  puts "PASS: #{label}"
+end
+
+assert_change.call("publish while adding a page", 1) do
+  book.transaction do
+    book.update!(published: true)
+    book.press(Page.new(body: ""), title: "Added while publishing")
+  end
+end
+
+assert_change.call("save an already-live book", 0) { book.update!(subtitle: "Still live") }
+assert_change.call("take a live book down", 0) { book.update!(published: false) }
+
+assert_change.call("roll back publication", 0) do
+  begin
+    book.transaction do
+      book.update!(published: true)
+      raise ActiveRecord::Rollback
+    end
+  ensure
+    raise "rollback left the book live" if book.reload.published?
+  end
+end
+
+book.destroy!
diff --git a/test/models/book/announceable_test.rb b/test/models/book/announceable_test.rb
new file mode 100644
index 0000000..d5b3387
--- /dev/null
+++ b/test/models/book/announceable_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class Book::AnnounceableTest < ActiveSupport::TestCase
+  include ActiveJob::TestHelper
+
+  self.use_transactional_tests = false
+
+  setup do
+    @book = books(:manual)
+    clear_enqueued_jobs
+  end
+
+  teardown do
+    clear_enqueued_jobs
+  end
+
+  test "announces when publishing while making other book changes" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.press Page.new(body: ""), title: "A new page"
+      end
+    end
+
+    assert_predicate @book.reload, :published?
+  end
+
+  test "announces a publication only once" do
+    assert_enqueued_jobs 1, only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.update! subtitle: "Saved again"
+        @book.touch
+      end
+    end
+  end
+
+  test "does not announce an already published book saved again" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! subtitle: "Still live"
+    end
+  end
+
+  test "does not announce when unpublishing" do
+    @book.update! published: true
+    clear_enqueued_jobs
+
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! published: false
+    end
+  end
+
+  test "does not announce a save that leaves a book unpublished" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.update! subtitle: "Still a draft"
+    end
+  end
+
+  test "does not announce when a book ends the transaction unpublished" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        @book.update! published: false
+      end
+    end
+
+    assert_not_predicate @book.reload, :published?
+  end
+
+  test "does not announce a rolled back publication" do
+    assert_no_enqueued_jobs only: AnnouncePublicationJob do
+      @book.transaction do
+        @book.update! published: true
+        raise ActiveRecord::Rollback
+      end
+    end
+
+    assert_not_predicate @book.reload, :published?
+  end
+end
