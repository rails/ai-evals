diff --git a/test/controllers/security_regressions_test.rb b/test/controllers/security_regressions_test.rb
new file mode 100644
index 0000000..cd818be
--- /dev/null
+++ b/test/controllers/security_regressions_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class SecurityRegressionsTest < ActionDispatch::IntegrationTest
+  test "a member cannot grant themselves a role through their profile" do
+    sign_in :kevin
+
+    put user_profile_url(users(:kevin)), params: {
+      user: { name: "Still Kevin", email_address: "still-kevin@example.com", role: "administrator" }
+    }
+
+    assert_redirected_to users_url
+    assert_equal "Still Kevin", users(:kevin).reload.name
+    assert_equal "still-kevin@example.com", users(:kevin).email_address
+    assert users(:kevin).member?
+  end
+
+  test "a reader cannot delete a book" do
+    sign_in :jz
+
+    assert_no_difference -> { Book.count } do
+      delete book_url(books(:handbook))
+    end
+
+    assert_response :forbidden
+  end
+
+  test "an editor can still delete a book" do
+    sign_in :david
+
+    assert_difference -> { Book.count }, -1 do
+      delete book_url(books(:handbook))
+    end
+
+    assert_redirected_to root_url
+  end
+
+  test "library search treats apostrophes and SQL syntax as data and respects access" do
+    visible = books(:handbook).press(Page.new, title: "Reader's visible guide")
+    hidden_book = Book.create!(title: "Hidden", everyone_access: false)
+    hidden = hidden_book.press(Page.new, title: "Reader's hidden guide")
+    sign_in :jz
+
+    get library_search_url, params: { q: "Reader's" }
+
+    assert_response :success
+    assert_select "a[href='#{leafable_slug_path(visible)}']"
+    assert_select "a[href='#{leafable_slug_path(hidden)}']", count: 0
+
+    get library_search_url, params: { q: "' OR 1=1 --" }
+
+    assert_response :success
+    assert_select ".search__result", count: 0
+  end
+
+  test "signed out library search only returns published books" do
+  books(:handbook).update!(published: true)
+  public_leaf = books(:handbook).press(Page.new, title: "Publicly searchable")
+  private_book = Book.create!(title: "Private", everyone_access: false)
+  private_leaf = private_book.press(Page.new, title: "Privately searchable")
+  sign_out
+
+  get library_search_url, params: { q: "searchable" }
+
+  assert_response :success
+  assert_select "a[href='#{leafable_slug_path(public_leaf)}']"
+  assert_select "a[href='#{leafable_slug_path(private_leaf)}']", count: 0
+end
+
+test "library search treats percent and underscore as literal characters" do
+    percent = books(:handbook).press(Page.new, title: "Save 50% off")
+    underscore = books(:handbook).press(Page.new, title: "under_score")
+    books(:handbook).press(Page.new, title: "ordinary title")
+    sign_in :jz
+
+    get library_search_url, params: { q: "%" }
+    assert_response :success
+    assert_select "a[href='#{leafable_slug_path(percent)}']"
+    assert_select ".search__result", count: 1
+
+    get library_search_url, params: { q: "_" }
+    assert_response :success
+    assert_select "a[href='#{leafable_slug_path(underscore)}']"
+    assert_select ".search__result", count: 1
+  end
+
+  test "a leaf id must belong to the readable book id in the URL" do
+    private_book = Book.create!(title: "Private", everyone_access: false)
+    private_leaf = private_book.press(Page.new(body: "Secret body"), title: "Secret page")
+    sign_in :jz
+
+    get slugged_leafable_url(books(:handbook), books(:handbook).slug, private_leaf, private_leaf.slug)
+
+    assert_response :not_found
+  end
+
+  test "a public leaf remains readable while signed out" do
+    books(:handbook).update!(published: true)
+    sign_out
+
+    get leafable_slug_url(leaves(:welcome_page))
+
+    assert_response :success
+  end
+end
