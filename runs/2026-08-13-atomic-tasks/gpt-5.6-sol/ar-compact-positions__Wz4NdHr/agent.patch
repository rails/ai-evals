diff --git a/test/models/book_test.rb b/test/models/book_test.rb
index be0e37d..3dc9488 100644
--- a/test/models/book_test.rb
+++ b/test/models/book_test.rb
@@ -1,6 +1,39 @@
 require "test_helper"
 
 class BookTest < ActiveSupport::TestCase
+  test "compacting positions preserves order and creates dense scores" do
+    book = books(:handbook)
+    arranged_leaves = leaves(:summary_page, :welcome_page, :reading_picture, :welcome_section)
+    arranged_leaves.each_with_index do |leaf, index|
+      leaf.update_column(:position_score, (index + 1) * 10)
+    end
+
+    book.compact_positions!
+
+    assert_equal arranged_leaves, book.leaves.positioned
+    assert_equal [ 1, 2, 3, 4 ], book.leaves.positioned.pluck(:position_score)
+  end
+
+  test "compacting positions preserves the position of trashed leaves" do
+    book = books(:handbook)
+    arranged_leaves = leaves(:summary_page, :welcome_page, :reading_picture, :welcome_section)
+    arranged_leaves.each_with_index do |leaf, index|
+      leaf.update_column(:position_score, (index + 1) * 10)
+    end
+    leaves(:welcome_page).trashed!
+
+    book.compact_positions!
+    leaves(:welcome_page).active!
+
+    assert_equal arranged_leaves, book.leaves.positioned
+  end
+
+  test "live leaf count excludes trashed leaves" do
+    leaves(:summary_page).trashed!
+
+    assert_equal 3, books(:handbook).live_leaf_count
+  end
+
   test "slug is generated from title" do
     book = Book.create!(title: "Hello, World!")
     assert_equal "hello-world", book.slug
