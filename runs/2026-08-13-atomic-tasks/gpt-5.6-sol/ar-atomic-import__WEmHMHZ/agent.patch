diff --git a/test/models/book/import_test.rb b/test/models/book/import_test.rb
new file mode 100644
index 0000000..1977ddf
--- /dev/null
+++ b/test/models/book/import_test.rb
@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Book::ImportTest < ActiveSupport::TestCase
+  test "a valid manifest imports every section once in manifest order" do
+    book = books(:manual)
+    entries = [
+      { title: "First", body: "First body" },
+      { title: "Second", body: "Second body" },
+      { title: "Third", body: "Third body" }
+    ]
+
+    assert book.import_manifest(entries)
+    assert_equal entries.pluck(:title), book.leaves.positioned.pluck(:title)
+    assert_equal entries.pluck(:body), book.leaves.positioned.map { it.leafable.body }
+  end
+
+  test "an invalid entry rolls back the entire manifest wherever it occurs" do
+    valid = { title: "Valid", body: "Valid body" }
+    invalid = { title: "Invalid", body: "" }
+
+    [ [ invalid, valid ], [ valid, invalid, valid ], [ valid, invalid ] ].each do |entries|
+      book = books(:manual)
+      leaf_count = Leaf.count
+      section_count = Section.count
+
+      assert_not book.import_manifest(entries)
+      assert_equal 0, book.leaves.reload.count
+      assert_equal leaf_count, Leaf.count
+      assert_equal section_count, Section.count
+    end
+  end
+
+  test "a duplicate title rejects and rolls back the manifest without raising" do
+    book = books(:handbook)
+    existing_titles = book.leaves.positioned.pluck(:title)
+    entries = [
+      { title: "New section", body: "New body" },
+      { title: existing_titles.first, body: "Duplicate body" }
+    ]
+
+    assert_not book.import_manifest(entries)
+    assert_equal existing_titles, book.leaves.reload.positioned.pluck(:title)
+  end
+
+  test "duplicate titles within a manifest reject the entire manifest" do
+  book = books(:manual)
+  entries = [
+    { title: "Repeated", body: "First body" },
+    { title: "Repeated", body: "Second body" }
+  ]
+
+  assert_not book.import_manifest(entries)
+  assert_equal 0, book.leaves.reload.count
+end
+
+test "a rejected manifest rolls back to its savepoint without undoing outer work" do
+    book = books(:manual)
+
+    Book.transaction do
+      book.update!(subtitle: "Nightly metadata")
+      assert_not book.import_manifest([
+        { title: "Before rejection", body: "Body" },
+        { title: "Rejected", body: nil }
+      ])
+      assert_equal 0, book.leaves.reload.count
+    end
+
+    assert_equal "Nightly metadata", book.reload.subtitle
+    assert_equal 0, book.leaves.count
+  end
+end
diff --git a/test/models/bulk_import_test.rb b/test/models/bulk_import_test.rb
new file mode 100644
index 0000000..a3929ee
--- /dev/null
+++ b/test/models/bulk_import_test.rb
@@ -0,0 +1,25 @@
+require "test_helper"
+
+class BulkImportTest < ActiveSupport::TestCase
+  test "a rejected manifest leaves no partial work while other manifests survive" do
+    rejected_book = books(:handbook)
+    imported_book = books(:manual)
+    existing_titles = rejected_book.leaves.positioned.pluck(:title)
+
+    result = BulkImport.new(
+      rejected_book => [
+        { title: "Rolled back", body: "Temporary body" },
+        { title: "Invalid", body: "" }
+      ],
+      imported_book => [
+        { title: "Kept first", body: "First body" },
+        { title: "Kept second", body: "Second body" }
+      ]
+    ).run
+
+    assert_equal [ imported_book ], result.imported
+    assert_equal [ rejected_book ], result.rejected
+    assert_equal existing_titles, rejected_book.leaves.reload.positioned.pluck(:title)
+    assert_equal [ "Kept first", "Kept second" ], imported_book.leaves.reload.positioned.pluck(:title)
+  end
+end
