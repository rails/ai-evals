   def large_image
diff --git a/test/controllers/leafables_controller_test.rb b/test/controllers/leafables_controller_test.rb
index d9e383c..ba4fa9e 100644
--- a/test/controllers/leafables_controller_test.rb
+++ b/test/controllers/leafables_controller_test.rb
@@ -117,4 +117,36 @@ class LeafablesControllerTest < ActionDispatch::IntegrationTest
 
     assert_response :forbidden
   end
+
+  test "a preprocessed picture is served without creating another derived image" do
+    picture = pictures(:reading)
+    transformations = 0
+    subscriber = ActiveSupport::Notifications.subscribe("transform.active_storage") { transformations += 1 }
+
+    perform_enqueued_jobs do
+      picture.image.attach io: file_fixture("reading.webp").open,
+        filename: "uploaded.webp", content_type: "image/webp"
+    end
+
+    blob = picture.reload.image.blob
+    variant = picture.large_image
+    derived_bytes = variant.download
+
+    assert_equal 1, transformations
+    assert_equal 1, blob.variant_records.count
+    assert blob.variant_records.first.image.attached?
+
+    transformations = 0
+    get leafable_slug_path(leaves(:reading_picture))
+    source = css_select("figure img").first["src"]
+    get source
+    follow_redirect!
+
+    assert_response :success
+    assert_equal derived_bytes, response.body.b
+    assert_equal 0, transformations
+    assert_equal 1, blob.variant_records.reload.count
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber) if subscriber
+  end
 end
