@@ -0,0 +1,38 @@
+require "test_helper"
+
+class RaisedExceptionsIsolationTest < ActionDispatch::IntegrationTest
+  test "raising exceptions is isolated from simultaneous requests" do
+    raising_block_started = Queue.new
+    normal_request_finished = Queue.new
+
+    raising_thread = Thread.new do
+      with_raised_exceptions do
+        raising_block_started << true
+        normal_request_finished.pop
+
+        assert_raises(ActiveRecord::RecordNotFound) do
+          get book_slug_path(books(:manual))
+        end
+      end
+    end
+
+    normal_thread = Thread.new do
+      raising_block_started.pop
+      get book_slug_path(books(:manual))
+      assert_response :not_found
+    ensure
+      normal_request_finished << true
+    end
+
+    [ raising_thread, normal_thread ].each(&:value)
+  end
+
+  test "raising exceptions is restored after the block raises" do
+    assert_raises(RuntimeError) do
+      with_raised_exceptions { raise "from the test" }
+    end
+
+    get book_slug_path(books(:manual))
+    assert_response :not_found
+  end
+end
