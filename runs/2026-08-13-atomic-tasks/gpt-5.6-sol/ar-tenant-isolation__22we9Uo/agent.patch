diff --git a/test/controllers/tenant_isolation_test.rb b/test/controllers/tenant_isolation_test.rb
new file mode 100644
index 0000000..de90324
--- /dev/null
+++ b/test/controllers/tenant_isolation_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class TenantIsolationTest < ActionDispatch::IntegrationTest
+  setup do
+    @tenant_a = Tenant.create!(name: "Customer A")
+    @tenant_b = Tenant.create!(name: "Customer B")
+    @user_a = users(:kevin)
+    @user_b = users(:jason)
+    @user_a.update!(tenant: @tenant_a)
+    @user_b.update!(tenant: @tenant_b)
+    books(:handbook).update!(tenant: @tenant_a)
+    books(:manual).update!(tenant: @tenant_b)
+    Access.create!(user: @user_a, book: books(:manual), level: :reader)
+    sign_in @user_a
+  end
+
+  test "foreign books are absent from a signed-in user's library even when published and shared" do
+    books(:manual).update!(published: true)
+
+    get root_url
+
+    assert_response :success
+    assert_select "h2", text: "Handbook"
+    assert_select "h2", text: "Manual", count: 0
+  end
+
+  test "foreign books and their pages return not found without signing the user out" do
+    books(:manual).update!(published: true)
+    foreign_leaf = books(:manual).press(Page.new(body: "Secret"), title: "Secret page")
+
+    get book_slug_url(books(:manual))
+    assert_response :not_found
+    assert cookies[:session_token].present?
+
+    get leafable_slug_url(foreign_leaf)
+    assert_response :not_found
+    assert cookies[:session_token].present?
+  end
+
+  test "foreign page histories return not found despite an access row" do
+    foreign_leaf = books(:manual).press(Page.new(body: "Old secret"), title: "Secret page")
+    foreign_leaf.edit leafable_params: { body: "New secret" }
+
+    get page_edit_url(foreign_leaf, foreign_leaf.edits.last)
+
+    assert_response :not_found
+    assert cookies[:session_token].present?
+  end
+
+  test "signed-out visitors can see published books across tenants" do
+    books(:manual).update!(published: true)
+    sign_out
+
+    get book_slug_url(books(:manual))
+
+    assert_response :success
+  end
+
+  test "sharing with everyone only grants access within the book's tenant" do
+    books(:handbook).update_access(editors: [ @user_a.id ], readers: [])
+
+    assert books(:handbook).accessable?(user: @user_a)
+    assert_not books(:handbook).accessable?(user: @user_b)
+  end
+
+  test "new tenant users only receive everyone access in their tenant" do
+  user = User.create!(name: "New A", email_address: "new-a@example.com", password: "secret123456", role: :member, tenant: @tenant_a)
+
+  assert books(:handbook).accessable?(user: user)
+  assert_not books(:manual).accessable?(user: user)
+end
+
+test "users index still lists users from every tenant" do
+  get users_url
+
+  assert_response :success
+  assert_select "body", text: /Kevin/
+  assert_select "body", text: /Jason/
+end
+
+test "new books belong to their creator's tenant" do
+    post books_url, params: { book: { title: "Tenant book", everyone_access: false } }
+
+    assert_equal @tenant_a, Book.order(:id).last.tenant
+  end
+end
