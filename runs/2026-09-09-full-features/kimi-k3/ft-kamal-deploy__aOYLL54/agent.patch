diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..3251bb7
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,66 @@
+# Deploy Fizzy to a single server with Kamal: one Linux box with Docker, where
+# one container runs everything -- the Rails app, the SQLite databases, and the
+# background jobs -- with SSL termination handled by kamal-proxy.
+#
+# Fill in the TODOs below and the secrets in .kamal/secrets, then deploy with:
+#
+#   bin/kamal setup
+#
+# See docs/deployment.md for a full walkthrough.
+
+service: fizzy
+
+# The name of the Docker image on your registry. On Docker Hub (the default
+# registry below), the name includes your username: <username>/fizzy.
+image: your-username/fizzy # TODO: Your Docker registry username
+
+# One server hosts the app. The web container also runs background jobs via
+# Solid Queue in Puma (see config/puma.rb), so there are no other roles.
+servers:
+  web:
+    hosts:
+      - 192.0.2.10 # TODO: Your server's IP address or SSH hostname
+
+# kamal-proxy terminates SSL with a Let's Encrypt certificate for your
+# hostname and serves the app at https://<your hostname>. The hostname's DNS
+# must point at your server before you deploy.
+proxy:
+  ssl: true
+  host: fizzy.example.com # TODO: Your hostname
+
+# Let kamal-proxy serve precompiled assets directly.
+asset_path: /rails/public/assets
+
+# The Docker image is pushed to a registry your server can pull from. Without
+# a registry.server this is Docker Hub, and the image is <username>/fizzy.
+registry:
+  username: your-username # TODO: Your Docker registry username
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Servers are typically x86; build amd64 images even on ARM development
+# machines, such as Apple Silicon Macs.
+builder:
+  arch: amd64
+
+env:
+  clear:
+    # TODO: Your outgoing mail server, used for magic links and notifications.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: your-smtp-username
+    # MAILER_FROM_ADDRESS: Fizzy <fizzy@your-domain.com>
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# The SQLite databases and uploaded files live in /rails/storage. Mounting a
+# named volume there keeps your data around across deploys.
+volumes:
+  - fizzy:/rails/storage
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
