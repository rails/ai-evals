+# Secrets for `bin/kamal setup` and `bin/kamal deploy`, referenced from
+# config/deploy.yml.
+#
+# Fill in each value below before deploying. You can also reference your own
+# environment variables ($NAME) or call out to a password manager
+# ($(op read op://Vault/Fizzy/key)), so real values never touch this file.
+#
+# Either way: do not commit real secrets to git.
+
+# Password for the Docker registry user from config/deploy.yml.
+KAMAL_REGISTRY_PASSWORD=
+
+# Secret used to sign session cookies and more. Generate with:
+#   bin/rails secret
+SECRET_KEY_BASE=
+
+# Key pair for web push notifications. Generate both with:
+#   bin/rails runner "key = WebPush.generate_key; puts \"VAPID_PUBLIC_KEY=#{key.public_key}\nVAPID_PRIVATE_KEY=#{key.private_key}\""
+VAPID_PUBLIC_KEY=
+VAPID_PRIVATE_KEY=
+
+# Password for the SMTP server from config/deploy.yml.
+SMTP_PASSWORD=
