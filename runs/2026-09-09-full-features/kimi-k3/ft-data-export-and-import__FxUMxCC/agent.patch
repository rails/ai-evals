+require "test_helper"
+
+class ImportMailerTest < ActionMailer::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+    @import = @account.imports.new user: @user, imported_account: accounts(:initech), error: "The manifest is missing"
+    @import.file.attach io: StringIO.new("zip"), filename: "fizzy-export.zip", content_type: "application/zip"
+  end
+
+  test "completed emails the importer with a link to the new account" do
