+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,152 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+// Lets people change a card's column or status by dragging it around the board.
+// Drops apply instantly -- the card is already where it was left when the save
+// happens in the background. Columns keep their own order: a card can't be
+// reordered within a column, only moved between them.
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  itemTargetDisconnected(item) {
+    item.draggable = false
+  }
+
+  dragStart(event) {
+    const item = event.target.closest?.(`[data-drag-and-drop-target~="item"]`)
+
+    if (item) {
+      this.draggedItem = item
+      this.sourceContainer = item.closest(`[data-drag-and-drop-target~="container"]`)
+
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", item.id)
+
+      // Defer so the browser snapshots the drag image before the card dims
+      requestAnimationFrame(() => this.draggedItem?.classList.add(this.draggedItemClass))
+    }
+  }
+
+  dragOver(event) {
+    const container = this.#hoveredContainer(event)
+
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#highlight(container)
+    }
+  }
+
+  dragLeave(event) {
+    const container = this.#hoveredContainer(event)
+
+    if (container && !container.contains(event.relatedTarget)) {
+      this.#removeHighlight(container)
+    }
+  }
+
+  drop(event) {
+    const container = this.#hoveredContainer(event)
+
+    if (container) {
+      event.preventDefault()
+      this.#dropInto(container)
+    }
+
+    this.#reset()
+  }
+
+  dragEnd() {
+    this.#reset()
+  }
+
+  // Private
+
+  #hoveredContainer(event) {
+    if (this.draggedItem) {
+      return event.target.closest?.(`[data-drag-and-drop-target~="container"]`)
+    }
+  }
+
+  #highlight(container) {
+    if (container !== this.hoverContainer) {
+      if (this.hoverContainer) this.#removeHighlight(this.hoverContainer)
+      this.hoverContainer = container
+      container.classList.add(this.hoverContainerClass)
+    }
+  }
+
+  #removeHighlight(container) {
+    container.classList.remove(this.hoverContainerClass)
+
+    if (container === this.hoverContainer) {
+      this.hoverContainer = null
+    }
+  }
+
+  #dropInto(container) {
+    const item = this.draggedItem
+
+    if (item?.isConnected && container !== this.sourceContainer) {
+      this.#move(item, container)
+    }
+  }
+
+  #move(item, container) {
+    const origin = { list: item.parentElement, nextSibling: item.nextElementSibling }
+    const list = container.querySelector(".cards__list")
+
+    // Newest cards sort first, so a moved card lands at the top of its column
+    if (list) list.prepend(item)
+
+    this.#persist(item, container, origin)
+  }
+
+  async #persist(item, container, origin) {
+    try {
+      const response = await this.#requestFor(item, container)
+      if (!response?.ok) this.#restore(item, origin)
+    } catch {
+      this.#restore(item, origin)
+    }
+  }
+
+  #requestFor(item, container) {
+    const { cardTriageUrl, cardNotNowUrl, cardClosureUrl } = item.dataset
+
+    switch (container.dataset.dragAndDropDropAction) {
+      case "triage":
+        return post(cardTriageUrl, { query: { column_id: container.dataset.dragAndDropColumnId }, responseKind: "json" })
+      case "stream":
+        return destroy(cardTriageUrl, { responseKind: "json" })
+      case "postpone":
+        return post(cardNotNowUrl, { responseKind: "json" })
+      case "close":
+        return post(cardClosureUrl, { responseKind: "json" })
+    }
+  }
+
+  #restore(item, origin) {
+    if (item.isConnected && origin.list && item.parentElement !== origin.list) {
+      if (origin.nextSibling?.parentElement === origin.list) {
+        origin.list.insertBefore(item, origin.nextSibling)
+      } else {
+        origin.list.append(item)
+      }
+    }
+  }
+
+  #reset() {
+    this.draggedItem?.classList.remove(this.draggedItemClass)
+    this.containerTargets.forEach(container => this.#removeHighlight(container))
+
+    this.draggedItem = null
+    this.sourceContainer = null
+    this.hoverContainer = null
+  }
+}
