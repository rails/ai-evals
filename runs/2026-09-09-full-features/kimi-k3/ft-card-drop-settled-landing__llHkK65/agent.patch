diff --git a/test/controllers/boards/drag_and_drop_test.rb b/test/controllers/boards/drag_and_drop_test.rb
new file mode 100644
index 0000000..a2c8a12
--- /dev/null
+++ b/test/controllers/boards/drag_and_drop_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Boards::DragAndDropTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "board is wired for dragging cards between columns" do
+    get board_path(@board)
+
+    assert_select ".card-columns[data-controller~='drag-and-drop'][data-drag-and-drop-dragged-item-class='drag-and-drop__dragged-item'][data-drag-and-drop-hover-container-class='drag-and-drop__hover-container']"
+  end
+
+  test "every column is a drop container" do
+    get board_path(@board)
+
+    assert_select ".card-columns" do
+      assert_select "section#not-now[data-drag-and-drop-target~='container'][data-drag-and-drop-drop-action='postpone']"
+      assert_select "section#maybe[data-drag-and-drop-target~='container'][data-drag-and-drop-drop-action='stream']"
+      assert_select "section#closed-cards[data-drag-and-drop-target~='container'][data-drag-and-drop-drop-action='close']"
+      assert_select "section[data-drag-and-drop-target~='container'][data-drag-and-drop-drop-action='triage'][data-drag-and-drop-column-id]", @board.columns.count
+    end
+  end
+
+  test "cards on the board are draggable items carrying their action urls" do
+    get board_path(@board)
+
+    assert_select "article.card[data-drag-and-drop-target~='item']", minimum: 1 do |cards|
+      cards.each do |card|
+        assert card["data-card-triage-url"].present?, "card is missing its triage url"
+        assert card["data-card-not-now-url"].present?, "card is missing its not now url"
+        assert card["data-card-closure-url"].present?, "card is missing its closure url"
+      end
+    end
+  end
+
+  test "cards inside lazily loaded columns are draggable items too" do
+    column = columns(:writebook_in_progress)
+
+    get board_column_path(@board, column)
+
+    assert_select "article.card[data-drag-and-drop-target~='item'][data-card-triage-url]", minimum: 1
+  end
+end
diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..4d0420a
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,174 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @board = boards(:writebook)
+  end
+
+  test "drag a card from the stream into a column" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_on_hold)
+
+    visit board_path(@board)
+    assert_card_in "#maybe", card
+    assert_selector "##{dom_id(column)} .cards__list", visible: :all
+
+    drag_card card, onto: "##{dom_id(column)}"
+
+    assert_card_in "##{dom_id(column)}", card
+    wait_until { card.reload.column == column }
+    assert_equal column, card.reload.column
+  end
+
+  test "drag a card from one column to another" do
+    card = cards(:logo)
+    column = columns(:writebook_review)
+
+    visit board_path(@board)
+    assert_card_in "##{dom_id(card.column)}", card
+    assert_selector "##{dom_id(column)} .cards__list", visible: :all
+
+    drag_card card, onto: "##{dom_id(column)}"
+
+    assert_card_in "##{dom_id(column)}", card
+    wait_until { card.reload.column == column }
+    assert_equal column, card.reload.column
+  end
+
+  test "drag a card to the not now column" do
+    card = cards(:text)
+
+    visit board_path(@board)
+    assert_card_in "##{dom_id(card.column)}", card
+    assert_selector "#not-now .cards__list", visible: :all
+
+    drag_card card, onto: "#not-now"
+
+    assert_card_in "#not-now", card
+    wait_until { card.reload.postponed? }
+    assert_predicate card.reload, :postponed?
+  end
+
+  test "drag a card to the done column" do
+    card = cards(:buy_domain)
+
+    visit board_path(@board)
+    assert_card_in "#maybe", card
+    assert_selector "#closed-cards .cards__list", visible: :all
+
+    drag_card card, onto: "#closed-cards"
+
+    assert_card_in "#closed-cards", card
+    wait_until { card.reload.closed? }
+    assert_predicate card.reload, :closed?
+  end
+
+  test "drag a closed card back to the stream" do
+    card = cards(:shipping)
+
+    visit board_path(@board)
+    assert_card_in "#closed-cards", card
+    assert_selector "#maybe .cards__list", visible: :all
+
+    drag_card card, onto: "#maybe"
+
+    assert_card_in "#maybe", card
+    wait_until { card.reload.awaiting_triage? }
+    assert card.reload.awaiting_triage?
+    assert_not card.closed?
+  end
+
+  test "dropping a card back into its own column neither moves nor saves it" do
+    card = cards(:logo)
+    column = card.column
+
+    visit board_path(@board)
+    assert_card_in "##{dom_id(column)}", card
+
+    assert_no_changes -> { card.reload.last_active_at } do
+      drag_card card, onto: "##{dom_id(column)}"
+      sleep 1 # give any unexpected request time to land
+    end
+
+    assert_card_in "##{dom_id(column)}", card
+  end
+
+test "drag a postponed card from not now into a column" do
+  card = cards(:buy_domain)
+  card.postpone(user: users(:kevin))
+  column = columns(:writebook_review)
+
+  visit board_path(@board)
+  assert_card_in "#not-now", card
+  assert_selector "##{dom_id(column)} .cards__list", visible: :all
+
+  drag_card card, onto: "##{dom_id(column)}"
+
+  assert_card_in "##{dom_id(column)}", card
+  wait_until { card.reload.column == column }
+  assert_not card.reload.postponed?
+end
+
+test "when the save fails the card moves back to where it was" do
+  card = cards(:buy_domain)
+  column = columns(:writebook_on_hold)
+
+  visit board_path(@board)
+  assert_card_in "#maybe", card
+  assert_selector "##{dom_id(column)} .cards__list", visible: :all
+
+  Card.any_instance.stubs(:triage_into).raises(ActiveRecord::RecordInvalid.new(card))
+
+  drag_card card, onto: "##{dom_id(column)}"
+
+  wait_until { page.has_css?("#maybe article##{dom_id(card, :article)}", visible: :all) }
+  assert_card_in "#maybe", card
+  assert_nil card.reload.column
+end
+
+  private
+    def drag_card(card, onto:)
+      card_selector = "##{dom_id(card, :article)}"
+
+      page.execute_script(<<~JS)
+        const card = document.querySelector(#{card_selector.to_json});
+        const container = document.querySelector(#{onto.to_json});
+        const dataTransfer = new DataTransfer();
+
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }));
+        container.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }));
+      JS
+
+      # the column under the pointer lights up and the dragged card dims
+      assert_selector "#{onto}.drag-and-drop__hover-container"
+      assert_selector "#{card_selector}.drag-and-drop__dragged-item", visible: :all
+
+      page.execute_script(<<~JS)
+        const card = document.querySelector(#{card_selector.to_json});
+        const container = document.querySelector(#{onto.to_json});
+        const dataTransfer = new DataTransfer();
+
+        container.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }));
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true, dataTransfer }));
+      JS
+
+      # dragging leaves no lingering feedback behind
+      assert_no_selector ".drag-and-drop__hover-container"
+      assert_no_selector ".drag-and-drop__dragged-item", visible: :all
+    end
+
+    def assert_card_in(container, card)
+      assert_selector "#{container} article##{dom_id(card, :article)}", visible: :all
+    end
+
+    def wait_until(timeout: 5)
+      Timeout.timeout(timeout) do
+        sleep 0.1 until yield
+      end
+    rescue Timeout::Error
+      flunk "timed out waiting for condition"
+    end
+end
