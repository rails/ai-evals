diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..eddbafc
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,293 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:jason)
+    @user.create_settings!(bundle_email_frequency: "every_few_hours")
+  end
+
+  test "the first notification opens a window when it lands" do
+    freeze_time do
+      notification = create_notification(events(:logo_published))
+      bundle = notification.bundle
+
+      assert_not_nil bundle
+      assert_equal Time.current, bundle.starts_at
+      assert_equal 4.hours.from_now, bundle.ends_at
+      assert bundle.open?
+    end
+  end
+
+  test "window length depends on the chosen frequency" do
+    freeze_time do
+      @user.settings.update!(bundle_email_frequency: "daily")
+      assert_equal 1.day.from_now, create_notification(events(:logo_published)).bundle.ends_at
+    end
+  end
+
+  test "weekly frequency opens a week-long window" do
+    freeze_time do
+      @user.settings.update!(bundle_email_frequency: "weekly")
+      assert_equal 1.week.from_now, create_notification(events(:logo_published)).bundle.ends_at
+    end
+  end
+
+  test "notifications that arrive while a window is open join it" do
+    first = create_notification(events(:logo_published))
+
+    travel 1.hour do
+      second = create_notification(events(:layout_published))
+      assert_equal first.bundle, second.bundle
+    end
+
+    assert_equal 1, @user.notification_bundles.count
+  end
+
+  test "late notifications join the window that has already opened" do
+    bundle = create_notification(events(:logo_published)).bundle
+
+    late = nil
+    travel 1.hour do
+      late = Notification.create!(user: @user, source: events(:layout_published), creator: users(:david), created_at: 2.hours.ago)
+    end
+
+    assert_operator late.created_at, :<, bundle.starts_at
+    assert_equal bundle, late.bundle
+  end
+
+  test "notifications are not bundled when the frequency is never" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    notification = create_notification(events(:logo_published))
+
+    assert_nil notification.bundle
+    assert_equal 0, @user.notification_bundles.count
+  end
+
+  test "deliver_all_due does not send windows that are still open" do
+    create_notification(events(:logo_published))
+
+    assert_no_emails do
+      perform_enqueued_jobs do
+        Notification::Bundle.deliver_all_due
+      end
+    end
+
+    assert_predicate @user.notification_bundles.sole, :open?
+  end
+
+  test "delivering a due window sends one email with all its notifications" do
+    create_notification(events(:logo_published))
+    create_notification(events(:layout_published))
+    bundle = @user.notification_bundles.sole
+
+    travel_to bundle.ends_at + 1.second do
+      assert_emails 1 do
+        perform_enqueued_jobs do
+          Notification::Bundle.deliver_all_due
+        end
+      end
+    end
+
+    assert_predicate bundle.reload, :sent?
+  end
+
+  test "delivering a window twice does not send twice" do
+    create_notification(events(:logo_published))
+    bundle = @user.notification_bundles.sole
+
+    travel_to bundle.ends_at + 1.second do
+      Notification::Bundle.deliver_all_due
+      bundle.deliver
+    end
+
+    assert_enqueued_emails 1
+  end
+
+  test "a new window opens after the previous one was sent" do
+    first_window = create_notification(events(:logo_published)).bundle
+    travel_to(first_window.ends_at + 1.second) { Notification::Bundle.deliver_all_due }
+
+    second_window = nil
+    travel_to(first_window.ends_at + 1.minute) do
+      second_window = create_notification(events(:layout_published)).bundle
+    end
+
+    assert_not_equal first_window, second_window
+    assert_operator first_window.ends_at, :<=, second_window.starts_at
+  end
+
+  test "windows never overlap" do
+    window = create_notification(events(:logo_published)).bundle
+
+    overlapping = Notification::Bundle.new(user: @user, starts_at: window.starts_at + 1.hour, ends_at: window.ends_at + 1.hour)
+    assert_not overlapping.valid?
+
+    adjacent = Notification::Bundle.new(user: @user, starts_at: window.ends_at, ends_at: window.ends_at + 4.hours)
+    assert adjacent.valid?
+  end
+
+  test "only one window can be open at a time, enforced by the database" do
+    open_window = create_notification(events(:logo_published)).bundle
+
+    assert_raises(ActiveRecord::RecordNotUnique) do
+      Notification::Bundle.new(user: @user, account: @user.account, starts_at: open_window.ends_at, ends_at: open_window.ends_at + 4.hours).save!(validate: false)
+    end
+  end
+
+  test "a notification joins a new window when it is updated after its window was sent" do
+    notification = create_notification(events(:logo_published))
+    first_window = notification.bundle
+
+    travel_to(first_window.ends_at + 1.second) { Notification::Bundle.deliver_all_due }
+    assert_predicate first_window.reload, :sent?
+
+    travel_to(first_window.ends_at + 1.minute) do
+      notification.update!(source: events(:logo_assignment_jz), read_at: nil, unread_count: 2)
+
+      assert_not_equal first_window, notification.bundle
+      assert_predicate notification.bundle, :open?
+    end
+  end
+
+  test "reading a notification does not move it to a new window" do
+    notification = create_notification(events(:logo_published))
+    window = notification.bundle
+
+    travel_to(window.ends_at + 1.second) { Notification::Bundle.deliver_all_due }
+
+    notification.read
+    assert_equal window, notification.reload.bundle
+  end
+
+  test "empty windows are closed without sending an email" do
+    notification = create_notification(events(:logo_published))
+    bundle = notification.bundle
+    notification.destroy!
+
+    travel_to bundle.ends_at + 1.second do
+      assert_no_emails do
+        perform_enqueued_jobs do
+          Notification::Bundle.deliver_all_due
+        end
+      end
+    end
+
+    assert_predicate bundle.reload, :sent?
+  end
+
+  test "windows for deactivated users close without sending an email" do
+    create_notification(events(:logo_published))
+    bundle = @user.notification_bundles.sole
+
+    @user.update!(active: false)
+
+    travel_to bundle.ends_at + 1.second do
+      assert_no_emails do
+        perform_enqueued_jobs do
+          Notification::Bundle.deliver_all_due
+        end
+      end
+    end
+
+    assert_predicate bundle.reload, :sent?
+  end
+
+  test "digest emails carry the account context even without a current account" do
+    create_notification(events(:logo_published))
+    bundle = @user.notification_bundles.sole
+
+    travel_to bundle.ends_at + 1.second do
+      assert_emails 1 do
+        Current.without_account do
+          perform_enqueued_jobs do
+            Notification::Bundle.deliver_all_due
+          end
+        end
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_match %r{#{@user.account.slug}/cards/}, email.html_part.body.encoded
+  end
+
+  test "notifications created by the notifier are bundled" do
+    jz = users(:jz)
+    jz.settings.update!(bundle_email_frequency: "daily")
+
+    freeze_time do
+      assert_difference -> { jz.notification_bundles.count }, +1 do
+        Notifier.for(events(:logo_assignment_jz)).notify
+      end
+
+      bundle = jz.notification_bundles.sole
+      assert_equal 1.day.from_now, bundle.ends_at
+      assert_equal bundle, jz.notifications.find_by(card: cards(:logo)).bundle
+    end
+  end
+
+  test "opening a window recovers when another window won the race" do
+    bundle = create_notification(events(:logo_published)).bundle
+
+    assert_equal bundle, Notification::Bundle.send(:create_for, @user)
+  end
+
+  test "users without settings are never bundled" do
+    @user.settings.destroy!
+    @user.reload
+
+    notification = create_notification(events(:logo_published))
+
+    assert_nil notification.bundle
+  end
+
+  test "windows are per-person and independent" do
+    jz = users(:jz)
+    kevin = users(:kevin)
+    jz.settings.update!(bundle_email_frequency: "daily")
+    kevin.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    jz_notification = Notification.create!(user: jz, source: events(:logo_assignment_jz), creator: users(:david))
+
+    travel 30.minutes do
+      kevin_notification = Notification.create!(user: kevin, source: events(:shipping_published), creator: users(:david))
+
+      assert_not_equal jz_notification.bundle, kevin_notification.bundle
+      assert_equal 4.hours, kevin_notification.bundle.ends_at - kevin_notification.bundle.starts_at
+      assert_equal 1.day, jz_notification.bundle.ends_at - jz_notification.bundle.starts_at
+    end
+  end
+
+  test "changing frequency mid-window keeps the open window's schedule" do
+    jz = users(:jz)
+    jz.settings.update!(bundle_email_frequency: "daily")
+
+    bundle = Notification.create!(user: jz, source: events(:logo_assignment_jz), creator: users(:david)).bundle
+    original_ends_at = bundle.ends_at
+
+    jz.settings.update!(bundle_email_frequency: "every_few_hours")
+    second = Notification.create!(user: jz, source: events(:shipping_published), creator: users(:david))
+
+    assert_equal bundle, second.bundle
+    assert_equal original_ends_at, bundle.reload.ends_at
+  end
+
+  test "bundles work in another account" do
+    mike = users(:mike)
+    mike.create_settings!(bundle_email_frequency: "weekly")
+    event = Event.create!(board: cards(:paycheck).board, creator: mike, eventable: cards(:paycheck), action: "card_published")
+
+    notification = Notification.create!(user: mike, source: event, creator: mike)
+
+    assert_equal accounts(:initech), notification.bundle.account
+    assert_equal 1.week, notification.bundle.ends_at - notification.bundle.starts_at
+  end
+
+  private
+    def create_notification(source)
+      Notification.create!(user: @user, source: source, creator: users(:david))
+    end
+end
