+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,9 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.order(updated_at: :desc)
+
+    mail to: @user.identity.email_address, subject: "You have #{@notifications.size} new #{"notification".pluralize(@notifications.size)}"
+  end
+end
