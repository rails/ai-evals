+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "bundle email frequency defaults to never" do
+    assert_equal "never", User::Settings.new.bundle_email_frequency
+  end
+
+  test "bundle_email? is only false when the frequency is never" do
+    assert_not User::Settings.new(bundle_email_frequency: "never").bundle_email?
+
+    %w[ every_few_hours daily weekly ].each do |frequency|
+      assert User::Settings.new(bundle_email_frequency: frequency).bundle_email?
+    end
+  end
+
+  test "bundle_email_window matches the frequency" do
+    assert_equal 4.hours, User::Settings.new(bundle_email_frequency: "every_few_hours").bundle_email_window
+    assert_equal 1.day, User::Settings.new(bundle_email_frequency: "daily").bundle_email_window
+    assert_equal 1.week, User::Settings.new(bundle_email_frequency: "weekly").bundle_email_window
+    assert_nil User::Settings.new(bundle_email_frequency: "never").bundle_email_window
+  end
+end
