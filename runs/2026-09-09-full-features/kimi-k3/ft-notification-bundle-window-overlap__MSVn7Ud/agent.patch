+module Notification::Bundleable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true
+
+    before_create :assign_to_open_bundle
+    before_update :assign_to_open_bundle, if: :source_id_changed?
+  end
+
+  private
+    def assign_to_open_bundle
+      if user.settings&.bundle_email? && (bundle.nil? || bundle.sent?)
+        self.bundle = Notification::Bundle.open_or_create_for(user)
+      end
+    end
+end
