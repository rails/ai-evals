@@ -0,0 +1,39 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:jason)
+    @user.create_settings!(bundle_email_frequency: "daily")
+  end
+
+  test "digest bundles a window's notifications into a single email" do
+    create_notification(events(:logo_published))
+    create_notification(events(:layout_published))
+    bundle = @user.notification_bundles.sole
+
+    email = NotificationMailer.digest(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "jason@37signals.com" ], email.to
+    assert_equal "You have 2 new notifications", email.subject
+    assert_match "The logo isn", email.html_part.body.encoded
+    assert_match "Layout is broken", email.html_part.body.encoded
+    assert_match "The logo isn't big enough", email.text_part.body.encoded
+    assert_match %r{#{@user.account.slug}/cards/}, email.html_part.body.encoded
+  end
+
+  test "digest subject is singular for a single notification" do
+    create_notification(events(:logo_published))
+    bundle = @user.notification_bundles.sole
+
+    assert_equal "You have 1 new notification", NotificationMailer.digest(bundle).subject
+  end
+
+  private
+    def create_notification(source)
+      Notification.create!(user: @user, source: source, creator: users(:david))
+    end
+end
