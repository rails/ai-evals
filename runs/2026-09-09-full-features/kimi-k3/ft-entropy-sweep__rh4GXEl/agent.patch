diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..4ca9927 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -86,3 +86,95 @@ class Card::EntropicTest < ActiveSupport::TestCase
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
 end
+
+class Card::EntropicBulkTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "auto postpone all due postpones cards in batches with full side effects" do
+    cards(:logo).update!(last_active_at: 2.days.ago - entropies(:writebook_board).auto_postpone_period, column: columns(:writebook_in_progress))
+    cards(:logo).create_activity_spike!
+    cards(:layout).update!(last_active_at: 2.days.ago - entropies(:writebook_board).auto_postpone_period)
+
+    assert_difference -> { Card::NotNow.count }, +2 do
+      assert_difference -> { Event.where(action: "card_auto_postponed").count }, +2 do
+        assert_difference -> { Comment.by_system.count }, +2 do
+          # batch_size of 1 forces the sweep through multiple batches
+          Card.auto_postpone_all_due(batch_size: 1)
+        end
+      end
+    end
+
+    card = cards(:logo).reload
+    assert card.postponed?
+    assert_equal accounts("37s").system_user, card.postponed_by
+    assert_nil card.column_id
+    assert_nil card.activity_spike
+    assert card.last_active_at > 1.minute.ago
+
+    event = card.events.last
+    assert_equal "card_auto_postponed", event.action
+    assert_equal accounts("37s").system_user, event.creator
+
+    comment = card.comments.last
+    assert comment.creator.system?
+    assert_includes comment.body.to_plain_text, "Not Now"
+
+    assert cards(:layout).reload.postponed?
+  end
+
+  test "auto postpone all due does not re-postpone cards on subsequent runs" do
+    cards(:logo).update!(last_active_at: 2.days.ago - entropies(:writebook_board).auto_postpone_period)
+
+    Card.auto_postpone_all_due
+
+    assert_no_difference -> { Card::NotNow.count } do
+      assert_no_difference -> { Event.count } do
+        Card.auto_postpone_all_due
+      end
+    end
+  end
+
+  test "auto postpone all due performs a constant number of queries per batch" do
+    cards(:logo, :layout, :text, :shipping).each do |card|
+      card.update!(last_active_at: 2.days.ago - entropies(:writebook_board).auto_postpone_period)
+    end
+
+    queries = 0
+    subscriber = ActiveSupport::Notifications.subscribe("sql.active_record") do |*, payload|
+      queries += 1 unless payload[:name] == "SCHEMA"
+    end
+
+    Card.auto_postpone_all_due(batch_size: 1_000)
+  ensure
+    ActiveSupport::Notifications.unsubscribe(subscriber)
+
+    # The callback-driven path this replaced ran ~50 queries per card.
+    assert_operator queries, :<, 40, "expected the sweep to run a bounded number of queries, got #{queries}"
+  end
+
+  test "auto postpone all due only dispatches webhooks for boards subscribed to card_auto_postponed" do
+    cards(:logo).update!(last_active_at: 2.days.ago - entropies(:writebook_board).auto_postpone_period)
+
+    # The writebook fixture webhook is not subscribed to card_auto_postponed.
+    assert_no_enqueued_jobs only: Event::WebhookDispatchJob do
+      Card.auto_postpone_all_due
+    end
+
+    Webhook.create! name: "Entropy hook", url: "https://example.com/entropy", board: boards(:writebook), subscribed_actions: %w[ card_auto_postponed ]
+    cards(:layout).update!(last_active_at: 2.days.ago - entropies(:writebook_board).auto_postpone_period)
+
+    assert_enqueued_with job: Event::WebhookDispatchJob do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "auto postpone all due touches affected boards" do
+    cards(:logo).update!(last_active_at: 2.days.ago - entropies(:writebook_board).auto_postpone_period)
+
+    assert_changes -> { boards(:writebook).reload.updated_at } do
+      Card.auto_postpone_all_due
+    end
+  end
+end
