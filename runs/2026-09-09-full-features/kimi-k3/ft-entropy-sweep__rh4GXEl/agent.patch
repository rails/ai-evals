 module Card::Entropic
   extend ActiveSupport::Concern
 
+  # Due cards are postponed in batches of this size to keep each bulk-write transaction short.
+  AUTO_POSTPONE_BATCH_SIZE = 1_000
+
   included do
     scope :due_to_be_postponed, -> do
       active
@@ -24,11 +27,90 @@ module Card::Entropic
   end
 
   class_methods do
-    def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+    # Postpones every due card with a handful of set-based statements per batch.
+    #
+    # Running the full per-card callback stack (Card#auto_postpone) costs tens of
+    # queries per card, so once an install grows past a hundred thousand cards the
+    # hourly sweep can no longer finish within its hour. This performs the same
+    # state changes in bulk instead: Not Now records, events, and system comments
+    # are inserted directly, activity spikes are cleared, cards are sent back to
+    # triage and touched, and affected boards are touched once per batch.
+    def auto_postpone_all_due(batch_size: AUTO_POSTPONE_BATCH_SIZE)
+      due_to_be_postponed.in_batches(of: batch_size) do |batch|
+        auto_postpone_batch(batch)
       end
     end
+
+    private
+      def auto_postpone_batch(batch)
+        # Plucking re-runs the due_to_be_postponed conditions, so cards that were
+        # revived or postponed since the batch range was computed are left alone.
+        due_cards = batch.pluck(:id, :account_id, :board_id, :column_id)
+        return if due_cards.empty?
+
+        card_ids    = due_cards.map(&:first)
+        account_ids = due_cards.map(&:second).uniq
+        board_ids   = due_cards.map(&:third).uniq
+        column_ids  = due_cards.map(&:fourth).compact.uniq
+
+        system_user_ids = User.where(account_id: account_ids, role: :system).pluck(:account_id, :id).to_h
+        now = Time.current
+
+        events = due_cards.map do |card_id, account_id, board_id, _|
+          { id: ActiveRecord::Type::Uuid.generate, account_id:, board_id:, creator_id: system_user_ids.fetch(account_id),
+            eventable_type: "Card", eventable_id: card_id, action: "card_auto_postponed", particulars: {},
+            created_at: now, updated_at: now }
+        end
+
+        comments = due_cards.map do |card_id, account_id, _, _|
+          { id: ActiveRecord::Type::Uuid.generate, account_id:, card_id:, creator_id: system_user_ids.fetch(account_id),
+            created_at: now, updated_at: now }
+        end
+
+        transaction do
+          Card::ActivitySpike.where(card_id: card_ids).delete_all
+
+          Card::NotNow.insert_all due_cards.map { |card_id, account_id, _, _|
+            { id: ActiveRecord::Type::Uuid.generate, account_id:, card_id:, user_id: system_user_ids.fetch(account_id),
+              created_at: now, updated_at: now }
+          }
+
+          Event.insert_all events
+
+          Comment.insert_all comments
+          ActionText::RichText.insert_all comments.map { |comment|
+            { id: ActiveRecord::Type::Uuid.generate, account_id: comment[:account_id], record_type: "Comment", record_id: comment[:id],
+              name: "body", body: auto_postponed_comment_body, created_at: now, updated_at: now }
+          }
+
+          Card.where(id: card_ids).update_all(column_id: nil, last_active_at: now, updated_at: now)
+          Board.where(id: board_ids).update_all(updated_at: now)
+          Column.where(id: column_ids).update_all(updated_at: now) if column_ids.any?
+        end
+
+        dispatch_webhook_jobs_for(events, board_ids)
+        broadcast_refreshes_for(board_ids, account_ids)
+      end
+
+      def auto_postponed_comment_body
+        Card::Eventable::SystemCommenter.body_for(Event.new(action: "card_auto_postponed"))
+      end
+
+      def dispatch_webhook_jobs_for(events, board_ids)
+        webhooked_board_ids = Webhook.active.triggered_by_action("card_auto_postponed").where(board_id: board_ids).pluck(:board_id)
+        event_ids = events.select { it[:board_id].in?(webhooked_board_ids) }.map { it[:id] }
+
+        if event_ids.any?
+          ActiveJob.perform_all_later Event.where(id: event_ids).map { |event| Event::WebhookDispatchJob.new(event) }
+        end
+      end
+
+      # One refresh per affected board and account replaces the per-card cascade
+      # of touches and broadcasts emitted by the callback-driven path.
+      def broadcast_refreshes_for(board_ids, account_ids)
+        Board.where(id: board_ids).each { |board| Turbo::StreamsChannel.broadcast_refresh_to(board) }
+        Account.where(id: account_ids).each { |account| Turbo::StreamsChannel.broadcast_refresh_to(account, :all_boards) }
+      end
   end
 
   def entropy
