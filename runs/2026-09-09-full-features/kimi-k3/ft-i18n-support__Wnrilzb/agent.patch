@@ -0,0 +1,46 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "default locale renders English" do
+    get board_path(boards(:writebook))
+    assert_response :success
+    assert_select "html[lang=en]"
+  end
+
+  test "switching locale with a query param" do
+    get board_path(boards(:writebook), locale: "ja")
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_equal "ja", session[:locale]
+  end
+
+  test "locale choice sticks for the session" do
+    get board_path(boards(:writebook), locale: "ja")
+    get board_path(boards(:writebook))
+    assert_select "html[lang=ja]"
+  end
+
+  test "locale choice persists on the identity" do
+    get board_path(boards(:writebook), locale: "ja")
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+
+  test "identity locale is used on a fresh session" do
+    identities(:kevin).update!(locale: "ja")
+    logout_and_sign_in_as :kevin
+    get board_path(boards(:writebook))
+    assert_select "html[lang=ja]"
+  end
+
+  test "invalid locale is ignored" do
+    get board_path(boards(:writebook), locale: "xx")
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_nil session[:locale]
+    assert_nil identities(:kevin).reload.locale
+  end
+end
