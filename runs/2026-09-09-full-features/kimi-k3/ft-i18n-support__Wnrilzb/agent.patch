diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..fdad9c1
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,36 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :set_locale
+
+    etag { I18n.locale }
+  end
+
+  private
+    def set_locale(&action)
+      I18n.with_locale(resolve_locale, &action)
+    end
+
+    def resolve_locale
+      if (locale = valid_locale(params[:locale]))
+        remember_locale(locale)
+      else
+        valid_locale(session[:locale]) || valid_locale(Current.identity&.locale) || I18n.default_locale
+      end
+    end
+
+    def remember_locale(locale)
+      session[:locale] = locale
+
+      if Current.identity && Current.identity.locale != locale
+        Current.identity.update!(locale: locale)
+      end
+
+      locale
+    end
+
+    def valid_locale(locale)
+      locale.to_s.presence_in(I18n.available_locales.map(&:to_s))
+    end
+end
