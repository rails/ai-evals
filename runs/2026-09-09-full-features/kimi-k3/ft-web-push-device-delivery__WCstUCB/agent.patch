diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..5baf30b
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,118 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  test "configured when VAPID keys are provided" do
+    assert_not PushSubscription.configured?
+
+    with_vapid_keys do
+      assert PushSubscription.configured?
+      assert_equal "test-public-key", PushSubscription.vapid_public_key
+      assert_equal "test-private-key", PushSubscription.vapid_private_key
+    end
+  end
+
+  test "validations" do
+    subscription = users(:david).push_subscriptions.build(endpoint: "http://insecure.example.com/push", p256dh_key: "p256dh", auth_key: "auth")
+    assert_not subscription.valid?
+
+    subscription.endpoint = "https://push.example.com/send/abc123"
+    assert subscription.valid?
+
+    subscription.p256dh_key = nil
+    assert_not subscription.valid?
+  end
+
+  test "push delivers the payload to the push service" do
+    subscription = push_subscriptions(:davids_desktop)
+
+    with_vapid_keys do
+      WebPush.expects(:payload_send).with(
+        message: "{\"title\":\"Hello\"}",
+        endpoint: subscription.endpoint,
+        p256dh: subscription.p256dh_key,
+        auth: subscription.auth_key,
+        vapid: {
+          subject: "mailto:support@fizzy.do",
+          public_key: "test-public-key",
+          private_key: "test-private-key"
+        })
+
+      subscription.push("{\"title\":\"Hello\"}")
+    end
+  end
+
+  test "push destroys the subscription when it has expired" do
+    subscription = push_subscriptions(:davids_desktop)
+    response = stub(code: "410", body: "Gone")
+
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "fcm.googleapis.com"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        subscription.push("payload")
+      end
+    end
+  end
+
+  test "push destroys the subscription when it is invalid" do
+    subscription = push_subscriptions(:davids_desktop)
+    response = stub(code: "404", body: "Not Found")
+
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).raises(WebPush::InvalidSubscription.new(response, "fcm.googleapis.com"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        subscription.push("payload")
+      end
+    end
+  end
+
+  test "push lets unexpected errors bubble up" do
+    subscription = push_subscriptions(:davids_desktop)
+    response = stub(code: "500", body: "Internal Server Error")
+
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).raises(WebPush::PushServiceError.new(response, "fcm.googleapis.com"))
+
+      assert_no_difference -> { PushSubscription.count } do
+        assert_raises(WebPush::PushServiceError) do
+          subscription.push("payload")
+        end
+      end
+    end
+  end
+
+  test "subscriptions are destroyed with their user" do
+    user = users(:david)
+
+    assert_difference -> { PushSubscription.count }, -user.push_subscriptions.count do
+      user.push_subscriptions.destroy_all
+    end
+  end
+
+  test "push builds an encrypted, VAPID-signed request to the subscription endpoint" do
+    vapid_key = WebPush.generate_key
+    p256dh_key = Base64.urlsafe_encode64(OpenSSL::PKey::EC.generate("prime256v1").public_key.to_bn.to_s(2))
+    auth_key = Base64.urlsafe_encode64(SecureRandom.bytes(16))
+
+    subscription = users(:david).push_subscriptions.create!(
+      endpoint: "https://push.example.com/send/abc123",
+      p256dh_key: p256dh_key,
+      auth_key: auth_key)
+
+    request = nil
+    http = mock
+    Net::HTTP.stubs(:new).returns(http)
+    http.stubs(:use_ssl=)
+    http.expects(:request).with { |req| request = req; true }.returns(Net::HTTPCreated.new("1.1", 201, "Created"))
+
+    with_vapid_keys(public_key: vapid_key.public_key, private_key: vapid_key.private_key) do
+      subscription.push({ title: "Hello", body: "World", url: "https://fizzy.example.com/123/cards/1" }.to_json)
+    end
+
+    assert_equal "/send/abc123", request.path
+    assert_equal "aes128gcm", request["Content-Encoding"]
+    assert_match %r{\Avapid t=.+,k=.+\z}, request["Authorization"]
+    assert request.body.present?
+  end
+end
