+++ b/test/jobs/notification/push_job_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Notification::PushJobTest < ActiveSupport::TestCase
+  test "pushes the notification to the user's subscriptions" do
+    notification = notifications(:layout_commented_kevin)
+    messages = []
+
+    with_vapid_keys do
+      WebPush.stubs(:payload_send).with { |message:, **| messages << message; true }
+      Notification::PushJob.perform_now(notification)
+    end
+
+    assert_equal users(:kevin).push_subscriptions.count, messages.size
+
+    payload = JSON.parse(messages.first)
+    assert_equal "RE: Layout is broken", payload["title"]
+    assert_equal "The text is overflowing the container.", payload["body"]
+  end
+
+  test "discards jobs for deleted notifications" do
+    notification = notifications(:layout_commented_kevin)
+
+    with_vapid_keys do
+      WebPush.expects(:payload_send).never
+
+      Notification::PushJob.perform_later(notification)
+      notification.destroy
+
+      assert_nothing_raised do
+        perform_enqueued_jobs only: Notification::PushJob
+      end
+    end
+  end
+end
