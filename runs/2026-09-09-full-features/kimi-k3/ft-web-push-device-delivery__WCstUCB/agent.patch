diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..6dea103 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -64,4 +64,32 @@ self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
 
+self.addEventListener("push", (event) => {
+  const payload = event.data.json()
+
+  event.waitUntil(
+    self.registration.showNotification(payload.title, {
+      body: payload.body,
+      icon: "/app-icon-192.png",
+      data: { url: payload.url }
+    })
+  )
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  event.waitUntil(
+    self.clients.matchAll({ type: "window", includeUncontrolled: true }).then((windowClients) => {
+      const client = windowClients.find((client) => client.url.startsWith(self.location.origin))
+
+      if (client) {
+        return client.focus().then((client) => client.navigate(event.notification.data.url))
+      } else {
+        return self.clients.openWindow(event.notification.data.url)
+      }
+    })
+  )
+})
+
 TurboOffline.start()
