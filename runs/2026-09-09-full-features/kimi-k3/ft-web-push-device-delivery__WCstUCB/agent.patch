new file mode 100644
index 0000000..98781aa
--- /dev/null
+++ b/test/test_helpers/vapid_test_helper.rb
@@ -0,0 +1,13 @@
+module VapidTestHelper
+  private
+
+  def with_vapid_keys(public_key: "test-public-key", private_key: "test-private-key")
+    original_public_key, original_private_key = ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"]
+    ENV["VAPID_PUBLIC_KEY"] = public_key
+    ENV["VAPID_PRIVATE_KEY"] = private_key
+    yield
+  ensure
+    ENV["VAPID_PUBLIC_KEY"] = original_public_key
+    ENV["VAPID_PRIVATE_KEY"] = original_private_key
+  end
+end
