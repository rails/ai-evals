--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,36 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    subscription.update!(push_subscription_params)
+
+    head :created
+  end
+
+  def destroy
+    @user.push_subscriptions.destroy_by(endpoint: endpoint_param)
+
+    head :ok
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+
+    def endpoint_param
+      params.expect(push_subscription: :endpoint)[:endpoint]
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..68b63b5
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,100 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "status" ]
+  static values = {
+    subscriptionsUrl: String,
+    vapidPublicKey: String
+  }
+
+  connect() {
+    if (this.#pushSupported) {
+      this.#sync()
+    } else {
+      this.statusTarget.hidden = true
+      this.#syncDetails()
+    }
+  }
+
+  async enable() {
+    if (await Notification.requestPermission() === "granted") {
+      await this.#subscribe()
+    }
+
+    this.#sync()
+  }
+
+  async disable() {
+    const subscription = await this.#browserSubscription
+
+    if (subscription) {
+      await subscription.unsubscribe()
+      await destroy(this.subscriptionsUrlValue, { body: { push_subscription: { endpoint: subscription.endpoint } } })
+    }
+
+    this.#sync()
+  }
+
+  get #pushSupported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #browserSubscription() {
+    return navigator.serviceWorker.ready.then((registration) => registration.pushManager.getSubscription())
+  }
+
+  async #sync() {
+    const subscription = await this.#browserSubscription
+    const enabled = !!subscription && Notification.permission === "granted"
+
+    if (enabled) {
+      this.#register(subscription)
+    }
+
+    this.element.classList.toggle("notifications--on", enabled)
+    this.#syncDetails()
+  }
+
+  #syncDetails() {
+    const showDetails = !this.#pushSupported || Notification.permission === "denied"
+
+    this.detailsTargets.forEach((details) => {
+      details.hidden = !showDetails
+    })
+  }
+
+  async #subscribe() {
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey
+    })
+
+    await this.#register(subscription)
+  }
+
+  #register(subscription) {
+    return post(this.subscriptionsUrlValue, { body: this.#subscriptionParams(subscription) })
+  }
+
+  #subscriptionParams(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    return {
+      push_subscription: {
+        endpoint: endpoint,
+        p256dh_key: keys.p256dh,
+        auth_key: keys.auth
+      }
+    }
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.vapidPublicKeyValue.length % 4) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const keyBytes = atob(base64)
+
+    return Uint8Array.from([ ...keyBytes ].map((character) => character.charCodeAt(0)))
+  }
+}
