diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..628a8f6
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,158 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "create" do
+    assert_difference -> { users(:david).push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(users(:david)), params: {
+        push_subscription: {
+          endpoint: "https://fcm.googleapis.com/fcm/send/new-device",
+          p256dh_key: "new-p256dh-key",
+          auth_key: "new-auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+
+    subscription = users(:david).push_subscriptions.order(:created_at).last
+    assert_equal "https://fcm.googleapis.com/fcm/send/new-device", subscription.endpoint
+    assert_equal "new-p256dh-key", subscription.p256dh_key
+    assert_equal "new-auth-key", subscription.auth_key
+    assert_equal accounts("37s"), subscription.account
+  end
+
+  test "create with form-encoded params" do
+    assert_difference -> { users(:david).push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(users(:david)), params: {
+        push_subscription: {
+          endpoint: "https://fcm.googleapis.com/fcm/send/form-encoded-device",
+          p256dh_key: "form-p256dh-key",
+          auth_key: "form-auth-key"
+        }
+      }
+    end
+
+    assert_response :created
+    assert_equal "https://fcm.googleapis.com/fcm/send/form-encoded-device", users(:david).push_subscriptions.order(:created_at).last.endpoint
+  end
+
+  test "create is idempotent for the same endpoint and refreshes the keys" do
+    existing = push_subscriptions(:davids_desktop)
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:david)), params: {
+        push_subscription: {
+          endpoint: existing.endpoint,
+          p256dh_key: "rotated-p256dh-key",
+          auth_key: "rotated-auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "rotated-p256dh-key", existing.reload.p256dh_key
+    assert_equal "rotated-auth-key", existing.auth_key
+  end
+
+  test "create allows another user to subscribe from the same browser endpoint" do
+    existing = push_subscriptions(:davids_desktop)
+    logout_and_sign_in_as :kevin
+
+    assert_difference -> { PushSubscription.count }, +1 do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: existing.endpoint,
+          p256dh_key: "kevins-p256dh-key",
+          auth_key: "kevins-auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal existing.endpoint, users(:kevin).push_subscriptions.order(:created_at).last.endpoint
+  end
+
+  test "create rejects a non-https endpoint" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:david)), params: {
+        push_subscription: {
+          endpoint: "http://insecure.example.com/push",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create requires push subscription params" do
+    post user_push_subscriptions_path(users(:david)), params: {}, as: :json
+
+    assert_response :bad_request
+  end
+
+  test "destroy" do
+    subscription = push_subscriptions(:davids_desktop)
+
+    assert_difference -> { users(:david).push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(users(:david)), params: {
+        push_subscription: { endpoint: subscription.endpoint }
+      }, as: :json
+    end
+
+    assert_response :ok
+  end
+
+  test "destroy with an unknown endpoint" do
+    assert_no_difference -> { PushSubscription.count } do
+      delete user_push_subscriptions_path(users(:david)), params: {
+        push_subscription: { endpoint: "https://fcm.googleapis.com/fcm/send/unknown" }
+      }, as: :json
+    end
+
+    assert_response :ok
+  end
+
+  test "cannot manage another user's subscriptions" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: "https://fcm.googleapis.com/fcm/send/not-your-device",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :forbidden
+
