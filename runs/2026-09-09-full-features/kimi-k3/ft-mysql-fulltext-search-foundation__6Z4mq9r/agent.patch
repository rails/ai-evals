diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..4d8e05a
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.session = sessions(:kevin)
+  end
+
+  test "show without a query renders the search form" do
+    get search_path
+
+    assert_response :success
+    assert_select "form input[name=q]"
+    assert_select "a.search-result", count: 0
+  end
+
+  test "search finds cards by title and highlights the match" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_match "The <mark>logo</mark> isn", @response.body
+    assert_select "a.search-result[href=?]", card_path(cards(:logo))
+  end
+
+  test "search finds cards by description" do
+    cards(:logo).update! description: "<p>The brandmark should dominate the page</p>"
+
+    get search_path(q: "brandmark")
+
+    assert_match "<mark>brandmark</mark>", @response.body
+    assert_select "a.search-result[href=?]", card_path(cards(:logo))
+  end
+
+  test "search finds cards by comment body" do
+    get search_path(q: "overflowing")
+
+    assert_match "<mark>overflowing</mark>", @response.body
+    assert_select "a.search-result[href=?]", card_path(cards(:layout))
+  end
+
+  test "results are ordered newest first" do
+    boards(:writebook).cards.create! title: "Catchable oldest", creator: users(:kevin), status: :published, created_at: 2.days.ago
+    boards(:writebook).cards.create! title: "Catchable newest", creator: users(:kevin), status: :published, created_at: 1.day.ago
+
+    get search_path(q: "Catchable")
+
+    assert_operator @response.body.index("<mark>Catchable</mark> newest"), :<, @response.body.index("<mark>Catchable</mark> oldest")
+  end
+
+  test "cards on boards the user cannot access are not returned" do
+    private_card = boards(:private).cards.create! title: "Clandestine project", creator: users(:kevin), status: :published
+
+    get search_path(q: "Clandestine")
+    assert_select "a.search-result[href=?]", card_path(private_card)
+
+    logout_and_sign_in_as :david
+    get search_path(q: "Clandestine")
+    assert_select "a.search-result", count: 0
+  end
+
+  test "draft cards and their comments never turn up" do
+    draft = boards(:writebook).cards.create! title: "Unpublished daydreams", creator: users(:kevin), status: :drafted
+    comment = draft.comments.build creator: users(:kevin), account: draft.account, body: "scribbled privately"
+    comment.rich_text_body.account = draft.account
+    comment.save! validate: false
+
+    get search_path(q: "Unpublished")
+    assert_select "a.search-result[href=?]", card_path(draft), count: 0
+
+    get search_path(q: "scribbled")
+    assert_select "a.search-result", count: 0
+  end
+
+  test "search escapes the query for LIKE matching" do
+    get search_path(q: "100%")
+
+    assert_response :success
+  end
+
+  test "search escapes HTML in card titles" do
+    boards(:writebook).cards.create! title: "Innocent <script>alert(1)</script> title", creator: users(:kevin), status: :published
+
+    get search_path(q: "Innocent")
+
+    assert_no_match "<script>", @response.body
+    assert_match "<mark>Innocent</mark> &lt;script&gt;", @response.body
+  end
+
+  test "search matches multi-word phrases" do
+    get search_path(q: "isn't big")
+
+    assert_match "The logo <mark>isn't big</mark> enough", @response.body
+  end
+
+  test "no matches renders a blank slate" do
+    get search_path(q: "zzz-no-such-thing-zzz")
+
+    assert_response :success
+    assert_select ".blank-slate"
+  end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..7c90c91
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "search matches on title" do
+    assert_includes Card.search("logo"), cards(:logo)
+    assert_not_includes Card.search("logo"), cards(:shipping)
+  end
+
+  test "search matches on description" do
+    cards(:logo).update! description: "<p>Make the brandmark huge</p>"
+
+    assert_includes Card.search("brandmark"), cards(:logo)
+  end
+
+  test "search matches on comment bodies" do
+    assert_includes Card.search("overflowing"), cards(:layout)
+  end
+
+  test "search is case-insensitive" do
+    assert_includes Card.search("LOGO"), cards(:logo)
+  end
+
+  test "search returns each matching card only once" do
+    cards(:logo).update! description: "<p>The logo again</p>"
+
+    assert_equal 1, Card.search("logo").where(id: cards(:logo).id).count
+  end
+
+  test "search escapes LIKE wildcards in the query" do
+    assert_empty Card.search("%")
+    assert_includes Card.search("logo"), cards(:logo)
+  end
+
+  test "search with a blank query returns no cards" do
+    assert_empty Card.search("")
+    assert_empty Card.search(nil)
+  end
+end
