@@ -10,4 +10,12 @@ module ExcerptHelper
     text = text.gsub(/\s+/, " ").strip
     text.truncate(length)
   end
+
+  def highlighted_excerpt(content, query, length: 200)
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+
+    if excerpt = excerpt(text, query, radius: length / 2)
+      highlight html_escape(excerpt), query
+    end
+  end
 end
