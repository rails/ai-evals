diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..c00af3d
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,19 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :search, ->(query) do
+      terms = query.to_s.strip
+
+      if terms.present?
+        pattern = "%#{ActiveRecord::Base.sanitize_sql_like(terms)}%"
+
+        where(id: Card.where("cards.title LIKE ?", pattern).select(:id))
+          .or(where(id: Card.joins(:rich_text_description).where("action_text_rich_texts.body LIKE ?", pattern).select(:id)))
+          .or(where(id: Comment.search(terms).select(:card_id)))
+      else
+        none
+      end
+    end
+  end
+end
