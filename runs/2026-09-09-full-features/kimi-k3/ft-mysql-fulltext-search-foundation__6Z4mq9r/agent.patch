diff --git a/app/controllers/searches_controller.rb b/app/controllers/searches_controller.rb
new file mode 100644
index 0000000..3861529
--- /dev/null
+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,22 @@
+class SearchesController < ApplicationController
+  MAX_RESULTS = 50
+
+  def show
+    @query = params[:q].to_s.strip
+
+    if @query.present?
+      @cards = Current.user.accessible_cards.published.search(@query)
+        .reverse_chronologically
+        .includes(:board)
+        .with_rich_text_description
+        .limit(MAX_RESULTS)
+      @comments_by_card_id = Comment.search(@query).where(card: @cards)
+        .with_rich_text_body
+        .includes(:creator)
+        .group_by(&:card_id)
+    else
+      @cards = Card.none
+      @comments_by_card_id = {}
+    end
+  end
+end
