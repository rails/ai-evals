diff --git a/app/views/searches/_card.html.erb b/app/views/searches/_card.html.erb
new file mode 100644
index 0000000..5dfed2e
--- /dev/null
+++ b/app/views/searches/_card.html.erb
@@ -0,0 +1,18 @@
+<%= link_to card_path(card), class: "search-result panel shadow txt-undecorated txt-ink" do %>
+  <article class="flex flex-column gap-half">
+    <header class="flex flex-column">
+      <strong class="txt-medium txt-tight-lines"><%= highlight html_escape(card.title.to_s), query %></strong>
+      <span class="txt-x-small txt-subtle"><%= card.board.name %> &middot; #<%= card.number %></span>
+    </header>
+
+    <% if description = highlighted_excerpt(card.description, query) %>
+      <p class="search-result__excerpt txt-small"><%= description %></p>
+    <% end %>
+
+    <% Array(comments_by_card_id[card.id]).each do |comment| %>
+      <p class="search-result__excerpt txt-small txt-subtle">
+        <strong><%= comment.creator.name %>:</strong> <%= highlighted_excerpt(comment.body, query) %>
+      </p>
+    <% end %>
+  </article>
+<% end %>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..c586483
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,24 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @page_title %></span>
+  </h1>
+<% end %>
+
+<div class="search margin-block-double">
+  <%= form_with url: search_path, method: :get do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards and comments…", class: "input full-width", autofocus: true, autocomplete: "off" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @cards.any? %>
+      <div class="search__results flex flex-column gap">
+        <%= render partial: "searches/card", collection: @cards, locals: { query: @query, comments_by_card_id: @comments_by_card_id } %>
+      </div>
+    <% else %>
+      <p class="blank-slate">No cards match &ldquo;<%= @query %>&rdquo;</p>
+    <% end %>
+  <% end %>
+</div>
