+    redirect_to saas.admin_account_path(@account), notice: "Usage limit override removed from #{@account.name}"
+  end
+
+  private
+    def set_account
+      @account = Account.find_by(id: params[:account_id]) || Account.find_by!(external_account_id: params[:account_id])
+    end
