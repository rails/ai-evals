--- /dev/null
+++ b/saas/app/views/account/settings/saas/_billing.html.erb
@@ -0,0 +1,43 @@
+<% plan = Current.account.billing_plan %>
+
+<% if Current.user.admin? %>
+  <div class="settings__panel settings__panel--billing panel shadow center">
+    <section class="settings__section settings__section--billing">
+      <header>
+        <h2 class="divider">Plan &amp; billing</h2>
+        <div>
+          This account is on the <strong><%= plan.name %></strong> plan<% if plan.paid? %> (<%= plan.price_per_month %>)<% end %>.
+        </div>
+      </header>
+
+      <div class="txt-small">
+        <div>
+          <strong><%= number_with_delimiter(Current.account.cards_used) %></strong>
+          <% if plan.card_limit %>
+            of <%= number_with_delimiter(plan.card_limit) %> cards used
+          <% else %>
+            cards used
+          <% end %>
+        </div>
+        <div>
+          <strong><%= number_to_human_size(Current.account.bytes_used) %></strong>
+          of <%= number_to_human_size(Current.account.storage_limit) %> storage used
+        </div>
+      </div>
+
+      <% if plan.free? %>
+        <div class="flex gap flex-wrap justify-center">
