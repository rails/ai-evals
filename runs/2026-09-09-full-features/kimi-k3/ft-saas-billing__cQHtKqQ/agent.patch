@@ -0,0 +1,97 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title">
+    <%= link_to "Accounts", saas.admin_accounts_path, class: "txt-ink-medium" %> /
+    <%= @page_title %>
+  </h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <div class="flex flex-column gap margin-block-half">
+      <div class="flex flex-column gap-half">
+        <header>
+          <h2 class="divider txt-medium margin-block-start">Account</h2>
+        </header>
+
+        <div class="txt-small">
+          <div>#<%= @account.external_account_id %></div>
+          <div>Signed up <%= time_ago_in_words(@account.created_at) %> ago</div>
+          <div>
+            Plan:
+            <strong><%= @account.billing_plan.name %></strong>
+            <% if @account.comped? %>
+              (comped)
+            <% end %>
+          </div>
+          <div>
+            Cards:
+            <strong><%= number_with_delimiter(@account.cards_used) %></strong>
+            /
+            <% if @account.card_limit %>
+              <%= number_with_delimiter(@account.card_limit) %>
+            <% else %>
+              unlimited
+            <% end %>
+          </div>
+          <div>
+            Storage:
+            <strong><%= number_to_human_size(@account.bytes_used) %></strong>
+            /
+            <%= number_to_human_size(@account.storage_limit) %>
+          </div>
+          <% if @account.subscription %>
+            <div>
+              Stripe customer: <%= @account.subscription.stripe_customer_id %>
+              (<%= @account.subscription.status %>)
+            </div>
+          <% end %>
+        </div>
+      </div>
+
+      <div class="flex flex-column gap-half">
+        <header>
+          <h2 class="divider txt-medium margin-block-start">Comping</h2>
+        </header>
+
+        <div class="flex gap">
+          <%= button_to "Comp", saas.admin_account_comp_path(@account), class: "btn" %>
+          <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn btn--negative" %>
+        </div>
+      </div>
+
+      <div class="flex flex-column gap-half">
+        <header>
+          <h2 class="divider txt-medium margin-block-start">Usage override</h2>
+        </header>
+
+        <% if @account.overridden_limit %>
+          <div class="txt-small">
+            Overridden to
+            <strong><%= number_with_delimiter(@account.overridden_limit.card_count) %></strong> cards and
+            <strong><%= number_to_human_size(@account.overridden_limit.bytes_used || 0) %></strong> used.
+          </div>
+        <% end %>
+
+        <%= form_with url: saas.admin_account_limit_override_path(@account), method: :post, class: "flex flex-column gap-half" do |form| %>
+          <div class="flex align-center gap-half">
+            <%= form.label :card_count, "Card count", class: "flex-item-grow" %>
+            <%= form.number_field :card_count, value: @account.cards_used, min: 0, class: "input" %>
+          </div>
+          <div class="flex align-center gap-half">
+            <%= form.label :bytes_used, "Bytes used", class: "flex-item-grow" %>
+            <%= form.number_field :bytes_used, value: @account.bytes_used, min: 0, class: "input" %>
+          </div>
+          <div class="flex gap">
+            <%= form.submit "Override", class: "btn" %>
+          </div>
+        <% end %>
+
+        <div>
+          <%= button_to "Reset", saas.admin_account_limit_override_path(@account), method: :delete, class: "btn btn--negative" %>
+        </div>
+      </div>
+    </div>
+  </div>
+</section>
