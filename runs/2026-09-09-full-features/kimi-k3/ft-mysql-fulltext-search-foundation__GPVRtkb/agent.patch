diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..045b98b
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,46 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  # "!" works as an ESCAPE character on both SQLite and MySQL, unlike "\", which
+  # needs string-literal escaping on MySQL but is not an escape in SQLite.
+  LIKE_ESCAPE_CHARACTER = "!"
+
+  included do
+    # Matches cards by title, description, or the body of any of their comments.
+    # Callers are responsible for scoping to cards the current user can see (and
+    # to published cards, so drafts and their comments never turn up).
+    scope :search, ->(query) do
+      if query.to_s.strip.present?
+        like = search_like_pattern(query)
+
+        where(<<~SQL.squish, like, like, like)
+          cards.title LIKE ? ESCAPE '!' OR
+          EXISTS (
+            SELECT 1 FROM action_text_rich_texts
+            WHERE action_text_rich_texts.record_type = 'Card'
+              AND action_text_rich_texts.record_id = cards.id
+              AND action_text_rich_texts.name = 'description'
+              AND action_text_rich_texts.body LIKE ? ESCAPE '!'
+          ) OR
+          EXISTS (
+            SELECT 1 FROM comments
+            INNER JOIN action_text_rich_texts
+              ON action_text_rich_texts.record_type = 'Comment'
+             AND action_text_rich_texts.record_id = comments.id
+             AND action_text_rich_texts.name = 'body'
+            WHERE comments.card_id = cards.id
+              AND action_text_rich_texts.body LIKE ? ESCAPE '!'
+          )
+        SQL
+      else
+        none
+      end
+    end
+  end
+
+  class_methods do
+    def search_like_pattern(query)
+      "%#{ActiveRecord::Base.sanitize_sql_like(query.to_s.strip, LIKE_ESCAPE_CHARACTER)}%"
+    end
+  end
+end
