diff --git a/app/controllers/searches_controller.rb b/app/controllers/searches_controller.rb
new file mode 100644
index 0000000..09bfb17
--- /dev/null
+++ b/app/controllers/searches_controller.rb
@@ -0,0 +1,38 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+
+    set_page_and_extract_portion_from matching_cards
+
+    @comments_by_card = matching_comments.group_by(&:card_id)
+  end
+
+  private
+    def matching_cards
+      if @query.present?
+        Current.user.accessible_cards
+          .published
+          .search(@query)
+          .reverse_chronologically
+          .includes(:board)
+          .with_rich_text_description
+      else
+        Card.none
+      end
+    end
+
+    # The comments that made the cards on this page match, so the matched words
+    # can be shown in context.
+    def matching_comments
+      if @query.present? && @page.records.any?
+        Comment
+          .where(card_id: @page.records.map(&:id))
+          .joins(:rich_text_body)
+          .where("action_text_rich_texts.body LIKE ? ESCAPE '!'", Card.search_like_pattern(@query))
+          .includes(:creator, :rich_text_body)
+          .chronologically
+      else
+        Comment.none
+      end
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..2508300
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,30 @@
+module SearchesHelper
+  def search_match?(content, query)
+    plain_text_for_search(content).match?(/#{Regexp.escape(query)}/i)
+  end
+
+  # An excerpt of the content, centered on the first occurrence of the query so
+  # the matched words are visible.
+  def search_excerpt(content, query, length: 200)
+    text = plain_text_for_search(content)
+
+    if text.length > length && (index = text.index(/#{Regexp.escape(query)}/i))
+      excerpt_start = [ index - (length - query.length) / 2, 0 ].max
+      excerpt_start = [ excerpt_start, text.length - length ].min
+
+      excerpt = +""
+      excerpt << "…" if excerpt_start.positive?
+      excerpt << text.slice(excerpt_start, length)
+      excerpt << "…" if excerpt_start + length < text.length
+      excerpt
+    else
+      text
+    end
+  end
+
+  private
+    def plain_text_for_search(content)
+      text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+      text.gsub(/\s+/, " ").strip
+    end
+end
