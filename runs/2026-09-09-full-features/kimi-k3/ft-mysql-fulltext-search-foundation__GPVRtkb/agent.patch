+<article class="search-result panel" id="<%= dom_id(card, :search_result) %>">
+  <header class="search-result__header flex align-center gap-half">
+    <h2 class="search-result__title overflow-ellipsis margin-none">
+      <%= link_to card_path(card), data: { turbo_frame: "_top" } do %>
+        <%= highlight(card.title, query) %>
+      <% end %>
+    </h2>
+    <span class="search-result__board txt-x-small translucent txt-nowrap"><%= card.board.name %></span>
+  </header>
+
+  <% if card.description.present? && search_match?(card.description, query) %>
+    <p class="search-result__excerpt margin-none">
+      <%= highlight(search_excerpt(card.description, query), query) %>
+    </p>
+  <% end %>
+
+  <% Array(comments_by_card[card.id]).each do |comment| %>
+    <p class="search-result__comment txt-small margin-none">
+      <strong><%= comment.creator.name %></strong>:
+      <%= highlight(search_excerpt(comment.body, query), query) %>
+    </p>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..2eaaf48
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,35 @@
+<% @page_title = @query.present? ? "Search results for “#{@query}”" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis"><%= @page_title %></span>
+  </h1>
+<% end %>
+
+<div class="search">
+  <%= form_with url: search_path, method: :get, class: "search__form flex align-center gap-half" do |form| %>
+    <label class="input input--actor flex align-center gap-half full-width fill-white">
+      <%= icon_tag "search" %>
+      <span class="for-screen-reader">Search cards and comments</span>
+      <%= form.search_field :q, value: @query, placeholder: "Search cards and comments…",
+            class: "input input--transparent full-width", autofocus: true, autocomplete: "off", autocorrect: "off", data: { "1p-ignore": "true" } %>
+    </label>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <% if @page.records.any? %>
+      <div class="search__results flex flex-column gap">
+        <%= with_automatic_pagination :search_results, @page do %>
+          <%= render partial: "searches/card", collection: @page.records, as: :card, locals: { query: @query, comments_by_card: @comments_by_card } %>
+        <% end %>
+      </div>
+    <% else %>
+      <p class="blank-slate">No cards match “<%= @query %>”</p>
+    <% end %>
+  <% end %>
+</div>
