diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..3502222
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,91 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    Current.session = sessions(:david)
+    sign_in_as :david
+  end
+
+  test "show without a query" do
+    get search_path
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "finds cards by title with the match highlighted" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select ".search-result__title mark", text: "logo"
+    assert_select ".search-result__title", text: /The logo isn't big enough/
+  end
+
+  test "finds cards by description with the match highlighted" do
+    boards(:writebook).cards.create! creator: users(:david), status: :published,
+      title: "Energy", description: "The flux capacitor needs replacing"
+
+    get search_path(q: "capacitor")
+
+    assert_response :success
+    assert_select ".search-result__excerpt mark", text: "capacitor"
+  end
+
+  test "finds cards by the body of any comment with the match highlighted" do
+    get search_path(q: "overflowing")
+
+    assert_response :success
+    assert_select ".search-result__title", text: "Layout is broken"
+    assert_select ".search-result__comment mark", text: "overflowing"
+  end
+
+  test "results are newest first" do
+    boards(:writebook).cards.create! creator: users(:david), status: :published,
+      title: "ZZZ-OLDER shibboleth", created_at: 2.days.ago, last_active_at: 2.days.ago
+    boards(:writebook).cards.create! creator: users(:david), status: :published,
+      title: "ZZZ-NEWER shibboleth", created_at: 1.hour.ago, last_active_at: 1.hour.ago
+
+    get search_path(q: "shibboleth")
+
+    assert_response :success
+    assert response.body.index("ZZZ-NEWER") < response.body.index("ZZZ-OLDER")
+  end
+
+  test "draft cards and their comments never turn up" do
+    card = boards(:writebook).cards.create! creator: users(:david), status: :published, title: "Hidden draft title"
+    card.comments.create! creator: users(:david), body: "Hidden draft comment"
+    card.update_column :status, :drafted
+
+    get search_path(q: "Hidden draft")
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "only shows results from boards the user can access" do
+    boards(:private).cards.create! creator: users(:kevin), status: :published, title: "Restricted matters"
+
+    get search_path(q: "Restricted")
+    assert_select ".search-result", count: 0
+
+    logout_and_sign_in_as :kevin
+    get search_path(q: "Restricted")
+    assert_select ".search-result", count: 1
+    assert_select ".search-result__title mark", text: "Restricted"
+  end
+
+  test "does not show cards from other accounts" do
+    get search_path(q: "radio")
+
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    get search_path(q: "logo")
+
+    assert_response :redirect
+  end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..194c344
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "matches cards by title" do
+    results = Card.published.search("logo")
+
+    assert_includes results, cards(:logo)
+    assert_not_includes results, cards(:layout)
+  end
+
+  test "matches cards by description" do
+    card = boards(:writebook).cards.create! creator: users(:david), status: :published,
+      title: "Plain title", description: "A very descriptive passage about flux capacitors"
+
+    assert_includes Card.published.search("flux capacitors"), card
+    assert_not_includes Card.published.search("flux capacitors"), cards(:logo)
+  end
+
+  test "matches cards by the body of any comment" do
+    results = Card.published.search("overflowing the container")
+
+    assert_includes results, cards(:layout)
+    assert_not_includes results, cards(:logo)
+  end
+
+  test "matching is case-insensitive" do
+    assert_includes Card.published.search("LOGO"), cards(:logo)
+  end
+
+  test "escapes LIKE wildcards in the query" do
+    card = boards(:writebook).cards.create! creator: users(:david), status: :published, title: "100% broken"
+
+    results = Card.published.search("100%")
+
+    assert_includes results, card
+    assert_not_includes results, cards(:logo)
+  end
+
+  test "blank queries match nothing" do
+    assert_empty Card.search("")
+    assert_empty Card.search("   ")
+    assert_empty Card.search(nil)
+  end
+end
