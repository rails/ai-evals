diff --git a/saas/test/controllers/admin/accounts_controller_test.rb b/saas/test/controllers/admin/accounts_controller_test.rb
new file mode 100644
index 0000000..5031d3f
--- /dev/null
+++ b/saas/test/controllers/admin/accounts_controller_test.rb
@@ -0,0 +1,153 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    sign_in_as :david # staff
+  end
+
+  # The admin area is untenanted; drop the default tenant prefix that the
+  # integration session would otherwise add to generated URLs.
+  def admin_accounts_path = saas.admin_accounts_path(script_name: "")
+  def admin_account_path(account) = saas.admin_account_path(account, script_name: "")
+  def admin_account_comp_path(account) = saas.admin_account_comp_path(account, script_name: "")
+  def admin_account_overridden_limit_path(account) = saas.admin_account_overridden_limit_path(account, script_name: "")
+
+  test "staff can list accounts" do
+    untenanted do
+      get admin_accounts_path
+    end
+
+    assert_response :success
+    assert_select "a", text: "37signals"
+    assert_select "a", text: "Initech LLC"
+    assert_select "a", text: "ACME"
+  end
+
+  test "account names link to their admin pages" do
+    untenanted do
+      get admin_accounts_path
+    end
+
+    assert_select "a[href='#{admin_account_path(@account)}']", text: "Initech LLC"
+  end
+
+  test "non-staff cannot list accounts" do
+    logout_and_sign_in_as :jz
+
+    untenanted do
+      get admin_accounts_path
+    end
+
+    assert_response :forbidden
+  end
+
+  test "staff can view an account page with the support tools" do
+    untenanted do
+      get admin_account_path(@account)
+    end
+
+    assert_response :success
+    assert_select "h1", text: "Initech LLC"
+    assert_select "strong", text: "Free"
+
+    assert_select "form[action='#{admin_account_comp_path(@account)}']" do
+      assert_select "button", text: "Comp"
+      assert_select "button", text: "Uncomp"
+    end
+
+    assert_select "form[action='#{admin_account_overridden_limit_path(@account)}']" do
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+      assert_select "input[type=submit][value=Override]"
+      assert_select "button", text: "Reset"
+    end
+  end
+
+  test "comp waives billing for the account" do
+    assert_difference -> { Account::BillingWaiver.count } do
+      untenanted do
+        post admin_account_comp_path(@account)
+      end
+    end
+
+    assert_redirected_to admin_account_path(@account)
+    assert @account.reload.comped?
+    assert_equal Plan.unlimited, @account.plan
+  end
+
+  test "uncomp restores billing" do
+    @account.comp
+
+    assert_difference -> { Account::BillingWaiver.count }, -1 do
+      untenanted do
+        delete admin_account_comp_path(@account)
+      end
+    end
+
+    assert_redirected_to admin_account_path(@account)
+    assert_not @account.reload.comped?
+  end
+
+  test "override sets the account's card count and bytes used" do
+    untenanted do
+      post admin_account_overridden_limit_path(@account), params: { card_count: 10_000, bytes_used: 10.gigabytes }
+    end
+
+    assert_redirected_to admin_account_path(@account)
+
+    override = @account.reload.overridden_limit
+    assert_equal 10_000, override.card_count
+    assert_equal 10.gigabytes, override.bytes_used
+    assert @account.exceeding_cards_limit?
+    assert_equal 10.gigabytes, @account.bytes_used
+  end
+
+  test "reset drops the override" do
+    @account.override_limits(card_count: 10_000, bytes_used: 10.gigabytes)
+
+    assert_difference -> { Account::OverriddenLimit.count }, -1 do
+      untenanted do
+        delete admin_account_overridden_limit_path(@account)
+      end
+    end
+
+    assert_redirected_to admin_account_path(@account)
+    assert_nil @account.reload.overridden_limit
+  end
+
+  test "non-staff cannot comp" do
+    logout_and_sign_in_as :jz
+
+    untenanted do
+      post admin_account_comp_path(@account)
+    end
+
+    assert_response :forbidden
+    assert_not @account.reload.comped?
+  end
+
+  test "admin pages cannot be reached through a tenant" do
+    get "/#{accounts(:"37s").external_account_id}/admin/accounts"
+
+assert_response :redirect
+assert_equal "http://www.example.com/#{accounts(:"37s").external_account_id}/", @response.location
+  end
+end
+
+class Admin::AccountsInvalidOverrideTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    sign_in_as :david
+  end
+
+  test "invalid override values bounce back with an alert" do
+    untenanted do
+      post saas.admin_account_overridden_limit_path(@account, script_name: ""), params: { card_count: -5 }
+    end
+
+    assert_redirected_to saas.admin_account_path(@account, script_name: "")
+    assert_nil @account.reload.overridden_limit
+    assert_equal "Card count and bytes used must be zero or more", flash[:alert]
+  end
+end
