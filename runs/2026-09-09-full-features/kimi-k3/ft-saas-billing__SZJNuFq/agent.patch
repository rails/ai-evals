+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..eb79edf
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,150 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @secret = "whsec_test_secret"
+    ENV["STRIPE_WEBHOOK_SECRET"] = @secret
+    @monthly_price_id = ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_monthly"
+    @extra_storage_price_id = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_extra_storage"
+  end
+
+  teardown do
+    ENV.delete("STRIPE_WEBHOOK_SECRET")
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+    ENV.delete("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  end
+
+  test "customer.subscription.created starts the paid plan" do
+    payload = stripe_event("customer.subscription.created", subscription_object(
+      id: "sub_123", customer: "cus_123", status: "active",
+      metadata: { account_id: @account.id },
+      price_ids: [ @monthly_price_id ]))
+
+    assert_difference -> { Account::Subscription.count } do
+      post_webhook payload
+    end
+
+    assert_response :ok
+
+    subscription = @account.reload.subscription
+    assert_equal "sub_123", subscription.stripe_subscription_id
+    assert_equal "cus_123", subscription.stripe_customer_id
+    assert_equal "active", subscription.status
+    assert_equal "unlimited", subscription.plan_key
+    assert_equal Plan.unlimited, @account.plan
+  end
+
+  test "customer.subscription.updated changes the plan" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123")
+
+    payload = stripe_event("customer.subscription.updated", subscription_object(
+      id: "sub_123", customer: "cus_123", status: "active",
+      price_ids: [ @monthly_price_id, @extra_storage_price_id ]))
+
+    post_webhook payload
+
+    assert_response :ok
+    assert_equal "unlimited_plus", @account.reload.subscription.plan_key
+    assert_equal Plan.unlimited_plus, @account.plan
+  end
+
+  test "customer.subscription.deleted drops the account back to free" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123")
+
+    payload = stripe_event("customer.subscription.deleted", subscription_object(
+      id: "sub_123", customer: "cus_123", status: "canceled", price_ids: []))
+
+    post_webhook payload
+
+    assert_response :ok
+    assert_equal "canceled", @account.reload.subscription.status
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "checkout.session.completed links the subscription to the account" do
+    stripe_subscription = subscription_object(
+      id: "sub_123", customer: "cus_123", status: "active",
+      price_ids: [ @monthly_price_id ])
+
+    Stripe::Subscription.expects(:retrieve).with("sub_123").returns(stripe_subscription)
+
+    payload = stripe_event("checkout.session.completed",
+      { id: "cs_123", customer: "cus_123", subscription: "sub_123", client_reference_id: @account.id })
+
+    post_webhook payload
+
+    assert_response :ok
+    assert_equal "sub_123", @account.reload.subscription.stripe_subscription_id
+    assert_equal Plan.unlimited, @account.plan
+  end
+
+  test "unhandled event types are acknowledged" do
+    payload = stripe_event("invoice.paid", { id: "in_123" })
+
+    post_webhook payload
+
+    assert_response :ok
+  end
+
+  test "bad signatures are rejected" do
+    untenanted do
+      post "/stripe/webhooks", params: "{}", headers: {
+        "CONTENT_TYPE" => "application/json",
+        "HTTP_STRIPE_SIGNATURE" => "t=123,v1=bogus" }
+    end
+
+    assert_response :bad_request
+  end
+
+  test "a tampered payload is rejected" do
+    payload = stripe_event("customer.subscription.created", subscription_object(
+      id: "sub_123", customer: "cus_123", status: "active",
+      metadata: { account_id: @account.id }, price_ids: [ @monthly_price_id ]))
+
+    # Sign the original payload, then post a tampered version of it.
+    signature = signature_for(payload)
+    tampered_payload = payload.gsub("sub_123", "sub_evil")
+
+    assert_no_difference -> { Account::Subscription.count } do
+      untenanted do
+        post "/stripe/webhooks", params: tampered_payload, headers: {
+          "CONTENT_TYPE" => "application/json",
+          "HTTP_STRIPE_SIGNATURE" => signature }
+      end
+    end
+
+    assert_response :bad_request
+  end
+
+  private
+    def subscription_object(id:, customer:, status:, price_ids:, metadata: {})
+      {
+        id: id, object: "subscription", customer: customer, status: status,
+        metadata: metadata,
+        current_period_end: 1.month.from_now.to_i,
+        cancel_at: nil,
+        items: { data: price_ids.map { |price_id| { price: { id: price_id, unit_amount: 20_00 } } } }
+      }
+    end
+
+    def stripe_event(type, object)
+      { id: "evt_#{SecureRandom.hex(4)}", object: "event", type: type, data: { object: object } }.to_json
+    end
+
+    def post_webhook(payload)
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: {
+          "CONTENT_TYPE" => "application/json",
+          "HTTP_STRIPE_SIGNATURE" => signature_for(payload) }
+      end
+    end
+
+    def signature_for(payload)
+      timestamp = Time.now.to_i
+      signature = OpenSSL::HMAC.hexdigest("SHA256", @secret, "#{timestamp}.#{payload}")
+      "t=#{timestamp},v1=#{signature}"
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..6f91299
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,172 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "accounts are on the free plan by default" do
+    assert_equal Plan.free, @account.plan
+    assert_not @account.comped?
+    assert_equal 1_000, @account.cards_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "an active subscription brings its plan" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active", stripe_customer_id: "cus_123")
+
+    assert_equal Plan.unlimited, @account.reload.plan
+    assert_nil @account.cards_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "unlimited+ brings 500 GB of storage" do
+    @account.create_subscription!(plan_key: "unlimited_plus", status: "active", stripe_customer_id: "cus_123")
+
+    assert_equal Plan.unlimited_plus, @account.reload.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "a canceled subscription drops the account back to free" do
+    @account.create_subscription!(plan_key: "unlimited", status: "canceled", stripe_customer_id: "cus_123")
+
+    assert_equal Plan.free, @account.reload.plan
+    assert_equal 1_000, @account.cards_limit
+  end
+
+  test "a trialing subscription is active" do
+    @account.create_subscription!(plan_key: "unlimited", status: "trialing", stripe_customer_id: "cus_123")
+
+    assert_equal Plan.unlimited, @account.reload.plan
+  end
+
+  test "comped accounts get the unlimited plan without a subscription" do
+    @account.comp
+
+    assert @account.reload.comped?
+    assert_equal Plan.unlimited, @account.plan
+    assert_nil @account.cards_limit
+  end
+
+  test "uncomp drops the waiver" do
+    @account.comp
+    @account.uncomp
+
+    assert_not @account.reload.comped?
+    assert_equal Plan.free, @account.plan
+  end
+
+  test "comped account with a subscription keeps the subscribed plan" do
+    @account.create_subscription!(plan_key: "unlimited_plus", status: "active", stripe_customer_id: "cus_123")
+    @account.comp
+
+    assert_equal Plan.unlimited_plus, @account.reload.plan
+  end
+
+  test "exceeding the card limit on the free plan" do
+    @account.update_column(:cards_count, 1_000)
+
+    assert @account.exceeding_cards_limit?
+    assert_not @account.nearing_cards_limit?
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "nearing the card limit counts down from 100 cards out" do
+    @account.update_column(:cards_count, 899)
+    assert_not @account.nearing_cards_limit?
+
+    @account.update_column(:cards_count, 900)
+    assert @account.nearing_cards_limit?
+    assert_equal 100, @account.cards_remaining
+
+    @account.update_column(:cards_count, 950)
+    assert @account.nearing_cards_limit?
+    assert_equal 50, @account.cards_remaining
+
+    @account.update_column(:cards_count, 999)
+    assert @account.nearing_cards_limit?
+    assert_equal 1, @account.cards_remaining
+  end
+
+  test "paid plans never exceed or near the card limit" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active", stripe_customer_id: "cus_123")
+    @account.update_column(:cards_count, 100_000)
+
+    assert_not @account.reload.exceeding_cards_limit?
+    assert_not @account.nearing_cards_limit?
+  end
+
+  test "overridden limits stand in for the measured usage" do
+    @account.override_limits(card_count: 1_000, bytes_used: 2.gigabytes)
+
+    assert @account.reload.exceeding_cards_limit?
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "overrides can be partial" do
+    @account.override_limits(card_count: 10)
+
+    assert_equal 10, @account.reload.overridden_limit.card_count
+    assert_nil @account.overridden_limit.bytes_used
+    assert_not @account.exceeding_cards_limit?
+  end
+
+  test "reset drops the override" do
+    @account.override_limits(card_count: 1_000, bytes_used: 2.gigabytes)
+    @account.reset_overridden_limits
+
+    assert_nil @account.reload.overridden_limit
+    assert_not @account.exceeding_cards_limit?
+    assert_not @account.exceeding_storage_limit?
+  end
+
+  test "overriding twice updates the same record" do
+    @account.override_limits(card_count: 1)
+    @account.override_limits(card_count: 2, bytes_used: 100)
+
+    assert_equal 1, Account::OverriddenLimit.where(account: @account).count
+    assert_equal 2, @account.reload.overridden_limit.card_count
+    assert_equal 100, @account.overridden_limit.bytes_used
+  end
+
+  test "canceling an account pauses the stripe subscription" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123")
+
+    Stripe::Subscription.expects(:update).with("sub_123", cancel_at_period_end: true)
+
+    @account.cancel(initiated_by: users(:mike))
+  end
+
+  test "incinerating an account cancels the stripe subscription" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123")
+
+    Stripe::Subscription.stubs(:update)
+    @account.cancel(initiated_by: users(:mike))
+
+    Stripe::Subscription.expects(:cancel).with("sub_123")
+
+    @account.incinerate
+  end
+
+  test "cancel and incinerate survive an unreachable stripe" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_offline", stripe_subscription_id: "sub_offline")
+
+    @account.cancel(initiated_by: users(:mike))
+    assert @account.reload.cancelled?
+
+    @account.incinerate
+    assert_not Account.exists?(@account.id)
+  end
+
+  test "accounts without a subscription do not talk to stripe when canceled or incinerated" do
+    Stripe::Subscription.expects(:update).never
+    Stripe::Subscription.expects(:cancel).never
+
+    @account.cancel(initiated_by: users(:mike))
+    @account.incinerate
+  end
+end
diff --git a/saas/test/models/account/subscription_test.rb b/saas/test/models/account/subscription_test.rb
new file mode 100644
index 0000000..6707993
--- /dev/null
+++ b/saas/test/models/account/subscription_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @monthly_price_id = ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_monthly"
+    @extra_storage_price_id = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_extra_storage"
+  end
+
+  teardown do
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+    ENV.delete("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  end
+
+  test "syncs a new subscription from stripe, deriving the plan from its prices" do
+    stripe_subscription = stripe_subscription(
+      id: "sub_123", customer: "cus_123", status: "active",
+      account_id: @account.id, price_ids: [ @monthly_price_id ],
+      current_period_end: 1.month.from_now.to_i)
+
+    assert_difference -> { Account::Subscription.count } do
+      Account::Subscription.sync_from_stripe(stripe_subscription)
+    end
+
+    subscription = @account.reload.subscription
+    assert_equal "sub_123", subscription.stripe_subscription_id
+    assert_equal "cus_123", subscription.stripe_customer_id
+    assert_equal "active", subscription.status
+    assert_equal "unlimited", subscription.plan_key
+    assert_equal 20_00, subscription.next_amount_due_in_cents
+    assert_equal Time.at(1.month.from_now.to_i).utc, subscription.current_period_end.change(usec: 0)
+    assert subscription.active?
+    assert_equal Plan.unlimited, @account.plan
+  end
+
+  test "syncs the unlimited+ plan when the extra storage price is present" do
+    Account::Subscription.sync_from_stripe stripe_subscription(
+      id: "sub_123", customer: "cus_123", status: "active",
+      account_id: @account.id, price_ids: [ @monthly_price_id, @extra_storage_price_id ])
+
+    assert_equal "unlimited_plus", @account.reload.subscription.plan_key
+    assert_equal Plan.unlimited_plus, @account.plan
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "syncs an existing subscription matched by stripe subscription id" do
+    subscription = @account.create_subscription!(plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123")
+
+    assert_no_difference -> { Account::Subscription.count } do
+      Account::Subscription.sync_from_stripe stripe_subscription(
+        id: "sub_123", customer: "cus_123", status: "past_due", price_ids: [])
+    end
+
+    assert_equal "past_due", subscription.reload.status
+    assert subscription.active?
+    assert_equal Plan.unlimited, @account.reload.plan
+  end
+
+  test "syncs a re-subscription matched by stripe customer id" do
+    subscription = @account.create_subscription!(plan_key: "unlimited", status: "canceled",
+      stripe_customer_id: "cus_123", stripe_subscription_id: "sub_old")
+
+    assert_no_difference -> { Account::Subscription.count } do
+      Account::Subscription.sync_from_stripe stripe_subscription(
+        id: "sub_new", customer: "cus_123", status: "active", price_ids: [ @monthly_price_id ])
+    end
+
+    assert_equal "sub_new", subscription.reload.stripe_subscription_id
+    assert_equal "active", subscription.status
+    assert_equal Plan.unlimited, @account.reload.plan
+  end
+
+  test "prefers the metadata plan key over price ids" do
+    Account::Subscription.sync_from_stripe stripe_subscription(
+      id: "sub_123", customer: "cus_123", status: "active",
+      account_id: @account.id, plan_key: "unlimited_plus", price_ids: [ @monthly_price_id ])
+
+    assert_equal "unlimited_plus", @account.reload.subscription.plan_key
+  end
+
+  test "ignores subscriptions for unknown accounts" do
+    assert_no_difference -> { Account::Subscription.count } do
+      subscription = Account::Subscription.sync_from_stripe stripe_subscription(
+        id: "sub_123", customer: "cus_unknown", status: "active", price_ids: [ @monthly_price_id ])
+
+      assert_nil subscription
+    end
+  end
+
+  test "mark canceled from stripe" do
+    subscription = @account.create_subscription!(plan_key: "unlimited", status: "active",
+      stripe_customer_id: "cus_123", stripe_subscription_id: "sub_123")
+
+    Account::Subscription.mark_canceled_from_stripe stripe_subscription(
+      id: "sub_123", customer: "cus_123", status: "canceled", price_ids: [])
+
+    assert_equal "canceled", subscription.reload.status
+    assert_not subscription.active?
+    assert_equal Plan.free, @account.reload.plan
+  end
+
+  private
+    def stripe_subscription(id:, customer:, status:, price_ids:, account_id: nil, plan_key: nil, current_period_end: nil)
+      items = price_ids.map do |price_id|
+        { price: { id: price_id, unit_amount: price_id == @extra_storage_price_id ? 5_00 : 20_00 } }
+      end
+
+      {
+        id: id,
+        customer: customer,
+        status: status,
+        items: { data: items },
+        current_period_end: current_period_end,
+        cancel_at: nil,
+        metadata: { account_id: account_id, plan_key: plan_key }.compact
+      }
+    end
+end
diff --git a/saas/test/models/plan_test.rb b/saas/test/models/plan_test.rb
new file mode 100644
index 0000000..d9a2cad
--- /dev/null
+++ b/saas/test/models/plan_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "free plan allows 1,000 cards and 1 GB" do
+    plan = Plan.free
+
+    assert_equal "free", plan.key
+    assert_equal "Free", plan.name
+    assert_equal 0, plan.price_in_cents
+    assert_equal 1_000, plan.card_limit
+    assert_equal 1.gigabyte, plan.storage_limit
+    assert plan.free?
+    assert_not plan.paid?
+  end
+
+  test "unlimited plan is $20/month with 5 GB" do
+    plan = Plan.unlimited
+
+    assert_equal "unlimited", plan.key
+    assert_equal "Unlimited", plan.name
+    assert_equal 20_00, plan.price_in_cents
+    assert_nil plan.card_limit
+    assert plan.unlimited_cards?
+    assert_equal 5.gigabytes, plan.storage_limit
+    assert plan.paid?
+  end
+
+  test "unlimited+ plan is $25/month with 500 GB" do
+    plan = Plan.unlimited_plus
+
+    assert_equal "unlimited_plus", plan.key
+    assert_equal "Unlimited+", plan.name
+    assert_equal 25_00, plan.price_in_cents
+    assert_nil plan.card_limit
+    assert_equal 500.gigabytes, plan.storage_limit
+    assert plan.paid?
+  end
+
+  test "lookup by key" do
+    assert_equal Plan.free, Plan["free"]
+    assert_equal Plan.unlimited, Plan[:unlimited]
+    assert_equal Plan.unlimited_plus, Plan["unlimited_plus"]
+    assert_nil Plan["bogus"]
+  end
+
+  test "lookup by stripe price ids" do
+    monthly = ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_monthly"
+    extra = ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_extra_storage"
+
+    assert_equal Plan.unlimited, Plan.for_stripe_price_ids([ monthly ])
+    assert_equal Plan.unlimited_plus, Plan.for_stripe_price_ids([ monthly, extra ])
+    assert_nil Plan.for_stripe_price_ids([ "price_unknown" ])
+    assert_nil Plan.for_stripe_price_ids([])
+  ensure
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+    ENV.delete("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  end
+end
