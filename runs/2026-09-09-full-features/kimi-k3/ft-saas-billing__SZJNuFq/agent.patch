+require "test_helper"
+
+class Billing::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    sign_in_as :mike # initech admin
+
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_monthly"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_extra_storage"
+
+    Stripe::Customer.stubs(:create).returns(Struct.new(:id).new("cus_new"))
+  end
+
+  teardown do
+    ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+    ENV.delete("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+  end
+
+  test "starting checkout for unlimited redirects to the stripe-hosted checkout" do
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      params[:mode] == "subscription" &&
+        params[:line_items] == [ { price: "price_monthly", quantity: 1 } ] &&
+        params[:client_reference_id] == @account.id
+    end.returns(stub_checkout_session)
+
+    post checkout_url(plan: "unlimited")
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_123"
+  end
+
+  test "unlimited+ checkout includes the extra storage price" do
+    Stripe::Checkout::Session.expects(:create).with do |params|
+      params[:line_items] == [ { price: "price_monthly", quantity: 1 }, { price: "price_extra_storage", quantity: 1 } ]
+    end.returns(stub_checkout_session)
+
+    post checkout_url(plan: "unlimited_plus")
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_123"
+  end
+
+  test "checkout reuses an existing stripe customer" do
+    @account.create_subscription!(stripe_customer_id: "cus_existing", status: "canceled")
+
+    Stripe::Customer.expects(:create).never
+    Stripe::Checkout::Session.expects(:create).with { |params| params[:customer] == "cus_existing" }.returns(stub_checkout_session)
+
+    post checkout_url(plan: "unlimited")
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test_123"
+  end
+
+  test "checkout creates a stripe customer on the fly" do
+    Stripe::Customer.expects(:create).returns(Struct.new(:id).new("cus_new"))
+    Stripe::Checkout::Session.expects(:create).with { |params| params[:customer] == "cus_new" }.returns(stub_checkout_session)
+
+    assert_difference -> { Account::Subscription.count } do
+      post checkout_url(plan: "unlimited")
+    end
+
+    assert_equal "cus_new", @account.reload.subscription.stripe_customer_id
+  end
+
+  test "cannot check out the free plan" do
+    Stripe::Checkout::Session.expects(:create).never
+
+    post checkout_url(plan: "free")
+
+    assert_response :unprocessable_entity
+  end
+
+  test "unknown plans are refused" do
+    post checkout_url(plan: "enterprise")
+
+    assert_response :unprocessable_entity
+  end
+
+  test "non-admins cannot start checkout" do
+    logout_and_sign_in_as :jz # member of 37signals
+
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.billing_checkout_path(plan: "unlimited")
+
+    assert_response :forbidden
+  end
+
+  private
+    def checkout_url(**options)
+      saas.billing_checkout_path(**options, script_name: @account.slug)
+    end
+
+    def stub_checkout_session
+      Struct.new(:url).new("https://checkout.stripe.com/c/pay/cs_test_123")
+    end
+end
