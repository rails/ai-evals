@@ -0,0 +1,21 @@
+# Hands the account off to Stripe-hosted checkout for the chosen plan.
+class Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_plan
+
+  def create
+    checkout_url = Current.account.start_stripe_checkout plan: @plan,
+      success_url: main_app.account_settings_url, cancel_url: main_app.account_settings_url
+
+    redirect_to checkout_url, allow_other_host: true
+  end
+
+  private
+    def set_plan
+      @plan = Plan[params[:plan]]
+
+      unless @plan&.paid?
+        head :unprocessable_entity
+      end
+    end
+end
