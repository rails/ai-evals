+# Hands the account off to the Stripe-hosted customer portal to manage its
+# subscription, payment method, and invoices.
+class Billing::PortalsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    if Current.account.subscription&.stripe_customer_id.present?
+      redirect_to Current.account.stripe_billing_portal_url(return_url: main_app.account_settings_url), allow_other_host: true
+    else
+      redirect_to main_app.account_settings_path, alert: "There's no subscription to manage yet"
+    end
+  end
+end
