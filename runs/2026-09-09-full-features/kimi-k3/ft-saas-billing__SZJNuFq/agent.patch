+class Admin::Accounts::OverriddenLimitsController < AdminController
+  before_action :set_account
+
+  def create
+    if @account.override_limits(card_count: params[:card_count], bytes_used: params[:bytes_used])
+      redirect_to saas.admin_account_path(@account), notice: "Limits overridden"
+    else
+      redirect_to saas.admin_account_path(@account), alert: "Card count and bytes used must be zero or more"
+    end
+  end
