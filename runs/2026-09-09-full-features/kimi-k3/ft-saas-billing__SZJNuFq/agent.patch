+      <header>
+        <h2 class="divider">Plan</h2>
+      </header>
+
+      <p class="margin-block-none">
+        This account is on the <strong><%= account.plan.name %></strong> plan<% if account.plan.paid? %> at <%= number_to_currency(account.plan.price, precision: 0) %>/month<% end %>.
+      </p>
+
+      <p class="txt-small txt-ink-medium margin-block-none">
+        <% if account.cards_limit %>
