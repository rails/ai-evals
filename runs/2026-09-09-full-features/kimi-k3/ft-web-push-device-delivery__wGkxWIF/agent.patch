@@ -0,0 +1,138 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create registers a subscription for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/davids-laptop",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/davids-laptop", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create refreshes the keys of an existing subscription for the same endpoint" do
+    existing = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/davids-laptop",
+      p256dh_key: "old-p256dh-key",
+      auth_key: "old-auth-key"
+    )
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: existing.endpoint,
+          p256dh_key: "new-p256dh-key",
+          auth_key: "new-auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "new-p256dh-key", existing.reload.p256dh_key
+    assert_equal "new-auth-key", existing.auth_key
+  end
+
+  test "create requires all subscription keys" do
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: "https://push.example.com/davids-laptop" }
+      }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create rejects blank keys" do
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/davids-laptop",
+          p256dh_key: "",
+          auth_key: ""
+        }
+      }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "cannot register a subscription for someone else" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: {
+          endpoint: "https://push.example.com/kevins-laptop",
+          p256dh_key: "p256dh-key",
+          auth_key: "auth-key"
+        }
+      }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy removes the subscription for the endpoint" do
+    subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/davids-laptop",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: subscription.endpoint }
+      }, as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy ignores unknown endpoints" do
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      delete user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: "https://push.example.com/unknown" }
+      }, as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "cannot remove someone else's subscription" do
+    assert_no_difference -> { users(:kevin).push_subscriptions.count } do
+      delete user_push_subscriptions_path(users(:kevin)), params: {
+        push_subscription: { endpoint: push_subscriptions(:kevins_phone).endpoint }
+      }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: {
+        endpoint: "https://push.example.com/davids-laptop",
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      }
+    }, as: :json
+
+    assert_response :redirect
+  end
+end
