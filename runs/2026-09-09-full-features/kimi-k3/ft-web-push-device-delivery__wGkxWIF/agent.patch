diff --git a/app/models/push_notification.rb b/app/models/push_notification.rb
new file mode 100644
index 0000000..4afd31d
--- /dev/null
+++ b/app/models/push_notification.rb
@@ -0,0 +1,45 @@
+# Builds the payload pushed to a user's devices for a notification.
+#
+# The push says what the tray says: the title and body come from the same
+# helpers that render the notification in the tray, and opening the push
+# opens the card it's about.
+class PushNotification
+  include NotificationsHelper
+  include Rails.application.routes.url_helpers
+
+  attr_reader :notification
+
+  delegate :account, :card, :source, to: :notification
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def payload
+    { title: title, body: body, url: url, tag: tag }
+  end
+
+  def title
+    case source
+    when Mention then "#{source.mentioner.first_name} @mentioned you"
+    else event_notification_title(source)
+    end
+  end
+
+  def body
+    case source
+    when Mention then source.source.mentionable_content.truncate(200)
+    else event_notification_body(source)
+    end
+  end
+
+  # A path is enough: the service worker resolves it against our own origin.
+  def url
+    card_path(card, script_name: account.slug)
+  end
+
+  # Repeat pushes about the same notification replace rather than stack.
+  def tag
+    "notification-#{notification.id}"
+  end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..1d0b2e3
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,53 @@
+# A Web Push subscription for one of a user's devices, as handed to us by the
+# browser. The browser's push service generates the endpoint and keys; we use
+# them to deliver a copy of everything that lands in the user's tray.
+#
+# Ops provisions the VAPID key pair via the VAPID_PUBLIC_KEY and
+# VAPID_PRIVATE_KEY environment variables. Without them, web push is disabled.
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: { scope: :user_id }
+
+  class << self
+    def configured?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].presence
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"].presence
+    end
+
+    def vapid_subject
+      ENV.fetch("VAPID_SUBJECT", "mailto:support@fizzy.do")
+    end
+  end
+
+  # Delivers a payload to this device. Subscriptions that the push service
+  # reports as gone or expired are removed so we stop trying to reach them.
+  def deliver(payload)
+    WebPush.payload_send \
+      message: JSON.generate(payload),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: vapid
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  end
+
+  private
+    def vapid
+      {
+        subject: self.class.vapid_subject,
+        public_key: self.class.vapid_public_key,
+        private_key: self.class.vapid_private_key
+      }
+    end
+end
