diff --git a/test/jobs/push_notification_job_test.rb b/test/jobs/push_notification_job_test.rb
new file mode 100644
index 0000000..cf58da5
--- /dev/null
+++ b/test/jobs/push_notification_job_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class PushNotificationJobTest < ActiveSupport::TestCase
+  setup do
+    @notification = notifications(:logo_assignment_kevin)
+    PushSubscription.stubs(:configured?).returns(true)
+  end
+
+  test "delivers what the tray says to each of the user's subscriptions" do
+    deliveries = capture_deliveries do
+      PushNotificationJob.perform_now(@notification)
+    end
+
+    assert_equal 2, deliveries.size
+    assert_equal %w[ https://push.example.com/kevins-desktop https://push.example.com/kevins-phone ],
+      deliveries.map { |delivery| delivery[:endpoint] }.sort
+
+    payload = JSON.parse(deliveries.first[:message], symbolize_names: true)
+    assert_equal @notification.card.title, payload[:title]
+    assert_equal "Assigned to #{@notification.source.assignees.pluck(:name).to_sentence}", payload[:body]
+    assert payload[:url].end_with?("/cards/#{@notification.card.number}")
+    assert_equal "notification-#{@notification.id}", payload[:tag]
+  end
+
+  test "does nothing when VAPID keys are not configured" do
+    PushSubscription.stubs(:configured?).returns(false)
+    WebPush.expects(:payload_send).never
+
+    PushNotificationJob.perform_now(@notification)
+  end
+
+  test "does nothing when the user has no subscriptions" do
+    WebPush.expects(:payload_send).never
+
+    PushNotificationJob.perform_now(notifications(:logo_mentioned_david))
+  end
+
+  private
+    def capture_deliveries
+      deliveries = []
+      WebPush.stubs(:payload_send).with { |options| deliveries << options; true }
+      yield
+      deliveries
+    end
+end
