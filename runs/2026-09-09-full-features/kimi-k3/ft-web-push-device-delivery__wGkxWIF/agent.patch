new file mode 100644
index 0000000..77d0bdf
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,41 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @user.with_lock do
+      @user.push_subscriptions.find_or_initialize_by(endpoint: endpoint_param).tap do |subscription|
+        subscription.update!(push_subscription_params)
+      end
+    end
+
+    head :created
+  rescue ActiveRecord::RecordInvalid
+    head :unprocessable_entity
+  end
+
+  def destroy
+    @user.push_subscriptions.where(endpoint: endpoint_param).destroy_all
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    # A device subscription identifies this user on this device -- nobody else
+    # should be able to add or remove subscriptions for them.
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def endpoint_param
+      params.expect(push_subscription: [ :endpoint ])[:endpoint]
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..b4a5293
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,145 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+// Manages this device's web push subscription from the notification settings
+// page. Turning notifications on asks the browser for permission, takes the
+// subscription the push service hands back, and registers it with the app so
+// that everything landing in the tray also reaches this device.
+export default class extends Controller {
+  static targets = [ "details", "status" ]
+  static values = {
+    subscriptionsUrl: String,
+    vapidPublicKey: String
+  }
+
+  connect() {
+    this.#reflectCurrentState()
+  }
+
+  async toggle() {
+    try {
+      if (await this.#currentSubscription()) {
+        await this.#unsubscribe()
+      } else {
+        await this.#subscribe()
+      }
+    } catch (error) {
+      console.error("Couldn't update push subscription", error)
+    }
+  }
+
+  async #subscribe() {
+    const permission = await Notification.requestPermission()
+
+    if (permission === "granted") {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#decodedVapidPublicKey
+      })
+      const response = await this.#register(subscription)
+
+      if (response.ok) {
+        this.#reflect(true)
+        this.#hideDetails()
+      } else {
+        throw new Error(`Registering the push subscription failed: ${response.statusCode}`)
+      }
+    } else {
+      // The browser blocked notifications: explain how to allow them.
+      this.#reflect(false)
+      this.#showDetails()
+    }
+  }
+
+  async #unsubscribe() {
+    const subscription = await this.#currentSubscription()
+
+    if (subscription) {
+      await this.#deregister(subscription)
+      await subscription.unsubscribe()
+    }
+
+    this.#reflect(false)
+  }
+
+  async #reflectCurrentState() {
+    if (this.#supported) {
+      this.#reflect(!!await this.#currentSubscription())
+
+      if (Notification.permission === "denied") {
+        this.#showDetails()
+      } else {
+        this.#hideDetails()
+      }
+    } else {
+      // Push isn't available here (e.g. Safari before installing as a web
+      // app), so there's nothing to toggle -- the install instructions below
+      // explain what to do instead.
+      this.statusTarget.hidden = true
+    }
+  }
+
+  #reflect(subscribed) {
+    this.element.classList.toggle("notifications--on", subscribed)
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach(target => target.hidden = false)
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach(target => target.hidden = true)
+  }
+
+  #currentSubscription() {
+    return navigator.serviceWorker.ready.then(registration => registration.pushManager.getSubscription())
+  }
+
+  #register(subscription) {
+    return post(this.subscriptionsUrlValue, {
+      responseKind: "json",
+      body: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: this.#encodeKey(subscription.getKey("p256dh")),
+          auth_key: this.#encodeKey(subscription.getKey("auth"))
+        }
+      }
+    })
+  }
+
+  #deregister(subscription) {
+    return destroy(this.subscriptionsUrlValue, {
+      responseKind: "json",
+      body: {
+        push_subscription: {
+          endpoint: subscription.endpoint
+        }
+      }
+    })
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window && this.hasVapidPublicKeyValue
+  }
+
+  // The VAPID public key arrives as URL-safe base64; subscribe() wants bytes.
+  get #decodedVapidPublicKey() {
+    const base64 = this.vapidPublicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, "=")
+    const binary = atob(padded)
+
+    return Uint8Array.from(binary, char => char.charCodeAt(0))
+  }
+
+  // The browser hands the subscription keys over as ArrayBuffers; the app
+  // expects them as URL-safe base64.
+  #encodeKey(key) {
+    let binary = ""
+
+    new Uint8Array(key).forEach(byte => binary += String.fromCharCode(byte))
+
+    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
+  }
+}
