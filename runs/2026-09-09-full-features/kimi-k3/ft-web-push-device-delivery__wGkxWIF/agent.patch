+require "test_helper"
+
+class PushNotificationTest < ActiveSupport::TestCase
+  test "payload for an event says what the tray says and points at the card" do
+    notification = notifications(:layout_commented_kevin)
+
+    payload = PushNotification.new(notification).payload
+
+    assert_equal "RE: #{notification.card.title}", payload[:title]
+    assert_equal notification.source.eventable.body.to_plain_text.truncate(200), payload[:body]
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.number}", payload[:url]
+    assert_equal "notification-#{notification.id}", payload[:tag]
+  end
+
+  test "payload for an assignment names the assignees like the tray" do
+    notification = notifications(:logo_assignment_kevin)
+
+    payload = PushNotification.new(notification).payload
+
+    assert_equal notification.card.title, payload[:title]
+    assert_equal "Assigned to #{notification.source.assignees.pluck(:name).to_sentence}", payload[:body]
+  end
+
+  test "payload for a mention says what the tray says" do
+    notification = notifications(:logo_mentioned_david)
+
+    payload = PushNotification.new(notification).payload
+
+    assert_equal "#{notification.source.mentioner.first_name} @mentioned you", payload[:title]
+    assert_equal notification.source.source.mentionable_content.truncate(200), payload[:body]
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.number}", payload[:url]
+  end
+end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..7c57dad
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,138 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = push_subscriptions(:kevins_phone)
+  end
+
+  test "belongs to a user and defaults the account" do
+    user = users(:david)
+
+    subscription = user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/davids-laptop",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+
+    assert_equal user, subscription.user
+    assert_equal user.account, subscription.account
+  end
+
+  test "requires endpoint and keys" do
+    assert_not users(:kevin).push_subscriptions.build.valid?
+    assert_not users(:kevin).push_subscriptions.build(endpoint: "https://push.example.com/x", p256dh_key: "key", auth_key: "").valid?
+  end
+
+  test "endpoint is unique per user" do
+    duplicate = users(:kevin).push_subscriptions.build(
+      endpoint: @subscription.endpoint,
+      p256dh_key: "other-p256dh-key",
+      auth_key: "other-auth-key"
+    )
+
+    assert_not duplicate.valid?
+  end
+
+  test "same endpoint can be subscribed by another user" do
+    other = users(:david).push_subscriptions.build(
+      endpoint: @subscription.endpoint,
+      p256dh_key: "other-p256dh-key",
+      auth_key: "other-auth-key"
+    )
+
+    assert other.valid?
+  end
+
+  test "configured? reflects the VAPID env vars" do
+    with_vapid_env "public-key", "private-key" do
+      assert PushSubscription.configured?
+      assert_equal "public-key", PushSubscription.vapid_public_key
+      assert_equal "private-key", PushSubscription.vapid_private_key
+    end
+
+    with_vapid_env nil, nil do
+      assert_not PushSubscription.configured?
+    end
+  end
+
+  test "deliver sends the payload to the push service with the subscription and VAPID keys" do
+    payload = { title: "Hello", body: "Something happened", url: "/cards/1", tag: "notification-1" }
+
+    with_vapid_env "public-key", "private-key" do
+      WebPush.expects(:payload_send).with do |options|
+        options[:message] == JSON.generate(payload) &&
+          options[:endpoint] == @subscription.endpoint &&
+          options[:p256dh] == @subscription.p256dh_key &&
+          options[:auth] == @subscription.auth_key &&
+          options[:vapid][:public_key] == "public-key" &&
+          options[:vapid][:private_key] == "private-key"
+      end
+
+      @subscription.deliver(payload)
+    end
+  end
+
+  test "deliver removes subscriptions the push service has forgotten" do
+    response = stub(code: "410", body: "gone", inspect: "410")
+
+    with_vapid_env "public-key", "private-key" do
+      WebPush.expects(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.com"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        @subscription.deliver(title: "Hello")
+      end
+    end
+  end
+
+  test "deliver removes invalid subscriptions" do
+    response = stub(code: "404", body: "not found", inspect: "404")
+
+    with_vapid_env "public-key", "private-key" do
+      WebPush.expects(:payload_send).raises(WebPush::InvalidSubscription.new(response, "push.example.com"))
+
+      assert_difference -> { PushSubscription.count }, -1 do
+        @subscription.deliver(title: "Hello")
+      end
+    end
+  end
+
+  test "deliver keeps the subscription when the push service has a hiccup" do
+    response = stub(code: "500", body: "boom", inspect: "500")
+
+    with_vapid_env "public-key", "private-key" do
+      WebPush.expects(:payload_send).raises(WebPush::PushServiceError.new(response, "push.example.com"))
+
+      assert_no_difference -> { PushSubscription.count } do
+        assert_raises(WebPush::PushServiceError) { @subscription.deliver(title: "Hello") }
+      end
+    end
+  end
+
+  test "deliver sends an encrypted, VAPID-signed request to the endpoint" do
+    vapid_key = WebPush.generate_key
+    endpoint_key = WebPush.generate_key # stands in for the browser's key pair
+
+    @subscription.update!(
+      endpoint: "https://push.example.com/deliveries/new",
+      p256dh_key: endpoint_key.public_key,
+      auth_key: Base64.urlsafe_encode64(Random.new.bytes(16), padding: false)
+    )
+
+    with_vapid_env vapid_key.public_key, vapid_key.private_key do
+      request = stub_request(:post, "https://push.example.com/deliveries/new").to_return(status: 201)
+
+      @subscription.deliver(title: "Hello", body: "Something happened", url: "/cards/1")
+
+      assert_requested request
+    end
+  end
+
+  private
+    def with_vapid_env(public_key, private_key)
+      original_public_key, original_private_key = ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"]
+      ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"] = public_key, private_key
+      yield
+    ensure
+      ENV["VAPID_PUBLIC_KEY"], ENV["VAPID_PRIVATE_KEY"] = original_public_key, original_private_key
+    end
+end
