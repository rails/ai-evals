+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:kevin))
+    @comment = comments(:logo_agreement_kevin)
+    @comment.update!(created_at: 3.hours.ago)
+  end
+
+  teardown do
+    reset_browser_timezone
+  end
+
+  test "comment times render in the viewer's timezone" do
+    visit card_url(@comment.card)
+
+    assert_selector "time[data-local-time-format-value=relative]", text: /#{Regexp.escape expected_relative_text(@comment.created_at, "UTC")}/i
+
+    override_browser_timezone "America/Los_Angeles"
+    visit card_url(@comment.card)
+
+    assert_selector "time[data-local-time-format-value=relative]", text: /#{Regexp.escape expected_relative_text(@comment.created_at, "America/Los_Angeles")}/i
+  end
+
+  test "card meta renders relative times" do
+    card = cards(:logo)
+    card.update!(created_at: 5.days.ago)
+
+    visit card_url(card)
+
+    assert_selector ".card__meta-text--added time[data-local-time-format-value=ago]", text: /5 days ago/i
+  end
+
+  test "event timestamps render in the viewer's timezone" do
+    event = events(:logo_published)
+    event.update!(created_at: 2.hours.ago)
+
+    visit events_url
+
+    assert_selector ".event__timestamp time", text: event.created_at.strftime("%l:%M %p").strip
+
+    override_browser_timezone "Australia/Sydney"
+    visit events_url
+
+    assert_selector ".event__timestamp time", text: event.created_at.in_time_zone("Australia/Sydney").strftime("%l:%M %p").strip
+  end
+
+  test "day labels never shift across timezones" do
+    visit events_url
+
+    assert_selector ".events__column-header time", text: /#{Date.current.strftime("%A, %B %-d")}/i
+
+    # The day bucket was chosen by the server; a viewer behind UTC must not see
+    # it nudged to the day before.
+    override_browser_timezone "America/Los_Angeles"
+    visit events_url
+
+    assert_selector ".events__column-header time", text: /#{Date.current.strftime("%A, %B %-d")}/i
+  end
+
+  private
+    def override_browser_timezone(timezone)
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: timezone)
+    end
+
+    def reset_browser_timezone
+      page.driver.browser.execute_cdp("Emulation.setTimezoneOverride", timezoneId: "")
+    rescue StandardError
+      # The browser may already be gone; the next test gets a fresh page anyway
+    end
+
+    # Mirrors the browser's relative formatting in app/javascript/helpers/datetime_helpers.js
+    def expected_relative_text(time, zone)
+      time = time.in_time_zone(zone)
+      days_ago = (Time.now.in_time_zone(zone).to_date - time.to_date).to_i
+
+      if days_ago <= 0
+        time.strftime("%l:%M %p").strip
+      elsif days_ago == 1
+        "yesterday"
+      elsif days_ago <= 6
+        "#{days_ago} days ago"
+      else
+        time.strftime("%b %-d")
+      end
+    end
+end
