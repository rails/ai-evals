@@ -0,0 +1,81 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  include TimeHelper
+
+  test "local_time_tag sends the raw UTC timestamp for the browser to format" do
+    tag = local_time_tag Time.utc(2025, 9, 12, 18, 42), :date
+
+    assert_select parse(tag), "time[data-controller=local-time][data-local-time-format-value=date][datetime='2025-09-12T18:42:00Z']"
+  end
+
+  test "local_time_tag renders fallback text in the request timezone" do
+    Time.use_zone "America/New_York" do
+      assert_equal "2:42 PM", text_of(local_time_tag(Time.utc(2025, 9, 12, 18, 42), :time))
+    end
+  end
+
+  test "local_time_tag sends calendar dates verbatim, so they never shift across timezones" do
+    tag = local_time_tag Date.new(2025, 9, 12), :weekday_date
+
+    assert_select parse(tag), "time[datetime='2025-09-12']", text: "Friday, September 12"
+  end
+
+  test "ago fallback" do
+    assert_equal "less than a minute ago", text_of(local_time_tag(10.seconds.ago, :ago))
+    assert_equal "5 minutes ago", text_of(local_time_tag(5.minutes.ago, :ago))
+    assert_equal "about 2 hours ago", text_of(local_time_tag(2.hours.ago, :ago))
+    assert_equal "5 days ago", text_of(local_time_tag(5.days.ago, :ago))
+  end
+
+  test "until fallback counts calendar days" do
+    assert_equal "today", text_of(local_time_tag(1.hour.from_now, :until))
+    assert_equal "tomorrow", text_of(local_time_tag(1.day.from_now, :until))
+    assert_equal "in 3 days", text_of(local_time_tag(3.days.from_now, :until))
+  end
+
+  test "relative fallback" do
+    travel_to Time.utc(2025, 9, 12, 18, 42) do
+      Time.use_zone "UTC" do
+        assert_equal "4:42 PM", text_of(local_time_tag(2.hours.ago, :relative))
+        assert_equal "yesterday", text_of(local_time_tag(1.day.ago, :relative))
+        assert_equal "5 days ago", text_of(local_time_tag(5.days.ago, :relative))
+        assert_equal "Aug 31", text_of(local_time_tag(12.days.ago, :relative))
+      end
+    end
+  end
+
+  test "date fallback only includes the year when it differs from the current one" do
+    travel_to Time.utc(2025, 9, 12, 18, 42) do
+      Time.use_zone "UTC" do
+        assert_equal "Sep 12, 2024", text_of(local_time_tag(Time.utc(2024, 9, 12), :date))
+        assert_equal "Sep 1", text_of(local_time_tag(Time.utc(2025, 9, 1), :date))
+      end
+    end
+  end
+
+  test "date_with_year fallback" do
+    assert_equal "Sep 12, 2025", text_of(local_time_tag(Time.utc(2025, 9, 12), :date_with_year))
+  end
+
+  test "datetime fallback" do
+    Time.use_zone "America/New_York" do
+      assert_equal "9/12/25, 2:42 PM", text_of(local_time_tag(Time.utc(2025, 9, 12, 18, 42), :datetime)).gsub(/\s+/, " ")
+    end
+  end
+
+  test "local_time_tag passes through attributes" do
+    tag = local_time_tag Time.current, :date, class: "card__timestamp"
+
+    assert_select parse(tag), "time.card__timestamp"
+  end
+
+  private
+    def parse(html)
+      Nokogiri::HTML::DocumentFragment.parse(html)
+    end
+
+    def text_of(html)
+      parse(html).text
+    end
+end
