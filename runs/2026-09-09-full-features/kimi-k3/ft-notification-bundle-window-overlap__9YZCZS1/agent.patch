+class NotificationMailer < ApplicationMailer
+  def bundle(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.ordered.preloaded
+
+    mail to: @user.identity.email_address, subject: "#{notification_count} in #{@user.account.name}"
+  end
+
+  private
+    def notification_count
+      if @notifications.many?
+        "#{@notifications.size} new notifications"
+      else
+        "1 new notification"
+      end
+    end
+end
