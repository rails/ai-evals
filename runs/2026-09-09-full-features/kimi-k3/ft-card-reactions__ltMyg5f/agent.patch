+module ReactionsHelper
+  def reactable_reactions_path(reactable)
+    if reactable.is_a?(Comment)
+      card_comment_reactions_path(reactable.card, reactable)
+    else
+      card_reactions_path(reactable)
+    end
+  end
+
+  def new_reactable_reaction_path(reactable)
+    if reactable.is_a?(Comment)
+      new_card_comment_reaction_path(reactable.card, reactable)
+    else
+      new_card_reaction_path(reactable)
+    end
+  end
+
+  def reactable_reaction_path(reaction)
+    if reaction.reactable.is_a?(Comment)
+      card_comment_reaction_path(reaction.card, reaction.reactable, reaction)
+    else
+      card_reaction_path(reaction.card, reaction)
+    end
+  end
+
+  def reactable_reaction_url(reaction)
+    if reaction.reactable.is_a?(Comment)
+      card_comment_reaction_url(reaction.card, reaction.reactable, reaction)
+    else
+      card_reaction_url(reaction.card, reaction)
+    end
+  end
+end
