diff --git a/test/controllers/cards/reactions_controller_test.rb b/test/controllers/cards/reactions_controller_test.rb
new file mode 100644
index 0000000..39ad6e2
--- /dev/null
+++ b/test/controllers/cards/reactions_controller_test.rb
@@ -0,0 +1,140 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+    @david_card_reaction = @card.reactions.create!(content: "🎉", reacter: users(:david))
+    @kevin_card_reaction = @card.reactions.create!(content: "🔥", reacter: users(:kevin))
+    @david_comment_reaction = @comment.reactions.create!(content: "👍", reacter: users(:david))
+    @kevin_comment_reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+  end
+
+  test "index" do
+    get card_reactions_path(@card)
+    assert_response :success
+  end
+
+  test "new" do
+    get new_card_reaction_path(@card)
+    assert_response :success
+    assert_select "form[action=?]", card_reactions_path(@card)
+  end
+
+  test "create" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card, format: :turbo_stream), params: { reaction: { content: "Great work!" } }
+      assert_turbo_stream action: :replace, target: dom_id(@card, :reacting)
+    end
+  end
+
+  test "destroy" do
+    reaction = @david_card_reaction
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction, format: :turbo_stream)
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "non-owner cannot destroy reaction" do
+    assert_no_difference -> { @card.reactions.count } do
+      delete card_reaction_path(@card, @kevin_card_reaction, format: :turbo_stream)
+      assert_response :forbidden
+    end
+  end
+
+  test "index as JSON" do
+    get card_reactions_path(@card), as: :json
+
+    assert_response :success
+    assert_equal @card.reactions.count, @response.parsed_body.count
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @card.reactions.count }, 1 do
+      post card_reactions_path(@card), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👍", @response.parsed_body["content"]
+  end
+
+  test "destroy as JSON" do
+    reaction = @david_card_reaction
+
+    assert_difference -> { @card.reactions.count }, -1 do
+      delete card_reaction_path(@card, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "cannot react to a draft card" do
+    draft = boards(:writebook).cards.create!(creator: users(:david), status: :drafted)
+
+    assert_no_difference -> { Reaction.count } do
+      post card_reactions_path(draft), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+  test "index comment reactions" do
+    get card_comment_reactions_path(@card, @comment)
+    assert_response :success
+  end
+
+  test "new comment reaction" do
+    get new_card_comment_reaction_path(@card, @comment)
+    assert_response :success
+    assert_select "form[action=?]", card_comment_reactions_path(@card, @comment)
+  end
+
+  test "create comment reaction" do
+    assert_difference -> { @comment.reactions.count }, 1 do
+      post card_comment_reactions_path(@card, @comment, format: :turbo_stream), params: { reaction: { content: "Great work!" } }
+      assert_turbo_stream action: :replace, target: dom_id(@comment, :reacting)
+    end
+  end
+
+  test "destroy comment reaction" do
+    reaction = @david_comment_reaction
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction, format: :turbo_stream)
+      assert_turbo_stream action: :remove, target: dom_id(reaction)
+    end
+  end
+
+  test "non-owner cannot destroy comment reaction" do
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, @kevin_comment_reaction, format: :turbo_stream)
+      assert_response :forbidden
+    end
+  end
+
+  test "index comment reactions as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal @comment.reactions.count, @response.parsed_body.count
+  end
+
+  test "create comment reaction as JSON" do
+    assert_difference -> { @comment.reactions.count }, 1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👍", @response.parsed_body["content"]
+  end
+
+  test "destroy comment reaction as JSON" do
+    reaction = @david_comment_reaction
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+end
