@@ -0,0 +1,9 @@
+module NotificationTestHelper
+  # Creates a notification the way Notifier does. Pass +at+ to pretend the
+  # notification landed at a different time (e.g. to simulate late arrivals).
+  def notify(user, source, creator: users(:david), at: nil)
+    attributes = { user: user, source: source, creator: creator }
+    attributes[:created_at] = at if at
+    Notification.create!(attributes)
+  end
+end
