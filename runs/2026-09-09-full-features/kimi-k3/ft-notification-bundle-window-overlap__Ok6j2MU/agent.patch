@@ -0,0 +1,15 @@
+class Notification::BundleMailer < ApplicationMailer
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.order(:created_at)
+
+    mail to: @user.identity.email_address, subject: digest_subject
+  end
+
+  private
+    def digest_subject
+      count = @notifications.size
+      "#{count} new #{"notification".pluralize(count)}"
+    end
+end
