+
+    create_table :notification_bundles, id: :uuid do |t|
+      t.uuid :account_id, null: false
+      t.uuid :user_id, null: false
+      t.datetime :starts_at, null: false
+      t.datetime :ends_at, null: false
+      t.datetime :delivered_at
+
+      # Set to true while the window is open and back to NULL once it has been
+      # delivered. Combined with the unique index below, this guarantees that a
+      # user can never have two overlapping open windows (NULLs don't conflict).
+      t.boolean :open
+
+      t.timestamps
+
+      t.index [ :account_id ]
+      t.index [ :ends_at ]
+      t.index [ :user_id, :open ], unique: true
+      t.index [ :user_id ]
+    end
+
+    add_column :notifications, :notification_bundle_id, :uuid
+    add_index :notifications, [ :notification_bundle_id ]
+  end
+end
