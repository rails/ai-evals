+module Notification::Emailable
+  extend ActiveSupport::Concern
+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", foreign_key: :notification_bundle_id, optional: true, inverse_of: :notifications
+
+    after_create_commit :bundle_email
+  end
+
+  # Adds the notification to the user's open email digest window, opening one
+  # if needed. Does nothing when the user turned email digests off.
+  def bundle_email
+    Notification::Bundle.bundle(self)
+  end
+end
