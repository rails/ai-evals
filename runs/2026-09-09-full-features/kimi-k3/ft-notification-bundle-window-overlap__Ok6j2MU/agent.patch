@@ -0,0 +1,30 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  test "bundle_email_frequency defaults to never" do
+    assert_equal "never", User::Settings.new.bundle_email_frequency
+    assert_not User::Settings.new.bundles_email?
+  end
+
+  test "bundle_email_frequency can be never, every_few_hours, daily, or weekly" do
+    settings = users(:kevin).settings
+
+    %w[ never every_few_hours daily weekly ].each do |frequency|
+      settings.update!(bundle_email_frequency: frequency)
+      assert_equal frequency, settings.bundle_email_frequency
+    end
+
+    assert_not settings.update(bundle_email_frequency: "hourly")
+    assert_equal "weekly", settings.reload.bundle_email_frequency
+  end
+
+  test "bundles_email? unless the frequency is never" do
+    settings = users(:kevin).settings
+
+    settings.bundle_email_frequency = "never"
+    assert_not settings.bundles_email?
+
+    settings.bundle_email_frequency = "daily"
+    assert settings.bundles_email?
+  end
+end
