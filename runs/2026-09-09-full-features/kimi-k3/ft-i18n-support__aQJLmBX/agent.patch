diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..bc3a5b9
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,39 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :store_locale_choice
+    around_action :with_locale
+
+    etag { I18n.locale }
+  end
+
+  private
+    def store_locale_choice
+      if valid_locale?(params[:locale])
+        session[:locale] = params[:locale]
+      end
+
+      if authenticated? && valid_locale?(session[:locale]) && Current.identity.locale != session[:locale]
+        Current.identity.update(locale: session[:locale])
+      end
+    end
+
+    def with_locale(&action)
+      I18n.with_locale(current_locale, &action)
+    end
+
+    def current_locale
+      if valid_locale?(session[:locale])
+        session[:locale]
+      elsif valid_locale?(Current.identity&.locale)
+        Current.identity.locale
+      else
+        I18n.default_locale
+      end
+    end
+
+    def valid_locale?(locale)
+      locale.present? && I18n.available_locales.map(&:to_s).include?(locale.to_s)
+    end
+end
