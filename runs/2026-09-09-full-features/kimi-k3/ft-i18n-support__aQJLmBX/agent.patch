+require "test_helper"
+
+class LocaleSwitchingTest < ActionDispatch::IntegrationTest
+  test "pages render in english by default" do
+    sign_in_as :david
+
+    get root_path
+    assert_response :success
+    assert_select "html[lang=en]"
+  end
+
+  test "locale param switches locale and sticks for the session" do
+    sign_in_as :david
+
+    get root_path(locale: "ja")
+    assert_response :success
+    assert_select "html[lang=ja]"
+
+    get root_path
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "locale choice is persisted on the identity" do
+    sign_in_as :david
+
+    get root_path(locale: "ja")
+    assert_equal "ja", identities(:david).reload.locale
+  end
+
+  test "locale is restored when signing in from a clean browser" do
+    identities(:david).update!(locale: "ja")
+    logout_and_sign_in_as :david
+
+    get root_path
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "unknown locale param is ignored" do
+    sign_in_as :david
+
+    get root_path(locale: "xx")
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_nil identities(:david).reload.locale
+  end
+
+  test "locale param works for anonymous visitors" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_response :success
+      assert_select "html[lang=ja]"
+
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=ja]"
+    end
+  end
+end
