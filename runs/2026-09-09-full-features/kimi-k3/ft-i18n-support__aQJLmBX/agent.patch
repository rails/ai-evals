diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..63ce6dd
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,30 @@
+// Lightweight translations for strings rendered by our own Stimulus
+// controllers. The rich-text editor (Lexxy) ships its own strings and is
+// intentionally not covered here.
+export function currentLocale() {
+  return document.documentElement.lang || "en"
+}
+
+const translations = {
+  en: {
+    are_you_sure: "Are you sure?",
+    days: "days",
+    less_than_a_minute_ago: "Less than a minute ago",
+    no_selection: "No selection",
+    please_fill_out_this_field: "Please fill out this field",
+    stalled_for: "Stalled for"
+  },
+  ja: {
+    are_you_sure: "本当によろしいですか？",
+    days: "日",
+    less_than_a_minute_ago: "たった今",
+    no_selection: "選択なし",
+    please_fill_out_this_field: "このフィールドを入力してください",
+    stalled_for: "停滞して"
+  }
+}
+
+export function translate(key) {
+  const locale = currentLocale()
+  return translations[locale]?.[key] ?? translations.en[key]
+}
