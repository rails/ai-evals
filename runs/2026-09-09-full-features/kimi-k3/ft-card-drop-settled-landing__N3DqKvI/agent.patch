@@ -0,0 +1,208 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    page.execute_script("localStorage.clear()")
+  end
+
+  teardown do
+    page.current_window.resize_to(1200, 1000)
+  end
+
+  test "drag a card from Maybe into a column" do
+    card = cards(:buy_domain)
+    target_column = columns(:writebook_in_progress)
+
+    visit board_url(boards(:writebook))
+    assert_selector "#maybe .card##{dom_id(card, :article)}[draggable='true']"
+
+    drag_card card, to: "##{dom_id(target_column)}"
+
+    # The card lands in the target column right away…
+    assert_selector "##{dom_id(target_column)} .card##{dom_id(card, :article)}", visible: :all
+    assert_no_selector "#maybe .card##{dom_id(card, :article)}", visible: :all
+
+    # …and the save follows right behind
+    wait_until { card.reload.column == target_column }
+  end
+
+  test "drag a card between columns" do
+    card = cards(:layout)
+    source_column = columns(:writebook_triage)
+    target_column = columns(:writebook_in_progress)
+
+    visit board_url(boards(:writebook))
+    expand_column source_column
+    assert_selector "##{dom_id(source_column)} .card##{dom_id(card, :article)}[draggable='true']"
+
+    drag_card card, to: "##{dom_id(target_column)}"
+
+    assert_selector "##{dom_id(target_column)} .card##{dom_id(card, :article)}", visible: :all
+    assert_no_selector "##{dom_id(source_column)} .card##{dom_id(card, :article)}", visible: :all
+
+    wait_until { card.reload.column == target_column }
+  end
+
+  test "drag a card to Done" do
+    card = cards(:buy_domain)
+
+    visit board_url(boards(:writebook))
+    assert_selector "#maybe .card##{dom_id(card, :article)}"
+
+    drag_card card, to: "#closed-cards"
+
+    assert_selector "#closed-cards .card##{dom_id(card, :article)}", visible: :all
+
+    wait_until { card.reload.closed? }
+  end
+
+  test "drag a card to Not Now" do
+    card = cards(:buy_domain)
+
+    visit board_url(boards(:writebook))
+    assert_selector "#maybe .card##{dom_id(card, :article)}"
+
+    drag_card card, to: "#not-now"
+
+    assert_selector "#not-now .card##{dom_id(card, :article)}", visible: :all
+
+    wait_until { card.reload.postponed? }
+  end
+
+  test "dropping a card on its own container leaves it in place" do
+    card = cards(:buy_domain)
+
+    visit board_url(boards(:writebook))
+    assert_selector "#maybe .card##{dom_id(card, :article)}"
+    last_active_at = card.reload.last_active_at
+
+    drag_card card, to: "#maybe"
+
+    assert_selector "#maybe .card##{dom_id(card, :article)}"
+    sleep 0.5 # Give any (unexpected) save a chance to land
+    assert_equal last_active_at, card.reload.last_active_at
+  end
+
+  test "containers highlight while hovering them with a dragged card" do
+    card = cards(:buy_domain)
+    target_column = columns(:writebook_in_progress)
+
+    visit board_url(boards(:writebook))
+    assert_selector "#maybe .card##{dom_id(card, :article)}"
+
+    start_dragging card
+
+    assert_selector ".card##{dom_id(card, :article)}.drag-and-drop__dragged-item"
+
+    hover "##{dom_id(target_column)}"
+
+    assert_selector "##{dom_id(target_column)}.drag-and-drop__hover-container"
+
+    hover "#not-now"
+
+    assert_selector "#not-now.drag-and-drop__hover-container"
+    assert_no_selector "##{dom_id(target_column)}.drag-and-drop__hover-container"
+
+    end_drag card
+
+    assert_no_selector ".drag-and-drop__hover-container"
+    assert_no_selector ".card##{dom_id(card, :article)}.drag-and-drop__dragged-item"
+  end
+
+  test "a dropped card lands at the top of a column, below golden cards" do
+    golden_card = cards(:logo)
+    card = cards(:buy_domain)
+    target_column = columns(:writebook_triage)
+
+    visit board_url(boards(:writebook))
+    assert_selector "#maybe .card##{dom_id(card, :article)}"
+
+    drag_card card, to: "##{dom_id(target_column)}"
+
+    wait_until { card.reload.column == target_column }
+
+    assert_equal [ golden_card.id, card.id ], card_ids_in("##{dom_id(target_column)}").first(2)
+  end
+
+  test "a dropped card stays put after the save lands" do
+    card = cards(:buy_domain)
+    target_column = columns(:writebook_in_progress)
+
+    visit board_url(boards(:writebook))
+    assert_selector "#maybe .card##{dom_id(card, :article)}"
+
+    drag_card card, to: "##{dom_id(target_column)}"
+
+    assert_selector "##{dom_id(target_column)} .card##{dom_id(card, :article)}", visible: :all
+    wait_until { card.reload.column == target_column }
+
+    # Server-side renders agree with where the card was dropped
+    assert_selector "##{dom_id(target_column)} .card##{dom_id(card, :article)}", visible: :all
+    assert_equal card.id, card_ids_in("##{dom_id(target_column)}").first
+  end
+
+  test "cards are not draggable on small screens" do
+    visit board_url(boards(:writebook))
+    page.current_window.resize_to(375, 800)
+    visit board_url(boards(:writebook))
+
+    assert_selector "#maybe .card:not([draggable='true'])", visible: :all
+  end
+
+  private
+    def drag_card(card, to:)
+      page.execute_script(<<~JS, dom_id(card, :article), to)
+        const [ cardId, containerSelector ] = arguments
+        const card = document.getElementById(cardId)
+        const container = document.querySelector(containerSelector)
+        const dataTransfer = new DataTransfer()
+
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        container.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+        container.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+      JS
+    end
+
+    def start_dragging(card)
+      page.execute_script(<<~JS, dom_id(card, :article))
+        const card = document.getElementById(arguments[0])
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer: new DataTransfer() }))
+      JS
+    end
+
+    def hover(container_selector)
+      page.execute_script(<<~JS, container_selector)
+        const container = document.querySelector(arguments[0])
+        container.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: new DataTransfer() }))
+      JS
+    end
+
+    def end_drag(card)
+      page.execute_script(<<~JS, dom_id(card, :article))
+        const card = document.getElementById(arguments[0])
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer: new DataTransfer() }))
+      JS
+    end
+
+    def expand_column(column)
+      find("##{dom_id(column)} .cards__expander", visible: :all).click
+      assert_selector "##{dom_id(column)}.is-expanded"
+    end
+
+    def card_ids_in(container_selector)
+      page.evaluate_script(<<~JS)
+        Array.from(document.querySelectorAll("#{container_selector} .cards__list .card"))
+          .map(element => element.id.replace("article_card_", ""))
+      JS
+    end
+
+    def wait_until(timeout: 5)
+      Timeout.timeout(timeout) do
+        sleep 0.1 until yield
+      end
+    end
+end
