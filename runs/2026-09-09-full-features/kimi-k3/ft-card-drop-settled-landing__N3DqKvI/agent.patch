@@ -0,0 +1,44 @@
+class Cards::DropsController < ApplicationController
+  include CardScoped
+
+  def create
+    @source = current_container
+
+    if drop_target != @source
+      @card.drop_into(drop_target)
+    end
+
+    @target = drop_target
+    set_page_and_extract_portion_from @board.cards.awaiting_triage.latest.with_golden_first.preloaded if involves_stream?
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def drop_target
+      @drop_target ||= if params[:column_id].present?
+        @board.columns.find(params[:column_id])
+      else
+        params[:target].presence_in(%w[ maybe not_now closed ])&.to_sym || raise(ActionController::BadRequest)
+      end
+    end
+
+    def current_container
+      if @card.closed?
+        :closed
+      elsif @card.postponed?
+        :not_now
+      elsif @card.column
+        @card.column
+      else
+        :maybe
+      end
+    end
+
+    def involves_stream?
+      @source == :maybe || @target == :maybe
+    end
+end
