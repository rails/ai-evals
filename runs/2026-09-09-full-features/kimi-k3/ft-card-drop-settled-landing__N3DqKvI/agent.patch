@@ -0,0 +1,92 @@
+require "test_helper"
+
+class Cards::DropsControllerTest < ActionDispatch::IntegrationTest
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "drop into a column" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    assert_changes -> { card.reload.column }, from: columns(:writebook_triage), to: column do
+      post card_drop_path(card, column_id: column.id), as: :turbo_stream
+      assert_response :success
+    end
+
+    assert_turbo_stream action: :replace, target: dom_id(columns(:writebook_triage))
+    assert_turbo_stream action: :replace, target: dom_id(column)
+  end
+
+  test "drop into maybe sends the card back to triage" do
+    card = cards(:logo)
+
+    assert_changes -> { card.reload.column }, from: columns(:writebook_triage), to: nil do
+      post card_drop_path(card, target: "maybe"), as: :turbo_stream
+      assert_response :success
+    end
+
+    assert_turbo_stream action: :replace, target: dom_id(columns(:writebook_triage))
+    assert_turbo_stream action: :replace, target: "maybe"
+  end
+
+  test "drop into not now postpones the card" do
+    card = cards(:logo)
+
+    assert_changes -> { card.reload.postponed? }, from: false, to: true do
+      post card_drop_path(card, target: "not_now"), as: :turbo_stream
+      assert_response :success
+    end
+
+    assert_turbo_stream action: :replace, target: "not-now"
+  end
+
+  test "drop into done closes the card" do
+    card = cards(:logo)
+
+    assert_changes -> { card.reload.closed? }, from: false, to: true do
+      post card_drop_path(card, target: "closed"), as: :turbo_stream
+      assert_response :success
+    end
+
+    assert_turbo_stream action: :replace, target: "closed-cards"
+  end
+
+  test "drop a closed card into a column reopens it" do
+    card = cards(:shipping)
+    assert card.closed?
+
+    post card_drop_path(card, column_id: columns(:writebook_on_hold).id), as: :turbo_stream
+
+    assert_response :success
+    assert_not card.reload.closed?
+    assert_equal columns(:writebook_on_hold), card.column
+  end
+
+  test "dropping a card where it already is changes nothing" do
+    card = cards(:logo)
+
+    assert_no_changes -> { card.reload.last_active_at } do
+      post card_drop_path(card, column_id: card.column_id), as: :turbo_stream
+      assert_response :success
+    end
+  end
+
+  test "drop requires a target" do
+    post card_drop_path(cards(:logo)), as: :json
+
+    assert_response :bad_request
+  end
+
+  test "drop as JSON" do
+    card = cards(:logo)
+    column = columns(:writebook_in_progress)
+
+    post card_drop_path(card, column_id: column.id), as: :json
+
+    assert_response :no_content
+    assert_equal column, card.reload.column
+  end
+end
