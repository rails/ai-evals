+  def turbo_stream_replace_board_container(board, container, page: nil)
+    case container
+    when Column
+      turbo_stream.replace(dom_id(container), partial: "boards/show/column", method: :morph, locals: { column: container })
+    when :maybe
+      turbo_stream.replace("maybe", partial: "boards/show/stream", method: :morph, locals: { board: board, page: page })
+    when :not_now
+      turbo_stream.replace("not-now", partial: "boards/show/not_now", method: :morph, locals: { board: board })
+    when :closed
+      turbo_stream.replace("closed-cards", partial: "boards/show/closed", method: :morph, locals: { board: board })
+    end
+  end
 end
diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..04b4166
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,183 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+// Moves cards between board containers (Maybe?, columns, Not Now, Done) with drag and drop.
+// Drops are optimistic: the card lands where it was released immediately, and the save
+// happens in the background. Containers own their order, so a drop only ever moves a card
+// between containers, never within one.
+export default class extends Controller {
+  static targets = [ "container", "item" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static values = {
+    desktopBreakpoint: { type: String, default: "(min-width: 640px)" }
+  }
+
+  #draggedItem
+  #hoveredContainer
+
+  // Lifecycle
+
+  itemTargetConnected(item) {
+    if (this.#isDesktop) {
+      item.draggable = true
+      item.querySelectorAll("a, img").forEach(element => { element.draggable = false })
+    }
+  }
+
+  itemTargetDisconnected(item) {
+    item.draggable = false
+  }
+
+  // Actions
+
+  start(event) {
+    const item = event.target.closest(this.#itemSelector)
+
+    if (item) {
+      this.#draggedItem = item
+      item.classList.add(this.draggedItemClass)
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", item.id) // Required for the drag to start on Firefox
+    }
+  }
+
+  hover(event) {
+    if (this.#draggedItem) {
+      const container = this.#containerFrom(event.target)
+
+      if (container) {
+        event.preventDefault() // Required to allow dropping
+        event.dataTransfer.dropEffect = "move"
+      }
+
+      this.#highlight(container)
+    }
+  }
+
+  leave(event) {
+    if (this.#hoveredContainer && !this.#pointerInside(event, this.element)) {
+      this.#highlight(null)
+    }
+  }
+
+  drop(event) {
+    const container = this.#containerFrom(event.target)
+
+    if (this.#draggedItem && container) {
+      event.preventDefault()
+      this.#dropInto(container)
+    }
+  }
+
+  end() {
+    this.#reset()
+  }
+
+  // Private
+
+  get #isDesktop() {
+    return window.matchMedia(this.desktopBreakpointValue).matches
+  }
+
+  get #itemSelector() {
+    return `[data-${this.identifier}-target~="item"]`
+  }
+
+  get #containerSelector() {
+    return `[data-${this.identifier}-target~="container"]`
+  }
+
+  #containerFrom(element) {
+    return element.closest(this.#containerSelector)
+  }
+
+  async #dropInto(container) {
+    const item = this.#draggedItem
+    const source = this.#containerFrom(item)
+    const origin = { parent: item.parentNode, nextSibling: item.nextSibling }
+    const url = item.dataset.cardDropUrl
+
+    this.#reset()
+
+    if (container !== source && url) {
+      this.#insert(item, container)
+      await this.#save(item, container, url, origin)
+    }
+  }
+
+  #insert(item, container) {
+    const list = container.querySelector(".cards__list")
+
+    if (list) {
+      // Containers order cards by activity, so a dropped card lands at the top, except
+      // that golden cards always come first in Maybe? and in columns.
+      if (this.#sortsGoldenFirst(container) && !item.classList.contains("golden-effect")) {
+        const goldenCards = list.querySelectorAll(".card.golden-effect")
+        const lastGoldenCard = goldenCards[goldenCards.length - 1]
+
+        if (lastGoldenCard) {
+          lastGoldenCard.after(item)
+        } else {
+          list.prepend(item)
+        }
+      } else {
+        list.prepend(item)
+      }
+    }
+  }
+
+  #sortsGoldenFirst(container) {
+    return container.dataset.columnId || container.dataset.dropTarget === "maybe"
+  }
+
+  async #save(item, container, url, origin) {
+    try {
+      const response = await post(url, { body: this.#dropParams(container), responseKind: "turbo-stream" })
+
+      if (!response.ok) {
+        this.#revert(item, origin)
+      }
+    } catch (error) {
+      this.#revert(item, origin)
+    }
+  }
+
+  #dropParams(container) {
+    if (container.dataset.columnId) {
+      return { column_id: container.dataset.columnId }
+    } else {
+      return { target: container.dataset.dropTarget }
+    }
+  }
+
+  #revert(item, origin) {
+    if (!origin.parent.isConnected) return // Page morphed while saving; the next render will reconcile
+
+    if (origin.nextSibling && origin.nextSibling.parentNode === origin.parent) {
+      origin.parent.insertBefore(item, origin.nextSibling)
+    } else {
+      origin.parent.appendChild(item)
+    }
+  }
+
+  #highlight(container) {
+    if (container !== this.#hoveredContainer) {
+      this.#hoveredContainer?.classList.remove(this.hoverContainerClass)
+      container?.classList.add(this.hoverContainerClass)
+      this.#hoveredContainer = container
+    }
+  }
+
+  #pointerInside(event, element) {
+    const rect = element.getBoundingClientRect()
+
+    return event.clientX >= rect.left && event.clientX <= rect.right &&
+      event.clientY >= rect.top && event.clientY <= rect.bottom
+  }
+
+  #reset() {
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#draggedItem = null
+    this.#highlight(null)
+  }
+}
