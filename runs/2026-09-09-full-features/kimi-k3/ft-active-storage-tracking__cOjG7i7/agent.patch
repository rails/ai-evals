@@ -0,0 +1,11 @@
+class Board::RecalculateStorageUsageJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  # Many attachments can change in quick succession on a busy board; serialize
+  # recalculations per board so they don't pile up on each other.
+  limits_concurrency key: ->(board) { board }
+
+  def perform(board)
+    board.recalculate_bytes_used
+  end
+end
