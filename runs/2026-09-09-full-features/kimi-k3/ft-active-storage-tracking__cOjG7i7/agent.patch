+module Account::StorageUsage
+  extend ActiveSupport::Concern
+
+  def recalculate_bytes_used_later
+    Account::RecalculateStorageUsageJob.perform_later(self)
+  end
+
+  # The account total is cheap to keep up to date as long as each board's
+  # counter is: it is simply the sum of its boards.
