--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  test "boards are not published by default" do
+    board = boards(:writebook)
+
+    assert_not board.published?
+    assert_nil board.publication_key
+    assert_nil board.public_url
+  end
+
+  test "publish generates a publication key" do
+    board = boards(:writebook)
+
+    assert_changes -> { board.published? }, from: false, to: true do
+      board.publish
+    end
+
+    assert board.reload.publication_key.present?
+    assert_includes Board.published, board
+    assert_equal board, Board.published.find_by(publication_key: board.publication_key)
+  end
+
+  test "publishing an already published board keeps the same key" do
+    board = boards(:writebook)
+    board.publish
+    key = board.publication_key
+
+    board.publish
+
+    assert_equal key, board.reload.publication_key
+  end
+
+  test "publication keys are unique" do
+    boards(:writebook).publish
+    boards(:private).publish
+
+    assert_not_equal boards(:writebook).publication_key, boards(:private).publication_key
+  end
+
+  test "unpublish removes the publication key" do
+    board = boards(:writebook)
+    board.publish
+
+    board.unpublish
+
+    assert_not board.reload.published?
+    assert_nil board.publication_key
+    assert_nil board.public_url
+    assert_not_includes Board.published, board
+  end
+
+  test "public_url points to the public board URL" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_includes board.public_url, "/public/boards/#{board.publication_key}"
+  end
+end
