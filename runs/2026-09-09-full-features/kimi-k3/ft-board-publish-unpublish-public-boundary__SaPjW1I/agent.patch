 To change who has access, use `PUT /:account_slug/boards/:board_id` with the `user_ids` parameter.
+## Board Publication
+
+Boards can be published so that anyone with a secret public URL can view them, without needing an account. Only account admins can publish or unpublish a board.
+
+When a board is published, its JSON representation includes a `public_url` pointing to the public board at `/public/boards/:key`. When the board is not published, `public_url` is `null`.
+
+Columns of a published board can be viewed at `/public/boards/:key/columns/:id` and published cards at `/public/boards/:key/cards/:number`.
+
+### `POST /:account_slug/boards/:board_id/publication`
+
+Publishes the specified board and generates its secret public URL. Only account admins can publish a board.
+
+__Response:__
+
+Returns `201 Created` on success. Fetch the board afterwards to read its `public_url`.
+
+### `DELETE /:account_slug/boards/:board_id/publication`
+
+Unpublishes the specified board. The public URL stops working immediately. Only account admins can unpublish a board.
+
+__Response:__
+
+Returns `204 No Content` on success.
+
diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..4b465a8
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create publishes the board" do
+    board = boards(:writebook)
+    assert_not board.published?
+
+    post board_publication_path(board)
+
+    assert_redirected_to edit_board_path(board)
+    assert board.reload.published?
+    assert board.publication_key.present?
+  end
+
+  test "create as JSON" do
+    board = boards(:writebook)
+
+    post board_publication_path(board), as: :json
+
+    assert_response :created
+    assert board.reload.published?
+  end
+
+  test "destroy unpublishes the board" do
+    board = boards(:writebook)
+    board.publish
+
+    delete board_publication_path(board)
+
+    assert_redirected_to edit_board_path(board)
+    assert_not board.reload.published?
+    assert_nil board.publication_key
+  end
+
+  test "destroy as JSON" do
+    board = boards(:writebook)
+    board.publish
+
+    delete board_publication_path(board), as: :json
+
+    assert_response :no_content
+    assert_not board.reload.published?
+  end
+
+  test "members cannot publish or unpublish boards" do
+    logout_and_sign_in_as :david
+    board = boards(:writebook)
+
+    post board_publication_path(board)
+    assert_response :forbidden
+    assert_not board.reload.published?
+
+    board.publish
+
+    delete board_publication_path(board)
+    assert_response :forbidden
+    assert board.reload.published?
+  end
+
+  test "board JSON includes public_url when published" do
+    board = boards(:writebook)
+
+    get board_path(board), as: :json
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+
+    post board_publication_path(board), as: :json
+
+    get board_path(board), as: :json
+    assert_response :success
+    assert_equal board.reload.public_url, @response.parsed_body["public_url"]
+  end
+end
