+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+  end
+
+  test "show published card without signing in" do
+    get public_board_card_path(@board.publication_key, cards(:logo).number)
+    assert_response :success
+  end
+
+  test "show as JSON" do
+    get public_board_card_path(@board.publication_key, cards(:logo).number), as: :json
+
+    assert_response :success
+    assert_equal cards(:logo).title, @response.parsed_body["title"]
+  end
+
+  test "drafted cards are not visible" do
+    board = boards(:miltons_wish_list)
+    board.publish
+
+    get public_board_card_path(board.publication_key, cards(:unfinished_thoughts).number, script_name: accounts(:initech).slug)
+    assert_response :not_found
+  end
+
+  test "cards of another board are not found" do
+    other_board = boards(:private)
+    other_board.publish
+
+    get public_board_card_path(other_board.publication_key, cards(:logo).number)
+    assert_response :not_found
+  end
+
+  test "show is not found when the board is not published" do
+    key = @board.publication_key
+    @board.unpublish
+
+    get public_board_card_path(key, cards(:logo).number)
+    assert_response :not_found
+  end
+end
