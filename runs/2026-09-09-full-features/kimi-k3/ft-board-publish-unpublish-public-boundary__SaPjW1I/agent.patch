diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..b528a6b
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,47 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  PUBLICATION_KEY_LENGTH = 24
+
+  included do
+    scope :published, -> { where.not(publication_key: nil) }
+  end
+
+  class_methods do
+    def generate_unique_publication_key
+      loop do
+        key = SecureRandom.urlsafe_base64(PUBLICATION_KEY_LENGTH)
+        break key unless exists?(publication_key: key)
+      end
+    end
+  end
+
+  def published?
+    publication_key.present?
+  end
+
+  def publish
+    update! publication_key: self.class.generate_unique_publication_key unless published?
+  end
+
+  def unpublish
+    update! publication_key: nil
+  end
+
+  def public_url
+    if published?
+      Rails.application.routes.url_helpers.public_board_url(publication_key, **public_url_options)
+    end
+  end
+
+  private
+    def public_url_options
+      default_url_options.merge(script_name: account.slug)
+    end
+
+    def default_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+end
