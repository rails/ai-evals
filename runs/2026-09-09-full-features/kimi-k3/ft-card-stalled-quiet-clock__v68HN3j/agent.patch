diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..38a9b57
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,146 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:shipping) # board writebook has a 90 day auto-close period, so the burst window is 30 days
+  end
+
+  test "cards are not stalled by default" do
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "burst when three comments from at least two people land within a third of the auto-close period" do
+    @card.comments.create!(body: "First", creator: users(:kevin))
+    assert_not @card.reload.bursted_at?
+
+    @card.comments.create!(body: "Second", creator: users(:jz))
+    assert_not @card.reload.bursted_at?
+
+    @card.comments.create!(body: "Third", creator: users(:kevin))
+    assert @card.reload.bursted_at?
+  end
+
+  test "no burst when the comments come from a single person" do
+    3.times { |i| @card.comments.create!(body: "Note #{i}", creator: users(:kevin)) }
+
+    assert_not @card.reload.bursted_at?
+  end
+
+  test "no burst when the comments are spread out over more than a third of the auto-close period" do
+    travel_to (90.days / 3 + 1.day).ago do
+      @card.comments.create!(body: "Old", creator: users(:kevin))
+      @card.comments.create!(body: "Old too", creator: users(:jz))
+    end
+
+    @card.comments.create!(body: "Fresh", creator: users(:kevin))
+
+    assert_not @card.reload.bursted_at?
+  end
+
+  test "burst when someone is assigned" do
+    @card.toggle_assignment users(:kevin)
+
+    assert @card.reload.bursted_at?
+  end
+
+  test "burst when the card is reopened" do
+    @card.close
+    @card.reopen
+
+    assert @card.reload.bursted_at?
+  end
+
+  test "a card with a burst and no activity for two weeks is stalled" do
+    @card.toggle_assignment users(:kevin)
+    assert_not @card.stalled?
+
+    travel 2.weeks - 1.day do
+      assert_not @card.reload.stalled?
+    end
+
+    travel 2.weeks + 1.day do
+      assert @card.reload.stalled?
+      assert_includes Card.stalled, @card
+    end
+  end
+
+  test "any activity resets the burst" do
+    @card.toggle_assignment users(:kevin)
+    assert @card.reload.bursted_at?
+
+    travel 1.week do
+      @card.comments.create!(body: "Ping", creator: users(:kevin))
+      assert_not @card.reload.bursted_at?
+    end
+
+    travel 2.weeks + 1.day do
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+    end
+  end
+
+  test "stalled state varies the card cache version" do
+    @card.toggle_assignment users(:kevin)
+    unstalled_cache_key = nil
+
+    travel 1.minute do
+      unstalled_cache_key = @card.reload.cache_key_with_version
+    end
+
+    travel Card::Stallable::STALLED_AFTER + 1.minute do
+      assert @card.reload.stalled?
+      assert_not_equal unstalled_cache_key, @card.cache_key_with_version
+      assert_includes @card.cache_key_with_version, "stalled"
+    end
+  end
+
+  test "no burst when assigning a draft" do
+    cards(:unfinished_thoughts).toggle_assignment users(:kevin)
+
+    assert_not cards(:unfinished_thoughts).reload.bursted_at?
+    assert_not cards(:unfinished_thoughts).stalled?
+  end
+
+  test "the burst window is a third of the board auto-close period" do
+    entropies(:writebook_board).update! auto_postpone_period: 3.days
+
+    travel_to 2.days.ago do
+      @card.comments.create!(body: "Old", creator: users(:kevin))
+      @card.comments.create!(body: "Old too", creator: users(:jz))
+    end
+    @card.comments.create!(body: "Fresh", creator: users(:kevin))
+    assert_not @card.reload.bursted_at?
+
+    travel_to 12.hours.ago do
+      @card.comments.create!(body: "Recent", creator: users(:david))
+      @card.comments.create!(body: "Recent too", creator: users(:jz))
+    end
+    @card.comments.create!(body: "Now", creator: users(:kevin))
+    assert @card.reload.bursted_at?
+  end
+
+  test "the burst window falls back to the account auto-close period" do
+    entropies(:writebook_board).destroy
+
+    travel_to (30.days / 3 + 1.day).ago do
+      @card.comments.create!(body: "Old", creator: users(:kevin))
+      @card.comments.create!(body: "Old too", creator: users(:jz))
+    end
+    @card.comments.create!(body: "Fresh", creator: users(:kevin))
+
+    assert_not @card.reload.bursted_at?
+  end
+
+  test "system comments do not count towards a burst" do
+    card = cards(:layout) # one existing comment by david
+
+    travel_to 1.hour.ago do
+      card.comments.create!(body: "Automated", creator: users(:system))
+    end
+    card.comments.create!(body: "Real", creator: users(:kevin))
+
+    assert_not card.reload.bursted_at?
+  end
+end
