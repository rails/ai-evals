index 0000000..72dc264
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,42 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  BURST_COMMENTS_THRESHOLD = 3
+  BURST_COMMENTERS_THRESHOLD = 2
+
+  included do
+    scope :stalled, -> { where.not(bursted_at: nil).where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def stalled?
+    bursted_at? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  # Varies the cache key with the stalled state so the badge shows up even
+  # though stalling happens without the card being touched.
+  def cache_version
+    [ super, ("stalled" if stalled?) ].compact_blank.join("-").presence
+  end
+
+  def record_burst
+    update!(bursted_at: Time.current) if published?
+  end
+
+  def record_comment_burst
+    record_burst if comment_burst?
+  end
+
+  private
+    def comment_burst?
+      recent_comments = comments.by_user.where(created_at: burst_period.ago..)
+
+      recent_comments.count >= BURST_COMMENTS_THRESHOLD &&
+        recent_comments.distinct.count(:creator_id) >= BURST_COMMENTERS_THRESHOLD
+    end
+
+    def burst_period
+      (auto_postpone_period / 3).seconds
+    end
+end
