diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..090e0cb
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,110 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  STALLED_INACTIVITY_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> {
+      active.where("cards.last_active_at <= ?", STALLED_INACTIVITY_PERIOD.ago)
+        .where(id: burst_card_ids)
+    }
+  end
+
+  class_methods do
+    def burst_card_ids
+      assigned_ids = Assignment.distinct.pluck(:card_id)
+      assigned_event_ids = Event.where(action: "card_assigned", eventable_type: "Card").distinct.pluck(:eventable_id)
+      reopened_ids = Event.where(action: "card_reopened", eventable_type: "Card").distinct.pluck(:eventable_id)
+      comment_ids = comment_burst_card_ids
+
+      (assigned_ids + assigned_event_ids + reopened_ids + comment_ids).uniq
+    end
+
+    def comment_burst_card_ids
+      # Only cards with 3+ user comments can have a comment burst.
+      grouped = Comment.by_user.order(:created_at).pluck(:card_id, :created_at, :creator_id).group_by(&:first)
+      candidate_ids = grouped.select { |_, rows| rows.size >= 3 }.keys
+      return [] if candidate_ids.empty?
+
+      periods = {}
+      Card.where(id: candidate_ids).includes(board: :entropy).find_each do |card|
+        begin
+          periods[card.id] = card.board.auto_postpone_period
+        rescue StandardError
+          next
+        end
+      end
+
+      grouped.filter_map do |card_id, rows|
+        next if rows.size < 3
+        period = periods[card_id]
+        next unless period
+
+        window = period.to_f / 3
+        sorted = rows.sort_by { |r| r[1] }
+        times = sorted.map { |r| r[1] }
+        creators = sorted.map { |r| r[2] }
+
+        burst = false
+        (0...sorted.size).each do |i|
+          distinct = Set.new
+          count = 0
+          (i...sorted.size).each do |j|
+            break if (times[j] - times[i]).to_f > window
+            distinct << creators[j]
+            count += 1
+            if count >= 3 && distinct.size >= 2
+              burst = true
+              break
+            end
+          end
+          break if burst
+        end
+
+        card_id if burst
+      end
+    end
+  end
+
+  def burst?
+    comment_burst? || assigned_burst? || reopened_burst?
+  end
+
+  def comment_burst?
+    window = board.auto_postpone_period.to_f / 3
+    rows = comments.by_user.order(:created_at).pluck(:created_at, :creator_id)
+    return false if rows.size < 3
+
+    times = rows.map(&:first)
+    creators = rows.map(&:last)
+
+    (0...rows.size).each do |i|
+      distinct = Set.new
+      count = 0
+      (i...rows.size).each do |j|
+        break if (times[j] - times[i]).to_f > window
+        distinct << creators[j]
+        count += 1
+        return true if count >= 3 && distinct.size >= 2
+      end
+    end
+    false
+  rescue StandardError
+    false
+  end
+
+  def assigned_burst?
+    assignments.exists? || events.where(action: "card_assigned").exists?
+  end
+
+  def reopened_burst?
+    events.where(action: "card_reopened").exists?
+  end
+
+  def stalled?
+    return false unless last_active_at
+    return false unless published? && active?
+    return false if last_active_at > STALLED_INACTIVITY_PERIOD.ago
+    burst?
+  end
+end
