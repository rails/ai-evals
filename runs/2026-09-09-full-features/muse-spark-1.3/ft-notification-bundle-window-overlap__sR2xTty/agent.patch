new file mode 100644
index 0000000..a8a3be2
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,40 @@
+class NotificationMailer < ApplicationMailer
+  def digest(bundle)
+    prepare(bundle)
+    mail(
+      to: @user.identity.email_address,
+      subject: "You have #{@notifications.size} new notification#{'s' if @notifications.size != 1}"
+    )
+  ensure
+    Current.account = nil
+  end
+
+  def bundle(bundle)
+    prepare(bundle)
+    mail(
+      to: @user.identity.email_address,
+      subject: "You have #{@notifications.size} new notification#{'s' if @notifications.size != 1}"
+    )
+  ensure
+    Current.account = nil
+  end
+
+  def email_bundle(bundle)
+    prepare(bundle)
+    mail(
+      to: @user.identity.email_address,
+      subject: "You have #{@notifications.size} new notification#{'s' if @notifications.size != 1}"
+    )
+  ensure
+    Current.account = nil
+  end
+
+  private
+    def prepare(bundle)
+      @bundle = bundle
+      @user = bundle.user
+      @account = bundle.account
+      @notifications = bundle.notifications.preloaded.order(:created_at).to_a
+      Current.account = @account
+    end
+end
