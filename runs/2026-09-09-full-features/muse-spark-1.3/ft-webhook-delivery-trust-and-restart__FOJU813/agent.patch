diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..b916ebb
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,25 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_success!
+    update!(consecutive_failures_count: 0, first_failure_at: nil) if consecutive_failures_count != 0 || first_failure_at.present?
+  end
+
+  def record_failure!
+    now = Time.current
+
+    if first_failure_at.nil? || first_failure_at < FAILURE_WINDOW.ago
+      update!(consecutive_failures_count: 1, first_failure_at: now)
+    else
+      update!(consecutive_failures_count: consecutive_failures_count + 1)
+    end
+
+    if consecutive_failures_count >= FAILURE_THRESHOLD
+      webhook.deactivate unless webhook.active == false
+    end
+  end
+end
