+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @terms = @query.split(/\s+/).reject(&:blank?)
+
+    if @terms.any?
+      @cards = search_cards.preload(:board, :rich_text_description, comments: :rich_text_body)
+    else
+      @cards = Card.none
+    end
+  end
+
+  private
+    def search_cards
+      relation = Current.user.accessible_cards.published.reverse_chronologically
+      relation = relation.where(cards: { account_id: Current.account.id })
+
+      @terms.each do |term|
+        pattern = "%#{ActiveRecord::Base.sanitize_sql_like(term)}%"
+        relation = relation.where(search_condition, pattern: pattern)
+      end
+
+      relation.distinct
+    end
+
+    def search_condition
+      <<~SQL.squish
+        cards.title LIKE :pattern ESCAPE '\\'
+        OR EXISTS (
+          SELECT 1 FROM action_text_rich_texts
+          WHERE action_text_rich_texts.record_type = 'Card'
+            AND action_text_rich_texts.record_id = cards.id
+            AND action_text_rich_texts.name = 'description'
+            AND action_text_rich_texts.body LIKE :pattern ESCAPE '\\'
+        )
+        OR EXISTS (
+          SELECT 1 FROM comments
+          INNER JOIN action_text_rich_texts AS comment_rich_texts
+            ON comment_rich_texts.record_type = 'Comment'
+            AND comment_rich_texts.record_id = comments.id
+            AND comment_rich_texts.name = 'body'
+          WHERE comments.card_id = cards.id
+            AND comment_rich_texts.body LIKE :pattern ESCAPE '\\'
+        )
+      SQL
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
