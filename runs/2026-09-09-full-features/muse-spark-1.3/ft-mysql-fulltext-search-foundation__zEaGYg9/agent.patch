+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,44 @@
+module SearchesHelper
+  def search_highlight(text, terms)
+    highlight(text.to_s, terms)
+  end
+
+  def search_excerpt(text, terms, length: 300, radius: 100)
+    plain = text.to_s
+    if plain.blank?
+      ""
+    else
+      found = terms.find { |term| plain.downcase.include?(term.downcase) }
+      if found
+        context = excerpt(plain, found, radius: radius)
+        context = plain.truncate(length) if context.blank?
+        highlight(context, terms)
+      else
+        highlight(format_excerpt(plain, length: length), terms)
+      end
+    end
+  end
+
+  def search_matching_comments(card, terms)
+    card.comments.select do |comment|
+      plain = search_comment_plain_text(comment)
+      terms.any? { |term| plain.downcase.include?(term.downcase) }
+    end
+  end
+
+  def search_comment_plain_text(comment)
+    text = comment.body&.to_plain_text.to_s
+    if text.blank? && comment.body.present?
+      text = strip_tags(comment.body.to_s)
+    end
+    text
+  end
+
+  def search_description_plain_text(card)
+    text = card.description&.to_plain_text.to_s
+    if text.blank? && card.description.present?
+      text = strip_tags(card.description.to_s)
+    end
+    text
+  end
+end
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..067c51d
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,44 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="search panel center margin pad">
+  <%= form_with url: search_path, method: :get, data: { turbo_frame: "_top" } do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: @query.blank?, class: "input full-width" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @terms.any? %>
+    <% if @cards.any? %>
+      <div class="search__results">
+        <% @cards.each do |card| %>
+          <article class="search__result" id="<%= dom_id(card) %>">
+            <h2 class="search__title">
+              <%= link_to search_highlight(card.title.to_s, @terms), card_path(card) %>
+            </h2>
+            <p class="txt-x-small">in <%= card.board.name %></p>
+
+            <% description_text = search_description_plain_text(card) %>
+            <% if description_text.present? %>
+              <div class="search__description">
+                <%= search_excerpt(description_text, @terms) %>
+              </div>
+            <% end %>
+
+            <% search_matching_comments(card, @terms).each do |comment| %>
+              <div class="search__comment">
+                <%= search_excerpt(search_comment_plain_text(comment), @terms) %>
+              </div>
+            <% end %>
+          </article>
+        <% end %>
+      </div>
+    <% else %>
+      <p class="search__empty">No cards found</p>
+    <% end %>
+  <% elsif params.key?(:q) %>
+    <p class="search__empty">Enter a search term</p>
+  <% end %>
+</section>
