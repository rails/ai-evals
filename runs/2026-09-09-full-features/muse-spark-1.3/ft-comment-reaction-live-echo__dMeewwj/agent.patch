diff --git a/app/views/cards/comments/reactions/_reactions.html.erb b/app/views/cards/comments/reactions/_reactions.html.erb
new file mode 100644
index 0000000..0cb4f3d
--- /dev/null
+++ b/app/views/cards/comments/reactions/_reactions.html.erb
@@ -0,0 +1,28 @@
+<div class="reactions" id="<%= dom_id(comment, :reactions) %>" data-controller="reaction">
+  <div class="reactions__list" id="<%= dom_id(comment, :reactions_list) %>">
+    <%= render partial: "cards/comments/reactions/reaction", collection: comment.reactions.sort_by(&:created_at), as: :reaction %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle" data-action="reaction#showForm" data-reaction-target="trigger" title="Add a reaction" aria-label="Add a reaction to this comment">
+    <%= image_tag "boost-color.svg", aria: { hidden: true }, alt: "" %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <div class="reaction reaction__form" data-reaction-target="form" hidden>
+    <%= form_with url: card_comment_reactions_path(comment.card, comment), method: :post, data: { reaction_target: "innerForm", action: "turbo:submit-end->reaction#afterSubmit" } do |form| %>
+      <label class="reaction__form-label flex align-center gap-half" aria-label="Add a reaction">
+        <span class="for-screen-reader">Reaction (max 16 characters)</span>
+        <%= form.text_field :content, required: true, maxlength: 16, size: 8, autocomplete: "off", placeholder: "React…",
+              class: "reaction__input input", data: { reaction_target: "input", action: "keydown.esc->reaction#hideForm" } %>
+      </label>
+      <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle", title: "Add reaction", aria: { label: "Confirm reaction" } do %>
+        <%= icon_tag "check" %>
+        <span class="for-screen-reader">Confirm</span>
+      <% end %>
+      <button type="button" class="reaction__cancel-btn btn btn--circle" data-action="reaction#hideForm" title="Cancel" aria-label="Cancel adding reaction">
+        <%= icon_tag "close" %>
+        <span class="for-screen-reader">Cancel</span>
+      </button>
+    <% end %>
+  </div>
+</div>
