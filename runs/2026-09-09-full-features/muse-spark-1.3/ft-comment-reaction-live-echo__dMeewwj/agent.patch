index 0000000..4b63094
--- /dev/null
+++ b/app/views/cards/comments/reactions/_reaction.html.erb
@@ -0,0 +1,15 @@
+<% mine = Current.user && reaction.reacter == Current.user %>
+<div class="reaction<%= " reaction--deleteable" if mine %>" id="<%= dom_id(reaction) %>" data-reacter-id="<%= reaction.reacter_id %>" title="<%= reaction.reacter.name %>: <%= reaction.content %>"<% if mine %> data-action="click->reaction#toggleExpanded"<% end %>>
+  <span class="reaction__avatar" title="<%= reaction.reacter.name %>" aria-label="<%= reaction.reacter.name %> reacted with <%= reaction.content %>">
+    <%= avatar_preview_tag reaction.reacter, hidden_for_screen_reader: true %>
+  </span>
+  <span class="txt-small txt-medium"><%= reaction.content %></span>
+  <% if mine %>
+    <%= button_to card_comment_reaction_path(reaction.comment.card, reaction.comment, reaction), method: :delete,
+          class: "reaction__delete btn btn--circle", title: "Remove your reaction", aria: { label: "Remove your reaction #{reaction.content}" },
+          form: { data: { action: "turbo:submit-start->reaction#willDelete" } } do %>
+      <%= icon_tag "trash" %>
+      <span class="for-screen-reader">Remove</span>
+    <% end %>
+  <% end %>
+</div>
