diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..a5b5b4e
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,56 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ destroy ]
+
+  def index
+    @reactions = @comment.reactions.includes(:reacter).order(:created_at)
+
+    respond_to do |format|
+      format.json
+      format.html { render partial: "cards/comments/reactions/reactions", locals: { comment: @comment } }
+    end
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params.merge(reacter: Current.user))
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: card_comment_reaction_url(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def destroy
+    if Current.user != @reaction.reacter
+      respond_to do |format|
+        format.turbo_stream { head :forbidden }
+        format.json { head :forbidden }
+        format.html { head :forbidden }
+      end
+      return
+    end
+
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..d9d050c
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,44 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "innerForm" ]
+
+  showForm() {
+    if (this.hasTriggerTarget) this.triggerTarget.hidden = true
+    if (this.hasFormTarget) {
+      this.formTarget.hidden = false
+      this.formTarget.classList.add("expanded")
+    }
+    this.inputTarget?.focus()
+  }
+
+  hideForm() {
+    if (this.hasFormTarget) {
+      this.formTarget.hidden = true
+      this.formTarget.classList.remove("expanded")
+    }
+    if (this.hasTriggerTarget) {
+      this.triggerTarget.hidden = false
+    }
+    if (this.hasInputTarget) this.inputTarget.value = ""
+  }
+
+  afterSubmit(event) {
+    if (event.detail.success) {
+      this.hideForm()
+    }
+  }
+
+  toggleExpanded(event) {
+    if (event.target.closest(".reaction__delete")) return
+    const reaction = event.currentTarget.closest(".reaction") || this.element.querySelector(".reaction")
+    // currentTarget is the reaction itself when action is on it
+    const target = event.currentTarget.classList?.contains("reaction") ? event.currentTarget : reaction
+    target?.classList.toggle("expanded")
+  }
+
+  willDelete(event) {
+    const reaction = event.target.closest(".reaction")
+    reaction?.classList.add("reaction--deleting")
+  }
+}
