diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..eb1549e
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,34 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_success!
+    if consecutive_failures_count != 0 || first_failure_at.present?
+      update! consecutive_failures_count: 0, first_failure_at: nil
+    end
+  end
+
+  def record_failure!
+    with_lock do
+      now = Time.current
+      new_count = consecutive_failures_count + 1
+      first = first_failure_at || now
+      update! consecutive_failures_count: new_count, first_failure_at: first
+
+      if new_count >= FAILURE_THRESHOLD && first <= FAILURE_WINDOW.ago
+        webhook.deactivate
+      end
+    end
+  end
+
+  def reset!
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  def should_deactivate?
+    consecutive_failures_count >= FAILURE_THRESHOLD && first_failure_at.present? && first_failure_at <= FAILURE_WINDOW.ago
+  end
+end
