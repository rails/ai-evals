+
   store :request, coder: JSON
   store :response, coder: JSON
 
@@ -10,6 +17,22 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  class << self
+    def cleanup
+      where(created_at: ...RETENTION_PERIOD.ago).delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver
+    if claim_for_delivery
+      perform_delivery
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -29,4 +52,124 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim_for_delivery
+      with_lock do
+        reload
+        if pending?
+          in_progress!
+          true
+        else
+          false
+        end
+      end
+    rescue ActiveRecord::StaleObjectError
+      false
+    end
+
+    def perform_delivery
+      body = payload_body
+      timestamp = Time.current.utc.iso8601
+      signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      headers = {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Timestamp" => timestamp,
+        "X-Webhook-Signature" => signature
+      }
+
+      update! request: { headers: headers, body: body }
+
+      uri = URI.parse(webhook.url)
+      endpoint_ip = SsrfProtection.resolve_public_ip(uri.host)
+
+      if endpoint_ip.nil?
+        record_error("destination_unreachable")
+      else
+        post_to_endpoint(uri, endpoint_ip, body, headers)
+      end
+    rescue StandardError => error
+      Rails.error.report(error, context: { webhook_id: webhook_id, delivery_id: id })
+      record_error(error_class_name(error))
+    end
+
+    def post_to_endpoint(uri, endpoint_ip, body, headers)
+      http = Net::HTTP.new(uri.host, uri.port)
+      http.ipaddr = endpoint_ip if http.respond_to?(:ipaddr=)
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = OPEN_TIMEOUT
+      http.read_timeout = READ_TIMEOUT
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+
+      response = http.request(request)
+      record_response(response.code.to_i)
+    rescue Net::OpenTimeout, Net::ReadTimeout, Timeout::Error
+      record_error("timeout")
+    rescue SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError
+      record_error("destination_unreachable")
+    end
+
+    def payload_body
+      JSON.generate(payload)
+    end
+
+    def payload
+      event_payload.merge(
+        "delivery_id" => id,
+        "event" => event_payload
+      )
+    end
+
+    def event_payload
+      fresh_event = event
+      {
+        "id" => fresh_event.id,
+        "action" => fresh_event.action.to_s,
+        "created_at" => fresh_event.created_at.utc.iso8601(3),
+        "board_id" => fresh_event.board_id,
+        "creator" => {
+          "id" => fresh_event.creator_id,
+          "name" => fresh_event.creator&.name
+        },
+        "eventable" => {
+          "type" => fresh_event.eventable_type,
+          "id" => fresh_event.eventable_id
+        },
+        "particulars" => fresh_event.try(:api_particulars) || {}
+      }
+    end
+
+    def record_response(code)
+      update! state: :completed, response: { code: code, error: nil }
+      track_outcome
+    end
+
+    def record_error(error_name)
+      update! state: :errored, response: { error: error_name }
+      track_outcome
+    end
+
+    def track_outcome
+      tracker = Webhook::DelinquencyTracker.find_or_create_by!(webhook: webhook)
+
+      if succeeded?
+        tracker.record_success!
+      else
+        tracker.record_failure!
+      end
+    end
+
+    def error_class_name(error)
+      case error
+      when Net::OpenTimeout, Net::ReadTimeout, Timeout::Error
+        "timeout"
+      when SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError
+        "destination_unreachable"
+      else
+        error.class.name.demodulize.underscore
+      end
+    end
 end
