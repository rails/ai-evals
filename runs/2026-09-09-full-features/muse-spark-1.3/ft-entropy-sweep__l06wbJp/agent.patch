+    def auto_postpone_all_due(batch_size: 1000)
+      now = Time.current
+      rows = boards_with_effective_periods
+
+      if rows.empty?
+        return
       end
+
+      grouped = rows.group_by { |(_board_id, account_id, period)| [ account_id, period.to_i ] }
+
+      account_ids = grouped.keys.map(&:first).uniq
+      system_users = User.where(account_id: account_ids, role: :system).index_by(&:account_id)
+
+      grouped.each do |(account_id, period), board_rows|
