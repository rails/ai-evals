diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..de163ad 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,33 @@
 module TimeHelper
+  def local_time_tag(time, format: :relative, **options)
+    if time.blank?
+      return
+    end
+
+    iso = time_to_utc_iso8601(time)
+
+    data = {
+      controller: "local-time",
+      local_time_datetime_value: iso,
+      local_time_format_value: format.to_s
+    }
+
+    if options[:data].is_a?(Hash)
+      merged = options.delete(:data)
+      data = data.merge(merged)
+    end
+
+    tag.time datetime: iso, data: data, **options
+  end
+
+  alias_method :local_time, :local_time_tag
+
+  private
+    def time_to_utc_iso8601(time)
+      if time.respond_to?(:utc)
+        time.utc.iso8601
+      else
+        time.to_time.utc.iso8601
+      end
+    end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..800f3cb
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,65 @@
+import { Controller } from "@hotwired/stimulus"
+import {
+  signedDifferenceInDays,
+  formatTime,
+  formatShortDate,
+  formatShortDateWithYear,
+  formatWeekdayDate,
+  formatDayTime,
+  formatRelative,
+  formatFull
+} from "helpers/date_helpers"
+
+export default class extends Controller {
+  static values = { datetime: String, format: String }
+
+  connect() {
+    this.update()
+  }
+
+  datetimeValueChanged() {
+    this.update()
+  }
+
+  formatValueChanged() {
+    this.update()
+  }
+
+  update() {
+    const datetime = this.datetimeValue || this.element.getAttribute("datetime")
+    if (!datetime) return
+
+    const date = new Date(datetime)
+    if (isNaN(date.getTime())) return
+
+    const format = this.formatValue || "relative"
+
+    this.element.textContent = this.#format(date, format)
+
+    try {
+      this.element.setAttribute("title", formatFull(date))
+    } catch {
+      // ignore title failures
+    }
+  }
+
+  #format(date, format) {
+    switch (format) {
+      case "relative":
+      case "time-ago":
+        return formatRelative(date, new Date())
+      case "time":
+        return formatTime(date)
+      case "date":
+        return formatShortDate(date, new Date())
+      case "date-with-year":
+        return formatShortDateWithYear(date)
+      case "weekday":
+        return formatWeekdayDate(date)
+      case "datetime":
+        return formatDayTime(date)
+      default:
+        return formatRelative(date, new Date())
+    }
+  }
+}
