diff --git a/app/models/card/stalled.rb b/app/models/card/stalled.rb
new file mode 100644
index 0000000..800225f
--- /dev/null
+++ b/app/models/card/stalled.rb
@@ -0,0 +1,112 @@
+module Card::Stalled
+  extend ActiveSupport::Concern
+
+  STALLED_INACTIVITY_PERIOD = 2.weeks
+
+  included do
+    scope :stalled, -> {
+      published.where("cards.last_active_at <= ?", STALLED_INACTIVITY_PERIOD.ago)
+        .where(
+          "cards.burst_at IS NOT NULL " \
+          "OR EXISTS (SELECT 1 FROM assignments WHERE assignments.card_id = cards.id) " \
+          "OR EXISTS (SELECT 1 FROM events WHERE events.eventable_type = 'Card' AND events.eventable_id = cards.id AND events.action IN ('card_assigned', 'card_reopened')) " \
+          "OR EXISTS (#{comment_burst_exists_sql})"
+        )
+    }
+  end
+
+  class_methods do
+    # SQL fragment for comment-burst detection used inside the stalled scope.
+    # A card has a comment burst when three or more non-system comments from
+    # at least two distinct people fall within a window of
+    # (board auto-postpone period / 3). The window is computed per card from
+    # its effective auto-postpone period (board override else account default).
+    def comment_burst_exists_sql
+      # Effective period per outer card.
+      period_sql = "(SELECT COALESCE(" \
+        "(SELECT auto_postpone_period FROM entropies WHERE container_type = 'Board' AND container_id = cards.board_id), " \
+        "(SELECT auto_postpone_period FROM entropies WHERE container_type = 'Account' AND container_id = cards.account_id)" \
+        "))"
+      window_sql = "(#{period_sql} / 3)"
+
+      # End of the window starting at anchor.created_at. Adapter-specific.
+      window_end_sql = if connection.adapter_name =~ /sqlite/i
+        "datetime(anchor.created_at, '+' || (#{window_sql}) || ' seconds')"
+      else
+        "DATE_ADD(anchor.created_at, INTERVAL #{window_sql} SECOND)"
+      end
+
+      <<~SQL.squish
+        SELECT 1 FROM comments AS anchor
+        JOIN users AS anchor_user ON anchor_user.id = anchor.creator_id
+        WHERE anchor.card_id = cards.id
+        AND anchor_user.role != 'system'
+        AND (
+          SELECT COUNT(*) FROM comments AS others
+          JOIN users AS other_user ON other_user.id = others.creator_id
+          WHERE others.card_id = cards.id
+          AND other_user.role != 'system'
+          AND others.created_at >= anchor.created_at
+          AND others.created_at <= #{window_end_sql}
+        ) >= 3
+        AND (
+          SELECT COUNT(DISTINCT others.creator_id) FROM comments AS others
+          JOIN users AS other_user ON other_user.id = others.creator_id
+          WHERE others.card_id = cards.id
+          AND other_user.role != 'system'
+          AND others.created_at >= anchor.created_at
+          AND others.created_at <= #{window_end_sql}
+        ) >= 2
+      SQL
+    end
+  end
+
+  def stalled?
+    return false unless published?
+    return false if last_active_at.blank?
+    return false unless last_active_at <= STALLED_INACTIVITY_PERIOD.ago
+    burst?
+  end
+
+  def burst?
+    burst_at.present? || assignment_burst? || reopen_burst? || comment_burst?
+  end
+
+  def assignment_burst?
+    assignments.exists? || events.where(action: "card_assigned").exists?
+  end
+
+  def reopen_burst?
+    events.where(action: "card_reopened").exists?
+  end
+
+  def comment_burst?
+    window = board.auto_postpone_period / 3.0
+    rows = comments.by_user.order(:created_at, :id).pluck(:created_at, :creator_id)
+    return false if rows.size < 3
+
+    left = 0
+    rows.each_with_index do |(time_j, _), j|
+      while time_j - rows[left].first > window
+        left += 1
+      end
+      size = j - left + 1
+      next if size < 3
+      distinct = rows[left..j].map(&:second).uniq.size
+      return true if distinct >= 2
+    end
+    false
+  end
+
+  def mark_burst!
+    return if burst_at.present?
+    update_columns(burst_at: Time.current, updated_at: Time.current)
+    self.burst_at = Time.current if has_attribute?(:burst_at)
+  rescue ActiveRecord::StatementInvalid
+    nil
+  end
+
+  def check_comment_burst!
+    mark_burst! if comment_burst?
+  end
+end
