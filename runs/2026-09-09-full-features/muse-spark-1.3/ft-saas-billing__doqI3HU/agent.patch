+module Billing
+  class PortalsController < ApplicationController
+    def create
+      customer_id = nil
+      begin
+        customer_id = Current.account.billing_subscription&.stripe_customer_id
+      rescue StandardError
+        customer_id = nil
+      end
+
+      unless customer_id.present?
+        redirect_to account_settings_path, alert: "No billing account found" and return
+      end
+
+      begin
+        ::Stripe.api_key ||= ENV["STRIPE_SECRET_KEY"]
+        host = request.base_url.gsub(%r{/\d+/?\z}, "")
+        return_url = "#{host}#{account_settings_path(script_name: Current.account.slug)}"
+        session = ::Stripe::BillingPortal::Session.create(customer: customer_id, return_url: return_url)
+        redirect_to session.url, allow_other_host: true
+      rescue StandardError => e
+        Rails.logger.warn "[Billing] Portal creation failed: #{e.class} #{e.message}"
+        redirect_to account_settings_path, alert: "Billing portal is unavailable"
+      end
+    end
+  end
+end
