diff --git a/saas/app/controllers/admin/accounts_controller.rb b/saas/app/controllers/admin/accounts_controller.rb
new file mode 100644
index 0000000..29a3410
--- /dev/null
+++ b/saas/app/controllers/admin/accounts_controller.rb
@@ -0,0 +1,64 @@
+class Admin::AccountsController < AdminController
+  layout "public"
+
+  def index
+    @accounts = Account.order(created_at: :desc).limit(100)
+  end
+
+  def show
+    @account = Account.find(params[:id])
+    @subscription = subscription_for(@account)
+  end
+
+  def comp
+    @account = Account.find(params[:id])
+    @account.comp!
+    redirect_to "/admin/accounts/#{@account.id}", notice: "Account comped"
+  end
+
+  def uncomp
+    @account = Account.find(params[:id])
+    @account.uncomp!
+    redirect_to "/admin/accounts/#{@account.id}", notice: "Comp removed"
+  end
+
+  def override
+    @account = Account.find(params[:id])
+    card_count = extract_int([ params[:card_count], params.dig(:override, :card_count), params.dig(:overridden_limit, :card_count), params.dig(:account_overridden_limit, :card_count), params.dig(:account, :card_count) ])
+    bytes_used = extract_int([ params[:bytes_used], params.dig(:override, :bytes_used), params.dig(:overridden_limit, :bytes_used), params.dig(:account_overridden_limit, :bytes_used), params.dig(:account, :bytes_used) ])
+    @account.override_limits!(card_count: card_count, bytes_used: bytes_used)
+    redirect_to "/admin/accounts/#{@account.id}", notice: "Override saved"
+  end
+
+  def reset
+    @account = Account.find(params[:id])
+    @account.reset_override!
+    redirect_to "/admin/accounts/#{@account.id}", notice: "Override reset"
+  end
+
+  private
+    def subscription_for(account)
+      account.billing_subscription || account.subscription_record
+    rescue StandardError
+      nil
+    end
+
+    def extract_int(candidates)
+      candidates.each do |v|
+        next if v.nil? || v.to_s.strip.blank?
+        begin
+          return Integer(v.to_s.strip)
+        rescue ArgumentError
+          next
+        end
+      end
+      nil
+    end
+
+    def parse_optional_int(value)
+      return nil if value.nil? || value.to_s.strip.blank?
+      Integer(value.to_s.strip)
+    rescue ArgumentError
+      nil
+    end
+end
diff --git a/saas/app/controllers/billing/checkouts_controller.rb b/saas/app/controllers/billing/checkouts_controller.rb
new file mode 100644
index 0000000..9eb1723
--- /dev/null
+++ b/saas/app/controllers/billing/checkouts_controller.rb
@@ -0,0 +1,63 @@
+module Billing
+  class CheckoutsController < ApplicationController
+    allow_unauthenticated_access only: []
+    # Requires account scope + authentication via ApplicationController defaults
+
+    def create
+      plan = params[:plan].to_s.presence || "unlimited"
+      plan = normalize_plan(plan)
+
+      price_id = ::Billing.price_id_for_plan(plan)
+
+      customer_id = stripe_customer_id_for(Current.account)
+
+      session = create_checkout_session(plan: plan, price_id: price_id, customer_id: customer_id)
+
+      if session && (session[:url] || session["url"])
+        redirect_to session[:url] || session["url"], allow_other_host: true
+      else
+        redirect_to account_settings_path, alert: "Checkout is not configured"
+      end
+    end
+
+    private
+      def normalize_plan(plan)
+        case plan.to_s.strip.downcase
+        when "unlimited+", "unlimited_plus", "unlimitedplus" then "unlimited_plus"
+        when "unlimited" then "unlimited"
+        else "unlimited"
+        end
+      end
+
+      def stripe_customer_id_for(account)
+        account.billing_subscription&.stripe_customer_id
+      rescue StandardError
+        nil
+      end
+
+      def create_checkout_session(plan:, price_id:, customer_id:)
+        return nil if price_id.blank?
+        begin
+          ::Stripe.api_key ||= ENV["STRIPE_SECRET_KEY"]
+          args = {
+            mode: "subscription",
+            line_items: [ { price: price_id, quantity: 1 } ],
+            metadata: { account_id: Current.account.id, plan: plan },
+            subscription_data: { metadata: { account_id: Current.account.id, plan: plan } }
+          }
+          args[:customer] = customer_id if customer_id.present?
+          unless customer_id.present?
+            args[:customer_email] = Current.account.owner_email
+          end
+          # Success/cancel URLs
+          host = request.base_url.gsub(%r{/\d+/?\z}, "")
+          args[:success_url] = "#{host}#{account_settings_path(script_name: Current.account.slug)}?checkout=success"
+          args[:cancel_url] = "#{host}#{account_settings_path(script_name: Current.account.slug)}?checkout=cancelled"
+          ::Stripe::Checkout::Session.create(args)
+        rescue StandardError => e
+          Rails.logger.warn "[Billing] Checkout creation failed: #{e.class} #{e.message}"
+          nil
+        end
+      end
+  end
+end
