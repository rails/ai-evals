+++ b/.kamal/secrets
@@ -0,0 +1,15 @@
+# Kamal secrets for the single-box Fizzy deploy (config/deploy.yml).
+#
+# This file is safe for git: it contains no raw credentials, only references
+# to environment variables. Set the real values in your shell before running
+# `bin/kamal setup` / `bin/kamal deploy`:
+#
+#   export KAMAL_REGISTRY_PASSWORD=...  # Docker Hub token/password for `your-user`
+#   export SECRET_KEY_BASE=$(openssl rand -hex 64)
+#   export SMTP_PASSWORD=...            # password for SMTP_USERNAME in deploy.yml
+#
+# Kamal reads each line as SECRET_NAME=$VALUE / $(command).
+
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+SMTP_PASSWORD=$SMTP_PASSWORD
