new file mode 100644
index 0000000..0d9f2df
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,95 @@
+# Fizzy — single-box Kamal config.
+#
+# Deploy everything (web + background jobs) to one Linux server with Docker,
+# using SQLite and the kamal-proxy for automatic SSL (Let's Encrypt).
+#
+# How to use (fork first, then on your machine):
+#
+#   1. Replace YOUR_SERVER_IP below with your server's IP or hostname
+#      (a Linux host with Docker installed and port 80/443 reachable).
+#   2. Replace YOUR_APP_HOST in `proxy/host` and `env/clear/APP_HOST`
+#      with the hostname Fizzy will be served at (DNS must point at the box).
+#      Fizzy will be available at https://YOUR_APP_HOST.
+#   3. Fill in your mail server under `env/clear` (SMTP_ADDRESS, SMTP_PORT,
+#      SMTP_USERNAME, ...). Magic-login codes are emailed, so this is required.
+#      Adjust MAILER_FROM_ADDRESS to an address on your domain.
+#   4. Replace `your-user` in `image` and `registry/username` with your
+#      Docker Hub username (or point `registry/server` at GHCR/another
+#      registry). Create a private repository for the image first.
+#   5. Export secrets (never commit raw values, see .kamal/secrets):
+#
+#        export KAMAL_REGISTRY_PASSWORD=...   # Docker registry token/password
+#        export SECRET_KEY_BASE=$(openssl rand -hex 64)
+#        export SMTP_PASSWORD=...             # password for SMTP_USERNAME
+#
+#   6. Deploy:
+#
+#        bin/kamal setup    # first time: installs Docker, proxy, boots the app
+#        bin/kamal deploy   # every next deploy; data survives via the volume below
+#
+# Notes:
+# - SQLite databases (storage/*.sqlite3) and uploads (storage/production/files)
+#   both live under /rails/storage, which is persisted in the `fizzy_storage`
+#   Docker volume. That is what makes data survive the next deploy.
+# - Background jobs run on the same box inside the web container via
+#   Solid Queue in Puma (SOLID_QUEUE_IN_PUMA=true), so no separate job host
+#   is needed. Recurring jobs are declared in config/recurring.yml.
+# - SSL is terminated by kamal-proxy (`proxy/ssl: true`); the Rails app
+#   assumes SSL behind the proxy (see config/environments/production.rb).
+# - The container serves Thruster -> Puma on port 80 (see Dockerfile).
+
+service: fizzy
+
+image: your-user/fizzy
+
+servers:
+  web:
+    hosts:
+      - YOUR_SERVER_IP
+
+proxy:
+  ssl: true
+  host: YOUR_APP_HOST
+
+registry:
+  username: your-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  # Change to `arm64` (or `[ amd64, arm64 ]`) if your box is ARM-based.
+  arch: amd64
+
+asset_path: /rails/public/assets
+
+# Everything SQLite + Active Storage lives under /rails/storage.
+# Keep this volume or data will be lost on every deploy.
+volumes:
+  - fizzy_storage:/rails/storage
+
+env:
+  clear:
+    RAILS_ENV: production
+    # Jobs run in the web (Puma) process on the same box. Do not turn off.
+    SOLID_QUEUE_IN_PUMA: "true"
+    # Public hostname, used for links inside emails and URL generation.
+    # Must match proxy/host above.
+    APP_HOST: YOUR_APP_HOST
+    # Address magic-login and notification emails are sent from.
+    MAILER_FROM_ADDRESS: "Fizzy <hello@YOUR_APP_HOST>"
+    # Outbound mail server (magic-login codes are emailed).
+    SMTP_ADDRESS: mail.YOUR_APP_HOST
+    SMTP_PORT: "587"
+    SMTP_DOMAIN: YOUR_APP_HOST
+    SMTP_USERNAME: fizzy
+    SMTP_AUTHENTICATION: login
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    - KAMAL_REGISTRY_PASSWORD
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..868022d 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -92,4 +92,29 @@ Rails.application.configure do
 
   # Skip DNS rebinding protection for the default health check endpoint.
   # config.host_authorization = { exclude: ->(request) { request.path == "/up" } }
+
+  # Single-box open-source deployment (Kamal + SQLite + kamal-proxy SSL).
+  # Configure via APP_HOST and SMTP_* env vars (see config/deploy.yml).
+  # Skipped for SaaS, which sets its own hosts and mailer config.
+  unless defined?(Fizzy) && Fizzy.saas?
+    if ENV["APP_HOST"].present?
+      config.action_mailer.default_url_options = { host: ENV["APP_HOST"], protocol: "https" }
+      config.action_controller.default_url_options = { host: ENV["APP_HOST"], protocol: "https" }
+    end
+
+    if ENV["SMTP_ADDRESS"].present?
+      smtp_authentication = ENV["SMTP_AUTHENTICATION"]&.to_sym
+      smtp_authentication ||= :login if ENV["SMTP_USERNAME"].present?
+      config.action_mailer.delivery_method = :smtp
+      config.action_mailer.smtp_settings = {
+        address: ENV["SMTP_ADDRESS"],
+        port: Integer(ENV.fetch("SMTP_PORT", "587")),
+        domain: ENV.fetch("SMTP_DOMAIN", ENV["APP_HOST"] || "localhost"),
+        user_name: ENV["SMTP_USERNAME"],
+        password: ENV["SMTP_PASSWORD"],
+        authentication: smtp_authentication,
+        enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+      }.compact
+    end
+  end
 end
