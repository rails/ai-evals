diff --git a/app/controllers/activities_controller.rb b/app/controllers/activities_controller.rb
new file mode 100644
index 0000000..ed70877
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,49 @@
+class ActivitiesController < ApplicationController
+  ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+    card_title_changed
+  ].freeze
+
+  def index
+    set_page_and_extract_portion_from activities
+
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  private
+    def activities
+      scope = Event
+        .preloaded
+        .includes(creator: :identity, board: { creator: :identity })
+        .where(board: Current.user.boards, action: ACTIVITY_ACTIONS)
+        .order(created_at: :desc, id: :desc)
+
+      scope = scope.where(creator_id: creator_ids) if creator_ids.any?
+      scope = scope.where(board_id: board_ids) if board_ids.any?
+      scope
+    end
+
+    def creator_ids
+      extract_ids(params[:creator_ids])
+    end
+
+    def board_ids
+      extract_ids(params[:board_ids])
+    end
+
+    def extract_ids(param)
+      Array(param).flat_map { |v| v.to_s.split(",") }.map(&:strip).reject(&:blank?)
+    end
+end
diff --git a/app/views/activities/index.json.jbuilder b/app/views/activities/index.json.jbuilder
new file mode 100644
index 0000000..da40526
--- /dev/null
+++ b/app/views/activities/index.json.jbuilder
@@ -0,0 +1,49 @@
+json.array! @page.records do |event|
+  json.id event.id
+  json.action event.action.to_s
+  json.created_at event.created_at.utc
+  json.description event.description_for(Current.user).to_plain_text
+
+  particulars_hash = case event.action.to_s
+  when "card_assigned", "card_unassigned"
+    { assignee_ids: event.assignee_ids || [] }
+  when "card_board_changed"
+    nested = event.particulars.is_a?(Hash) ? (event.particulars["particulars"] || {}) : {}
+    nested = {} unless nested.is_a?(Hash)
+    flat = event.particulars.is_a?(Hash) ? event.particulars : {}
+    old_board = nested["old_board"].presence || nested["old_collection"].presence || flat["old_board"].presence || ""
+    new_board = nested["new_board"].presence || nested["new_collection"].presence || flat["new_board"].presence || ""
+    { old_board: old_board, new_board: new_board }
+  when "card_title_changed"
+    nested = event.particulars.is_a?(Hash) ? (event.particulars["particulars"] || {}) : {}
+    nested = {} unless nested.is_a?(Hash)
+    flat = event.particulars.is_a?(Hash) ? event.particulars : {}
+    old_title = nested["old_title"].presence || flat["old_title"].presence || ""
+    new_title = nested["new_title"].presence || flat["new_title"].presence || ""
+    { old_title: old_title, new_title: new_title }
+  when "card_triaged"
+    nested = event.particulars.is_a?(Hash) ? (event.particulars["particulars"] || {}) : {}
+    nested = {} unless nested.is_a?(Hash)
+    flat = event.particulars.is_a?(Hash) ? event.particulars : {}
+    column = nested["column"].presence || flat["column"].presence || ""
+    { column: column }
+  else
+    {}
+  end
+  json.particulars particulars_hash
+
+  json.url polymorphic_url(event.eventable)
+  json.eventable_type event.eventable_type
+
+  json.eventable do
+    case event.eventable
+    when Card
+      json.partial! "cards/card", card: event.eventable
+    when Comment
+      json.partial! "cards/comments/comment", comment: event.eventable
+    end
+  end
+
+  json.board event.board, partial: "boards/board", as: :board
+  json.creator event.creator, partial: "users/user", as: :user
+end
