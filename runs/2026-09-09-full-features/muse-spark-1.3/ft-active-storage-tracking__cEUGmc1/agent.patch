+# Calculates storage usage for accounts and boards.
+#
+# Only counts:
+# - Card images (Card#image attachments)
+# - Files embedded in board descriptions (Board#public_description embeds)
+# - Files embedded in card descriptions (Card#description embeds)
+# - Files embedded in comments (Comment#body embeds)
+#
+# All calculations are single SQL SUM queries with JOINs (no Ruby-level
+# iteration, no N+1), so they work for small and large accounts alike.
+# Variant records, avatars, exports, imports and any other attachments
+# are excluded by filtering on record_type/name.
+class StorageUsage
+  CARD_IMAGE_RECORD_TYPE = "Card"
+  CARD_IMAGE_NAME = "image"
+
+  RICH_TEXT_RECORD_TYPE = "ActionText::RichText"
+  EMBEDS_NAME = "embeds"
+
+  class << self
+    def board_bytes(board)
+      board_id = board.is_a?(Board) ? board.id : board
+      card_images_for_board(board_id) +
+        board_description_embeds(board_id) +
+        card_description_embeds_for_board(board_id) +
+        comment_embeds_for_board(board_id)
+    end
+
+    def account_bytes(account)
+      account_id = account.is_a?(Account) ? account.id : account
+      card_images_for_account(account_id) +
+        board_description_embeds_for_account(account_id) +
+        card_description_embeds_for_account(account_id) +
+        comment_embeds_for_account(account_id)
+    end
+
+    def card_bytes(card)
+      card_id = card.is_a?(Card) ? card.id : card
+      card_image = ActiveStorage::Attachment
+        .joins(:blob)
+        .where(record_type: CARD_IMAGE_RECORD_TYPE, name: CARD_IMAGE_NAME, record_id: card_id)
+        .sum("active_storage_blobs.byte_size")
+
+      description_embeds = ActiveStorage::Attachment
+        .joins(:blob)
+        .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+        .where(active_storage_attachments: { record_type: RICH_TEXT_RECORD_TYPE, name: EMBEDS_NAME })
+        .where(action_text_rich_texts: { record_type: "Card", record_id: card_id, name: "description" })
+        .sum("active_storage_blobs.byte_size")
+
+      comment_embeds = ActiveStorage::Attachment
+        .joins(:blob)
+        .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+        .joins("INNER JOIN comments ON comments.id = action_text_rich_texts.record_id")
+        .where(active_storage_attachments: { record_type: RICH_TEXT_RECORD_TYPE, name: EMBEDS_NAME })
+        .where(action_text_rich_texts: { record_type: "Comment", name: "body" })
+        .where(comments: { card_id: card_id })
+        .sum("active_storage_blobs.byte_size")
+
+      card_image + description_embeds + comment_embeds
+    end
+
+    private
+      def card_images_for_board(board_id)
+        ActiveStorage::Attachment
+          .joins(:blob)
+          .joins("INNER JOIN cards ON cards.id = active_storage_attachments.record_id")
+          .where(active_storage_attachments: { record_type: CARD_IMAGE_RECORD_TYPE, name: CARD_IMAGE_NAME })
+          .where(cards: { board_id: board_id })
+          .sum("active_storage_blobs.byte_size")
+      end
+
+      def board_description_embeds(board_id)
+        ActiveStorage::Attachment
+          .joins(:blob)
+          .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+          .where(active_storage_attachments: { record_type: RICH_TEXT_RECORD_TYPE, name: EMBEDS_NAME })
+          .where(action_text_rich_texts: { record_type: "Board", record_id: board_id, name: "public_description" })
+          .sum("active_storage_blobs.byte_size")
+      end
+
+      def card_description_embeds_for_board(board_id)
+        ActiveStorage::Attachment
+          .joins(:blob)
+          .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+          .joins("INNER JOIN cards ON cards.id = action_text_rich_texts.record_id")
+          .where(active_storage_attachments: { record_type: RICH_TEXT_RECORD_TYPE, name: EMBEDS_NAME })
+          .where(action_text_rich_texts: { record_type: "Card", name: "description" })
+          .where(cards: { board_id: board_id })
+          .sum("active_storage_blobs.byte_size")
+      end
+
+      def comment_embeds_for_board(board_id)
+        ActiveStorage::Attachment
+          .joins(:blob)
+          .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+          .joins("INNER JOIN comments ON comments.id = action_text_rich_texts.record_id")
+          .joins("INNER JOIN cards ON cards.id = comments.card_id")
+          .where(active_storage_attachments: { record_type: RICH_TEXT_RECORD_TYPE, name: EMBEDS_NAME })
+          .where(action_text_rich_texts: { record_type: "Comment", name: "body" })
+          .where(cards: { board_id: board_id })
+          .sum("active_storage_blobs.byte_size")
+      end
+
+      def card_images_for_account(account_id)
+        ActiveStorage::Attachment
+          .joins(:blob)
+          .joins("INNER JOIN cards ON cards.id = active_storage_attachments.record_id")
+          .where(active_storage_attachments: { record_type: CARD_IMAGE_RECORD_TYPE, name: CARD_IMAGE_NAME })
+          .where(cards: { account_id: account_id })
+          .sum("active_storage_blobs.byte_size")
+      end
+
+      def board_description_embeds_for_account(account_id)
+        ActiveStorage::Attachment
+          .joins(:blob)
+          .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+          .joins("INNER JOIN boards ON boards.id = action_text_rich_texts.record_id")
+          .where(active_storage_attachments: { record_type: RICH_TEXT_RECORD_TYPE, name: EMBEDS_NAME })
+          .where(action_text_rich_texts: { record_type: "Board", name: "public_description" })
+          .where(boards: { account_id: account_id })
+          .sum("active_storage_blobs.byte_size")
+      end
+
+      def card_description_embeds_for_account(account_id)
+        ActiveStorage::Attachment
+          .joins(:blob)
+          .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+          .joins("INNER JOIN cards ON cards.id = action_text_rich_texts.record_id")
+          .where(active_storage_attachments: { record_type: RICH_TEXT_RECORD_TYPE, name: EMBEDS_NAME })
+          .where(action_text_rich_texts: { record_type: "Card", name: "description" })
+          .where(cards: { account_id: account_id })
+          .sum("active_storage_blobs.byte_size")
+      end
+
+      def comment_embeds_for_account(account_id)
+        ActiveStorage::Attachment
+          .joins(:blob)
+          .joins("INNER JOIN action_text_rich_texts ON action_text_rich_texts.id = active_storage_attachments.record_id")
+          .joins("INNER JOIN comments ON comments.id = action_text_rich_texts.record_id")
+          .joins("INNER JOIN cards ON cards.id = comments.card_id")
+          .where(active_storage_attachments: { record_type: RICH_TEXT_RECORD_TYPE, name: EMBEDS_NAME })
+          .where(action_text_rich_texts: { record_type: "Comment", name: "body" })
+          .where(cards: { account_id: account_id })
+          .sum("active_storage_blobs.byte_size")
+      end
+  end
+end
diff --git a/app/models/storage_usage_tracker.rb b/app/models/storage_usage_tracker.rb
new file mode 100644
index 0000000..b459e53
--- /dev/null
+++ b/app/models/storage_usage_tracker.rb
@@ -0,0 +1,171 @@
+# Resolves attachments to their owning board/account and maintains the
+# cached bytes_used columns.
+#
+# Synchronous deltas use atomic update_counters (single UPDATE, no row
+# locking beyond the write itself), so many concurrent users attaching
+# files do not contend on long transactions. Background recalculations
+# (see Account::StorageUsageRecalculationJob and
+# Board::StorageUsageRecalculationJob) correct any drift with efficient
+# SQL SUM queries that never instantiate attachment records.
+module StorageUsageTracker
+  class << self
+    def attachment_added(attachment)
+      board_id, account_id, byte_size = resolve(attachment)
+      return if board_id.nil? || account_id.nil? || byte_size.nil? || byte_size.zero?
+
+      Board.update_counters(board_id, bytes_used: byte_size)
+      Account.update_counters(account_id, bytes_used: byte_size)
+
+      schedule_recalculation(board_id, account_id)
+    rescue StandardError => e
+      Rails.error.report(e, context: { attachment_id: attachment.id })
+      schedule_recalculation_for_attachment(attachment)
+    end
+
+    def attachment_removed(attachment, snapshot = nil)
+      board_id, account_id, byte_size = snapshot || resolve(attachment)
+      # Fall back to live resolve when snapshot is missing or incomplete
+      # (e.g. blob already purged is captured in snapshot, so prefer it).
+      if board_id.nil? || account_id.nil? || byte_size.nil?
+        live_board_id, live_account_id, live_size = resolve(attachment)
+        board_id ||= live_board_id
+        account_id ||= live_account_id
+        byte_size ||= live_size
+      end
+      return if board_id.nil? || account_id.nil? || byte_size.nil? || byte_size.zero?
+
+      Board.update_counters(board_id, bytes_used: -byte_size)
+      Account.update_counters(account_id, bytes_used: -byte_size)
+
+      schedule_recalculation(board_id, account_id)
+    rescue StandardError => e
+      Rails.error.report(e, context: { attachment_id: attachment.id })
+      schedule_recalculation_for_attachment(attachment)
+    end
+
+    # Captures [board_id, account_id, byte_size] before destroy, while the
+    # blob and associated records still exist. Used to decrement correctly
+    # even when purge deletes the blob alongside the attachment.
+    def snapshot(attachment)
+      resolve(attachment)
+    rescue StandardError
+      [ nil, nil, nil ]
+    end
+
+    def card_moved(card, old_board_id)
+      new_board_id = card.board_id
+      return if old_board_id == new_board_id
+
+      total = StorageUsage.card_bytes(card.id)
+
+      old_board = Board.find_by(id: old_board_id)
+      new_board = Board.find_by(id: new_board_id)
+
+      if old_board && total.nonzero?
+        Board.update_counters(old_board.id, bytes_used: -total)
+      end
+      if new_board && total.nonzero?
+        Board.update_counters(new_board.id, bytes_used: total)
+      end
+
+      old_account_id = old_board&.account_id
+      new_account_id = new_board&.account_id || card.account_id
+      if old_account_id && new_account_id && old_account_id != new_account_id && total.nonzero?
+        Account.update_counters(old_account_id, bytes_used: -total)
+        Account.update_counters(new_account_id, bytes_used: total)
+      end
+
+      schedule_recalculation(old_board_id, old_account_id)
+      schedule_recalculation(new_board_id, new_account_id)
+    rescue StandardError => e
+      Rails.error.report(e, context: { card_id: card.id })
+      schedule_recalculation(card.board_id, card.account_id)
+      schedule_recalculation(old_board_id, nil) if old_board_id
+    end
+
+    def card_destroyed(card)
+      schedule_recalculation(card.board_id, card.account_id)
+    end
+
+    def comment_destroyed(comment)
+      card = Card.find_by(id: comment.card_id)
+      if card
+        schedule_recalculation(card.board_id, card.account_id)
+      else
+        schedule_recalculation(nil, comment.account_id)
+      end
+    end
+
+    def board_destroyed(board)
+      schedule_recalculation(nil, board.account_id)
+    end
+
+    private
+      # Returns [board_id, account_id, byte_size] or [nil, nil, nil] when
+      # the attachment is not counted (avatars, exports, variants, etc).
+      def resolve(attachment)
+        case [ attachment.record_type, attachment.name ]
+        when [ "Card", "image" ]
+          resolve_card_image(attachment)
+        when [ "ActionText::RichText", "embeds" ]
+          resolve_embed(attachment)
+        else
+          [ nil, nil, nil ]
+        end
+      end
+
+      def resolve_card_image(attachment)
+        card = Card.find_by(id: attachment.record_id)
+        return [ nil, nil, nil ] if card.nil?
+
+        [ card.board_id, card.account_id, blob_byte_size(attachment) ]
+      end
+
+      def resolve_embed(attachment)
+        rich_text = ActionText::RichText.find_by(id: attachment.record_id)
+        return [ nil, nil, nil ] if rich_text.nil?
+
+        case [ rich_text.record_type, rich_text.name ]
+        when [ "Board", "public_description" ]
+          board = Board.find_by(id: rich_text.record_id)
+          return [ nil, nil, nil ] if board.nil?
+          [ board.id, board.account_id, blob_byte_size(attachment) ]
+        when [ "Card", "description" ]
+          card = Card.find_by(id: rich_text.record_id)
+          return [ nil, nil, nil ] if card.nil?
+          [ card.board_id, card.account_id, blob_byte_size(attachment) ]
+        when [ "Comment", "body" ]
+          comment = Comment.find_by(id: rich_text.record_id)
+          return [ nil, nil, nil ] if comment.nil?
+          card = Card.find_by(id: comment.card_id)
+          return [ nil, nil, nil ] if card.nil?
+          [ card.board_id, card.account_id, blob_byte_size(attachment) ]
+        else
+          [ nil, nil, nil ]
+        end
+      end
+
+      def blob_byte_size(attachment)
+        attachment.blob&.byte_size ||
+          ActiveStorage::Blob.where(id: attachment.blob_id).pick(:byte_size)
+      end
+
+      def schedule_recalculation(board_id, account_id)
+        if board_id && Board.exists?(board_id)
+          Board::StorageUsageRecalculationJob.perform_later(Board.find(board_id))
+        end
+        if account_id && Account.exists?(account_id)
+          Account::StorageUsageRecalculationJob.perform_later(Account.find(account_id))
+        end
+      rescue ActiveRecord::RecordNotFound
+        # Record was deleted concurrently; nothing to schedule.
+      end
+
+      def schedule_recalculation_for_attachment(attachment)
+        board_id, account_id, _ = resolve(attachment)
+        schedule_recalculation(board_id, account_id)
+      rescue StandardError
+        # Best effort only.
+      end
+  end
+end
diff --git a/config/initializers/storage_usage.rb b/config/initializers/storage_usage.rb
new file mode 100644
index 0000000..5d3a1fd
--- /dev/null
+++ b/config/initializers/storage_usage.rb
@@ -0,0 +1,80 @@
+# Tracks storage usage for accounts and boards.
+#
+# Only card images and files embedded in board/card descriptions and
+# comments are counted (see StorageUsage). Counters are kept in the
+# bytes_used columns and maintained two ways for correctness at any scale:
+#
+# - Synchronous atomic deltas (update_counters, no locking) on attachment
+#   create/destroy and card board changes, so #bytes_used is up-to-date
+#   immediately without loading records.
+# - Background full recalculations (single SQL SUM queries) scheduled on
+#   every relevant change, so drift is corrected and bulk operations
+#   (imports, moves, purges) converge to the exact value.
+Rails.application.config.to_prepare do
+  ActiveStorage::Attachment.class_eval do
+    before_destroy :remember_storage_usage_before_destroy
+    after_create :track_storage_usage_on_create
+    after_destroy :track_storage_usage_on_destroy
+
+    # purge/purge_later/detach use #delete which bypasses callbacks, so
+    # track synchronously here as well. #destroy does not call #delete,
+    # so there is no double counting with the callbacks above.
+    def delete(*args, **kwargs)
+      snapshot = StorageUsageTracker.snapshot(self)
+      result = super
+      StorageUsageTracker.attachment_removed(self, snapshot)
+      result
+    end
+
+    private
+      def remember_storage_usage_before_destroy
+        @storage_usage_snapshot = StorageUsageTracker.snapshot(self)
+      end
+
+      def track_storage_usage_on_create
+        StorageUsageTracker.attachment_added(self)
+      end
+
+      def track_storage_usage_on_destroy
+        StorageUsageTracker.attachment_removed(self, @storage_usage_snapshot)
+      end
+  end
+
+  Card.class_eval do
+    # Transfer is done in before_update (not after) because
+    # Card#handle_board_change performs a second save inside its
+    # after_update callback, which would overwrite saved_change state
+    # and instance variables before later after_update callbacks run.
+    before_update :track_storage_usage_on_board_change
+    after_destroy :schedule_storage_recalculation_on_destroy
+
+    private
+      def track_storage_usage_on_board_change
+        if will_save_change_to_board_id? && board_id_in_database != board_id
+          StorageUsageTracker.card_moved(self, board_id_in_database)
+        end
+      end
+
+      def schedule_storage_recalculation_on_destroy
+        StorageUsageTracker.card_destroyed(self)
+      end
+  end
+
+  Comment.class_eval do
+    after_destroy :schedule_storage_recalculation_on_destroy
+
+    private
+      def schedule_storage_recalculation_on_destroy
+        StorageUsageTracker.comment_destroyed(self)
+      end
+  end
+
+  Board.class_eval do
+    after_destroy :schedule_storage_recalculation_on_destroy
+
+    private
+      def schedule_storage_recalculation_on_destroy
+        StorageUsageTracker.board_destroyed(self)
+      end
+  end
+end
