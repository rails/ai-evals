index 0000000..8c26b29
--- /dev/null
+++ b/app/models/account/storage_usage.rb
@@ -0,0 +1,26 @@
+module Account::StorageUsage
+  extend ActiveSupport::Concern
+
+  # Returns up-to-date storage usage in bytes. The value is maintained in
+  # the bytes_used column by background recalculation jobs (see
+  # Account::StorageUsageRecalculationJob) that are scheduled whenever
+  # attachments change, plus atomic synchronous deltas for immediacy.
+  # Falls back to a live calculation if the cached column has not been
+  # populated yet, so the value is always correct.
+  def bytes_used
+    cached = self[:bytes_used]
+    if cached.nil?
+      StorageUsage.account_bytes(self)
+    else
+      cached
+    end
+  end
+
+  def recalculate_bytes_used!
+    update_columns(bytes_used: StorageUsage.account_bytes(self))
+  end
+
+  def schedule_storage_recalculation
+    Account::StorageUsageRecalculationJob.perform_later(self)
+  end
+end
