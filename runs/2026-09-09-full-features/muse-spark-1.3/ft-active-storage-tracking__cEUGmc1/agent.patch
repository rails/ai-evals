@@ -0,0 +1,85 @@
+require "test_helper"
+
+class StorageUsageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "account aggregates boards" do
+    account = accounts("37s")
+    Current.account = account
+    board1 = boards(:writebook)
+    board2 = boards(:private)
+    user = users(:david)
+
+    # Clear existing? Boards start at 0 (no attachments in fixtures)
+    assert_equal 0, board1.reload.bytes_used
+    assert_equal 0, board2.reload.bytes_used
+    assert_equal 0, account.reload.bytes_used
+
+    card1 = Card.create!(title: "A1", board: board1, creator: user, status: "published")
+    card1.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    s1 = card1.image.blob.byte_size
+
+    card2 = Card.create!(title: "A2", board: board2, creator: user, status: "published")
+    card2.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    s2 = card2.image.blob.byte_size
+
+    assert_equal s1, board1.reload.bytes_used
+    assert_equal s2, board2.reload.bytes_used
+    assert_equal s1 + s2, account.reload.bytes_used
+    assert_equal s1 + s2, StorageUsage.account_bytes(account)
+  end
+
+  test "board destroy updates account" do
+    account = accounts("37s")
+    Current.account = account
+    user = users(:david)
+    board = Board.create!(name: "TempBoard", account: account, creator: user)
+    card = Card.create!(title: "T1", board: board, creator: user, status: "published")
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+    size = card.image.blob.byte_size
+    assert_equal size, board.reload.bytes_used
+    assert_equal size, account.reload.bytes_used
+
+    board.destroy
+    perform_enqueued_jobs
+    assert_equal 0, StorageUsage.account_bytes(account)
+    assert_equal 0, account.reload.bytes_used
+  end
+
+  test "export and import files excluded" do
+    board = boards(:writebook)
+    account = board.account
+    Current.account = account
+    before_board = board.reload.bytes_used
+    before_account = account.reload.bytes_used
+
+    # Export file
+    user = users(:david)
+    exp = account.exports.create!(user: user, status: "pending")
+    exp.file.attach(io: StringIO.new("export data"), filename: "export.zip", content_type: "application/zip")
+    assert_equal before_board, board.reload.bytes_used
+    assert_equal before_account, account.reload.bytes_used
+
+    # Import file
+    imp = account.imports.create!(identity: identities(:david), status: "pending")
+    imp.file.attach(io: StringIO.new("import data"), filename: "import.zip", content_type: "application/zip")
+    assert_equal before_board, board.reload.bytes_used
+    assert_equal before_account, account.reload.bytes_used
+  end
+
+  test "direct blob without attachment not counted" do
+    board = boards(:writebook)
+    Current.account = board.account
+    before = board.reload.bytes_used
+    ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "orphan.jpg", content_type: "image/jpeg")
+    assert_equal before, board.reload.bytes_used
+    assert_equal before, StorageUsage.board_bytes(board)
+  end
+
+  test "bytes_used returns integer" do
+    assert_kind_of Integer, boards(:writebook).bytes_used
+    assert_kind_of Integer, accounts("37s").bytes_used
+  end
+end
