diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..c1a284e
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,60 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content body text ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: %i[ destroy ]
+  before_action :ensure_creatorship, only: %i[ destroy ]
+
+  def index
+    @reactions = @comment.reactions.preloaded.chronologically
+
+    respond_to do |format|
+      format.json { render :index }
+    end
+  end
+
+  def create
+    @reaction = @comment.reactions.create!(reaction_params.merge(creator: Current.user))
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to card_path(@card, anchor: ActionView::RecordIdentifier.dom_id(@comment)) }
+      format.json { render :show, status: :created }
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.html { redirect_to card_path(@card, anchor: ActionView::RecordIdentifier.dom_id(@comment)) }
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden if Current.user != @reaction.creator
+    end
+
+    def reaction_params
+      begin
+        permitted = params.expect(reaction: [ :content, :body, :text ])
+        content = permitted[:content].presence || permitted[:body].presence || permitted[:text].presence
+      rescue ActionController::ParameterMissing
+        content = nil
+      end
+      content ||= params[:content].presence || params[:body].presence || params[:text].presence
+      { content: content.to_s.strip }
+    end
+end
