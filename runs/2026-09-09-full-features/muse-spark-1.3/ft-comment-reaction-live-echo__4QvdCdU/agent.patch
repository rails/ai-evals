diff --git a/app/views/cards/comments/reactions/_reactions.html.erb b/app/views/cards/comments/reactions/_reactions.html.erb
new file mode 100644
index 0000000..9b42535
--- /dev/null
+++ b/app/views/cards/comments/reactions/_reactions.html.erb
@@ -0,0 +1,42 @@
+<% card = comment.card %>
+<div class="reactions" id="<%= dom_id(comment, :reactions) %>" data-controller="reactions" data-action="click@document->reactions#closeOnClickOutside">
+  <div class="reactions__list" id="<%= dom_id(comment, :reactions_list) %>">
+    <%= render partial: "cards/comments/reactions/reaction", collection: comment.reactions.preloaded.chronologically, as: :reaction, cached: true %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle" data-reactions-target="trigger" data-action="reactions#showForm" aria-label="Add reaction" title="Add reaction">
+    <%= image_tag "boost-color.svg", aria: { hidden: true } %>
+    <span class="for-screen-reader">Add reaction</span>
+  </button>
+
+  <div class="reaction reaction__form" data-reactions-target="form" hidden>
+    <%= form_with url: card_comment_reactions_path(card, comment), scope: :reaction, data: { reactions_target: "formElement", action: "turbo:submit-end->reactions#resetAfterSubmit keydown.esc->reactions#hideForm" } do |form| %>
+      <div class="reaction__menu" data-controller="dialog" data-action="keydown.esc->dialog#close click@document->dialog#closeOnClickOutside">
+        <button type="button" class="reaction__menu-btn btn btn--circle borderless" data-action="dialog#toggle" aria-label="Choose an emoji" title="Choose an emoji">
+          <%= image_tag "boost-color.svg", aria: { hidden: true } %>
+          <span class="for-screen-reader">Choose an emoji</span>
+        </button>
+        <dialog class="reaction__popup popup dialog panel" data-dialog-target="dialog">
+          <div class="reaction__emoji-list">
+            <% EmojiHelper::REACTIONS.each do |emoji, label| %>
+              <button type="button" class="btn btn--circle borderless" data-action="reactions#pickEmoji" data-emoji="<%= h emoji %>" title="<%= h label %>" aria-label="<%= h label %>"><%= h emoji %></button>
+            <% end %>
+          </div>
+        </dialog>
+      </div>
+
+      <label class="reaction__form-label">
+        <span class="for-screen-reader">Reaction</span>
+        <%= form.text_field :content, class: "reaction__input input", maxlength: 16, required: true, autocomplete: "off", placeholder: "React…", data: { reactions_target: "input" } %>
+      </label>
+      <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle borderless", title: "Confirm reaction", aria: { label: "Confirm reaction" } do %>
+        <%= icon_tag "check" %>
+        <span class="for-screen-reader">Confirm</span>
+      <% end %>
+      <button type="button" class="reaction__cancel-btn btn btn--circle borderless" data-action="reactions#hideForm" title="Cancel" aria-label="Cancel">
+        <%= icon_tag "close" %>
+        <span class="for-screen-reader">Cancel</span>
+      </button>
+    <% end %>
+  </div>
+</div>
