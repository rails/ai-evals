diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..0b6788e
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,91 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "formElement" ]
+
+  showForm(event) {
+    event?.preventDefault?.()
+    this.collapseAll()
+    if (this.hasTriggerTarget) this.triggerTarget.hidden = true
+    if (this.hasFormTarget) {
+      this.formTarget.hidden = false
+      this.formTarget.classList.add("expanded")
+      // focus after visible
+      requestAnimationFrame(() => this.inputTarget?.focus?.())
+    }
+  }
+
+  hideForm(event) {
+    event?.preventDefault?.()
+    if (this.hasFormTarget) {
+      this.formTarget.hidden = true
+      this.formTarget.classList.remove("expanded")
+    }
+    if (this.hasTriggerTarget) this.triggerTarget.hidden = false
+    if (this.hasInputTarget) this.inputTarget.value = ""
+    this.closeDialog()
+    this.triggerTarget?.focus?.()
+  }
+
+  resetAfterSubmit(event) {
+    // Turbo submit-end: reset to trigger state on success so button is back for next one
+    const success = event?.detail?.success
+    if (success === false) return
+    if (this.hasFormElementTarget) this.formElementTarget.reset()
+    if (this.hasFormTarget) {
+      this.formTarget.hidden = true
+      this.formTarget.classList.remove("expanded")
+    }
+    if (this.hasTriggerTarget) this.triggerTarget.hidden = false
+    this.closeDialog()
+  }
+
+  toggleExpanded(event) {
+    // Ignore clicks on interactive elements inside the reaction (delete button/form, links, buttons)
+    const interactive = event.target.closest("button, a, form, input, dialog")
+    if (interactive) return
+
+    const reaction = event.target.closest(".reaction--deleteable")
+    if (!reaction || !this.element.contains(reaction)) return
+
+    // Only the owner can expand: check visibility of delete button is handled by CSS,
+    // but guard here by ensuring delete control exists
+    const wasExpanded = reaction.classList.contains("expanded")
+    this.collapseAll()
+    if (!wasExpanded) reaction.classList.add("expanded")
+  }
+
+  closeOnClickOutside(event) {
+    const target = event.target
+    // Don't collapse when clicking inside an expanded reaction or the form/trigger
+    if (target.closest?.(".reaction.expanded") || target.closest?.(".reaction__form") || target.closest?.(".reactions__trigger")) return
+    if (!this.element.contains(target)) this.collapseAll()
+  }
+
+  pickEmoji(event) {
+    event.preventDefault()
+    const emoji = event.currentTarget?.dataset?.emoji
+    if (emoji && this.hasInputTarget) {
+      this.inputTarget.value = emoji
+      this.inputTarget.focus()
+    }
+    this.closeDialog()
+  }
+
+  markDeleting(event) {
+    const reaction = event.target.closest?.(".reaction")
+    if (reaction) reaction.classList.add("reaction--deleting")
+  }
+
+  collapseAll() {
+    this.element.querySelectorAll(".reaction.expanded").forEach((el) => {
+      // Keep the form's expanded animation only while visible; collapse others
+      if (el !== this.formTarget) el.classList.remove("expanded")
+    })
+  }
+
+  closeDialog() {
+    const dialog = this.element.querySelector(".reaction__popup[open]")
+    if (dialog) dialog.close()
+  }
+}
