+class Comment::Reaction < ApplicationRecord
+  self.table_name = "comment_reactions"
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  belongs_to :user, class_name: "User", foreign_key: :creator_id, optional: true
+
+  alias_attribute :body, :content
+  alias_attribute :text, :content
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  before_validation :strip_content
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { preload(creator: [ :avatar_attachment, :account ]) }
+
+  delegate :card, to: :comment
+
+  after_create_commit :broadcast_reactions_refresh
+  after_destroy_commit :broadcast_reactions_refresh
+
+  private
+    def strip_content
+      self.content = content.to_s.strip
+    end
+
+    def broadcast_reactions_refresh
+      broadcast_refresh_to card
+    rescue StandardError
+      nil
+    end
+end
