diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..56f57dd
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,148 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+// Drag cards between board columns (and status columns) with instant,
+// optimistic updates.
+//
+// - Columns keep their own order: dropping onto the same column is a no-op —
+//   no DOM move, no save.
+// - Dropping onto another column moves the card element immediately
+//   (synchronously, before any network request), then persists in the
+//   background as JSON so no Turbo Stream response morphs the board
+//   afterwards and nothing shifts.
+// - Visual feedback uses the shipped design classes:
+//   the column under the pointer lights up (`hoverContainer`) and the
+//   dragged card dims (`draggedItem`).
+export default class extends Controller {
+  static classes = [ "draggedItem", "hoverContainer" ]
+  static targets = [ "container", "item" ]
+
+  dragStart(event) {
+    const item = event.currentTarget
+    this.draggedItem = item
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      try {
+        event.dataTransfer.setData("text/plain", item.id)
+      } catch {
+        // Clipboard access can throw in some browsers; dragging still works.
+      }
+    }
+
+    item.classList.add(this.hoverDraggedItemClass)
+  }
+
+  dragOver(event) {
+    event.preventDefault()
+
+    if (event.dataTransfer) {
+      event.dataTransfer.dropEffect = "move"
+    }
+
+    event.currentTarget.classList.add(this.hoverContainerClassValue)
+  }
+
+  dragLeave(event) {
+    const container = event.currentTarget
+
+    if (!container.contains(event.relatedTarget)) {
+      container.classList.remove(this.hoverContainerClassValue)
+    }
+  }
+
+  drop(event) {
+    event.preventDefault()
+
+    const targetContainer = event.currentTarget
+    targetContainer.classList.remove(this.hoverContainerClassValue)
+
+    const item = this.draggedItem || this.#itemFromDataTransfer(event)
+
+    if (!item) {
+      return
+    }
+
+    const sourceContainer = item.closest('[data-drag-and-drop-target="container"]')
+
+    if (sourceContainer && sourceContainer === targetContainer) {
+      return
+    }
+
+    // Optimistic, synchronous move so the board is already the way the user
+    // left it when they let go — no waiting on the save.
+    const list = targetContainer.querySelector(".cards__list")
+
+    if (list) {
+      const firstCard = list.querySelector(".card")
+
+      if (firstCard) {
+        list.insertBefore(item, firstCard)
+      } else {
+        list.appendChild(item)
+      }
+    } else {
+      targetContainer.appendChild(item)
+    }
+
+    // Persist in the background as JSON. JSON responses carry no Turbo Stream
+    // actions, so nothing re-renders or shifts afterwards.
+    void this.#persist(item, targetContainer)
+  }
+
+  dragEnd(event) {
+    event.currentTarget.classList.remove(this.hoverDraggedItemClass)
+    this.containerTargets.forEach((container) => container.classList.remove(this.hoverContainerClassValue))
+    this.draggedItem = null
+  }
+
+  async #persist(item, container) {
+    const triageUrl = item.dataset.dragAndDropTriageUrl
+    const closureUrl = item.dataset.dragAndDropClosureUrl
+    const notNowUrl = item.dataset.dragAndDropNotNowUrl
+    const columnId = container.dataset.dragAndDropColumnId
+    const status = container.dataset.dragAndDropStatus
+
+    try {
+      if (columnId) {
+        await post(triageUrl, { query: { column_id: columnId }, responseKind: "json" })
+      } else if (status === "stream" || status === "maybe") {
+        await destroy(triageUrl, { responseKind: "json" })
+      } else if (status === "not_now") {
+        await post(notNowUrl, { responseKind: "json" })
+      } else if (status === "closed") {
+        await post(closureUrl, { responseKind: "json" })
+      }
+    } catch (error) {
+      console.error(error)
+    }
+  }
+
+  #itemFromDataTransfer(event) {
+    try {
+      const id = event.dataTransfer?.getData("text/plain")
+      if (id) {
+        return this.itemTargets.find((item) => item.id === id) || document.getElementById(id)
+      }
+    } catch {
+      // Ignore clipboard errors.
+    }
+    return null
+  }
+
+  get hoverDraggedItemClass() {
+    if (this.hasDraggedItemClass) {
+      return this.draggedItemClass
+    } else {
+      return "drag-and-drop__dragged-item"
+    }
+  }
+
+  get hoverContainerClassValue() {
+    if (this.hasHoverContainerClass) {
+      return this.hoverContainerClass
+    } else {
+      return "drag-and-drop__hover-container"
+    }
+  }
+}
