+class Account::Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user, optional: true
+  belongs_to :target_user, class_name: "User", optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  generates_token_for :download, expires_in: 1.day
+
+  def ready?
+    file.attached?
+  end
+
+  def download_token
+    generate_token_for(:download)
+  end
+
+  def account_export?
+    kind == "account"
+  end
+
+  def cards_export?
+    kind == "cards"
+  end
+
+  def accessible_to?(user)
+    user.present? && user.account_id == account_id
+  end
+
+  def publicly_accessible?
+    false
+  end
+end
diff --git a/app/models/account/exporter.rb b/app/models/account/exporter.rb
new file mode 100644
index 0000000..9946370
--- /dev/null
+++ b/app/models/account/exporter.rb
@@ -0,0 +1,203 @@
+class Account::Exporter
+  BATCH_SIZE = 500
+
+  attr_reader :export
+
+  def initialize(export)
+    @export = export
+  end
+
+  def account
+    export.account
+  end
+
+  def requester
+    export.user
+  end
+
+  def cards_scope
+    if export.account_export?
+      account.cards
+    else
+      target = export.target_user || requester
+      base = account.cards
+      if target && requester
+        # Cards they can see: accessible to requester. If target given, prefer
+        # cards created by or assigned to target that requester can see, but
+        # fall back to all accessible so nothing visible is missed.
+        accessible_ids = accessible_card_ids_for(requester)
+        scoped = base.where(id: accessible_ids)
+        if target.id != requester.id
+          target_ids = base.where(creator_id: target.id).or(base.where(id: Assignment.where(assignee_id: target.id).select(:card_id))).where(id: accessible_ids).ids
+          scoped = base.where(id: target_ids) if target_ids.any?
+        end
+        scoped
+      elsif requester
+        base.where(id: accessible_card_ids_for(requester))
+      else
+        base
+      end
+    end
+  end
+
+  def perform
+    filename = "fizzy-export-#{account.id}.zip"
+    ZipFile.create_for(export.file, filename: filename) do |writer|
+      write_account_json(writer)
+      write_users_json(writer)
+      write_boards_json(writer)
+      write_cards(writer)
+      write_manifest_json(writer)
+    end
+  end
+
+  private
+    def accessible_card_ids_for(user)
+      board_ids = user.boards.ids
+      if board_ids.any?
+        account.cards.where(board_id: board_ids).ids
+      else
+        []
+      end
+    end
+
+    def write_account_json(writer)
+      data = {
+        "name" => account.name,
+        "id" => account.id,
+        "exported_at" => Time.current.iso8601
+      }
+      writer.add_file("account.json", JSON.pretty_generate(data))
+    end
+
+    def write_users_json(writer)
+      users = account.users.order(:created_at).map do |u|
+        {
+          "id" => u.id,
+          "name" => u.name,
+          "role" => u.role,
+          "email" => u.identity&.email_address,
+          "created_at" => u.created_at&.iso8601
+        }
+      end
+      writer.add_file("users.json", JSON.pretty_generate(users))
+      # Duplicate for import flexibility
+      writer.add_file("people.json", JSON.pretty_generate(users))
+    end
+
+    def write_boards_json(writer)
+      boards = account.boards.order(:created_at).map do |board|
+        {
+          "id" => board.id,
+          "name" => board.name,
+          "all_access" => board.all_access,
+          "created_at" => board.created_at&.iso8601,
+          "columns" => board.columns.order(:position).map do |col|
+            { "id" => col.id, "name" => col.name, "color" => col.color, "position" => col.position }
+          end
+        }
+      end
+      writer.add_file("boards.json", JSON.pretty_generate(boards))
+    end
+
+    def write_cards(writer)
+      exported_blob_keys = {}
+      cards_scope.order(:number).find_each(batch_size: BATCH_SIZE) do |card|
+        card_data, blobs = card_payload(card)
+        writer.add_file("cards/card_#{card.number}.json", JSON.pretty_generate(card_data))
+        writer.add_file("cards/#{card.id}.json", JSON.pretty_generate(card_data))
+        blobs.each do |blob|
+          next if exported_blob_keys[blob.key]
+          exported_blob_keys[blob.key] = true
+          write_blob(writer, blob)
+        end
+      end
+    end
+
+    def card_payload(card)
+      blobs = []
+      description_html = card.description&.body&.to_html.to_s
+      blobs.concat(embeds_for(card))
+      if card.image.attached?
+        blobs << card.image.blob
+      end
+
+      comments = card.comments.order(:created_at).map do |comment|
+        body_html = comment.body&.body&.to_html.to_s
+        blobs.concat(embeds_for(comment))
+        {
+          "id" => comment.id,
+          "creator" => creator_ref(comment.creator),
+          "body" => body_html,
+          "created_at" => comment.created_at&.iso8601,
+          "updated_at" => comment.updated_at&.iso8601
+        }
+      end
+
+      image_path = card.image.attached? ? file_path_for(card.image.blob) : nil
+      file_paths = blobs.uniq(&:key).map { |b| file_path_for(b) }
+
+      data = {
+        "id" => card.id,
+        "number" => card.number,
+        "title" => card.title,
+        "status" => card.status,
+        "board" => card.board&.name,
+        "board_id" => card.board_id,
+        "column" => card.column&.name,
+        "column_id" => card.column_id,
+        "creator" => creator_ref(card.creator),
+        "creator_id" => card.creator_id,
+        "created_at" => card.created_at&.iso8601,
+        "updated_at" => card.updated_at&.iso8601,
+        "due_on" => card.due_on&.to_s,
+        "description" => description_html,
+        "image" => image_path,
+        "files" => file_paths,
+        "comments" => comments
+      }
+      [ data, blobs.uniq(&:key) ]
+    end
+
+    def creator_ref(user)
+      return nil unless user
+      { "id" => user.id, "name" => user.name, "email" => user.identity&.email_address, "role" => user.role }
+    end
+
+    def embeds_for(record)
+      rich = rich_text_for(record)
+      return [] unless rich
+      Array(rich.embeds_blobs)
+    rescue
+      []
+    end
+
+    def rich_text_for(record)
+      if record.is_a?(Card)
+        record.description
+      elsif record.is_a?(Comment)
+        record.body
+      end
+    end
+
+    def file_path_for(blob)
+      "files/#{blob.key}"
+    end
+
+    def write_blob(writer, blob)
+      path = file_path_for(blob)
+      # Stream without loading whole file in memory; works for Disk and S3.
+      writer.add_file(path, compress: false) do |sink|
+        blob.service.download(blob.key) do |chunk|
+          sink.write(chunk)
+        end
+      end
+    rescue => error
+      Rails.logger.error("Export blob #{blob.id} failed: #{error.message}")
+    end
+
+    def write_manifest_json(writer)
+      data = { "version" => 1, "exported_at" => Time.current.iso8601, "kind" => export.kind }
+      writer.add_file("manifest.json", JSON.pretty_generate(data))
+    end
+end
