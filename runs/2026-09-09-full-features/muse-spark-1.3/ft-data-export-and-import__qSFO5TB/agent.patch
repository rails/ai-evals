+
+  def publicly_accessible?
+    false
+  end
+end
diff --git a/app/models/account/importer.rb b/app/models/account/importer.rb
new file mode 100644
index 0000000..18e6943
--- /dev/null
+++ b/app/models/account/importer.rb
@@ -0,0 +1,295 @@
+class Account::Importer
+  class Failure < StandardError; end
+
+  attr_reader :import
+
+  def initialize(import)
+    @import = import
+  end
+
+  def perform
+    requester = import.user
+    new_account = nil
+    import.file.blob.open do |zip_file|
+      entries = read_entries(zip_file)
+      validate!(entries)
+      new_account = build_account(entries, requester)
+    end
+    new_account
+  end
+
+  private
+    def read_entries(zip_path_or_file)
+      path = zip_path_or_file.is_a?(String) ? zip_path_or_file : zip_path_or_file.path
+      result = {}
+      File.open(path, "rb") do |io|
+        begin
+          structure = ZipKit::FileReader.read_zip_structure(io: io)
+        rescue => error
+          raise Failure, "Invalid archive: #{error.message}"
+        end
+        structure.each do |entry|
+          next if entry.filename.end_with?("/")
+          extractor = entry.extractor_from(io)
+          data = +"".b
+          until extractor.eof?
+            chunk = extractor.extract(1024 * 1024)
+            data << chunk if chunk
+          end
+          result[entry.filename] = data
+        end
+      end
+      result
+    rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD => error
+      raise Failure, "Invalid archive: #{error.message}"
+    end
+
+    def validate!(entries)
+      if entries.empty?
+        raise Failure, "Import file is empty"
+      end
+      unless entries.key?("account.json") || entries.key?("boards.json") || entries.keys.any? { _1.start_with?("cards/") }
+        raise Failure, "Import file is not a Fizzy export (missing account data)"
+      end
+    end
+
+    def build_account(entries, requester)
+      account_data = entries["account.json"] ? JSON.parse(entries["account.json"]) : {}
+      users_data = parse_json(entries["users.json"]) || parse_json(entries["people.json"]) || []
+      boards_data = parse_json(entries["boards.json"]) || []
+
+      card_entries = entries.select { |k, _| k.start_with?("cards/") && k.end_with?(".json") }
+      # Deduplicate: files appear twice (by number and by id); keep one per card number/id
+      cards_by_number = {}
+      card_entries.each_value do |raw|
+        parsed = JSON.parse(raw) rescue nil
+        next unless parsed.is_a?(Hash) && parsed["title"]
+        key = parsed["number"] || parsed["id"]
+        cards_by_number[key] ||= parsed
+      end
+
+      created_account = nil
+      ActiveRecord::Base.transaction do
+        created_account = Account.create!(name: account_data["name"].presence || "Imported account")
+        user_map = create_users(created_account, users_data, requester)
+        board_map, column_map = create_boards(created_account, boards_data, user_map, requester)
+        create_cards(created_account, board_map, column_map, user_map, cards_by_number.values, entries, requester)
+        created_account.update!(cards_count: created_account.cards.maximum(:number) || 0)
+      end
+      created_account
+    end
+
+    def parse_json(raw)
+      return nil unless raw
+      JSON.parse(raw)
+    rescue
+      nil
+    end
+
+    def create_users(account, users_data, requester)
+      map = {}
+      users_data.each do |u|
+        next unless u.is_a?(Hash)
+        email = u["email"]&.strip&.downcase.presence
+        name = u["name"].presence || email || "Imported user"
+        role = %w[owner admin member system].include?(u["role"]) ? u["role"] : "member"
+        identity = email ? Identity.find_or_create_by!(email_address: email) : nil
+        user = account.users.create!(name: name, role: role, identity: identity, verified_at: (identity ? Time.current : nil))
+        map[u["id"]] = user if u["id"]
+        map[email] = user if email
+        map[name] = user if name
+      end
+      # Ensurerequester has access if not already mapped
+      if requester && requester.identity
+        email = requester.identity.email_address
+        unless map[email] || map[requester.id]
+          existing = account.users.find_by(name: requester.name)
+          unless existing
+            map[requester.id] = account.users.create!(name: requester.name, role: "owner", identity: requester.identity, verified_at: Time.current)
+          else
+            map[requester.id] = existing
+          end
+        end
+      end
+      # Ensure at least an owner exists
+      if account.users.where(role: %i[owner admin]).none? && account.users.any?
+        account.users.first.update!(role: "owner")
+      elsif account.users.none?
+        identity = requester&.identity
+        account.users.create!(role: "system", name: "System")
+        account.users.create!(name: requester&.name || "Owner", role: "owner", identity: identity, verified_at: Time.current)
+      else
+        account.users.find_or_create_by!(role: "system") { |u| u.name = "System" }
+      end
+      # Map system users
+      account.users.each { |u| map[u.id] = u }
+      map
+    end
+
+    def resolve_user(map, account, ref, requester)
+      return fallback_user(map, account, requester) unless ref
+      if ref.is_a?(Hash)
+        map[ref["id"]] || (ref["email"] && map[ref["email"]&.downcase]) || (ref["name"] && map[ref["name"]]) || fallback_user(map, account, requester)
+      else
+        map[ref] || fallback_user(map, account, requester)
+      end
+    end
+
+    def fallback_user(map, account, requester)
+      if requester && (mapped = (map[requester.id] || (requester.identity && map[requester.identity.email_address])))
+        mapped
+      else
+        account.users.where.not(role: :system).first || account.users.first
+      end
+    end
+
+    def create_boards(account, boards_data, user_map, requester)
+      board_map = {}
+      column_map = {}
+      owner = fallback_user(user_map, account, requester)
+      boards_data.each do |b|
+        next unless b.is_a?(Hash) && b["name"].present?
+        creator = (b["creator"] && user_map[b["creator"]]) || owner
+        Current.set(user: creator, account: account) do
+          board = account.boards.create!(name: b["name"], all_access: b.fetch("all_access", true), creator: creator)
+          board_map[b["id"]] = board if b["id"]
+          board_map[b["name"]] = board
+          Array(b["columns"]).each do |c|
+            next unless c.is_a?(Hash) && c["name"].present?
+            col = board.columns.create!(name: c["name"], color: c["color"].presence || "blue", position: c["position"] || 0)
+            column_map[c["id"]] = col if c["id"]
+          end
+        end
+      end
+      # Grant access on restricted boards to all imported users (original accesses not exported)
+      account.boards.where(all_access: false).each do |board|
+        account.users.where.not(role: :system).each do |u|
+          board.accesses.find_or_create_by!(user: u)
+        end
+      end
+      [ board_map, column_map ]
+    end
+
+    def create_cards(account, board_map, column_map, user_map, cards_data, entries, requester)
+      # Ensure at least one board exists
+      if board_map.empty?
+        owner = fallback_user(user_map, account, requester)
+        Current.set(user: owner, account: account) do
+          board = account.boards.create!(name: "Imported", all_access: true, creator: owner)
+          board_map[nil] = board
+        end
+      end
+      default_board = board_map.values.first
+      blob_cache = {}
+
+      cards_data.each do |c|
+        board = (c["board_id"] && board_map[c["board_id"]]) || (c["board"] && board_map[c["board"]]) || default_board
+        column = (c["column_id"] && column_map[c["column_id"]]) || nil
+        if c["column"].present? && board
+          column ||= board.columns.find_by(name: c["column"])
+        end
+        creator = resolve_user(user_map, account, c["creator"] || c["creator_id"], requester)
+        Current.set(user: creator, account: account) do
+          status = %w[drafted published].include?(c["status"]) ? c["status"] : "published"
+          status = "published" if status == "drafted" && Array(c["comments"]).any?
+          card = board.cards.build(
+            title: c["title"].presence || "Untitled",
+            status: status,
+            column: column,
+            creator: creator,
+            created_at: parse_time(c["created_at"]) || Time.current,
+            updated_at: parse_time(c["updated_at"]) || Time.current,
+            due_on: c["due_on"].presence
+          )
+          card.number = c["number"] if c["number"]
+          card.save!
+          # Description with embeds
+          if c["description"].present?
+            html = rewrite_body(c["description"], entries, blob_cache, account)
+            card.update!(description: html)
+          end
+          # Image
+          if c["image"].present?
+            blob = fetch_blob(c["image"], entries, blob_cache, account, creator)
+            if blob
+              card.image.attach(blob)
+            end
+          end
+          # Comments
+          Array(c["comments"]).each do |cm|
+            next unless cm.is_a?(Hash)
+            comment_creator = resolve_user(user_map, account, cm["creator"], requester)
+            Current.set(user: comment_creator, account: account) do
+              body = cm["body"].presence || cm["text"].presence || ""
+              body = rewrite_body(body, entries, blob_cache, account)
+              comment = card.comments.build(creator: comment_creator, created_at: parse_time(cm["created_at"]) || Time.current, updated_at: parse_time(cm["updated_at"]) || Time.current)
+              # Assign body via rich text
+              comment.body = body
+              comment.save!
+            end
+          end
+        end
+      end
+    end
+
+    def parse_time(value)
+      Time.parse(value.to_s) rescue nil
+    end
+
+    def rewrite_body(html, entries, blob_cache, account)
+      return "" if html.blank?
+      doc = Nokogiri::HTML.fragment(html)
+      doc.css("action-text-attachment").each do |node|
+        file_path = attachment_path_for(node, entries)
+        if file_path && entries[file_path]
+          blob = fetch_blob(file_path, entries, blob_cache, account, nil)
+          if blob
+            node["sgid"] = blob.attachable_sgid
+            node["url"] = absolute_blob_url(blob, account)
+          end
+        end
+      end
+      doc.to_html
+    rescue => error
+      Rails.logger.error("rewrite_body failed: #{error.message}")
+      html
+    end
+
+    def attachment_path_for(node, entries)
+      # Try url, caption, filename hints to find file path
+      candidates = [ node["url"], node["filename"], node["caption"] ].compact
+      # Direct file path match
+      entries.keys.each do |key|
+        next unless key.start_with?("files/")
+        basename = File.basename(key)
+        candidates.each do |c|
+          if c.to_s.include?(basename) || c.to_s == key
+            return key
+          end
+        end
+      end
+      nil
+    end
+
+    def fetch_blob(file_path, entries, blob_cache, account, creator)
+      return blob_cache[file_path] if blob_cache[file_path].is_a?(ActiveStorage::Blob)
+      data = entries[file_path]
+      return nil unless data
+      filename = File.basename(file_path)
+      # Guess content type
+      content_type = Marcel::MimeType.for(StringIO.new(data), name: filename) rescue "application/octet-stream"
+      blob = ActiveStorage::Blob.create_before_direct_upload!(filename: filename, byte_size: data.bytesize, checksum: Digest::MD5.base64digest(data), content_type: content_type)
+      # Upload data to service (works for Disk and S3)
+      blob.service.upload(blob.key, StringIO.new(data))
+      # Associate account
+      blob.update!(account: account)
+      blob_cache[file_path] = blob
+      blob
+    end
+
+    def absolute_blob_url(blob, account)
+      Rails.application.routes.url_helpers.polymorphic_url(blob, only_path: true, script_name: account.slug)
+    rescue
+      "/rails/active_storage/blobs/redirect/#{blob.signed_id}/#{blob.filename}"
+    end
+end
