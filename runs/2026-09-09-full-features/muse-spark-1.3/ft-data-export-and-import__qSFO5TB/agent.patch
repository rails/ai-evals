+    <% if @import.completed? %>
+      <p>Your import is complete.</p>
+      <% if @import.imported_account %>
+        <p><%= link_to "Open #{@import.imported_account.name}", root_path(script_name: @import.imported_account.slug), class: "btn btn--primary" %></p>
