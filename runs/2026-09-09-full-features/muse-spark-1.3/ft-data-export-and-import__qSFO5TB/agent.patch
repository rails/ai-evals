+++ b/app/jobs/account/export_job.rb
@@ -0,0 +1,16 @@
+class Account::ExportJob < ApplicationJob
+  queue_as :default
+
+  def perform(export)
+    Current.set(account: export.account, user: export.user) do
+      Account::Exporter.new(export).perform
+      export.reload
+      if export.file.attached?
+        ExportMailer.ready(export).deliver_later
+      end
+    end
+  rescue => error
+    Rails.logger.error("Export #{export.id} failed: #{error.message}\n#{error.backtrace&.first(10)&.join("\n")}")
+    raise
+  end
+end
diff --git a/app/jobs/account/import_job.rb b/app/jobs/account/import_job.rb
new file mode 100644
index 0000000..fd3e42b
--- /dev/null
+++ b/app/jobs/account/import_job.rb
@@ -0,0 +1,30 @@
+class Account::ImportJob < ApplicationJob
+  queue_as :default
+
+  def perform(import)
+    Current.set(account: import.account, user: import.user) do
+      begin
+        new_account = Account::Importer.new(import).perform
+        import.update!(status: :completed, imported_account: new_account)
+        ImportMailer.completed(import).deliver_later
+      rescue Account::Importer::Failure => error
+        fail_import(import, error.message)
+      rescue => error
+        Rails.logger.error("Import #{import.id} failed: #{error.message}\n#{error.backtrace&.first(15)&.join("\n")}")
+        fail_import(import, error.message)
+      end
+    end
+  end
+
+  private
+    def fail_import(import, message)
+      # Ensure nothing is left behind: remove any partially created account.
+      if import.imported_account_id.present?
+        Account.find_by(id: import.imported_account_id)&.destroy
+      end
+      import.update!(status: :failed, error_message: message)
+      ImportMailer.failed(import).deliver_later
+    rescue => error
+      Rails.logger.error("Failed to mark import as failed: #{error.message}")
+    end
+end
