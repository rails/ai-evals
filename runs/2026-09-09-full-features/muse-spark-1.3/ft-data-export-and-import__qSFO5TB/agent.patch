index 0000000..0a7cd11
--- /dev/null
+++ b/app/mailers/import_mailer.rb
@@ -0,0 +1,17 @@
+class ImportMailer < ApplicationMailer
+  def completed(import)
+    @import = import
+    @account = import.account
+    @user = import.user
+    @new_account = import.imported_account
+    mail(to: @user.identity.email_address, subject: "Your import is complete")
+  end
+
+  def failed(import)
+    @import = import
+    @account = import.account
+    @user = import.user
+    @error = import.error_message
+    mail(to: @user.identity.email_address, subject: "Your import failed")
+  end
+end
