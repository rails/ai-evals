diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..7fc185d
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,314 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+
+// Allows people to change a card's column or status by dragging it across
+// the board. Moves are optimistic: the card is placed in the target column
+// synchronously on drop, then persisted in the background as JSON so no
+// Turbo Stream render shifts the board afterwards. Cards only move between
+// columns, never within one.
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+
+  connect() {
+    this.draggedCard = null
+    this.sourceColumn = null
+
+    this._onDragStart = this.dragStart.bind(this)
+    this._onDragEnd = this.dragEnd.bind(this)
+    this._onDragOver = this.dragOver.bind(this)
+    this._onDragLeave = this.dragLeave.bind(this)
+    this._onDrop = this.drop.bind(this)
+
+    this.element.addEventListener("dragstart", this._onDragStart)
+    this.element.addEventListener("dragend", this._onDragEnd)
+    this.element.addEventListener("dragover", this._onDragOver)
+    this.element.addEventListener("dragleave", this._onDragLeave)
+    this.element.addEventListener("drop", this._onDrop)
+
+    this.#enableItems()
+    this.#observeNewItems()
+  }
+
+  disconnect() {
+    this.element.removeEventListener("dragstart", this._onDragStart)
+    this.element.removeEventListener("dragend", this._onDragEnd)
+    this.element.removeEventListener("dragover", this._onDragOver)
+    this.element.removeEventListener("dragleave", this._onDragLeave)
+    this.element.removeEventListener("drop", this._onDrop)
+    this._observer?.disconnect()
+  }
+
+  // Actions (also wired via delegation, so they work for turbo-frame content)
+
+  dragStart(event) {
+    const card = this.#cardFromEvent(event)
+    if (!card) return
+    if (!this.#isDraggableCard(card)) return
+
+    this.draggedCard = card
+    this.sourceColumn = this.#columnFor(card)
+
+    try {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id || "")
+    } catch (_) {
+      // Some browsers throw when dataTransfer is unavailable; dragging still works.
+    }
+
+    card.classList.add(DRAGGED_CLASS)
+  }
+
+  dragOver(event) {
+    if (!this.draggedCard) return
+
+    const column = this.#columnFromEvent(event)
+    if (!column) return
+
+    // Required to allow dropping.
+    event.preventDefault()
+    try {
+      event.dataTransfer.dropEffect = "move"
+    } catch (_) {}
+
+    if (column !== this._hoverColumn) {
+      this.#clearHover()
+      column.classList.add(HOVER_CLASS)
+      this._hoverColumn = column
+    }
+  }
+
+  dragLeave(event) {
+    const column = this.#columnFromEvent(event)
+    if (!column) return
+
+    // Only clear when truly leaving the column, not moving between children.
+    if (column.contains(event.relatedTarget)) return
+
+    column.classList.remove(HOVER_CLASS)
+    if (this._hoverColumn === column) this._hoverColumn = null
+  }
+
+  drop(event) {
+    if (!this.draggedCard) return
+
+    const targetColumn = this.#columnFromEvent(event)
+    if (!targetColumn) return
+
+    event.preventDefault()
+
+    const card = this.draggedCard
+    const sourceColumn = this.sourceColumn
+
+    this.#clearHover()
+
+    // Columns keep their own order: moves within the same column are a no-op.
+    if (sourceColumn && sourceColumn === targetColumn) {
+      return
+    }
+
+    // Instant: place the board exactly as left before persisting.
+    this.#moveCardToColumn(card, targetColumn)
+
+    // Persist in the background without disturbing the board.
+    this.#saveCardMove(card, targetColumn, sourceColumn)
+  }
+
+  dragEnd() {
+    if (this.draggedCard) {
+      this.draggedCard.classList.remove(DRAGGED_CLASS)
+    }
+    this.#clearHover()
+    this.draggedCard = null
+    this.sourceColumn = null
+  }
+
+  // Private
+
+  #moveCardToColumn(card, column) {
+    const list = column.querySelector(".cards__list")
+
+    if (list) {
+      // Prepend so the optimistic position matches the server's
+      // latest-first ordering (drag bumps last_active_at to now).
+      // Insert before pagination wrappers when present so the card lands on top.
+      list.prepend(card)
+    } else {
+      column.appendChild(card)
+    }
+  }
+
+  #saveCardMove(card, targetColumn, sourceColumn) {
+    const { type, columnId } = this.#columnInfo(targetColumn)
+    const urls = this.#cardUrls(card)
+
+    let request
+
+    if (type === "maybe") {
+      if (!urls.triageUrl) return
+      request = destroy(urls.triageUrl, { responseKind: "json" })
+    } else if (type === "not_now") {
+      if (!urls.notNowUrl) return
+      request = post(urls.notNowUrl, { responseKind: "json" })
+    } else if (type === "closed") {
+      if (!urls.closureUrl) return
+      request = post(urls.closureUrl, { responseKind: "json" })
+    } else {
+      if (!urls.triageUrl || !columnId) return
+      request = post(urls.triageUrl, { query: { column_id: columnId }, responseKind: "json" })
+    }
+
+    // Fire-and-forget: the board is already correct. On failure, put the
+    // card back where it came from so the board still matches the server.
+    Promise.resolve(request).catch(() => {
+      if (sourceColumn) {
+        try {
+          const list = sourceColumn.querySelector(".cards__list")
+          if (list) {
+            list.prepend(card)
+          } else {
+            sourceColumn.appendChild(card)
+          }
+        } catch (_) {}
+      }
+    })
+  }
+
+  #columnInfo(column) {
+    const dataset = column.dataset || {}
+
+    const explicitId = dataset.dragAndDropColumnId || dataset.columnId
+    const explicitType = dataset.dragAndDropColumnType || dataset.columnType || dataset.dropType
+
+    if (explicitType) {
+      return { type: explicitType, columnId: explicitId || null }
+    }
+
+    const id = column.id || ""
+
+    if (id === "maybe") return { type: "maybe", columnId: null }
+    if (id === "not-now") return { type: "not_now", columnId: null }
+    if (id === "closed-cards") return { type: "closed", columnId: null }
+
+    if (explicitId) return { type: "column", columnId: explicitId }
+
+    // Regular columns use dom_id(column) => "column_<uuid>".
+    if (id.startsWith("column_")) {
+      const columnId = id.replace(/^column_/, "")
+      if (columnId && columnId !== "cards") {
+        return { type: "column", columnId }
+      }
+    }
+
+    // Fallback: derive from the nested cards frame id "column_<uuid>_cards".
+    const frame = column.querySelector('turbo-frame[id$="_cards"]')
+    if (frame && frame.id) {
+      const match = frame.id.match(/^column_(.+)_cards$/)
+      if (match) return { type: "column", columnId: match[1] }
+    }
+
+    return { type: "column", columnId: null }
+  }
+
+  #cardUrls(card) {
+    const dataset = card.dataset || {}
+
+    let triageUrl = dataset.cardTriageUrl
+    let notNowUrl = dataset.cardNotNowUrl
+    let closureUrl = dataset.cardClosureUrl
+
+    if (triageUrl && notNowUrl && closureUrl) {
+      return { triageUrl, notNowUrl, closureUrl }
+    }
+
+    const base = this.#baseCardPath(card)
+
+    if (base) {
+      triageUrl = triageUrl || `${base}/triage`
+      notNowUrl = notNowUrl || `${base}/not_now`
+      closureUrl = closureUrl || `${base}/closure`
+    }
+
+    return { triageUrl, notNowUrl, closureUrl }
+  }
+
+  #baseCardPath(card) {
+    const link = card.querySelector("a.card__link[href], a[href*='/cards/']")
+    const href = link?.getAttribute("href")
+    if (href) {
+      try {
+        return new URL(href, window.location.origin).pathname
+      } catch (_) {
+        return href.split("?")[0]
+      }
+    }
+
+    // Derive from a known action URL, e.g. "/cards/1/closure" -> "/cards/1".
+    for (const url of [ card.dataset?.cardClosureUrl, card.dataset?.cardNotNowUrl, card.dataset?.cardTriageUrl ]) {
+      if (url) {
+        const path = url.split("?")[0]
+        const match = path.match(/^(.+)\/(closure|not_now|triage)$/)
+        if (match) return match[1]
+        return path
+      }
+    }
+
+    return null
+  }
+
+  #cardFromEvent(event) {
+    const target = event.target
+    if (!(target instanceof Element)) return null
+    return target.closest('[data-drag-and-drop-target="item"], .card')
+  }
+
+  #columnFromEvent(event) {
+    const target = event.target
+    if (!(target instanceof Element)) return null
+    const column = target.closest('[data-drag-and-drop-target="container"], .cards')
+    if (column && this.element.contains(column)) return column
+    return null
+  }
+
+  #columnFor(card) {
+    return card.closest('[data-drag-and-drop-target="container"], .cards')
+  }
+
+  #isDraggableCard(card) {
+    if (card.getAttribute("draggable") === "false") return false
+    return true
+  }
+
+  #clearHover() {
+    this.element.querySelectorAll(`.${HOVER_CLASS}`).forEach((el) => el.classList.remove(HOVER_CLASS))
+    this._hoverColumn = null
+  }
+
+  #enableItems() {
+    this.element.querySelectorAll(".card:not([draggable])").forEach((card) => {
+      card.setAttribute("draggable", "true")
+    })
+  }
+
+  #observeNewItems() {
+    if (typeof MutationObserver === "undefined") return
+
+    this._observer = new MutationObserver((mutations) => {
+      for (const mutation of mutations) {
+        for (const node of mutation.addedNodes) {
+          if (!(node instanceof Element)) continue
+          if (node.matches?.(".card") && !node.hasAttribute("draggable")) {
+            node.setAttribute("draggable", "true")
+          }
+          node.querySelectorAll?.(".card:not([draggable])").forEach((card) => {
+            card.setAttribute("draggable", "true")
+          })
+        }
+      }
+    })
+
+    this._observer.observe(this.element, { childList: true, subtree: true })
+  }
+}
