+class Sessions::MagicLinksController < ApplicationController
+  include MagicLinkAuthentication
+
+  disallow_account_scope
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  def new
+    @magic_link = find_pending_magic_link
+
+    if @magic_link.nil?
+      redirect_to new_session_path
+    end
+  end
+
+  def create
+    magic_link = find_pending_magic_link
+
+    if verify_magic_link_code(magic_link, params[:code])
+      email_address = magic_link.email_address
+      identity = Identity.find_by(email_address: email_address)
+
+      if identity.nil? && !Account.accepting_signups?
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "Couldn't find an account for that email." }
+          format.json { render json: { message: "Couldn't find an account for that email." }, status: :unauthorized }
+        end
+        return
+      end
+
+      identity ||= Identity.create!(email_address: email_address)
+
+      magic_link.consume!
+      clear_pending_authentication_token
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
