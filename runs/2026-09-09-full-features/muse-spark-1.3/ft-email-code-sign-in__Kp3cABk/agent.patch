diff --git a/app/controllers/concerns/magic_link_authentication.rb b/app/controllers/concerns/magic_link_authentication.rb
new file mode 100644
index 0000000..7386cf0
--- /dev/null
+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,50 @@
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  PENDING_COOKIE = :pending_authentication_token
+
+  private
+    def issue_magic_link_for(email_address)
+      magic_link = MagicLink.create!(email_address: email_address)
+      MagicLinkMailer.code_email(magic_link: magic_link).deliver_now
+
+      token = pending_token_for(magic_link)
+      set_pending_authentication_token(token)
+
+      magic_link
+    end
+
+    def pending_token_for(magic_link)
+      magic_link.signed_id(purpose: :magic_link, expires_in: MagicLink::EXPIRY_DURATION)
+    end
+
+    def set_pending_authentication_token(token)
+      cookies[PENDING_COOKIE] = {
+        value: token,
+        httponly: true,
+        same_site: :lax,
+        expires: MagicLink::EXPIRY_DURATION.from_now
+      }
+    end
+
+    def clear_pending_authentication_token
+      cookies.delete(PENDING_COOKIE)
+    end
+
+    def pending_authentication_token
+      cookies.signed[PENDING_COOKIE] || cookies[PENDING_COOKIE] || params[:pending_authentication_token]
+    end
+
+    def find_pending_magic_link
+      token = pending_authentication_token
+      return nil if token.blank?
+
+      MagicLink.find_signed(token, purpose: :magic_link)
+    rescue StandardError
+      nil
+    end
+
+    def verify_magic_link_code(magic_link, code)
+      magic_link.present? && magic_link.valid_code?(code)
+    end
+end
