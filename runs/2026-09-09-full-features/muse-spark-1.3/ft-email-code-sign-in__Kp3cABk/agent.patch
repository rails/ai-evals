@@ -0,0 +1,69 @@
+class JoinCodes::MagicLinksController < ApplicationController
+  include MagicLinkAuthentication
+
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+
+  layout "public"
+
+  def new
+    @magic_link = find_pending_magic_link
+
+    if @magic_link.nil?
+      redirect_to join_path(code: @join_code.code)
+    end
+  end
+
+  def create
+    magic_link = find_pending_magic_link
+    code = request.request_parameters[:code] || params[:code]
+
+    # Distinguish verification code from join code in path when they share the name:
+    # path param is join_code, body param is code (no collision due to distinct names),
+    # but also support posting to this endpoint with plain `code`.
+    if verify_magic_link_code(magic_link, code)
+      identity = Identity.find_or_create_by!(email_address: magic_link.email_address)
+
+      magic_link.consume!
+      clear_pending_authentication_token
+      start_new_session_for identity
+
+      @join_code.redeem_if { |account| identity.join(account) }
+      user = User.active.find_by!(account: @join_code.account, identity: identity)
+      user.verify if user.respond_to?(:verify)
+
+      respond_to do |format|
+        format.html do
+          if user.setup?
+            redirect_to landing_url(script_name: @join_code.account.slug)
+          else
+            redirect_to new_users_verification_url(script_name: @join_code.account.slug)
+          end
+        end
+        format.json { render json: { session_token: session_token }, status: :created }
+      end
+    else
+      respond_to do |format|
+        format.html { redirect_to join_magic_link_path(join_code: @join_code.code), alert: "That code didn't work. Try again." }
+        format.json { render json: { message: "That code didn't work. Try again." }, status: :unauthorized }
+      end
+    end
+  end
+
+  private
+    def set_join_code
+      join_code_param = request.path_parameters[:join_code] || params[:join_code] || request.path_parameters[:code] || params[:code]
+      @join_code ||= Account::JoinCode.find_by(code: join_code_param, account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render :"join_codes/inactive", status: :gone
+      end
+    end
+end
