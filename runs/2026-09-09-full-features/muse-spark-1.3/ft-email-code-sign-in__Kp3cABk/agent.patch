--- /dev/null
+++ b/app/mailers/magic_link_mailer.rb
@@ -0,0 +1,13 @@
+class MagicLinkMailer < ApplicationMailer
+  def code_email(magic_link:)
+    @magic_link = magic_link
+    @code = magic_link.code
+
+    Rails.logger.info "[MagicLink] Verification code for #{magic_link.email_address}: #{@code}"
+
+    mail(
+      to: magic_link.email_address,
+      subject: "Your Fizzy verification code is #{@code}"
+    )
+  end
+end
diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..8ed2408
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,44 @@
+class MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRY_DURATION = 15.minutes
+  CODE_CHARSET = %w[ A B C D E F G H J K L M N P Q R S T U V W X Y Z 2 3 4 5 6 7 8 9 ].freeze
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  before_validation :generate_code, :set_expiry, on: :create
+
+  def expired?
+    expires_at < Time.current
+  end
+
+  def valid_code?(input)
+    return false if expired?
+    return false if input.blank?
+
+    ActiveSupport::SecurityUtils.secure_compare(normalize_code(code), normalize_code(input.to_s))
+  rescue ArgumentError
+    false
+  end
+
+  def consume!
+    destroy!
+  end
+
+  private
+    def generate_code
+      self.code ||= loop do
+        candidate = Array.new(CODE_LENGTH) { CODE_CHARSET.sample }.join
+        # uniqueness not strictly required, but avoid collision for same email
+        break candidate unless self.class.exists?(email_address: email_address, code: candidate)
+      end
+    end
+
+    def set_expiry
+      self.expires_at ||= EXPIRY_DURATION.from_now
+    end
+
+    def normalize_code(value)
+      value.to_s.strip.upcase
+    end
+end
