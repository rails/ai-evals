+<% @page_title = "Enter your code to join #{@join_code.account.name}" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+
+  <p>We sent a six-character code to <strong><%= @magic_link.email_address %></strong>. Enter it below to join.</p>
+
