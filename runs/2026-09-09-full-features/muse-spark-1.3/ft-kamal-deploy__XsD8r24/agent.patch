diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..77e1b44
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,109 @@
+# Fizzy single-box deployment with Kamal.
+#
+# This config deploys Fizzy to a single Linux server with Docker:
+# SQLite, Active Storage files, Solid Cache / Queue / Cable databases all live
+# in /rails/storage, which is persisted in a Docker volume so data survives
+# redeploys. The web container serves traffic via Thruster on port 80 behind
+# kamal-proxy, which terminates SSL with an automatic Let's Encrypt certificate.
+# A second container on the same host runs `bin/jobs` (Solid Queue) so
+# background jobs run on the same box.
+#
+# Setup for a fork:
+#
+#   1. Fill in HOSTNAME below with the public hostname users will visit
+#      (DNS must point at your server), and SERVER_IP with your server's
+#      IP or SSH hostname.
+#   2. Fill in IMAGE below with your container image name
+#      (e.g. your-dockerhub-user/fizzy) and the registry credentials.
+#   3. Fill in the mail server settings under `env.clear` (SMTP_ADDRESS, etc.)
+#      and set MAILER_FROM_ADDRESS to an address on your domain.
+#   4. Copy the secrets template and fill in real values:
+#
+#        cp .kamal/secrets.example .kamal/secrets
+#        # then edit .kamal/secrets
+#
+#      Required secrets: KAMAL_REGISTRY_PASSWORD, RAILS_MASTER_KEY,
+#      SMTP_PASSWORD (if your mail server needs authentication).
+#      Generate the Rails master key material with:
+#
+#        bin/rails credentials:edit
+#        # or: openssl rand -hex 32  (for SECRET_KEY_BASE, if used)
+#
+#      `.kamal/secrets` is git-ignored -- never commit it.
+#   5. Deploy:
+#
+#        bin/kamal setup
+#        # later deploys:
+#        bin/kamal deploy
+#
+#   You should then have Fizzy at https://HOSTNAME with data that survives
+#   the next `bin/kamal deploy`.
+
+service: fizzy
+
+# Container image to build and push. Replace with your own repository.
+# e.g. image: your-dockerhub-user/fizzy
+image: your-user/fizzy
+
+# Single box: web and jobs run on the same host.
+# Replace 192.168.0.1 with your server's IP or SSH hostname in both roles.
+servers:
+  web:
+    hosts:
+      - 192.168.0.1
+  jobs:
+    hosts:
+      - 192.168.0.1
+    cmd: bin/jobs
+
+# kamal-proxy terminates SSL and forwards to Thruster (port 80 in the
+# container, see Dockerfile CMD). `host` must be the public hostname that
+# points at the server above; it is used for routing and for the
+# Let's Encrypt certificate.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+  app_port: 80
+
+# Credentials for the container registry (Docker Hub by default).
+# KAMAL_REGISTRY_PASSWORD comes from `.kamal/secrets`.
+registry:
+  username: your-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64
+
+# Share fingerprinted assets between releases to avoid 404s during deploys.
+asset_path: /rails/public/assets
+
+# Persist everything in /rails/storage (SQLite databases for primary, cache,
+# queue, cable + Active Storage files + lock files) so `kamal setup` data
+# survives the next deploy.
+volumes:
+  - fizzy_storage:/rails/storage
+
+env:
+  clear:
+    RAILS_ENV: production
+    # Run Solid Queue in the dedicated `jobs` container, not inside Puma.
+    SOLID_QUEUE_IN_PUMA: "false"
+    # Public hostname users visit. Used for mailer/controller URLs (see
+    # config/environments/production.rb). Must match `proxy.host` above.
+    APP_HOST: fizzy.example.com
+    # Outbound mail server. Fill in your provider's settings.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: "587"
+    SMTP_DOMAIN: fizzy.example.com
+    SMTP_USERNAME: fizzy@example.com
+    SMTP_AUTHENTICATION: login
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+  secret:
+    - RAILS_MASTER_KEY
+    - SMTP_PASSWORD
+
+# SSH in as root by default on a fresh Linux box. Uncomment to use another user.
+# ssh:
+#   user: root
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..8fd7dee 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -80,6 +80,23 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Single-box (Kamal) mail + host configuration. All values are set via
+  # `env.clear` / `env.secret` in config/deploy.yml so a fork only has to
+  # fill in APP_HOST and the SMTP_* settings there.
+  app_host = ENV.fetch("APP_HOST", ENV.fetch("HOST", "example.com"))
+  config.action_controller.default_url_options = { host: app_host, protocol: "https" }
+  config.action_mailer.default_url_options = { host: app_host, protocol: "https" }
+  config.action_mailer.delivery_method = :smtp
+  config.action_mailer.smtp_settings = {
+    address: ENV.fetch("SMTP_ADDRESS", "localhost"),
+    port: Integer(ENV.fetch("SMTP_PORT", "25")),
+    domain: ENV.fetch("SMTP_DOMAIN", app_host),
+    user_name: ENV["SMTP_USERNAME"].presence,
+    password: ENV["SMTP_PASSWORD"].presence,
+    authentication: ENV.fetch("SMTP_AUTHENTICATION", "login").presence,
+    enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+  }.compact
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
