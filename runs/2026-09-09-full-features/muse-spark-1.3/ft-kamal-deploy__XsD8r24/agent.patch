diff --git a/.kamal/secrets.example b/.kamal/secrets.example
new file mode 100644
index 0000000..4610e8c
--- /dev/null
+++ b/.kamal/secrets.example
@@ -0,0 +1,21 @@
+# Template for Kamal secrets (dotenv format). Copy and fill in real values:
+#
+#   cp .kamal/secrets.example .kamal/secrets
+#
+# `.kamal/secrets` is git-ignored -- never commit real secrets.
+# Kamal loads this file locally; values listed under `env.secret` in
+# config/deploy.yml are copied to the server in an env file (not baked into
+# the image).
+
+# Docker registry password / access token (see `registry` in config/deploy.yml).
+KAMAL_REGISTRY_PASSWORD=replace-with-registry-password-or-token
+
+# Rails credential master key (`config/master.key` content). Required if you
+# use Rails credentials; otherwise still set it so `kamal setup` has it.
+# Generate with `bin/rails credentials:edit` or copy from config/master.key.
+RAILS_MASTER_KEY=replace-with-output-of-cat-config-master-key
+
+# SMTP password for the mail server configured in config/deploy.yml
+# (`SMTP_USERNAME`). Leave blank if your mail server needs no authentication,
+# otherwise set the real password.
+SMTP_PASSWORD=replace-with-smtp-password
