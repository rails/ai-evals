diff --git a/app/controllers/activities_controller.rb b/app/controllers/activities_controller.rb
new file mode 100644
index 0000000..c6db1d2
--- /dev/null
+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,49 @@
+class ActivitiesController < ApplicationController
+  TIMELINEABLE_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    comment_created
+    card_title_changed
+  ]
+
+  def index
+    set_page_and_extract_portion_from activity_scope
+
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  private
+    def activity_scope
+      events = Event.preloaded.where(board: accessible_boards, action: TIMELINEABLE_ACTIONS)
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events.order(created_at: :desc, id: :desc)
+    end
+
+    def accessible_boards
+      boards = Current.user.boards
+      boards = boards.where(id: board_ids) if board_ids.present?
+      boards
+    end
+
+    def creator_ids
+      @creator_ids ||= normalize_id_list(params[:creator_ids])
+    end
+
+    def board_ids
+      @board_ids ||= normalize_id_list(params[:board_ids])
+    end
+
+    def normalize_id_list(value)
+      Array(value).flatten.compact_blank
+    end
+end
diff --git a/app/views/activities/_activity.json.jbuilder b/app/views/activities/_activity.json.jbuilder
new file mode 100644
index 0000000..ffd3915
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,34 @@
+json.(activity, :id, :action)
+json.created_at activity.created_at.utc
+json.description activity.description_for(Current.user).to_plain_text
+
+particulars = case activity.action
+when "card_assigned", "card_unassigned"
+  ids = activity.assignee_ids.presence || activity.particulars["assignee_ids"] || activity.particulars[:assignee_ids]
+  { "assignee_ids" => Array(ids) }
+when "card_board_changed"
+  nested = activity.particulars["particulars"] || activity.particulars[:particulars] || {}
+  { "old_board" => nested["old_board"] || nested[:old_board] || "", "new_board" => nested["new_board"] || nested[:new_board] || "" }
+when "card_title_changed"
+  nested = activity.particulars["particulars"] || activity.particulars[:particulars] || {}
+  { "old_title" => nested["old_title"] || nested[:old_title] || "", "new_title" => nested["new_title"] || nested[:new_title] || "" }
+when "card_triaged"
+  nested = activity.particulars["particulars"] || activity.particulars[:particulars] || {}
+  { "column" => nested["column"] || nested[:column] || "" }
+else
+  {}
+end
+json.particulars particulars
+
+json.url polymorphic_url(activity.eventable)
+json.eventable_type activity.eventable_type
+
+case activity.eventable
+when Card
+  json.eventable activity.eventable, partial: "cards/card", as: :card
+when Comment
+  json.eventable activity.eventable, partial: "cards/comments/comment", as: :comment
+end
+
+json.board activity.board, partial: "boards/board", as: :board
+json.creator activity.creator, partial: "users/user", as: :user
