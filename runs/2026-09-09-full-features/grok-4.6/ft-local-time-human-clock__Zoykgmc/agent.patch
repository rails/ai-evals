index 90020f0..f3f083e 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,12 @@
 module TimeHelper
+  # Render a <time> whose label is filled in by the browser, in the viewer's
+  # timezone. The server only sends the raw UTC timestamp so the HTML can be
+  # cached and shared.
+  def local_time_tag(time, format: :relative, **attributes)
+    data = attributes.delete(:data) || {}
+    data[:controller] = token_list(data[:controller], "local-time")
+    data[:local_time_format_value] = format
+
+    tag.time **attributes, datetime: time.to_time.utc.iso8601, data: data
+  end
 end
diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..b7c85b8
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,30 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime } from "helpers/local_time_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  #timer
+
+  connect() {
+    this.#render()
+
+    if (this.formatValue === "relative") {
+      this.#timer = setInterval(() => this.#render(), REFRESH_INTERVAL)
+    }
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  #render() {
+    const date = new Date(this.element.dateTime)
+    if (isNaN(date)) return
+
+    this.element.textContent = formatLocalTime(date, this.formatValue)
+    this.element.title = formatLocalTime(date, "full")
+  }
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..55c1b44
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,78 @@
+const MS_PER_DAY = 1000 * 60 * 60 * 24
+
+export function formatLocalTime(date, format = "relative") {
+  switch (format) {
+    case "date":
+      return formatDate(date)
+    case "long_date":
+      return formatLongDate(date)
+    case "time":
+      return formatTime(date)
+    case "weekday":
+      return formatWeekday(date)
+    case "datetime":
+      return formatDatetime(date)
+    case "full":
+      return formatFull(date)
+    default:
+      return formatRelative(date)
+  }
+}
+
+export function formatRelative(date, now = new Date()) {
+  const days = differenceInLocalDays(now, date)
+
+  if (days === 0) {
+    return date >= now ? "today" : formatTime(date)
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days > 1) {
+    return `in ${days} days`
+  } else if (days < -1 && days > -7) {
+    return `${-days} days ago`
+  } else {
+    return formatDate(date)
+  }
+}
+
+export function differenceInLocalDays(fromDate, toDate) {
+  return Math.round((beginningOfLocalDay(toDate) - beginningOfLocalDay(fromDate)) / MS_PER_DAY)
+}
+
+function beginningOfLocalDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+function formatDate(date) {
+  const options = { month: "short", day: "numeric" }
+  if (date.getFullYear() !== new Date().getFullYear()) options.year = "numeric"
+  return new Intl.DateTimeFormat("en-US", options).format(date)
+}
+
+function formatLongDate(date) {
+  return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(date)
+}
+
+function formatTime(date) {
+  return new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }).format(date)
+}
+
+function formatWeekday(date) {
+  return new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" }).format(date)
+}
+
+function formatDatetime(date) {
+  return new Intl.DateTimeFormat("en-US", {
+    month: "numeric", day: "numeric", year: "2-digit",
+    hour: "numeric", minute: "2-digit"
+  }).format(date)
+}
+
+function formatFull(date) {
+  return new Intl.DateTimeFormat("en-US", {
+    weekday: "long", month: "long", day: "numeric", year: "numeric",
+    hour: "numeric", minute: "2-digit"
+  }).format(date)
+}
