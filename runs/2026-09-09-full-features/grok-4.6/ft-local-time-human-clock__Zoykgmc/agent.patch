diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..67e2cba
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,52 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  def parse(html)
+    Nokogiri::HTML::DocumentFragment.parse(html)
+  end
+
+  test "emits a time tag with a UTC timestamp for the browser to format" do
+    time = Time.utc(2025, 9, 12, 18, 42, 0)
+    html = local_time_tag(time)
+
+    assert_select parse(html), "time[datetime='2025-09-12T18:42:00Z'][data-controller='local-time'][data-local-time-format-value='relative']"
+  end
+
+  test "datetime stays in UTC regardless of the server timezone" do
+    time = Time.utc(2025, 9, 12, 18, 42, 0)
+
+    Time.use_zone("America/Los_Angeles") do
+      html = local_time_tag(time)
+      assert_select parse(html), "time[datetime='2025-09-12T18:42:00Z']"
+    end
+
+    Time.use_zone("Asia/Tokyo") do
+      html = local_time_tag(Time.zone.parse("2025-09-13 03:42:00"))
+      assert_select parse(html), "time[datetime='2025-09-12T18:42:00Z']"
+    end
+  end
+
+  test "accepts a format for the browser" do
+    time = Time.utc(2025, 9, 12, 18, 42, 0)
+
+    assert_select parse(local_time_tag(time, format: :date)), "time[data-local-time-format-value='date']"
+    assert_select parse(local_time_tag(time, format: :long_date)), "time[data-local-time-format-value='long_date']"
+    assert_select parse(local_time_tag(time, format: :time)), "time[data-local-time-format-value='time']"
+    assert_select parse(local_time_tag(time, format: :weekday)), "time[data-local-time-format-value='weekday']"
+    assert_select parse(local_time_tag(time, format: :datetime)), "time[data-local-time-format-value='datetime']"
+  end
+
+  test "merges extra attributes and existing stimulus controllers" do
+    time = Time.utc(2025, 9, 12, 18, 42, 0)
+    html = local_time_tag(time, class: "event__timestamp", data: { controller: "tooltip" })
+
+    assert_select parse(html), "time.event__timestamp[data-controller='tooltip local-time']"
+  end
+
+  test "does not bake a formatted clock into the HTML" do
+    time = Time.utc(2025, 9, 12, 18, 42, 0)
+
+    html = local_time_tag(time)
+    assert_no_match(/1:42|6:42|Friday|Sep/, html)
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..a76b8a6
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,15 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "formats timestamps in the browser instead of the server" do
+    sign_in_as(users(:kevin))
+    comment = comments(:logo_agreement_kevin)
+    comment.update_column(:created_at, Time.utc(2025, 9, 12, 18, 42, 0))
+
+    visit card_url(comment.card)
+
+    time = find("time[datetime='2025-09-12T18:42:00Z']")
+    assert_not_equal "", time.text.strip
+    assert_no_match(/2025-09-12T18:42:00Z/, time.text)
+  end
+end
