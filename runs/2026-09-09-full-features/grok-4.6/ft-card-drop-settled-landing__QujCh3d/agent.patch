diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..b144915
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,136 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+
+export default class extends Controller {
+  static targets = [ "container", "item" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  connect() {
+    this.draggedItem = null
+    this.hoveredContainer = null
+  }
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  dragstart(event) {
+    const item = this.#itemContaining(event.target)
+    if (!item) return
+
+    this.draggedItem = item
+    item.classList.add(this.draggedItemClass)
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+  }
+
+  dragover(event) {
+    if (!this.draggedItem) return
+
+    const container = this.#containerContaining(event.target)
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+      this.#highlight(container)
+    } else {
+      this.#clearHighlight()
+    }
+  }
+
+  drop(event) {
+    event.preventDefault()
+
+    const container = this.#containerContaining(event.target)
+    const item = this.draggedItem
+    if (!this.#canDrop(item, container)) return
+
+    this.#move(item, container)
+    this.#lockBoard()
+    this.#save(item, container)
+  }
+
+  dragend() {
+    this.draggedItem?.classList.remove(this.draggedItemClass)
+    this.draggedItem = null
+    this.#clearHighlight()
+  }
+
+  // Private
+
+  #canDrop(item, container) {
+    return item && container &&
+      this.#containerContaining(item) !== container &&
+      this.#listIn(container) &&
+      this.#requestFor(item, container)
+  }
+
+  #itemContaining(element) {
+    return this.itemTargets.find(item => item.contains(element))
+  }
+
+  #containerContaining(element) {
+    return this.containerTargets.find(container => container.contains(element))
+  }
+
+  #highlight(container) {
+    if (this.hoveredContainer === container) return
+
+    this.#clearHighlight()
+    this.hoveredContainer = container
+    container.classList.add(this.hoverContainerClass)
+  }
+
+  #clearHighlight() {
+    this.hoveredContainer?.classList.remove(this.hoverContainerClass)
+    this.hoveredContainer = null
+  }
+
+  #move(item, container) {
+    this.#listIn(container).prepend(item)
+  }
+
+  #lockBoard() {
+    this.element.closest("turbo-frame#cards_container")?.setAttribute("data-turbo-permanent", "")
+  }
+
+  async #save(item, container) {
+    const { method, url, query } = this.#requestFor(item, container)
+    const options = { responseKind: "json", query }
+
+    if (method === "delete") {
+      await destroy(url, options)
+    } else {
+      await post(url, options)
+    }
+  }
+
+  #requestFor(item, container) {
+    const request = this.#requestDetailsFor(item, container)
+    if (request?.url) return request
+  }
+
+  #requestDetailsFor(item, container) {
+    if (container.dataset.columnId) {
+      return { method: "post", url: item.dataset.cardTriageUrl, query: { column_id: container.dataset.columnId } }
+    }
+
+    switch (container.dataset.dropAction) {
+      case "stream":
+        return { method: "delete", url: item.dataset.cardTriageUrl }
+      case "not_now":
+        return { method: "post", url: item.dataset.cardNotNowUrl }
+      case "closed":
+        return { method: "post", url: item.dataset.cardClosureUrl }
+    }
+  }
+
+  #listIn(container) {
+    return container.querySelector(".cards__list")
+  }
+}
