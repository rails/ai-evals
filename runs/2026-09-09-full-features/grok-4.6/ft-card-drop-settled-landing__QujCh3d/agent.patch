diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..0c19a5b
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,103 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+    @card = cards(:buy_domain)
+    @column = columns(:writebook_in_progress)
+  end
+
+  test "dragging a card to a column moves it immediately and persists" do
+    visit_board_and_wait_for_card
+
+    assert_selector "#maybe ##{dom_id(@card, :article)}"
+
+    drag_card @card, to: "##{dom_id(@column)}"
+
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_no_selector "#maybe ##{dom_id(@card, :article)}"
+    assert_card_persists { @card.reload.column == @column }
+  end
+
+  test "dragging a card to Done closes it immediately and persists" do
+    visit_board_and_wait_for_card
+
+    drag_card @card, to: "#closed-cards"
+
+    assert_selector "#closed-cards ##{dom_id(@card, :article)}", visible: :all
+    assert_card_persists { @card.reload.closed? }
+  end
+
+  test "dragging a card to Not Now postpones it immediately and persists" do
+    visit_board_and_wait_for_card
+
+    drag_card @card, to: "#not-now"
+
+    assert_selector "#not-now ##{dom_id(@card, :article)}", visible: :all
+    assert_card_persists { @card.reload.postponed? }
+  end
+
+  test "dragging a card to Maybe? sends it back to triage immediately" do
+    @card = cards(:logo)
+    visit board_url(@board)
+    assert_selector "##{dom_id(@card, :article)}", visible: :all
+
+    drag_card @card, to: "#maybe"
+
+    assert_selector "#maybe ##{dom_id(@card, :article)}"
+    assert_card_persists { @card.reload.awaiting_triage? }
+  end
+
+  test "dropping a card on its own column does not move it" do
+    visit_board_and_wait_for_card
+
+    drag_card @card, to: "#maybe"
+
+    assert_selector "#maybe ##{dom_id(@card, :article)}"
+    assert_card_persists { @card.reload.awaiting_triage? }
+  end
+
+  test "a dropped card stays where it was dropped" do
+    visit_board_and_wait_for_card
+
+    drag_card @card, to: "##{dom_id(@column)}"
+
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    sleep 1
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_no_selector "#maybe ##{dom_id(@card, :article)}"
+  end
+
+  private
+    def visit_board_and_wait_for_card
+      visit board_url(@board)
+      assert_selector "##{dom_id(@card, :article)}"
+      assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+      assert_selector "#closed-cards .cards__list", visible: :all
+      assert_selector "#not-now .cards__list", visible: :all
+    end
+
+    def drag_card(card, to:)
+      page.execute_script(<<~JS, dom_id(card, :article), to)
+        const item = document.getElementById(arguments[0])
+        const container = document.querySelector(arguments[1])
+        const dataTransfer = new DataTransfer()
+
+        item.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        container.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+        container.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+        item.dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true, dataTransfer }))
+      JS
+    end
+
+    def assert_card_persists(&condition)
+      Timeout.timeout(5) do
+        sleep 0.1 until condition.call
+      end
+    rescue Timeout::Error
+      flunk "card change did not persist"
+    end
+end
