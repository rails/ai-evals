diff --git a/app/models/storage/attachment.rb b/app/models/storage/attachment.rb
new file mode 100644
index 0000000..afbbd10
--- /dev/null
+++ b/app/models/storage/attachment.rb
@@ -0,0 +1,42 @@
+module Storage::Attachment
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit { recalculate_storage_later }
+    after_destroy_commit { recalculate_storage_later }
+  end
+
+  def delete
+    recalculate_storage_later
+    super
+  end
+
+  private
+    def recalculate_storage_later
+      if board = counted_storage_board
+        Storage::CalculationJob.perform_later(board)
+      end
+    end
+
+    def counted_storage_board
+      case record
+      when Card
+        record.board
+      when ActionText::RichText
+        storage_board_for_rich_text(record.record)
+      end
+    rescue ActiveRecord::RecordNotFound
+      nil
+    end
+
+    def storage_board_for_rich_text(owner)
+      case owner
+      when Board
+        owner
+      when Card
+        owner.board
+      when Comment
+        owner.card.board
+      end
+    end
+end
diff --git a/app/models/storage/calculator.rb b/app/models/storage/calculator.rb
new file mode 100644
index 0000000..f516dd5
--- /dev/null
+++ b/app/models/storage/calculator.rb
@@ -0,0 +1,83 @@
+class Storage::Calculator
+  COUNTED_RICH_TEXT_RECORD_TYPES = %w[ Board Card Comment ].freeze
+
+  def initialize(account: nil, board: nil)
+    @account = account
+    @board = board
+  end
+
+  def bytes_used
+    card_image_bytes + rich_text_embed_bytes
+  end
+
+  private
+    attr_reader :account, :board
+
+    def card_image_bytes
+      sum_bytes card_image_attachments
+    end
+
+    def rich_text_embed_bytes
+      if board
+        board_description_bytes + card_description_bytes + comment_bytes
+      else
+        sum_bytes embeds_for(account_rich_texts)
+      end
+    end
+
+    def board_description_bytes
+      sum_bytes embeds_for(board_description_rich_texts)
+    end
+
+    def card_description_bytes
+      sum_bytes embeds_for(card_description_rich_texts)
+    end
+
+    def comment_bytes
+      sum_bytes embeds_for(comment_rich_texts)
+    end
+
+    def sum_bytes(attachments)
+      ActiveStorage::Blob.where(id: attachments.select(:blob_id)).sum(:byte_size)
+    end
+
+    def card_image_attachments
+      if board
+        attachments.where(record_type: "Card", name: "image", record_id: board.cards.select(:id))
+      else
+        attachments.where(record_type: "Card", name: "image")
+      end
+    end
+
+    def embeds_for(rich_texts)
+      attachments.where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_texts.select(:id))
+    end
+
+    def account_rich_texts
+      ActionText::RichText.where(account_id: account.id, record_type: COUNTED_RICH_TEXT_RECORD_TYPES)
+    end
+
+    def board_description_rich_texts
+      ActionText::RichText.where(record_type: "Board", record_id: board.id)
+    end
+
+    def card_description_rich_texts
+      ActionText::RichText.where(record_type: "Card", record_id: board.cards.select(:id))
+    end
+
+    def comment_rich_texts
+      ActionText::RichText.where(record_type: "Comment", record_id: comments.select(:id))
+    end
+
+    def comments
+      Comment.where(card_id: board.cards.select(:id))
+    end
+
+    def attachments
+      ActiveStorage::Attachment.where(account_id: container_account.id)
+    end
+
+    def container_account
+      account || board.account
+    end
+end
