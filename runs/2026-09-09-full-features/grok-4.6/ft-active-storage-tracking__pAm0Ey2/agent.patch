@@ -0,0 +1,11 @@
+class Storage::CalculationJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  # One calculation at a time per board keeps concurrent uploads from writing
+  # stale totals, while still letting other boards calculate freely.
+  limits_concurrency to: 1, key: ->(board) { board }, duration: 5.minutes
+
+  def perform(board)
+    board.update_bytes_used
+  end
+end
