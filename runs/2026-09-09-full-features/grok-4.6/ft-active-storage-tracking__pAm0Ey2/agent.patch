+end
diff --git a/test/models/account/storage_test.rb b/test/models/account/storage_test.rb
new file mode 100644
index 0000000..92d6a2f
--- /dev/null
+++ b/test/models/account/storage_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+    @board = boards(:writebook)
+    @other_board = boards(:private)
+    @card = cards(:logo)
+  end
+
+  test "starts at zero" do
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "counts card images" do
+    size = attach_card_image(@card)
+
+    assert_equal size, @account.bytes_used
+  end
+
+  test "counts files embedded in card descriptions" do
+    size = attach_rich_text_embed(@card, :description)
+
+    assert_equal size, @account.bytes_used
+  end
+
+  test "counts files embedded in comments" do
+    comment = @card.comments.create!(body: "See attached")
+    size = attach_rich_text_embed(comment, :body)
+
+    assert_equal size, @account.bytes_used
+  end
+
+  test "counts files embedded in board descriptions" do
+    size = attach_rich_text_embed(@board, :public_description)
+
+    assert_equal size, @account.bytes_used
+  end
+
+  test "sums usage across all boards" do
+    image_size = attach_card_image(@card)
+    other_card = @other_board.cards.create!(title: "Other", creator: users(:david), status: :published)
+    other_size = attach_card_image(other_card)
+
+    assert_equal image_size + other_size, @account.bytes_used
+  end
+
+  test "does not count avatars" do
+    users(:david).avatar.attach(io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg")
+    perform_enqueued_jobs only: Storage::CalculationJob
+
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "does not count export files" do
+    export = @account.exports.create!(user: users(:david))
+    export.file.attach(io: StringIO.new("export"), filename: "export.zip", content_type: "application/zip")
+    perform_enqueued_jobs only: Storage::CalculationJob
+
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "does not count another account's attachments" do
+    attach_card_image(@card)
+    Current.account = accounts(:initech)
+
+    assert_equal 0, accounts(:initech).bytes_used
+  end
+
+  test "calculates usage in the background" do
+    assert_enqueued_with job: Storage::CalculationJob, args: [ @board ] do
+      @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    end
+  end
+
+  private
+    def attach_card_image(card)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      perform_enqueued_jobs only: Storage::CalculationJob
+      card.image.blob.byte_size
+    end
+
+    def attach_rich_text_embed(record, attribute)
+      blob = ActiveStorage::Blob.create_and_upload!(
+        io: file_fixture("moon.jpg").open,
+        filename: "embed.jpg",
+        content_type: "image/jpeg"
+      )
+      html = ActionText::Attachment.from_attachable(blob).to_html
+      record.update!(attribute => "<p>File: #{html}</p>")
+      perform_enqueued_jobs only: Storage::CalculationJob
+      blob.byte_size
+    end
+end
