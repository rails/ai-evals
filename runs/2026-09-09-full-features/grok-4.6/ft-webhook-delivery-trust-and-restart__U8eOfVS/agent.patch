@@ -29,4 +78,114 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def claim_for_delivery
+      with_lock do
+        return false unless pending?
+
+        in_progress!
+        true
+      end
+    end
+
+    def payload_body
+      if webhook.for_slack?
+        { text: chat_text }.to_json
+      elsif webhook.for_campfire?
+        { body: chat_text }.to_json
+      elsif webhook.for_basecamp?
+        { content: chat_text }.to_json
+      else
+        rendered_event_json
+      end
+    end
+
+    def chat_text
+      [ event.description_for(event.creator).to_plain_text, eventable_url ].compact.join(" ")
+    end
+
+    def eventable_url
+      Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **url_options)
+    end
+
+    def url_options
+      base_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+      base_options.merge(script_name: webhook.account.slug)
+    end
+
+    def rendered_event_json
+      ApplicationController.renderer.new(script_name: webhook.account.slug).render(
+        template: "webhooks/event",
+        formats: [ :json ],
+        assigns: { event: event }
+      )
+    end
+
+    def headers_for(body)
+      timestamp = Time.current.utc.iso8601(3)
+
+      {
+        "Content-Type" => "application/json",
+        "User-Agent" => USER_AGENT,
+        "X-Webhook-Timestamp" => timestamp,
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+      ip = destination_ip(uri.host)
+
+      if ip.present?
+        http = Net::HTTP.new(uri.host, uri.port)
+        http.ipaddr = ip
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = OPEN_TIMEOUT
+        http.read_timeout = READ_TIMEOUT
+
+        request = Net::HTTP::Post.new(uri.request_uri)
+        request.body = body
+        headers.each { |name, value| request[name] = value }
+
+        response = http.start { |connection| connection.request(request) }
+        { code: response.code.to_i }
+      else
+        { error: "destination_unreachable" }
+      end
+    rescue *NETWORK_ERRORS
+      { error: "destination_unreachable" }
+    end
+
+    def destination_ip(host)
+      if ip_address?(host)
+        host unless SsrfProtection.blocked_address?(host)
+      else
+        SsrfProtection.resolve_public_ip(host)
+      end
+    end
+
+    def ip_address?(host)
+      IPAddr.new(host)
+      true
+    rescue IPAddr::InvalidAddressError
+      false
+    end
+
+    def record_result
+      tracker = webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+
+      if succeeded?
+        tracker.record_success
+      else
+        tracker.record_failure
+      end
+    end
+
+    def fail_with_unreachable
+      update!(response: { error: "destination_unreachable" }, state: :errored)
+      record_result
+    end
 end
