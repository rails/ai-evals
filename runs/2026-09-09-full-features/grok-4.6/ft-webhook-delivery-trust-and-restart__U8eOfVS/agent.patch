@@ -0,0 +1,71 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    stub_dns_resolution("93.184.216.34")
+    @webhook = webhooks(:active)
+  end
+
+  test "creating an event enqueues a relay job" do
+    assert_enqueued_with(job: Event::RelayJob) do
+      create_event("card_published")
+    end
+  end
+
+  test "relay delivers to active webhooks subscribed to the action" do
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    event = create_event("card_closed")
+
+    assert_difference -> { @webhook.deliveries.count }, 1 do
+      perform_enqueued_jobs only: Event::RelayJob
+    end
+
+    delivery = @webhook.deliveries.where(event: event).last
+    assert delivery.succeeded?, "expected success, got state=#{delivery.state} response=#{delivery.response.inspect} request=#{delivery.request.inspect}"
+    assert_requested :post, @webhook.url, times: 1
+    assert_equal event, delivery.event
+  end
+
+  test "relay skips webhooks that are not subscribed to the action" do
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    event = create_event("comment_created")
+    perform_enqueued_jobs only: Event::RelayJob
+
+    assert_equal 0, @webhook.deliveries.where(event: event).count
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "relay skips inactive webhooks" do
+    @webhook.deactivate
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    event = create_event("card_published")
+    perform_enqueued_jobs only: Event::RelayJob
+
+    assert_equal 0, @webhook.deliveries.where(event: event).count
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "relay delivers exactly once even if the job runs twice" do
+    stub_request(:post, @webhook.url).to_return(status: 200)
+    event = create_event("card_published")
+
+    event.relay_now
+    event.relay_now
+
+    assert_equal 1, @webhook.deliveries.where(event: event).count
+    assert_requested :post, @webhook.url, times: 1
+  end
+
+  private
+    def create_event(action)
+      boards(:writebook).events.create!(
+        action: action,
+        creator: users(:david),
+        eventable: cards(:logo),
+        account: accounts("37s")
+      )
+    end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..6b5b969
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = Webhook.create!(name: "Tracker", url: "https://example.com/webhook", board: boards(:writebook))
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "created with a new webhook" do
+    assert @tracker.persisted?
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "record_success resets consecutive failures" do
+    @tracker.update!(consecutive_failures_count: 4, first_failure_at: 10.minutes.ago)
+
+    @tracker.record_success
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+  end
+
+  test "ten consecutive failures within an hour deactivate the webhook" do
+    freeze_time
+
+    9.times { @tracker.record_failure }
+    assert @webhook.reload.active?
+    assert_equal 9, @tracker.reload.consecutive_failures_count
+
+    @tracker.record_failure
+
+    assert_not @webhook.reload.active?
+    assert_equal 10, @tracker.reload.consecutive_failures_count
+  end
+
+  test "failures spread over more than an hour reset the window" do
+    freeze_time
+
+    9.times { @tracker.record_failure }
+    assert_equal 9, @tracker.reload.consecutive_failures_count
+
+    travel 61.minutes
+    @tracker.record_failure
+
+    assert @webhook.reload.active?
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+  end
+
+  test "a success in between failures resets the count" do
+    9.times { @tracker.record_failure }
+    @tracker.record_success
+    @tracker.record_failure
+
+    assert @webhook.reload.active?
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+  end
+end
