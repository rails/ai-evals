+    Errno::ECONNREFUSED,
+    Errno::ECONNRESET,
+    Errno::EHOSTUNREACH,
+    Errno::ENETUNREACH,
+    Errno::EADDRNOTAVAIL,
+    Errno::ETIMEDOUT,
