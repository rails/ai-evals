--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,36 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    subscription.update!(push_subscription_params)
+
+    head :created
+  end
+
+  def destroy
+    @user.push_subscriptions.destroy_by(endpoint: endpoint_param)
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.active.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: %i[ endpoint p256dh_key auth_key ])
+    end
+
+    def endpoint_param
+      params[:endpoint].presence || params.dig(:push_subscription, :endpoint)
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..cae4e7c
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,102 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details" ]
+  static values = { subscriptionsUrl: String, vapidPublicKey: String }
+
+  async connect() {
+    await this.#sync()
+  }
+
+  async toggle() {
+    try {
+      if (await this.#subscription()) {
+        await this.#disable()
+      } else {
+        await this.#enable()
+      }
+    } finally {
+      await this.#sync()
+    }
+  }
+
+  async #sync() {
+    this.element.classList.toggle("notifications--on", await this.#subscription() != null)
+    this.#toggleHelp()
+  }
+
+  #toggleHelp() {
+    const blocked = !this.#supported || Notification.permission === "denied"
+    this.detailsTargets.forEach(details => details.toggleAttribute("hidden", !blocked))
+  }
+
+  async #enable() {
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") return
+
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey
+    })
+
+    await this.#save(subscription)
+  }
+
+  async #disable() {
+    const subscription = await this.#subscription()
+    if (!subscription) return
+
+    await this.#remove(subscription)
+    await subscription.unsubscribe()
+  }
+
+  async #save(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    await post(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint,
+          p256dh_key: keys.p256dh,
+          auth_key: keys.auth
+        }
+      },
+      responseKind: "json"
+    })
+  }
+
+  async #remove(subscription) {
+    await destroy(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: { endpoint: subscription.endpoint }
+      },
+      responseKind: "json"
+    })
+  }
+
+  async #subscription() {
+    if (!this.#supported) return null
+
+    const registration = await navigator.serviceWorker.ready
+    return registration.pushManager.getSubscription()
+  }
+
+  get #supported() {
+    return "Notification" in window && "serviceWorker" in navigator && "PushManager" in window
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.vapidPublicKeyValue.length % 4) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    const output = new Uint8Array(rawData.length)
+
+    for (let i = 0; i < rawData.length; ++i) {
+      output[i] = rawData.charCodeAt(i)
+    }
+
+    return output
+  }
+}
