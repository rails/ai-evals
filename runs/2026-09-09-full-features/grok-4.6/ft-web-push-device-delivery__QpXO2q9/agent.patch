diff --git a/app/models/push.rb b/app/models/push.rb
new file mode 100644
index 0000000..df8ab6e
--- /dev/null
+++ b/app/models/push.rb
@@ -0,0 +1,38 @@
+module Push
+  class << self
+    def table_name_prefix
+      "push_"
+    end
+
+    def enabled?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"].presence
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"].presence
+    end
+
+    def vapid_options
+      {
+        subject: vapid_subject,
+        public_key: vapid_public_key,
+        private_key: vapid_private_key
+      }
+    end
+
+    private
+      def vapid_subject
+        if url = ENV["BASE_URL"].presence
+          url
+        else
+          from = ENV.fetch("MAILER_FROM_ADDRESS", "support@fizzy.do")
+          email = from[/<([^>]+)>/, 1] || from
+          "mailto:#{email}"
+        end
+      end
+  end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..de21ab4
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,18 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+  def deliver(notification)
+    WebPush.payload_send(
+      message: notification.push_payload.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: Push.vapid_options
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized
+    destroy
+  end
+end
