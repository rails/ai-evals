diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..0a8f65b
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/abc", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create updates an existing subscription for the same endpoint" do
+    subscription = @user.push_subscriptions.create!(subscription_params)
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: subscription_params.merge(p256dh_key: "new-p256dh", auth_key: "new-auth")
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "new-p256dh", subscription.reload.p256dh_key
+    assert_equal "new-auth", subscription.auth_key
+  end
+
+  test "create for another user is forbidden" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: subscription_params }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy" do
+    @user.push_subscriptions.create!(subscription_params)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: subscription_params[:endpoint] } }, as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy for another user is forbidden" do
+    users(:kevin).push_subscriptions.create!(subscription_params)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      delete user_push_subscriptions_path(users(:kevin)), params: { push_subscription: { endpoint: subscription_params[:endpoint] } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  private
+    def subscription_params
+      {
+        endpoint: "https://push.example.com/abc",
+        p256dh_key: "p256dh-key",
+        auth_key: "auth-key"
+      }
+    end
+end
diff --git a/test/models/notification/push_test.rb b/test/models/notification/push_test.rb
new file mode 100644
index 0000000..c3a9fb4
--- /dev/null
+++ b/test/models/notification/push_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Notification::PushTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/abc",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  test "creating a notification enqueues a push" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_with job: Notification::PushJob do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "updating a notification source enqueues a push" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_enqueued_with job: Notification::PushJob do
+      notification.update!(source: events(:logo_published), read_at: nil)
+    end
+  end
+
+  test "reading a notification does not enqueue a push" do
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notifications(:logo_assignment_kevin).read
+    end
+  end
+
+  test "push_now delivers to every subscription" do
+    Push::Subscription.any_instance.expects(:deliver).once
+
+    notifications(:logo_assignment_kevin).push_now
+  end
+
+  test "title and body match the tray for events" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_equal "The logo isn't big enough", notification.title
+    assert_equal "Assigned to Kevin", notification.body
+  end
+
+  test "title and body match the tray for mentions" do
+    notification = notifications(:logo_mentioned_david)
+
+    assert_equal "JZ @mentioned you", notification.title
+    assert_equal notification.source.source.mentionable_content.truncate(200), notification.body
+  end
+
+  test "comment notifications use a RE title" do
+    notification = notifications(:layout_commented_kevin)
+
+    assert_equal "RE: Layout is broken", notification.title
+  end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..5c894b8
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/abc",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  test "deliver sends the tray title, body, and card path" do
+    WebPush.expects(:payload_send).with do |kwargs|
+      message = JSON.parse(kwargs[:message])
+
+      kwargs[:endpoint] == @subscription.endpoint &&
+        kwargs[:p256dh] == @subscription.p256dh_key &&
+        kwargs[:auth] == @subscription.auth_key &&
+        kwargs[:vapid][:public_key] == ENV["VAPID_PUBLIC_KEY"] &&
+        kwargs[:vapid][:private_key] == ENV["VAPID_PRIVATE_KEY"] &&
+        message["title"] == @notification.title &&
+        message["body"] == @notification.body &&
+        message["path"] == "#{@user.account.slug}/cards/#{@notification.card.to_param}"
+    end
+
+    @subscription.deliver(@notification)
+  end
+
+  test "deliver destroys expired subscriptions" do
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(stub(body: ""), "push.example.com"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver(@notification)
+    end
+  end
+end
