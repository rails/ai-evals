+    end
+
+    def remap_uuids(attrs, id_map)
+      uuid_column_names.each do |column|
+        next if skip_remap_columns.include?(column)
+        next unless attrs.key?(column)
+
+        if attrs[column].present?
+          attrs[column] = id_map.lookup(attrs[column])
+        end
+      end
+    end
+
+    def uuid_column_names
+      @uuid_column_names ||= model.columns.select { |column| column.type == :uuid }.map(&:name)
+    end
+
+    def skip_remap_columns
+      []
+    end
+
+    def regenerate_unique_tokens(attrs)
+      if model == ::Board::Publication
