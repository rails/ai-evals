+
+    def write_records
+      each_record do |record|
+        zip.add_file(record_path(record), record_payload(record).to_json)
+      end
+    end
+
+    def each_record(&block)
+      if records.respond_to?(:find_each)
+        records.find_each(&block)
+      else
+        Array(records).each(&block)
+      end
+    end
+
+    def record_path(record)
+      "#{model_dir}/#{record.id}.json"
+    end
+
+    def record_payload(record)
+      record.attributes.slice(*attributes)
