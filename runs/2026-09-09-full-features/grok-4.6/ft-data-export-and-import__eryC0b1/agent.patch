diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..3429659
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,40 @@
+class ZipFile::Reader
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io)
+  end
+
+  def glob(pattern)
+    filenames.select { |filename| File.fnmatch(pattern, filename) }.sort
+  end
+
+  def exists?(path)
+    find_entry(path).present?
+  end
+
+  def read(path)
+    buffer = +""
+    extract(path) { |chunk| buffer << chunk }
+    buffer
+  end
+
+  def extract(path)
+    entry = find_entry(path)
+    raise ArgumentError, "No zip entry #{path}" unless entry
+
+    extractor = entry.extractor_from(@io)
+    until extractor.eof?
+      chunk = extractor.extract(64.kilobytes)
+      yield chunk if chunk.present?
+    end
+  end
+
+  private
+    def filenames
+      @filenames ||= @entries.map(&:filename)
+    end
+
+    def find_entry(path)
+      @entries.find { |entry| entry.filename == path }
+    end
+end
