+
+    def portable_body(record)
+      html = record.body&.to_html.presence || record[:body]
+      return html if html.blank?
+
+      fragment = Nokogiri::HTML.fragment(html.to_s)
+      fragment.css("action-text-attachment").each do |node|
+        if (attachable = attachable_from(node["sgid"])) && attachable.respond_to?(:id)
+          node["sgid"] = "#{BLOB_SGID_PREFIX}#{attachable.id}"
+        end
+      end
+      fragment.to_html
+    end
+
+    def restore_body(html, id_map)
+      return html if html.blank?
+
+      fragment = Nokogiri::HTML.fragment(html.to_s)
+      fragment.css("action-text-attachment").each do |node|
+        old_id = node["sgid"].to_s.delete_prefix(BLOB_SGID_PREFIX)
+        next if old_id.blank?
+
+        if (blob = ::ActiveStorage::Blob.find_by(id: id_map.lookup(old_id)))
+          node["sgid"] = blob.attachable_sgid
+          node["url"] = Rails.application.routes.url_helpers.rails_blob_path(
+            blob, only_path: true, script_name: account.slug
+          )
+        end
+      end
+      fragment.to_html
+    end
+
+    def attachable_from(sgid)
+      ActionText::Attachable.from_attachable_sgid(sgid) if sgid.present?
+    rescue ActiveRecord::RecordNotFound, ActiveSupport::MessageVerifier::InvalidSignature
+      nil
+    end
 end
