index 0000000..7913780
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,34 @@
+class Account::DataTransfer::Importer
+  class InvalidFile < StandardError; end
+
+  def initialize(account)
+    @account = account
+  end
+
+  def read_from(zip)
+    validate!(zip)
+
+    id_map = Account::DataTransfer::IdMap.new
+    Current.with_account(account) do
+      Account::DataTransfer::Manifest.new(account).each_record_set do |record_set|
+        record_set.import_from(zip, id_map: id_map)
+      end
+    end
+  end
+
+  private
+    attr_reader :account
+
+    def validate!(zip)
+      unless zip.exists?("export.json")
+        raise InvalidFile, "This file is not a Fizzy account export."
+      end
+
+      metadata = JSON.parse(zip.read("export.json"))
+      unless metadata["format"] == Account::DataTransfer::Manifest::FORMAT
+        raise InvalidFile, "This file is not a Fizzy account export."
+      end
+    rescue JSON::ParserError
+      raise InvalidFile, "This file is not a Fizzy account export."
+    end
+end
