diff --git a/app/models/account/data_transfer/filter_record_set.rb b/app/models/account/data_transfer/filter_record_set.rb
new file mode 100644
index 0000000..5b963f5
--- /dev/null
+++ b/app/models/account/data_transfer/filter_record_set.rb
@@ -0,0 +1,59 @@
+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  ASSOCIATION_KEYS = {
+    "tag_ids" => :tag_ids,
+    "board_ids" => :board_ids,
+    "assignee_ids" => :assignee_ids,
+    "filter_creator_ids" => :creator_ids,
+    "closer_ids" => :closer_ids
+  }.freeze
+
+  def initialize(account)
+    super(account: account, model: Filter)
+  end
+
+  private
+    def record_payload(record)
+      super.merge(
+        "tag_ids" => record.tag_ids,
+        "board_ids" => record.board_ids,
+        "assignee_ids" => record.assignee_ids,
+        "filter_creator_ids" => record.creator_ids,
+        "closer_ids" => record.closer_ids
+      )
+    end
+
+    def read_records(id_map)
+      zip.glob("#{model_dir}/*.json").each do |path|
+        raw = JSON.parse(zip.read(path))
+        association_ids = ASSOCIATION_KEYS.keys.index_with { |key| Array(raw.delete(key)) }
+        attrs = import_payload(raw, id_map)
+        remap_filter_fields(attrs, id_map)
+        model.insert_all([ attrs ], record_timestamps: false)
+
+        assign_associations(attrs["id"], association_ids, id_map)
+      end
+    end
+
+    def remap_filter_fields(attrs, id_map)
+      fields = attrs["fields"]
+      fields = JSON.parse(fields) if fields.is_a?(String)
+      return unless fields.is_a?(Hash)
+
+      %w[ card_ids column_ids ].each do |key|
+        if fields[key].present?
+          fields[key] = Array(fields[key]).map { |id| id_map.lookup(id) }
+        end
+      end
+
+      attrs["fields"] = fields
+    end
+
+    def assign_associations(filter_id, association_ids, id_map)
+      filter = model.find(filter_id)
+
+      ASSOCIATION_KEYS.each do |key, setter|
+        ids = association_ids[key].map { |id| id_map.lookup(id) }
+        filter.public_send("#{setter}=", ids) if ids.any?
+      end
+    end
+end
