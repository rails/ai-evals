+class Account::DataTransfer::IdMap
+  def initialize
+    @ids = {}
+    @keys = {}
+  end
+
+  def remember(old_id, new_id)
+    @ids[old_id.to_s] = new_id
+  end
+
+  def lookup(old_id)
+    if old_id.present?
+      @ids[old_id.to_s] ||= ActiveRecord::Type::Uuid.generate
+    end
+  end
+
+  def remember_key(old_key, new_key)
+    @keys[old_key] = new_key
+  end
+
+  def lookup_key(old_key)
+    @keys[old_key]
+  end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
