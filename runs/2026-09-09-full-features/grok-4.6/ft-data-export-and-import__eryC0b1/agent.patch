diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..1cb0494
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,85 @@
+class Account::Import < ApplicationRecord
+  include DataTransferStatus
+
+  belongs_to :account
+  belongs_to :user
+  belongs_to :identity
+  belongs_to :imported_account, class_name: "Account", optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  validate :file_must_be_attached, on: :create
+
+  after_create_commit :process_later
+
+  def process_later
+    Account::ImportJob.perform_later(self)
+  end
+
+  def process_now
+    imported = create_imported_account
+
+    begin
+      ZipFile.open(file) do |zip|
+        Account::DataTransfer::Importer.new(imported).read_from(zip)
+      end
+
+      assign_requester(imported)
+      reindex(imported)
+      imported.reconcile_storage
+
+      update!(imported_account: imported, status: :completed)
+      AccountMailer.import_completed(self).deliver_later
+    rescue => error
+      wipe(imported)
+      update!(status: :failed, error_message: error.message, imported_account: nil)
+      AccountMailer.import_failed(self).deliver_later
+      Rails.error.report(error)
+    end
+  end
+
+  private
+    def file_must_be_attached
+      errors.add(:file, "can't be blank") unless file.attached?
+    end
+
+    def create_imported_account
+      Account.create!(name: "Imported account")
+    end
+
+    def assign_requester(imported)
+      requester = imported.users.find_by(identity: identity)
+
+      if requester
+        requester.update!(role: :owner, active: true, verified_at: requester.verified_at || Time.current)
+      else
+        requester = imported.users.create!(
+          name: user.name,
+          identity: identity,
+          role: :owner,
+          verified_at: Time.current
+        )
+      end
+
+      imported.boards.find_each do |board|
+        board.accesses.grant_to([ requester ]) unless board.accessible_to?(requester)
+      end
+    end
+
+    def reindex(imported)
+      Current.with_account(imported) do
+        imported.cards.published.find_each(&:reindex)
+        Comment.where(account: imported).find_each { |comment| comment.reindex if comment.searchable? }
+      end
+    end
+
+    def wipe(imported)
+      return unless imported
+
+      Storage::Entry.suppressing_recording do
+        Account::DataTransfer::Manifest.new(imported).wipe
+        imported.reload.destroy
+      end
+    rescue ActiveRecord::RecordNotFound
+    end
+end
