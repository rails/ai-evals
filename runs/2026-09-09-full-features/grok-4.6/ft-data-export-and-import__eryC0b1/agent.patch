+require "test_helper"
+
+class User::ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+  end
+
+  test "process_now emails a download link" do
+    export = @user.exports.create!(account: @user.account, user: @user)
+
+    assert_enqueued_emails 1 do
+      export.process_now
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+  end
+
+  test "zip includes accessible cards as JSON with comments and files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = @user.exports.create!(account: @user.account, user: @user)
+    export.process_now
+
+    ZipFile.open(export.file) do |zip|
+      path = "cards/#{card.number}.json"
+      assert zip.exists?(path)
+
+      payload = JSON.parse(zip.read(path))
+      assert_equal card.title, payload["title"]
+      assert payload["comments"].any?
+      assert_includes payload["files"], "moon.jpg"
+      assert zip.exists?("cards/#{card.number}/moon.jpg")
+    end
+  end
+end
