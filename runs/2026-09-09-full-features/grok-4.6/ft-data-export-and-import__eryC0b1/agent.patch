+
+    def read_records(id_map)
+      paths = zip.glob("#{model_dir}/*.json")
+      paths.each_slice(500) do |batch|
+        rows = batch.map { |path| import_payload(JSON.parse(zip.read(path)), id_map) }
+        model.insert_all(rows, record_timestamps: false) if rows.any?
+      end
+    end
+
+    def import_payload(attrs, id_map)
+      attrs = attrs.slice(*attributes)
+      remap_uuids(attrs, id_map)
+      regenerate_unique_tokens(attrs)
