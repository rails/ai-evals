diff --git a/app/models/user/export.rb b/app/models/user/export.rb
new file mode 100644
index 0000000..d937e53
--- /dev/null
+++ b/app/models/user/export.rb
@@ -0,0 +1,119 @@
+class User::Export < ApplicationRecord
+  include DataTransferStatus
+
+  DOWNLOAD_EXPIRY = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file, dependent: :purge_later
+
+  after_create_commit :process_later
+
+  scope :expired, -> { where(created_at: ...DOWNLOAD_EXPIRY.ago) }
+
+  class << self
+    def cleanup
+      expired.find_each(&:destroy)
+    end
+  end
+
+  def process_later
+    User::ExportJob.perform_later(self)
+  end
+
+  def process_now
+    ZipFile.create_for(file, filename: filename) do |zip|
+      write_cards(zip)
+    end
+
+    completed!
+    AccountMailer.cards_export_completed(self).deliver_later
+  rescue => error
+    failed!
+    update!(error_message: error.message)
+    AccountMailer.cards_export_failed(self).deliver_later
+    Rails.error.report(error)
+  end
+
+  def download_sgid
+    to_sgid(expires_in: DOWNLOAD_EXPIRY, for: :download)
+  end
+
+  private
+    def filename
+      "fizzy-cards-#{user.name.parameterize}-#{created_at.to_date}.zip"
+    end
+
+    def write_cards(zip)
+      zip.add_file("export.json", { "format" => "fizzy.cards", "version" => 1 }.to_json)
+
+      cards.find_each do |card|
+        files = write_card_files(zip, card)
+        zip.add_file("cards/#{card.number}.json", JSON.pretty_generate(card_payload(card, files)))
+      end
+    end
+
+    def cards
+      user.accessible_cards.preloaded
+    end
+
+    def card_payload(card, files)
+      {
+        "number" => card.number,
+        "title" => card.title,
+        "status" => card.status,
+        "description" => card.description.to_plain_text,
+        "board" => card.board.name,
+        "column" => card.column&.name,
+        "creator" => card.creator.name,
+        "assignees" => card.assignees.map(&:name),
+        "tags" => card.tags.map(&:title),
+        "created_at" => card.created_at.utc.iso8601,
+        "last_active_at" => card.last_active_at.utc.iso8601,
+        "files" => files,
+        "comments" => card.comments.preloaded.chronologically.map { |comment| comment_payload(comment) }
+      }
+    end
+
+    def comment_payload(comment)
+      {
+        "creator" => comment.creator.name,
+        "body" => comment.body.to_plain_text,
+        "created_at" => comment.created_at.utc.iso8601
+      }
+    end
+
+    def write_card_files(zip, card)
+      names = []
+
+      if card.image.attached?
+        names << write_blob(zip, card, card.image.blob)
+      end
+
+      card.attachments.each do |attachment|
+        names << write_blob(zip, card, attachment.blob)
+      end
+
+      card.comments.preloaded.each do |comment|
+        comment.attachments.each do |attachment|
+          names << write_blob(zip, card, attachment.blob)
+        end
+      end
+
+      names.compact
+    end
+
+    def write_blob(zip, card, blob)
+      name = blob.filename.to_s
+      path = "cards/#{card.number}/#{name}"
+
+      zip.add_file(path, compress: false) do |sink|
+        blob.download { |chunk| sink.write(chunk) }
+      end
+
+      name
+    rescue ActiveStorage::FileNotFoundError
+      nil
+    end
+end
