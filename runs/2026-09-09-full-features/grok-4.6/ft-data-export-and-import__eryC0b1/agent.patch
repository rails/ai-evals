diff --git a/test/models/account/export_test.rb b/test/models/account/export_test.rb
new file mode 100644
index 0000000..c32d8cd
--- /dev/null
+++ b/test/models/account/export_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+  end
+
+  test "process_now attaches a zip and emails a download link" do
+    export = @account.exports.create!(user: @user)
+
+    assert_enqueued_emails 1 do
+      export.process_now
+    end
+
+    assert export.completed?
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+  end
+
+  test "zip includes cards, comments, and attached files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = @account.exports.create!(user: @user)
+    export.process_now
+
+    ZipFile.open(export.file) do |zip|
+      assert zip.exists?("export.json")
+      metadata = JSON.parse(zip.read("export.json"))
+      assert_equal "fizzy.account", metadata["format"]
+
+      assert zip.exists?("cards/#{card.id}.json")
+      assert zip.exists?("comments/#{comments(:logo_agreement_jz).id}.json")
+      assert zip.glob("files/*").any?
+    end
+  end
+end
diff --git a/test/models/account/import_test.rb b/test/models/account/import_test.rb
new file mode 100644
index 0000000..fd27f93
--- /dev/null
+++ b/test/models/account/import_test.rb
@@ -0,0 +1,54 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+  end
+
+  test "process_now creates a new account with boards, cards, comments, files, and people" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = @account.exports.create!(user: @user)
+    export.process_now
+
+    import = @account.imports.new(user: @user, identity: @user.identity)
+    import.file.attach(export.file.blob)
+    import.save!
+
+    assert_enqueued_emails 1 do
+      import.process_now
+    end
+
+    import.reload
+    assert import.completed?
+    imported = import.imported_account
+    assert_not_equal @account.id, imported.id
+    assert_equal @account.name, imported.name
+    assert imported.cards.find_by(title: card.title)
+    assert imported.users.find_by(identity: @user.identity)
+    assert imported.users.find_by(name: "David")
+    assert imported.cards.find_by(title: card.title).image.attached?
+    assert imported.cards.find_by(title: card.title).comments.any?
+  end
+
+  test "failed import leaves nothing behind" do
+    import = @account.imports.new(user: @user, identity: @user.identity)
+    import.file.attach(io: StringIO.new("not a zip"), filename: "broken.zip", content_type: "application/zip")
+    import.save!
+
+    account_ids = Account.pluck(:id)
+
+    assert_enqueued_emails 1 do
+      import.process_now
+    end
+
+    import.reload
+    assert import.failed?
+    assert_nil import.imported_account
+    assert_equal account_ids.sort, Account.pluck(:id).sort
+  end
+end
