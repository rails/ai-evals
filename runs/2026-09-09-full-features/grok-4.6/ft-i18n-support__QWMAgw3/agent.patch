new file mode 100644
index 0000000..47d55cc
--- /dev/null
+++ b/config/initializers/i18n.rb
@@ -0,0 +1,18 @@
+# Sentence-style keys (the English copy itself) contain spaces and
+# punctuation, including "." which I18n otherwise treats as nesting.
+# Use a different separator for those keys and fall back to the key so
+# English pages never show "translation missing".
+module I18nSentenceKeys
+  SENTENCE_KEY = /[\s?!:;…,]/
+
+  def translate(key = nil, **options)
+    if key.is_a?(String) && key.match?(SENTENCE_KEY)
+      options[:separator] ||= "\001"
+      options[:default] ||= key
+    end
+    super(key, **options)
+  end
+end
+
+I18n.singleton_class.prepend I18nSentenceKeys
+I18n.singleton_class.alias_method :t, :translate
