diff --git a/app/javascript/helpers/i18n.js b/app/javascript/helpers/i18n.js
new file mode 100644
index 0000000..d60eac9
--- /dev/null
+++ b/app/javascript/helpers/i18n.js
@@ -0,0 +1,26 @@
+export function locale() {
+  return document.documentElement.lang || document.querySelector('meta[name="locale"]')?.content || "en"
+}
+
+export function dateLocale() {
+  return locale() === "ja" ? "ja" : "en-US"
+}
+
+export function t(key, vars = {}) {
+  const translations = translationsFromPage()
+  let text = translations[key] ?? key
+  Object.entries(vars).forEach(([ name, value ]) => {
+    text = text.replaceAll(`%{${name}}`, value)
+  })
+  return text
+}
+
+function translationsFromPage() {
+  const el = document.getElementById("fizzy-i18n")
+  if (!el) return {}
+  try {
+    return JSON.parse(el.textContent)
+  } catch {
+    return {}
+  }
+}
