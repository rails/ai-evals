diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..4d56972
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,43 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :set_locale
+
+    etag { I18n.locale }
+  end
+
+  private
+    def set_locale
+      apply_requested_locale
+      I18n.with_locale(active_locale) do
+        yield
+        persist_locale_to_identity
+      end
+    end
+
+    def apply_requested_locale
+      if locale = requested_locale
+        session[:locale] = locale
+      end
+    end
+
+    def requested_locale
+      available_locale(params[:locale])
+    end
+
+    def active_locale
+      available_locale(session[:locale]) || I18n.default_locale
+    end
+
+    def persist_locale_to_identity
+      if Current.identity && (locale = available_locale(session[:locale])) && Current.identity.locale != locale
+        Current.identity.update!(locale: locale)
+      end
+    end
+
+    def available_locale(value)
+      locale = value.to_s.downcase.presence
+      locale if locale && I18n.available_locales.map(&:to_s).include?(locale)
+    end
+end
