diff --git a/test/integration/locale_test.rb b/test/integration/locale_test.rb
new file mode 100644
index 0000000..17a98a2
--- /dev/null
+++ b/test/integration/locale_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "default pages stay in English" do
+    untenanted do
+      get new_session_path
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_match "Get into Fizzy", response.body
+      assert_no_match "Fizzyに入る", response.body
+    end
+  end
+
+  test "locale=ja switches the page to Japanese" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_match "Fizzyに入る", response.body
+      assert_no_match "Get into Fizzy", response.body
+    end
+  end
+
+  test "locale choice persists for the rest of the session" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      assert_match "Fizzyに入る", response.body
+
+      get new_session_path
+      assert_select "html[lang=ja]"
+      assert_match "Fizzyに入る", response.body
+    end
+  end
+
+  test "unknown locale does not switch or break the page" do
+    untenanted do
+      get new_session_path, params: { locale: "xx" }
+      assert_response :success
+      assert_select "html[lang=en]"
+      assert_match "Get into Fizzy", response.body
+    end
+  end
+
+  test "locale persists on the identity across a clean sign in" do
+    identity = identities(:kevin)
+
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+    end
+
+    sign_in_as identity
+    identity.reload
+    assert_equal "ja", identity.locale
+
+    sign_out
+    cookies.delete :session_token
+    reset!
+
+    integration_session.default_url_options[:script_name] = "/#{ActiveRecord::FixtureSet.identify("37signals")}"
+
+    sign_in_as identity
+
+    get session_menu_path
+    follow_redirect! while response.redirect?
+    assert_select "html[lang=ja]"
+  end
+
+  test "Japanese emails use the recipient locale" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+    magic_link = MagicLink.create!(identity: identity)
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+    assert_match "Fizzyのコードは", email.subject
+    assert_match "確認コード", email.html_part.decoded
+    assert_no_match "Your Fizzy code is", email.subject
+  end
+
+  test "English emails stay English when locale was never chosen" do
+    identity = identities(:kevin)
+    magic_link = MagicLink.create!(identity: identity)
+
+    email = MagicLinkMailer.sign_in_instructions(magic_link)
+    assert_equal "Your Fizzy code is #{magic_link.code}", email.subject
+  end
+end
