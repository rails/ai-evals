@@ -0,0 +1,16 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    set_page_and_extract_portion_from cards
+  end
+
+  private
+    def cards
+      Current.user.accessible_cards
+        .published
+        .matching(@query)
+        .reverse_chronologically
+        .preloaded
+        .preload(comments: :rich_text_body)
+    end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..ebe6b33
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,21 @@
+module SearchesHelper
+  def search_snippets_for(card, query)
+    snippets = []
+
+    if (description = card.description&.to_plain_text.presence) && search_text_match?(description, query)
+      snippets << description
+    end
+
+    card.comments.each do |comment|
+      if (body = comment.body&.to_plain_text.presence) && search_text_match?(body, query)
+        snippets << body
+      end
+    end
+
+    snippets
+  end
+
+  def search_text_match?(text, query)
+    text.to_s.downcase.include?(query.to_s.downcase)
+  end
+end
