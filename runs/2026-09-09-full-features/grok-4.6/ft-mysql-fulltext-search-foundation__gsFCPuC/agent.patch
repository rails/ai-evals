diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..34473fe
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,28 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :matching, ->(term) {
+      term = term.to_s.strip
+      if term.present?
+        pattern = "%#{sanitize_sql_like(term)}%"
+
+        matching_descriptions = ActionText::RichText
+          .where(record_type: "Card", name: "description")
+          .where("action_text_rich_texts.record_id = cards.id")
+          .where("action_text_rich_texts.body LIKE ?", pattern)
+          .select("1")
+
+        matching_comments = Comment
+          .joins(:rich_text_body)
+          .where("comments.card_id = cards.id")
+          .where("action_text_rich_texts.body LIKE ?", pattern)
+          .select("1")
+
+        where("cards.title LIKE ? OR EXISTS (#{matching_descriptions.to_sql}) OR EXISTS (#{matching_comments.to_sql})", pattern)
+      else
+        none
+      end
+    }
+  end
+end
