diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..bf42e8f
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show" do
+    get search_path
+    assert_response :success
+  end
+
+  test "finds cards by title, newest first, and wraps matches in mark" do
+    older, newer = with_current_user(:kevin) do
+      [
+        boards(:writebook).cards.create!(title: "unique-title-search older", status: :published, creator: users(:kevin), created_at: 2.days.ago),
+        boards(:writebook).cards.create!(title: "unique-title-search newer", status: :published, creator: users(:kevin), created_at: 1.hour.ago)
+      ]
+    end
+
+    get search_path(q: "unique-title-search")
+    assert_response :success
+
+    titles = css_select(".search-result__title").map { |element| element.text.strip }
+    assert_equal [ newer.title, older.title ], titles
+    assert_select "mark", text: "unique-title-search", count: 2
+  end
+
+  test "finds cards by description and wraps matches in mark" do
+    cards(:layout).update!(description: "A unique-description-search lives here")
+
+    get search_path(q: "unique-description-search")
+    assert_response :success
+
+    assert_select ".search-result", count: 1
+    assert_select ".search-result__title", text: cards(:layout).title
+    assert_select "mark", text: "unique-description-search"
+  end
+
+  test "finds cards by comment body and wraps matches in mark" do
+    with_current_user(:kevin) do
+      cards(:logo).comments.create!(body: "Let's talk unique-comment-search", creator: users(:kevin))
+    end
+
+    get search_path(q: "unique-comment-search")
+    assert_response :success
+
+    assert_select ".search-result", count: 1
+    assert_select ".search-result__title", text: cards(:logo).title
+    assert_select "mark", text: "unique-comment-search"
+  end
+
+  test "does not return cards from boards the user cannot access" do
+    with_current_user(:kevin) do
+      boards(:private).cards.create!(title: "secret-private-search", status: :published, creator: users(:kevin))
+    end
+
+    logout_and_sign_in_as :david
+
+    get search_path(q: "secret-private-search")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "does not return draft cards" do
+    boards(:writebook).cards.create!(title: "draft-only-search", status: :drafted, creator: users(:kevin))
+
+    get search_path(q: "draft-only-search")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+
+  test "does not return comments on draft cards" do
+    draft = boards(:writebook).cards.create!(title: "A published looking title", status: :drafted, creator: users(:kevin))
+    comment = Comment.new(card: draft, creator: users(:kevin), account: draft.account)
+    comment.save!(validate: false)
+    comment.create_rich_text_body!(body: "draft-comment-search", account: draft.account)
+
+    get search_path(q: "draft-comment-search")
+    assert_response :success
+    assert_select ".search-result", count: 0
+  end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..e0c5bea
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,50 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "matching finds cards by title" do
+    assert_includes Card.matching("logo"), cards(:logo)
+    assert_not_includes Card.matching("logo"), cards(:layout)
+  end
+
+  test "matching finds cards by description" do
+    cards(:layout).update!(description: "A unique widget description")
+
+    assert_includes Card.matching("widget"), cards(:layout)
+    assert_not_includes Card.matching("widget"), cards(:logo)
+  end
+
+  test "matching finds cards by comment body" do
+    cards(:logo).comments.create!(body: "I love haggis", creator: users(:kevin))
+
+    assert_includes Card.matching("haggis"), cards(:logo)
+    assert_not_includes Card.matching("haggis"), cards(:layout)
+  end
+
+  test "matching is newest first when combined with reverse_chronologically" do
+    older = boards(:writebook).cards.create!(title: "chronosearch older", status: :published, creator: users(:kevin), created_at: 2.days.ago)
+    newer = boards(:writebook).cards.create!(title: "chronosearch newer", status: :published, creator: users(:kevin), created_at: 1.hour.ago)
+
+    assert_equal [ newer, older ], Card.matching("chronosearch").reverse_chronologically
+  end
+
+  test "matching ignores blank terms" do
+    assert_empty Card.matching("")
+    assert_empty Card.matching("   ")
+    assert_empty Card.matching(nil)
+  end
+
+  test "published matching never includes draft cards" do
+    draft = boards(:writebook).cards.create!(title: "draftosaurus", status: :drafted, creator: users(:kevin))
+
+    assert_includes Card.matching("draftosaurus"), draft
+    assert_not_includes Card.published.matching("draftosaurus"), draft
+  end
+
+  test "matching is case insensitive" do
+    assert_includes Card.matching("LOGO"), cards(:logo)
+  end
+end
