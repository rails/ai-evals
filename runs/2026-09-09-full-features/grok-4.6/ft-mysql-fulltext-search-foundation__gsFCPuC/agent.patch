+<article class="search-result panel shadow txt-align-start center">
+  <%= link_to card, class: "search-result__link flex flex-column gap-half txt-undecorated" do %>
+    <div class="txt-x-small txt-subtle">
+      <%= card.board.name %> · #<%= card.number %>
+    </div>
+
+    <h2 class="search-result__title txt-medium txt-tight-lines">
+      <%= highlight(card.title, query) %>
+    </h2>
+
+    <% search_snippets_for(card, query).each do |snippet| %>
+      <p class="search-result__snippet txt-small txt-subtle">
+        <%= highlight(format_excerpt(snippet), query) %>
+      </p>
+    <% end %>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..c911688
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,33 @@
+<% @page_title = @query.present? ? "Search: #{@query}" : "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<div class="search center">
+  <%= form_with url: search_path, method: :get, class: "search__form margin-block" do %>
+    <%= search_field_tag :q, @query,
+          class: "input",
+          placeholder: "Search cards…",
+          autofocus: true,
+          autocomplete: "off",
+          autocorrect: "off",
+          aria: { label: "Search" } %>
+  <% end %>
+
+  <% if @query.present? %>
+    <section class="search__results flex flex-column gap">
+      <% if @page.records.any? %>
+        <%= with_automatic_pagination :search_paginated_container, @page do %>
+          <%= render partial: "searches/card", collection: @page.records, as: :card, locals: { query: @query } %>
+        <% end %>
+      <% else %>
+        <div class="blank-slate">No cards match this search</div>
+      <% end %>
+    </section>
+  <% end %>
+</div>
