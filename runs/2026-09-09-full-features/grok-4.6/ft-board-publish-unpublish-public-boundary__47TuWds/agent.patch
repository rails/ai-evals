@@ -0,0 +1,24 @@
+module PublicBoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    allow_unauthenticated_access
+    layout "public"
+
+    before_action :set_publication
+    before_action :set_board
+  end
+
+  private
+    def set_publication
+      @publication = Board::Publication.find_by!(key: public_board_key, account: Current.account)
+    end
+
+    def set_board
+      @board = @publication.board
+    end
+
+    def public_board_key
+      params[:board_key] || params[:key]
+    end
+end
