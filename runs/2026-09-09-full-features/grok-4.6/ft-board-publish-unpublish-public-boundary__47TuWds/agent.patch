@@ -0,0 +1,39 @@
+require "test_helper"
+
+class Board::PublicationTest < ActiveSupport::TestCase
+  test "publish creates a unique key" do
+    publication = boards(:writebook).publish
+
+    assert publication.persisted?
+    assert publication.key.present?
+    assert_equal boards(:writebook).account, publication.account
+  end
+
+  test "publish is idempotent" do
+    board = boards(:writebook)
+    publication = board.publish
+
+    assert_no_difference -> { Board::Publication.count } do
+      assert_equal publication, board.publish
+    end
+  end
+
+  test "unpublish removes the publication" do
+    board = boards(:writebook)
+    board.publish
+
+    board.unpublish
+
+    assert_not board.reload.published?
+    assert_nil board.publication
+  end
+
+  test "destroying the board destroys the publication" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      board.destroy
+    end
+  end
+end
