+require "test_helper"
+
+class ExportTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+  end
+
+  test "account export zips records and emails a download link" do
+    cards(:logo).image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = Export.create!(account: @account, user: @user, kind: "account")
+
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      perform_enqueued_jobs
+    end
+
+    export.reload
+    assert export.file.attached?
+    assert_equal "application/zip", export.file.content_type
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_includes email.subject, "account export"
+    assert_includes email.html_part.body.to_s, "Download ZIP"
+    assert_includes email.html_part.body.to_s, "rails/active_storage"
+
+    ZipFile.open(export.file) do |zip|
+      assert zip.glob("accounts/*.json").any?
+      assert zip.glob("users/*.json").any?
+      assert zip.glob("cards/*.json").any?
+      assert zip.glob("files/*").any?
+
+      account_json = JSON.parse(zip.read(zip.glob("accounts/*.json").first))
+      assert_equal @account.name, account_json["name"]
+    end
+  end
+
+  test "cards export includes accessible cards, comments, and files" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = Export.create!(account: @account, user: users(:david), kind: "cards")
+
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      perform_enqueued_jobs
+    end
+
+    export.reload
+    ZipFile.open(export.file) do |zip|
+      payload = JSON.parse(zip.read("cards/#{card.number}.json"))
+      assert_equal card.title, payload["title"]
+      assert payload["comments"].any?
+      assert_equal "cards/#{card.number}/moon.jpg", payload["image"]
+      assert zip.exists?("cards/#{card.number}/moon.jpg")
+    end
+  end
+end
diff --git a/test/models/import_test.rb b/test/models/import_test.rb
new file mode 100644
index 0000000..39d2203
--- /dev/null
+++ b/test/models/import_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class ImportTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @account = accounts(:"37s")
+    @user = users(:kevin)
+  end
+
+  test "import creates a new account with boards, cards, comments, files, and people" do
+    card = cards(:logo)
+    card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+
+    export = Export.create!(account: @account, user: @user, kind: "account")
+    perform_enqueued_jobs
+    export.reload
+
+    assert_difference -> { Account.count }, 1 do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        Import.create!(account: @account, user: @user, file: export.file.blob)
+        perform_enqueued_jobs
+      end
+    end
+
+    import = Import.order(:created_at).last
+    imported = import.imported_account
+    assert imported.present?
+    assert_equal @account.name, imported.name
+    assert_not_equal @account.id, imported.id
+    assert_not_equal @account.external_account_id, imported.external_account_id
+
+    assert imported.boards.find_by(name: boards(:writebook).name)
+    imported_card = imported.cards.find_by(number: card.number)
+    assert_equal card.title, imported_card.title
+    assert imported_card.image.attached?
+    assert imported_card.comments.any?
+    assert imported.users.find_by(identity: @user.identity)
+
+    email = ActionMailer::Base.deliveries.last
+    assert_includes email.subject, "import is complete"
+    assert_includes email.html_part.body.to_s, imported.name
+  end
+
+  test "a failed import leaves nothing behind" do
+    export = Export.create!(account: @account, user: @user, kind: "account")
+    perform_enqueued_jobs
+    export.reload
+
+    Account::DataTransfer::AccountRecordSet.any_instance.stubs(:import_from).raises(RuntimeError, "boom")
+
+    assert_no_difference -> { Account.count } do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        Import.create!(account: @account, user: @user, file: export.file.blob)
+        perform_enqueued_jobs
+      end
+    end
+
+    import = Import.order(:created_at).last
+    assert_nil import.imported_account
+    assert_equal "boom", import.error
+
+    email = ActionMailer::Base.deliveries.last
+    assert_includes email.subject, "import failed"
+    assert_includes email.html_part.body.to_s, "boom"
+  end
+end
