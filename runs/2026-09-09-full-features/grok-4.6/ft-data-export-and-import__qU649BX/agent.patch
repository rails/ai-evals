+    @ids[old_id.to_s] if old_id.present?
+  end
+
+  def []=(old_id, new_id)
+    @ids[old_id.to_s] = new_id if old_id.present?
+  end
+
+  def assign(old_id)
+    if old_id.present?
+      @ids[old_id.to_s] ||= ActiveRecord::Type::Uuid.generate
+    end
+  end
+end
