+
+    def record_path(record)
+      "#{model_dir}/#{record.id}.json"
+    end
+
+    def attributes_for(record)
+      record.attributes.slice(*attributes).as_json
+    end
+
+    def remap_attributes(attrs, id_map)
+      attrs.each_with_object({}) do |(key, value), result|
+        result[key] = remap_value(key, value, id_map)
+      end
+    end
+
+    def remap_value(key, value, id_map)
+      if key == "id"
+        id_map.assign(value)
+      elsif key.end_with?("_id") && SKIP_ID_ATTRIBUTES.exclude?(key)
+        id_map.assign(value)
+      else
+        remap_nested(value, id_map)
+      end
+    end
+
+    def remap_nested(value, id_map)
+      case value
+      when Hash
+        value.each_with_object({}) { |(k, v), result| result[k] = remap_nested(v, id_map) }
+      when Array
+        value.map { |v| remap_nested(v, id_map) }
+      when String
+        if value.match?(UUID_PATTERN) && id_map[value]
+          id_map[value]
+        else
+          value
+        end
+      else
+        value
+      end
+    end
+
+    def attributes_for_insert(attrs)
+      attrs.each_with_object({}) do |(key, value), result|
+        result[key] = if key == "key" && model == Board::Publication
+          Board::Publication.generate_unique_secure_token
+        else
+          value
+        end
+      end
+    end
+
+    def insert_rows(rows)
+      model.insert_all!(rows) if rows.any?
+    end
 end
