+    assert_equal "cards", Export.last.kind
+    assert_equal users(:david), Export.last.user
+  end
+
+  test "a user cannot export someone else's cards" do
+    assert_no_difference -> { Export.count } do
+      post user_export_path(users(:kevin))
+    end
+
+    assert_response :forbidden
+  end
+end
