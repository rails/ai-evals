@@ -0,0 +1,23 @@
+class ImportMailer < ApplicationMailer
+  def completed(import)
+    @import = import
+    @user = import.user
+    @account = import.imported_account
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your Fizzy account import is complete"
+    )
+  end
+
+  def failed(import)
+    @import = import
+    @user = import.user
+    @error = import.error
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Your Fizzy account import failed"
+    )
+  end
+end
