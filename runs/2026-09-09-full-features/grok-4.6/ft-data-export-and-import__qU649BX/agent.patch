+++ b/app/models/import.rb
@@ -0,0 +1,83 @@
+class Import < ApplicationRecord
+  belongs_to :account, default: -> { Current.account }
+  belongs_to :user, default: -> { Current.user }
+  belongs_to :imported_account, class_name: "Account", optional: true
+
+  has_one_attached :file, dependent: :purge_later
+
+  after_create_commit :import_later
+
+  def import_later
+    ImportJob.perform_later(self)
+  end
+
+  def import_now
+    imported = nil
+
+    ZipFile.open(file) do |zip|
+      id_map = Account::DataTransfer::IdMap.new
+      record_sets = []
+      Account::DataTransfer::Manifest.new(account).each_record_set { |record_set| record_sets << record_set }
+
+      account_record_set, *remaining_record_sets = record_sets
+      account_record_set.import_from(zip, id_map: id_map)
+      imported = Account.find(id_map.account_id)
+
+      Current.with_account(imported) do
+        remaining_record_sets.each do |record_set|
+          record_set.import_from(zip, id_map: id_map)
+        end
+
+        ensure_importer_membership(imported)
+        reindex(imported)
+      end
+    end
+
+    update!(imported_account: imported)
+    ImportMailer.completed(self).deliver_now
+  rescue => error
+    rollback(imported)
+    update!(error: error.message, imported_account: nil)
+    ImportMailer.failed(self).deliver_now
+  end
+
+  private
+    def ensure_importer_membership(imported)
+      membership = imported.users.find_by(identity: user.identity)
+
+      if membership
+        membership.update!(active: true, verified_at: membership.verified_at || Time.current)
+      else
+        imported.users.create!(
+          name: user.name,
+          identity: user.identity,
+          role: :owner,
+          verified_at: Time.current
+        )
+      end
+    end
+
+    def reindex(imported)
+      imported.cards.published.find_each(&:reindex)
+      Comment.joins(:card).merge(imported.cards.published).find_each(&:reindex)
+    end
+
+    def rollback(imported)
+      return unless imported
+
+      Current.with_account(imported) do
+        Storage::Entry.suppressing_recording do
+          ActiveStorage::Blob.where(account: imported).find_each do |blob|
+            delete_blob_file(blob)
+          end
+          imported.destroy
+        end
+      end
+    end
+
+    def delete_blob_file(blob)
+      blob.service.delete(blob.key)
+    rescue StandardError
+      # Files may already be gone if the import failed mid-upload.
+    end
+end
