diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..e93bcd4
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,160 @@
+class Export < ApplicationRecord
+  DOWNLOAD_DURATION = 1.day
+
+  belongs_to :account, default: -> { Current.account }
+  belongs_to :user, default: -> { Current.user }
+
+  has_one_attached :file, dependent: :purge_later
+
+  after_create_commit :export_later
+
+  def export_later
+    ExportJob.perform_later(self)
+  end
+
+  def export_now
+    ZipFile.create_for(file, filename: filename) do |zip|
+      if account_export?
+        write_account(zip)
+      else
+        write_cards(zip)
+      end
+    end
+
+    ExportMailer.ready(self).deliver_now
+  end
+
+  def download_url
+    Rails.application.routes.url_helpers.rails_blob_url(
+      file,
+      expires_in: DOWNLOAD_DURATION,
+      host: host,
+      script_name: account.slug
+    )
+  end
+
+  def account_export?
+    kind == "account"
+  end
+
+  def filename
+    if account_export?
+      "fizzy-#{account.name.parameterize}-export.zip"
+    else
+      "fizzy-cards-export.zip"
+    end
+  end
+
+  private
+    def write_account(zip)
+      Account::DataTransfer::Manifest.new(account).each_record_set do |record_set|
+        record_set.export_to(zip)
+      end
+    end
+
+    def write_cards(zip)
+      cards.find_each do |card|
+        zip.add_file(card_json_path(card), card_payload(card).to_json)
+        write_card_files(zip, card)
+      end
+    end
+
+    def cards
+      user.accessible_cards.preloaded.includes(comments: [ :creator, { rich_text_body: { embeds_attachments: :blob } } ])
+    end
+
+    def card_json_path(card)
+      "cards/#{card.number}.json"
+    end
+
+    def card_payload(card)
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        status: card.status,
+        description: card.description.to_plain_text,
+        description_html: card.description.to_s,
+        created_at: card.created_at.utc,
+        last_active_at: card.last_active_at&.utc,
+        closed: card.closed?,
+        postponed: card.postponed?,
+        golden: card.golden?,
+        board: { id: card.board_id, name: card.board.name },
+        column: card.column && { id: card.column_id, name: card.column.name },
+        creator: person_payload(card.creator),
+        assignees: card.assignees.map { |user| person_payload(user) },
+        tags: card.tags.map(&:title).sort,
+        comments: card.comments.chronologically.map { |comment| comment_payload(comment) },
+        image: card.image.attached? ? card_file_path(card, card.image.blob) : nil,
+        attachments: attachment_payloads(card)
+      }
+    end
+
+    def comment_payload(comment)
+      {
+        id: comment.id,
+        created_at: comment.created_at.utc,
+        updated_at: comment.updated_at.utc,
+        body: comment.body.to_plain_text,
+        body_html: comment.body.to_s,
+        creator: person_payload(comment.creator),
+        attachments: comment.attachments.map { |attachment| file_payload(card_comment_file_path(comment, attachment.blob), attachment.blob) }
+      }
+    end
+
+    def person_payload(user)
+      {
+        id: user.id,
+        name: user.name,
+        email_address: user.identity&.email_address
+      }
+    end
+
+    def attachment_payloads(card)
+      files = []
+      files << file_payload(card_file_path(card, card.image.blob), card.image.blob) if card.image.attached?
+      card.attachments.each do |attachment|
+        files << file_payload(card_file_path(card, attachment.blob), attachment.blob)
+      end
+      files
+    end
+
+    def file_payload(path, blob)
+      { filename: blob.filename.to_s, content_type: blob.content_type, path: path }
+    end
+
+    def write_card_files(zip, card)
+      write_blob_file(zip, card_file_path(card, card.image.blob), card.image.blob) if card.image.attached?
+
+      card.attachments.each do |attachment|
+        write_blob_file(zip, card_file_path(card, attachment.blob), attachment.blob)
+      end
+
+      card.comments.each do |comment|
+        comment.attachments.each do |attachment|
+          write_blob_file(zip, card_comment_file_path(comment, attachment.blob), attachment.blob)
+        end
+      end
+    end
+
+    def write_blob_file(zip, path, blob)
+      return if zip.exists?(path)
+
+      zip.add_file(path, compress: false) do |sink|
+        blob.download { |chunk| sink.write(chunk) }
+      end
+    end
+
+    def card_file_path(card, blob)
+      "cards/#{card.number}/#{blob.filename}"
+    end
+
+    def card_comment_file_path(comment, blob)
+      "cards/#{comment.card.number}/comments/#{comment.id}/#{blob.filename}"
+    end
+
+    def host
+      Rails.application.config.action_mailer.default_url_options&.[](:host) || "localhost"
+    end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
