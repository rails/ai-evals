diff --git a/app/models/zip_file/blob_io.rb b/app/models/zip_file/blob_io.rb
new file mode 100644
index 0000000..cc2d4f9
--- /dev/null
+++ b/app/models/zip_file/blob_io.rb
@@ -0,0 +1,56 @@
+# A seekable IO over an ActiveStorage blob that uses range reads.
+# This lets us parse ZIP central directories on 500GB+ archives without
+# downloading the whole object.
+class ZipFile::BlobIO
+  def initialize(blob)
+    @blob = blob
+    @pos = 0
+  end
+
+  def size
+    @blob.byte_size
+  end
+
+  def tell
+    @pos
+  end
+
+  def seek(amount, whence = IO::SEEK_SET)
+    @pos = new_position(amount, whence)
+    0
+  end
+
+  def read(n_bytes = nil)
+    return if size.zero?
+
+    available = size - @pos
+    n_bytes = available if n_bytes.nil?
+    return "" if n_bytes.zero? || available <= 0
+
+    n_bytes = available if n_bytes > available
+    data = @blob.service.download_chunk(@blob.key, @pos...(@pos + n_bytes))
+    @pos += data.bytesize
+    data
+  end
+
+  def binmode
+    self
+  end
+
+  def close
+  end
+
+  private
+    def new_position(amount, whence)
+      case whence
+      when IO::SEEK_SET
+        amount
+      when IO::SEEK_CUR
+        @pos + amount
+      when IO::SEEK_END
+        size + amount
+      else
+        raise ArgumentError, "Unknown seek mode #{whence}"
+      end.clamp(0, size)
+    end
+end
diff --git a/app/models/zip_file/extractor_io.rb b/app/models/zip_file/extractor_io.rb
new file mode 100644
index 0000000..bf6d404
--- /dev/null
+++ b/app/models/zip_file/extractor_io.rb
@@ -0,0 +1,70 @@
+# Readable IO adapter over a ZipKit extractor so ActiveStorage can stream
+# a ZIP entry into blob storage without buffering the whole file.
+class ZipFile::ExtractorIO
+  def initialize(extractor)
+    @extractor = extractor
+    @buffer = "".b
+  end
+
+  def read(n_bytes = nil, outbuf = nil)
+    data = if n_bytes.nil?
+      drain_remaining
+    else
+      fill_buffer_to(n_bytes)
+      slice = @buffer.byteslice(0, n_bytes)
+      @buffer = @buffer.byteslice(slice.bytesize, @buffer.bytesize) || "".b
+      slice
+    end
+
+    if data.nil? || data.empty?
+      if eof?
+        outbuf&.clear
+        nil
+      else
+        write_out(outbuf, "".b)
+      end
+    else
+      write_out(outbuf, data)
+    end
+  end
+
+  def eof?
+    @buffer.empty? && @extractor.eof?
+  end
+
+  def binmode
+    self
+  end
+
+  def close
+  end
+
+  private
+    def drain_remaining
+      data = @buffer
+      @buffer = "".b
+
+      until @extractor.eof?
+        chunk = @extractor.extract(1.megabyte)
+        data << chunk if chunk
+      end
+
+      data
+    end
+
+    def fill_buffer_to(n_bytes)
+      while @buffer.bytesize < n_bytes && !@extractor.eof?
+        chunk = @extractor.extract([ n_bytes, 1.megabyte ].max)
+        @buffer << chunk if chunk
+      end
+    end
+
+    def write_out(outbuf, data)
+      if outbuf
+        outbuf.replace(data)
+        outbuf
+      else
+        data
+      end
+    end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..086a75a
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,42 @@
+class ZipFile::Reader
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io)
+    @entries_by_name = @entries.index_by(&:filename)
+  end
+
+  def glob(pattern)
+    @entries.map(&:filename).select { |name| File.fnmatch(pattern, name) }.sort
+  end
+
+  def exists?(path)
+    @entries_by_name.key?(path)
+  end
+
+  def read(path)
+    extract(path)
+  end
+
+  def extract(path)
+    entry = @entries_by_name.fetch(path)
+    extractor = entry.extractor_from(@io)
+
+    if block_given?
+      yield ZipFile::ExtractorIO.new(extractor)
+    else
+      read_all(extractor)
+    end
+  end
+
+  private
+    def read_all(extractor)
+      data = "".b
+
+      until extractor.eof?
+        chunk = extractor.extract(1.megabyte)
+        data << chunk if chunk
+      end
+
+      data
+    end
+end
