diff --git a/app/models/account/data_transfer/action_text/rich_text_record_set.rb b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
index 76411f2..acd435b 100644
--- a/app/models/account/data_transfer/action_text/rich_text_record_set.rb
+++ b/app/models/account/data_transfer/action_text/rich_text_record_set.rb
@@ -8,4 +8,61 @@ class Account::DataTransfer::ActionText::RichTextRecordSet < Account::DataTransf
       ::ActionText::RichText.where(account: account)
     end
 
+    def attributes_for(record)
+      super.merge("body" => portable_body(record))
+    end
+
+    def remap_attributes(attrs, id_map)
+      super.tap do |remapped|
+        remapped["body"] = restore_body(remapped["body"], id_map)
+      end
+    end
+
+    def portable_body(record)
+      html = record.body&.to_html
+      return html if html.blank?
+
+      fragment = Nokogiri::HTML.fragment(html)
+      fragment.css(ActionText::Attachment.tag_name).each do |node|
+        localize_attachment(node)
+      end
+      fragment.to_html
+    end
+
+    def localize_attachment(node)
+      attachable = ActionText::Attachable.from_node(node)
+
+      if attachable.is_a?(ActiveStorage::Blob)
+        node.remove_attribute("sgid")
+        node.remove_attribute("url")
+        node["blob-id"] = attachable.id
+      end
+    rescue ActiveRecord::RecordNotFound
+      # Leave the original node if the attachable is gone.
+    end
+
+    def restore_body(html, id_map)
+      return html if html.blank?
+
+      fragment = Nokogiri::HTML.fragment(html)
+      fragment.css(ActionText::Attachment.tag_name).each do |node|
+        restore_attachment(node, id_map)
+      end
+      fragment.to_html
+    end
+
+    def restore_attachment(node, id_map)
+      blob_id = node["blob-id"]
+      return unless blob_id
+
+      new_id = id_map[blob_id]
+      return unless new_id
+
+      blob = ActiveStorage::Blob.find_by(id: new_id)
+      return unless blob
+
+      caption = node["caption"]
+      restored = ActionText::Attachment.from_attachable(blob, { caption: caption }.compact)
+      node.replace(Nokogiri::HTML.fragment(restored.to_html))
+    end
 end
