diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..82126b2
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,88 @@
+# Deploy Fizzy to a single Linux box with Docker and SQLite.
+#
+# Fill in your hostname, mail server, and secrets, then run `bin/kamal setup`.
+# Fizzy will be at https://your-host. SQLite, uploads, and Solid Queue all run
+# in one container. Data lives in the fizzy_storage volume and survives deploys.
+#
+# SSL is terminated by kamal-proxy (Let's Encrypt). Point DNS at the box first.
+
+<%
+  # Fill these in:
+  server = "192.168.0.1"        # Linux box you can SSH into
+  host   = "fizzy.example.com"  # Public hostname
+%>
+
+service: fizzy
+
+# Local registry started by `kamal setup`. Switch to Docker Hub / GHCR if you prefer.
+image: fizzy
+
+# Deploy to these servers.
+servers:
+  web:
+    - <%= server %>
+
+# Enable SSL auto certification via Let's Encrypt.
+#
+# Note: If using Cloudflare, set encryption mode in SSL/TLS setting to "Full"
+# to enable CF-to-app encryption.
+proxy:
+  ssl: true
+  host: <%= host %>
+
+registry:
+  server: localhost:5555
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+  clear:
+    # Solid Queue runs inside Puma so jobs run on this box without a second container.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Public hostname - used for mailer links and URL generation.
+    APP_HOST: <%= host %>
+
+    # Outbound mail (magic-link sign-in, notifications). Fill in your mail server.
+    MAILER_FROM_ADDRESS: "Fizzy <noreply@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    # SMTP_DOMAIN: example.com
+    # SMTP_AUTHENTICATION: plain
+
+    # Set number of processes dedicated to Solid Queue (default: 1)
+    # JOB_CONCURRENCY: 3
+
+    # Set number of cores available to the application on each server (default: 1).
+    # WEB_CONCURRENCY: 2
+
+    # Log everything from Rails
+    # RAILS_LOG_LEVEL: debug
+
+# Aliases are triggered with "bin/kamal <alias>". You can overwrite arguments on invocation.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole --include-password"
+
+# Persistent storage for SQLite databases and Active Storage uploads.
+# Recommended to change this to a mounted volume path that is backed up off server.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests. Combines all files from new and old
+# version inside the asset_path.
+asset_path: /rails/public/assets
+
+# Configure the image builder.
+builder:
+  arch: amd64
+
+# Use a different ssh user than root
+# ssh:
+#   user: app
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..85e7445 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -80,6 +80,27 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Canonical host for mailer links and generated URLs (set APP_HOST in config/deploy.yml).
+  if ENV["APP_HOST"].present?
+    url_options = { host: ENV["APP_HOST"], protocol: ENV.fetch("APP_PROTOCOL", "https") }
+    config.action_mailer.default_url_options = url_options
+    config.action_controller.default_url_options = url_options
+  end
+
+  # Outbound email via SMTP when a mail server is configured.
+  if ENV["SMTP_ADDRESS"].present?
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = {
+      address: ENV["SMTP_ADDRESS"],
+      port: Integer(ENV.fetch("SMTP_PORT", "587")),
+      domain: ENV.fetch("SMTP_DOMAIN", ENV["APP_HOST"]),
+      user_name: ENV["SMTP_USERNAME"].presence,
+      password: ENV["SMTP_PASSWORD"].presence,
+      authentication: ENV["SMTP_AUTHENTICATION"].presence,
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+    }.compact
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
diff --git a/docs/deploy.md b/docs/deploy.md
new file mode 100644
index 0000000..f41d34e
--- /dev/null
+++ b/docs/deploy.md
@@ -0,0 +1,33 @@
+## Deployment
+
+Fizzy deploys to a single Linux server with [Kamal](https://kamal-deploy.org/): Docker, SQLite, background jobs, and SSL from kamal-proxy, all on one box.
+
+### What you need
+
+- A Linux server you can SSH into (Kamal installs Docker if needed)
+- A hostname pointing at that server (for Let's Encrypt)
+- An SMTP server, for magic-link sign-in and notifications
+
+### Configure
+
+1. In `config/deploy.yml`, set:
+   - `server` to your Linux box
+   - `host` to your public hostname
+   - `MAILER_FROM_ADDRESS`, `SMTP_ADDRESS`, and `SMTP_PORT` to your mail server
+2. Generate a secret key and add SMTP credentials:
+
+```sh
+bin/rails secret > .kamal/secret_key_base
+export SMTP_USERNAME=your-smtp-username
+export SMTP_PASSWORD=your-smtp-password
+```
+
+### Deploy
+
+```sh
+bin/kamal setup
+```
+
+Fizzy will be at `https://your-host`. Later deploys are `bin/kamal deploy`.
+
+SQLite data and uploads live in the `fizzy_storage` Docker volume, so they survive deploys. Background jobs run in the web container via Solid Queue.
