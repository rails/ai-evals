@@ -0,0 +1,27 @@
+class Users::PushSubscriptionsController < ApplicationController
+  wrap_parameters :push_subscription, include: %i[ endpoint p256dh_key auth_key ]
+
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    subscription = PushSubscription.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    subscription.assign_attributes(push_subscription_params.merge(user: @user))
+    subscription.save!
+
+    head :created
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..649a828
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,115 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+export default class extends Controller {
+  static values = { subscriptionsUrl: String, vapidPublicKey: String }
+  static targets = [ "details" ]
+  static classes = [ "on" ]
+
+  async connect() {
+    if (!this.#supported) {
+      this.#off()
+      this.#showDetails()
+      return
+    }
+
+    switch (Notification.permission) {
+      case "granted":
+        await this.#enable()
+        break
+      case "denied":
+        this.#off()
+        this.#showDetails()
+        break
+      default:
+        this.#off()
+        this.#hideDetails()
+    }
+  }
+
+  async attemptToSubscribe() {
+    if (!this.#supported) {
+      this.#showDetails()
+      return
+    }
+
+    const permission = await Notification.requestPermission()
+
+    if (permission === "granted") {
+      await this.#enable()
+    } else {
+      this.#off()
+      this.#showDetails()
+    }
+  }
+
+  async #enable() {
+    try {
+      await this.#syncSubscription()
+      this.#on()
+      this.#hideDetails()
+    } catch (error) {
+      this.#off()
+      this.#showDetails()
+    }
+  }
+
+  #on() {
+    this.element.classList.add(this.onClass)
+  }
+
+  #off() {
+    this.element.classList.remove(this.onClass)
+  }
+
+  #showDetails() {
+    this.detailsTargets.forEach(details => details.hidden = false)
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach(details => details.hidden = true)
+  }
+
+  async #syncSubscription() {
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey
+    })
+
+    await this.#postSubscription(subscription)
+  }
+
+  #postSubscription(subscription) {
+    return post(this.subscriptionsUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: this.#encodeKey(subscription.getKey("p256dh")),
+          auth_key: this.#encodeKey(subscription.getKey("auth"))
+        }
+      },
+      responseKind: "json"
+    })
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.vapidPublicKeyValue.length % 4) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const raw = atob(base64)
+
+    return Uint8Array.from(raw, char => char.charCodeAt(0))
+  }
+
+  #encodeKey(buffer) {
+    const bytes = new Uint8Array(buffer)
+    let binary = ""
+    bytes.forEach(byte => binary += String.fromCharCode(byte))
+
+    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
+  }
+
+  get #supported() {
+    return this.hasVapidPublicKeyValue && "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+}
