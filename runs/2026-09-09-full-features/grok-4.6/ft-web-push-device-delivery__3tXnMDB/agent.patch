+require "test_helper"
+
+class Notification::PushJobTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @notification = notifications(:logo_assignment_kevin)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/abc",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+  end
+
+  test "perform delivers to each of the user's subscriptions" do
+    WebPush.expects(:payload_send).once
+
+    Notification::PushJob.perform_now(@notification)
+  end
+
+  test "creating a notification enqueues a push" do
+    @user.notifications.where(card: cards(:logo)).destroy_all
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notification.create!(user: @user, source: events(:logo_published), creator: users(:david))
+    end
+  end
+
+  test "updating the source enqueues a push" do
+    assert_enqueued_with(job: Notification::PushJob) do
+      @notification.update!(source: events(:logo_published))
+    end
+  end
+end
