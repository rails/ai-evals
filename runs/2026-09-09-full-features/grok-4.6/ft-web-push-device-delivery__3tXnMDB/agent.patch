new file mode 100644
index 0000000..162a026
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,59 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :push_later
+    after_update_commit :push_on_source_change
+  end
+
+  def push_later
+    if PushSubscription.configured? && user.push_subscriptions.exists?
+      Notification::PushJob.perform_later(self)
+    end
+  end
+
+  def push_now
+    return if source.blank? || card.blank?
+
+    user.push_subscriptions.find_each do |subscription|
+      subscription.deliver(self)
+    end
+  end
+
+  def push_payload
+    { title: push_title, body: push_body, path: push_path }
+  end
+
+  def push_title
+    case source
+    when Event
+      helpers.event_notification_title(source)
+    when Mention
+      "#{source.mentioner.first_name} @mentioned you"
+    end
+  end
+
+  def push_body
+    case source
+    when Event
+      helpers.event_notification_body(source)
+    when Mention
+      source.source.mentionable_content.truncate(200)
+    end
+  end
+
+  def push_path
+    Rails.application.routes.url_helpers.card_path(card, script_name: account.slug)
+  end
+
+  private
+    def push_on_source_change
+      if source_id_previously_changed?
+        push_later
+      end
+    end
+
+    def helpers
+      ApplicationController.helpers
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..7dfc834
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,35 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+  class << self
+    def configured?
+      vapid[:public_key].present? && vapid[:private_key].present?
+    end
+
+    def vapid
+      {
+        subject: Rails.configuration.x.vapid.subject,
+        public_key: Rails.configuration.x.vapid.public_key,
+        private_key: Rails.configuration.x.vapid.private_key
+      }
+    end
+  end
+
+  def deliver(notification)
+    return unless self.class.configured?
+
+    WebPush.payload_send \
+      message: notification.push_payload.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: self.class.vapid
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized
+    destroy
+  rescue WebPush::ResponseError, Net::OpenTimeout, Net::ReadTimeout, SocketError, OpenSSL::SSL::SSLError => error
+    logger.warn "Push failed for subscription #{id}: #{error.message}"
+  end
+end
