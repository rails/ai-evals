+++ b/config/initializers/web_push.rb
@@ -0,0 +1,27 @@
+Rails.application.configure do
+  config.x.vapid.subject = ENV.fetch("VAPID_SUBJECT", "mailto:support@fizzy.do")
+  config.x.vapid.public_key = ENV["VAPID_PUBLIC_KEY"]
+  config.x.vapid.private_key = ENV["VAPID_PRIVATE_KEY"]
+
+  if config.x.vapid.public_key.blank? && Rails.env.development?
+    path = Rails.root.join("tmp/vapid.yml")
+
+    keys = if File.exist?(path)
+      YAML.load_file(path).symbolize_keys
+    else
+      key = WebPush.generate_key
+      generated = { public_key: key.public_key, private_key: key.private_key }
+      File.write(path, generated.stringify_keys.to_yaml)
+      generated
+    end
+
+    config.x.vapid.public_key = keys.fetch(:public_key)
+    config.x.vapid.private_key = keys.fetch(:private_key)
+  end
+
+  if config.x.vapid.public_key.blank? && Rails.env.test?
+    key = WebPush.generate_key
+    config.x.vapid.public_key = key.public_key
+    config.x.vapid.private_key = key.private_key
+  end
+end
