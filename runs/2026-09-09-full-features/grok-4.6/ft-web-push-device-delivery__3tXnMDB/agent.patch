index 483cba6..9c20983 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,35 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+self.addEventListener("push", (event) => {
+  const data = event.data.json()
+
+  event.waitUntil(
+    self.registration.showNotification(data.title, {
+      body: data.body,
+      data: { path: data.path },
+      icon: "/app-icon-192.png"
+    })
+  )
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openNotification(event.notification.data.path))
+})
+
+async function openNotification(path) {
+  const url = new URL(path, self.location.origin).href
+  const windows = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+
+  for (const client of windows) {
+    if (client.url === url && "focus" in client) {
+      return client.focus()
+    }
+  }
+
+  if (self.clients.openWindow) {
+    return self.clients.openWindow(url)
+  }
+}
