@@ -0,0 +1,52 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @subscription = @user.push_subscriptions.create!(
+      endpoint: "https://push.example.com/abc",
+      p256dh_key: "p256dh-key",
+      auth_key: "auth-key"
+    )
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "deliver sends the tray title, body, and card path" do
+    WebPush.expects(:payload_send).with do |options|
+      message = JSON.parse(options[:message])
+
+      options[:endpoint] == @subscription.endpoint &&
+        options[:p256dh] == @subscription.p256dh_key &&
+        options[:auth] == @subscription.auth_key &&
+        options[:vapid][:public_key].present? &&
+        message["title"] == @notification.push_title &&
+        message["body"] == @notification.push_body &&
+        message["path"] == @notification.push_path
+    end
+
+    @subscription.deliver(@notification)
+  end
+
+  test "deliver destroys expired subscriptions" do
+    response = stub(body: "", inspect: "")
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(response, "push.example.com"))
+
+    assert_difference -> { PushSubscription.count }, -1 do
+      @subscription.deliver(@notification)
+    end
+  end
+
+  test "push payload matches the tray" do
+    assert_equal "The logo isn't big enough", @notification.push_title
+    assert_equal "Assigned to Kevin", @notification.push_body
+    assert_equal "#{@notification.account.slug}/cards/#{@notification.card.to_param}", @notification.push_path
+  end
+
+  test "mention push payload matches the tray" do
+    notification = notifications(:logo_mentioned_david)
+
+    assert_equal "JZ @mentioned you", notification.push_title
+    assert_equal "I agree.", notification.push_body
+    assert_match %r{#{Regexp.escape(notification.account.slug)}/cards/#{notification.card.to_param}}, notification.push_path
+  end
+end
