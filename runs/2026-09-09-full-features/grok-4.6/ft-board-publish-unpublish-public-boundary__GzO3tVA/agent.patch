+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @card = cards(:logo)
+  end
+
+  test "show" do
+    get public_board_card_path(@board.publication, @card)
+
+    assert_response :success
+    assert_select "h1", text: @card.title
+  end
+
+  test "show as JSON" do
+    get public_board_card_path(@board.publication, @card), as: :json
+
+    assert_response :success
+    assert_equal @card.number, @response.parsed_body["number"]
+    assert_equal @card.title, @response.parsed_body["title"]
+  end
+
+  test "show does not require authentication" do
+    get public_board_card_path(@board.publication, @card)
+
+    assert_response :success
+  end
+
+  test "show returns not found for a drafted card" do
+    card = @board.cards.create!(title: "Draft", status: :drafted, creator: users(:kevin))
+
+    get public_board_card_path(@board.publication, card)
+
+    assert_response :not_found
+  end
+
+  test "show returns not found for a card on another board" do
+    get public_board_card_path(@board.publication, 999_999)
+
+    assert_response :not_found
+  end
+
+  test "show returns not found after unpublishing" do
+    key = @board.publication.key
+    number = @card.number
+    @board.unpublish
+
+    get public_board_card_path(key, number)
+
+    assert_response :not_found
+  end
+end
