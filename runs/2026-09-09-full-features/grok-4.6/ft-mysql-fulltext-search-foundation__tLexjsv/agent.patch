diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..dc4e228
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,48 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+    @user = users(:kevin)
+  end
+
+  test "finds cards by title, newest first" do
+    older = boards(:writebook).cards.create!(title: "Unique haggis title", status: :published, created_at: 2.days.ago)
+    newer = boards(:writebook).cards.create!(title: "Another haggis title", status: :published, created_at: 1.day.ago)
+
+    assert_equal [ newer, older ], Search.new(query: "haggis", user: @user).cards
+  end
+
+  test "finds cards by description" do
+    card = boards(:writebook).cards.create!(title: "Untitled food", description: "A recipe for haggis", status: :published)
+
+    assert_includes Search.new(query: "haggis", user: @user).cards, card
+  end
+
+  test "finds cards by comment body" do
+    cards(:layout).comments.create!(body: "I hate haggis")
+    cards(:logo).comments.create!(body: "I love haggis")
+
+    results = Search.new(query: "haggis", user: @user).cards
+    assert_includes results, cards(:logo)
+    assert_includes results, cards(:layout)
+  end
+
+  test "does not return draft cards or their comments" do
+    draft = boards(:writebook).cards.create!(title: "Draft haggis", description: "Secret haggis", status: :drafted)
+
+    results = Search.new(query: "haggis", user: @user).cards
+    assert_not_includes results, draft
+  end
+
+  test "does not return cards from inaccessible boards" do
+    inaccessible = boards(:private).cards.create!(title: "Private haggis", status: :published, creator: users(:kevin))
+
+    results = Search.new(query: "haggis", user: users(:david)).cards
+    assert_not_includes results, inaccessible
+  end
+
+  test "blank query returns no cards" do
+    assert_empty Search.new(query: " ", user: @user).cards
+  end
+end
