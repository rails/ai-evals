diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..e5578ac
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show" do
+    get search_path
+    assert_response :success
+  end
+
+  test "finds cards by title and wraps matches in mark" do
+    with_current_user :kevin do
+      boards(:writebook).cards.create!(title: "The haggis is ready", status: :published, creator: users(:kevin))
+    end
+
+    get search_path(q: "haggis")
+    assert_response :success
+    assert_select "mark", text: "haggis"
+    assert_select ".search-result", text: /The haggis is ready/
+  end
+
+  test "finds cards by description and wraps matches in mark" do
+    with_current_user :kevin do
+      boards(:writebook).cards.create!(title: "Dinner plans", description: "We should cook haggis tonight", status: :published, creator: users(:kevin))
+    end
+
+    get search_path(q: "haggis")
+    assert_response :success
+    assert_select "mark", text: "haggis"
+  end
+
+  test "finds cards by comment body and wraps matches in mark" do
+    with_current_user :kevin do
+      cards(:logo).comments.create!(body: "I love haggis", creator: users(:kevin))
+    end
+
+    get search_path(q: "haggis")
+    assert_response :success
+    assert_select "mark", text: "haggis"
+    assert_select ".search-result", text: /The logo isn't big enough/
+  end
+
+  test "returns newest cards first" do
+    older = newer = nil
+
+    with_current_user :kevin do
+      older = boards(:writebook).cards.create!(title: "Older haggis", status: :published, creator: users(:kevin), created_at: 2.days.ago)
+      newer = boards(:writebook).cards.create!(title: "Newer haggis", status: :published, creator: users(:kevin), created_at: 1.day.ago)
+    end
+
+    get search_path(q: "haggis")
+    assert_select ".search-result h2" do |elements|
+      titles = elements.map { |el| el.text.strip }
+      assert_equal [ newer.title, older.title ], titles
+    end
+  end
+
+  test "does not return draft cards" do
+    with_current_user :kevin do
+      boards(:writebook).cards.create!(title: "Draft haggis", status: :drafted, creator: users(:kevin))
+    end
+
+    get search_path(q: "haggis")
+    assert_select ".search-result", count: 0
+  end
+
+  test "does not return cards from inaccessible boards" do
+    with_current_user :kevin do
+      boards(:private).cards.create!(title: "Private haggis", status: :published, creator: users(:kevin))
+    end
+
+    logout_and_sign_in_as :david
+    get search_path(q: "haggis")
+    assert_select ".search-result", count: 0
+  end
+end
