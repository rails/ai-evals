diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..570c218
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,15 @@
+module SearchesHelper
+  def highlight_search(text)
+    text = text.to_s
+    return text if @search.blank?
+
+    highlight(text, @search.query)
+  end
+
+  def search_excerpt(content)
+    return if content.blank? || @search.blank?
+
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+    excerpt(text, @search.query, radius: 80)
+  end
+end
