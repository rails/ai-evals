+      <p class="txt-small margin-block-start-half"><%= highlight_search(snippet) %></p>
+    <% end %>
+  <% end %>
+</article>
diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..c33b1c0
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,29 @@
+<% @page_title = @search.blank? ? "Search" : "Search: #{@search.query}" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="search panel center txt-align-start">
+  <%= form_with url: search_path, method: :get, class: "search__form flex gap-half align-center" do %>
+    <%= search_field_tag :q, @search.query,
+          class: "input",
+          placeholder: "Search cards…",
+          autofocus: true,
+          autocomplete: "off",
+          autocorrect: "off",
+          data: { "1p-ignore": "true" } %>
+    <%= button_tag "Search", class: "btn", name: nil %>
+  <% end %>
+
+  <% if @search.blank? %>
+    <p class="blank-slate">Type something to find cards by title, description, or comments</p>
+  <% elsif @page.records.empty? %>
+    <p class="blank-slate">No cards match “<%= @search.query %>”</p>
+  <% else %>
+    <%= with_automatic_pagination :search_paginated_container, @page do %>
+      <%= render partial: "searches/card", collection: @page.records, as: :card %>
+    <% end %>
+  <% end %>
+</section>
