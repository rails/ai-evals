diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..ebff9cd
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,23 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    scope :matching, ->(query) do
+      pattern = "%#{sanitize_sql_like(query.to_s)}%"
+
+      description_card_ids = ActionText::RichText
+        .where(record_type: "Card", name: "description")
+        .where("body LIKE ?", pattern)
+        .select(:record_id)
+
+      comment_ids = ActionText::RichText
+        .where(record_type: "Comment", name: "body")
+        .where("body LIKE ?", pattern)
+        .select(:record_id)
+
+      comment_card_ids = Comment.where(id: comment_ids).select(:card_id)
+
+      where("cards.title LIKE ? OR cards.id IN (?) OR cards.id IN (?)", pattern, description_card_ids, comment_card_ids)
+    end
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..bbdc6dc
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,20 @@
+class Search
+  attr_reader :query, :user
+
+  def initialize(query:, user:)
+    @query = query.to_s.strip
+    @user = user
+  end
+
+  def cards
+    if query.present?
+      user.accessible_cards.published.matching(query).reverse_chronologically
+    else
+      Card.none
+    end
+  end
+
+  def blank?
+    query.blank?
+  end
+end
