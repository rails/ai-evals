+<article class="search-result">
+  <h2 class="txt-medium">
+    <%= link_to highlight_search(card.title), card, class: "txt-undecorated txt-ink" %>
+  </h2>
+
+  <div class="txt-small txt-subtle"><%= card.board.name %></div>
+
+  <% if snippet = search_excerpt(card.description) %>
+    <p class="txt-small margin-block-start-half"><%= highlight_search(snippet) %></p>
