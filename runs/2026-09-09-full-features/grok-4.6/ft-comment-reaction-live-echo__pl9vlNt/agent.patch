+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "adding and removing a reaction on a comment" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Nice!"
+      click_on "Add reaction"
+
+      assert_text "Nice!"
+      assert_selector ".reactions__trigger"
+    end
+
+    reaction = @comment.reactions.order(:created_at).last
+    find("##{dom_id(reaction)}", text: "Nice!").click
+    click_on "Remove reaction"
+
+    assert_no_text "Nice!"
+  end
+
+  test "a reaction from someone else appears without reloading" do
+    visit card_url(@card)
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+    assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+
+    assert_no_text "Shipped"
+
+    @comment.reactions.create!(content: "Shipped", reacter: users(:jz))
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_text "Shipped", wait: 5
+  end
+end
