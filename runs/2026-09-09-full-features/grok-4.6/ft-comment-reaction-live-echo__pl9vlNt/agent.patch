+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "create a reaction on a comment" do
+    comment = comments(:logo_agreement_jz)
+
+    reaction = comment.reactions.create!(content: "Nice!")
+
+    assert_equal "Nice!", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal comment.account, reaction.account
+  end
+
+  test "content is required and limited to 16 characters" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_not comment.reactions.build(content: "").valid?
+    assert_not comment.reactions.build(content: "a" * 17).valid?
+    assert comment.reactions.build(content: "a" * 16).valid?
+  end
+
+  test "content is stripped" do
+    reaction = comments(:logo_agreement_jz).reactions.create!(content: "  👍  ")
+
+    assert_equal "👍", reaction.content
+  end
+
+  test "creating a reaction touches the card" do
+    comment = comments(:logo_agreement_jz)
+
+    assert_changes -> { comment.card.reload.updated_at } do
+      comment.reactions.create!(content: "🔥")
+    end
+  end
+
+  test "emoji_only? for pictographic content" do
+    comment = comments(:logo_agreement_jz)
+
+    assert reactions(:logo_jz_thumbs_up).emoji_only?
+    assert comment.reactions.build(content: "🎉").emoji_only?
+    assert_not comment.reactions.build(content: "Great 👍").emoji_only?
+  end
+end
