+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,22 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "delete" ]
+
+  connect() {
+    if (!this.#ownedByCurrentUser) {
+      this.element.classList.remove("reaction--deleteable")
+      if (this.hasDeleteTarget) this.deleteTarget.hidden = true
+    }
+  }
+
+  toggle() {
+    if (this.#ownedByCurrentUser) {
+      this.element.classList.toggle("expanded")
+    }
+  }
+
+  get #ownedByCurrentUser() {
+    return this.element.dataset.creatorId === document.querySelector("meta[name=current-user-id]")?.content
+  }
+}
