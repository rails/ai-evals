+    assert_select "label", /Bytes used/
+    assert_select "input[type=submit][value=Override]"
+    assert_select "button", "Reset"
+  end
+
+  test "comp and uncomp an account" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_comp_path(account, script_name: nil)
+    end
+
+    assert_redirected_to saas.admin_account_path(account, script_name: nil)
+    assert account.reload.comped?
+
+    untenanted do
+      delete saas.admin_account_comp_path(account, script_name: nil)
+    end
+
+    assert_not account.reload.comped?
+  end
+
+  test "override and reset limits" do
+    sign_in_as :david
+    account = accounts(:initech)
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(account, script_name: nil), params: { card_count: 50, bytes_used: 123 }
+    end
+
+    assert_redirected_to saas.admin_account_path(account, script_name: nil)
+    account.reload
+    assert_equal 50, account.overridden_limit.card_count
+    assert_equal 123, account.overridden_limit.bytes_used
+
+    untenanted do
+      delete saas.admin_account_overridden_limit_path(account, script_name: nil)
+    end
+
+    assert_nil account.reload.overridden_limit
+  end
+end
diff --git a/saas/test/controllers/billing/webhooks_controller_test.rb b/saas/test/controllers/billing/webhooks_controller_test.rb
new file mode 100644
index 0000000..9fc1ea8
--- /dev/null
+++ b/saas/test/controllers/billing/webhooks_controller_test.rb
@@ -0,0 +1,113 @@
+require "test_helper"
+
+class StripeWebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "subscription updated webhook applies the paid plan" do
+    payload = stripe_event_payload(
+      type: "customer.subscription.updated",
+      object: {
+        id: "sub_unlimited",
+        object: "subscription",
+        customer: "cus_unlimited",
+        status: "active",
+        metadata: { account_id: @account.id },
+        items: {
+          object: "list",
+          data: [
+            { price: { id: "price_unlimited", unit_amount: 2000 } }
+          ]
+        }
+      }
+    )
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, headers: stripe_signature_headers(payload)
+    end
+
+    assert_response :ok
+    @account.reload
+    assert_equal "unlimited", @account.subscription.plan_key
+    assert @account.subscription.paid?
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "checkout session completed webhook stores the customer" do
+    payload = stripe_event_payload(
+      type: "checkout.session.completed",
+      object: {
+        id: "cs_test",
+        object: "checkout.session",
+        customer: "cus_checkout",
+        subscription: "sub_checkout",
+        client_reference_id: @account.id,
+        metadata: { account_id: @account.id, plan_key: "unlimited_plus" }
+      }
+    )
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, headers: stripe_signature_headers(payload)
+    end
+
+    assert_response :ok
+    @account.reload
+    assert_equal "cus_checkout", @account.subscription.stripe_customer_id
+    assert_equal "unlimited_plus", @account.subscription.plan_key
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "subscription deleted webhook returns the account to free" do
+    @account.create_subscription!(
+      plan_key: "unlimited",
+      status: "active",
+      stripe_customer_id: "cus_deleted",
+      stripe_subscription_id: "sub_deleted"
+    )
+
+    payload = stripe_event_payload(
+      type: "customer.subscription.deleted",
+      object: {
+        id: "sub_deleted",
+        object: "subscription",
+        customer: "cus_deleted",
+        status: "canceled"
+      }
+    )
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, headers: stripe_signature_headers(payload)
+    end
+
+    assert_response :ok
+    assert_equal "Free", @account.reload.current_plan.name
+  end
+
+  test "invalid signature is rejected" do
+    payload = stripe_event_payload(type: "customer.subscription.updated", object: { id: "sub_x", customer: "cus_x", status: "active" })
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, headers: { "Stripe-Signature" => "t=1,v1=deadbeef", "CONTENT_TYPE" => "application/json" }
+    end
+
+    assert_response :bad_request
+  end
+
+  private
+    def stripe_event_payload(type:, object:)
+      {
+        id: "evt_test_#{SecureRandom.hex(4)}",
+        object: "event",
+        type: type,
+        data: { object: object }
+      }.to_json
+    end
+
+    def stripe_signature_headers(payload)
+      timestamp = Time.now.to_i
+      secret = ENV.fetch("STRIPE_WEBHOOK_SECRET")
+      signature = OpenSSL::HMAC.hexdigest("SHA256", secret, "#{timestamp}.#{payload}")
+      { "Stripe-Signature" => "t=#{timestamp},v1=#{signature}", "CONTENT_TYPE" => "application/json" }
+    end
+end
diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
