+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  test "draft card shows upgrade pitch instead of create buttons when card limit exceeded" do
+    sign_in_as :mike
+    accounts(:initech).override_limits(card_count: 1_000)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select ".card-perma__account-limit-message", text: /Upgrade|upgrade|used all/
+    assert_select "button, a", text: /Upgrade/
+    assert_select ".card-perma__notch-new-card-buttons", count: 0
+  end
+
+  test "draft card shows remaining cards warning from 100 out" do
+    sign_in_as :mike
+    accounts(:initech).override_limits(card_count: 950)
+
+    get card_draft_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :success
+    assert_select "div", text: /50 cards left/
+    assert_select ".card-perma__notch-new-card-buttons"
+  end
+
+  test "can still draft when card limit exceeded" do
+    sign_in_as :mike
+    accounts(:initech).override_limits(card_count: 1_000)
+    accounts(:initech).update_column(:cards_count, 100)
+    boards(:miltons_wish_list).cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "cannot create cards via JSON when card limit exceeded" do
+    sign_in_as :mike
+    accounts(:initech).override_limits(card_count: 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:miltons_wish_list), script_name: accounts(:initech).slug),
+        params: { card: { title: "Blocked card" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "cannot publish cards when card limit exceeded" do
+    sign_in_as :mike
+    accounts(:initech).override_limits(card_count: 1_000)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :forbidden
+    assert cards(:unfinished_thoughts).reload.drafted?
+  end
+
+  test "staff can publish even when card limit exceeded" do
+    sign_in_as :mike
+    accounts(:initech).override_limits(card_count: 1_000)
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    post card_publish_path(cards(:unfinished_thoughts), script_name: accounts(:initech).slug)
+
+    assert_response :redirect
+    assert cards(:unfinished_thoughts).reload.published?
+  end
+end
diff --git a/saas/test/models/account/billed_test.rb b/saas/test/models/account/billed_test.rb
new file mode 100644
index 0000000..d183750
--- /dev/null
+++ b/saas/test/models/account/billed_test.rb
@@ -0,0 +1,98 @@
+require "test_helper"
+
+class Account::BilledTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free plan is the default" do
+    assert_equal "Free", @account.current_plan.name
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "exceeding card limit at 1000 cards" do
+    @account.override_limits(card_count: 1_000)
+
+    assert @account.exceeding_card_limit?
+  end
+
+  test "not exceeding card limit just under 1000" do
+    @account.override_limits(card_count: 999)
+
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "nearing card limit from 100 cards out" do
+    @account.override_limits(card_count: 900)
+
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+  end
+
+  test "cards remaining counts down" do
+    @account.override_limits(card_count: 950)
+
+    assert @account.nearing_card_limit?
+    assert_equal 50, @account.cards_remaining
+  end
+
+  test "not nearing card limit when already exceeding it" do
+    @account.override_limits(card_count: 1_000)
+
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "paid unlimited plan has no card limit and 5 GB storage" do
+    @account.create_subscription!(plan_key: "unlimited", status: "active", stripe_customer_id: "cus_unlimited")
+
+    assert_equal "Unlimited", @account.current_plan.name
+    assert_nil @account.card_limit
+    assert_not @account.exceeding_card_limit?
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "paid unlimited plus plan has 500 GB storage" do
+    @account.create_subscription!(plan_key: "unlimited_plus", status: "active", stripe_customer_id: "cus_plus")
+
+    assert_equal "Unlimited+", @account.current_plan.name
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "comp grants unlimited plus benefits" do
+    @account.comp
+
+    assert @account.comped?
+    assert_equal "Unlimited+", @account.current_plan.name
+    assert_not @account.exceeding_card_limit?
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "uncomp returns the account to its regular plan" do
+    @account.comp
+    @account.uncomp
+
+    assert_not @account.comped?
+    assert_equal "Free", @account.current_plan.name
+  end
+
+  test "reset drops the override" do
+    @account.override_limits(card_count: 1_000, bytes_used: 2.gigabytes)
+    @account.reset_overridden_limits
+
+    assert_nil @account.reload.overridden_limit
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "overridden bytes used are used for storage limits" do
+    @account.override_limits(bytes_used: 1.gigabyte + 1)
+
+    assert @account.exceeding_storage_limit?
+  end
+
+  test "canceled subscription is treated as free" do
+    @account.create_subscription!(plan_key: "unlimited", status: "canceled", stripe_customer_id: "cus_canceled")
+
+    assert_equal "Free", @account.current_plan.name
+  end
+end
