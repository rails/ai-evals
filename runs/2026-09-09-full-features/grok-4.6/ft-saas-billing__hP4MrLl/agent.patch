+<section class="settings__section">
+  <header>
+    <h2 class="divider">Billing</h2>
+  </header>
+
+  <div class="flex flex-column gap-half">
+    <div>Plan: <strong><%= Current.account.current_plan.name %></strong></div>
+
+    <% if Current.account.current_plan.upgradable? %>
+      <%= button_to "Upgrade", saas.account_checkout_path, params: { plan: Current.account.current_plan.free? ? "unlimited" : "unlimited_plus" }, class: "btn" %>
+    <% end %>
+
+    <% if Current.account.subscription&.stripe_customer_id.present? %>
+      <%= button_to "Manage billing", saas.account_billing_portal_path, class: "btn btn--reversed" %>
+    <% end %>
