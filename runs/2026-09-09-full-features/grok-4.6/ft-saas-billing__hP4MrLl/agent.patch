+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <p>
+      Plan: <strong><%= @account.current_plan.name %></strong>
+      <% if @account.comped? %>
+        (comped)
+      <% end %>
+    </p>
+    <p>Cards: <%= @account.billed_card_count %><% if @account.card_limit %> / <%= number_with_delimiter(@account.card_limit) %><% end %></p>
