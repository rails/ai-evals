diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..d2ee08f
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,118 @@
+class Account::Subscription < SaasRecord
+  belongs_to :account
+
+  PAID_STATUSES = %w[ active trialing past_due ].freeze
+
+  def paid?
+    PAID_STATUSES.include?(status) && plan_key.present? && plan_key != Plan.free.key
+  end
+
+  def plan
+    Plan.lookup(plan_key) || Plan.free
+  end
+
+  class << self
+    def process_event(event)
+      case event.type
+      when "checkout.session.completed"
+        sync_from_checkout_session(event.data.object)
+      when "customer.subscription.created", "customer.subscription.updated"
+        sync_from_stripe_subscription(event.data.object)
+      when "customer.subscription.deleted"
+        sync_from_deleted_subscription(event.data.object)
+      end
+    end
+
+    private
+      def sync_from_checkout_session(session)
+        account = find_account_from_checkout(session)
+        return unless account
+
+        subscription = account.subscription || account.build_subscription
+        subscription.update!(
+          stripe_customer_id: session.customer,
+          stripe_subscription_id: session.subscription,
+          plan_key: plan_key_from_checkout(session),
+          status: "active"
+        )
+      end
+
+      def sync_from_stripe_subscription(stripe_subscription)
+        record = find_or_build_for_stripe_subscription(stripe_subscription)
+        return unless record
+
+        record.update!(
+          stripe_customer_id: stripe_subscription.customer,
+          stripe_subscription_id: stripe_subscription.id,
+          plan_key: plan_key_from_stripe_subscription(stripe_subscription),
+          status: stripe_subscription.status,
+          current_period_end: timestamp(stripe_subscription.try(:current_period_end) || stripe_subscription.items&.data&.first&.try(:current_period_end)),
+          cancel_at: timestamp(stripe_subscription.try(:cancel_at)),
+          next_amount_due_in_cents: amount_due_from(stripe_subscription)
+        )
+      end
+
+      def sync_from_deleted_subscription(stripe_subscription)
+        record = find_by(stripe_subscription_id: stripe_subscription.id) || find_by(stripe_customer_id: stripe_subscription.customer)
+        return unless record
+
+        record.update!(
+          plan_key: Plan.free.key,
+          status: "canceled",
+          stripe_subscription_id: nil,
+          cancel_at: Time.current
+        )
+      end
+
+      def find_account_from_checkout(session)
+        account_id = session.client_reference_id.presence || metadata_value(session, :account_id)
+        Account.find_by(id: account_id) if account_id
+      end
+
+      def find_or_build_for_stripe_subscription(stripe_subscription)
+        if record = find_by(stripe_subscription_id: stripe_subscription.id) || find_by(stripe_customer_id: stripe_subscription.customer)
+          record
+        elsif account = account_from_stripe_subscription(stripe_subscription)
+          account.subscription || account.build_subscription
+        end
+      end
+
+      def account_from_stripe_subscription(stripe_subscription)
+        account_id = metadata_value(stripe_subscription, :account_id)
+        Account.find_by(id: account_id) if account_id
+      end
+
+      def plan_key_from_checkout(session)
+        plan_key_from(metadata_value(session, :plan_key), nil)
+      end
+
+      def plan_key_from_stripe_subscription(stripe_subscription)
+        price_id = stripe_subscription.items&.data&.first&.price&.id
+        plan_key_from(metadata_value(stripe_subscription, :plan_key), price_id)
+      end
+
+      def plan_key_from(explicit_key, price_id)
+        plan = Plan.lookup(explicit_key.presence || price_id)
+        (plan || Plan.free).key
+      end
+
+      def metadata_value(object, key)
+        metadata = object.try(:metadata)
+        return if metadata.blank?
+
+        metadata.public_send(key) if metadata.respond_to?(key)
+      rescue NoMethodError
+        metadata[key] || metadata[key.to_s]
+      end
+
+      def timestamp(value)
+        if value.present?
+          Time.at(value).utc
+        end
+      end
+
+      def amount_due_from(stripe_subscription)
+        stripe_subscription.items&.data&.first&.price&.unit_amount
+      end
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..dfd18a9
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,92 @@
+class Plan
+  attr_reader :key, :name, :price_cents, :card_limit, :storage_limit, :price_env, :aliases, :queenbee_name
+
+  def initialize(key:, name:, price_cents:, card_limit:, storage_limit:, price_env: nil, aliases: [], queenbee_name:)
+    @key = key
+    @name = name
+    @price_cents = price_cents
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @price_env = price_env
+    @aliases = aliases
+    @queenbee_name = queenbee_name
+  end
+
+  def stripe_price_id
+    ENV[price_env] if price_env
+  end
+
+  def free?
+    key == "free"
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def upgradable?
+    key != "unlimited_plus"
+  end
+
+  def matches?(identifier)
+    return false if identifier.blank?
+
+    id = identifier.to_s
+    key == id || name == id || aliases.include?(id)
+  end
+
+  class << self
+    def all
+      [ free, unlimited, unlimited_plus ]
+    end
+
+    def free
+      @free ||= new(
+        key: "free",
+        name: "Free",
+        price_cents: 0,
+        card_limit: 1_000,
+        storage_limit: 1.gigabyte,
+        aliases: %w[ FreeV1 ],
+        queenbee_name: "FreeV1"
+      )
+    end
+
+    def unlimited
+      @unlimited ||= new(
+        key: "unlimited",
+        name: "Unlimited",
+        price_cents: 20_00,
+        card_limit: nil,
+        storage_limit: 5.gigabytes,
+        price_env: "STRIPE_MONTHLY_V1_PRICE_ID",
+        aliases: %w[ monthly_v1 UnlimitedV1 ],
+        queenbee_name: "UnlimitedV1"
+      )
+    end
+
+    def unlimited_plus
+      @unlimited_plus ||= new(
+        key: "unlimited_plus",
+        name: "Unlimited+",
+        price_cents: 25_00,
+        card_limit: nil,
+        storage_limit: 500.gigabytes,
+        price_env: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID",
+        aliases: %w[ monthly_extra_storage_v1 UnlimitedPlusV1 ],
+        queenbee_name: "UnlimitedPlusV1"
+      )
+    end
+
+    def lookup(identifier)
+      return free if identifier.blank?
+
+      all.find { |plan| plan.matches?(identifier) } ||
+        all.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == identifier.to_s }
+    end
+
+    def fetch(identifier)
+      lookup(identifier) || raise(ArgumentError, "Unknown plan: #{identifier}")
+    end
+  end
+end
