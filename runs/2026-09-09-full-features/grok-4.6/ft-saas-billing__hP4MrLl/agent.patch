diff --git a/saas/app/models/account/billed.rb b/saas/app/models/account/billed.rb
new file mode 100644
index 0000000..eac2793
--- /dev/null
+++ b/saas/app/models/account/billed.rb
@@ -0,0 +1,141 @@
+module Account::Billed
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+
+    set_callback :cancel, :after, :cancel_stripe_subscription
+  end
+
+  def current_plan
+    if comped?
+      Plan.unlimited_plus
+    elsif subscription&.paid?
+      subscription.plan
+    else
+      Plan.free
+    end
+  end
+
+  def active_subscription
+    subscription if subscription&.paid?
+  end
+
+  def card_limit
+    current_plan.card_limit
+  end
+
+  def billed_card_count
+    if overridden_limit && !overridden_limit.card_count.nil?
+      overridden_limit.card_count
+    else
+      cards.count
+    end
+  end
+
+  def billed_bytes_used
+    if overridden_limit && !overridden_limit.bytes_used.nil?
+      overridden_limit.bytes_used
+    else
+      bytes_used
+    end
+  end
+
+  def exceeding_card_limit?
+    card_limit.present? && billed_card_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    card_limit.present? && !exceeding_card_limit? && billed_card_count >= card_limit - CARD_LIMIT_WARNING_THRESHOLD
+  end
+
+  def cards_remaining
+    if card_limit
+      [ card_limit - billed_card_count, 0 ].max
+    end
+  end
+
+  def comped?
+    billing_waiver&.persisted?
+  end
+
+  def comp
+    create_billing_waiver! unless billing_waiver
+  end
+
+  def uncomp
+    billing_waiver&.destroy
+    association(:billing_waiver).reset
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    attributes = {
+      card_count: integer_or_nil(card_count),
+      bytes_used: integer_or_nil(bytes_used)
+    }
+
+    if overridden_limit
+      overridden_limit.update!(attributes)
+    else
+      create_overridden_limit!(attributes)
+    end
+  end
+
+  def reset_overridden_limits
+    overridden_limit&.destroy
+    association(:overridden_limit).reset
+  end
+
+  def create_checkout_session(plan:, success_url:, cancel_url:)
+    Stripe::Checkout::Session.create(
+      mode: "subscription",
+      customer: ensure_stripe_customer,
+      line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+      success_url: success_url,
+      cancel_url: cancel_url,
+      client_reference_id: id,
+      metadata: { account_id: id, plan_key: plan.key },
+      subscription_data: { metadata: { account_id: id, plan_key: plan.key } }
+    )
+  end
+
+  def create_billing_portal_session(return_url:)
+    Stripe::BillingPortal::Session.create(
+      customer: subscription.stripe_customer_id,
+      return_url: return_url
+    )
+  end
+
+  private
+    def integer_or_nil(value)
+      value.presence && value.to_i
+    end
+
+    def ensure_stripe_customer
+      if subscription&.stripe_customer_id.present?
+        subscription.stripe_customer_id
+      else
+        customer = Stripe::Customer.create(
+          name: name,
+          email: owner_email,
+          metadata: { account_id: id }
+        )
+        (subscription || build_subscription(plan_key: Plan.free.key, status: "free")).update!(
+          stripe_customer_id: customer.id
+        )
+        customer.id
+      end
+    end
+
+    def cancel_stripe_subscription
+      if subscription&.stripe_subscription_id.present? && Stripe.api_key.present?
+        Stripe::Subscription.cancel(subscription.stripe_subscription_id)
+      end
+    rescue Stripe::StripeError => error
+      Rails.error.report(error)
+    end
+end
