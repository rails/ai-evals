+require "test_helper"
+
+class Account::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  test "admin is redirected to stripe checkout" do
+    sign_in_as :mike
+
+    Stripe::Customer.stubs(:create).returns(stub(id: "cus_test"))
+    Stripe::Checkout::Session.stubs(:create).returns(stub(url: "https://checkout.stripe.com/test-session"))
+
+    post saas.account_checkout_path(script_name: accounts(:initech).slug), params: { plan: "unlimited" }
+
+    assert_redirected_to "https://checkout.stripe.com/test-session"
+  end
+
+  test "non-admin cannot start checkout" do
+    users(:mike).update!(role: :member)
+    sign_in_as :mike
+
+    post saas.account_checkout_path(script_name: accounts(:initech).slug), params: { plan: "unlimited" }
+
+    assert_response :forbidden
+  end
+end
