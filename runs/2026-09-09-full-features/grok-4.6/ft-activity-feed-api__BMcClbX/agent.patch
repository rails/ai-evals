+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,217 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns newest activity first" do
+    get activities_path, as: :json
+    assert_response :success
+
+    ids = @response.parsed_body.map { |event| event["id"] }
+    expected_ids = users(:kevin).activities.limit(ids.size).map(&:id)
+
+    assert_equal expected_ids, ids
+    assert_equal events(:layout_assignment_jz).id, ids.first
+  end
+
+  test "index as JSON includes the expected event fields" do
+    event = events(:layout_assignment_jz)
+
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal event.id, json["id"]
+    assert_equal "card_assigned", json["action"]
+    assert_equal event.created_at.utc.as_json, json["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, json["description"]
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, json["particulars"])
+    assert_equal polymorphic_url(event.eventable), json["url"]
+    assert_equal "Card", json["eventable_type"]
+    assert_equal event.eventable.id, json["eventable"]["id"]
+    assert_equal event.eventable.number, json["eventable"]["number"]
+    assert_equal event.board.id, json["board"]["id"]
+    assert_equal event.creator.id, json["creator"]["id"]
+  end
+
+  test "index as JSON uses comment URLs that jump to the comment" do
+    event = events(:layout_commented)
+
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal "Comment", json["eventable_type"]
+    assert_equal polymorphic_url(event.eventable), json["url"]
+    assert_includes json["url"], "#comment_#{event.eventable.id}"
+    assert_equal event.eventable.id, json["eventable"]["id"]
+    assert json["eventable"]["body"]
+  end
+
+  test "index as JSON omits deprecated card_collection_changed events" do
+    event = boards(:writebook).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_collection_changed",
+      created_at: Time.current
+    )
+
+    get activities_path, as: :json
+    ids = @response.parsed_body.map { |item| item["id"] }
+
+    assert_not_includes ids, event.id
+  end
+
+  test "index as JSON includes card_title_changed events" do
+    event = boards(:writebook).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "logo", new_title: "New logo" } },
+      created_at: Time.current
+    )
+
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert json.present?
+    assert_equal "card_title_changed", json["action"]
+    assert_equal({ "old_title" => "logo", "new_title" => "New logo" }, json["particulars"])
+  end
+
+  test "index as JSON returns empty particulars for events without details" do
+    get activities_path, as: :json
+    json = @response.parsed_body.find { |item| item["id"] == events(:logo_published).id }
+
+    assert_equal({}, json["particulars"])
+  end
+
+  test "index as JSON returns empty strings for missing board title and column values" do
+    board_event = boards(:writebook).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_board_changed",
+      particulars: {},
+      created_at: Time.current
+    )
+    title_event = boards(:writebook).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_title_changed",
+      particulars: {},
+      created_at: Time.current
+    )
+    triage_event = boards(:writebook).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_triaged",
+      particulars: {},
+      created_at: Time.current
+    )
+
+    get activities_path, as: :json
+    body = @response.parsed_body.index_by { |item| item["id"] }
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, body[board_event.id]["particulars"])
+    assert_equal({ "old_title" => "", "new_title" => "" }, body[title_event.id]["particulars"])
+    assert_equal({ "column" => "" }, body[triage_event.id]["particulars"])
+  end
+
+  test "index as JSON exposes board change and triage particulars" do
+    board_event = boards(:writebook).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_board_changed",
+      particulars: { particulars: { old_board: "Writebook", new_board: "Private board" } },
+      created_at: Time.current
+    )
+    triage_event = boards(:writebook).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_triaged",
+      particulars: { particulars: { column: "In Progress" } },
+      created_at: 1.second.ago
+    )
+
+    get activities_path, as: :json
+    body = @response.parsed_body.index_by { |item| item["id"] }
+
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, body[board_event.id]["particulars"])
+    assert_equal({ "column" => "In Progress" }, body[triage_event.id]["particulars"])
+  end
+
+  test "index as JSON can filter by creator_ids" do
+    get activities_path, as: :json, params: { creator_ids: [ users(:kevin).id ] }
+    assert_response :success
+
+    creator_ids = @response.parsed_body.map { |item| item["creator"]["id"] }.uniq
+    assert_equal [ users(:kevin).id ], creator_ids
+  end
+
+  test "index as JSON can filter by board_ids" do
+    private_event = boards(:private).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_published",
+      created_at: Time.current
+    )
+
+    get activities_path, as: :json, params: { board_ids: [ boards(:writebook).id ] }
+    assert_response :success
+
+    board_ids = @response.parsed_body.map { |item| item["board"]["id"] }.uniq
+    assert_equal [ boards(:writebook).id ], board_ids
+    assert_not_includes @response.parsed_body.map { |item| item["id"] }, private_event.id
+  end
+
+  test "index as JSON only returns activity the current user can access" do
+    private_event = boards(:private).events.create!(
+      creator: users(:kevin),
+      eventable: cards(:logo),
+      action: "card_published",
+      created_at: Time.current
+    )
+
+    get activities_path, as: :json
+    assert_includes @response.parsed_body.map { |item| item["id"] }, private_event.id
+
+    logout_and_sign_in_as :david
+    get activities_path, as: :json
+    assert_not_includes @response.parsed_body.map { |item| item["id"] }, private_event.id
+  end
+
+  test "index as JSON paginates newest first" do
+    16.times do |index|
+      boards(:writebook).events.create!(
+        creator: users(:kevin),
+        eventable: cards(:logo),
+        action: "card_published",
+        created_at: index.minutes.ago
+      )
+    end
+
+    expected_ids = users(:kevin).activities.map(&:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.map { |event| event["id"] })
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      return unless link_header
+
+      link_header[/<(.*)>; rel="next"/, 1]
+    end
+end
diff --git a/test/models/event/particulars_test.rb b/test/models/event/particulars_test.rb
