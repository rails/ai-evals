diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..bff55fc 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,28 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def api_particulars
+    case action.to_s
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: particular_detail("old_board"), new_board: particular_detail("new_board") }
+    when "card_title_changed"
+      { old_title: particular_detail("old_title"), new_title: particular_detail("new_title") }
+    when "card_triaged"
+      { column: particular_detail("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    def particular_detail(name)
+      hash = (particulars || {}).with_indifferent_access
+      nested = hash[:particulars]
+      nested = nested.with_indifferent_access if nested.is_a?(Hash)
+      value = (nested.is_a?(Hash) && nested[name]) || hash[name]
+      value.nil? ? "" : value
+    end
 end
