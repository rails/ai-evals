index 0000000..a694018
--- /dev/null
+++ b/docs/api/sections/activities.md
@@ -0,0 +1,64 @@
+# Activities
+
+Account activity is the same stream of events shown on the HTML timeline: cards being published, assigned, moved, commented on, and so on.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activity the current user can access, newest first.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the user ID(s) who created the activity |
+| `board_ids[]` | Filter by board ID(s) |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5vaeq985jlvwv3arl4srq2",
+    "action": "card_published",
+    "created_at": "2025-12-05T19:38:48.553Z",
+    "description": "David added \"First!\"",
+    "particulars": {},
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/4",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5vaeq985jlvwv3arl4srq2",
+      "number": 1,
+      "title": "First!"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson"
+    }
+  }
+]
+```
+
+`eventable`, `board`, and `creator` use the same representations as the rest of the API. `description` is the plain-text form of the event.
+
+For card events, `url` opens the card. For comment events, `url` opens the card where the comment was posted and jumps to that comment.
+
+The following actions are included:
+
+`card_assigned`, `card_unassigned`, `card_published`, `card_closed`, `card_reopened`, `card_board_changed`, `card_title_changed`, `card_postponed`, `card_auto_postponed`, `card_triaged`, `card_sent_back_to_triage`, `comment_created`
+
+Deprecated `card_collection_changed` events are omitted.
+
+### Particulars
+
+The `particulars` object exposes event-specific details. Other events return an empty object. Missing board, title, or column values are returned as empty strings.
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `{ "assignee_ids": ["..."] }` |
+| `card_board_changed` | `{ "old_board": "Old name", "new_board": "New name" }` |
+| `card_title_changed` | `{ "old_title": "Old title", "new_title": "New title" }` |
+| `card_triaged` | `{ "column": "In Progress" }` |
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..4a89fa5
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,181 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON returns a flat array of accessible activity" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert @response.parsed_body.any? { |event| event["id"] == events(:logo_published).id }
+    assert @response.parsed_body.any? { |event| event["id"] == events(:layout_commented).id }
+  end
+
+  test "index as JSON returns newest activity first" do
+    get activities_path, as: :json
+
+    created_ats = @response.parsed_body.map { |event| event["created_at"] }
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "index as JSON includes the activity attributes" do
+    get activities_path, as: :json
+
+    event = events(:logo_published)
+    json = @response.parsed_body.find { |entry| entry["id"] == event.id }
+
+    assert_equal event.action, json["action"]
+    assert_equal event.created_at.utc.as_json, json["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, json["description"]
+    assert_equal({}, json["particulars"])
+    assert_equal card_url(cards(:logo)), json["url"]
+    assert_equal "Card", json["eventable_type"]
+    assert_equal cards(:logo).id, json.dig("eventable", "id")
+    assert_equal cards(:logo).number, json.dig("eventable", "number")
+    assert_equal boards(:writebook).id, json.dig("board", "id")
+    assert_equal users(:david).id, json.dig("creator", "id")
+    assert_equal %w[id action created_at description particulars url eventable_type eventable board creator], json.keys
+  end
+
+  test "index as JSON uses the comment URL that jumps to the comment" do
+    get activities_path, as: :json
+
+    event = events(:layout_commented)
+    json = @response.parsed_body.find { |entry| entry["id"] == event.id }
+    comment = comments(:layout_overflowing_david)
+
+    assert_equal "Comment", json["eventable_type"]
+    assert_equal comment.id, json.dig("eventable", "id")
+    assert_equal polymorphic_url(comment), json["url"]
+    assert_includes json["url"], "#comment_#{comment.id}"
+  end
+
+  test "index as JSON omits deprecated card_collection_changed events" do
+    event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: cards(:logo),
+      action: "card_collection_changed",
+      particulars: { particulars: { old_collection: "Old", new_collection: "New" } }
+    )
+
+    get activities_path, as: :json
+
+    assert @response.parsed_body.none? { |entry| entry["id"] == event.id }
+  end
+
+  test "index as JSON includes card_title_changed events" do
+    event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: cards(:logo),
+      action: "card_title_changed",
+      particulars: { particulars: { old_title: "Old title", new_title: "New title" } }
+    )
+
+    get activities_path, as: :json
+
+    json = @response.parsed_body.find { |entry| entry["id"] == event.id }
+    assert_not_nil json
+    assert_equal "card_title_changed", json["action"]
+    assert_equal({ "old_title" => "Old title", "new_title" => "New title" }, json["particulars"])
+  end
+
+  test "index as JSON exposes assignment particulars" do
+    get activities_path, as: :json
+
+    json = @response.parsed_body.find { |entry| entry["id"] == events(:logo_assignment_jz).id }
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, json["particulars"])
+  end
+
+  test "index as JSON exposes board change particulars and empty strings for missing values" do
+    event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: cards(:logo),
+      action: "card_board_changed",
+      particulars: { particulars: { new_board: "Writebook" } }
+    )
+
+    get activities_path, as: :json
+
+    json = @response.parsed_body.find { |entry| entry["id"] == event.id }
+    assert_equal({ "old_board" => "", "new_board" => "Writebook" }, json["particulars"])
+  end
+
+  test "index as JSON exposes triage particulars" do
+    event = Event.create!(
+      board: boards(:writebook),
+      creator: users(:david),
+      eventable: cards(:logo),
+      action: "card_triaged",
+      particulars: { particulars: { column: "In Progress" } }
+    )
+
+    get activities_path, as: :json
+
+    json = @response.parsed_body.find { |entry| entry["id"] == event.id }
+    assert_equal({ "column" => "In Progress" }, json["particulars"])
+  end
+
+  test "index as JSON can filter by creator_ids" do
+    get activities_path, as: :json, params: { creator_ids: [ users(:kevin).id ] }
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |entry| entry.dig("creator", "id") == users(:kevin).id }
+  end
+
+  test "index as JSON can filter by board_ids" do
+    Current.session = sessions(:kevin)
+    private_card = boards(:private).cards.create!(title: "Secret work", creator: users(:kevin), status: :published)
+    private_event = private_card.events.find_by!(action: "card_published")
+
+    get activities_path, as: :json, params: { board_ids: [ boards(:private).id ] }
+
+    assert_response :success
+    assert_equal [ private_event.id ], @response.parsed_body.map { |entry| entry["id"] }
+  end
+
+  test "index as JSON does not return activity from boards the user cannot access" do
+    Current.session = sessions(:kevin)
+    boards(:private).cards.create!(title: "Secret work", creator: users(:kevin), status: :published)
+
+    logout_and_sign_in_as :david
+    get activities_path, as: :json
+
+    assert_response :success
+    assert @response.parsed_body.none? { |entry| entry.dig("board", "id") == boards(:private).id }
+  end
+
+
+test "index as JSON ignores board_ids the user cannot access" do
+  logout_and_sign_in_as :david
+
+  get activities_path, as: :json, params: { board_ids: [ boards(:private).id ] }
+
+  assert_response :success
+  assert_equal [], @response.parsed_body
+end
+  test "index as JSON paginates with a next link" do
+    20.times do |index|
+      Event.create!(
+        board: boards(:writebook),
+        creator: users(:david),
+        eventable: cards(:logo),
+        action: "card_published",
+        created_at: index.minutes.ago
+      )
+    end
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_operator @response.parsed_body.size, :<=, 15
+    assert_match(/rel="next"/, @response.headers["Link"])
+  end
+end
diff --git a/test/models/event/particulars_test.rb b/test/models/event/particulars_test.rb
