+++ b/test/models/event/particulars_test.rb
@@ -0,0 +1,40 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "assignment events expose assignee_ids" do
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, events(:logo_assignment_jz).api_particulars)
+  end
+
+  test "board changes expose old and new board names" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "A", "new_board" => "B" } })
+
+    assert_equal({ old_board: "A", new_board: "B" }, event.api_particulars)
+  end
+
+  test "title changes expose old and new titles" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "A", "new_title" => "B" } })
+
+    assert_equal({ old_title: "A", new_title: "B" }, event.api_particulars)
+  end
+
+  test "triage events expose the column" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_triaged", particulars: { "particulars" => { "column" => "In Progress" } })
+
+    assert_equal({ column: "In Progress" }, event.api_particulars)
+  end
+
+  test "missing board title and column values are empty strings" do
+    event = events(:logo_published)
+    event.update_columns(action: "card_board_changed", particulars: {})
+
+    assert_equal({ old_board: "", new_board: "" }, event.api_particulars)
+  end
+
+  test "other events expose an empty particulars object" do
+    assert_equal({}, events(:logo_published).api_particulars)
+    assert_equal({}, events(:layout_commented).api_particulars)
+  end
+end
