diff --git a/app/javascript/helpers/i18n_helpers.js b/app/javascript/helpers/i18n_helpers.js
new file mode 100644
index 0000000..8b493de
--- /dev/null
+++ b/app/javascript/helpers/i18n_helpers.js
@@ -0,0 +1,78 @@
+import { getMetaContent } from "helpers/meta_helpers"
+
+const STRINGS = {
+  en: {
+    lessThanAMinuteAgo: "Less than a minute ago",
+    yearAgo: "%{count} year ago",
+    yearsAgo: "%{count} years ago",
+    monthAgo: "%{count} month ago",
+    monthsAgo: "%{count} months ago",
+    weekAgo: "%{count} week ago",
+    weeksAgo: "%{count} weeks ago",
+    dayAgo: "%{count} day ago",
+    daysAgo: "%{count} days ago",
+    hourAgo: "%{count} hour ago",
+    hoursAgo: "%{count} hours ago",
+    minuteAgo: "%{count} minute ago",
+    minutesAgo: "%{count} minutes ago",
+    today: "today",
+    yesterday: "yesterday",
+    tomorrow: "tomorrow",
+    daysAgoShort: "%{count} days ago",
+    inDays: "in %{count} days",
+    todayCap: "Today",
+    day: "day",
+    days: "days",
+    stalledFor: "Stalled for",
+    pleaseFillOutThisField: "Please fill out this field",
+    actionIn: "%{action} in"
+  },
+  ja: {
+    lessThanAMinuteAgo: "1分未満前",
+    yearAgo: "%{count}年前",
+    yearsAgo: "%{count}年前",
+    monthAgo: "%{count}か月前",
+    monthsAgo: "%{count}か月前",
+    weekAgo: "%{count}週間前",
+    weeksAgo: "%{count}週間前",
+    dayAgo: "%{count}日前",
+    daysAgo: "%{count}日前",
+    hourAgo: "%{count}時間前",
+    hoursAgo: "%{count}時間前",
+    minuteAgo: "%{count}分前",
+    minutesAgo: "%{count}分前",
+    today: "今日",
+    yesterday: "昨日",
+    tomorrow: "明日",
+    daysAgoShort: "%{count}日前",
+    inDays: "%{count}日後",
+    todayCap: "今日",
+    day: "日",
+    days: "日",
+    stalledFor: "停滞して",
+    pleaseFillOutThisField: "この欄を入力してください",
+    actionIn: "%{action}まで"
+  }
+}
+
+export function currentLocale() {
+  return getMetaContent("locale") || document.documentElement.lang || "en"
+}
+
+export function dateLocale() {
+  const locale = currentLocale()
+  if (locale === "ja") return "ja-JP"
+  return "en-US"
+}
+
+export function t(key, interpolations = {}) {
+  const locale = currentLocale()
+  const table = STRINGS[locale] || STRINGS.en
+  let value = table[key] || STRINGS.en[key] || key
+
+  Object.keys(interpolations).forEach(name => {
+    value = value.replaceAll(`%{${name}}`, interpolations[name])
+  })
+
+  return value
+}
