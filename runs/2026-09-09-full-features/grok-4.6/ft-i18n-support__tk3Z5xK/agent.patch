diff --git a/test/controllers/locale_test.rb b/test/controllers/locale_test.rb
new file mode 100644
index 0000000..ed65cd9
--- /dev/null
+++ b/test/controllers/locale_test.rb
@@ -0,0 +1,63 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  test "pages render in English by default" do
+    untenanted do
+      get new_session_path
+    end
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_match "Get into Fizzy", response.body
+    assert_no_match "Fizzyに入る", response.body
+  end
+
+  test "opening a page with locale=ja switches to Japanese" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+    end
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_match "Fizzyに入る", response.body
+  end
+
+  test "locale choice sticks for the rest of the session" do
+    untenanted do
+      get new_session_path, params: { locale: "ja" }
+      get new_session_path
+    end
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_match "Fizzyに入る", response.body
+  end
+
+  test "an unknown locale does not switch or break the page" do
+    untenanted do
+      get new_session_path, params: { locale: "xx" }
+    end
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_match "Get into Fizzy", response.body
+  end
+
+  test "locale persists on the identity after sign in from a clean browser" do
+    identity = identities(:kevin)
+    identity.update!(locale: "ja")
+
+    sign_in_as :kevin
+
+    get root_path
+    assert_select "html[lang=ja]"
+  end
+
+  test "choosing a locale while signed in saves it on the identity" do
+    sign_in_as :kevin
+
+    get root_path, params: { locale: "ja" }
+
+    assert_equal "ja", identities(:kevin).reload.locale
+  end
+end
