diff --git a/app/controllers/concerns/set_locale.rb b/app/controllers/concerns/set_locale.rb
new file mode 100644
index 0000000..99692f8
--- /dev/null
+++ b/app/controllers/concerns/set_locale.rb
@@ -0,0 +1,43 @@
+module SetLocale
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_before_action :set_locale_from_request
+    before_action :set_locale_from_identity
+
+    etag { I18n.locale }
+  end
+
+  private
+    def set_locale_from_request
+      if locale = requested_locale
+        I18n.locale = locale
+        session[:locale] = locale
+      elsif locale = Locales.available(session[:locale])
+        I18n.locale = locale
+      else
+        I18n.locale = I18n.default_locale
+      end
+    end
+
+    def set_locale_from_identity
+      if locale = requested_locale
+        persist_locale_to_identity(locale)
+      elsif session[:locale].blank?
+        if locale = Locales.available(Current.identity&.locale)
+          I18n.locale = locale
+          session[:locale] = locale
+        end
+      end
+    end
+
+    def requested_locale
+      Locales.available(params[:locale])
+    end
+
+    def persist_locale_to_identity(locale)
+      if Current.identity && Current.identity.locale != locale
+        Current.identity.update(locale: locale)
+      end
+    end
+end
