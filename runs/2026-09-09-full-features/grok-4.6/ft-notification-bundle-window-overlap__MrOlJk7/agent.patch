+class NotificationMailer < ApplicationMailer
+  def bundle(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.preloaded.ordered
+
+    mail to: @user.identity.email_address, subject: subject_for(@notifications)
+  end
+
+  private
+    def subject_for(notifications)
+      count = notifications.size
+
+      if count == 1
+        notifications.first.payload.title
+      else
+        "#{count} new notifications on Fizzy"
+      end
+    end
+end
