+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:jz)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    @user.notifications.delete_all
+    @user.notification_bundles.delete_all
+  end
+
+  test "bundle" do
+    notification = Notification.create!(user: @user, source: events(:logo_published), creator: users(:david))
+    bundle = notification.bundle
+    email = NotificationMailer.bundle(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "jz@37signals.com" ], email.to
+    assert_match "The logo isn't big enough", email.subject
+    assert_match "The logo isn't big enough", email.body.encoded
+  end
+end
