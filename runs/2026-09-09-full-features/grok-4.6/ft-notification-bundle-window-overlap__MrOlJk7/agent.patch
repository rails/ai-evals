+
+  included do
+    belongs_to :bundle, class_name: "Notification::Bundle", optional: true, inverse_of: :notifications
+
+    after_save_commit :capture_in_bundle, if: :source_id_previously_changed?
+  end
+
+  def capture_in_bundle
+    Notification::Bundle.capture(self)
+  end
+end
diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..85b8503
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,87 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, dependent: :nullify, inverse_of: :bundle
+
+  after_create_commit :deliver_later
+
+  scope :covering, ->(time) { where("starts_at <= :time AND ends_at > :time", time: time) }
+  scope :overlapping, ->(starts_at, ends_at) {
+    where("starts_at < :ends_at AND ends_at > :starts_at", starts_at: starts_at, ends_at: ends_at)
+  }
+
+  validate :windows_must_not_overlap
+
+  class << self
+    def capture(notification)
+      if window = window_for(notification)
+        assign(notification, window)
+        window
+      end
+    end
+
+    private
+      def window_for(notification)
+        if duration = notification.user.settings&.bundle_email_window
+          notification.user.with_lock do
+            find_window(notification, duration) || open_window(notification, duration)
+          end
+        end
+      end
+
+      def find_window(notification, duration)
+        bundles = notification.user.notification_bundles
+        now = Time.current
+        created_at = notification.created_at
+        still_open = bundles.where("ends_at > ?", now)
+
+        still_open.covering(now).first ||
+          still_open.covering(created_at).first ||
+          still_open.overlapping(created_at, created_at + duration).order(:starts_at).first
+      end
+
+      def open_window(notification, duration)
+        start = notification.created_at
+
+        notification.user.notification_bundles.create!(starts_at: start, ends_at: start + duration)
+      end
+
+      def assign(notification, window)
+        if notification.bundle_id != window.id
+          notification.update_column(:bundle_id, window.id)
+          notification.association(:bundle).reset
+        end
+      end
+  end
+
+  def deliver_later
+    Notification::BundleJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver
+    return if delivered?
+
+    if deliverable?
+      NotificationMailer.bundle(self).deliver_now
+    end
+
+    update!(delivered_at: Time.current)
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  private
+    def deliverable?
+      notifications.any? && user&.active? && user.identity.present? && account&.active?
+    end
+
+    def windows_must_not_overlap
+      if user && starts_at && ends_at
+        if user.notification_bundles.where.not(id: id).overlapping(starts_at, ends_at).exists?
+          errors.add(:base, "overlaps an existing window")
+        end
+      end
+    end
+end
