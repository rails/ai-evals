diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..570e322
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,190 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:jz)
+    @user.notifications.delete_all
+    @user.notification_bundles.delete_all
+  end
+
+  test "never does not open a window" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      create_notification_for @user, source: events(:logo_published)
+    end
+  end
+
+  test "the clock starts when the first notification lands" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    now = Time.utc(2026, 7, 10, 12, 0, 0)
+
+    bundle = travel_to(now) do
+      create_notification_for @user, source: events(:logo_published)
+      Notification::Bundle.last
+    end
+
+    assert_equal now, bundle.starts_at
+    assert_equal now + 4.hours, bundle.ends_at
+    assert_equal @user, bundle.user
+  end
+
+  test "daily windows last one day" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    now = Time.utc(2026, 7, 10, 9, 0, 0)
+
+    bundle = travel_to(now) do
+      create_notification_for @user, source: events(:logo_published)
+      Notification::Bundle.last
+    end
+
+    assert_equal now + 1.day, bundle.ends_at
+  end
+
+  test "weekly windows last one week" do
+    @user.settings.update!(bundle_email_frequency: :weekly)
+    now = Time.utc(2026, 7, 10, 9, 0, 0)
+
+    bundle = travel_to(now) do
+      create_notification_for @user, source: events(:logo_published)
+      Notification::Bundle.last
+    end
+
+    assert_equal now + 1.week, bundle.ends_at
+  end
+
+  test "later notifications in the same window join it" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    now = Time.utc(2026, 7, 10, 12, 0, 0)
+
+    first, second = travel_to(now) do
+      [
+        create_notification_for(@user, source: events(:logo_published)),
+        create_notification_for(@user, source: events(:layout_published))
+      ]
+    end
+
+    travel_to(now + 1.hour) do
+      third = create_notification_for(@user, source: events(:text_published))
+
+      assert_equal 1, @user.notification_bundles.count
+      assert_equal first.bundle, second.reload.bundle
+      assert_equal first.bundle, third.reload.bundle
+    end
+  end
+
+  test "a new window opens after the previous one ends" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    now = Time.utc(2026, 7, 10, 12, 0, 0)
+
+    first = travel_to(now) { create_notification_for @user, source: events(:logo_published) }
+    second = travel_to(now + 4.hours) { create_notification_for @user, source: events(:layout_published) }
+
+    assert_equal 2, @user.notification_bundles.count
+    assert_not_equal first.bundle, second.bundle
+    assert_equal now + 4.hours, second.bundle.starts_at
+  end
+
+  test "late notifications belong in the window that has already opened" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    now = Time.utc(2026, 7, 10, 12, 0, 0)
+
+    first = travel_to(now) { create_notification_for @user, source: events(:logo_published) }
+
+    late = travel_to(now - 30.minutes) do
+      create_notification_for @user, source: events(:layout_published)
+    end
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal first.reload.bundle, late.reload.bundle
+    assert_equal now, first.bundle.starts_at
+  end
+
+  test "nobody ends up with two overlapping windows" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    now = Time.utc(2026, 7, 10, 12, 0, 0)
+
+    travel_to(now) { create_notification_for @user, source: events(:logo_published) }
+    travel_to(now + 1.hour) { create_notification_for @user, source: events(:layout_published) }
+    travel_to(now - 1.hour) { create_notification_for @user, source: events(:text_published) }
+    travel_to(now + 4.hours) { create_notification_for @user, source: events(:shipping_published) }
+
+    windows = @user.notification_bundles.reload.to_a
+    windows.combination(2).each do |left, right|
+      overlap = left.starts_at < right.ends_at && right.starts_at < left.ends_at
+      assert_not overlap, "windows #{left.starts_at}-#{left.ends_at} and #{right.starts_at}-#{right.ends_at} overlap"
+    end
+  end
+
+  test "each person has their own windows" do
+    kevin = users(:kevin)
+    kevin.notifications.delete_all
+    kevin.notification_bundles.delete_all
+    kevin.settings.update!(bundle_email_frequency: :daily)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+
+    jz_notification = create_notification_for @user, source: events(:logo_published)
+    kevin_notification = create_notification_for kevin, source: events(:logo_published)
+
+    assert_not_equal jz_notification.bundle, kevin_notification.bundle
+    assert_equal 4.hours, jz_notification.bundle.ends_at - jz_notification.bundle.starts_at
+    assert_equal 1.day, kevin_notification.bundle.ends_at - kevin_notification.bundle.starts_at
+  end
+
+  test "validation rejects overlapping windows" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    now = Time.utc(2026, 7, 10, 12, 0, 0)
+
+    travel_to(now) { create_notification_for @user, source: events(:logo_published) }
+    existing = @user.notification_bundles.last
+
+    bundle = @user.notification_bundles.build(
+      starts_at: existing.starts_at + 1.hour,
+      ends_at: existing.ends_at + 1.hour
+    )
+
+    assert_not bundle.valid?
+    assert_includes bundle.errors[:base], "overlaps an existing window"
+  end
+
+  test "schedules one email delivery at the end of the window" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    now = Time.utc(2026, 7, 10, 12, 0, 0)
+
+    travel_to(now) do
+      create_notification_for @user, source: events(:logo_published)
+    end
+
+    bundle = Notification::Bundle.last
+    job = enqueued_jobs.find { |enqueued| enqueued[:job] == Notification::BundleJob }
+
+    assert_not_nil job
+    assert_equal bundle.ends_at.to_i, job[:at].to_i
+  end
+
+  test "sends one email for the window" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    now = Time.utc(2026, 7, 10, 12, 0, 0)
+
+    travel_to(now) do
+      create_notification_for @user, source: events(:logo_published)
+      create_notification_for @user, source: events(:layout_published)
+    end
+
+    bundle = Notification::Bundle.last
+
+    assert_emails 1 do
+      travel_to(bundle.ends_at) { bundle.deliver }
+    end
+
+    assert bundle.reload.delivered?
+    assert_no_emails { bundle.deliver }
+  end
+
+  private
+    def create_notification_for(user, source:)
+      Notification.create!(user: user, source: source, creator: users(:david))
+    end
+end
