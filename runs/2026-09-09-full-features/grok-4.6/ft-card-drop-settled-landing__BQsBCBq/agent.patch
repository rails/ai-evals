diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..d28490b
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,137 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "item", "container" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  static get shouldLoad() {
+    return window.matchMedia("(min-width: 640px)").matches
+  }
+
+  #item = null
+  #source = null
+  #hovered = null
+
+  // Lifecycle
+
+  itemTargetConnected(item) {
+    item.draggable = true
+  }
+
+  // Actions
+
+  dragstart(event) {
+    const item = this.#itemFrom(event.target)
+    if (!item) return
+
+    this.#item = item
+    this.#source = this.#containerFrom(item)
+    item.classList.add(this.draggedItemClass)
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", item.id)
+    }
+  }
+
+  dragover(event) {
+    if (!this.#item) return
+
+    event.preventDefault()
+    if (event.dataTransfer) event.dataTransfer.dropEffect = "move"
+
+    const container = this.#droppableContainer(event.target)
+    if (container) {
+      this.#hover(container)
+    } else {
+      this.#clearHover()
+    }
+  }
+
+  drop(event) {
+    if (!this.#item) return
+
+    event.preventDefault()
+
+    const container = this.#droppableContainer(event.target)
+    if (!container || !this.#urlFor(this.#item, container)) return
+
+    this.#relocate(this.#item, container)
+    this.#persist(this.#item, container)
+  }
+
+  dragend() {
+    this.#item?.classList.remove(this.draggedItemClass)
+    this.#clearHover()
+    this.#item = null
+    this.#source = null
+  }
+
+  // Private
+
+  #itemFrom(element) {
+    const item = element.closest("[data-drag-and-drop-target~='item']")
+    return this.itemTargets.includes(item) ? item : null
+  }
+
+  #containerFrom(element) {
+    const container = element.closest("[data-drag-and-drop-target~='container']")
+    return this.containerTargets.includes(container) ? container : null
+  }
+
+  #droppableContainer(element) {
+    const container = this.#containerFrom(element)
+    if (!container || container === this.#source) return null
+    return container
+  }
+
+  #hover(container) {
+    if (this.#hovered === container) return
+
+    this.#clearHover()
+    container.classList.add(this.hoverContainerClass)
+    this.#hovered = container
+  }
+
+  #clearHover() {
+    this.#hovered?.classList.remove(this.hoverContainerClass)
+    this.#hovered = null
+  }
+
+  #relocate(item, container) {
+    const list = container.querySelector(".cards__list")
+    if (!list) return
+
+    list.prepend(item)
+    container.focus({ preventScroll: true })
+  }
+
+  #persist(item, container) {
+    const url = this.#urlFor(item, container)
+    const options = { responseKind: "json", keepalive: true }
+
+    switch (container.dataset.dropAction) {
+      case "stream":
+        destroy(url, options)
+        break
+      case "column":
+        post(url, { ...options, query: { column_id: container.dataset.columnId } })
+        break
+      default:
+        post(url, options)
+    }
+  }
+
+  #urlFor(item, container) {
+    switch (container.dataset.dropAction) {
+      case "not_now":
+        return item.dataset.cardNotNowUrl
+      case "closed":
+        return item.dataset.cardClosureUrl
+      case "stream":
+      case "column":
+        return item.dataset.cardTriageUrl
+    }
+  }
+}
