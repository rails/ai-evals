diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..075fbd5
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,106 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+    visit board_url(@board)
+    assert_selector "#maybe .card"
+    assert_selector "#closed-cards .cards__list", visible: :all
+    assert_selector "#not-now .cards__list", visible: :all
+  end
+
+  test "dragging a card to a column moves it immediately and persists" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+
+    assert_selector "#maybe ##{dom_id(card, :article)}"
+    assert_selector "##{dom_id(column)} .cards__list", visible: :all
+
+    html5_drag find("##{dom_id(card, :article)}"), find("##{dom_id(column)}")
+
+    assert_selector "##{dom_id(column)} ##{dom_id(card, :article)}"
+    assert_no_selector "#maybe ##{dom_id(card, :article)}"
+    assert_persisted { card.reload.column == column }
+  end
+
+  test "dragging a card to Done closes it immediately" do
+    card = cards(:buy_domain)
+
+    html5_drag find("##{dom_id(card, :article)}"), find("#closed-cards")
+
+    assert_selector "#closed-cards ##{dom_id(card, :article)}"
+    assert_persisted { card.reload.closed? }
+  end
+
+  test "dragging a card to Not Now postpones it immediately" do
+    card = cards(:buy_domain)
+
+    html5_drag find("##{dom_id(card, :article)}"), find("#not-now")
+
+    assert_selector "#not-now ##{dom_id(card, :article)}"
+    assert_persisted { card.reload.postponed? }
+  end
+
+  test "dragging a triaged card to another column moves it" do
+    card = cards(:logo)
+    source = card.column
+    destination = columns(:writebook_in_progress)
+
+    find("##{dom_id(source)} .cards__expander").click
+    assert_selector "##{dom_id(source)} ##{dom_id(card, :article)}"
+    assert_selector "##{dom_id(destination)} .cards__list", visible: :all
+
+    html5_drag find("##{dom_id(card, :article)}"), find("##{dom_id(destination)}")
+
+    assert_selector "##{dom_id(destination)} ##{dom_id(card, :article)}"
+    assert_persisted { card.reload.column == destination }
+  end
+
+  test "dragging a card back to Maybe sends it to triage" do
+    card = cards(:logo)
+    source = card.column
+
+    find("##{dom_id(source)} .cards__expander").click
+    assert_selector "##{dom_id(source)} ##{dom_id(card, :article)}"
+
+    html5_drag find("##{dom_id(card, :article)}"), find("#maybe")
+
+    assert_selector "#maybe ##{dom_id(card, :article)}"
+    assert_persisted { card.reload.awaiting_triage? }
+  end
+
+  test "dropping a card on its own column does not move it" do
+    card = cards(:buy_domain)
+
+    html5_drag find("##{dom_id(card, :article)}"), find("#maybe")
+
+    assert_selector "#maybe ##{dom_id(card, :article)}"
+    assert card.reload.awaiting_triage?
+  end
+
+  private
+    def assert_persisted(timeout: Capybara.default_max_wait_time)
+      deadline = Time.now + timeout
+      until Time.now > deadline
+        return if yield
+        sleep 0.05
+      end
+      flunk "timed out waiting for the card to persist"
+    end
+
+    def html5_drag(source, destination)
+      page.execute_script(<<~JS, source, destination)
+        const source = arguments[0]
+        const destination = arguments[1]
+        const dataTransfer = new DataTransfer()
+
+        source.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        destination.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+        destination.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+        source.dispatchEvent(new DragEvent("dragend", { bubbles: true, cancelable: true, dataTransfer }))
+      JS
+    end
+end
