diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..7432b81
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,159 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:buy_domain)
+  end
+
+  test "three comments from two people within a third of the auto-close period is a burst" do
+    freeze_time
+
+    comment @card, :david, "First"
+    comment @card, :kevin, "Second"
+    comment @card, :david, "Third"
+
+    assert @card.reload.last_burst_at
+    assert_equal Time.current, @card.last_burst_at
+  end
+
+  test "three comments from one person is not a burst" do
+    3.times { comment @card, :david, "Solo" }
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "two comments from two people is not a burst" do
+    comment @card, :david, "First"
+    comment @card, :kevin, "Second"
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "comments outside a third of the auto-close period are not a burst" do
+    entropies(:writebook_board).update! auto_postpone_period: 3.days
+
+    comment @card, :david, "First"
+    comment @card, :kevin, "Second"
+
+    travel 2.days
+    comment @card, :david, "Third"
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "system comments do not count toward a burst" do
+    3.times do
+      @card.comments.create!(body: "System", creator: users(:system))
+    end
+    comment @card, :david, "Human"
+    comment @card, :kevin, "Human too"
+
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "assigning someone records a burst" do
+    freeze_time
+
+    @card.toggle_assignment users(:kevin)
+
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "unassigning does not record a burst and resets a previous burst" do
+    @card.toggle_assignment users(:kevin)
+    assert @card.reload.last_burst_at
+
+    @card.toggle_assignment users(:kevin)
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "reopening records a burst" do
+    freeze_time
+    card = cards(:shipping)
+
+    card.reopen
+
+    assert_equal Time.current, card.reload.last_burst_at
+  end
+
+  test "a burst with no activity for two weeks is stalled" do
+    freeze_time
+    @card.toggle_assignment users(:kevin)
+
+    assert_not @card.reload.stalled?
+
+    travel 2.weeks
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "any activity resets a burst so the card is not stalled" do
+    freeze_time
+    @card.toggle_assignment users(:kevin)
+
+    comment @card, :david, "Still working"
+
+    assert_nil @card.reload.last_burst_at
+
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity on a stalled card resets it" do
+    freeze_time
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks
+    assert @card.reload.stalled?
+
+    comment @card, :david, "Back"
+
+    assert_not @card.reload.stalled?
+    assert_nil @card.last_burst_at
+  end
+
+  test "closed and postponed cards are not stalled" do
+    freeze_time
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks
+
+    @card.close
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.reopen
+    travel 2.weeks
+    assert @card.reload.stalled?
+
+    @card.postpone
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "indexed_by stalled" do
+    freeze_time
+    @card.toggle_assignment users(:kevin)
+    travel 2.weeks
+
+    assert_includes Card.indexed_by("stalled"), @card
+    assert_not_includes Card.indexed_by("stalled"), cards(:logo)
+  end
+
+  test "cache key changes when a card becomes stalled" do
+    freeze_time
+    @card.toggle_assignment users(:kevin)
+    fresh_key = @card.reload.cache_key_with_version
+
+    travel 2.weeks
+    stalled_key = @card.reload.cache_key_with_version
+
+    assert_not_equal fresh_key, stalled_key
+    assert_match %r{/stalled\z}, stalled_key
+  end
+
+  private
+    def comment(card, user, body)
+      with_current_user(user) { card.comments.create!(body: body) }
+    end
+end
