new file mode 100644
index 0000000..ddd02d1
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,43 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+  BURST_COMMENT_COUNT = 3
+  BURST_COMMENTER_COUNT = 2
+
+  included do
+    scope :stalled, -> { active.where.not(last_burst_at: nil).where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def stalled?
+    last_burst_at.present? && last_active_at <= STALL_PERIOD.ago && active?
+  end
+
+  def record_burst
+    now = Time.current
+    update!(last_active_at: now, last_burst_at: now)
+  end
+
+  def bursting_from_comments?
+    creator_ids = recent_burst_comment_creator_ids
+    creator_ids.size >= BURST_COMMENT_COUNT && creator_ids.uniq.size >= BURST_COMMENTER_COUNT
+  end
+
+  def cache_key_with_version
+    key = super
+    if stalled?
+      "#{key}/stalled"
+    else
+      key
+    end
+  end
+
+  private
+    def recent_burst_comment_creator_ids
+      comments.by_user.where(created_at: burst_comment_window.ago..).pluck(:creator_id)
+    end
+
+    def burst_comment_window
+      (auto_postpone_period / 3.0).seconds
+    end
+end
