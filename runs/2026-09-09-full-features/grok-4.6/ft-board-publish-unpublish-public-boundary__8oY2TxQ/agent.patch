+module PublicBoardScoped
+  extend ActiveSupport::Concern
+
+  included do
+    allow_unauthenticated_access
+    layout "public"
+
+    before_action :set_board
+  end
+
+  private
+    def set_board
+      publication = Board::Publication.find_by!(key: publication_key)
+      @board = Current.account.boards.find(publication.board_id)
+    end
+
+    def publication_key
+      params[:board_key] || params[:key]
+    end
+end
