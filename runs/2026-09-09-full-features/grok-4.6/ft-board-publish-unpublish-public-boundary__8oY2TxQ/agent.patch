diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..6071d88
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are unpublished by default" do
+    assert_not @board.published?
+    assert_nil @board.publication
+  end
+
+  test "publish creates a publication with a secret key" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      @board.publish
+    end
+
+    assert @board.published?
+    assert @board.publication.key.present?
+  end
+
+  test "publish is idempotent" do
+    @board.publish
+
+    assert_no_difference -> { Board::Publication.count } do
+      @board.publish
+    end
+  end
+
+  test "unpublish destroys the publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+    end
+
+    assert_not @board.published?
+  end
+
+  test "published scope" do
+    assert_not_includes Board.published, @board
+
+    @board.publish
+
+    assert_includes Board.published, @board
+  end
+
+  test "publishing touches the board" do
+    updated_at = @board.updated_at
+
+    travel 1.minute do
+      @board.publish
+    end
+
+    assert @board.reload.updated_at > updated_at
+  end
+end
