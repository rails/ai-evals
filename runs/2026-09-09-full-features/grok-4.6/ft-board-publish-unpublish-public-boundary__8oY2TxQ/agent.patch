@@ -0,0 +1,28 @@
+<%= turbo_frame_tag board, :publication do %>
+  <div class="margin-block-end">
+    <h2 class="divider txt-large">Public sharing</h2>
+    <p class="margin-none-block-start">Publish this board to generate a secret URL anyone can use to view it.</p>
+
+    <% if board.published? %>
+      <% url = public_board_url(board.publication.key) %>
+      <div class="flex align-center gap-half margin-block">
+        <input type="text" class="input flex-item-grow" value="<%= url %>" readonly>
+        <%= button_to_copy_to_clipboard(url) do %>
+          <%= icon_tag "copy-paste" %>
+          <span>Copy link</span>
+        <% end %>
+      </div>
+
+      <% if Current.user.can_administer_board?(board) %>
+        <%= button_to board_publication_path(board), method: :delete, class: "btn txt-small" do %>
+          <span>Unpublish board</span>
+        <% end %>
+      <% end %>
+    <% elsif Current.user.can_administer_board?(board) %>
+      <%= button_to board_publication_path(board), method: :post, class: "btn txt-small" do %>
+        <%= icon_tag "globe" %>
+        <span>Publish board</span>
+      <% end %>
+    <% end %>
+  </div>
+<% end %>
