@@ -0,0 +1,15 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  connect() {
+    if (this.#createdByCurrentUser) this.element.classList.add("reaction--deleteable")
+  }
+
+  toggle() {
+    if (this.#createdByCurrentUser) this.element.classList.toggle("expanded")
+  }
+
+  get #createdByCurrentUser() {
+    return this.element.dataset.creatorId === window.Current.user?.id
+  }
+}
