@@ -0,0 +1,23 @@
+class Reaction < ApplicationRecord
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  normalizes :content, with: -> { it.strip }
+
+  validates :content, presence: true, length: { maximum: 16 }
+
+  after_create_commit :broadcast_creation
+  after_destroy_commit :broadcast_destruction
+
+  delegate :card, to: :comment
+
+  private
+    def broadcast_creation
+      broadcast_append_to card, target: [ comment, :reactions ], partial: "cards/comments/reactions/reaction"
+    end
+
+    def broadcast_destruction
+      broadcast_remove_to card
+    end
+end
