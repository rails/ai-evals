+<div class="reactions" data-controller="reaction">
+  <div id="<%= dom_id(comment, :reactions) %>" class="reactions__list">
+    <%= render partial: "cards/comments/reactions/reaction", collection: comment.reactions, as: :reaction %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle" title="Add a reaction"
+      data-reaction-target="trigger" data-action="reaction#open">
+    <%= image_tag "boost-color.svg", alt: "" %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <%= form_with model: [ comment.card, comment, Reaction.new ], namespace: dom_id(comment), class: "reaction reaction__form", html: { hidden: true },
+        data: { reaction_target: "form", action: "turbo:submit-end->reaction#submitted keydown.esc->reaction#cancel:stop" } do |form| %>
+    <%= form.label :content, "Reaction", class: "reaction__form-label for-screen-reader" %>
+    <%= form.text_field :content, required: true, maxlength: 16, autocomplete: "off", class: "reaction__input input",
+          data: { reaction_target: "input" } %>
+    <%= form.button class: "reaction__submit-btn btn btn--circle borderless", title: "Add reaction" do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Confirm reaction</span>
+    <% end %>
+    <button type="button" class="reaction__cancel-btn btn btn--circle borderless" title="Cancel"
+        data-action="reaction#cancel">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel reaction</span>
+    </button>
+  <% end %>
+</div>
