@@ -0,0 +1,77 @@
+require "test_helper"
+
+class Cards::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@comment.card, @comment),
+        params: { reaction: { content: "🚀" } }, as: :turbo_stream
+    end
+
+    assert_response :no_content
+    assert_equal users(:kevin), Reaction.last.creator
+  end
+
+  test "create rejects more than sixteen characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@comment.card, @comment),
+        params: { reaction: { content: "12345678901234567" } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create scopes the comment to the card" do
+    other_card = cards(:layout)
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(other_card, @comment),
+        params: { reaction: { content: "🚀" } }, as: :turbo_stream
+    end
+
+    assert_response :not_found
+  end
+
+  test "destroy your own reaction" do
+    reaction = @comment.reactions.create!(content: "Done", creator: users(:kevin))
+
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :no_content
+  end
+
+  test "cannot destroy another person's reaction" do
+    reaction = @comment.reactions.create!(content: "Nice", creator: users(:jz))
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "card renders a reaction strip for every user comment" do
+    reaction = @comment.reactions.create!(content: "Looks good", creator: users(:jz))
+
+    get card_path(@comment.card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment)} .reactions[data-controller=reaction]" do
+      assert_select "##{dom_id(@comment, :reactions)}.reactions__list"
+      assert_select ".reactions__trigger[data-action=?] img[src*=?]", "reaction#open", "boost-color"
+      assert_select "form.reaction__form[hidden]" do
+        assert_select "input.reaction__input##{dom_id(@comment)}_reaction_content", maxlength: "16", required: "required"
+      end
+      assert_select "##{dom_id(reaction)}.reaction[data-creator-id=?]", users(:jz).id do
+        assert_select "span", text: "Looks good"
+        assert_select "form[action=?] [data-only-visible-to-you]", card_comment_reaction_path(@comment.card, @comment, reaction)
+      end
+    end
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..7562fa4
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "valid with content up to sixteen characters" do
+    reaction = @comment.reactions.new(content: "1234567890123456", creator: users(:kevin))
+
+    assert reaction.valid?
+  end
+
+  test "invalid with content longer than sixteen characters" do
+    reaction = @comment.reactions.new(content: "12345678901234567", creator: users(:kevin))
+
+    assert_not reaction.valid?
+    assert reaction.errors.added?(:content, :too_long, count: 16)
+  end
+
+  test "invalid when content is blank" do
+    reaction = @comment.reactions.new(content: "  ", creator: users(:kevin))
+
+    assert_not reaction.valid?
+    assert reaction.errors.added?(:content, :blank)
+  end
+
+  test "strips surrounding whitespace" do
+    reaction = @comment.reactions.create!(content: "  Ship it  ", creator: users(:kevin))
+
+    assert_equal "Ship it", reaction.content
+  end
+
+  test "account comes from comment" do
+    reaction = @comment.reactions.create!(content: "👍", creator: users(:kevin))
+
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "creation broadcasts an append to the comment reaction list" do
+    broadcasts = capture_turbo_stream_broadcasts(@comment.card) do
+      @comment.reactions.create!(content: "🚀", creator: users(:kevin))
+    end
+
+    assert_equal 1, broadcasts.size
+    assert_equal "append", broadcasts.first["action"]
+    assert_equal dom_id(@comment, :reactions), broadcasts.first["target"]
+  end
+
+  test "destruction broadcasts a removal" do
+    reaction = @comment.reactions.create!(content: "Done", creator: users(:kevin))
+
+    broadcasts = capture_turbo_stream_broadcasts(@comment.card) { reaction.destroy }
+
+    assert_equal 1, broadcasts.size
+    assert_equal "remove", broadcasts.first["action"]
+    assert_equal dom_id(reaction), broadcasts.first["target"]
+  end
+end
