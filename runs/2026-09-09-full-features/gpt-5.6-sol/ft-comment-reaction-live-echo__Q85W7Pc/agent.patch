--- /dev/null
+++ b/app/controllers/cards/reactions_controller.rb
@@ -0,0 +1,39 @@
+class Cards::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def create
+    reaction = @comment.reactions.create(reaction_params)
+
+    if reaction.persisted?
+      head :no_content
+    else
+      head :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+    head :no_content
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden unless Current.user == @reaction.creator
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
