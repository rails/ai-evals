diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..6a033cb
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago" do
+    account = create_account
+    account.cancel(initiated_by: account.system_user)
+    account.cancellation.update_column(:created_at, 31.days.ago)
+    user_ids = account.user_ids
+    join_code_id = account.join_code.id
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account.id)
+    assert_not User.where(id: user_ids).exists?
+    assert_not Account::JoinCode.exists?(join_code_id)
+  end
+
+  test "preserves active and recently cancelled accounts" do
+    travel_to Time.current.change(usec: 0) do
+      active_account = create_account
+      recently_cancelled_account = create_account
+      recently_cancelled_account.cancel(initiated_by: recently_cancelled_account.system_user)
+      recently_cancelled_account.cancellation.update_column(:created_at, 30.days.ago)
+
+      Account::IncinerateDueJob.perform_now
+
+      assert Account.exists?(active_account.id)
+      assert Account.exists?(recently_cancelled_account.id)
+    end
+  end
+
+  private
+    def create_account
+      Account.create!(name: "Incineration test").tap do |account|
+        account.users.create!(name: "System", role: :system)
+      end
+    end
+end
