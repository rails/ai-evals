diff --git a/script/benchmark_entropy_sweep.rb b/script/benchmark_entropy_sweep.rb
new file mode 100644
index 0000000..e21fe57
--- /dev/null
+++ b/script/benchmark_entropy_sweep.rb
@@ -0,0 +1,63 @@
+# Run with: RAILS_ENV=test bin/rails runner script/benchmark_entropy_sweep.rb
+
+require "benchmark"
+require Rails.root.join("test/test_helper")
+require "active_record/fixtures"
+
+ActiveRecord::FixtureSet.create_fixtures(
+  Rails.root.join("test/fixtures"),
+  %w[ accounts identities users boards entropies ]
+) if Board.none?
+
+CARD_COUNT = ENV.fetch("CARD_COUNT", 100_000).to_i
+BATCH_SIZE = 5_000
+MARKER = "entropy-sweep-benchmark"
+
+board = Board.joins(:account, :creator).first!
+account = board.account
+creator = board.creator
+now = Time.current
+period = board.auto_postpone_period
+first_number = Card.where(account: account).maximum(:number).to_i + 1
+
+rows = CARD_COUNT.times.map do |offset|
+  {
+    id: ActiveRecord::Type::Uuid.generate,
+    account_id: account.id,
+    board_id: board.id,
+    creator_id: creator.id,
+    created_at: now,
+    updated_at: now,
+    last_active_at: offset.even? ? now - period - 1.day : now,
+    number: first_number + offset,
+    status: "published",
+    title: MARKER
+  }
+end
+
+begin
+  puts "Inserting #{CARD_COUNT} cards..."
+  rows.each_slice(BATCH_SIZE) { |batch| Card.insert_all!(batch) }
+
+  joined = Card.due_to_be_postponed.where(title: MARKER)
+
+  puts "\nCandidate query plan:"
+  ActiveRecord::Base.connection.execute("EXPLAIN QUERY PLAN #{joined.to_sql}").each do |row|
+    puts row.fetch("detail")
+  end
+
+  candidate_time = Benchmark.realtime { puts "\nCandidates: #{joined.count}" }
+  iteration_time = Benchmark.realtime { joined.find_each { } }
+
+  ActiveJob::Base.queue_adapter.enqueued_jobs.clear
+  sweep_time = Benchmark.realtime { Card.auto_postpone_all_due }
+  enqueued_count = ActiveJob::Base.queue_adapter.enqueued_jobs.count do |job|
+    job.fetch(:job) == Card::AutoPostponeJob
+  end
+
+  puts "Candidate query:     #{candidate_time.round(3)}s"
+  puts "Candidate iteration: #{iteration_time.round(3)}s"
+  puts "Async sweep:         #{sweep_time.round(3)}s (#{enqueued_count} jobs)"
+ensure
+  Card.where(title: MARKER).delete_all
+end
diff --git a/test/jobs/card/auto_postpone_job_test.rb b/test/jobs/card/auto_postpone_job_test.rb
new file mode 100644
index 0000000..c51008c
--- /dev/null
+++ b/test/jobs/card/auto_postpone_job_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class Card::AutoPostponeJobTest < ActiveJob::TestCase
+  test "postpones a card that is still due" do
+    card = cards(:logo)
+    card.update!(last_active_at: card.auto_postpone_period.seconds.ago - 1.day)
+
+    Card::AutoPostponeJob.perform_now(card)
+
+    assert card.reload.postponed?
+  end
+
+  test "does not postpone a card that became active after it was queued" do
+    card = cards(:logo)
+    card.update!(last_active_at: Time.current)
+
+    Card::AutoPostponeJob.perform_now(card)
+
+    assert card.reload.active?
+  end
+
+  test "does not postpone an already postponed card" do
+    card = cards(:logo)
+    card.postpone(user: card.account.system_user)
+
+    assert_no_difference -> { card.events.count } do
+      Card::AutoPostponeJob.perform_now(card)
+    end
+  end
+end
