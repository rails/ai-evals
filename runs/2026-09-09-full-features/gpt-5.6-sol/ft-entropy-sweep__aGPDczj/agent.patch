new file mode 100644
index 0000000..0507399
--- /dev/null
+++ b/app/jobs/card/auto_postpone_job.rb
@@ -0,0 +1,11 @@
+class Card::AutoPostponeJob < ApplicationJob
+  limits_concurrency to: 1, key: ->(card) { card }
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(card)
+    if card.active? && card.entropy.auto_clean_at <= Time.current
+      card.auto_postpone(user: card.account.system_user)
+    end
+  end
+end
