--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,30 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    created = @push_subscription.new_record?
+    @push_subscription.update!(push_subscription_params.merge(user: @user))
+
+    render json: { id: @push_subscription.id }, status: created ? :created : :ok
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy!
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..528c13b
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,119 @@
+import { Controller } from "@hotwired/stimulus"
+import { destroy, post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details", "toggle" ]
+  static values = {
+    publicKey: String,
+    subscriptionsUrl: String
+  }
+
+  async connect() {
+    if (this.#isSupported) {
+      try {
+        this.registration = await navigator.serviceWorker.ready
+        this.subscription = await this.registration.pushManager.getSubscription()
+
+        if (this.subscription && Notification.permission === "granted") {
+          await this.#register(this.subscription)
+          this.#showOn()
+        } else {
+          this.#showOff(Notification.permission === "denied")
+        }
+      } catch (error) {
+        console.error("Unable to load push notification settings", error)
+        this.#showOff(true)
+      }
+    } else {
+      this.#showOff(true)
+      this.toggleTarget.disabled = true
+    }
+  }
+
+  async toggle() {
+    this.toggleTarget.disabled = true
+
+    try {
+      if (this.toggleTarget.checked) {
+        await this.#subscribe()
+      } else {
+        await this.#unsubscribe()
+      }
+    } catch (error) {
+      console.error("Unable to change push notification settings", error)
+      this.#showOff(Notification.permission === "denied")
+    } finally {
+      this.toggleTarget.disabled = false
+    }
+  }
+
+  async #subscribe() {
+    const permission = await Notification.requestPermission()
+
+    if (permission === "granted") {
+      this.subscription = await this.registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+      await this.#register(this.subscription)
+      this.#showOn()
+    } else {
+      this.#showOff(permission === "denied")
+    }
+  }
+
+  async #unsubscribe() {
+    if (this.subscription) {
+      await this.subscription.unsubscribe()
+      if (this.subscriptionId) await destroy(`${this.subscriptionsUrlValue}/${this.subscriptionId}`)
+      this.subscription = null
+      this.subscriptionId = null
+    }
+
+    this.#showOff(false)
+  }
+
+  async #register(subscription) {
+    const json = subscription.toJSON()
+    const response = await post(this.subscriptionsUrlValue, {
+      body: JSON.stringify({
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: json.keys.p256dh,
+          auth_key: json.keys.auth
+        }
+      }),
+      contentType: "application/json",
+      responseKind: "json"
+    })
+
+    if (!response.ok) throw new Error(`Push subscription registration failed (${response.statusCode})`)
+    this.subscriptionId = (await response.json).id
+  }
+
+  #showOn() {
+    this.element.classList.add("notifications--on")
+    this.toggleTarget.checked = true
+    this.#toggleDetails(false)
+  }
+
+  #showOff(showDetails) {
+    this.element.classList.remove("notifications--on")
+    this.toggleTarget.checked = false
+    this.#toggleDetails(showDetails)
+  }
+
+  #toggleDetails(visible) {
+    this.detailsTargets.forEach((element) => element.hidden = !visible)
+  }
+
+  get #isSupported() {
+    return this.hasPublicKeyValue && "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.publicKeyValue.length % 4) % 4)
+    const base64 = (this.publicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+}
