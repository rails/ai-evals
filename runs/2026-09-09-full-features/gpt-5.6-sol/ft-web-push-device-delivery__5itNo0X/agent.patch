--- /dev/null
+++ b/test/models/user/push_subscription_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  test "endpoint is unique" do
+    user = users(:david)
+    user.push_subscriptions.create!(endpoint: "https://push.example/one", p256dh_key: "p256dh", auth_key: "auth")
+    duplicate = user.push_subscriptions.new(endpoint: "https://push.example/one", p256dh_key: "other", auth_key: "other")
+
+    assert_not duplicate.valid?
+    assert duplicate.errors[:endpoint].present?
+  end
+
+  test "deliver sends notification payload with tray copy and account-scoped card URL" do
+    subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example/one", p256dh_key: "p256dh", auth_key: "auth")
+    notification = notifications(:layout_commented_kevin)
+    options = nil
+    WebPush.stubs(:payload_send).with { |**args| options = args }.returns(nil)
+
+    subscription.deliver(notification)
+
+    payload = JSON.parse(options[:message])
+    assert_equal event_notification_title(notification.source), payload["title"]
+    assert_equal event_notification_body(notification.source), payload["body"]
+    assert_equal notification.card.id, payload["tag"]
+    assert_equal card_url(notification.card, **Rails.application.config.action_mailer.default_url_options, script_name: notification.account.slug), payload["url"]
+    assert_equal subscription.endpoint, options[:endpoint]
+    assert_equal subscription.p256dh_key, options[:p256dh]
+    assert_equal subscription.auth_key, options[:auth]
+    assert_equal ENV["VAPID_PUBLIC_KEY"], options.dig(:vapid, :public_key)
+    assert_equal ENV["VAPID_PRIVATE_KEY"], options.dig(:vapid, :private_key)
+  end
+
