diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..64c3bc2
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    @card = cards(:text)
+    @card.comments.by_user.delete_all
+    Current.user = users(:david)
+  end
+
+  teardown do
+    Current.reset
+  end
+
+  test "three comments by two people within a third of the board auto-close period cause a burst" do
+    @card.board.auto_postpone_period = 30.days
+
+    travel_to Time.current.change(usec: 0) do
+      create_comment users(:david), 10.days.ago
+      create_comment users(:david), 5.days.ago
+      create_comment users(:kevin), Time.current
+
+      assert_equal Time.current, @card.reload.burst_at
+    end
+  end
+
+  test "three comments by one person do not cause a burst" do
+    travel_to Time.current.change(usec: 0) do
+      create_comment users(:david), 2.hours.ago
+      create_comment users(:david), 1.hour.ago
+      create_comment users(:david), Time.current
+
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "three comments outside a third of the board auto-close period do not cause a burst" do
+    @card.board.auto_postpone_period = 30.days
+
+    travel_to Time.current.change(usec: 0) do
+      create_comment users(:kevin), 10.days.ago - 1.second
+      create_comment users(:david), 1.day.ago
+      create_comment users(:kevin), Time.current
+
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "system comments do not count toward a burst" do
+    travel_to Time.current.change(usec: 0) do
+      create_comment users(:david), 2.hours.ago
+      create_comment users(:system), 1.hour.ago
+      create_comment users(:kevin), Time.current
+
+      assert_nil @card.reload.burst_at
+    end
+  end
+
+  test "assignment causes a burst" do
+    travel_to Time.current.change(usec: 0) do
+      @card.toggle_assignment users(:jz)
+
+      assert_equal Time.current, @card.reload.burst_at
+    end
+  end
+
+  test "reopening causes a burst" do
+    @card.close
+
+    travel_to Time.current.change(usec: 0) do
+      @card.reopen
+
+      assert_equal Time.current, @card.reload.burst_at
+    end
+  end
+
+  test "a card is stalled two weeks after its last activity following a burst" do
+    @card.update_columns burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago
+
+    assert_predicate @card.reload, :stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "cache key changes when a card becomes stalled" do
+    now = Time.current.change(usec: 0)
+    @card.update_columns burst_at: 3.weeks.ago, last_active_at: now - 2.weeks + 1.second
+
+    fresh_key = travel_to(now) { @card.reload.cache_key_with_version }
+    stalled_key = travel_to(now + 2.seconds) { @card.cache_key_with_version }
+
+    assert_not_equal fresh_key, stalled_key
+  end
+
+  test "activity resets a stalled card" do
+    @card.update_columns burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago
+    assert_predicate @card.reload, :stalled?
+
+    travel_to Time.current do
+      @card.track_event :moved
+    end
+
+    assert_not_predicate @card.reload, :stalled?
+  end
+
+  private
+    def create_comment(user, created_at)
+      @card.comments.create!(creator: user, created_at: created_at)
+    end
+end
