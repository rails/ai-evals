diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..82768ea
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,34 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { where.not(burst_at: nil).where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def stalled?
+    burst_at.present? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  def record_comment_activity(comment)
+    record_burst(comment.created_at) if comment_burst?(comment)
+  end
+
+  def record_event_activity(event)
+    record_burst(event.created_at) if event.action.in?(%w[ card_assigned card_reopened ])
+  end
+
+  private
+    def record_burst(at)
+      update!(burst_at: at)
+    end
+
+    def comment_burst?(comment)
+      comments_by_creator = comments.by_user
+        .where(created_at: (comment.created_at - auto_postpone_period / 3)..comment.created_at)
+        .group(:creator_id).count
+
+      comments_by_creator.many? && comments_by_creator.values.sum >= 3
+    end
+end
