diff --git a/app/models/account/data_transfer/card_archive.rb b/app/models/account/data_transfer/card_archive.rb
new file mode 100644
index 0000000..3c3b44a
--- /dev/null
+++ b/app/models/account/data_transfer/card_archive.rb
@@ -0,0 +1,34 @@
+class Account::DataTransfer::CardArchive
+  attr_reader :user
+
+  def initialize(user)
+    @user = user
+  end
+
+  def write_to(zip)
+    zip.add_file("manifest.json", JSON.generate(format: "fizzy-cards", version: 1, exported_at: Time.current.iso8601))
+
+    cards.includes(:comments).find_each do |card|
+      zip.add_file("cards/#{card.id}.json", JSON.pretty_generate(
+        card: card.attributes.merge("description" => card.description.to_html),
+        comments: card.comments.map { |comment| comment.attributes.merge("body" => comment.body.to_html) }
+      ))
+      attachment_records_for(card).each { |attachment| add_attachment(zip, card, attachment) }
+    end
+  end
+
+  private
+    def cards
+      user.accessible_cards.published.distinct
+    end
+
+    def attachment_records_for(card)
+      rich_texts = ActionText::RichText.where(record: [ card, *card.comments ])
+      ActiveStorage::Attachment.where(record: [ card, *rich_texts ]).includes(:blob)
+    end
+
+    def add_attachment(zip, card, attachment)
+      path = "cards/#{card.id}/attachments/#{attachment.blob.id}/#{attachment.filename.to_s.gsub(/[^0-9A-Za-z.()_ -]/, "_")}"
+      zip.add_file(path, compress: false) { |sink| attachment.blob.download { |chunk| sink.write(chunk) } }
+    end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..12ba651
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,220 @@
+class Account::DataTransfer::Importer
+  class InvalidArchive < StandardError; end
+
+  METADATA_LIMIT = 100.megabytes
+  UUID_PATTERN = /\A[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\z/i
+
+  attr_reader :transfer, :identity
+
+  def initialize(transfer)
+    @transfer = transfer
+    @identity = transfer.identity
+    @uploaded_keys = []
+  end
+
+  def import
+    @archive = BlobIO.new(transfer.file.blob)
+    @entries = read_entries
+    validate_manifest!
+
+    Account.transaction do
+      @account = create_account
+      import_records
+      connect_identity
+      upload_files
+      transfer.update!(account: @account)
+    end
+  rescue
+    remove_uploaded_files
+    raise
+  end
+
+  private
+    def read_entries
+      entries = ZipKit::FileReader.read_zip_structure(io: @archive)
+      raise InvalidArchive, "The archive contains duplicate paths" if entries.map(&:filename).uniq.size != entries.size
+      raise InvalidArchive, "The archive contains unsafe paths" if entries.any? { |entry| unsafe_path?(entry.filename) }
+
+      entries.index_by(&:filename)
+    rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::UnsupportedFeature => error
+      raise InvalidArchive, "The uploaded file is not a valid Fizzy archive (#{error.message})"
+    end
+
+    def unsafe_path?(path)
+      path.start_with?("/", "\\") || path.split(/[\\\/]/).include?("..") || path.include?("\0")
+    end
+
+    def validate_manifest!
+      manifest = parse_json(entry!("manifest.json"))
+      unless manifest["format"] == Account::DataTransfer::Archive::FORMAT && manifest["version"] == Account::DataTransfer::Archive::VERSION
+        raise InvalidArchive, "This is not a supported Fizzy account archive"
+      end
+    end
+
+    def create_account
+      source = account_attributes
+      @source_account_id = source.fetch("id")
+      Account.create!(name: source.fetch("name"), cards_count: source.fetch("cards_count", 0)).tap { |account| account.entropies.delete_all }
+    end
+
+    def account_attributes
+      entry = @entries.values.find { |candidate| candidate.filename.match?(%r{\Arecords/accounts/[^/]+\.json\z}) }
+      raise InvalidArchive, "The archive has no account record" unless entry
+
+      parse_json(entry)
+    end
+
+    def import_records
+      record_sets.each do |record_set|
+        next if record_set.model == Account || record_set.is_a?(Account::DataTransfer::ActiveStorage::FileRecordSet)
+
+        entries_for(record_set.model.table_name).each do |entry|
+          attributes = remap_attributes(record_set.model, parse_json(entry))
+          record_set.model.insert_all!([ attributes ])
+        rescue ActiveRecord::ActiveRecordError => error
+          raise InvalidArchive, "Could not restore #{record_set.model.table_name}: #{error.message}"
+        end
+      end
+    end
+
+    def record_sets
+      sets = []
+      Account::DataTransfer::Manifest.new(@account).each_record_set { |record_set| sets << record_set }
+      sets
+    end
+
+    def entries_for(table)
+      @entries.values.select { |entry| entry.filename.match?(%r{\Arecords/#{Regexp.escape(table)}/[^/]+\.json\z}) }.sort_by(&:filename)
+    end
+
+    def remap_attributes(model, attributes)
+      allowed = attributes.slice(*model.column_names)
+      allowed["id"] = remap_uuid(allowed["id"]) if allowed["id"]
+      allowed["account_id"] = @account.id if allowed.key?("account_id")
+
+      allowed.each_key do |name|
+        if name.end_with?("_id") && name != "account_id" && allowed[name].present?
+          allowed[name] = remap_uuid(allowed[name])
+        end
+      end
+
+      prepare_special_attributes(model, allowed)
+    end
+
+    def prepare_special_attributes(model, attributes)
+      if model == User
+        attributes["identity_id"] = nil
+        attributes["verified_at"] = nil
+      elsif model == ActiveStorage::Blob
+        attributes["key"] = ActiveStorage::Blob.generate_unique_secure_token(length: ActiveStorage::Blob::MINIMUM_TOKEN_LENGTH)
+        attributes["service_name"] = ActiveStorage::Blob.service.name
+      end
+      attributes
+    end
+
+    def remap_uuid(uuid)
+      return @account.id if uuid == @source_account_id
+
+      bytes = Digest::SHA256.digest("#{transfer.id}:#{uuid}").bytes.first(16)
+      bytes[6] = (bytes[6] & 0x0f) | 0x40
+      bytes[8] = (bytes[8] & 0x3f) | 0x80
+      hex = bytes.pack("C*").unpack1("H*")
+      "#{hex[0, 8]}-#{hex[8, 4]}-#{hex[12, 4]}-#{hex[16, 4]}-#{hex[20, 12]}"
+    end
+
+    def connect_identity
+      owner = @account.users.find_by(role: :owner) || @account.users.where.not(role: :system).first
+      raise InvalidArchive, "The archive has no account owner" unless owner
+
+      owner.update_columns(identity_id: identity.id, active: true, verified_at: Time.current)
+    end
+
+    def upload_files
+      metadata_ids = entries_for(ActiveStorage::Blob.table_name).map { |entry| File.basename(entry.filename, ".json") }.to_set
+      file_ids = @entries.keys.filter_map { |path| path[%r{\Afiles/([^/]+)\z}, 1] }.to_set
+      unless metadata_ids == file_ids
+        raise InvalidArchive, "Archived file entries do not match their metadata"
+      end
+
+      @entries.each do |path, entry|
+        if match = path.match(%r{\Afiles/([^/]+)\z})
+          blob = ActiveStorage::Blob.find(remap_uuid(match[1]))
+          unless entry.uncompressed_size == blob.byte_size
+            raise InvalidArchive, "Archived file size does not match its metadata"
+          end
+          blob.service.upload(blob.key, EntryIO.new(entry.extractor_from(@archive)), checksum: blob.checksum)
+          @uploaded_keys << [ blob.service, blob.key ]
+        end
+      end
+    end
+
+    def remove_uploaded_files
+      @uploaded_keys.each { |service, key| service.delete(key) }
+    end
+
+    def parse_json(entry)
+      raise InvalidArchive, "Archive metadata is too large" if entry.uncompressed_size > METADATA_LIMIT
+      JSON.parse(read_entry(entry, limit: METADATA_LIMIT))
+    rescue JSON::ParserError => error
+      raise InvalidArchive, "Archive metadata is invalid JSON (#{error.message})"
+    end
+
+    def read_entry(entry, limit:)
+      reader = entry.extractor_from(@archive)
+      output = +""
+      output << reader.extract([ 1.megabyte, limit - output.bytesize ].min) until reader.eof? || output.bytesize >= limit
+      raise InvalidArchive, "Archive entry is too large" unless reader.eof?
+      output
+    end
+
+    def entry!(path)
+      @entries.fetch(path) { raise InvalidArchive, "The archive is missing #{path}" }
+    end
+
+    class BlobIO
+      attr_reader :size
+
+      def initialize(blob)
+        @service = blob.service
+        @key = blob.key
+        @size = blob.byte_size
+        @position = 0
+      end
+
+      def tell
+        @position
+      end
+
+      def seek(amount, whence = IO::SEEK_SET)
+        @position = case whence
+        when IO::SEEK_SET then amount
+        when IO::SEEK_CUR then @position + amount
+        when IO::SEEK_END then size + amount
+        end
+        0
+      end
+
+      def read(length = nil)
+        return "" if length == 0
+        return if @position >= size
+
+        finish = length ? [ @position + length, size ].min : size
+        data = @service.download_chunk(@key, @position...finish)
+        @position = finish
+        data
+      end
+    end
+
+    class EntryIO
+      def initialize(reader)
+        @reader = reader
+      end
+
+      def read(length = nil, buffer = nil)
+        return if @reader.eof?
+
+        data = @reader.extract(length || 1.megabyte)
+        buffer ? buffer.replace(data) : data
+      end
+    end
+end
