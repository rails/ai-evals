diff --git a/test/models/account/data_transfer/export_import_test.rb b/test/models/account/data_transfer/export_import_test.rb
new file mode 100644
index 0000000..827b7d0
--- /dev/null
+++ b/test/models/account/data_transfer/export_import_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Account::DataTransfer::ExportImportTest < ActiveSupport::TestCase
+  test "account archive round trips into a distinct account" do
+    export = Export.create!(account: accounts("37s"), user: users(:kevin), kind: :account)
+    export.perform_now
+
+    assert export.reload.completed?
+    assert export.file.attached?
+
+    transfer = Import.create!(identity: identities(:kevin), source_account: accounts("37s"), account: accounts("37s"), file: export.file.blob)
+    transfer.perform_now
+
+    assert transfer.reload.completed?, transfer.error_message
+    assert_not_equal accounts("37s"), transfer.account
+    assert_equal accounts("37s").boards.count, transfer.account.boards.count
+    assert_equal accounts("37s").cards.count, transfer.account.cards.count
+    assert_equal accounts("37s").users.count, transfer.account.users.count
+    assert_equal identities(:kevin), transfer.account.users.find_by(role: :owner).identity
+    assert transfer.account.users.where.not(role: :owner).where.not(verified_at: nil).none?
+  end
+
+  test "attached files round trip" do
+    card = cards(:logo)
+    card.image.attach(io: StringIO.new("picture data"), filename: "picture.jpg", content_type: "image/jpeg")
+    export = Export.create!(account: accounts("37s"), user: users(:kevin), kind: :account)
+    export.perform_now
+
+    transfer = Import.create!(identity: identities(:kevin), source_account: accounts("37s"), account: accounts("37s"), file: export.file.blob)
+    transfer.perform_now
+
+    imported = transfer.account.cards.find_by!(number: card.number)
+    assert imported.image.attached?
+    assert_equal "picture data", imported.image.download
+  end
+
+  test "a malformed import leaves no account behind" do
+    transfer = Import.new(identity: identities(:kevin), source_account: accounts("37s"), account: accounts("37s"))
+    transfer.file.attach io: StringIO.new("not a zip"), filename: "bad.zip", content_type: "application/zip"
+    transfer.save!
+
+    assert_no_difference -> { Account.count } do
+      transfer.perform_now
+    end
+
+    assert transfer.reload.failed?
+    assert_nil transfer.account
+  end
+end
