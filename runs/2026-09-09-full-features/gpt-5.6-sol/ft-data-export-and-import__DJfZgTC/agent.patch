+class Exports::DownloadsController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+
+  def show
+    export = Export.find_signed!(params[:id], purpose: :download)
+    if export.completed? && export.file.attached?
+      redirect_to download_url(export), allow_other_host: true
+    else
+      head :not_found
+    end
+  rescue ActiveSupport::MessageVerifier::InvalidSignature, ActiveRecord::RecordNotFound
+    head :not_found
+  end
+
+  private
+    def download_url(export)
+      ActiveStorage::Current.set(url_options: { protocol: request.protocol, host: request.host, port: request.port }) do
+        export.file.url(disposition: :attachment)
+      end
+    end
+end
