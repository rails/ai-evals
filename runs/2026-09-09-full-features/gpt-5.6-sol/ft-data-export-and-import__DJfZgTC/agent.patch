+class DataTransferMailer < ApplicationMailer
+  def export_ready(export)
+    @export = export
+    mail to: export.user.identity.email_address, subject: "Your Fizzy export is ready"
+  end
+
+  def export_failed(export)
+    @export = export
+    mail to: export.user.identity.email_address, subject: "Your Fizzy export failed"
+  end
+
+  def import_completed(transfer)
+    @import = transfer
+    mail to: transfer.identity.email_address, subject: "Your Fizzy import is complete"
+  end
+
+  def import_failed(transfer)
+    @import = transfer
+    mail to: transfer.identity.email_address, subject: "Your Fizzy import failed"
+  end
+end
