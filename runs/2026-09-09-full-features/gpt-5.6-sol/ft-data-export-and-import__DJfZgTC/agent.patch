+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  test "new" do
+    sign_in_as :kevin
+    get new_account_import_path
+    assert_response :success
+    assert_select "input[type=file]"
+  end
+
+  test "create queues an import" do
+    sign_in_as :kevin
+    archive = fixture_file_upload("empty.zip", "application/zip")
+
+    assert_enqueued_with job: ImportJob do
+      post account_imports_path, params: { import: { file: archive } }
+    end
+
+    assert_redirected_to session_menu_path(script_name: nil)
+    assert_equal identities(:kevin), Import.last.identity
+    assert_equal accounts("37s"), Import.last.source_account
+  end
+  test "create requires a file" do
+    sign_in_as :kevin
+
+    assert_no_enqueued_jobs only: ImportJob do
+      post account_imports_path, params: { import: { file: "" } }
+    end
+
+    assert_response :unprocessable_entity
+    assert_not Import.exists?
+  end
+end
