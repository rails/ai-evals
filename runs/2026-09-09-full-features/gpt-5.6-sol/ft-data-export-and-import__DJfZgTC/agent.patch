diff --git a/app/models/export.rb b/app/models/export.rb
new file mode 100644
index 0000000..55eb43d
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,41 @@
+class Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file
+
+  enum :kind, %w[account cards].index_by(&:itself)
+  enum :status, %w[pending processing completed failed].index_by(&:itself), default: :pending
+
+  def perform_later
+    ExportJob.perform_later(self)
+  end
+
+  def perform_now
+    processing!
+
+    ZipFile.create_for(file, filename: filename) do |zip|
+      if account?
+        Account::DataTransfer::Archive.new(account).write_to(zip)
+      else
+        Account::DataTransfer::CardArchive.new(user).write_to(zip)
+      end
+    end
+
+    update!(status: :completed, completed_at: Time.current, error_message: nil)
+  rescue => error
+    update!(status: :failed, error_message: error.message)
+    DataTransferMailer.export_failed(self).deliver_later
+  else
+    DataTransferMailer.export_ready(self).deliver_later
+  end
+
+  def download_token
+    signed_id purpose: :download, expires_in: 1.day
+  end
+
+  private
+    def filename
+      "fizzy-#{kind}-#{Time.current.to_date}.zip"
+    end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..3462776
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,27 @@
+class Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :source_account, class_name: "Account"
+  belongs_to :account, optional: true
+
+  has_one_attached :file
+
+  enum :status, %w[pending processing completed failed].index_by(&:itself), default: :pending
+
+  validates :file, presence: true
+
+  def perform_later
+    ImportJob.perform_later(self)
+  end
+
+  def perform_now
+    processing!
+    validate!(:perform)
+    Account::DataTransfer::Importer.new(self).import
+    update!(status: :completed, completed_at: Time.current, error_message: nil)
+  rescue => error
+    update!(status: :failed, account: nil, error_message: error.message)
+    DataTransferMailer.import_failed(self).deliver_later
+  else
+    DataTransferMailer.import_completed(self).deliver_later
+  end
+end
