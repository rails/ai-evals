@@ -0,0 +1,22 @@
+require "test_helper"
+
+class Exports::DownloadsControllerTest < ActionDispatch::IntegrationTest
+  test "invalid token is not found without authentication" do
+    get export_download_url("invalid", script_name: nil)
+    assert_response :not_found
+  end
+  test "completed export token works for one day" do
+    export = Export.create!(account: accounts("37s"), user: users(:kevin), kind: :cards, status: :completed)
+    export.file.attach io: StringIO.new("zip"), filename: "cards.zip", content_type: "application/zip"
+    token = export.download_token
+
+    get export_download_url(token, script_name: nil)
+    assert_response :redirect
+
+    travel 1.day + 1.second do
+      get export_download_url(token, script_name: nil)
+      assert_response :not_found
+    end
+  end
+
+end
