new file mode 100644
index 0000000..4ae5c8b
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,53 @@
+# One-box Fizzy deployment. Replace the example values before running `kamal setup`.
+service: fizzy
+image: YOUR_DOCKER_HUB_USERNAME/fizzy
+
+servers:
+  web:
+    - YOUR_SERVER_IP
+
+# Kamal Proxy obtains and renews a Let's Encrypt certificate for this hostname.
+# Point the hostname's DNS record at YOUR_SERVER_IP before the first deploy.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+  app_port: 80
+  healthcheck:
+    path: /up
+
+# SQLite databases and local Active Storage files all live below /rails/storage.
+# A named Docker volume keeps them when Kamal replaces the application container.
+volumes:
+  - fizzy_storage:/rails/storage
+
+registry:
+  server: docker.io
+  username: YOUR_DOCKER_HUB_USERNAME
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64
+
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    RAILS_ENV: production
+    APP_HOST: fizzy.example.com
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+    # The OSS Puma process runs Solid Queue, keeping web and jobs in one container.
+    SOLID_QUEUE_IN_PUMA: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+aliases:
+  console: app exec -i --reuse "bin/rails console"
+  shell: app exec -i --reuse /bin/bash
+  logs: app logs -f
