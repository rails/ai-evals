diff --git a/test/deployment_config_test.rb b/test/deployment_config_test.rb
new file mode 100644
index 0000000..e8cbeaf
--- /dev/null
+++ b/test/deployment_config_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+require "erb"
+require "yaml"
+
+class DeploymentConfigTest < ActiveSupport::TestCase
+  CONFIG_PATH = Rails.root.join("config/deploy.yml")
+  SECRETS_PATH = Rails.root.join(".kamal/secrets")
+
+  test "one-box Kamal config provides SSL, persistent storage, jobs, and mail" do
+    assert_path_exists CONFIG_PATH
+    assert_path_exists SECRETS_PATH
+
+    config = YAML.safe_load(ERB.new(CONFIG_PATH.read).result, aliases: true)
+
+    assert_equal [ "web" ], config.fetch("servers").keys
+    assert_equal [ "YOUR_SERVER_IP" ], config.dig("servers", "web")
+    assert_equal true, config.dig("proxy", "ssl")
+    assert_equal "fizzy.example.com", config.dig("proxy", "host")
+    assert_includes config.fetch("volumes"), "fizzy_storage:/rails/storage"
+
+    clear_env = config.dig("env", "clear")
+    assert_equal "fizzy.example.com", clear_env["APP_HOST"]
+    assert_equal "Fizzy <fizzy@example.com>", clear_env["MAILER_FROM_ADDRESS"]
+    assert_equal "smtp.example.com", clear_env["SMTP_ADDRESS"]
+    assert_equal 587, clear_env["SMTP_PORT"]
+    assert_equal "true", clear_env["SOLID_QUEUE_IN_PUMA"]
+
+    secret_env = config.dig("env", "secret")
+    assert_includes secret_env, "SECRET_KEY_BASE"
+    assert_includes secret_env, "SMTP_USERNAME"
+    assert_includes secret_env, "SMTP_PASSWORD"
+
+    secrets = SECRETS_PATH.read
+    assert_includes secrets, "KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD"
+    assert_includes secrets, "SECRET_KEY_BASE=$SECRET_KEY_BASE"
+    assert_includes secrets, "SMTP_USERNAME=$SMTP_USERNAME"
+    assert_includes secrets, "SMTP_PASSWORD=$SMTP_PASSWORD"
+  end
+
+  test "production uses the configured hostname and SMTP server" do
+    env = {
+      "RAILS_ENV" => "production",
+      "SECRET_KEY_BASE" => "test",
+      "APP_HOST" => "fizzy.test",
+      "SMTP_ADDRESS" => "smtp.test",
+      "SMTP_PORT" => "2525",
+      "SMTP_USERNAME" => "user",
+      "SMTP_PASSWORD" => "pass"
+    }
+    script = <<~'RUBY'
+      abort unless Rails.application.config.action_mailer.default_url_options == { host: "fizzy.test", protocol: "https" }
+      abort unless Rails.application.routes.default_url_options == { host: "fizzy.test", protocol: "https" }
+      abort unless Rails.application.config.action_mailer.delivery_method == :smtp
+      settings = Rails.application.config.action_mailer.smtp_settings
+      abort unless settings.values_at(:address, :port, :user_name, :password) == [ "smtp.test", 2525, "user", "pass" ]
+    RUBY
+
+    assert system(env, Rails.root.join("bin/rails").to_s, "runner", script)
+  end
+end
