diff --git a/test/models/board/publication_test.rb b/test/models/board/publication_test.rb
new file mode 100644
index 0000000..ce679ba
--- /dev/null
+++ b/test/models/board/publication_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+
+class Board::PublicationTest < ActiveSupport::TestCase
+  test "publishing creates one stable secret and unpublishing revokes it" do
+    board = boards(:writebook)
+
+    assert_nil board.publication_key
+    assert_not board.published?
+
+    board.publish
+    key = board.publication_key
+
+    assert board.published?
+    assert_operator key.length, :>=, 32
+    assert_no_changes -> { board.reload.publication_key } do
+      board.publish
+    end
+
+    board.unpublish
+    assert_nil board.publication_key
+    assert_not board.published?
+
+    board.publish
+    assert_not_equal key, board.publication_key
+  end
+end
