diff --git a/app/models/board/publication.rb b/app/models/board/publication.rb
new file mode 100644
index 0000000..394651f
--- /dev/null
+++ b/app/models/board/publication.rb
@@ -0,0 +1,23 @@
+module Board::Publication
+  extend ActiveSupport::Concern
+
+  included do
+    scope :published, -> { where.not(publication_key: nil) }
+  end
+
+  def publish
+    if publication_key.blank?
+      update!(publication_key: SecureRandom.urlsafe_base64(32))
+    end
+  rescue ActiveRecord::RecordNotUnique
+    retry
+  end
+
+  def unpublish
+    update!(publication_key: nil)
+  end
+
+  def published?
+    publication_key.present?
+  end
+end
