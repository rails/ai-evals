diff --git a/test/controllers/public_boards_test.rb b/test/controllers/public_boards_test.rb
new file mode 100644
index 0000000..b075268
--- /dev/null
+++ b/test/controllers/public_boards_test.rb
@@ -0,0 +1,100 @@
+require "test_helper"
+
+class PublicBoardsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "board JSON has a null public URL before publication" do
+    get board_path(@board), as: :json
+    assert_response :success
+    assert_nil response.parsed_body["public_url"]
+  end
+
+  test "an admin can publish and unpublish a board" do
+    post board_publication_path(@board), as: :json
+    assert_response :created
+
+    public_url = response.parsed_body.fetch("public_url")
+    assert_match %r{/public/boards/[^/]+\z}, public_url
+    key = @board.reload.publication_key
+    assert key.present?
+
+    delete board_publication_path(@board), as: :json
+    assert_response :no_content
+    assert_nil @board.reload.publication_key
+
+    get public_board_path(key)
+    assert_response :not_found
+  end
+
+  test "a non-admin cannot publish or unpublish" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board)
+    assert_response :forbidden
+    assert_nil @board.reload.publication_key
+
+    @board.update!(publication_key: "existing-secret")
+    delete board_publication_path(@board)
+    assert_response :forbidden
+    assert_equal "existing-secret", @board.reload.publication_key
+  end
+
+  test "anonymous visitors can open a public board, its column, and published card" do
+    post board_publication_path(@board), as: :json
+    key = @board.reload.publication_key
+    sign_out
+
+    get public_board_path(key)
+    assert_response :success
+    assert_includes response.body, @board.name
+    assert_includes Nokogiri::HTML(response.body).text, cards(:logo).title
+
+    get public_board_column_path(key, columns(:writebook_triage))
+    assert_response :success
+    assert_includes Nokogiri::HTML(response.body).text, cards(:logo).title
+
+    get public_board_card_path(key, cards(:logo).number)
+    assert_response :success
+    assert_includes Nokogiri::HTML(response.body).text, cards(:logo).title
+  end
+
+  test "public JSON contains public links and excludes drafts" do
+    draft = @board.cards.create!(title: "Private draft", status: :drafted, creator: users(:kevin))
+    post board_publication_path(@board), as: :json
+    key = @board.reload.publication_key
+    sign_out
+
+    get public_board_path(key), as: :json
+    assert_response :success
+
+    payload = response.parsed_body
+    assert_equal public_board_url(key), payload.fetch("public_url")
+    assert payload.fetch("columns").all? { |column| column.fetch("url").include?("/public/boards/#{key}/columns/") }
+    assert payload.fetch("cards").all? { |card| card.fetch("url").include?("/public/boards/#{key}/cards/") }
+    assert_not_includes payload.fetch("cards").pluck("number"), draft.number
+  end
+
+  test "public endpoints exclude drafts and resources from other boards" do
+    other_board = boards(:private)
+    draft = @board.cards.create!(title: "Never public", status: :drafted, creator: users(:kevin))
+    other_card = with_current_user(users(:kevin)) do
+      other_board.cards.create!(title: "Other", status: :published, creator: users(:kevin))
+    end
+    post board_publication_path(@board), as: :json
+    key = @board.reload.publication_key
+    sign_out
+
+    get public_board_path(key)
+    assert_response :success
+    assert_not_includes response.body, draft.title
+
+    get public_board_card_path(key, draft.number)
+    assert_response :not_found
+
+    get public_board_card_path(key, other_card.number)
+    assert_response :not_found
+  end
+end
