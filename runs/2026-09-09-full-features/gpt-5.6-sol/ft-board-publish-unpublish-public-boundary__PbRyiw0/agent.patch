diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..c0b80c2
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,36 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "admin publishes and unpublishes a board" do
+    post board_publication_path(@board, format: :json)
+
+    assert_response :created
+    assert_predicate @board.reload.publication_key, :present?
+
+    public_url = JSON.parse(response.body).fetch("public_url")
+    assert_equal public_board_url(@board.publication_key, script_name: nil), public_url
+
+    delete board_publication_path(@board, format: :json)
+
+    assert_response :no_content
+    assert_nil @board.reload.publication_key
+  end
+
+  test "member cannot publish or unpublish a board" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board)
+    assert_response :forbidden
+    assert_nil @board.reload.publication_key
+
+    @board.update!(publication_key: "published-secret")
+    delete board_publication_path(@board)
+    assert_response :forbidden
+    assert_equal "published-secret", @board.reload.publication_key
+  end
+end
diff --git a/test/controllers/public/boards/resources_controller_test.rb b/test/controllers/public/boards/resources_controller_test.rb
new file mode 100644
index 0000000..ac484a2
--- /dev/null
+++ b/test/controllers/public/boards/resources_controller_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Public::Boards::ResourcesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.update!(publication_key: "writebook-public-secret")
+  end
+
+  test "anonymous visitor opens a column and a published card" do
+    column = columns(:writebook_triage)
+    card = cards(:logo)
+
+    get public_board_column_path(@board.publication_key, column, script_name: nil)
+    assert_response :success
+    assert_select "h1", text: /#{column.name}/
+    assert_select "a", text: card.title
+
+    get public_board_card_path(@board.publication_key, card.number, script_name: nil)
+    assert_response :success
+    assert_select "h1", text: card.title
+  end
+
+  test "cards and columns must belong to the public board" do
+    other_board = boards(:miltons_wish_list)
+
+    get public_board_card_path(@board.publication_key, 999, script_name: nil)
+    assert_response :not_found
+
+    other_column = other_board.columns.create!(name: "Other")
+    get public_board_column_path(@board.publication_key, other_column, script_name: nil)
+    assert_response :not_found
+  end
+
+  test "public JSON uses public URLs and includes only published cards" do
+    draft = @board.cards.create!(title: "Private JSON draft", status: :drafted, creator: users(:kevin))
+
+    get public_board_path(@board.publication_key, format: :json, script_name: nil)
+    assert_response :success
+
+    payload = JSON.parse(response.body)
+    assert_equal public_board_url(@board.publication_key, script_name: nil), payload.fetch("public_url")
+    assert_includes payload.fetch("cards").pluck("number"), cards(:logo).number
+    assert_not_includes payload.fetch("cards").pluck("number"), draft.number
+
+    get public_board_card_path(@board.publication_key, cards(:logo).number, format: :json, script_name: nil)
+    assert_equal public_board_url(@board.publication_key, script_name: nil), JSON.parse(response.body).dig("board", "url")
+  end
+
+  test "draft cards cannot be opened or shown on a public board" do
+    draft = @board.cards.create!(title: "Private draft", status: :drafted, creator: users(:kevin))
+
+    get public_board_path(@board.publication_key, script_name: nil)
+    assert_response :success
+    assert_select "a", text: draft.title, count: 0
+
+    get public_board_card_path(@board.publication_key, draft.number, script_name: nil)
+    assert_response :not_found
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..085c760
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.update!(publication_key: "writebook-public-secret")
+  end
+
+  test "anonymous visitor opens a public board" do
+    get public_board_path(@board.publication_key, script_name: nil)
+
+    assert_response :success
+    assert_select "h1", text: @board.name
+    assert_select "a", text: cards(:logo).title
+  end
+
+  test "board JSON has a public URL only while published" do
+    sign_in_as :kevin
+
+    get board_path(@board, format: :json)
+    assert_equal public_board_url(@board.publication_key, script_name: nil), JSON.parse(response.body).fetch("public_url")
+
+    @board.update!(publication_key: nil)
+    get board_path(@board, format: :json)
+    assert_nil JSON.parse(response.body).fetch("public_url")
+  end
+
+  test "unknown and revoked keys are not found" do
+    get public_board_path("unknown-secret", script_name: nil)
+    assert_response :not_found
+
+    key = @board.publication_key
+    @board.update!(publication_key: nil)
+    get public_board_path(key, script_name: nil)
+    assert_response :not_found
+  end
+end
