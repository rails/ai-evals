diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..75f0730
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,70 @@
+class Notification::EmailBundle < ApplicationRecord
+  self.table_name = "notification_email_bundles"
+
+  DURATIONS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }.freeze
+
+  belongs_to :account
+  belongs_to :user
+  has_many :entries, class_name: "Notification::EmailBundle::Entry", foreign_key: :bundle_id, dependent: :destroy, inverse_of: :bundle
+  has_many :notifications, through: :entries
+
+  validates :frequency, inclusion: { in: DURATIONS.keys }
+  validates :starts_at, :ends_at, presence: true
+  validate :ends_after_it_starts
+
+  scope :open, -> { where(open_marker: true) }
+
+  def self.record(notification, arrived_at: Time.current)
+    user = notification.user
+    frequency = user.settings&.bundle_email_frequency
+    return if frequency == "never" || !DURATIONS.key?(frequency) || user.identity.blank?
+
+    bundle = nil
+    created = false
+
+    user.with_lock do
+      bundle = open.find_by(user: user)
+      unless bundle
+        bundle = create!(
+          account: user.account, user: user, frequency: frequency,
+          starts_at: arrived_at, ends_at: arrived_at + DURATIONS.fetch(frequency)
+        )
+        created = true
+      end
+
+      bundle.entries.create!(
+        account: notification.account,
+        notification: notification,
+        source: notification.source,
+        creator: notification.creator,
+        card: notification.card,
+        arrived_at: arrived_at
+      )
+    end
+
+    Notification::EmailBundleDeliveryJob.set(wait_until: bundle.ends_at).perform_later(bundle) if created
+    bundle
+  rescue ActiveRecord::RecordNotUnique
+    # A database-level backstop for callers on databases where row locking an
+    # as-yet-nonexistent bundle cannot serialize concurrent inserts.
+    retry
+  end
+
+  def deliver
+    with_lock do
+      return if delivered_at?
+
+      NotificationMailer.bundle(self).deliver_now if entries.exists? && user.identity.present?
+      update!(delivered_at: Time.current, open_marker: nil)
+    end
+  end
+
+  private
+    def ends_after_it_starts
+      errors.add(:ends_at, "must be after starts_at") if starts_at && ends_at && ends_at <= starts_at
+    end
+end
