--- /dev/null
+++ b/test/mailers/notification_mailer_test.rb
@@ -0,0 +1,28 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :daily)
+    Notification::EmailBundle.delete_all
+    notifications(:layout_commented_kevin).destroy!
+    @notification = Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    @bundle = Notification::EmailBundle.find_by!(user: @user)
+  end
+
+  test "bundle contains all entries and account-scoped links" do
+    email = NotificationMailer.bundle(@bundle)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "1 new Fizzy notification", email.subject
+    assert_includes email.html_part.body.to_s, @notification.card.title
+    assert_includes email.html_part.body.to_s, "#{@user.account.slug}/cards/"
+  end
+
+  test "delivery is idempotent" do
+    assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+      @bundle.deliver
+      @bundle.deliver
+    end
+  end
+end
diff --git a/test/models/notification/email_bundle_test.rb b/test/models/notification/email_bundle_test.rb
new file mode 100644
index 0000000..43667d4
--- /dev/null
+++ b/test/models/notification/email_bundle_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    Notification::EmailBundle.delete_all
+    clear_enqueued_jobs
+  end
+
+  test "the first notification opens an anchored window and schedules one delivery" do
+    now = Time.zone.parse("2026-02-20 10:15:00")
+
+    travel_to now do
+      notification = create_notification
+      bundle = Notification::EmailBundle.find_by!(user: @user)
+
+      assert_equal now, bundle.starts_at
+      assert_equal now + 4.hours, bundle.ends_at
+      assert_equal [ notification ], bundle.notifications
+      assert_enqueued_with job: Notification::EmailBundleDeliveryJob, at: bundle.ends_at
+    end
+  end
+
+  test "later and late-dated notifications join the already open window" do
+    first = travel_to(Time.zone.parse("2026-02-20 10:00")) { create_notification }
+    bundle = Notification::EmailBundle.find_by!(user: @user)
+
+    travel_to bundle.starts_at + 3.hours do
+      second = create_notification(events(:logo_assignment_km))
+      assert_equal bundle, second.reload.email_bundle_entries.first.bundle
+    end
+
+    assert_equal 1, Notification::EmailBundle.where(user: @user).count
+    assert_equal 2, bundle.entries.count
+    assert_equal first, bundle.notifications.first
+  end
+
+  test "new activity on an existing collapsed notification joins the window" do
+    notification = create_notification
+    bundle = Notification::EmailBundle.find_by!(user: @user)
+
+    notification.update!(source: events(:layout_published), unread_count: 2)
+
+    assert_equal 2, bundle.entries.count
+    assert_equal [ notification.id, notification.id ], bundle.entries.order(:arrived_at).pluck(:notification_id)
+    assert_equal 1, Notification::EmailBundle.where(user: @user).count
+  end
+
+  test "never does not create a window" do
+    @user.settings.never!
+    assert_no_difference(-> { Notification::EmailBundle.count }) { create_notification }
+  end
+
+  test "frequencies have the requested duration" do
+    { daily: 1.day, weekly: 1.week }.each do |frequency, duration|
+      Notification::EmailBundle.delete_all
+      @user.settings.update!(bundle_email_frequency: frequency)
+      now = Time.current
+      travel_to(now) { create_notification }
+      bundle = Notification::EmailBundle.last
+      assert_equal duration, bundle.ends_at - bundle.starts_at
+    end
+  end
+
+  test "delivery closes a window and the next arrival opens a non-overlapping one" do
+    create_notification
+    first = Notification::EmailBundle.find_by!(user: @user)
+
+    travel_to first.ends_at, with_usec: true do
+      assert_difference(-> { ActionMailer::Base.deliveries.size }, 1) { first.deliver }
+      create_notification(events(:logo_assignment_km))
+    end
+
+    second = Notification::EmailBundle.open.find_by!(user: @user)
+    assert first.reload.delivered_at?
+    assert_operator second.starts_at, :>=, first.ends_at
+    assert_equal 2, Notification::EmailBundle.where(user: @user).count
+  end
