@@ -0,0 +1,11 @@
+class Notification::EmailBundleDeliveryJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(bundle)
+    if bundle.ends_at.future?
+      self.class.set(wait_until: bundle.ends_at).perform_later(bundle)
+    else
+      bundle.deliver
+    end
+  end
+end
