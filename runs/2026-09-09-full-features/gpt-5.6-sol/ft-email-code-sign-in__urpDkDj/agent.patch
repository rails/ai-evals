+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  test "is issued for fifteen minutes and delivered with the code in the subject" do
+    travel_to Time.zone.local(2026, 1, 1, 12) do
+      email_code = nil
+
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        perform_enqueued_jobs do
+          email_code = EmailCode.issue(email_address: "Person@Example.com ", purpose: "signup")
+        end
+      end
+
+      assert_equal "person@example.com", email_code.email_address
+      assert_equal 15.minutes.from_now, email_code.expires_at
+      assert_match(/\A[A-Z0-9]{6}\z/, email_code.code)
+      assert_includes ActionMailer::Base.deliveries.last.subject, email_code.code
+    end
+  end
+
+  test "redeems once and accepts lowercase input" do
+    email_code = EmailCode.issue(email_address: "person@example.com", purpose: "signup")
+
+    assert email_code.redeem(email_code.code.downcase)
+    assert_not EmailCode.exists?(email_code.id)
+  end
+
+  test "does not redeem after fifteen minutes" do
+    email_code = EmailCode.issue(email_address: "person@example.com", purpose: "signup")
+
+    travel 15.minutes + 1.second do
+      assert_not email_code.redeem(email_code.code)
+      assert EmailCode.exists?(email_code.id)
+    end
+  end
+
+  test "does not redeem the wrong code" do
+    email_code = EmailCode.issue(email_address: "person@example.com", purpose: "signup")
+
+    assert_not email_code.redeem("WRONG1")
+    assert EmailCode.exists?(email_code.id)
+  end
+end
