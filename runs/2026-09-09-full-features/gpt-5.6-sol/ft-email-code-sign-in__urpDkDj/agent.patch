diff --git a/test/controllers/email_code_authentication_test.rb b/test/controllers/email_code_authentication_test.rb
new file mode 100644
index 0000000..0789f18
--- /dev/null
+++ b/test/controllers/email_code_authentication_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class EmailCodeAuthenticationTest < ActionDispatch::IntegrationTest
+  test "sign in sends and accepts a six-character email code" do
+    identity = identities(:kevin)
+
+    untenanted do
+      assert_emails 1 do
+        post session_path, params: { email_address: identity.email_address }
+      end
+
+      assert_redirected_to new_session_email_code_path
+      authentication_code = EmailCode.order(:created_at).last
+      email = ActionMailer::Base.deliveries.last
+      assert_includes email.subject, authentication_code.code
+      assert_match(/\A[A-Z0-9]{6}\z/, authentication_code.code)
+
+      post session_email_code_path, params: { code: authentication_code.code }
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "code verification is rate limited without rendering an unloaded form" do
+  identity = identities(:kevin)
+
+  untenanted do
+    post session_path, params: { email_address: identity.email_address }
+    Rails.cache.stubs(:increment).returns(11)
+
+    post session_email_code_path, params: { code: EmailCode.order(:created_at).last.code }
+    assert_response :too_many_requests
+    assert_not cookies[:session_token].present?
+  end
+end
+
+test "expired code cannot sign in" do
+    identity = identities(:kevin)
+
+    untenanted do
+      post session_path, params: { email_address: identity.email_address }
+      authentication_code = EmailCode.order(:created_at).last
+      authentication_code.update!(expires_at: 1.second.ago)
+
+      post session_email_code_path, params: { code: authentication_code.code }
+      assert_response :unprocessable_entity
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "signup code creates and signs in the identity" do
+    email_address = "new-person@example.com"
+
+    untenanted do
+      assert_emails 1 do
+        post signup_path, params: { signup: { email_address: email_address } }
+      end
+      assert_not Identity.exists?(email_address: email_address)
+
+      authentication_code = EmailCode.order(:created_at).last
+      post signup_email_code_path, params: { code: authentication_code.code }
+
+      assert_redirected_to new_signup_completion_path
+      assert Identity.exists?(email_address: email_address)
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "join code authentication joins and signs in the identity" do
+    email_address = "new-member@example.com"
+    account = accounts("37s")
+    join_code = account_join_codes(:"37s")
+
+    assert_emails 1 do
+      post join_path(code: join_code.code, script_name: account.slug), params: { email_address: email_address }
+    end
+    authentication_code = EmailCode.order(:created_at).last
+
+    post join_email_code_path(join_code: join_code.code, script_name: account.slug), params: { code: authentication_code.code }
+
+    identity = Identity.find_by!(email_address: email_address)
+    assert identity.users.exists?(account: account)
+    assert cookies[:session_token].present?
+    assert_redirected_to new_users_verification_url(script_name: account.slug)
+  end
+end
