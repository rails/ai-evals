diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..98f6dd9
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,41 @@
+class EmailCode < ApplicationRecord
+  LIFETIME = 15.minutes
+  PURPOSES = %w[ session signup join ].freeze
+
+  belongs_to :account_join_code, class_name: "Account::JoinCode", optional: true
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code, format: { with: /\A[A-Z0-9]{6}\z/ }
+  validates :purpose, inclusion: { in: PURPOSES }
+  validates :expires_at, presence: true
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+  normalizes :code, with: ->(value) { value.strip.upcase.presence }
+
+  scope :active, -> { where(expires_at: Time.current..) }
+
+  def self.issue(email_address:, purpose:, account_join_code: nil)
+    create!(
+      email_address: email_address,
+      purpose: purpose,
+      account_join_code: account_join_code,
+      code: SecureRandom.alphanumeric(6).upcase,
+      expires_at: LIFETIME.from_now
+    ).tap(&:deliver)
+  end
+
+  def deliver
+    EmailCodeMailer.verification(email_address: email_address, code: code).deliver_later
+  end
+
+  def redeem(code)
+    with_lock do
+      if expires_at.future? && ActiveSupport::SecurityUtils.secure_compare(self.code, code.to_s.strip.upcase)
+        destroy!
+        true
+      else
+        false
+      end
+    end
+  end
+end
