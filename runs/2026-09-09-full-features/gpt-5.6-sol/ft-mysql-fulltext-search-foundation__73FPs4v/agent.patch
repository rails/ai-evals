+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @cards = Current.user.accessible_cards.published.search(@query).reverse_chronologically
+      .includes(:board, :rich_text_description, comments: :rich_text_body)
+  end
+end
diff --git a/app/helpers/searches_helper.rb b/app/helpers/searches_helper.rb
new file mode 100644
index 0000000..7a4a876
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,24 @@
+module SearchesHelper
+  def search_highlight(content, query)
+    highlight(search_text(content), query, highlighter: "<mark>\\1</mark>")
+  end
+
+  def search_excerpt(content, query, context: 100)
+    text = search_text(content)
+    match_start = text.downcase.index(query.downcase)
+    excerpt_start = [ match_start - context, 0 ].max
+    excerpt_end = [ match_start + query.length + context, text.length ].min
+
+    [ ("…" if excerpt_start.positive?), text[excerpt_start...excerpt_end], ("…" if excerpt_end < text.length) ].compact.join
+  end
+
+  def search_match?(content, query)
+    search_text(content).downcase.include?(query.downcase)
+  end
+
+  private
+    def search_text(content)
+      text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+      text.gsub(/\s+/, " ").strip
+    end
+end
