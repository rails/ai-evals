diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..7eeea40
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    Current.user = users(:kevin)
+  end
+
+  test "finds published accessible cards by title, description, or comment newest first" do
+    title_match = create_card(title: "Needle in the title", created_at: 3.days.ago)
+    description_match = create_card(title: "Description match", description: "#{"Earlier text. " * 30}A hidden NEEDLE appears here", created_at: 2.days.ago)
+    comment_match = create_card(title: "Comment match", created_at: 1.day.ago)
+    comment_match.comments.create!(body: "Look for this needle", creator: users(:kevin))
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "[data-card-id]", 3
+    assert_equal [ comment_match, description_match, title_match ].map { |card| card.id.to_s },
+      css_select("[data-card-id]").map { |element| element["data-card-id"] }
+    assert_select "mark", text: /needle/i, count: 3
+  end
+
+  test "does not find inaccessible cards or drafts and searches wildcards literally" do
+    create_card(title: "Secret needle", board: boards(:private))
+    accesses(:private_kevin).destroy!
+
+    draft = create_card(title: "Draft needle")
+    draft.comments.create!(body: "needle in a draft comment", creator: users(:kevin))
+    draft.update_column(:status, :drafted)
+
+    literal_match = create_card(title: "This is 100% ready")
+    create_card(title: "This is 1000 ready")
+
+    get search_path, params: { q: "100%" }
+
+    assert_response :success
+    assert_select "[data-card-id='#{literal_match.id}']", 1
+    assert_select "[data-card-id]", 1
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "[data-card-id]", 0
+  end
+
+  test "escapes content before marking matches" do
+    card = create_card(title: "Find <script>alert('x')</script> needle")
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "[data-card-id] script", 0
+    assert_select "[data-card-id='#{card.id}'] mark", text: "needle"
+  end
+
+  test "shows an empty search page without a query" do
+    get search_path
+
+    assert_response :success
+    assert_select "[data-card-id]", 0
+  end
+
+  private
+    def create_card(title:, description: nil, board: boards(:writebook), status: :published, created_at: Time.current)
+      board.cards.create!(title: title, description: description, creator: users(:kevin), status: status, created_at: created_at)
+    end
+end
