diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..c4ec96f
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,47 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span>Search</span>
+  </h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get, class: "search__form" do |form| %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards…", autofocus: true,
+          autocomplete: "off", autocorrect: "off", class: "input search__input", aria: { label: "Search cards" } %>
+    <%= form.submit "Search", class: "btn btn--primary" %>
+  <% end %>
+
+  <% if @query.present? %>
+    <h2 class="search__summary"><%= pluralize(@cards.size, "result") %> for “<%= @query %>”</h2>
+
+    <div class="search__results">
+      <% @cards.each do |card| %>
+        <article class="search-result" data-card-id="<%= card.id %>">
+          <header class="search-result__header">
+            <%= link_to search_highlight(card.title, @query), card_path(card), class: "search-result__title" %>
+            <span class="search-result__board"><%= card.board.name %> · Card <%= card.number %></span>
+          </header>
+
+          <% if search_match?(card.description, @query) %>
+            <p class="search-result__excerpt"><%= search_highlight(search_excerpt(card.description, @query), @query) %></p>
+          <% end %>
+
+          <% card.comments.each do |comment| %>
+            <% if search_match?(comment.body, @query) %>
+              <p class="search-result__excerpt search-result__comment">
+                <span class="for-screen-reader">Matching comment:</span>
+                <%= search_highlight(search_excerpt(comment.body, @query), @query) %>
+              </p>
+            <% end %>
+          <% end %>
+        </article>
+      <% end %>
+
+      <% if @cards.empty? %>
+        <div class="blank-slate">No cards match “<%= @query %>”</div>
+      <% end %>
+    </div>
+  <% end %>
+</section>
