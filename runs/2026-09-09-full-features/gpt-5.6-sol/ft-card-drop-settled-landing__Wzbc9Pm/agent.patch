diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..94bf1dc
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,124 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  test "moving a card to another column is optimistic" do
+    sign_in_as users(:david)
+    visit board_url(boards(:writebook))
+
+    card = cards(:layout)
+    destination = columns(:writebook_in_progress)
+    source_selector = "#column_#{columns(:writebook_triage).id}"
+    destination_selector = "#column_#{destination.id}"
+    card_selector = "#article_card_#{card.id}"
+
+    assert_selector "#{source_selector} #{card_selector}", visible: :all
+    assert_selector "#{destination_selector} .cards__list", visible: :all
+
+    source_count = count_in(source_selector)
+    destination_count = count_in(destination_selector)
+
+    page.execute_script <<~JAVASCRIPT
+      window.actualFetch = window.fetch
+      window.fetch = (...args) => new Promise(resolve => {
+        window.releaseDragRequest = () => resolve(window.actualFetch(...args))
+      })
+    JAVASCRIPT
+
+    drag card_selector, to: destination_selector
+
+    assert_selector "#{destination_selector} #{card_selector}", visible: :all
+    assert_equal source_count - 1, count_in(source_selector)
+    assert_equal destination_count + 1, count_in(destination_selector)
+    assert_equal columns(:writebook_triage), card.reload.column
+
+    page.execute_script "window.releaseDragRequest()"
+    wait_until { card.reload.column == destination }
+  ensure
+    page.execute_script "window.fetch = window.actualFetch" if page.current_url.present?
+  end
+
+  test "a failed move is rolled back" do
+  sign_in_as users(:david)
+  visit board_url(boards(:writebook))
+
+  card = cards(:layout)
+  source_selector = "#column_#{columns(:writebook_triage).id}"
+  destination_selector = "#column_#{columns(:writebook_in_progress).id}"
+  card_selector = "#article_card_#{card.id}"
+
+  assert_selector "#{source_selector} #{card_selector}", visible: :all
+  source_count = count_in(source_selector)
+  destination_count = count_in(destination_selector)
+  page.execute_script "window.fetch = () => Promise.resolve(new Response(null, { status: 500 }))"
+
+  drag card_selector, to: destination_selector
+
+  assert_selector "#{source_selector} #{card_selector}", visible: :all
+  assert_equal source_count, count_in(source_selector)
+  assert_equal destination_count, count_in(destination_selector)
+  assert_equal columns(:writebook_triage), card.reload.column
+ensure
+  page.execute_script "window.fetch = window.actualFetch" if page.current_url.present?
+end
+
+test "moving a card between statuses and not within a column" do
+    sign_in_as users(:david)
+    visit board_url(boards(:writebook))
+
+    card = cards(:layout)
+    card_selector = "#article_card_#{card.id}"
+    triage_column = "#column_#{columns(:writebook_triage).id}"
+    assert_selector "#{triage_column} #{card_selector}", visible: :all
+
+    drag card_selector, to: "#maybe"
+    wait_until { card.reload.awaiting_triage? }
+    assert_selector "#maybe #{card_selector}", visible: :all
+
+    drag card_selector, to: "#not-now"
+    wait_until { card.reload.postponed? }
+    assert_selector "#not-now #{card_selector}", visible: :all
+
+    drag card_selector, to: "#closed-cards"
+    wait_until { card.reload.closed? }
+    assert_selector "#closed-cards #{card_selector}", visible: :all
+
+    drag card_selector, to: triage_column
+    wait_until { card.reload.column == columns(:writebook_triage) && card.open? }
+    assert_selector "#{triage_column} #{card_selector}", visible: :all
+
+    original_order = card_ids_in(triage_column)
+    drag card_selector, to: triage_column
+    assert_equal original_order, card_ids_in(triage_column)
+    assert_equal columns(:writebook_triage), card.reload.column
+  end
+
+  private
+    def drag(item_selector, to:)
+      page.execute_script <<~JAVASCRIPT
+        const item = document.querySelector(#{item_selector.to_json})
+        const destination = document.querySelector(#{to.to_json})
+        const transfer = new DataTransfer()
+
+        item.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer: transfer }))
+        destination.dispatchEvent(new DragEvent("dragenter", { bubbles: true, dataTransfer: transfer }))
+        destination.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+        destination.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+        item.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer: transfer }))
+      JAVASCRIPT
+    end
+
+    def count_in(column_selector)
+      find("#{column_selector} .cards__expander-count", visible: :all).text(:all).to_i
+    end
+
+    def card_ids_in(column_selector)
+      selector = "#{column_selector} [data-drag-and-drop-target~='item']"
+      page.evaluate_script("Array.from(document.querySelectorAll(#{selector.to_json}), item => item.id)")
+    end
+
+    def wait_until
+      Timeout.timeout(Capybara.default_max_wait_time) do
+        sleep 0.05 until yield
+      end
+    end
+end
