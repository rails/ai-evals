diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..e2af04e
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,202 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "container", "item" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  connect() {
+    this.dragstart = this.dragstart.bind(this)
+    this.dragend = this.dragend.bind(this)
+    this.dragenter = this.dragenter.bind(this)
+    this.dragover = this.dragover.bind(this)
+    this.dragleave = this.dragleave.bind(this)
+    this.drop = this.drop.bind(this)
+
+    this.element.addEventListener("dragstart", this.dragstart)
+    this.element.addEventListener("dragend", this.dragend)
+    this.element.addEventListener("dragenter", this.dragenter)
+    this.element.addEventListener("dragover", this.dragover)
+    this.element.addEventListener("dragleave", this.dragleave)
+    this.element.addEventListener("drop", this.drop)
+  }
+
+  disconnect() {
+    this.element.removeEventListener("dragstart", this.dragstart)
+    this.element.removeEventListener("dragend", this.dragend)
+    this.element.removeEventListener("dragenter", this.dragenter)
+    this.element.removeEventListener("dragover", this.dragover)
+    this.element.removeEventListener("dragleave", this.dragleave)
+    this.element.removeEventListener("drop", this.drop)
+  }
+
+  dragstart(event) {
+    const item = this.#itemFor(event.target)
+
+    if (item) {
+      this.draggedItem = item
+      this.sourceContainer = this.#containerFor(item)
+      this.sourceParent = item.parentNode
+      this.sourceNextSibling = item.nextElementSibling
+      item.classList.add(this.draggedItemClass)
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", item.id)
+    }
+  }
+
+  dragend() {
+    this.#clearDragState()
+  }
+
+  dragenter(event) {
+    const container = this.#containerFor(event.target)
+
+    if (this.#canDropIn(container)) {
+      this.hoverContainer?.classList.remove(this.hoverContainerClass)
+      this.hoverContainer = container
+      container.classList.add(this.hoverContainerClass)
+    }
+  }
+
+  dragover(event) {
+    const container = this.#containerFor(event.target)
+
+    if (this.#canDropIn(container)) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  dragleave(event) {
+    if (this.hoverContainer && !this.hoverContainer.contains(event.relatedTarget)) {
+      this.hoverContainer.classList.remove(this.hoverContainerClass)
+      this.hoverContainer = null
+    }
+  }
+
+  drop(event) {
+    const destination = this.#containerFor(event.target)
+
+    if (this.#canDropIn(destination)) {
+      event.preventDefault()
+      this.#moveTo(destination)
+    }
+  }
+
+  #moveTo(destination) {
+    const item = this.draggedItem
+    const source = this.sourceContainer
+    const parent = this.sourceParent
+    const nextSibling = this.sourceNextSibling
+
+    this.#insertInOrder(item, destination)
+    this.#updateEmptyState(source)
+    this.#updateEmptyState(destination)
+    this.#updateCount(source, -1)
+    this.#updateCount(destination, 1)
+    this.#clearDragState()
+
+    this.#persist(item, destination).catch(() => {
+      this.#insertBack(item, parent, nextSibling)
+      this.#updateEmptyState(source)
+      this.#updateEmptyState(destination)
+      this.#updateCount(source, 1)
+      this.#updateCount(destination, -1)
+    })
+  }
+
+  #insertInOrder(item, container) {
+    const list = container.querySelector(".cards__list")
+    const items = this.itemTargets.filter(candidate => candidate !== item && list.contains(candidate))
+    const followingItem = items.find(candidate => this.#comesBefore(item, candidate, container))
+
+    if (followingItem) {
+      followingItem.parentNode.insertBefore(item, followingItem)
+    } else if (items.length > 0) {
+      items.at(-1).parentNode.insertBefore(item, items.at(-1).nextSibling)
+    } else {
+      list.append(item)
+    }
+  }
+
+  #comesBefore(first, second, container) {
+    if (container.dataset.dragAndDropOrder === "newest") return true
+
+    if (container.dataset.dragAndDropOrder === "golden-latest") {
+      const goldenDifference = Number(first.dataset.dragAndDropGolden === "true") - Number(second.dataset.dragAndDropGolden === "true")
+      if (goldenDifference !== 0) return goldenDifference > 0
+    }
+
+    const activityDifference = first.dataset.dragAndDropLastActiveAt.localeCompare(second.dataset.dragAndDropLastActiveAt)
+    if (activityDifference !== 0) return activityDifference > 0
+
+    return first.id > second.id
+  }
+
+  #insertBack(item, parent, nextSibling) {
+    parent.insertBefore(item, nextSibling && parent.contains(nextSibling) ? nextSibling : null)
+  }
+
+  async #persist(item, container) {
+    const [ url, method ] = this.#requestFor(item, container)
+    const response = await fetch(url, {
+      method,
+      headers: {
+        "Accept": "application/json",
+        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content
+      }
+    })
+
+    if (!response.ok) throw new Error(`Unable to move card (${response.status})`)
+  }
+
+  #requestFor(item, container) {
+    switch (container.dataset.dragAndDropKind) {
+      case "column": {
+        const url = new URL(item.dataset.dragAndDropTriageUrl, window.location.origin)
+        url.searchParams.set("column_id", container.dataset.dragAndDropColumnId)
+        return [ url, "POST" ]
+      }
+      case "triage":
+        return [ item.dataset.dragAndDropTriageUrl, "DELETE" ]
+      case "not-now":
+        return [ item.dataset.dragAndDropNotNowUrl, "POST" ]
+      case "closed":
+        return [ item.dataset.dragAndDropClosureUrl, "POST" ]
+    }
+  }
+
+  #updateEmptyState(container) {
+    const list = container?.querySelector(".cards__list")
+    if (!list) return
+
+    const empty = !list.querySelector('[data-drag-and-drop-target~="item"]')
+    list.querySelectorAll(".blank-slate").forEach(placeholder => placeholder.hidden = !empty)
+  }
+
+  #updateCount(container, change) {
+    const counter = container.querySelector(".cards__expander-count")
+    if (counter && /^\d+$/.test(counter.textContent)) counter.textContent = Number(counter.textContent) + change
+  }
+
+  #canDropIn(container) {
+    return this.draggedItem && container && container !== this.sourceContainer && container.querySelector(".cards__list")
+  }
+
+  #itemFor(element) {
+    return element.closest?.('[data-drag-and-drop-target~="item"]')
+  }
+
+  #containerFor(element) {
+    return element.closest?.('[data-drag-and-drop-target~="container"]')
+  }
+
+  #clearDragState() {
+    this.draggedItem?.classList.remove(this.draggedItemClass)
+    this.hoverContainer?.classList.remove(this.hoverContainerClass)
+    this.draggedItem = null
+    this.sourceContainer = null
+    this.sourceParent = null
+    this.sourceNextSibling = null
+    this.hoverContainer = null
+  }
+}
