diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..917cb7f
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,67 @@
+class Notification::Bundle < ApplicationRecord
+  OPEN_SLOT = "open"
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :entries, class_name: "Notification::Bundle::Entry", foreign_key: :notification_bundle_id, inverse_of: :notification_bundle, dependent: :destroy
+
+  scope :open, -> { where(open_slot: OPEN_SLOT) }
+
+  validates :starts_at, :ends_at, presence: true
+  validates :open_slot, inclusion: { in: [ OPEN_SLOT ] }, allow_nil: true
+
+  class << self
+    def collect(user:, source:)
+      if duration = user.settings&.bundle_email_duration
+        user.with_lock do
+          close_expired_for(user)
+          open.find_or_create_by!(user: user) do |bundle|
+            bundle.starts_at = Time.current
+            bundle.ends_at = duration.from_now
+          end.tap do |bundle|
+            bundle.entries.create_or_find_by!(source: source)
+            bundle.schedule_delivery if bundle.previously_new_record?
+          end
+        end
+      end
+    end
+
+    private
+      def close_expired_for(user)
+        if (bundle = open.find_by(user: user)) && bundle.ends_at <= Time.current
+          bundle.deliver
+        end
+      end
+  end
+
+  def sources
+    entries.map(&:source)
+  end
+
+  def deliver
+    with_lock do
+      if user.settings.never?
+        discard
+      elsif delivered?
+        nil
+      elsif ends_at.future?
+        schedule_delivery
+      else
+        UserMailer.notification_bundle(self).deliver_now
+        update!(delivered_at: Time.current, open_slot: nil)
+      end
+    end
+  end
+
+  def discard
+    update!(delivered_at: Time.current, open_slot: nil) unless delivered?
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def schedule_delivery
+    Notification::Bundle::DeliveryJob.set(wait_until: ends_at).perform_later(self)
+  end
+end
