+
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      assert_enqueued_with(job: Notification::Bundle::DeliveryJob, args: [ bundle ], at: bundle.ends_at) do
+        bundle.deliver
+      end
+    end
+
+    assert_not bundle.reload.delivered?
+  end
+end
