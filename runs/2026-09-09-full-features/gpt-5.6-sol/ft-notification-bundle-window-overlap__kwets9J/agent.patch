+require "test_helper"
+
+class UserMailerNotificationBundleTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :daily)
+  end
+
+  test "renders an event digest" do
+    bundle = Notification::Bundle.collect(user: @user, source: events(:layout_commented))
+    email = UserMailer.notification_bundle(bundle)
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "1 new Fizzy notification", email.subject
+    assert_includes email.text_part.body.to_s, cards(:layout).title
+  end
+
+  test "renders a mention digest" do
+    bundle = Notification::Bundle.collect(user: @user, source: mentions(:logo_card_david_mention_by_jz))
+    email = UserMailer.notification_bundle(bundle)
+
+    assert_includes email.text_part.body.to_s, "Mentioned by #{users(:jz).name}"
+    assert_includes email.text_part.body.to_s, cards(:logo).title
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..f8afd3d
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,106 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+  end
+
+  test "the first notification opens a four hour window and schedules its delivery" do
+    travel_to Time.zone.local(2026, 3, 1, 9) do
+      assert_enqueued_with(job: Notification::Bundle::DeliveryJob, at: 4.hours.from_now) do
+        bundle = Notification::Bundle.collect(user: @user, source: events(:layout_commented))
+
+        assert_equal Time.current, bundle.starts_at
+        assert_equal 4.hours.from_now, bundle.ends_at
+        assert_equal [ events(:layout_commented) ], bundle.sources
+      end
+    end
+  end
+
+  test "late notifications join the window that is already open" do
+    bundle = travel_to Time.zone.local(2026, 3, 1, 9) do
+      Notification::Bundle.collect(user: @user, source: events(:layout_commented))
+    end
+
+    travel_to Time.zone.local(2026, 3, 1, 12, 59) do
+      assert_no_difference -> { @user.notification_bundles.count } do
+        assert_equal bundle, Notification::Bundle.collect(user: @user, source: events(:logo_assignment_km))
+      end
+    end
+
+    assert_equal [ events(:layout_commented), events(:logo_assignment_km) ], bundle.sources
+  end
+
+  test "daily and weekly windows are measured from the first notification" do
+    { daily: 1.day, weekly: 1.week }.each do |frequency, duration|
+      @user.settings.update!(bundle_email_frequency: frequency)
+      travel_to Time.current + duration do
+        bundle = Notification::Bundle.collect(user: @user, source: events(:layout_commented))
+        assert_equal duration, bundle.ends_at - bundle.starts_at
+        bundle.update!(delivered_at: Time.current, open_slot: nil)
+      end
+    end
+  end
+
+  test "never does not collect notifications or enqueue delivery" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_enqueued_jobs only: Notification::Bundle::DeliveryJob do
+      assert_no_difference -> { Notification::Bundle.count } do
+        assert_nil Notification::Bundle.collect(user: @user, source: events(:layout_commented))
+      end
+    end
+  end
+
+
+
+  test "the database prevents two open windows for one user" do
+    bundle = Notification::Bundle.collect(user: @user, source: events(:layout_commented))
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      Notification::Bundle.create!(user: @user, starts_at: Time.current,
+        ends_at: 4.hours.from_now, open_slot: Notification::Bundle::OPEN_SLOT)
+    end
+
+    assert bundle.reload.open_slot
+  end
+
+  test "switching email off discards an open window" do
+    bundle = Notification::Bundle.collect(user: @user, source: events(:layout_commented))
+
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert bundle.reload.delivered?
+    assert_nil bundle.open_slot
+    assert_no_difference -> { ActionMailer::Base.deliveries.size } do
+      bundle.deliver
+    end
+  end
+
+  test "delivery sends one email and closes the window" do
+    bundle = Notification::Bundle.collect(user: @user, source: events(:layout_commented))
+    bundle.entries.create!(source: events(:logo_assignment_km))
+
+    travel_to bundle.ends_at + 1.second do
+      assert_difference -> { ActionMailer::Base.deliveries.size }, 1 do
+        bundle.deliver
+      end
+    end
+
+    assert bundle.reload.delivered?
+    assert_nil bundle.open_slot
+  end
+
+  test "delivery before the end of the window reschedules instead of sending" do
