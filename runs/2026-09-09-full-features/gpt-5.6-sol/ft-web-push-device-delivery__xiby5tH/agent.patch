@@ -0,0 +1,22 @@
+require "test_helper"
+
+class Notification::PushJobTest < ActiveJob::TestCase
+  test "pushes tray content and card URL to every subscribed device" do
+    notification = notifications(:logo_mentioned_david)
+    deliveries = []
+    subscription = notification.user.push_subscriptions.create!(endpoint: "https://push.example.test/1", p256dh_key: "key", auth_key: "auth")
+    second_subscription = notification.user.push_subscriptions.create!(endpoint: "https://push.example.test/2", p256dh_key: "key", auth_key: "auth")
+
+    PushSubscription.any_instance.stubs(:push).with do |payload|
+      deliveries << payload
+      payload["title"].present? && payload["body"].present? && payload["url"] == Rails.application.routes.url_helpers.card_path(notification.card, script_name: notification.account.slug)
+    end
+
+    Notification::PushJob.perform_now(notification)
+
+    assert_equal 2, deliveries.size
+  ensure
+    subscription&.destroy
+    second_subscription&.destroy
+  end
+end
