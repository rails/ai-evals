+    )
+  end
+
+  test "requires its push service credentials" do
+    assert @subscription.valid?
+
+    %i[ endpoint p256dh_key auth_key ].each do |attribute|
+      @subscription.public_send("#{attribute}=", nil)
+      assert_not @subscription.valid?
+    end
+  end
+
+  test "delivers a web push" do
+    payload = { title: "Card title", body: "Comment", url: "/123/cards/1" }
+    request = nil
+
