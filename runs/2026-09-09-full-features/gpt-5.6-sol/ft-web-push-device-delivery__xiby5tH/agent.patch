--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,26 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    @push_subscription.assign_attributes(push_subscription_params.merge(user: @user))
+    created = @push_subscription.new_record?
+    @push_subscription.save!
+
+    head(created ? :created : :ok)
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..b4452a6
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,85 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static classes = [ "on" ]
+  static targets = [ "button", "details", "status" ]
+  static values = { publicKey: String, subscriptionUrl: String }
+
+  connect() {
+    this.refresh().catch(() => this.#showHelp())
+  }
+
+  async subscribe() {
+    this.buttonTarget.disabled = true
+
+    try {
+      const permission = await Notification.requestPermission()
+
+      if (permission === "granted") {
+        const registration = await navigator.serviceWorker.ready
+        const subscription = await registration.pushManager.subscribe({
+          userVisibleOnly: true,
+          applicationServerKey: this.#applicationServerKey
+        })
+
+        await this.#save(subscription)
+      }
+    } catch {
+      this.#showHelp()
+    } finally {
+      await this.refresh().catch(() => this.#showHelp())
+    }
+  }
+
+  async refresh() {
+    const supported = "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+    let subscribed = false
+
+    if (supported && Notification.permission === "granted") {
+      const registration = await navigator.serviceWorker.ready
+      const subscription = await registration.pushManager.getSubscription()
+
+      if (subscription) {
+        await this.#save(subscription)
+        subscribed = true
+      }
+    }
+
+    this.element.classList.toggle(this.onClass, subscribed)
+    this.buttonTarget.disabled = !supported || Notification.permission === "denied" || subscribed
+    this.detailsTargets.forEach(element => element.hidden = supported && Notification.permission !== "denied")
+    this.statusTarget.textContent = subscribed ? "Notifications are on for this device." : "Notifications are off for this device."
+  }
+
+  #showHelp() {
+    const supported = "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+    this.buttonTarget.disabled = !supported || Notification.permission === "denied"
+    this.detailsTargets.forEach(element => element.hidden = false)
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.publicKeyValue.length % 4) % 4)
+    const base64 = (this.publicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+
+  async #save(subscription) {
+    const json = subscription.toJSON()
+    const response = await fetch(this.subscriptionUrlValue, {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content
+      },
+      body: JSON.stringify({
+        push_subscription: {
+          endpoint: json.endpoint,
+          p256dh_key: json.keys.p256dh,
+          auth_key: json.keys.auth
+        }
+      })
+    })
+
+    if (!response.ok) throw new Error("Could not save push subscription")
+  }
+}
