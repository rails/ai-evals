diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..df620c2 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,28 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+self.addEventListener("push", (event) => {
+  if (event.data) {
+    const notification = event.data.json()
+    event.waitUntil(self.registration.showNotification(notification.title, {
+      body: notification.body,
+      data: { url: notification.url }
+    }))
+  }
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  if (event.notification.data?.url) {
+    const url = new URL(event.notification.data.url, self.location.origin)
+
+    if (url.origin === self.location.origin) {
+      event.waitUntil(clients.matchAll({ type: "window", includeUncontrolled: true }).then((windows) => {
+        const client = windows[0]
+        return client ? client.navigate(url.href).then(() => client.focus()) : clients.openWindow(url.href)
+      }))
+    }
+  }
+})
