@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: {
+          endpoint: "https://push.example.test/subscription",
+          p256dh_key: "p256dh",
+          auth_key: "auth"
+        }
+      }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "p256dh", @user.push_subscriptions.last.p256dh_key
+    assert_equal "auth", @user.push_subscriptions.last.auth_key
+  end
+
+  test "create replaces keys for an existing endpoint" do
+    subscription = @user.push_subscriptions.create!(endpoint: "https://push.example.test/subscription", p256dh_key: "old", auth_key: "old")
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: {
+        push_subscription: { endpoint: subscription.endpoint, p256dh_key: "new", auth_key: "new" }
+      }, as: :json
+    end
+
+    assert_response :ok
+    assert_equal [ "new", "new" ], subscription.reload.attributes.values_at("p256dh_key", "auth_key")
+  end
+
+  test "cannot create a subscription for another user" do
+    post user_push_subscriptions_path(users(:jason)), params: {
+      push_subscription: { endpoint: "https://push.example.test/subscription", p256dh_key: "key", auth_key: "auth" }
+    }, as: :json
+
+    assert_response :forbidden
+  end
+
+test "the same browser endpoint can subscribe different users" do
+  other_user = users(:jason)
+  endpoint = "https://push.example.test/shared-subscription"
+  other_user.push_subscriptions.create!(endpoint: endpoint, p256dh_key: "other", auth_key: "other")
+
+  post user_push_subscriptions_path(@user), params: {
+    push_subscription: { endpoint: endpoint, p256dh_key: "mine", auth_key: "mine" }
+  }, as: :json
+
+  assert_response :created
+  assert_equal "other", other_user.push_subscriptions.find_by!(endpoint: endpoint).p256dh_key
+  assert_equal "mine", @user.push_subscriptions.find_by!(endpoint: endpoint).p256dh_key
+end
+end
