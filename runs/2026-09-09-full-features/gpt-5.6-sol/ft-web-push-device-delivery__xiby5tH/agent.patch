--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,27 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create_commit :push_later
+    after_update_commit :push_later, if: :source_id_previously_changed?
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self) if PushSubscription.configured?
+  end
+
+  def push
+    user.push_subscriptions.find_each do |subscription|
+      subscription.push(push_payload)
+    end
+  end
+
+  private
+    def push_payload
+      JSON.parse(ApplicationController.render(
+        partial: "notifications/notification/#{source_type.underscore}/body",
+        formats: :json,
+        locals: { notification: self }
+      )).merge("url" => Rails.application.routes.url_helpers.card_path(card, script_name: account.slug))
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..6335840
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,29 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: { scope: :user_id }
+
+  class << self
+    def configured?
+      ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+    end
+  end
+
+  def push(payload)
+    if self.class.configured?
+      WebPush.payload_send(
+        message: payload.to_json,
+        endpoint: endpoint,
+        p256dh: p256dh_key,
+        auth: auth_key,
+        vapid: {
+          public_key: ENV["VAPID_PUBLIC_KEY"],
+          private_key: ENV["VAPID_PRIVATE_KEY"]
+        }
+      )
+    end
+  rescue WebPush::ExpiredSubscription
+    destroy
+  end
+end
