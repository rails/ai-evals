@@ -0,0 +1,26 @@
+require "test_helper"
+
+class Cards::StalledControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+    @card = cards(:layout)
+    @card.update_columns(burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+  end
+
+  test "stalled cards can be listed" do
+    get cards_path(indexed_by: "stalled")
+
+    assert_response :success
+    assert_select "##{ActionView::RecordIdentifier.dom_id(@card, :article)}"
+    assert_select ".card__stalled", text: /Stalled/
+  end
+
+  test "stalled cards can be listed as JSON" do
+    get cards_path(indexed_by: "stalled", format: :json)
+
+    assert_response :success
+    card = response.parsed_body.find { |candidate| candidate["id"] == @card.id }
+    assert card
+    assert card["stalled"]
+  end
+end
diff --git a/test/models/card/burstable_test.rb b/test/models/card/burstable_test.rb
new file mode 100644
index 0000000..aff3f24
--- /dev/null
+++ b/test/models/card/burstable_test.rb
@@ -0,0 +1,93 @@
+require "test_helper"
+
+class Card::BurstableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:layout)
+    @card.comments.destroy_all
+    @card.update_columns(burst_at: nil, last_active_at: Time.current)
+  end
+
+  test "three comments from two people within a third of the board auto-close period cause a burst" do
+    now = Time.current.change(usec: 0)
+    window = @card.auto_postpone_period / 3
+
+    travel_to(now - window) { comment_by users(:david) }
+    travel_to(now - window / 2) { comment_by users(:david) }
+    travel_to(now) { comment_by users(:jason) }
+
+    assert_predicate @card.reload, :burst?
+  end
+
+  test "three comments from one person do not cause a burst" do
+    3.times { comment_by users(:david) }
+
+    assert_not_predicate @card.reload, :burst?
+  end
+
+  test "three comments outside a third of the board auto-close period do not cause a burst" do
+    now = Time.current.change(usec: 0)
+    window = @card.auto_postpone_period / 3
+
+    travel_to(now - window - 1.second) { comment_by users(:david) }
+    travel_to(now - 1.minute) { comment_by users(:david) }
+    travel_to(now) { comment_by users(:jason) }
+
+    assert_not_predicate @card.reload, :burst?
+  end
+
+  test "comment burst window uses the board auto-close period" do
+    @card.board.update!(auto_postpone_period_in_days: 3)
+    now = Time.current.change(usec: 0)
+
+    travel_to(now - 2.days) { comment_by users(:david) }
+    travel_to(now - 12.hours) { comment_by users(:david) }
+    travel_to(now) { comment_by users(:jason) }
+
+    assert_not_predicate @card.reload, :burst?
+  end
+
+  test "assignment causes a burst" do
+    @card.toggle_assignment(users(:jason))
+
+    assert_predicate @card.reload, :burst?
+  end
+
+  test "reopening causes a burst" do
+    @card.close
+    @card.reopen
+
+    assert_predicate @card.reload, :burst?
+  end
+
+  test "card is stalled two weeks after its last activity following a burst" do
+    @card.update_columns(burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+
+    assert_predicate @card.reload, :stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "recent activity resets stalled status without forgetting the burst" do
+    @card.update_columns(burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+    assert_predicate @card.reload, :stalled?
+
+    comment_by users(:jason)
+
+    assert_not_predicate @card.reload, :stalled?
+    assert_predicate @card, :burst?
+  end
+
+  test "stalled index returns only stalled cards" do
+    @card.update_columns(burst_at: 3.weeks.ago, last_active_at: 2.weeks.ago)
+
+    cards = Card.indexed_by("stalled")
+
+    assert_includes cards, @card
+    assert cards.all?(&:stalled?)
+  end
+
+  private
+    def comment_by(creator)
+      @card.comments.create!(body: "A comment", creator: creator)
+    end
+end
