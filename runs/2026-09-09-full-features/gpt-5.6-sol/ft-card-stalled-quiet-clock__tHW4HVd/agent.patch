diff --git a/app/models/card/burstable.rb b/app/models/card/burstable.rb
new file mode 100644
index 0000000..9112b61
--- /dev/null
+++ b/app/models/card/burstable.rb
@@ -0,0 +1,39 @@
+module Card::Burstable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> { where.not(burst_at: nil).where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def record_activity(event)
+    touch_last_active_at
+
+    if burst_triggered_by?(event)
+      update_column(:burst_at, event.created_at)
+    end
+  end
+
+  def burst?
+    burst_at.present?
+  end
+
+  def stalled?
+    burst? && last_active_at.present? && last_active_at <= STALLED_AFTER.ago
+  end
+
+  private
+    def burst_triggered_by?(event)
+      event.action.in?([ "card_assigned", "card_reopened" ]) || comment_burst?(event)
+    end
+
+    def comment_burst?(event)
+      if event.action == "comment_created"
+        comments_in_burst_window = comments.by_user.where(created_at: (event.eventable.created_at - auto_postpone_period / 3)..event.eventable.created_at)
+        comments_in_burst_window.count >= 3 && comments_in_burst_window.distinct.count(:creator_id) >= 2
+      else
+        false
+      end
+    end
+end
