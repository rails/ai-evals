new file mode 100644
index 0000000..4b4d122
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,153 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  connect() {
+    this.enableCards()
+  }
+
+  enableCards() {
+    this.element.querySelectorAll(".card").forEach(card => card.draggable = true)
+  }
+
+  start(event) {
+    const card = event.target.closest(".card[draggable=true]")
+    if (!card || !this.element.contains(card)) return
+
+    this.card = card
+    this.sourceParent = card.parentElement
+    this.sourceNextSibling = card.nextSibling
+    card.classList.add(DRAGGED_CLASS)
+
+    event.dataTransfer.effectAllowed = "move"
+    // Firefox will not start a native drag unless some data is supplied.
+    event.dataTransfer.setData("text/plain", card.id)
+  }
+
+  over(event) {
+    if (!this.card) return
+
+    const destination = event.target.closest("[data-drag-and-drop-destination]")
+    if (!destination || !this.element.contains(destination)) return
+
+    event.preventDefault()
+    event.dataTransfer.dropEffect = "move"
+    this.#hover(destination)
+  }
+
+  leave(event) {
+    if (!this.hoveredDestination) return
+    if (this.hoveredDestination.contains(event.relatedTarget)) return
+
+    this.#clearHover()
+  }
+
+  async drop(event) {
+    if (!this.card) return
+
+    const destination = event.target.closest("[data-drag-and-drop-destination]")
+    if (!destination || !this.element.contains(destination)) return
+
+    event.preventDefault()
+
+    const card = this.card
+    const sourceParent = this.sourceParent
+    const sourceNextSibling = this.sourceNextSibling
+    const destinationList = destination.querySelector(".cards__list")
+    const destinationParent = destinationList?.querySelector("turbo-frame[role=presentation]") || destinationList
+
+    this.#clearHover()
+
+    // A column is a destination, not a sortable list.
+    if (!destinationList || destination.contains(card)) {
+      this.#reset()
+      return
+    }
+
+    this.#insertInColumnOrder(card, destinationParent)
+    card.classList.remove(DRAGGED_CLASS)
+    card.draggable = false
+
+    try {
+      const response = await this.#save(card, destination)
+      if (!response.ok) this.#restore(card, sourceParent, sourceNextSibling)
+    } catch (error) {
+      this.#restore(card, sourceParent, sourceNextSibling)
+    } finally {
+      card.draggable = true
+      this.#reset()
+    }
+  }
+
+  end() {
+    this.#reset()
+  }
+
+  disconnect() {
+    this.#reset()
+  }
+
+  #save(card, destination) {
+    const type = destination.dataset.dragAndDropDestination
+    let method = "post"
+    let url
+
+    switch (type) {
+      case "column":
+        url = new URL(card.dataset.cardTriageUrl, window.location.href)
+        url.searchParams.set("column_id", destination.dataset.dragAndDropColumnId)
+        break
+      case "triage":
+        method = "delete"
+        url = card.dataset.cardTriageUrl
+        break
+      case "not-now":
+        url = card.dataset.cardNotNowUrl
+        break
+      case "closed":
+        url = card.dataset.cardClosureUrl
+        break
+      default:
+        throw new Error(`Unknown card destination: ${type}`)
+    }
+
+    return new FetchRequest(method, url.toString(), { responseKind: "json" }).perform()
+  }
+
+  #insertInColumnOrder(card, list) {
+    const cards = Array.from(list.children).filter(element => element.classList.contains("card"))
+    const firstCardInGroup = card.classList.contains("golden-effect")
+      ? cards[0]
+      : cards.find(element => !element.classList.contains("golden-effect"))
+
+    list.insertBefore(card, firstCardInGroup || null)
+  }
+
+  #restore(card, parent, nextSibling) {
+    if (!parent?.isConnected) return
+    parent.insertBefore(card, nextSibling?.parentElement === parent ? nextSibling : null)
+  }
+
+  #hover(destination) {
+    if (this.hoveredDestination === destination) return
+    this.#clearHover()
+    this.hoveredDestination = destination
+    destination.classList.add(HOVER_CLASS)
+  }
+
+  #clearHover() {
+    this.hoveredDestination?.classList.remove(HOVER_CLASS)
+    this.hoveredDestination = null
+  }
+
+  #reset() {
+    this.card?.classList.remove(DRAGGED_CLASS)
+    this.#clearHover()
+    this.card = null
+    this.sourceParent = null
+    this.sourceNextSibling = null
+  }
+}
