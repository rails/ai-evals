diff --git a/test/integration/board_drag_and_drop_test.rb b/test/integration/board_drag_and_drop_test.rb
new file mode 100644
index 0000000..0ba02a2
--- /dev/null
+++ b/test/integration/board_drag_and_drop_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class BoardDragAndDropTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "board and cards expose drag and drop actions and destinations" do
+    board = boards(:writebook)
+    card = cards(:logo)
+
+    get board_path(board)
+
+    assert_response :success
+    assert_select '[data-controller~="drag-and-drop"]'
+    assert_select '#maybe[data-drag-and-drop-destination="triage"]'
+    assert_select '#not-now[data-drag-and-drop-destination="not-now"]'
+    assert_select '#closed-cards[data-drag-and-drop-destination="closed"]'
+    assert_select "#column_#{columns(:writebook_in_progress).id}[data-drag-and-drop-destination=column]"
+
+    get board_column_path(board, card.column)
+
+    assert_response :success
+    assert_select "article.card" do |elements|
+      data = elements.first.attributes
+      assert_equal card_triage_path(card), data["data-card-triage-url"].value
+      assert_equal card_not_now_path(card), data["data-card-not-now-url"].value
+      assert_equal card_closure_path(card), data["data-card-closure-url"].value
+    end
+  end
+end
diff --git a/test/system/board_drag_and_drop_test.rb b/test/system/board_drag_and_drop_test.rb
new file mode 100644
index 0000000..93eb025
--- /dev/null
+++ b/test/system/board_drag_and_drop_test.rb
@@ -0,0 +1,54 @@
+require "application_system_test_case"
+
+class BoardDragAndDropTest < ApplicationSystemTestCase
+  test "moving a card between columns is immediate and persists without reordering" do
+    card = cards(:logo)
+    destination = columns(:writebook_in_progress)
+    sign_in_as(users(:kevin))
+    visit board_url(card.board)
+
+    card_selector = "##{dom_id(card, :article)}"
+    destination_selector = "##{dom_id(destination)}"
+    assert_selector card_selector, visible: :all
+    assert_selector "#{destination_selector} .card", visible: :all
+
+    Timeout.timeout(Capybara.default_max_wait_time) do
+      sleep 0.01 until page.evaluate_script(
+        'window.Stimulus.controllers.some(controller => controller.identifier === "drag-and-drop")'
+      )
+    end
+
+    existing_card_ids = page.evaluate_script(<<~JS)
+      Array.from(document.querySelectorAll(#{("#{destination_selector} .card").to_json})).map(card => card.id)
+    JS
+
+    drag_result = page.evaluate_script(<<~JS)
+      (() => {
+        const card = document.querySelector(#{card_selector.to_json})
+        const destination = document.querySelector(#{destination_selector.to_json})
+        const transfer = new DataTransfer()
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer: transfer }))
+        destination.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+        const dimmed = card.classList.contains("drag-and-drop__dragged-item")
+        const highlighted = destination.classList.contains("drag-and-drop__hover-container")
+        destination.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+        const cardsAfterDrop = Array.from(destination.querySelectorAll(".card")).map(card => card.id)
+        return { moved: destination.contains(card), dimmed, highlighted, cardsAfterDrop }
+      })()
+    JS
+
+    assert drag_result["dimmed"], "dragged card should be dimmed"
+    assert drag_result["highlighted"], "destination should light up under the pointer"
+    assert drag_result["moved"], "card should move before its save finishes"
+    assert_equal existing_card_ids, drag_result["cardsAfterDrop"].without(dom_id(card, :article)),
+      "moving a card should not reorder cards already in the column"
+    assert_selector "#{destination_selector} #{card_selector}", visible: :all
+
+    Timeout.timeout(Capybara.default_max_wait_time) do
+      sleep 0.05 until card.reload.column == destination
+    end
+
+    visit current_url
+    assert_selector "#{destination_selector} #{card_selector}", visible: :all
+  end
+end
