+require "test_helper"
+
+class BridgeHelperTest < ActionView::TestCase
+  test "renders raw card timestamps for browser-local sharing" do
+    card = cards(:logo)
+    description = bridge_share_card_description(card)
+    button = Nokogiri::HTML.fragment(bridged_share_url_button(description)).at_css("button")
+
+    assert_equal card.created_at.iso8601, button["data-bridge-share-added-at"]
+    assert_equal card.last_active_at.iso8601, button["data-bridge-share-updated-at"]
+    assert_nil button["data-bridge-share-description"]
+  end
+
+  test "renders plain descriptions for non-timestamped sharing" do
+    button = Nokogiri::HTML.fragment(bridged_share_url_button("Board summary")).at_css("button")
+
+    assert_equal "Board summary", button["data-bridge-share-description"]
+  end
+end
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..8a08918
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "renders a raw timestamp for browser formatting" do
+    timestamp = Time.zone.parse("2025-01-22 17:30:00")
+
+    travel_to Time.zone.parse("2025-01-23 09:00:00") do
+      html = local_time_tag(timestamp, format: :conversational)
+      element = Nokogiri::HTML.fragment(html).at_css("time")
+
+      assert_equal timestamp.iso8601, element["datetime"]
+      assert_equal "local-time", element["data-controller"]
+      assert_equal "conversational", element["data-local-time-format-value"]
+      assert_empty element.text
+      assert_not_includes html, "yesterday"
+      assert_not_includes html, "5:30 PM"
+    end
+  end
+
+  test "renders the same timestamp regardless of the server timezone" do
+    timestamp = Time.utc(2025, 1, 22, 17, 30, 0)
+
+    eastern = Time.use_zone("America/New_York") { local_time_tag(timestamp.in_time_zone) }
+    pacific = Time.use_zone("America/Los_Angeles") { local_time_tag(timestamp.in_time_zone) }
+
+    assert_equal eastern, pacific
+    assert_includes eastern, %(datetime="2025-01-22T17:30:00Z")
+  end
+
+  test "normalizes underscored format names for Stimulus" do
+    html = local_time_tag(Time.zone.parse("2025-01-22 17:30:00"), format: :full_date)
+    element = Nokogiri::HTML.fragment(html).at_css("time")
+
+    assert_equal "full-date", element["data-local-time-format-value"]
+  end
+
+  test "preserves HTML options" do
+    html = local_time_tag(Time.zone.parse("2025-01-22 17:30:00"), format: :time, class: "timestamp")
+    element = Nokogiri::HTML.fragment(html).at_css("time.timestamp")
+
+    assert_equal "time", element["data-local-time-format-value"]
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..43b5276
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,46 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  test "renders conversational dates in the browser timezone" do
+    sign_in_as(users(:david))
+
+    page.execute_script <<~JS
+      const now = new Date()
+      const sameDay = new Date(now)
+      sameDay.setHours(Math.max(0, now.getHours() - 2), 42, 0, 0)
+
+      const sameDayElement = document.createElement("time")
+      sameDayElement.id = "same-day"
+      sameDayElement.dateTime = sameDay.toISOString()
+      sameDayElement.dataset.controller = "local-time"
+      sameDayElement.dataset.expected = new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" }).format(sameDay)
+      document.body.append(sameDayElement)
+
+      const times = [
+        ["yesterday", -1],
+        ["five-days-ago", -5],
+        ["tomorrow", 1],
+        ["in-three-days", 3]
+      ]
+
+      for (const [id, days] of times) {
+        const date = new Date(now)
+        date.setDate(date.getDate() + days)
+        date.setHours(12, 0, 0, 0)
+
+        const element = document.createElement("time")
+        element.id = id
+        element.dateTime = date.toISOString()
+        element.dataset.controller = "local-time"
+        document.body.append(element)
+      }
+    JS
+
+    same_day = find("time#same-day")
+    assert_equal same_day["data-expected"], same_day.text
+    assert_selector "time#yesterday", text: "yesterday"
+    assert_selector "time#five-days-ago", text: "5 days ago"
+    assert_selector "time#tomorrow", text: "tomorrow"
+    assert_selector "time#in-three-days", text: "in 3 days"
+  end
+end
