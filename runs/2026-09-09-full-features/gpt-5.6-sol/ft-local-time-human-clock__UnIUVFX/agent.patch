diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..7c3d210
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,98 @@
+import { Controller } from "@hotwired/stimulus"
+
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1000
+
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    this.render()
+  }
+
+  render() {
+    const date = new Date(this.element.dateTime)
+
+    if (!Number.isNaN(date.valueOf())) {
+      this.element.textContent = this.formattedDate(date)
+      this.element.title = this.fullDateTime(date)
+    }
+  }
+
+  formattedDate(date) {
+    switch (this.formatValue) {
+      case "time":
+        return this.time(date)
+      case "date":
+        return this.date(date)
+      case "full-date":
+        return this.fullDate(date)
+      case "numeric":
+        return this.numericDateTime(date)
+      case "relative":
+        return this.relativeTime(date)
+      default:
+        return this.conversationalDate(date)
+    }
+  }
+
+  conversationalDate(date) {
+    const days = this.differenceInDays(date, new Date())
+
+    if (days === 0) return this.time(date)
+    if (days === -1) return "yesterday"
+    if (days === 1) return "tomorrow"
+    if (days > -7 && days < 0) return `${Math.abs(days)} days ago`
+    if (days < 7 && days > 0) return `in ${days} days`
+
+    return this.date(date)
+  }
+
+  relativeTime(date) {
+    const seconds = Math.round((date - new Date()) / 1000)
+    const absoluteSeconds = Math.abs(seconds)
+
+    if (absoluteSeconds < 60) return this.relativeTimeFormatter().format(seconds, "second")
+    if (absoluteSeconds < 60 * 60) return this.relativeTimeFormatter().format(Math.round(seconds / 60), "minute")
+    if (absoluteSeconds < DAY_IN_MILLISECONDS / 1000) return this.relativeTimeFormatter().format(Math.round(seconds / (60 * 60)), "hour")
+
+    return this.relativeTimeFormatter().format(this.differenceInDays(date, new Date()), "day")
+  }
+
+  differenceInDays(date, now) {
+    return Math.round((this.beginningOfDay(date) - this.beginningOfDay(now)) / DAY_IN_MILLISECONDS)
+  }
+
+  beginningOfDay(date) {
+    return Date.UTC(date.getFullYear(), date.getMonth(), date.getDate())
+  }
+
+  time(date) {
+    return new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" }).format(date)
+  }
+
+  date(date) {
+    const options = { month: "short", day: "numeric" }
+    if (date.getFullYear() !== new Date().getFullYear()) options.year = "numeric"
+    return new Intl.DateTimeFormat(undefined, options).format(date)
+  }
+
+  fullDate(date) {
+    return new Intl.DateTimeFormat(undefined, { year: "numeric", month: "short", day: "numeric" }).format(date)
+  }
+
+  numericDateTime(date) {
+    return new Intl.DateTimeFormat(undefined, {
+      year: "2-digit", month: "numeric", day: "numeric", hour: "numeric", minute: "2-digit"
+    }).format(date)
+  }
+
+  fullDateTime(date) {
+    return new Intl.DateTimeFormat(undefined, {
+      dateStyle: "full", timeStyle: "short"
+    }).format(date)
+  }
+
+  relativeTimeFormatter() {
+    return new Intl.RelativeTimeFormat(undefined, { numeric: "always" })
+  }
+}
