diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..a0d985c
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,60 @@
+const DAY_IN_MILLISECONDS = 24 * 60 * 60 * 1000
+
+export function formatLocalTime(date, style = "datetime", now = new Date()) {
+  switch (style) {
+    case "time":
+      return time(date)
+    case "date":
+      return shortDate(date, now)
+    case "weekday-date":
+      return weekdayDate(date)
+    case "numeric-datetime":
+      return numericDateTime(date)
+    default:
+      return relativeDateTime(date, now)
+  }
+}
+
+export function formatExactLocalTime(date) {
+  return new Intl.DateTimeFormat("en-US", { dateStyle: "full", timeStyle: "short" }).format(date)
+}
+
+function relativeDateTime(date, now) {
+  const days = differenceInCalendarDays(date, now)
+
+  if (days === 0) return time(date)
+  if (days === -1) return "yesterday"
+  if (days === 1) return "tomorrow"
+  if (days < 0 && days >= -6) return `${Math.abs(days)} days ago`
+  if (days > 0 && days <= 6) return `in ${days} days`
+
+  return shortDate(date, now)
+}
+
+function differenceInCalendarDays(date, now) {
+  const localDate = Date.UTC(date.getFullYear(), date.getMonth(), date.getDate())
+  const localToday = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate())
+
+  return Math.round((localDate - localToday) / DAY_IN_MILLISECONDS)
+}
+
+function time(date) {
+  return new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }).format(date)
+}
+
+function shortDate(date, now) {
+  const options = { month: "short", day: "numeric" }
+  if (date.getFullYear() !== now.getFullYear()) options.year = "numeric"
+
+  return new Intl.DateTimeFormat("en-US", options).format(date)
+}
+
+function weekdayDate(date) {
+  return new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" }).format(date)
+}
+
+function numericDateTime(date) {
+  return new Intl.DateTimeFormat("en-US", {
+    year: "2-digit", month: "numeric", day: "numeric", hour: "numeric", minute: "2-digit"
+  }).format(date)
+}
