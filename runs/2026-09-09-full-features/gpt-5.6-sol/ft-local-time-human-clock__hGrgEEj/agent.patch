+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local time tags contain a raw timestamp for browser rendering" do
+    timestamp = Time.utc(2024, 9, 12, 17, 42, 3)
+
+    html = local_time_tag(timestamp, style: :datetime, class: "timestamp", data: { controller: "tooltip" })
+
+    assert_select parse(html), "time.timestamp[datetime='2024-09-12T17:42:03Z'][data-controller='tooltip local-time'][data-local-time-style-value='datetime']", text: "2024-09-12T17:42:03Z"
+  end
+
+  test "local time tag output does not depend on the server timezone" do
+    timestamp = Time.utc(2024, 9, 12, 17, 42, 3)
+
+    utc_html = Time.use_zone("UTC") { local_time_tag(timestamp) }
+    pacific_html = Time.use_zone("Pacific Time (US & Canada)") { local_time_tag(timestamp) }
+
+    assert_equal utc_html, pacific_html
+  end
+
+  private
+    def parse(html)
+      Nokogiri::HTML::DocumentFragment.parse(html)
+    end
+end
