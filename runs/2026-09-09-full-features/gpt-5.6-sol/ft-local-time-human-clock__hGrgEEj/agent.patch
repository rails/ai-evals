@@ -0,0 +1,15 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatExactLocalTime, formatLocalTime } from "helpers/local_time_helpers"
+
+export default class extends Controller {
+  static values = { style: { type: String, default: "datetime" } }
+
+  connect() {
+    const date = new Date(this.element.dateTime)
+
+    if (!Number.isNaN(date.valueOf())) {
+      this.element.textContent = formatLocalTime(date, this.styleValue)
+      this.element.title = formatExactLocalTime(date)
+    }
+  }
+}
