diff --git a/lib/rails_ext/account_owned_framework_records.rb b/lib/rails_ext/account_owned_framework_records.rb
new file mode 100644
index 0000000..7549fbc
--- /dev/null
+++ b/lib/rails_ext/account_owned_framework_records.rb
@@ -0,0 +1,18 @@
+# Action Text and Active Storage are account data too, but their models live in
+# framework engines. Keep their tenant ownership alongside the application
+# models using the engine load hooks.
+ActiveSupport.on_load :action_text_rich_text do
+  belongs_to :account, default: -> { record.account }
+end
+
+ActiveSupport.on_load :active_storage_attachment do
+  belongs_to :account, default: -> { record.respond_to?(:account) ? record.account : Current.account }
+end
+
+ActiveSupport.on_load :active_storage_blob do
+  belongs_to :account, default: -> { Current.account }
+end
