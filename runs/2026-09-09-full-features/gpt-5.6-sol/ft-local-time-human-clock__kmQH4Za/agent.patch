diff --git a/test/helpers/browser_time_rendering_test.rb b/test/helpers/browser_time_rendering_test.rb
new file mode 100644
index 0000000..e6b1c8a
--- /dev/null
+++ b/test/helpers/browser_time_rendering_test.rb
@@ -0,0 +1,14 @@
+require "test_helper"
+
+class BrowserTimeRenderingTest < ActiveSupport::TestCase
+  test "browser views do not format timestamps on the server" do
+    browser_views = Dir[Rails.root.join("app/views/**/*.html.erb")].reject { |path| path.include?("/mailers/") }
+    rendered_timestamp_patterns = /time_ago_in_words|\.strftime\(/
+
+    offenders = browser_views.filter_map do |path|
+      path.delete_prefix("#{Rails.root}/") if File.read(path).match?(rendered_timestamp_patterns)
+    end
+
+    assert_empty offenders, "Server-rendered timestamps found in: #{offenders.join(', ')}"
+  end
+end
diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..3467f5a
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local time sends a raw UTC timestamp for browser rendering" do
+    timestamp = Time.zone.parse("2025-09-12 13:42:00 -0400")
+    element = Nokogiri::HTML::DocumentFragment.parse(local_time_tag(timestamp, format: :comment)).at_css("time")
+
+    assert_equal "2025-09-12T17:42:00Z", element["datetime"]
+    assert_equal "local-time", element["data-controller"]
+    assert_equal "comment", element["data-local-time-format-value"]
+    assert_empty element.text
+  end
+
+  test "local time accepts HTML options" do
+    element = Nokogiri::HTML::DocumentFragment.parse(local_time_tag(Time.current, format: :date, class: "timestamp")).at_css("time.timestamp")
+
+    assert element
+  end
+
+  test "local time preserves another controller" do
+  html = local_time_tag(Time.current, data: { controller: "tooltip" })
+  element = Nokogiri::HTML::DocumentFragment.parse(html).at_css("time")
+
+  assert_equal "tooltip local-time", element["data-controller"]
+end
+
+test "local time renders nothing without a timestamp" do
+    assert_nil local_time_tag(nil)
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..5215dd7
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,34 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+    visit board_url(boards(:writebook))
+  end
+
+  test "renders timestamps with the viewer's calendar and clock" do
+    insert_local_time :today, days_from_today: 0, hour: 13, minute: 42, format: "comment"
+    insert_local_time :yesterday, days_from_today: -1, format: "comment"
+    insert_local_time :earlier_this_week, days_from_today: -5, format: "comment"
+    insert_local_time :tomorrow, days_from_today: 1, format: "future"
+    insert_local_time :three_days_from_now, days_from_today: 3, format: "future"
+
+    assert_selector "#today", text: "1:42 PM"
+    assert_selector "#yesterday", text: "yesterday"
+    assert_selector "#earlier_this_week", text: "5 days ago"
+    assert_selector "#tomorrow", text: "tomorrow"
+    assert_selector "#three_days_from_now", text: "in 3 days"
+  end
+
+  private
+    def insert_local_time(id, days_from_today:, format:, hour: 12, minute: 0)
+      page.execute_script <<~JS
+        (() => {
+          const timestamp = new Date()
+          timestamp.setDate(timestamp.getDate() + #{days_from_today})
+          timestamp.setHours(#{hour}, #{minute}, 0, 0)
+          document.body.insertAdjacentHTML("beforeend", `<time id="#{id}" datetime="${timestamp.toISOString()}" data-controller="local-time" data-local-time-format-value="#{format}"></time>`)
+        })()
+      JS
+    end
+end
