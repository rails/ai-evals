diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..ef10eb8
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,112 @@
+import { Controller } from "@hotwired/stimulus"
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.update()
+    this.refreshTimer = setInterval(() => this.update(), REFRESH_INTERVAL)
+  }
+
+  disconnect() {
+    clearInterval(this.refreshTimer)
+  }
+
+  update() {
+    const timestamp = new Date(this.element.dateTime)
+
+    if (!Number.isNaN(timestamp.valueOf())) {
+      this.element.textContent = this.#format(timestamp)
+      this.element.title = this.#dateTime(timestamp)
+    }
+  }
+
+  #format(timestamp) {
+    switch (this.formatValue) {
+      case "comment":
+        return this.#comment(timestamp)
+      case "future":
+        return this.#future(timestamp)
+      case "date":
+        return this.#date(timestamp)
+      case "full-date":
+        return this.#fullDate(timestamp)
+      case "long-date":
+        return this.#longDate(timestamp)
+      case "time":
+        return this.#time(timestamp)
+      case "date-time":
+        return this.#dateTime(timestamp)
+      default:
+        return this.#relative(timestamp)
+    }
+  }
+
+  #comment(timestamp) {
+    const daysAgo = signedDifferenceInDays(timestamp, new Date())
+
+    if (daysAgo === 0) {
+      return this.#time(timestamp)
+    } else if (daysAgo === 1) {
+      return "yesterday"
+    } else if (daysAgo > 1 && daysAgo < 7) {
+      return `${daysAgo} days ago`
+    } else {
+      return this.#date(timestamp)
+    }
+  }
+
+  #relative(timestamp) {
+    const difference = signedDifferenceInDays(timestamp, new Date())
+
+    if (difference >= 0) {
+      return this.#comment(timestamp)
+    } else {
+      return this.#future(timestamp)
+    }
+  }
+
+  #future(timestamp) {
+    const daysAway = signedDifferenceInDays(new Date(), timestamp)
+
+    if (daysAway === 0) {
+      return "today"
+    } else if (daysAway === 1) {
+      return "tomorrow"
+    } else if (daysAway > 1) {
+      return `in ${daysAway} days`
+    } else if (daysAway === -1) {
+      return "yesterday"
+    } else {
+      return `${Math.abs(daysAway)} days ago`
+    }
+  }
+
+  #date(timestamp) {
+    const options = { month: "short", day: "numeric" }
+    if (timestamp.getFullYear() !== new Date().getFullYear()) options.year = "numeric"
+
+    return new Intl.DateTimeFormat("en-US", options).format(timestamp)
+  }
+
+  #fullDate(timestamp) {
+    return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(timestamp)
+  }
+
+  #longDate(timestamp) {
+    return new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" }).format(timestamp)
+  }
+
+  #time(timestamp) {
+    return new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }).format(timestamp)
+  }
+
+  #dateTime(timestamp) {
+    return new Intl.DateTimeFormat("en-US", {
+      year: "numeric", month: "numeric", day: "numeric", hour: "numeric", minute: "2-digit"
+    }).format(timestamp)
+  }
+}
