diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..d85e7e3
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "index returns accessible timeline activity as JSON" do
+    title_event = create_event(action: "card_title_changed", particulars: { old_title: "Old & stale", new_title: "New title" }, created_at: 1.minute.ago)
+    create_event(action: "card_collection_changed", created_at: Time.current)
+
+    get activities_path(format: :json)
+
+    assert_response :success
+    activities = @response.parsed_body
+    assert_kind_of Array, activities
+    assert_equal title_event.id, activities.first["id"]
+    assert_not_includes activities.pluck("action"), "card_collection_changed"
+    assert_includes activities.pluck("action"), "card_title_changed"
+
+    activity = activities.find { |candidate| candidate["id"] == title_event.id }
+    assert_equal %w[action board created_at creator description eventable eventable_type id particulars url], activity.keys.sort
+    assert_equal "card_title_changed", activity["action"]
+    assert_equal({ "old_title" => "Old & stale", "new_title" => "New title" }, activity["particulars"])
+    assert_equal card_url(cards(:logo)), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_includes activity["description"], "Old & stale"
+    assert_not_includes activity["description"], "&amp;"
+  end
+
+  test "comment activity links to its card and comment" do
+    event = events(:layout_commented)
+
+    get activities_path(format: :json), params: { creator_ids: [ event.creator_id ] }
+
+    activity = @response.parsed_body.find { |candidate| candidate["id"] == event.id }
+    assert_equal card_url(event.card, anchor: dom_id(event.eventable)), activity["url"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal event.eventable.id, activity.dig("eventable", "id")
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "returns event-specific particulars with missing values as empty strings" do
+    board_event = create_event(action: "card_board_changed", particulars: { new_board: nil })
+    title_event = create_event(action: "card_title_changed", particulars: { old_title: nil })
+    triage_event = create_event(action: "card_triaged", particulars: { column: nil })
+    assignment_event = Event.create!(board: boards(:writebook), eventable: cards(:logo), action: "card_assigned", particulars: { assignee_ids: [ users(:jz).id ] }, creator: users(:david))
+
+    get activities_path(format: :json)
+
+    activities = @response.parsed_body.index_by { |activity| activity["id"] }
+    assert_equal({ "old_board" => "", "new_board" => "" }, activities.dig(board_event.id, "particulars"))
+    assert_equal({ "old_title" => "", "new_title" => "" }, activities.dig(title_event.id, "particulars"))
+    assert_equal({ "column" => "" }, activities.dig(triage_event.id, "particulars"))
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activities.dig(assignment_event.id, "particulars"))
+  end
+
+  test "filters by creators and accessible boards" do
+    inaccessible_board = boards(:private)
+    inaccessible_event = create_event(board: inaccessible_board, action: "card_published", eventable: cards(:logo))
+
+    get activities_path(format: :json), params: {
+      creator_ids: [ users(:kevin).id ],
+      board_ids: [ boards(:writebook).id, inaccessible_board.id ]
+    }
+
+    activities = @response.parsed_body
+    assert activities.any?
+    assert activities.all? { |activity| activity.dig("creator", "id") == users(:kevin).id }
+    assert activities.all? { |activity| activity.dig("board", "id") == boards(:writebook).id }
+    assert_not_includes activities.pluck("id"), inaccessible_event.id
+  end
+
+  test "paginates a flat newest-first array" do
+    101.times { |index| create_event(created_at: index.seconds.ago) }
+
+    get activities_path(format: :json)
+
+    assert_equal 15, @response.parsed_body.size
+    assert_equal @response.parsed_body.pluck("created_at").sort.reverse, @response.parsed_body.pluck("created_at")
+    assert_match(/rel="next"/, response.headers["Link"])
+    assert_operator response.headers["X-Total-Count"].to_i, :>, 100
+  end
+
+  private
+    def create_event(board: boards(:writebook), eventable: cards(:logo), action: "card_published", particulars: {}, created_at: Time.current)
+      Event.create!(board:, eventable:, action:, particulars: { particulars: }, creator: users(:david), created_at:)
+    end
+end
