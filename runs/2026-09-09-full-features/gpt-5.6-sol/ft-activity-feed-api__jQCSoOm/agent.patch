@@ -0,0 +1,15 @@
+eventable_partial, eventable_local = case activity.eventable
+when Card
+  [ "cards/card", :card ]
+when Comment
+  [ "cards/comments/comment", :comment ]
+end
+
+json.(activity, :id, :action, :eventable_type)
+json.created_at activity.created_at.utc
+json.description CGI.unescapeHTML(activity.description_for(Current.user).to_plain_text.to_s)
+json.particulars activity.api_particulars
+json.url card_url(activity.card, anchor: activity.action.comment_created? ? dom_id(activity.eventable) : nil)
+json.eventable activity.eventable, partial: eventable_partial, as: eventable_local
+json.board activity.board, partial: "boards/board", as: :board
+json.creator activity.creator, partial: "users/user", as: :user
