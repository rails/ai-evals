diff --git a/app/models/event.rb b/app/models/event.rb
index bbbf2a6..f5a802f 100644
--- a/app/models/event.rb
+++ b/app/models/event.rb
@@ -1,4 +1,19 @@
 class Event < ApplicationRecord
+  API_ACTIVITY_ACTIONS = %w[
+    card_assigned
+    card_unassigned
+    card_published
+    card_closed
+    card_reopened
+    card_board_changed
+    card_postponed
+    card_auto_postponed
+    card_triaged
+    card_sent_back_to_triage
+    card_title_changed
+    comment_created
+  ].freeze
+
   include Notifiable, Particulars, Promptable
 
   belongs_to :account, default: -> { board.account }
@@ -25,6 +40,17 @@ class Event < ApplicationRecord
 
   delegate :card, to: :eventable
 
+  class << self
+    def api_activities_for(user, creator_ids: [], board_ids: [])
+      accessible_boards = user.boards
+      accessible_boards = accessible_boards.where(id: board_ids) if board_ids.present?
+
+      events = preloaded.where(board: accessible_boards, action: API_ACTIVITY_ACTIONS)
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events.order(created_at: :desc, id: :desc)
+    end
+  end
+
   def action
     super.inquiry
   end
@@ -37,6 +63,24 @@ class Event < ApplicationRecord
     Event::Description.new(self, user)
   end
 
+  def api_particulars
+    stored_particulars = particulars || {}
+    details = (stored_particulars.fetch("particulars", stored_particulars) || {}).with_indifferent_access
+
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(details[:assignee_ids]) }
+    when "card_board_changed"
+      { old_board: details[:old_board].presence || "", new_board: details[:new_board].presence || "" }
+    when "card_title_changed"
+      { old_title: details[:old_title].presence || "", new_title: details[:new_title].presence || "" }
+    when "card_triaged"
+      { column: details[:column].presence || "" }
+    else
+      {}
+    end
+  end
+
   private
     def dispatch_webhooks
       Event::WebhookDispatchJob.perform_later(self)
