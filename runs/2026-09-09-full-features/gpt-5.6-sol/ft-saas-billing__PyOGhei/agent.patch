diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..f30a9b2
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,35 @@
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[active trialing past_due].freeze
+
+  belongs_to :account
+
+  validates :plan_key, inclusion: { in: Account::Plan::PLANS.keys }
+  validates :stripe_customer_id, :stripe_subscription_id, :status, presence: true
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def plan
+    Account::Plan[plan_key]
+  end
+
+  def apply_stripe_subscription(stripe_subscription)
+    update!(
+      plan_key: plan_key_from(stripe_subscription),
+      stripe_customer_id: stripe_subscription.customer,
+      status: stripe_subscription.status,
+      current_period_end: timestamp(stripe_subscription.current_period_end),
+      cancel_at: timestamp(stripe_subscription.cancel_at)
+    )
+  end
+
+  private
+    def plan_key_from(stripe_subscription)
+      Account::Plan.key_for_subscription(stripe_subscription) || stripe_subscription.metadata["plan"] || plan_key
+    end
+
+    def timestamp(value)
+      Time.zone.at(value) if value.present?
+    end
+end
