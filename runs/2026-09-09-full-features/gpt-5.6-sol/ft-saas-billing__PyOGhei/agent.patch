diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..2436ec2
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,59 @@
+class Stripe::WebhooksController < ActionController::Base
+  skip_forgery_protection
+
+  def create
+    event = ::Stripe::Webhook.construct_event(request.raw_post, request.headers["Stripe-Signature"], ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+    process_event(event)
+    head :ok
+  rescue JSON::ParserError, ::Stripe::SignatureVerificationError
+    head :bad_request
+  end
+
+  private
+    def process_event(event)
+      case event.type
+      when "customer.subscription.created", "customer.subscription.updated"
+        apply_subscription(event.data.object)
+      when "customer.subscription.deleted"
+        delete_subscription(event.data.object)
+      end
+    end
+
+    def apply_subscription(stripe_subscription)
+      account = account_for(stripe_subscription)
+      return unless account
+
+      plan_key = plan_key_for(stripe_subscription)
+      subscription = Account::Subscription.find_by(stripe_subscription_id: stripe_subscription.id) || Account::Subscription.find_or_initialize_by(account_id: account.id)
+      subscription.account = account
+      subscription.stripe_subscription_id = stripe_subscription.id
+      subscription.plan_key = plan_key
+      subscription.stripe_customer_id = stripe_subscription.customer
+      subscription.status = stripe_subscription.status
+      subscription.current_period_end = timestamp(stripe_subscription.current_period_end)
+      subscription.cancel_at = timestamp(stripe_subscription.cancel_at)
+      subscription.save!
+    end
+
+    def delete_subscription(stripe_subscription)
+      if subscription = Account::Subscription.find_by(stripe_subscription_id: stripe_subscription.id)
+        subscription.update!(status: "canceled", cancel_at: Time.current)
+      end
+    end
+
+    def account_for(stripe_subscription)
+      if account_id = stripe_subscription.metadata["account_id"]
+        Account.find_by(id: account_id)
+      else
+        Account::Subscription.find_by(stripe_customer_id: stripe_subscription.customer)&.account
+      end
+    end
+
+    def plan_key_for(stripe_subscription)
+      Account::Plan.key_for_subscription(stripe_subscription) || stripe_subscription.metadata["plan"] || "free"
+    end
+
+    def timestamp(value)
+      Time.zone.at(value) if value.present?
+    end
+end
diff --git a/saas/app/models/account/billable.rb b/saas/app/models/account/billable.rb
new file mode 100644
index 0000000..58669e4
--- /dev/null
+++ b/saas/app/models/account/billable.rb
@@ -0,0 +1,81 @@
+module Account::Billable
+  extend ActiveSupport::Concern
+
+  CARD_LIMIT_WARNING_THRESHOLD = 100
+
+  included do
+    has_one :account_subscription, class_name: "Account::Subscription"
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit"
+    has_one :billing_waiver, class_name: "Account::BillingWaiver"
+  end
+
+  def billing_plan
+    if billing_waiver
+      Account::Plan["unlimited"]
+    elsif account_subscription&.active?
+      account_subscription.plan
+    else
+      Account::Plan.free
+    end
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    association(:billing_waiver).reset
+  end
+
+  def card_limit
+    plan.card_limit
+  end
+
+  def billable_card_count
+    overridden_limit&.card_count || cards_count
+  end
+
+  def cards_remaining
+    [ card_limit - billable_card_count, 0 ].max if card_limit
+  end
+
+  def card_limit_reached?
+    card_limit.present? && billable_card_count >= card_limit
+  end
+
+  def nearing_card_limit?
+    cards_remaining.present? && cards_remaining.positive? && cards_remaining <= CARD_LIMIT_WARNING_THRESHOLD
+  end
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  def storage_limit
+    storage_exception&.bytes_allowed || plan.storage_limit
+  end
+
+  def override_usage(card_count:, bytes_used:)
+    attributes = { card_count: optional_integer(card_count), bytes_used: optional_integer(bytes_used) }
+    if overridden_limit
+      overridden_limit.update!(attributes)
+    else
+      create_overridden_limit!(attributes)
+    end
+  end
+
+  def reset_usage_override
+    overridden_limit&.destroy!
+    association(:overridden_limit).reset
+  end
+
+  private
+    def optional_integer(value)
+      value.present? ? Integer(value) : nil
+    end
+end
