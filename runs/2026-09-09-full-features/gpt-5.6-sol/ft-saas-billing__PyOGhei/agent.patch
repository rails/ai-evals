diff --git a/saas/test/controllers/stripe_billing_controller_test.rb b/saas/test/controllers/stripe_billing_controller_test.rb
new file mode 100644
index 0000000..a96e585
--- /dev/null
+++ b/saas/test/controllers/stripe_billing_controller_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+require "ostruct"
+
+class StripeBillingControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+    @old_price = ENV["STRIPE_UNLIMITED_PRICE_ID"]
+    @old_secret = ENV["STRIPE_WEBHOOK_SECRET"]
+    ENV["STRIPE_UNLIMITED_PRICE_ID"] = "price_unlimited"
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+  end
+
+  teardown do
+    ENV["STRIPE_UNLIMITED_PRICE_ID"] = @old_price
+    ENV["STRIPE_WEBHOOK_SECRET"] = @old_secret
+  end
+
+  test "checkout redirects to Stripe hosted checkout" do
+    sign_in_as :kevin
+    ::Stripe::Checkout::Session.expects(:create).with do |attributes|
+      attributes[:line_items] == [ { price: "price_unlimited", quantity: 1 } ] &&
+        attributes.dig(:subscription_data, :metadata, :account_id) == @account.id
+    end.returns(OpenStruct.new(url: "https://checkout.stripe.test/session"))
+
+    post saas.billing_checkout_path(plan: "unlimited")
+    assert_redirected_to "https://checkout.stripe.test/session"
+  end
+
+  test "portal redirects to Stripe hosted customer portal" do
+    Account::Subscription.create!(account: @account, plan_key: "unlimited", stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", status: "active")
+    sign_in_as :kevin
+    ::Stripe::BillingPortal::Session.expects(:create).with(has_entry(customer: "cus_1")).returns(OpenStruct.new(url: "https://billing.stripe.test/portal"))
+
+    post saas.billing_portal_path
+    assert_redirected_to "https://billing.stripe.test/portal"
+  end
+
+  test "subscription webhook activates and deletes a plan" do
+    stripe_subscription = subscription_object(status: "active")
+    event = OpenStruct.new(type: "customer.subscription.created", data: OpenStruct.new(object: stripe_subscription))
+    ::Stripe::Webhook.expects(:construct_event).with(anything, anything, "whsec_test").returns(event)
+
+    untenanted { post "/stripe/webhooks", params: "{}", headers: { "Stripe-Signature" => "signature" } }
+    assert_response :ok
+    assert_equal "Unlimited", @account.reload.plan.name
+
+    deleted_event = OpenStruct.new(type: "customer.subscription.deleted", data: OpenStruct.new(object: stripe_subscription))
+    ::Stripe::Webhook.expects(:construct_event).returns(deleted_event)
+    untenanted { post "/stripe/webhooks", params: "{}", headers: { "Stripe-Signature" => "signature" } }
+    assert_equal "Free", @account.reload.plan.name
+  end
+
+  test "invalid webhook signature is rejected" do
+    ::Stripe::Webhook.expects(:construct_event).raises(::Stripe::SignatureVerificationError.new("bad", "sig"))
+    untenanted { post "/stripe/webhooks", params: "{}", headers: { "Stripe-Signature" => "bad" } }
+    assert_response :bad_request
+  end
+
+  private
+    def subscription_object(status:)
+      OpenStruct.new(
+        id: "sub_1", customer: "cus_1", status: status,
+        metadata: { "account_id" => @account.id, "plan" => "unlimited" },
+        items: OpenStruct.new(data: [ OpenStruct.new(price: OpenStruct.new(id: "price_unlimited")) ]),
+        current_period_end: 1.month.from_now.to_i, cancel_at: nil
+      )
+    end
+end
diff --git a/saas/test/integration/billing_edges_test.rb b/saas/test/integration/billing_edges_test.rb
new file mode 100644
index 0000000..69ea477
--- /dev/null
+++ b/saas/test/integration/billing_edges_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class BillingEdgesTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "card warning starts with 100 cards remaining" do
+    @account.update!(cards_count: 900)
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+
+    @account.update!(cards_count: 899)
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "active paid plan has unlimited cards and its storage allowance" do
+    Account::Subscription.create!(account: @account, plan_key: "unlimited_plus", stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", status: "active")
+    @account.reload.update!(cards_count: 100_000)
+
+    assert_equal "Unlimited+", @account.plan.name
+    assert_nil @account.card_limit
+    assert_not @account.card_limit_reached?
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "canceled subscription falls back to free" do
+    Account::Subscription.create!(account: @account, plan_key: "unlimited", stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", status: "canceled")
+    assert_equal "Free", @account.reload.plan.name
+  end
+
+  test "non-admin cannot start checkout" do
+    sign_in_as :david
+    post saas.billing_checkout_path(plan: "unlimited")
+    assert_response :forbidden
+  end
+
+  test "staff account tools list and show accounts" do
+    sign_in_as :david
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :success
+      assert_select "a", text: @account.name
+
+      get saas.admin_account_path(@account)
+      assert_response :success
+      assert_select "button", text: "Comp"
+      assert_select "label", text: "Card count"
+      assert_select "label", text: "Bytes used"
+    end
+  end
+
+  test "non-staff cannot access account tools" do
+    sign_in_as :jz
+    untenanted do
+      get saas.admin_accounts_path
+      assert_response :forbidden
+    end
+  end
+end
diff --git a/saas/test/integration/billing_test.rb b/saas/test/integration/billing_test.rb
new file mode 100644
index 0000000..53fe762
--- /dev/null
+++ b/saas/test/integration/billing_test.rb
@@ -0,0 +1,59 @@
+require "test_helper"
+
+class BillingTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "approved plan limits" do
+    assert_equal [ "Unlimited", "Unlimited+" ], Account::Plan.paid.map(&:name)
+    assert_equal [ 20, 25 ], Account::Plan.paid.map(&:price)
+    assert_equal 1_000, Account::Plan.free.card_limit
+    assert_equal 1.gigabyte, Account::Plan.free.storage_limit
+    assert_equal [ 5.gigabytes, 500.gigabytes ], Account::Plan.paid.map(&:storage_limit)
+  end
+
+  test "free account at card limit can draft but cannot publish or create through API" do
+    sign_in_as :kevin
+    @account.update!(cards_count: 1_000)
+
+    assert_difference -> { Card.count }, 1 do
+      post board_cards_path(boards(:writebook))
+    end
+    assert_response :redirect
+
+    card = Card.last
+    assert card.drafted?
+    post card_publish_path(card)
+    assert_response :forbidden
+    assert card.reload.drafted?
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(boards(:writebook)), params: { card: { title: "No" } }, as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "admins see plan and upgrade in settings" do
+    sign_in_as :kevin
+    get account_settings_path
+    assert_response :success
+    assert_select ".settings-subscription", text: /Free/
+    assert_select "form button", text: "Upgrade"
+  end
+
+  test "staff can comp and override account usage" do
+    sign_in_as :david
+    untenanted do
+      post saas.admin_account_comp_path(@account)
+      assert @account.reload.comped?
+
+      post saas.admin_account_override_path(@account), params: { override: { card_count: 900, bytes_used: 1234 } }
+      assert_equal 900, @account.reload.billable_card_count
+      assert_equal 1234, @account.bytes_used
+
+      delete saas.admin_account_override_path(@account)
+      assert_nil @account.reload.overridden_limit
+    end
+  end
+end
