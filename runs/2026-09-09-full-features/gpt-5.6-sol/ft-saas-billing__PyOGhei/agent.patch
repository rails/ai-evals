diff --git a/saas/app/models/account/plan.rb b/saas/app/models/account/plan.rb
new file mode 100644
index 0000000..bb0cb20
--- /dev/null
+++ b/saas/app/models/account/plan.rb
@@ -0,0 +1,66 @@
+class Account::Plan
+  include ActiveModel::Model
+
+  PLANS = {
+    "free" => { name: "Free", price: 0, card_limit: 1_000, storage_limit: 1.gigabyte },
+    "unlimited" => { name: "Unlimited", price: 20, card_limit: nil, storage_limit: 5.gigabytes },
+    "unlimited_plus" => { name: "Unlimited+", price: 25, card_limit: nil, storage_limit: 500.gigabytes }
+  }.freeze
+
+  attr_reader :key
+
+  class << self
+    def [](key)
+      new(key: key.to_s) if PLANS.key?(key.to_s)
+    end
+
+    def free
+      self["free"]
+    end
+
+    def paid
+      PLANS.keys.drop(1).map { |key| self[key] }
+    end
+
+    def key_for_price(price_id)
+      price_ids.key(price_id)
+    end
+
+    def checkout_price_ids_for(key)
+      if key.to_s == "unlimited_plus" && ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"].blank?
+        [ price_ids["unlimited"], price_ids["unlimited_plus"] ].compact
+      else
+        [ price_ids[key.to_s] ].compact
+      end
+    end
+
+    def key_for_subscription(stripe_subscription)
+      keys = stripe_subscription.items.data.filter_map { |item| key_for_price(item.price.id) }
+      keys.include?("unlimited_plus") ? "unlimited_plus" : keys.first
+    end
+
+    private
+      def price_ids
+        {
+          "unlimited" => ENV["STRIPE_UNLIMITED_PRICE_ID"] || ENV["STRIPE_MONTHLY_V1_PRICE_ID"],
+          "unlimited_plus" => ENV["STRIPE_UNLIMITED_PLUS_PRICE_ID"] || ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"]
+        }.compact
+      end
+  end
+
+  def initialize(key:)
+    @key = key.to_s
+    raise ArgumentError, "Unknown plan: #{key}" unless PLANS.key?(@key)
+  end
+
+  def name = attributes.fetch(:name)
+  def price = attributes.fetch(:price)
+  def card_limit = attributes.fetch(:card_limit)
+  def storage_limit = attributes.fetch(:storage_limit)
+  def paid? = price.positive?
+
+  private
+    def attributes
+      PLANS.fetch(key)
+    end
+end
