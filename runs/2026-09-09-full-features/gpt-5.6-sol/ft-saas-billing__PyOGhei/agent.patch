diff --git a/saas/app/controllers/billing/checkouts_controller.rb b/saas/app/controllers/billing/checkouts_controller.rb
new file mode 100644
index 0000000..489c195
--- /dev/null
+++ b/saas/app/controllers/billing/checkouts_controller.rb
@@ -0,0 +1,23 @@
+class Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = Account::Plan[params[:plan]]
+    price_ids = Account::Plan.checkout_price_ids_for(plan&.key)
+    head :unprocessable_entity and return unless plan&.paid? && price_ids.any?
+
+    session = Stripe::Checkout::Session.create(
+      mode: "subscription",
+      line_items: price_ids.map { |price_id| { price: price_id, quantity: 1 } },
+      customer: Current.account.account_subscription&.stripe_customer_id,
+      customer_email: Current.account.account_subscription ? nil : Current.account.owner_email,
+      client_reference_id: Current.account.id,
+      metadata: { account_id: Current.account.id, plan: plan.key },
+      subscription_data: { metadata: { account_id: Current.account.id, plan: plan.key } },
+      success_url: account_settings_url(script_name: Current.account.slug),
+      cancel_url: account_settings_url(script_name: Current.account.slug)
+    )
+
+    redirect_to session.url, allow_other_host: true
+  end
+end
