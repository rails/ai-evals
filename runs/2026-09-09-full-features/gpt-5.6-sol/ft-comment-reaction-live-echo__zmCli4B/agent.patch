index 0000000..3350d9d
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,39 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "form", "input", "reaction", "trigger" ]
+
+  connect() {
+    this.reactionTargets.forEach(reaction => {
+      if (this.#isCurrentUsers(reaction)) reaction.classList.add("reaction--deleteable")
+    })
+  }
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.focus()
+  }
+
+  cancel() {
+    this.formTarget.reset()
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  revealDeletion(event) {
+    const reaction = event.currentTarget
+
+    if (this.#isCurrentUsers(reaction)) {
+      this.reactionTargets.forEach(element => element.classList.remove("expanded"))
+      reaction.classList.add("expanded")
+    }
+  }
+
+  #isCurrentUsers(reaction) {
+    return reaction.dataset.creatorId === window.Current.user?.id
+  }
+}
