@@ -0,0 +1,55 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params)
+
+    if @reaction.save
+      render_reactions
+    else
+      render_reactions status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+    render_reactions
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden if Current.user != @reaction.creator
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+
+    def reaction_for_form
+      if @reaction.errors.any?
+        @reaction
+      else
+        @comment.reactions.build
+      end
+    end
+
+    def render_reactions(status: :ok)
+      render turbo_stream: turbo_stream.replace(
+        ActionView::RecordIdentifier.dom_id(@comment, :reactions),
+        partial: "cards/comments/reactions",
+        locals: { comment: @comment, reaction: reaction_for_form }
+      ), status: status
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
