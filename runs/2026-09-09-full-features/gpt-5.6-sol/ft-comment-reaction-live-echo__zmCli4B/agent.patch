index 0000000..ba35b73
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "🚀" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal users(:kevin), Reaction.last.creator
+  end
+
+  test "invalid create renders errors without creating a reaction" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "a" * 17 } }, as: :turbo_stream
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "destroy your own reaction" do
+    reaction = @comment.reactions.create!(creator: users(:kevin), content: "Yes")
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+  end
+
+  test "cannot destroy someone else's reaction" do
+    reaction = @comment.reactions.create!(creator: users(:jz), content: "Yes")
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "cannot address a comment through another card" do
+    post card_comment_reactions_path(cards(:layout), @comment), params: { reaction: { content: "🚀" } }, as: :turbo_stream
+
+    assert_response :not_found
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..c0b5940
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,44 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  test "reaction content is limited to 16 characters" do
+    reaction = Reaction.new(comment: comments(:logo_agreement_kevin), creator: users(:kevin), content: "a" * 17)
+
+    assert_not reaction.valid?
+    assert_equal [ "is too long (maximum is 16 characters)" ], reaction.errors[:content]
+  end
+
+  test "reaction content is required" do
+    reaction = Reaction.new(comment: comments(:logo_agreement_kevin), creator: users(:kevin), content: " ")
+
+    assert_not reaction.valid?
+    assert reaction.errors.added?(:content, :blank)
+  end
+
+  test "account comes from the comment" do
+    reaction = Reaction.create!(comment: comments(:logo_agreement_kevin), creator: users(:kevin), content: "🚀")
+
+    assert_equal reaction.comment.account, reaction.account
+  end
+
+  test "creating and deleting broadcasts the reactions strip" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = nil
+
+    assert_turbo_stream_broadcasts(comment.card, count: 1) do
+      reaction = Reaction.create!(comment: comment, creator: users(:kevin), content: "🚀")
+    end
+
+    assert_turbo_stream_broadcasts(comment.card, count: 1) do
+      reaction.destroy!
+    end
+  end
+
+  test "destroying a comment destroys its reactions" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = Reaction.create!(comment: comment, creator: users(:kevin), content: "🚀")
+
+    assert_nothing_raised { comment.destroy! }
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
