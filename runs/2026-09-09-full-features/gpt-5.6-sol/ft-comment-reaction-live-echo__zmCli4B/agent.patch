diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..365e515
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,30 @@
+<% reaction ||= comment.reactions.build %>
+<% expanded = reaction.errors.any? %>
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reaction">
+  <div class="reactions__list">
+    <%= render partial: "cards/comments/reactions/reaction", collection: comment.reactions.select(&:persisted?) %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle" data-reaction-target="trigger" data-action="reaction#open" <%= "hidden" if expanded %>>
+    <%= image_tag "boost-color.svg", alt: "" %>
+    <span class="for-screen-reader">Add a reaction</span>
+  </button>
+
+  <%= form_with model: [ comment.card, comment, reaction ], class: class_names("reaction__form", reaction: expanded, expanded: expanded),
+        data: { reaction_target: "form", action: "keydown.esc->reaction#cancel:prevent" }, html: { hidden: !expanded } do |form| %>
+    <%= form.label :content, "Reaction", class: "reaction__form-label for-screen-reader" %>
+    <%= form.text_field :content, class: "reaction__input input", maxlength: 16, required: true, autofocus: expanded,
+          autocomplete: "off", data: { reaction_target: "input" }, aria: { invalid: reaction.errors.any? } %>
+    <%= form.button type: :submit, class: "reaction__submit-btn btn btn--circle borderless", title: "Add reaction" do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Confirm reaction</span>
+    <% end %>
+    <button type="button" class="reaction__cancel-btn btn btn--circle borderless" title="Cancel" data-action="reaction#cancel">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel reaction</span>
+    </button>
+    <% if reaction.errors.any? %>
+      <span class="for-screen-reader" role="alert"><%= reaction.errors.full_messages.to_sentence %></span>
+    <% end %>
+  <% end %>
+</div>
