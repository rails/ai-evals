@@ -0,0 +1,21 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsTest < ActionView::TestCase
+  test "renders reactions, their creators, and an add form" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(creator: users(:kevin), content: "🚀")
+    Current.user = users(:kevin)
+
+    render partial: "cards/comments/reactions", locals: { comment: comment }
+
+    assert_select ".reactions"
+    assert_select "##{dom_id(reaction)}.reaction[data-creator-id=?]", users(:kevin).id
+    assert_select "[title=?]", users(:kevin).name
+    assert_select "input[maxlength=16][required]"
+    assert_select ".reaction__submit-btn"
+    assert_select ".reaction__cancel-btn"
+    assert_select "form[action=?][method=post]", card_comment_reactions_path(comment.card, comment)
+  ensure
+    Current.reset
+  end
+end
