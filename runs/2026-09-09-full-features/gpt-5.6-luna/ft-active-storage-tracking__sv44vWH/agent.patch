diff --git a/app/jobs/storage_usage/refresh_job.rb b/app/jobs/storage_usage/refresh_job.rb
new file mode 100644
index 0000000..9fdc03d
--- /dev/null
+++ b/app/jobs/storage_usage/refresh_job.rb
@@ -0,0 +1,12 @@
+class StorageUsage::RefreshJob < ApplicationJob
+  queue_as :backend
+
+  def perform(account_id: nil, board_id: nil)
+    board = Board.find_by(id: board_id) if board_id
+    board&.update_column(:bytes_used, StorageUsage::Calculator.new(board).call)
+    account_id ||= board&.account_id
+
+    account = Account.find_by(id: account_id) if account_id
+    account&.update_column(:bytes_used, StorageUsage::Calculator.new(account).call)
+  end
+end
