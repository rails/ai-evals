diff --git a/app/services/storage_usage/calculator.rb b/app/services/storage_usage/calculator.rb
new file mode 100644
index 0000000..ca199e5
--- /dev/null
+++ b/app/services/storage_usage/calculator.rb
@@ -0,0 +1,49 @@
+module StorageUsage
+  # Calculates from Active Storage metadata only. In particular, this never downloads
+  # files and never builds the records containing the rich text.
+  class Calculator
+    def initialize(scope)
+      @scope = scope
+    end
+
+    def call
+      account_id = @scope.is_a?(Account) ? @scope.id : @scope.account_id
+      board_id = @scope.is_a?(Board) ? @scope.id : nil
+
+      conditions = ["a.account_id = #{connection.quote(account_id)}"]
+      sql = <<~SQL.squish
+        SELECT DISTINCT a.blob_id
+        FROM active_storage_attachments a
+        WHERE #{conditions.join(" AND ")}
+          AND (
+            (a.record_type = 'Card' AND a.name = 'image' AND EXISTS
+              (SELECT 1 FROM cards c WHERE c.id = a.record_id #{board_id ? "AND c.board_id = #{connection.quote(board_id)}" : "AND c.account_id = #{connection.quote(account_id)}"}))
+            OR (a.record_type = 'ActionText::RichText' AND a.name = 'embeds' AND EXISTS
+              (SELECT 1 FROM action_text_rich_texts rt WHERE rt.id = a.record_id AND #{rich_text_scope(board_id, account_id)}))
+          )
+      SQL
+      connection.select_value("SELECT COALESCE(SUM(byte_size), 0) FROM active_storage_blobs WHERE id IN (#{sql})").to_i
+    end
+
+    private
+      def connection
+        ActiveRecord::Base.connection
+      end
+
+      def rich_text_scope(board_id, account_id)
+        if board_id
+          <<~SQL.squish
+            (rt.record_type = 'Board' AND rt.record_id = #{connection.quote(board_id)}) OR
+            (rt.record_type = 'Card' AND EXISTS (SELECT 1 FROM cards c WHERE c.id = rt.record_id AND c.board_id = #{connection.quote(board_id)})) OR
+            (rt.record_type = 'Comment' AND EXISTS (SELECT 1 FROM comments cm JOIN cards c ON c.id = cm.card_id WHERE cm.id = rt.record_id AND c.board_id = #{connection.quote(board_id)}))
+          SQL
+        else
+          <<~SQL.squish
+            (rt.record_type = 'Board' AND EXISTS (SELECT 1 FROM boards b WHERE b.id = rt.record_id AND b.account_id = #{connection.quote(account_id)})) OR
+            (rt.record_type = 'Card' AND EXISTS (SELECT 1 FROM cards c WHERE c.id = rt.record_id AND c.account_id = #{connection.quote(account_id)})) OR
+            (rt.record_type = 'Comment' AND EXISTS (SELECT 1 FROM comments cm WHERE cm.id = rt.record_id AND cm.account_id = #{connection.quote(account_id)}))
+          SQL
+        end
+      end
+  end
+end
diff --git a/config/initializers/storage_usage.rb b/config/initializers/storage_usage.rb
new file mode 100644
index 0000000..dd6f361
--- /dev/null
+++ b/config/initializers/storage_usage.rb
@@ -0,0 +1,14 @@
+# Active Storage attachments are the source of truth for card images and Action
+# Text embeds. Recalculation is deliberately deferred to the backend queue.
+ActiveSupport.on_load(:active_storage_attachment) do
+  after_create_commit :refresh_storage_usage
+  after_destroy_commit :refresh_storage_usage
+
+  private
+    def refresh_storage_usage
+      owner = record_type == "ActionText::RichText" ? record&.record : record
+      board = owner.respond_to?(:board) ? owner.board : owner if owner
+      account_id = owner&.account_id || board&.account_id
+      StorageUsage::RefreshJob.perform_later(account_id: account_id, board_id: board&.id) if account_id
+    end
+end
