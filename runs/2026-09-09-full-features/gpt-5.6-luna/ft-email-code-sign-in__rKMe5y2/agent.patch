diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
new file mode 100644
index 0000000..7150a93
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,20 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  test "issues a six character code that expires in fifteen minutes" do
+    code, value = EmailCode.issue(email_address: " Test@Example.com ", purpose: "sign_in")
+
+    assert_equal "test@example.com", code.email_address
+    assert_equal 6, value.length
+    assert code.expires_at.between?(14.minutes.from_now, 16.minutes.from_now)
+    assert code.consume?(value)
+    assert_not code.consume?(value)
+  end
+
+  test "expired codes cannot be consumed" do
+    code, value = EmailCode.issue(email_address: "test@example.com", purpose: "sign_in")
+    code.update!(expires_at: 1.second.ago)
+
+    assert_not code.consume?(value)
+  end
+end
