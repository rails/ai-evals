diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..68e43bb
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,28 @@
+class EmailCode < ApplicationRecord
+  LIFETIME = 15.minutes
+  LENGTH = 6
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase }
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+
+  def self.issue(email_address:, purpose:)
+    code = SecureRandom.alphanumeric(LENGTH).upcase
+    record = create!(email_address: email_address, purpose: purpose,
+      code_digest: digest(code), expires_at: LIFETIME.from_now)
+    [ record, code ]
+  end
+
+  def self.digest(code)
+    Digest::SHA256.hexdigest(code.to_s.strip.upcase)
+  end
+
+  def valid_code?(code)
+    !used_at? && expires_at.future? && ActiveSupport::SecurityUtils.secure_compare(code_digest, self.class.digest(code))
+  end
+
+  def consume?(code)
+    return false unless valid_code?(code)
+    update!(used_at: Time.current)
+    true
+  end
+end
