diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..39960dd
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,49 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Dates are deliberately formatted here, rather than on the server. This keeps
+// cached HTML independent of both the server timezone and the person viewing it.
+export default class extends Controller {
+  static values = { format: String }
+
+  connect() {
+    const date = new Date(this.element.dateTime || this.element.dataset.timestamp)
+    if (!Number.isNaN(date.getTime())) this.element.textContent = formatDate(date, this.formatValue || "smart")
+  }
+}
+
+const clock = new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" })
+const calendar = new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric" })
+const calendarWithYear = new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric", year: "numeric" })
+
+function formatDate(date, format) {
+  if (format === "time") return clock.format(date)
+  if (format === "date") {
+    return date.getFullYear() === new Date().getFullYear() ? calendar.format(date) : calendarWithYear.format(date)
+  }
+  if (format === "relative") return relativeDuration(date)
+
+  const today = startOfDay(new Date())
+  const day = startOfDay(date)
+  const days = Math.round((day - today) / 86400000)
+  if (days === 0) return clock.format(date)
+  if (days === -1) return "yesterday"
+  if (days === 1) return "tomorrow"
+  if (days < 0 && days >= -6) return `${-days} days ago`
+  if (days > 0 && days <= 6) return `in ${days} days`
+  return formatDate(date, "date")
+}
+
+function relativeDuration(date) {
+  const seconds = Math.round((date - new Date()) / 1000)
+  const future = seconds > 0
+  const amount = Math.abs(seconds)
+  const units = [[86400, "day"], [3600, "hour"], [60, "minute"]]
+  const unit = units.find(([size]) => amount >= size) || [1, "second"]
+  const count = Math.max(1, Math.round(amount / unit[0]))
+  const words = `${count} ${unit[1]}${count === 1 ? "" : "s"}`
+  return future ? `in ${words}` : `${words} ago`
+}
+
+function startOfDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
