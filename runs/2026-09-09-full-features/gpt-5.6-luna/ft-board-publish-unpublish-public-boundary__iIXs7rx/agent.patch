diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..553af2d
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class PublicBoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @admin = users(:kevin)
+    @published_card = cards(:logo)
+    @published_card.update!(board: @board, status: :published)
+    @draft = @board.cards.create!(creator: @admin, status: :drafted)
+  end
+
+  test "unpublished boards have no public URL and are not publicly accessible" do
+    get board_path(@board), as: :json
+    assert_nil response.parsed_body["public_url"]
+
+    get public_board_path("not-a-real-key"), as: :json
+    assert_response :not_found
+  end
+
+  test "admins can publish and unpublish a board" do
+    sign_in_as :kevin
+
+    post board_publication_path(@board), as: :json
+    assert_response :created
+    key = @board.reload.public_key
+    assert key.present?
+    assert_equal public_board_url(key), response.parsed_body["public_url"]
+
+    delete board_publication_path(@board), as: :json
+    assert_response :success
+    assert_nil @board.reload.public_key
+  end
+
+  test "non-admins cannot publish a board" do
+    sign_in_as :jz
+
+    post board_publication_path(@board), as: :json
+    assert_response :forbidden
+    assert_nil @board.reload.public_key
+  end
+
+  test "anyone can access a published board and its published card" do
+    @board.publish
+    key = @board.public_key
+
+    get public_board_path(key), as: :json
+    assert_response :success
+    assert_equal @board.name, response.parsed_body["name"]
+
+    get public_board_card_path(key, @published_card.number), as: :json
+    assert_response :success
+    assert_equal @published_card.number, response.parsed_body["number"]
+
+    get public_board_card_path(key, @draft.number), as: :json
+    assert_response :not_found
+  end
+end
