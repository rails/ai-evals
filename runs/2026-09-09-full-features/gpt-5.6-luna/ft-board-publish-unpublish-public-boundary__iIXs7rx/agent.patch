+class Public::ColumnsController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_before_action :redirect_tenanted_request
+
+  before_action :set_board
+  before_action :set_column
+
+  def show
+    @page = @column.cards.published.latest.with_golden_first.preloaded
+    respond_to do |format|
+      format.json
+      format.any { render json: @column }
+    end
+  end
+
+  private
+    def set_board
+      @board = Board.published.find_by!(public_key: params[:board_key])
+    end
+
+    def set_column
+      @column = @board.columns.find(params[:id])
+    end
+end
