diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..6aeba3a 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,33 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  class_methods do
+    def incinerate_due
+      joins(:cancellation)
+        .where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+        .find_each(&:incinerate!)
+    end
+  end
+
+  def incinerate!
+    transaction do
+      # Destroy associated records through Active Record first so their callbacks
+      # and polymorphic dependents are not bypassed.
+      destroy!
+
+      # Not every account-owned table has an Active Record association. Remove
+      # those remaining records by their tenant key after destroying the account.
+      self.class.connection.tables.each do |table_name|
+        next if table_name == self.class.table_name
+        next unless self.class.connection.columns(table_name).any? { |column| column.name == "account_id" }
+
+        self.class.connection.delete(
+          "DELETE FROM #{self.class.connection.quote_table_name(table_name)} " \
+          "WHERE account_id = #{self.class.connection.quote(id)}"
+        )
+      end
+    end
+  end
 end
