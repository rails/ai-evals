--- /dev/null
+++ b/app/models/email_digest_window.rb
@@ -0,0 +1,15 @@
+class EmailDigestWindow < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  has_many :notifications, dependent: :nullify
+
+  scope :open, -> { where(sent_at: nil) }
+
+  def deliver
+    with_lock do
+      return if sent_at.present?
+      update!(sent_at: Time.current)
+    end
+    NotificationMailer.digest(user: user, notifications: notifications.includes(:creator, :card), window: self).deliver_now
+  end
+end
