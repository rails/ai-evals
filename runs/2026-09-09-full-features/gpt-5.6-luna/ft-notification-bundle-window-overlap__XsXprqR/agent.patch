diff --git a/app/services/notification_email_digest.rb b/app/services/notification_email_digest.rb
new file mode 100644
index 0000000..fbe53a8
--- /dev/null
+++ b/app/services/notification_email_digest.rb
@@ -0,0 +1,30 @@
+class NotificationEmailDigest
+  FREQUENCIES = { "every_few_hours" => 4.hours, "daily" => 1.day, "weekly" => 1.week }.freeze
+
+  def self.enqueue(notification)
+    new(notification).enqueue
+  end
+
+  def initialize(notification)
+    @notification = notification
+  end
+
+  def enqueue
+    user = notification.user
+    user.with_lock do
+      frequency = user.settings&.bundle_email_frequency
+      return if frequency.blank? || frequency == "never"
+
+      now = Time.current
+      window = user.email_digest_windows.open.where("ends_at > ?", now).order(starts_at: :desc).first
+      unless window
+        window = user.email_digest_windows.create!(account: user.account, starts_at: now, ends_at: now + FREQUENCIES.fetch(frequency))
+        NotificationEmailDigestJob.set(wait_until: window.ends_at).perform_later(window)
+      end
+      notification.update_column(:email_digest_window_id, window.id) unless notification.email_digest_window_id == window.id
+    end
+  end
+
+  private
+    attr_reader :notification
+end
