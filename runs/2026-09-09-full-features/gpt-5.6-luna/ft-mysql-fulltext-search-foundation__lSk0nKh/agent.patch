+++ b/test/controllers/search_controller_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class SearchControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "finds published cards by title and highlights matches" do
+    card = cards(:logo)
+    card.update_column(:title, "Searchable blue card")
+
+    get search_path, params: { q: "blue" }
+
+    assert_response :success
+    assert_select "mark", text: "blue"
+    assert_select "a[href='#{card_path(card)}']"
+  end
+
+  test "does not return drafts" do
+    draft = boards(:writebook).cards.create!(creator: users(:kevin), status: :drafted, title: "Secret searchable draft")
+
+    get search_path, params: { q: "searchable" }
+
+    assert_response :success
+    assert_select "a[href='#{card_path(draft)}']", count: 0
+  end
+end
