new file mode 100644
index 0000000..f83e92e
--- /dev/null
+++ b/app/controllers/search_controller.rb
@@ -0,0 +1,23 @@
+class SearchController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @cards = search_cards
+  end
+
+  private
+    def search_cards
+      return Card.none if @query.blank?
+
+      pattern = "%#{ActiveRecord::Base.sanitize_sql_like(@query)}%"
+      cards = Current.user.accessible_cards.published
+        .where(
+          "cards.title LIKE :pattern OR EXISTS (SELECT 1 FROM action_text_rich_texts description_text WHERE description_text.record_type = 'Card' AND description_text.name = 'description' AND description_text.record_id = cards.id AND description_text.body LIKE :pattern) OR EXISTS (SELECT 1 FROM comments search_comments INNER JOIN action_text_rich_texts comment_text ON comment_text.record_type = 'Comment' AND comment_text.name = 'body' AND comment_text.record_id = search_comments.id WHERE search_comments.card_id = cards.id AND comment_text.body LIKE :pattern)",
+          pattern: pattern
+        )
+        .distinct
+        .reverse_chronologically
+        .preloaded
+
+      cards
+    end
+end
diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..9194f7a
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,10 @@
+module SearchHelper
+  def search_highlight(text, query)
+    escaped = ERB::Util.html_escape(text.to_s)
+    words = query.to_s.split.reject(&:blank?).uniq
+    return escaped unless words.any?
+
+    pattern = Regexp.union(words.map { |word| Regexp.escape(ERB::Util.html_escape(word)) })
+    escaped.gsub(pattern) { |match| "<mark>#{match}</mark>" }.html_safe
+  end
+end
diff --git a/app/views/search/show.html.erb b/app/views/search/show.html.erb
new file mode 100644
index 0000000..37f1b6c
--- /dev/null
+++ b/app/views/search/show.html.erb
@@ -0,0 +1,40 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">Search</h1>
+<% end %>
+
+<section class="panel margin-block-start" aria-labelledby="search-heading">
+  <h2 id="search-heading" class="sr-only">Search cards</h2>
+  <%= form_with url: search_path, method: :get, class: "form" do |form| %>
+    <%= form.label :q, "Search cards", class: "sr-only" %>
+    <%= form.search_field :q, value: @query, autofocus: true, placeholder: "Search cards", class: "input" %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+</section>
+
+<section class="cards cards--grid margin-block-start" aria-live="polite">
+  <div class="cards__list hide-scrollbar">
+    <% if @query.blank? %>
+      <div class="blank-slate">Enter a search term</div>
+    <% elsif @cards.any? %>
+      <% @cards.each do |card| %>
+        <article class="panel margin-block-end">
+          <h2><%= link_to search_highlight(card.title, @query), card_path(card) %></h2>
+          <% if card.description.present? %>
+            <p><%= search_highlight(card.description.to_plain_text, @query) %></p>
+          <% end %>
+          <% card.comments.preloaded.each do |comment| %>
+            <% body = comment.body.to_plain_text %>
+            <% if body.downcase.include?(@query.downcase) %>
+              <p class="txt-small"><%= search_highlight(body, @query) %></p>
+            <% end %>
+          <% end %>
+          <p class="txt-small"><%= link_to card.board.name, board_path(card.board) %></p>
+        </article>
+      <% end %>
+    <% else %>
+      <div class="blank-slate">No cards match your search</div>
+    <% end %>
+  </div>
+</section>
