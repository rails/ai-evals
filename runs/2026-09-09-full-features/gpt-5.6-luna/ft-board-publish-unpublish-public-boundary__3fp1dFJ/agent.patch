+class Public::BoardsController < ApplicationController
+  allow_unauthorized_access
+  layout "public"
+
+  before_action :set_board
+
+  def show
+    @columns = @board.columns.sorted.includes(cards: :column)
+    respond_to do |format|
+      format.html
+      format.json { render :show }
+    end
+  end
+
+  private
+    def set_board
+      @board = Board.find_by!(public_key: params[:key])
+    end
+end
