diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..86ce63b
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,26 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup { sign_in_as :kevin }
+
+  test "returns activity as a flat JSON array" do
+    get activities_path, as: :json
+
+    assert_response :success
+    activities = response.parsed_body
+    assert_kind_of Array, activities
+    assert activities.any?
+    event = activities.first
+    assert_equal %w[id action created_at description particulars url eventable_type eventable board creator], event.keys
+  end
+
+  test "filters by creator and board" do
+    get activities_path, params: { creator_ids: [ users(:jz).id ], board_ids: [ boards(:writebook).id ] }, as: :json
+
+    assert_response :success
+    response.parsed_body.each do |activity|
+      assert_equal users(:jz).id, activity.dig("creator", "id")
+      assert_equal boards(:writebook).id, activity.dig("board", "id")
+    end
+  end
+end
