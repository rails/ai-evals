diff --git a/app/controllers/events_controller.rb b/app/controllers/events_controller.rb
index 5b52b02..09c1e13 100644
--- a/app/controllers/events_controller.rb
+++ b/app/controllers/events_controller.rb
@@ -4,4 +4,16 @@ class EventsController < ApplicationController
   def index
     fresh_when @day_timeline
   end
+
+  def activities
+    events = Event.preloaded
+      .where(board: Current.user.boards)
+      .where(action: User::DayTimeline::TIMELINEABLE_ACTIONS - [ "card_collection_changed" ] + [ "card_title_changed" ])
+      .order(created_at: :desc, id: :desc)
+
+    events = events.where(creator_id: @filter.creator_ids) if @filter.creator_ids.present?
+    events = events.where(board_id: @filter.board_ids) if @filter.board_ids.present?
+
+    set_page_and_extract_portion_from events
+  end
 end
diff --git a/app/views/events/activities.json.jbuilder b/app/views/events/activities.json.jbuilder
new file mode 100644
index 0000000..b54cf1c
--- /dev/null
+++ b/app/views/events/activities.json.jbuilder
@@ -0,0 +1,34 @@
+json.array! @page.records do |event|
+  json.(event, :id, :action)
+  json.created_at event.created_at.utc
+  json.description event.description_for(Current.user).to_plain_text
+  json.particulars do
+    case event.action.to_s
+    when "card_assigned", "card_unassigned"
+      json.assignee_ids event.assignee_ids || []
+    when "card_board_changed"
+      values = event.particulars.fetch("particulars", {})
+      json.old_board values.fetch("old_board", "") || ""
+      json.new_board values.fetch("new_board", "") || ""
+    when "card_title_changed"
+      values = event.particulars.fetch("particulars", {})
+      json.old_title values.fetch("old_title", "") || ""
+      json.new_title values.fetch("new_title", "") || ""
+    when "card_triaged"
+      json.column event.particulars.dig("particulars", "column") || ""
+    end
+  end
+
+  if event.action.to_s == "comment_created"
+    json.url card_url(event.eventable.card, anchor: dom_id(event.eventable))
+    json.eventable_type event.eventable_type
+    json.eventable event.eventable, partial: "cards/comments/comment", as: :comment
+  else
+    json.url card_url(event.eventable)
+    json.eventable_type event.eventable_type
+    json.eventable event.eventable, partial: "cards/card", as: :card
+  end
+
+  json.board event.board, partial: "boards/board", as: :board
+  json.creator event.creator, partial: "users/user", as: :user
+end
