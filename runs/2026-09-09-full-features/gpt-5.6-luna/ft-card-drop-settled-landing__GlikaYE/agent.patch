diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..d0fb878
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,93 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+// Cards are moved in the document first. The request is deliberately made as JSON so
+// Turbo cannot re-render the board after the drop and undo the optimistic move.
+export default class extends Controller {
+  static classes = { dragged: "drag-and-drop__dragged-item", hover: "drag-and-drop__hover-container" }
+
+  connect() {
+    this.card = null
+    this.origin = null
+    this.hoveredColumn = null
+  }
+
+  dragstart(event) {
+    const card = event.target.closest("[data-drag-and-drop-card]")
+    if (!card || !this.element.contains(card)) return
+
+    this.card = card
+    this.origin = { parent: card.parentElement, next: card.nextElementSibling }
+    card.classList.add(this.draggedClass)
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.dataset.dragAndDropCard)
+  }
+
+  dragend() {
+    this.clearHover()
+    this.card?.classList.remove(this.draggedClass)
+    this.card = null
+    this.origin = null
+  }
+
+  dragover(event) {
+    const column = event.target.closest("[data-drag-and-drop-column]")
+    if (!column || !this.element.contains(column) || !this.card) return
+
+    event.preventDefault()
+    event.dataTransfer.dropEffect = "move"
+    this.setHover(column)
+  }
+
+  drop(event) {
+    event.preventDefault()
+    const column = event.target.closest("[data-drag-and-drop-column]")
+    if (!column || !this.card || !this.element.contains(column)) return
+
+    const card = this.card
+    const origin = this.origin
+    const list = column.querySelector(".cards__list")
+    if (!list || list.contains(card) && column === card.closest("[data-drag-and-drop-column]")) return
+
+    list.append(card)
+    this.clearHover()
+    card.classList.remove(this.draggedClass)
+    this.persist(card, column, origin)
+    this.card = null
+    this.origin = null
+  }
+
+  setHover(column) {
+    if (this.hoveredColumn === column) return
+    this.clearHover()
+    this.hoveredColumn = column
+    column.classList.add(this.hoverClass)
+  }
+
+  clearHover() {
+    this.hoveredColumn?.classList.remove(this.hoverClass)
+    this.hoveredColumn = null
+  }
+
+  async persist(card, column, origin) {
+    const baseUrl = card.dataset.dragAndDropUrl
+    const action = column.dataset.dragAndDropAction
+    const url = action === "triage"
+      ? `${baseUrl}?column_id=${encodeURIComponent(column.dataset.dragAndDropColumn)}`
+      : action === "triage_remove" ? baseUrl : baseUrl.replace(/\/triage$/, `/${action}`)
+    const method = action === "triage_remove" ? "delete" : "post"
+
+    try {
+      const response = await new FetchRequest(method, url, { responseKind: "json" }).perform()
+      if (!response.ok) this.restore(card, origin)
+    } catch {
+      this.restore(card, origin)
+    }
+  }
+
+  restore(card, origin) {
+    if (!origin?.parent?.isConnected) return
+    if (origin.next?.parentElement === origin.parent) origin.parent.insertBefore(card, origin.next)
+    else origin.parent.append(card)
+  }
+}
