-    end
+    response.present? ? { code: response[:code], error: response[:error] } : nil
   end
 
   def failed?
@@ -29,4 +28,44 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  def deliver
+    return if completed? || errored?
+    return unless webhook.active?
+
+    update!(state: :in_progress)
+    body = ApplicationController.render template: "webhooks/event", formats: [ :json ], assigns: { event: event },
+      layout: false
+    timestamp = Time.current.utc.iso8601(3)
+    signature = OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, "#{timestamp}.#{body}")
+    headers = {
+      "User-Agent" => "fizzy/1.0.0 Webhook", "Content-Type" => "application/json",
+      "X-Webhook-Timestamp" => timestamp, "X-Webhook-Signature" => "sha256=#{signature}"
+    }
+    update!(request: { headers: headers })
+    uri = URI.parse(webhook.url)
+    http = Net::HTTP.new(uri.host, uri.port)
+    http.use_ssl = uri.scheme == "https"
+    http.open_timeout = 10
+    http.read_timeout = 30
+    response = http.post(uri.request_uri, body, headers)
+    update!(state: :completed, response: { code: response.code.to_i, headers: response.each_header.to_h })
+    succeeded? ? tracker.record_success! : tracker.record_failure!
+  rescue StandardError => error
+    update_columns(state: "errored", response: { error: error.class.name.underscore }) if persisted?
+    tracker.record_failure! if persisted?
+  end
+
+  def self.cleanup
+    where(created_at: ..1.week.ago).delete_all
+  end
+
+  private
+    def ensure_delinquency_tracker
+      webhook.create_delinquency_tracker! unless webhook.delinquency_tracker
+    end
+
+    def tracker
+      webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+    end
 end
