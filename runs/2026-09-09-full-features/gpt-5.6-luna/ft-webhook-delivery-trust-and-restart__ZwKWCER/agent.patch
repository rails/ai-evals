new file mode 100644
index 0000000..086d86b
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,19 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  belongs_to :webhook
+  belongs_to :account, default: -> { webhook.account }
+
+  def record_failure!
+    now = Time.current
+    if first_failure_at.nil? || first_failure_at < 1.hour.ago
+      update!(consecutive_failures_count: 1, first_failure_at: now)
+    else
+      increment!(:consecutive_failures_count)
+    end
+
+    webhook.deactivate if consecutive_failures_count >= 10 && first_failure_at >= 1.hour.ago
+  end
+
+  def record_success!
+    update!(consecutive_failures_count: 0, first_failure_at: nil) if consecutive_failures_count.positive?
+  end
+end
