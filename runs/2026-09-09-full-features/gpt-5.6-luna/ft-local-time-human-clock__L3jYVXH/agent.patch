diff --git a/app/javascript/initializers/local_times.js b/app/javascript/initializers/local_times.js
new file mode 100644
index 0000000..9989384
--- /dev/null
+++ b/app/javascript/initializers/local_times.js
@@ -0,0 +1,57 @@
+// Timestamps are deliberately rendered here, rather than on the server. This
+// keeps cached HTML the same for everyone and uses the viewer's timezone.
+const DAY = 24 * 60 * 60 * 1000
+
+function dayStart(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate()).getTime()
+}
+
+function dayDifference(from, to) {
+  return Math.round((dayStart(to) - dayStart(from)) / DAY)
+}
+
+function formatDate(date, includeYear = false) {
+  return new Intl.DateTimeFormat(undefined, {
+    month: "short", day: "numeric", ...(includeYear ? { year: "numeric" } : {})
+  }).format(date)
+}
+
+function formatTimestamp(element) {
+  const date = new Date(element.dataset.localTime || element.dateTime)
+  if (Number.isNaN(date.getTime())) return
+
+  const now = new Date()
+  const difference = dayDifference(now, date)
+  const format = element.dataset.localTimeFormat
+  let text
+
+  if (format === "time") {
+    text = new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" }).format(date)
+  } else if (format === "comment") {
+    text = difference === 0
+      ? new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" }).format(date)
+      : difference === -1 ? "yesterday" : difference < 0 && difference >= -6
+        ? `${-difference} days ago` : formatDate(date, date.getFullYear() !== now.getFullYear())
+  } else if (format === "relative") {
+    text = difference === 0 ? "today" : difference === -1 ? "yesterday" : difference < 0 && difference >= -6
+      ? `${-difference} days ago` : difference > 0 && difference <= 6
+        ? `in ${difference} days` : formatDate(date, date.getFullYear() !== now.getFullYear())
+  } else if (format === "future-relative") {
+    text = difference === 0 ? "today" : difference === 1 ? "tomorrow" : difference > 1 && difference <= 6
+      ? `in ${difference} days` : formatDate(date, date.getFullYear() !== now.getFullYear())
+  } else if (format === "day") {
+    text = new Intl.DateTimeFormat(undefined, { weekday: "long", month: "long", day: "numeric" }).format(date)
+  } else { // date
+    text = formatDate(date, date.getFullYear() !== now.getFullYear())
+  }
+
+  element.textContent = text
+}
+
+function renderLocalTimes(root = document) {
+  root.querySelectorAll("[data-local-time]").forEach(formatTimestamp)
+}
+
+document.addEventListener("turbo:load", () => renderLocalTimes())
+document.addEventListener("turbo:frame-render", event => renderLocalTimes(event.target))
+renderLocalTimes()
