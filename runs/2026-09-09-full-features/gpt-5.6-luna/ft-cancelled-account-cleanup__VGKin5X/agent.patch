diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..d2e04b7 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,44 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :incineratable, -> {
+      joins(:cancellation).where(account_cancellations: { created_at: ...INCINERATION_GRACE_PERIOD.ago })
+    }
+  end
+
+  class_methods do
+    def incinerate_due
+      incineratable.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    transaction do
+      # Destroy users first so records which are owned through a user (filters,
+      # notifications, mentions, etc.) get their normal dependent cleanup.
+      users.find_each(&:destroy!)
+
+      # Some account data is not represented by an Account association (for
+      # example search partitions and Active Storage records). Delete all such
+      # rows explicitly rather than relying on an incomplete association graph.
+      account_id_tables.each do |table|
+        self.class.connection.delete(
+          self.class.sanitize_sql_array([ "DELETE FROM #{self.class.connection.quote_table_name(table)} WHERE account_id = ?", id ])
+        )
+      end
+
+      destroy!
+    end
+  end
+
+  private
+    def account_id_tables
+      self.class.connection.tables.filter_map do |table|
+        columns = self.class.connection.columns(table)
+        table if columns.any? { |column| column.name == "account_id" } && table != self.class.table_name
+      end
+    end
 end
