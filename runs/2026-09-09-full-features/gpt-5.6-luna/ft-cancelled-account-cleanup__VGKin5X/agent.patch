diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..13750dd
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled less than 30 days ago" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: 31.days.ago)
+    account_id = account.id
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account_id)
+    assert_not Account::Cancellation.exists?(account_id: account_id)
+  end
+
+  test "does not incinerate accounts within the grace period" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+    account.cancellation.update!(created_at: 29.days.ago)
+    account_id = account.id
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(account_id)
+  end
+
+  test "does not incinerate active accounts" do
+    account_id = accounts(:"37s").id
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(account_id)
+  end
+end
