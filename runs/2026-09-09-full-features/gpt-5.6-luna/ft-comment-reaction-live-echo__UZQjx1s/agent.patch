diff --git a/app/views/cards/comments/_reactions.html.erb b/app/views/cards/comments/_reactions.html.erb
new file mode 100644
index 0000000..2a84c11
--- /dev/null
+++ b/app/views/cards/comments/_reactions.html.erb
@@ -0,0 +1,29 @@
+<div id="<%= dom_id(comment, :reactions) %>" class="reactions" data-controller="reactions">
+  <div class="reactions__list">
+    <% comment.reactions.includes(:creator).each do |reaction| %>
+      <div class="reaction reaction--deleteable"
+           data-creator-id="<%= reaction.creator_id %>"
+           data-action="click->reactions#toggleDelete">
+        <span class="reaction__avatar" aria-label="<%= reaction.creator.name %>">
+          <%= avatar_preview_tag reaction.creator, hidden_for_screen_reader: true %>
+        </span>
+        <span class="txt-small txt-medium" title="<%= reaction.creator.name %>"><%= reaction.content %></span>
+        <%= button_to card_comment_reaction_path(comment.card, comment, reaction), method: :delete,
+              class: "reaction__delete btn btn--plain", data: { only_visible_to_you: true, action: "click->reactions#stop" },
+              aria: { label: "Remove reaction" } do %>
+          <%= icon_tag "close" %>
+        <% end %>
+      </div>
+    <% end %>
+  </div>
+
+  <button type="button" class="reactions__trigger btn btn--circle" aria-label="Add a reaction" data-action="reactions#showForm">
+    <%= image_tag "boost-color.svg", alt: "" %>
+  </button>
+
+  <%= form_with model: Reaction.new, url: card_comment_reactions_path(comment.card, comment), class: "reaction reaction__form", hidden: true, data: { reactions_target: "form", action: "turbo:submit-end->reactions#submitted" } do |form| %>
+    <%= form.text_field :content, class: "reaction__input input", maxlength: 16, autocomplete: "off", required: true, aria: { label: "Your reaction" }, data: { reactions_target: "input" } %>
+    <%= form.button "✓", class: "reaction__submit-btn btn btn--plain", aria: { label: "Confirm reaction" } %>
+    <button type="button" class="reaction__cancel-btn btn btn--plain" aria-label="Cancel" data-action="reactions#cancel">×</button>
+  <% end %>
+</div>
