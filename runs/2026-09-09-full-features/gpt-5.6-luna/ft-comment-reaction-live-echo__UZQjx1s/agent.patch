new file mode 100644
index 0000000..10adbed
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,18 @@
+class Reaction < ApplicationRecord
+  belongs_to :comment, touch: true
+  belongs_to :creator, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: 16 }
+  validates :creator, uniqueness: { scope: :comment_id }
+
+  after_create_commit :broadcast_comment
+  after_destroy_commit :broadcast_comment
+
+  private
+    def broadcast_comment
+      comment.broadcast_replace_later_to comment.card,
+        target: ActionView::RecordIdentifier.dom_id(comment, :reactions),
+        partial: "cards/comments/reactions",
+        locals: { comment: comment }
+    end
+end
