new file mode 100644
index 0000000..b3803d5
--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,38 @@
+module EmailCodeAuthentication
+  extend ActiveSupport::Concern
+  included do
+    helper_method :email_code_challenge
+  end
+  CODE_LENGTH = 6
+  CODE_LIFETIME = 15.minutes
+
+  private
+    def send_email_code(email_address, purpose:, data: {})
+      code = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+      session[:email_code] = {
+        "email_address" => email_address,
+        "digest" => Digest::SHA256.hexdigest(code),
+        "purpose" => purpose.to_s,
+        "expires_at" => CODE_LIFETIME.from_now.to_i,
+        "data" => data.stringify_keys
+      }
+      EmailCodeMailer.code(email_address: email_address, code: code).deliver_later
+    end
+
+    def valid_email_code?(code, purpose:)
+      challenge = session[:email_code]
+      challenge.present? && challenge["purpose"] == purpose.to_s &&
+        challenge["expires_at"].to_i > Time.current.to_i &&
+        ActiveSupport::SecurityUtils.secure_compare(
+          challenge["digest"].to_s, Digest::SHA256.hexdigest(code.to_s.strip.upcase)
+        )
+    end
+
+    def email_code_challenge
+      session[:email_code]
+    end
+
+    def consume_email_code
+      session.delete(:email_code)
+    end
+end
diff --git a/app/controllers/join_codes/email_codes_controller.rb b/app/controllers/join_codes/email_codes_controller.rb
