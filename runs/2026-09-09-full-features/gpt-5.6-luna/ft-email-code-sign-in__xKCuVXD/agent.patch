index 0000000..ee816c2
--- /dev/null
+++ b/app/controllers/join_codes/email_codes_controller.rb
@@ -0,0 +1,43 @@
+class JoinCodes::EmailCodesController < ApplicationController
+  include EmailCodeAuthentication
+  allow_unauthenticated_access
+  before_action :set_join_code
+  before_action :ensure_join_code_is_valid
+  layout "public"
+
+  def new
+    redirect_to join_path(code: @join_code.code) unless challenge_for_join?
+  end
+
+  def create
+    unless valid_email_code?(params[:code], purpose: :join) && challenge_for_join?
+      flash.now[:alert] = "That code is invalid or has expired."
+      return render :new, status: :unprocessable_entity
+    end
+
+    identity = Identity.find_or_create_by!(email_address: email_code_challenge["email_address"])
+    consume_email_code
+    start_new_session_for(identity)
+    @join_code.redeem_if { |account| identity.join(account) }
+    user = User.active.find_by!(account: @join_code.account, identity: identity)
+    redirect_to user.setup? ? landing_url(script_name: @join_code.account.slug) : new_users_verification_url(script_name: @join_code.account.slug)
+  end
+
+  private
+    def set_join_code
+      @join_code = Account::JoinCode.find_by(code: params.expect(:code), account: Current.account)
+    end
+
+    def ensure_join_code_is_valid
+      if @join_code.nil?
+        head :not_found
+      elsif !@join_code.active?
+        render "join_codes/inactive", status: :gone
+      end
+    end
+
+    def challenge_for_join?
+      email_code_challenge&.dig("purpose") == "join" &&
+        email_code_challenge.dig("data", "join_code") == @join_code.code
+    end
+end
