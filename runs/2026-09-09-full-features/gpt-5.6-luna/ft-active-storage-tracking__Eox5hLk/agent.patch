diff --git a/app/models/storage_usage.rb b/app/models/storage_usage.rb
new file mode 100644
index 0000000..e3b3775
--- /dev/null
+++ b/app/models/storage_usage.rb
@@ -0,0 +1,50 @@
+# Calculates the bytes occupied by files that are part of board content.
+# The cached columns make reads constant-time; this module is deliberately query based
+# so recalculation does not instantiate cards, comments, or attachments.
+module StorageUsage
+  module_function
+
+  def board_bytes(board)
+    attachment_ids = ActiveStorage::Attachment
+      .joins("INNER JOIN active_storage_blobs ON active_storage_blobs.id = active_storage_attachments.blob_id")
+      .where(content_predicate, board.id, board.id, board.id, board.id)
+      .select(:blob_id).distinct
+
+    ActiveStorage::Blob.where(id: attachment_ids).sum(:byte_size)
+  end
+
+  def refresh_board(board)
+    bytes = board_bytes(board)
+    board.update_column(:storage_bytes_used, bytes) if board.storage_bytes_used != bytes
+    refresh_account(board.account_id)
+  end
+
+  def refresh_account(account_id)
+    bytes = Board.where(account_id: account_id).sum(:storage_bytes_used)
+    Account.where(id: account_id).update_all(storage_bytes_used: bytes)
+  end
+
+  def enqueue_board(board)
+    StorageUsageJob.perform_later(board) if board&.persisted?
+  end
+
+  def enqueue_account(account)
+    StorageUsageAccountJob.perform_later(account) if account&.persisted?
+  end
+
+  def content_predicate
+    <<~SQL.squish
+      (active_storage_attachments.record_type = 'Card' AND active_storage_attachments.name = 'image'
+       AND active_storage_attachments.record_id IN (SELECT id FROM cards WHERE board_id = ?))
+      OR (active_storage_attachments.record_type = 'ActionText::RichText'
+       AND active_storage_attachments.record_id IN
+         (SELECT id FROM action_text_rich_texts WHERE
+           (record_type = 'Board' AND name = 'public_description' AND record_id = ?)
+           OR (record_type = 'Card' AND name = 'description' AND record_id IN
+             (SELECT id FROM cards WHERE board_id = ?))
+           OR (record_type = 'Comment' AND name = 'body' AND record_id IN
+             (SELECT id FROM comments WHERE card_id IN (SELECT id FROM cards WHERE board_id = ?)))
+         ))
+    SQL
+  end
+end
diff --git a/config/initializers/active_storage.rb b/config/initializers/active_storage.rb
index f85a27a..a70a798 100644
--- a/config/initializers/active_storage.rb
+++ b/config/initializers/active_storage.rb
@@ -56,3 +56,33 @@ Rails.application.config.to_prepare do
   ActiveStorage::BaseController.include ActiveStorageControllerExtensions
   ActiveStorage::DirectUploadsController.include ActiveStorageDirectUploadsControllerExtensions
 end
+
+# Active Text creates Active Storage attachments independently of the owning record.
+
+# Active Text creates Active Storage attachments independently of the owning record.
+module StorageUsageAttachmentCallbacks
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :enqueue_storage_usage, on: [ :create, :update ]
+    before_destroy :enqueue_storage_usage
+  end
+
+  private
+    def enqueue_storage_usage
+      attached_record = record
+      owner = if attached_record.respond_to?(:board)
+        attached_record.board
+      elsif attached_record.respond_to?(:record)
+        attached_record.record
+      else
+        attached_record
+      end
+      owner = owner.board if owner.respond_to?(:board) && !owner.is_a?(Board)
+      StorageUsage.enqueue_board(owner) if owner.is_a?(Board)
+    end
+end
+
+Rails.application.config.to_prepare do
+  ActiveStorage::Attachment.include(StorageUsageAttachmentCallbacks) unless ActiveStorage::Attachment < StorageUsageAttachmentCallbacks
+end
