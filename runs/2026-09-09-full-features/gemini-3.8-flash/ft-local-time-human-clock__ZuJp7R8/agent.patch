new file mode 100644
index 0000000..7fee12a
--- /dev/null
+++ b/test/integration/local_time_caching_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class LocalTimeCachingTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as users(:david)
+  end
+
+  test "server renders raw timestamps instead of timezone-baked formatted strings" do
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+
+    get card_path(card)
+    assert_response :success
+
+    # The HTML should contain local-time element with raw ISO8601 timestamp
+    assert_select "local-time[datetime='#{comment.created_at.utc.iso8601}']"
+
+    # Verify that the old baked server format is not present
+    assert_no_match(/#{comment.created_at.strftime("%A, %B %-d")}/, response.body)
+  end
+
+  test "cached comment fragment contains raw timestamp" do
+    comment = comments(:logo_agreement_kevin)
+    card = comment.card
+
+    # Warm cache
+    get card_path(card)
+    assert_response :success
+
+    # Ensure cache has the raw timestamp
+    cache_key = comment
+    cached_fragment = Rails.cache.read(ActionController::Base.new.view_context.cache_fragment_name(cache_key))
+    if cached_fragment
+      assert_includes cached_fragment, "local-time"
+      assert_includes cached_fragment, comment.created_at.utc.iso8601
+    end
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..5624154
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,66 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  setup do
+    sign_in_as(users(:david))
+  end
+
+  test "comments and auto-closing render in the browser" do
+    card = cards(:logo)
+
+    comments(:logo_agreement_kevin).update_columns(created_at: 2.hours.ago)
+    comments(:logo_agreement_jz).update_columns(created_at: 5.days.ago)
+
+    visit card_url(card)
+
+    # Comment from 2 hours ago displays the time of day with AM/PM (e.g. 1:42 PM)
+    kevin_comment = find(".comment", text: /Kevin/)
+    assert_match(/\d{1,2}:\d{2}\s+(AM|PM)/i, kevin_comment.find(".comment__permalink-title").text)
+
+    # Comment from earlier in the week displays "5 days ago" or "Sep 12"
+    jz_comment = find(".comment", text: /JZ/)
+    assert_match(/(5 days ago|Sep 12)/i, jz_comment.find(".comment__permalink-title").text)
+
+    # Auto-closing overnight reads "tomorrow"
+    card.update_columns(last_active_at: 1.day.from_now - card.auto_postpone_period)
+    visit card_url(card)
+    assert_selector "#" + ActionView::RecordIdentifier.dom_id(card, :closure_notice), text: /Moves to “Not Now” tomorrow if there’s no activity/
+
+    # Auto-closing further out reads "in 3 days"
+    card.update_columns(last_active_at: 3.days.from_now - card.auto_postpone_period)
+    visit card_url(card)
+    assert_selector "#" + ActionView::RecordIdentifier.dom_id(card, :closure_notice), text: /Moves to “Not Now” in 3 days if there’s no activity/
+  end
+
+  test "comment from yesterday reads yesterday" do
+    card = cards(:logo)
+    card.comments.create!(creator: users(:kevin), body: "Yesterday comment", created_at: 1.day.ago)
+
+    visit card_url(card)
+    yesterday_comment = find(".comment", text: /Yesterday comment/)
+    assert_equal "Yesterday", yesterday_comment.find(".comment__permalink-title").text
+  end
+
+  test "card meta renders time ago in the browser" do
+    card = cards(:logo)
+    card.update_columns(created_at: 5.days.ago, last_active_at: 2.hours.ago)
+
+    visit card_url(card)
+
+    within(".card__meta") do
+      assert_match(/Added.*5 days ago/i, text)
+      assert_match(/Updated.*(2 hours ago|\d+ hours? ago)/i, text)
+    end
+  end
+
+  test "completed card renders completed date in the browser" do
+    card = cards(:shipping) # closed card fixture
+    card.closure.update_columns(created_at: Time.utc(2025, 9, 12, 10, 0, 0))
+
+    visit card_url(card)
+
+    within(".card-perma__closure-message") do
+      assert_match(/Completed by .* on Sep 12/i, text)
+    end
+  end
+end
