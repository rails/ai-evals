diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..38792f2
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_time with default options" do
+    time = Time.utc(2025, 1, 22, 17, 30, 0)
+    tag = local_time(time)
+
+    assert_dom_equal %(<local-time datetime="2025-01-22T17:30:00Z" type="time">2025-01-22T17:30:00Z</local-time>), tag
+  end
+
+  test "local_time with format string" do
+    time = Time.utc(2025, 1, 22, 17, 30, 0)
+    tag = local_time(time, "%l:%M %p")
+
+    assert_dom_equal %(<local-time datetime="2025-01-22T17:30:00Z" type="time" format="%l:%M %p">2025-01-22T17:30:00Z</local-time>), tag
+  end
+
+  test "local_date" do
+    date = Date.new(2025, 1, 22)
+    tag = local_date(date, format: "%b %-d")
+
+    assert_dom_equal %(<local-time datetime="2025-01-22" type="date" format="%b %-d">2025-01-22</local-time>), tag
+  end
+
+  test "local_time_ago" do
+    time = Time.utc(2025, 1, 22, 17, 30, 0)
+    tag = local_time_ago(time, class: "local-time-value")
+
+    assert_dom_equal %(<local-time class="local-time-value" datetime="2025-01-22T17:30:00Z" type="time-ago">2025-01-22T17:30:00Z</local-time>), tag
+  end
+
+  test "local_relative_time" do
+    time = Time.utc(2025, 1, 22, 17, 30, 0)
+    tag = local_relative_time(time)
+
+    assert_dom_equal %(<local-time datetime="2025-01-22T17:30:00Z" type="time-or-date">2025-01-22T17:30:00Z</local-time>), tag
+  end
+
+  test "returns nil for blank time" do
+    assert_nil local_time(nil)
+    assert_nil local_date(nil)
+    assert_nil local_time_ago(nil)
+    assert_nil local_relative_time(nil)
+  end
+end
