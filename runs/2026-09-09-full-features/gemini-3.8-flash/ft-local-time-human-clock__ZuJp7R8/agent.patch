diff --git a/app/javascript/initializers/local_time.js b/app/javascript/initializers/local_time.js
new file mode 100644
index 0000000..a8f0269
--- /dev/null
+++ b/app/javascript/initializers/local_time.js
@@ -0,0 +1,52 @@
+import { updateElement } from "helpers/local_time"
+
+export class LocalTimeElement extends HTMLElement {
+  static get observedAttributes() {
+    return ["datetime", "format", "type"]
+  }
+
+  connectedCallback() {
+    this.update()
+  }
+
+  attributeChangedCallback() {
+    this.update()
+  }
+
+  update() {
+    updateElement(this)
+  }
+}
+
+if (!customElements.get("local-time")) {
+  customElements.define("local-time", LocalTimeElement)
+}
+
+export function updateAll(root = document) {
+  root.querySelectorAll("local-time, time[data-local]").forEach(updateElement)
+}
+
+const observer = new MutationObserver((mutations) => {
+  for (const mutation of mutations) {
+    for (const node of mutation.addedNodes) {
+      if (node.nodeType === Node.ELEMENT_NODE) {
+        if (node.matches("local-time, time[data-local]")) {
+          updateElement(node)
+        }
+        node.querySelectorAll?.("local-time, time[data-local]").forEach(updateElement)
+      }
+    }
+  }
+})
+
+if (typeof document !== "undefined") {
+  if (document.documentElement) {
+    observer.observe(document.documentElement, { childList: true, subtree: true })
+  }
+
+  document.addEventListener("turbo:load", () => updateAll())
+  document.addEventListener("turbo:frame-load", (event) => updateAll(event.target))
+  document.addEventListener("turbo:render", () => updateAll())
+
+  setInterval(() => updateAll(), 60_000)
+}
