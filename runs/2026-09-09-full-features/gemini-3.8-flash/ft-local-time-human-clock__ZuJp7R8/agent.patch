diff --git a/app/javascript/helpers/local_time.js b/app/javascript/helpers/local_time.js
new file mode 100644
index 0000000..27899c3
--- /dev/null
+++ b/app/javascript/helpers/local_time.js
@@ -0,0 +1,219 @@
+const MONTHS = [
+  "January", "February", "March", "April", "May", "June",
+  "July", "August", "September", "October", "November", "December"
+]
+
+const SHORT_MONTHS = [
+  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
+  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
+]
+
+const WEEKDAYS = [
+  "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"
+]
+
+const SHORT_WEEKDAYS = [
+  "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"
+]
+
+export function parseDate(datetime) {
+  if (!datetime) return null
+
+  if (/^\d{4}-\d{2}-\d{2}$/.test(datetime)) {
+    const [year, month, day] = datetime.split("-").map(Number)
+    return new Date(year, month - 1, day)
+  }
+
+  const date = new Date(datetime)
+  return isNaN(date.getTime()) ? null : date
+}
+
+export function calendarDayDifference(fromDate, toDate) {
+  const fromMidnight = new Date(fromDate.getFullYear(), fromDate.getMonth(), fromDate.getDate())
+  const toMidnight = new Date(toDate.getFullYear(), toDate.getMonth(), toDate.getDate())
+  return Math.round((fromMidnight - toMidnight) / (1000 * 60 * 60 * 24))
+}
+
+export function formatStrftime(date, format) {
+  const hours = date.getHours()
+  const hours12 = hours % 12 || 12
+  const minutes = date.getMinutes()
+  const seconds = date.getSeconds()
+  const month = date.getMonth()
+  const day = date.getDate()
+  const year = date.getFullYear()
+  const weekday = date.getDay()
+
+  const tokens = {
+    "%A": WEEKDAYS[weekday],
+    "%a": SHORT_WEEKDAYS[weekday],
+    "%B": MONTHS[month],
+    "%b": SHORT_MONTHS[month],
+    "%d": String(day).padStart(2, "0"),
+    "%-d": String(day),
+    "%e": String(day),
+    "%m": String(month + 1).padStart(2, "0"),
+    "%-m": String(month + 1),
+    "%Y": String(year),
+    "%y": String(year).slice(-2),
+    "%H": String(hours).padStart(2, "0"),
+    "%-H": String(hours),
+    "%I": String(hours12).padStart(2, "0"),
+    "%-I": String(hours12),
+    "%l": String(hours12),
+    "%M": String(minutes).padStart(2, "0"),
+    "%-M": String(minutes),
+    "%S": String(seconds).padStart(2, "0"),
+    "%-S": String(seconds),
+    "%p": hours >= 12 ? "PM" : "AM",
+    "%P": hours >= 12 ? "pm" : "am"
+  }
+
+  return format.replace(/%[AaBbdeHhIlMmPpSyY]|%-[deHIlMPSm]/g, match => tokens[match] ?? match)
+}
+
+export function formatTimeOfDay(date) {
+  const hours12 = date.getHours() % 12 || 12
+  const minutes = String(date.getMinutes()).padStart(2, "0")
+  const meridiem = date.getHours() >= 12 ? "PM" : "AM"
+  return `${hours12}:${minutes} ${meridiem}`
+}
+
+export function formatRelative(date, now = new Date()) {
+  const diffDays = calendarDayDifference(now, date)
+
+  if (diffDays === 0) {
+    return formatTimeOfDay(date)
+  }
+
+  if (diffDays === 1) {
+    return "yesterday"
+  }
+
+  if (diffDays >= 2 && diffDays <= 6) {
+    return `${diffDays} days ago`
+  }
+
+  if (date.getFullYear() === now.getFullYear()) {
+    return `${SHORT_MONTHS[date.getMonth()]} ${date.getDate()}`
+  }
+
+  return `${SHORT_MONTHS[date.getMonth()]} ${date.getDate()}, ${date.getFullYear()}`
+}
+
+export function formatAutoClose(date, now = new Date()) {
+  const diffDays = calendarDayDifference(now, date)
+
+  if (diffDays === -1) {
+    return "tomorrow"
+  }
+
+  if (diffDays < -1) {
+    const days = -diffDays
+    return `in ${days} days`
+  }
+
+  if (diffDays === 0) {
+    return "today"
+  }
+
+  if (diffDays === 1) {
+    return "yesterday"
+  }
+
+  return `${diffDays} days ago`
+}
+
+export function formatTimeAgo(date, now = new Date()) {
+  const diffMs = now - date
+
+  if (diffMs < 0) {
+    return formatAutoClose(date, now)
+  }
+
+  const diffSeconds = Math.round(diffMs / 1000)
+  if (diffSeconds < 60) {
+    return "just now"
+  }
+
+  const diffMinutes = Math.round(diffSeconds / 60)
+  if (diffMinutes < 60) {
+    return `${diffMinutes} ${diffMinutes === 1 ? "minute" : "minutes"} ago`
+  }
+
+  const diffHours = Math.round(diffMinutes / 60)
+  const diffDays = calendarDayDifference(now, date)
+
+  if (diffHours < 24 && diffDays === 0) {
+    return `${diffHours} ${diffHours === 1 ? "hour" : "hours"} ago`
+  }
+
+  if (diffDays === 1) {
+    return "yesterday"
+  }
+
+  if (diffDays < 7) {
+    return `${diffDays} days ago`
+  }
+
+  if (diffDays < 30) {
+    const weeks = Math.round(diffDays / 7)
+    return `${weeks} ${weeks === 1 ? "week" : "weeks"} ago`
+  }
+
+  if (diffDays < 365) {
+    const months = Math.round(diffDays / 30)
+    return `${months} ${months === 1 ? "month" : "months"} ago`
+  }
+
+  const years = Math.max(1, Math.round(diffDays / 365))
+  return `${years} ${years === 1 ? "year" : "years"} ago`
+}
+
+export function formatLocalTime(date, { type, format } = {}, now = new Date()) {
+  if (format) {
+    return formatStrftime(date, format)
+  }
+
+  switch (type) {
+    case "auto-close":
+      return formatAutoClose(date, now)
+    case "time-ago":
+      return formatTimeAgo(date, now)
+    case "time-or-date":
+    case "relative":
+      return formatRelative(date, now)
+    case "time":
+      return formatTimeOfDay(date)
+    case "date":
+      return `${SHORT_MONTHS[date.getMonth()]} ${date.getDate()}`
+    default:
+      return formatRelative(date, now)
+  }
+}
+
+export function formatFullDateTime(date) {
+  const weekday = WEEKDAYS[date.getDay()]
+  const month = MONTHS[date.getMonth()]
+  const day = date.getDate()
+  const year = date.getFullYear()
+  const time = formatTimeOfDay(date)
+  return `${weekday}, ${month} ${day}, ${year} at ${time}`
+}
+
+export function updateElement(element) {
+  const datetime = element.getAttribute("datetime")
+  if (!datetime) return
+
+  const date = parseDate(datetime)
+  if (!date) return
+
+  const type = element.getAttribute("type") || element.getAttribute("data-local")
+  const format = element.getAttribute("format") || element.getAttribute("data-format")
+
+  element.textContent = formatLocalTime(date, { type, format })
+
+  if (!element.getAttribute("title")) {
+    element.title = formatFullDateTime(date)
+  }
+}
