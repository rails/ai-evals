diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..4e82782 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,46 @@
 module TimeHelper
+  def local_time(time, options = {}, &block)
+    return if time.blank?
+
+    options = { format: options } if options.is_a?(String)
+    local_time_tag(time, **options.reverse_merge(type: "time"), &block)
+  end
+
+  def local_date(time, options = {}, &block)
+    return if time.blank?
+
+    options = { format: options } if options.is_a?(String)
+    local_time_tag(time, **options.reverse_merge(type: "date"), &block)
+  end
+
+  def local_time_ago(time, options = {}, &block)
+    return if time.blank?
+
+    local_time_tag(time, **options.merge(type: "time-ago"), &block)
+  end
+
+  def local_relative_time(time, options = {}, &block)
+    return if time.blank?
+
+    local_time_tag(time, **options.reverse_merge(type: "time-or-date"), &block)
+  end
+
+  private
+    def local_time_tag(time, format: nil, type: nil, **options, &block)
+      iso_time = if time.is_a?(Date) && !time.is_a?(DateTime)
+        time.iso8601
+      else
+        (time.respond_to?(:utc) ? time.utc : time.to_time.utc).iso8601
+      end
+
+      content = block_given? ? capture(&block) : iso_time
+
+      tag.send(:"local-time",
+        content,
+        datetime: iso_time,
+        type: type,
+        format: format,
+        **options
+      )
+    end
 end
