diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..e416f9c
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,234 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+import { isMobile } from "helpers/platform_helpers"
+
+export default class extends Controller {
+  static get shouldLoad() {
+    return !isMobile()
+  }
+
+  dragstart(event) {
+    const card = event.target.closest("article.card")
+    if (!card) return
+
+    this.draggedCard = card
+    this.sourceColumn = card.closest(".cards")
+
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+
+    card.classList.add("drag-and-drop__dragged-item")
+  }
+
+  dragenter(event) {
+    if (!this.draggedCard) return
+    event.preventDefault()
+  }
+
+  dragover(event) {
+    if (!this.draggedCard) return
+
+    const column = event.target.closest(".cards")
+    if (!column || !this.element.contains(column)) {
+      this.#clearHover()
+      return
+    }
+
+    event.preventDefault()
+    event.dataTransfer.dropEffect = "move"
+
+    if (this.currentHoveredColumn !== column) {
+      this.#clearHover()
+      column.classList.add("drag-and-drop__hover-container")
+      this.currentHoveredColumn = column
+    }
+  }
+
+  dragleave(event) {
+    if (!this.draggedCard) return
+
+    if (!event.relatedTarget || !this.element.contains(event.relatedTarget)) {
+      this.#clearHover()
+    }
+  }
+
+  dragend(event) {
+    this.#cleanup()
+  }
+
+  async drop(event) {
+    if (!this.draggedCard) return
+
+    event.preventDefault()
+
+    const targetColumn = event.target.closest(".cards")
+    const card = this.draggedCard
+    const sourceColumn = this.sourceColumn
+
+    this.#cleanup()
+
+    if (!targetColumn || !sourceColumn || targetColumn === sourceColumn || !this.element.contains(targetColumn)) {
+      return
+    }
+
+    await this.#moveCard(card, sourceColumn, targetColumn)
+  }
+
+  // Private
+
+  #clearHover() {
+    if (this.currentHoveredColumn) {
+      this.currentHoveredColumn.classList.remove("drag-and-drop__hover-container")
+      this.currentHoveredColumn = null
+    }
+  }
+
+  #cleanup() {
+    this.#clearHover()
+    if (this.draggedCard) {
+      this.draggedCard.classList.remove("drag-and-drop__dragged-item")
+      this.draggedCard = null
+    }
+    this.sourceColumn = null
+  }
+
+  async #moveCard(card, sourceColumn, targetColumn) {
+    const originalParent = card.parentElement
+    const originalNextSibling = card.nextSibling
+    const originalClasses = card.className
+    const originalCardColor = card.style.getPropertyValue("--card-color")
+
+    const cardsList = targetColumn.querySelector(".cards__list")
+    if (!cardsList) return
+
+    const targetContainer = cardsList.querySelector("[data-timeline-target='frame']") || cardsList
+
+    // 1. Move card in the DOM according to column ordering
+    this.#insertCardIntoContainer(card, targetContainer)
+
+    // 2. Optimistically update card attributes & classes
+    this.#updateCardAttributes(card, targetColumn)
+
+    // 3. Update expander counts
+    this.#adjustExpanderCount(sourceColumn, -1)
+    this.#adjustExpanderCount(targetColumn, +1)
+
+    // 4. Send background request
+    try {
+      const response = await this.#sendMoveRequest(card, targetColumn)
+      if (!response || !response.ok) {
+        throw new Error(`Failed to move card: ${response?.statusCode}`)
+      }
+    } catch (error) {
+      console.error(error)
+      // Rollback DOM changes
+      if (originalNextSibling) {
+        originalParent.insertBefore(card, originalNextSibling)
+      } else {
+        originalParent.appendChild(card)
+      }
+      card.className = originalClasses
+      if (originalCardColor) {
+        card.style.setProperty("--card-color", originalCardColor)
+      } else {
+        card.style.removeProperty("--card-color")
+      }
+      this.#adjustExpanderCount(sourceColumn, +1)
+      this.#adjustExpanderCount(targetColumn, -1)
+    }
+  }
+
+  #insertCardIntoContainer(card, targetContainer) {
+    const isGolden = card.classList.contains("golden-effect")
+    const existingCards = Array.from(targetContainer.querySelectorAll("article.card")).filter(c => c !== card)
+
+    if (isGolden) {
+      if (existingCards.length > 0) {
+        existingCards[0].before(card)
+      } else {
+        targetContainer.prepend(card)
+      }
+    } else {
+      const goldenCards = existingCards.filter(c => c.classList.contains("golden-effect"))
+      if (goldenCards.length > 0) {
+        goldenCards[goldenCards.length - 1].after(card)
+      } else if (existingCards.length > 0) {
+        existingCards[0].before(card)
+      } else {
+        targetContainer.prepend(card)
+      }
+    }
+  }
+
+  #updateCardAttributes(card, targetColumn) {
+    const destination = this.#destinationFor(targetColumn)
+
+    if (destination === "not_now") {
+      card.classList.add("card--postponed")
+      card.classList.remove("card--active")
+      card.style.setProperty("--card-color", "var(--color-card-complete)")
+    } else if (destination === "closed") {
+      card.classList.remove("card--postponed")
+      card.classList.remove("card--active")
+      card.style.setProperty("--card-color", "var(--color-card-complete)")
+    } else if (destination === "stream") {
+      card.classList.add("card--active")
+      card.classList.remove("card--postponed")
+      card.style.setProperty("--card-color", "var(--color-card-default)")
+    } else if (destination === "column") {
+      card.classList.add("card--active")
+      card.classList.remove("card--postponed")
+      const columnColor = targetColumn.style.getPropertyValue("--card-color")
+      if (columnColor) {
+        card.style.setProperty("--card-color", columnColor)
+      }
+    }
+
+    const stages = card.querySelectorAll(".card__stages .card__column-name")
+    const targetColumnName = targetColumn.dataset.columnName
+    stages.forEach(stage => {
+      const matches = destination === "column" && stage.textContent.trim() === targetColumnName?.trim()
+      stage.classList.toggle("card__column-name--current", matches)
+    })
+  }
+
+  #destinationFor(column) {
+    if (column.dataset.dropDestination) {
+      return column.dataset.dropDestination
+    }
+    if (column.id === "not-now") return "not_now"
+    if (column.id === "maybe") return "stream"
+    if (column.id === "closed-cards") return "closed"
+    return "column"
+  }
+
+  async #sendMoveRequest(card, targetColumn) {
+    const destination = this.#destinationFor(targetColumn)
+
+    if (destination === "not_now") {
+      return post(card.dataset.cardNotNowUrl, { responseKind: "json" })
+    } else if (destination === "closed") {
+      return post(card.dataset.cardClosureUrl, { responseKind: "json" })
+    } else if (destination === "stream") {
+      return destroy(card.dataset.cardTriageUrl, { responseKind: "json" })
+    } else if (destination === "column") {
+      const columnId = targetColumn.dataset.columnId || targetColumn.id.replace(/^column_/, "")
+      return post(card.dataset.cardTriageUrl, {
+        body: { column_id: columnId },
+        responseKind: "json"
+      })
+    }
+  }
+
+  #adjustExpanderCount(column, delta) {
+    const countElement = column.querySelector(".cards__expander-count")
+    if (!countElement) return
+
+    const currentText = countElement.textContent.trim()
+    const currentCount = parseInt(currentText, 10)
+    if (!isNaN(currentCount)) {
+      const newCount = Math.max(0, currentCount + delta)
+      countElement.textContent = newCount > 99 ? "99+" : newCount
+    }
+  }
+}
