diff --git a/test/models/multi_tenant_rollout_test.rb b/test/models/multi_tenant_rollout_test.rb
new file mode 100644
index 0000000..bf1e68b
--- /dev/null
+++ b/test/models/multi_tenant_rollout_test.rb
@@ -0,0 +1,188 @@
+require "test_helper"
+
+class MultiTenantRolloutTest < ActiveSupport::TestCase
+  ACCOUNT_TABLES = %i[
+    accesses
+    account_cancellations
+    account_imports
+    account_join_codes
+    action_text_rich_texts
+    active_storage_attachments
+    active_storage_blobs
+    active_storage_variant_records
+    assignments
+    board_publications
+    boards
+    card_activity_spikes
+    card_goldnesses
+    card_not_nows
+    cards
+    closures
+    columns
+    comments
+    entropies
+    events
+    exports
+    filters
+    mentions
+    notification_bundles
+    notifications
+    pins
+    push_subscriptions
+    reactions
+    search_queries
+    steps
+    storage_entries
+    taggings
+    tags
+    user_settings
+    users
+    watches
+    webhook_delinquency_trackers
+    webhook_deliveries
+    webhooks
+  ].freeze
+
+  test "every table that holds account data has required and indexed account_id" do
+    conn = ActiveRecord::Base.connection
+
+    ACCOUNT_TABLES.each do |table|
+      col = conn.columns(table).find { |c| c.name == "account_id" }
+      assert_not_nil col, "Expected #{table} to have an account_id column"
+      assert_equal false, col.null, "Expected #{table}.account_id to be NOT NULL (required)"
+      assert conn.index_exists?(table, :account_id), "Expected #{table} to have an index on account_id"
+    end
+  end
+
+  test "tags table has scoped uniqueness on account_id and title" do
+    conn = ActiveRecord::Base.connection
+    assert conn.index_exists?(:tags, [ :account_id, :title ], unique: true),
+      "Expected tags to have a unique index on [account_id, title]"
+    assert_not conn.index_exists?(:tags, :title, unique: true),
+      "Expected global uniqueness index on tags.title to be removed"
+  end
+
+  test "associated records automatically inherit account_id from context" do
+    account = accounts(:"37s")
+    user = users(:david)
+    board = Board.create!(account: account, creator: user, name: "New Board")
+    card = board.cards.create!(account: account, creator: user, title: "Rollout Test Card")
+
+    Current.account = account
+
+    # Access
+    access = Access.create!(board: board, user: users(:kevin))
+    assert_equal account.id, access.account_id
+
+    # Assignment
+    assignment = Assignment.create!(card: card, assignee: users(:kevin), assigner: user)
+    assert_equal account.id, assignment.account_id
+
+    # Board::Publication
+    publication = Board::Publication.create!(board: board)
+    assert_equal account.id, publication.account_id
+
+    # Card::ActivitySpike
+    card_spike = cards(:layout)
+    spike = Card::ActivitySpike.create!(card: card_spike)
+    assert_equal account.id, spike.account_id
+
+    # Card::Goldness
+    card_gold = cards(:layout)
+    goldness = Card::Goldness.create!(card: card_gold)
+    assert_equal account.id, goldness.account_id
+
+    # Card::NotNow
+    card_not_now = cards(:layout)
+    not_now = Card::NotNow.create!(card: card_not_now, user: user)
+    assert_equal account.id, not_now.account_id
+
+    # Closure
+    closure = Closure.create!(card: card, user: user)
+    assert_equal account.id, closure.account_id
+
+    # Entropy
+    entropy = Entropy.create!(container: board, auto_postpone_period: 30.days.to_i)
+    assert_equal account.id, entropy.account_id
+
+    # Mention
+    mention = Mention.create!(source: card, mentioner: user, mentionee: users(:kevin))
+    assert_equal account.id, mention.account_id
+
+    # Pin
+    pin = Pin.create!(card: cards(:layout), user: user)
+    assert_equal account.id, pin.account_id
+
+    # Reaction
+    reaction = Reaction.create!(reactable: card, reacter: user, content: "🚀")
+    assert_equal account.id, reaction.account_id
+
+    # Search::Query
+    query = Search::Query.create!(user: user, terms: "multi tenant test")
+    assert_equal account.id, query.account_id
+
+    # Tagging
+    tag = Tag.create!(title: "test-tag")
+    assert_equal account.id, tag.account_id
+    tagging = Tagging.create!(card: card, tag: tag)
+    assert_equal account.id, tagging.account_id
+
+    # User::Settings
+    new_user = User.create!(account: account, identity: Identity.create!(email_address: "unique-test-user@example.com"), name: "New David")
+    assert_equal account.id, new_user.settings.account_id
+
+    # Watch
+    watch = Watch.create!(card: cards(:shipping), user: user)
+    assert_equal account.id, watch.account_id
+
+    # Webhook::DelinquencyTracker
+    webhook = Webhook.create!(board: board, name: "WH", url: "https://example.com/test", signing_secret: "sec")
+    tracker = Webhook::DelinquencyTracker.create!(webhook: webhook)
+    assert_equal account.id, tracker.account_id
+
+    # Webhook::Delivery
+    event = events(:logo_published)
+    delivery = Webhook::Delivery.create!(webhook: webhook, event: event)
+    assert_equal account.id, delivery.account_id
+
+    # ActiveStorage::Blob
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("test content"),
+      filename: "test.txt",
+      content_type: "text/plain"
+    )
+    assert_equal account.id, blob.account_id
+
+    # ActiveStorage::VariantRecord
+    variant_record = ActiveStorage::VariantRecord.create!(
+      blob: blob,
+      variation_digest: "test_digest_edge_case"
+    )
+    assert_equal account.id, variant_record.account_id
+
+    # ActiveStorage::Attachment
+    attachment = ActiveStorage::Attachment.create!(
+      name: "file",
+      record: card,
+      blob: blob
+    )
+    assert_equal account.id, attachment.account_id
+
+    # ActionText::RichText
+    rich_text = ActionText::RichText.create!(
+      record: card,
+      name: "description",
+      body: "Test content"
+    )
+    assert_equal account.id, rich_text.account_id
+  end
+
+  test "cannot persist account records with null account_id" do
+    assert_raises ActiveRecord::NotNullViolation do
+      ActiveRecord::Base.connection.execute <<~SQL
+        INSERT INTO accesses (id, board_id, user_id, involvement, created_at, updated_at, account_id)
+        VALUES ('#{ActiveRecord::Type::Uuid.generate}', '#{boards(:writebook).id}', '#{users(:david).id}', 'access_only', '#{Time.current}', '#{Time.current}', NULL)
+      SQL
+    end
+  end
+end
