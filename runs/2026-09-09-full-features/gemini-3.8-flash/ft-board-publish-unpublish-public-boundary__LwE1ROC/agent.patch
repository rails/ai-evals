+              <span class="for-screen-reader">Maximize column</span>
+            <% end %>
+          </header>
+          <%= column_frame_tag dom_id(column, :cards), src: public_board_column_path(@board.publication_key, column) %>
+        <% end %>
+      <% end %>
+    </div>
+  </div>
+<% end %>
