@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @board = boards(:writebook)
+  end
+
+  test "board JSON includes public_url as nil by default" do
+    get board_path(@board), as: :json
+    assert_response :success
+    assert_nil @response.parsed_body["public_url"]
+  end
+
+  test "publish board as admin" do
+    assert_difference -> { Board::Publication.count }, 1 do
+      post board_publication_path(@board)
+    end
+
+    assert_redirected_to @board
+    assert @board.reload.published?
+    assert @board.publication.key.present?
+  end
+
+  test "publish board as admin using JSON" do
+    post board_publication_path(@board), as: :json
+
+    assert_response :created
+    assert @board.reload.published?
+    assert_equal "http://www.example.com/public/boards/#{@board.publication_key}", @response.parsed_body["public_url"]
+  end
+
+  test "board JSON includes public_url when published" do
+    @board.publish
+
+    get board_path(@board), as: :json
+    assert_response :success
+    assert_equal "http://www.example.com/public/boards/#{@board.publication_key}", @response.parsed_body["public_url"]
+  end
+
+  test "publish board as non-admin board creator is forbidden" do
+    logout_and_sign_in_as :david
+
+    post board_publication_path(@board)
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "publish board as non-admin member is forbidden" do
+    logout_and_sign_in_as :jz
+
+    post board_publication_path(@board)
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "unpublish board as admin" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      delete board_publication_path(@board)
+    end
+
+    assert_redirected_to @board
+    assert_not @board.reload.published?
+  end
+
+  test "unpublish board as admin using JSON" do
+    @board.publish
+
+    delete board_publication_path(@board), as: :json
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+
+    get board_path(@board), as: :json
+    assert_nil @response.parsed_body["public_url"]
+  end
+
+  test "unpublish board as non-admin board creator is forbidden" do
+    @board.publish
+    logout_and_sign_in_as :david
+
+    delete board_publication_path(@board)
+
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "unpublish board as non-admin member is forbidden" do
+    @board.publish
+    logout_and_sign_in_as :jz
+
+    delete board_publication_path(@board)
+
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+end
