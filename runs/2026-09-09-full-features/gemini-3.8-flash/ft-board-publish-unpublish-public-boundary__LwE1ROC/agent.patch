diff --git a/test/models/board/publication_test.rb b/test/models/board/publication_test.rb
new file mode 100644
index 0000000..b2dddf7
--- /dev/null
+++ b/test/models/board/publication_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Board::PublicationTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "board is not published by default" do
+    assert_not @board.published?
+    assert_nil @board.publication
+    assert_nil @board.publication_key
+    assert_nil @board.public_url
+  end
+
+  test "publish board creates publication and generates secret key" do
+    @board.publish
+
+    assert @board.published?
+    assert_not_nil @board.publication
+    assert_not_nil @board.publication_key
+    assert_equal 24, @board.publication_key.length
+    assert_equal "http://example.com/public/boards/#{@board.publication_key}", @board.public_url
+  end
+
+  test "publish board is idempotent" do
+    pub1 = @board.publish
+    pub2 = @board.publish
+
+    assert_equal pub1, pub2
+  end
+
+  test "unpublish board destroys publication and resets public_url" do
+    @board.publish
+    assert @board.published?
+
+    @board.unpublish
+
+    assert_not @board.published?
+    assert_nil @board.publication
+    assert_nil @board.public_url
+  end
+
+  test "destroying board destroys publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy
+    end
+  end
+
+  test "published scope returns only published boards" do
+    assert_not_includes Board.published, @board
+
+    @board.publish
+    assert_includes Board.published, @board
+  end
+end
