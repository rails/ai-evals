+<% @page_title = @card.title %>
+<% @header_class = "header--card" %>
+
+<% content_for :head do %>
+  <%= card_social_tags(@card) %>
+<% end %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= link_to @board.name, public_board_path(@board.publication_key), class: "btn btn--circle-mobile" %>
+  </div>
+<% end %>
+
+<div data-controller="lightbox">
+  <section id="<%= dom_id(@card, :card_container) %>" class="card-perma" style="--card-color: <%= @card.color %>;">
+    <div class="card-perma__bg">
+      <%= card_article_tag @card, class: "card" do %>
+        <header class="card__header">
+          <%= render "cards/display/common/board", card: @card %>
+          <% if @card.tags.any? %>
+            <div class="card__tags-list min-width">
+              <% @card.tags.each_with_index do |tag, index| %>
+                <span class="card__tag btn btn--plain min-width txt-uppercase fill-transparent"><%= tag.title %></span><%= "," unless index == @card.tags.size - 1 %>
+              <% end %>
+            </div>
+          <% end %>
+        </header>
+
+        <div class="card__body justify-space-between">
+          <div class="card__content">
+            <h1 class="card__title flex align-start gap-half">
+              <%= card_html_title(@card) %>
+            </h1>
+
+            <% unless @card.description.blank? %>
+              <div class="card__description lexxy-content" data-controller="syntax-highlight retarget-links">
+                <%= @card.description %>
+              </div>
+            <% end %>
+
+            <% if @card.steps.any? %>
+              <ol class="steps txt-small margin-block-start-auto">
+                <% @card.steps.each do |step| %>
+                  <li class="step">
+                    <input type="checkbox" class="checkbox" disabled <%= "checked" if step.completed? %>>
+                    <span class="step__content"><%= step.content %></span>
+                  </li>
+                <% end %>
+              </ol>
+            <% end %>
+          </div>
+
+          <%= render "cards/display/common/stamp", card: @card %>
+        </div>
+
+        <footer class="card__footer">
+          <%= render "cards/display/perma/meta", card: @card %>
+          <%= render "cards/display/perma/background", card: @card %>
+          <% if @card.reactions.any? %>
+            <div class="reactions">
+              <div class="reactions__list">
+                <%= render partial: "reactions/reaction", collection: @card.reactions %>
+              </div>
+            </div>
+          <% end %>
+        </footer>
+      <% end %>
+    </div>
+  </section>
+
+  <% if @card.comments.any? %>
+    <%= messages_tag(@card) do %>
+      <%= render partial: "cards/comments/comment", collection: @card.comments.preloaded.chronologically, cached: true %>
+    <% end %>
+  <% end %>
+
+  <%= render "layouts/lightbox" %>
+</div>
