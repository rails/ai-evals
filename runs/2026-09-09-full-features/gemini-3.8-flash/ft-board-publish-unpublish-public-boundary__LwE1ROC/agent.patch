diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..0c396d7
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,42 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, class_name: "Board::Publication", dependent: :destroy
+    delegate :key, to: :publication, prefix: true, allow_nil: true
+
+    scope :published, -> { joins(:publication) }
+  end
+
+  def published?
+    publication.present? && !publication.destroyed?
+  end
+
+  def publish
+    if published?
+      publication
+    else
+      create_publication!
+    end
+  end
+
+  def unpublish
+    if published?
+      publication.destroy
+      association(:publication).reset
+    end
+  end
+
+  def public_url(**options)
+    if published?
+      base_options = { host: "example.com" }
+        .merge(Rails.application.routes.default_url_options.presence || {})
+        .merge(Rails.application.config.action_mailer.default_url_options.presence || {})
+
+      Rails.application.routes.url_helpers.public_board_url(
+        publication_key,
+        **base_options.merge(script_name: nil).merge(options)
+      )
+    end
+  end
+end
