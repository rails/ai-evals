index d3e48d6..9f0dcbd 100644
--- a/app/models/board/entropic.rb
+++ b/app/models/board/entropic.rb
@@ -18,4 +18,16 @@ module Board::Entropic
   def auto_postpone_period_in_days=(value)
     self.auto_postpone_period = value.to_i.days.to_i
   end
+
+  def auto_postpone_all_due
+    return unless auto_postpone_period
+
+    cutoff = Time.current - auto_postpone_period
+    system_user = nil
+
+    cards.active.where("last_active_at <= ?", cutoff).find_each do |card|
+      system_user ||= account.system_user
+      card.auto_postpone(user: system_user)
+    end
+  end
 end
