diff --git a/test/models/identity/email_verification_code_test.rb b/test/models/identity/email_verification_code_test.rb
new file mode 100644
index 0000000..2fb0a8b
--- /dev/null
+++ b/test/models/identity/email_verification_code_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Identity::EmailVerificationCodeTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "generates a six-character code" do
+    verification = Identity::EmailVerificationCode.create!(email_address: "test@example.com")
+    assert_equal 6, verification.code.length
+    assert_match /\A[A-Z0-9]{6}\z/, verification.code
+  end
+
+  test "validates email format" do
+    assert_raises(ActiveRecord::RecordInvalid) do
+      Identity::EmailVerificationCode.create!(email_address: "invalid-email")
+    end
+  end
+
+  test "normalizes email and code" do
+    verification = Identity::EmailVerificationCode.create!(email_address: "  TEST@EXAMPLE.COM  ", code: "abc123")
+    assert_equal "test@example.com", verification.email_address
+    assert_equal "ABC123", verification.code
+  end
+
+  test "verifies valid code" do
+    verification = Identity::EmailVerificationCode.create!(email_address: "test@example.com", code: "ABC123")
+
+    result = Identity::EmailVerificationCode.verify(code: "abc123", email_address: "test@example.com")
+    assert_equal "test@example.com", result.email_address
+    assert_nil Identity::EmailVerificationCode.find_by(id: verification.id)
+  end
+
+  test "verifies without email_address when unique" do
+    verification = Identity::EmailVerificationCode.create!(email_address: "test@example.com", code: "ABC123")
+
+    result = Identity::EmailVerificationCode.verify(code: "abc123")
+    assert_equal "test@example.com", result.email_address
+    assert_nil Identity::EmailVerificationCode.find_by(id: verification.id)
+  end
+
+  test "fails verification with invalid code" do
+    Identity::EmailVerificationCode.create!(email_address: "test@example.com", code: "ABC123")
+
+    assert_nil Identity::EmailVerificationCode.verify(code: "WRONG1", email_address: "test@example.com")
+  end
+
+  test "code works for 15 minutes" do
+    verification = Identity::EmailVerificationCode.create!(email_address: "test@example.com", code: "ABC123")
+
+    travel 14.minutes do
+      assert_not verification.reload.expired?
+      assert Identity::EmailVerificationCode.verify(code: "ABC123", email_address: "test@example.com")
+    end
+  end
+
+  test "code expires after 15 minutes" do
+    verification = Identity::EmailVerificationCode.create!(email_address: "test@example.com", code: "ABC123")
+
+    travel 16.minutes do
+      assert verification.reload.expired?
+      assert_nil Identity::EmailVerificationCode.verify(code: "ABC123", email_address: "test@example.com")
+    end
+  end
+
+  test "send_code_to sends email with code in subject" do
+    assert_emails 1 do
+      Identity::EmailVerificationCode.send_code_to("test@example.com")
+    end
+
+    mail = ActionMailer::Base.deliveries.last
+    assert_equal [ "test@example.com" ], mail.to
+    assert_match /\A[A-Z0-9]{6} is your Fizzy code\z/, mail.subject
+    assert_includes mail.body.encoded, mail.subject[0...6]
+  end
+end
