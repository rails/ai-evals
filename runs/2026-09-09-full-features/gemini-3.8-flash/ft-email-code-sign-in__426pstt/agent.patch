index 0000000..96dd7fd
--- /dev/null
+++ b/app/views/join_codes/code.html.erb
@@ -0,0 +1,34 @@
+<% @page_title = "Join #{@join_code.account.name} in Fizzy" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-none"><%= @page_title %></h1>
+
+  <%= form_with url: join_path(code: @join_code.code, tenant: params[:tenant]), class: "flex flex-column gap txt-medium", data: { turbo: false, controller: "form" } do |form| %>
+    <%= form.hidden_field :email_address, value: @email_address %>
+
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input full-width", autofocus: true, autocomplete: "one-time-code", placeholder: "6-character code" %>
+      </label>
+    </div>
+
+    <p>We just sent a six-character code to <strong><%= @email_address %></strong>. It works for 15 minutes.</p>
+
+    <% if flash[:alert] %>
+      <div class="txt-negative txt-small center"><%= flash[:alert] %></div>
+    <% end %>
+
+    <button type="submit" id="log_in" class="btn btn--link center" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <div class="margin-block-start">
+    <%= link_to "Use a different email", join_path(code: @join_code.code), class: "btn btn--plain txt-link center txt-small" %>
+  </div>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
