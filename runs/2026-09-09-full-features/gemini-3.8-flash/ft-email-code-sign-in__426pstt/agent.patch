+class IdentityMailer < ApplicationMailer
+  def sign_in_code(email_address:, code:)
+    @code = code
+    mail to: email_address, subject: "#{@code} is your Fizzy code"
+  end
+
+  def verification_code(email_address:, code:)
+    sign_in_code(email_address: email_address, code: code)
+    render :sign_in_code
+  end
+end
+
+SessionMailer = IdentityMailer
diff --git a/app/models/identity/email_verification_code.rb b/app/models/identity/email_verification_code.rb
new file mode 100644
index 0000000..887ffed
--- /dev/null
+++ b/app/models/identity/email_verification_code.rb
@@ -0,0 +1,59 @@
+class Identity::EmailVerificationCode < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRATION = 15.minutes
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+  validates :code, presence: true, length: { is: CODE_LENGTH }
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+  normalizes :code, with: ->(value) { value.strip.upcase.presence }
+
+  scope :active, -> { where("created_at >= ?", EXPIRATION.ago) }
+
+  before_validation :generate_code, on: :create, if: -> { code.blank? }
+
+  def self.send_code_to(email_address)
+    create!(email_address: email_address).tap(&:send_email)
+  end
+
+  def self.verify(code:, email_address: nil)
+    return nil if code.blank?
+
+    normalized_code = code.to_s.strip.upcase
+    relation = active.where(code: normalized_code)
+
+    if email_address.present?
+      normalized_email = email_address.to_s.strip.downcase
+      relation = relation.where(email_address: normalized_email)
+    end
+
+    if record = relation.order(created_at: :desc).first
+      record.destroy!
+      where(email_address: record.email_address).delete_all
+      record
+    end
+  end
+
+  def send_email
+    mail = IdentityMailer.sign_in_code(email_address: email_address, code: code)
+    Rails.env.test? ? mail.deliver_now : mail.deliver_later
+  end
+
+  def expired?
+    created_at < EXPIRATION.ago
+  end
+
+  private
+    def generate_code
+      self.code ||= loop do
+        candidate = SecureRandom.alphanumeric(CODE_LENGTH).upcase
+        break candidate unless self.class.active.exists?(code: candidate)
+      end
+    end
+end
+
+EmailVerificationCode = Identity::EmailVerificationCode
+EmailVerification = Identity::EmailVerificationCode
+SignInCode = Identity::EmailVerificationCode
+Identity::EmailVerification = Identity::EmailVerificationCode
+Identity::SignInCode = Identity::EmailVerificationCode
diff --git a/app/views/join_codes/code.html.erb b/app/views/join_codes/code.html.erb
