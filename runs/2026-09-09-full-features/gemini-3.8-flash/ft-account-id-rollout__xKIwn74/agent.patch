diff --git a/test/models/account_id_rollout_test.rb b/test/models/account_id_rollout_test.rb
new file mode 100644
index 0000000..62e3dc5
--- /dev/null
+++ b/test/models/account_id_rollout_test.rb
@@ -0,0 +1,188 @@
+require "test_helper"
+
+class AccountIdRolloutTest < ActiveSupport::TestCase
+  ACCOUNT_DATA_TABLES = %w[
+    accesses
+    account_cancellations
+    account_imports
+    account_join_codes
+    action_text_rich_texts
+    active_storage_attachments
+    active_storage_blobs
+    active_storage_variant_records
+    assignments
+    board_publications
+    boards
+    card_activity_spikes
+    card_goldnesses
+    card_not_nows
+    cards
+    closures
+    columns
+    comments
+    entropies
+    events
+    exports
+    filters
+    mentions
+    notification_bundles
+    notifications
+    pins
+    push_subscriptions
+    reactions
+    search_queries
+    steps
+    storage_entries
+    storage_totals
+    taggings
+    tags
+    user_settings
+    users
+    watches
+    webhook_delinquency_trackers
+    webhook_deliveries
+    webhooks
+  ].freeze
+
+  test "every table holding account data has required and indexed account_id" do
+    connection = ActiveRecord::Base.connection
+
+    ACCOUNT_DATA_TABLES.each do |table_name|
+      columns = connection.columns(table_name)
+      account_column = columns.find { |c| c.name == "account_id" }
+
+      assert account_column, "Expected #{table_name} to have an account_id column"
+      assert_not account_column.null, "Expected #{table_name}.account_id to be NOT NULL (null: false)"
+
+      indexes = connection.indexes(table_name)
+      has_account_index = indexes.any? { |idx| idx.columns.include?("account_id") }
+
+      assert has_account_index, "Expected #{table_name} to have an index on account_id"
+    end
+  end
+
+  test "creating domain models sets account_id automatically" do
+    account = accounts("37s")
+    user = users(:david)
+    fresh_identity = Identity.create!(email_address: "fresh@example.com")
+    new_user = account.users.create!(name: "Fresh User", identity: fresh_identity)
+    board = boards(:writebook)
+    card = cards(:logo)
+    fresh_board = account.boards.create!(name: "Fresh Board", creator: user)
+    fresh_card = fresh_board.cards.create!(title: "Fresh Card", creator: user)
+
+    # Access
+    access = fresh_board.accesses.create!(user: new_user)
+    assert_equal account.id, access.account_id
+
+    # Assignment
+    assignment = fresh_card.assignments.create!(assignee: user, assigner: user)
+    assert_equal account.id, assignment.account_id
+
+    # Board::Publication
+    publication = fresh_board.create_publication!
+    assert_equal account.id, publication.account_id
+
+    # Card::ActivitySpike
+    spike = fresh_card.create_activity_spike!
+    assert_equal account.id, spike.account_id
+
+    # Card::Goldness
+    goldness = fresh_card.create_goldness!
+    assert_equal account.id, goldness.account_id
+
+    # Card::NotNow
+    not_now = fresh_card.create_not_now!(user: user)
+    assert_equal account.id, not_now.account_id
+
+    # Closure
+    closure = fresh_card.create_closure!(user: user)
+    assert_equal account.id, closure.account_id
+
+    # Entropy
+    entropy = fresh_board.create_entropy!(auto_postpone_period_in_days: 30)
+    assert_equal account.id, entropy.account_id
+
+    # Mention
+    mention = Mention.create!(source: fresh_card, mentioner: user, mentionee: new_user)
+    assert_equal account.id, mention.account_id
+
+    # Pin
+    pin = Pin.create!(card: fresh_card, user: user)
+    assert_equal account.id, pin.account_id
+
+    # Reaction
+    reaction = Reaction.create!(reactable: fresh_card, reacter: user, content: "🚀")
+    assert_equal account.id, reaction.account_id
+
+    # Search::Query
+    search_query = Search::Query.create!(user: user, terms: "ruby rails")
+    assert_equal account.id, search_query.account_id
+
+    # Storage::Total
+    storage_total = Storage::Total.create!(owner: fresh_card.board)
+    assert_equal account.id, storage_total.account_id
+
+    # Tagging
+    tag = account.tags.create!(title: "fresh-tag")
+    tagging = Tagging.create!(card: fresh_card, tag: tag)
+    assert_equal account.id, tagging.account_id
+
+    # User::Settings
+    settings = User::Settings.create!(user: new_user)
+    assert_equal account.id, settings.account_id
+
+    # Watch
+    watch = Watch.create!(card: fresh_card, user: user, watching: true)
+    assert_equal account.id, watch.account_id
+
+    # Webhook::DelinquencyTracker
+    webhook = fresh_board.webhooks.create!(name: "Test Hook", url: "https://example.com/hook", active: true)
+    assert_equal account.id, webhook.delinquency_tracker.account_id
+
+    # Webhook::Delivery
+    delivery = webhook.deliveries.create!(event: events(:logo_published), state: :pending)
+    assert_equal account.id, delivery.account_id
+
+    # ActionText::RichText
