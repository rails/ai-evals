@@ -0,0 +1,108 @@
+# Deployment
+
+Fizzy is designed to be easily deployed to a single Linux server with Docker using [Kamal](https://kamal-deploy.org/).
+
+## Architecture
+
+This deployment setup is optimized for running on a single box:
+
+- **All-in-one container**: The Rails web server (via Thruster and Puma) and Solid Queue background jobs run together in the same container.
+- **SQLite**: Primary database, Action Cable, Solid Cache, and Solid Queue databases run on SQLite and are stored locally in `/rails/storage`.
+- **Persistent storage**: A Docker volume (`fizzy_storage:/rails/storage`) persists your databases and uploaded Active Storage files across deploys.
+- **SSL via Kamal Proxy**: [Kamal Proxy](https://github.com/basecamp/kamal-proxy) automatically provisions and renews TLS/SSL certificates from Let's Encrypt.
+
+## Prerequisites
+
+1. A Linux server (e.g. Ubuntu LTS) with SSH access.
+2. A domain name with a DNS A record pointing to your server's public IP.
+3. A container image registry (such as Docker Hub or GitHub Packages).
+4. An SMTP mail server for sending magic link sign-in emails and notifications.
+
+## Configuration
+
+### 1. Configure `config/deploy.yml`
+
+Edit `config/deploy.yml` with your details:
+
+```yaml
+service: fizzy
+image: your-user/fizzy
+
+servers:
+  web:
+    - 192.168.0.1  # Your server's public IP address or hostname
+
+proxy:
+  ssl: true
+  host: fizzy.example.com  # Your domain name
+
+registry:
+  username: your-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+builder:
+  arch: amd64
+
+env:
+  clear:
+    SOLID_QUEUE_IN_PUMA: true
+    APP_HOST: fizzy.example.com
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: your-smtp-username
+    # MAILER_FROM_ADDRESS: Fizzy <notifications@example.com>
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+```
+
+### 2. Configure `.kamal/secrets`
+
+Fill in your secrets in `.kamal/secrets` (or export them in your local environment):
+
+```shell
+# Registry token or password
+KAMAL_REGISTRY_PASSWORD=your-registry-token
+
+# Rails secret key base (generate with: bin/rails secret)
+SECRET_KEY_BASE=your-generated-secret-key-base
+
+# Mail server password
+SMTP_PASSWORD=your-smtp-password
+```
+
+## First Deploy (`kamal setup`)
+
+Run:
+
+```sh
+kamal setup
+```
+
+(or `bin/kamal setup`)
+
+This command will:
+1. Connect to your server and install Docker if needed.
+2. Log in to your image registry and build/push the Docker image.
+3. Start Kamal Proxy with automatic Let's Encrypt SSL.
+4. Prepare and migrate the SQLite databases.
+5. Start the container with web serving and background jobs.
+
+Once complete, visit `https://your-host` to start using Fizzy.
+
+## Subsequent Deploys
+
+For future updates, simply run:
+
+```sh
+kamal deploy
+```
+
+Your data in SQLite and uploaded files in Active Storage will survive across deployments.
+
+## Useful Commands
+
+- **View logs**: `kamal app logs -f`
+- **Rails console**: `kamal console`
+- **Shell**: `kamal shell`
diff --git a/test/deploy_config_test.rb b/test/deploy_config_test.rb
new file mode 100644
index 0000000..58a0c30
--- /dev/null
+++ b/test/deploy_config_test.rb
@@ -0,0 +1,105 @@
+require "test_helper"
+require "kamal"
+
+class DeployConfigTest < ActiveSupport::TestCase
+  test "kamal deployment configuration is valid" do
+    deploy_config_path = Rails.root.join("config/deploy.yml")
+    assert File.exist?(deploy_config_path), "config/deploy.yml must exist"
+
+    config = Kamal::Configuration.create_from(config_file: deploy_config_path)
+
+    # Everything in one container (only web role, which runs Puma + Solid Queue)
+    assert_equal [ "web" ], config.roles.map(&:name)
+    assert_equal 1, config.all_hosts.size
+
+    # Proxy with SSL enabled
+    assert config.proxy.ssl?, "Proxy SSL must be enabled"
+    assert config.proxy.hosts.any?, "Proxy host must be configured"
+
+    # Volume mounts to /rails/storage for data persistence
+    assert_includes config.volume_args, "fizzy_storage:/rails/storage"
+
+    # Background jobs run inside Puma in the web container
+    assert_equal true, config.role(:web).env("192.168.0.1").clear["SOLID_QUEUE_IN_PUMA"]
+
+    # Hostname and mail server settings are present in clear env
+    clear_env = config.role(:web).env("192.168.0.1").clear
+    assert clear_env.key?("APP_HOST")
+    assert clear_env.key?("SMTP_ADDRESS")
+    assert clear_env.key?("SMTP_PORT")
+  end
+
+  test "kamal secrets file defines all required secrets" do
+    secrets_path = Rails.root.join(".kamal/secrets")
+    assert File.exist?(secrets_path), ".kamal/secrets must exist"
+
+    deploy_config_path = Rails.root.join("config/deploy.yml")
+    config = Kamal::Configuration.create_from(config_file: deploy_config_path)
+
+    # Verify Kamal can read all secrets referenced in config/deploy.yml
+    secrets = config.secrets.to_h
+    assert secrets.key?("KAMAL_REGISTRY_PASSWORD")
+    assert secrets.key?("SECRET_KEY_BASE")
+    assert secrets.key?("RAILS_MASTER_KEY")
+    assert secrets.key?("SMTP_PASSWORD")
+  end
+
+  test "production environment configures host, smtp, and secrets correctly" do
+    script = <<~RUBY
+      require_relative "config/environment"
+      exit 1 unless Rails.application.config.action_mailer.default_url_options == { host: "fizzy.test.example.com", protocol: "https" }
+      exit 2 unless Rails.application.config.action_controller.default_url_options == { host: "fizzy.test.example.com", protocol: "https" }
+      exit 3 unless Rails.application.routes.default_url_options == { host: "fizzy.test.example.com", protocol: "https" }
+      exit 4 unless Rails.application.config.action_mailer.smtp_settings[:address] == "smtp.mailprovider.com"
+      exit 5 unless Rails.application.config.action_mailer.smtp_settings[:port] == 587
+      exit 6 unless Rails.application.config.action_mailer.smtp_settings[:user_name] == "smtpuser"
+      exit 7 unless Rails.application.config.action_mailer.smtp_settings[:password] == "smtppass"
+      exit 8 unless Rails.application.secret_key_base == "test_secret_key_base_value_12345"
+    RUBY
+
+    env = {
+      "APP_HOST" => "fizzy.test.example.com",
+      "SMTP_ADDRESS" => "smtp.mailprovider.com",
+      "SMTP_PORT" => "587",
+      "SMTP_USERNAME" => "smtpuser",
+      "SMTP_PASSWORD" => "smtppass",
+      "SECRET_KEY_BASE" => "test_secret_key_base_value_12345",
+      "RAILS_ENV" => "production"
+    }
+
+    assert system(env, "bundle", "exec", "ruby", "-e", script), "Production boot failed under test configuration"
+  end
+
+  test "production environment configures smtp from SMTP_URL" do
+    script = <<~RUBY
+      require_relative "config/environment"
+      exit 1 unless Rails.application.config.action_mailer.smtp_settings[:address] == "smtp.service.com"
+      exit 2 unless Rails.application.config.action_mailer.smtp_settings[:port] == 2525
+      exit 3 unless Rails.application.config.action_mailer.smtp_settings[:user_name] == "alice"
+      exit 4 unless Rails.application.config.action_mailer.smtp_settings[:password] == "pass123"
+    RUBY
+
+    env = {
+      "SMTP_URL" => "smtp://alice:pass123@smtp.service.com:2525",
+      "SECRET_KEY_BASE" => "test_secret_key_base_value_12345",
+      "RAILS_ENV" => "production"
+    }
+
+    assert system(env, "bundle", "exec", "ruby", "-e", script), "Production boot with SMTP_URL failed"
+  end
+
+  test "production environment falls back to RAILS_MASTER_KEY when SECRET_KEY_BASE is absent" do
+    script = <<~RUBY
+      require_relative "config/environment"
+      exit 1 unless Rails.application.secret_key_base == "master_key_fallback_value_12345"
+    RUBY
+
+    env = {
+      "SECRET_KEY_BASE" => "",
+      "RAILS_MASTER_KEY" => "master_key_fallback_value_12345",
+      "RAILS_ENV" => "production"
+    }
+
+    assert system(env, "bundle", "exec", "ruby", "-e", script), "Production fallback to RAILS_MASTER_KEY failed"
+  end
+end
