diff --git a/config/deploy.yml b/config/deploy.yml
new file mode 100644
index 0000000..9908fd2
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,65 @@
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image (e.g., your-user/fizzy on Docker Hub or ghcr.io/your-user/fizzy).
+image: your-user/fizzy
+
+# Deploy to this server.
+servers:
+  web:
+    - 192.168.0.1
+
+# Enable SSL auto-certification via Let's Encrypt and proxy requests to the container.
+proxy:
+  ssl: true
+  host: app.example.com
+
+# Container image registry credentials.
+registry:
+  # Specify the registry server if not using Docker Hub (e.g. ghcr.io)
+  # server: ghcr.io
+  username: your-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Configure builder architecture.
+builder:
+  arch: amd64
+
+# Inject ENV variables into containers (secrets come from .kamal/secrets).
+env:
+  clear:
+    # Run the Solid Queue Supervisor inside Puma (everything in one container).
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Application hostname for URLs in emails and background jobs.
+    APP_HOST: app.example.com
+
+    # Sender address for outgoing emails.
+    MAILER_FROM_ADDRESS: Fizzy <support@example.com>
+
+    # Mail server (SMTP) configuration.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USERNAME: your-smtp-username
+    # SMTP_DOMAIN: example.com
+    # SMTP_AUTHENTICATION: plain
+    # SMTP_STARTTLS_AUTO: true
+  secret:
+    - RAILS_MASTER_KEY
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+
+# Aliases are triggered with "bin/kamal <alias>".
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
+
+# Persistent storage volume for SQLite databases and Active Storage files that survives deployments.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets between versions to avoid 404s during rolling deploys.
+asset_path: /rails/public/assets
