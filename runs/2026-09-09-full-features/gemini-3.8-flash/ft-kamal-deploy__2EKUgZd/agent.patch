@@ -0,0 +1,16 @@
+# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
+# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
+# password manager, ENV, or entered directly. DO NOT COMMIT RAW PRODUCTION CREDENTIALS!
+#
+# Values can be read from the environment (e.g. SECRET=$SECRET) or entered directly.
+
+# Container registry password (e.g. Docker Hub personal access token or GitHub PAT)
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# Rails secret key base (generate with: bin/rails secret)
+# You can provide either SECRET_KEY_BASE or RAILS_MASTER_KEY
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+RAILS_MASTER_KEY=$RAILS_MASTER_KEY
+
+# Mail server password (if required by your SMTP server)
+SMTP_PASSWORD=$SMTP_PASSWORD
