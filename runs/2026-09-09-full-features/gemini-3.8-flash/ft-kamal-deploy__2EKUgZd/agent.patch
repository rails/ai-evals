+        enable_starttls_auto: true
+      }.compact
+    elsif smtp_address = ENV["SMTP_ADDRESS"].presence
+      config.action_mailer.delivery_method = :smtp
+      config.action_mailer.smtp_settings = {
+        address: smtp_address,
+        port: ENV.fetch("SMTP_PORT", 587).to_i,
+        domain: ENV["SMTP_DOMAIN"].presence || app_host,
+        user_name: ENV["SMTP_USERNAME"].presence || ENV["SMTP_USER_NAME"].presence,
+        password: ENV["SMTP_PASSWORD"].presence,
+        authentication: (ENV["SMTP_AUTHENTICATION"].presence || ((ENV["SMTP_USERNAME"].present? || ENV["SMTP_USER_NAME"].present?) ? "plain" : nil))&.to_sym,
+        enable_starttls_auto: ENV["SMTP_STARTTLS_AUTO"] != "false" && ENV["SMTP_ENABLE_STARTTLS_AUTO"] != "false",
+        tls: ENV["SMTP_TLS"] == "true" || ENV["SMTP_PORT"] == "465"
+      }.compact
+    end
+  end
