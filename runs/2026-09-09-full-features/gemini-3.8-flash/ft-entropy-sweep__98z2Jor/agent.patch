diff --git a/app/models/board/entropic.rb b/app/models/board/entropic.rb
index d3e48d6..e740a05 100644
--- a/app/models/board/entropic.rb
+++ b/app/models/board/entropic.rb
@@ -2,10 +2,18 @@ module Board::Entropic
   extend ActiveSupport::Concern
 
   included do
-    delegate :auto_postpone_period, :auto_postpone_period_in_days, to: :entropy
+    delegate :auto_postpone_period, :auto_postpone_period_in_days, to: :entropy, allow_nil: true
     has_one :entropy, as: :container, dependent: :destroy
   end
 
+  def auto_postpone_all_due
+    return unless auto_postpone_period
+
+    cards.active.where("last_active_at <= ?", auto_postpone_period.seconds.ago).find_each do |card|
+      card.auto_postpone(user: account.system_user)
+    end
+  end
+
   def entropy
     super || account.entropy
   end
diff --git a/app/models/card/entropic.rb b/app/models/card/entropic.rb
index ebaad78..683d34e 100644
--- a/app/models/card/entropic.rb
+++ b/app/models/card/entropic.rb
