diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..d29fd3d
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,64 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reacter, only: :destroy
+  before_action :ensure_card_is_commentable, only: :create
+
+  def index
+    @reactions = @comment.reactions.chronologically
+
+    respond_to do |format|
+      format.json
+    end
+  end
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params)
+    @reaction.reacter = Current.user
+
+    if @reaction.save
+      respond_to do |format|
+        format.turbo_stream
+        format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+      end
+    else
+      respond_to do |format|
+        format.turbo_stream { head :unprocessable_entity }
+        format.json { render json: @reaction.errors, status: :unprocessable_entity }
+      end
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reacter
+      head :forbidden unless @reaction.reacter == Current.user
+    end
+
+    def ensure_card_is_commentable
+      head :forbidden unless @card.commentable?
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..efe43d4
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,56 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  connect() {
+    if (this.#isOwnReaction) {
+      this.element.classList.add("reaction--deleteable")
+    } else {
+      this.element.classList.remove("reaction--deleteable")
+    }
+  }
+
+  toggle(event) {
+    if (this.#isOwnReaction && !event.target.closest("a, button, form")) {
+      if (this.element.classList.contains("expanded")) {
+        this.collapse()
+      } else {
+        this.expand()
+      }
+    }
+  }
+
+  expand() {
+    this.element.classList.add("expanded")
+    this.boundCloseOnOutsideClick = this.boundCloseOnOutsideClick || this.closeOnOutsideClick.bind(this)
+    setTimeout(() => {
+      document.addEventListener("click", this.boundCloseOnOutsideClick)
+    }, 0)
+  }
+
+  collapse() {
+    this.element.classList.remove("expanded")
+    if (this.boundCloseOnOutsideClick) {
+      document.removeEventListener("click", this.boundCloseOnOutsideClick)
+    }
+  }
+
+  closeOnOutsideClick(event) {
+    if (!this.element.contains(event.target)) {
+      this.collapse()
+    }
+  }
+
+  delete(event) {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  disconnect() {
+    if (this.boundCloseOnOutsideClick) {
+      document.removeEventListener("click", this.boundCloseOnOutsideClick)
+    }
+  }
+
+  get #isOwnReaction() {
+    return this.element.dataset.creatorId === Current.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..1c97a4d
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,33 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add("reaction", "expanded")
+    this.inputTarget.value = ""
+    this.inputTarget.focus()
+  }
+
+  close() {
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction", "expanded")
+    this.inputTarget.value = ""
+    this.triggerTarget.hidden = false
+  }
+
+  cancel(event) {
+    event.preventDefault()
+    this.close()
+  }
+
+  submit(event) {
+    const value = (this.inputTarget.value || "").trim()
+    if (!value) {
+      event.preventDefault()
+      this.inputTarget.focus()
+    }
+  }
+}
