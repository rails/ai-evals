index 0000000..f235229
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,127 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    json = @response.parsed_body
+    assert_equal @comment.reactions.count, json.count
+    assert_equal "👍", json.first["content"]
+    assert_equal users(:david).id, json.first["reacter"]["id"]
+  end
+
+  test "create as Turbo Stream" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment),
+        params: { reaction: { content: "🎉" } },
+        as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :replace, target: ActionView::RecordIdentifier.dom_id(@comment, :reactions)
+    reaction = Reaction.last
+    assert_equal "🎉", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment),
+        params: { reaction: { content: "Nice work" } },
+        as: :json
+    end
+
+    assert_response :created
+    reaction = Reaction.last
+    assert_equal card_comment_reaction_path(@card, @comment, reaction, format: :json), @response.headers["Location"]
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal "Nice work", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body["reacter"]["id"]
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment),
+        params: { content: "🙌" },
+        as: :json
+    end
+
+    assert_response :created
+    assert_equal "🙌", Reaction.last.content
+  end
+
+  test "create with content exceeding 16 characters" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment),
+        params: { reaction: { content: "This is way too long for a reaction" } },
+        as: :json
+    end
+
+    assert_response :unprocessable_entity
+    assert_includes @response.parsed_body["content"], "is too long (maximum is 16 characters)"
+  end
+
+  test "create with blank content" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment),
+        params: { reaction: { content: "   " } },
+        as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create on draft card is forbidden" do
+    draft_card = boards(:writebook).cards.create!(status: :drafted, creator: users(:kevin))
+    # bypass card_is_commentable validation for setup
+    comment = draft_card.comments.build(creator: users(:kevin), account: draft_card.account)
+    comment.save!(validate: false)
+
+    assert_no_difference -> { comment.reactions.count } do
+      post card_comment_reactions_path(draft_card, comment),
+        params: { reaction: { content: "👍" } },
+        as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "destroy as Turbo Stream by reacter" do
+    reaction = reactions(:logo_agreement_kevin_rocket) # created by kevin
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :remove, target: ActionView::RecordIdentifier.dom_id(reaction)
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy as JSON by reacter" do
+    reaction = reactions(:logo_agreement_kevin_rocket)
+
+    delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy by another user is forbidden" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up) # created by david, logged in as kevin
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+    assert Reaction.exists?(reaction.id)
+  end
+end
