@@ -0,0 +1,83 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    Current.user = users(:david)
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "adding and removing a reaction on a comment" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment)}" do
+      # Initial reactions from fixtures
+      assert_selector ".reactions"
+      assert_selector ".reaction", text: "👍"
+
+      # Click the add button to reveal the small input
+      find(".reactions__trigger").click
+
+      # Input with confirm and cancel buttons is revealed
+      assert_selector ".reaction__form:not([hidden])"
+      assert_selector ".reaction__input"
+      assert_selector ".reaction__submit-btn"
+      assert_selector ".reaction__cancel-btn"
+      assert_no_selector ".reactions__trigger", visible: true
+
+      # Canceling hides the input and brings the button back
+      find(".reaction__cancel-btn").click
+      assert_no_selector ".reaction__form", visible: true
+      assert_selector ".reactions__trigger", visible: true
+
+      # Open input again and submit a reaction
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "cheers"
+      find(".reaction__submit-btn").click
+
+      # Confirming puts reaction in the strip, input is gone, button is back
+      assert_selector ".reaction", text: "cheers"
+      assert_no_selector ".reaction__form", visible: true
+      assert_selector ".reactions__trigger", visible: true
+
+      # Click own reaction to reveal way to remove it
+      own_reaction = find(".reaction", text: "cheers")
+      assert_no_selector ".reaction__delete", visible: true
+      own_reaction.click
+      assert_selector ".reaction__delete", visible: true
+
+      # Clicking remove button removes the reaction
+      find(".reaction__delete").click
+      assert_no_selector ".reaction", text: "cheers"
+    end
+  end
+
+  test "live updates: reactions land as they happen without reloading" do
+    visit card_url(@card)
+
+    wait_for_cable_subscriptions
+
+    within "##{dom_id(@comment)}" do
+      assert_no_selector ".reaction", text: "party"
+    end
+
+    # Another user reacts to the comment
+    Current.user = users(:kevin)
+    @comment.reactions.create!(content: "party", reacter: users(:kevin))
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    # Reaction lands in the strip without reloading
+    within "##{dom_id(@comment)}" do
+      assert_selector ".reaction", text: "party", wait: 5
+    end
+  end
+
+  private
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
