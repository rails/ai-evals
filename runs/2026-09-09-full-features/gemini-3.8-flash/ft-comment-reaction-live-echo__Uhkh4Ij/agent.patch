+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "valid reaction with emoji" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.build(content: "🎉", reacter: users(:david))
+
+    assert reaction.valid?
+    assert_equal users(:david).account, reaction.account
+  end
+
+  test "valid reaction with text up to 16 characters" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.build(content: "1234567890123456", reacter: users(:david))
+
+    assert reaction.valid?
+  end
+
+  test "invalid reaction with content longer than 16 characters" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.build(content: "12345678901234567", reacter: users(:david))
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+  end
+
+  test "invalid reaction with blank content" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.build(content: "   ", reacter: users(:david))
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "normalizes content by stripping whitespace" do
+    comment = comments(:logo_agreement_kevin)
+    reaction = comment.reactions.create!(content: "  👍  ", reacter: users(:david))
+
+    assert_equal "👍", reaction.content
+  end
+
+  test "touches comment and registers card activity on create" do
+    comment = comments(:logo_agreement_kevin)
+    card = comment.card
+    t_card = card.last_active_at
+
+    reaction = comment.reactions.create!(content: "🔥", reacter: users(:david))
+
+    assert_operator card.reload.last_active_at, :>=, t_card
+  end
+
+  test "destroyed when comment is destroyed" do
+    reaction = reactions(:logo_agreement_kevin_thumbs_up)
+    comment = reaction.comment
+
+    assert_difference "Reaction.count", -comment.reactions.count do
+      comment.destroy!
+    end
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+end
