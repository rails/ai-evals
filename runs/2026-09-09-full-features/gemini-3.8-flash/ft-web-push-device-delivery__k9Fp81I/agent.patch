diff --git a/test/models/notification/push_test.rb b/test/models/notification/push_test.rb
new file mode 100644
index 0000000..e2a013d
--- /dev/null
+++ b/test/models/notification/push_test.rb
@@ -0,0 +1,155 @@
+require "test_helper"
+
+class Notification::PushTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @account = @user.account
+    @subscription = Push::Subscription.create!(
+      account: @account,
+      user: @user,
+      endpoint: "https://push.example.com/sub/1",
+      p256dh_key: "p256dh",
+      auth_key: "auth"
+    )
+  end
+
+  test "creating a notification enqueues a push job when user has subscriptions" do
+    card = cards(:layout)
+    event = events(:layout_commented)
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      Notification.create!(user: @user, card: card, source: event, creator: users(:kevin))
+    end
+  end
+
+  test "creating a notification does not enqueue push job if user has no subscriptions" do
+    user_without_subs = users(:jz)
+    assert_empty user_without_subs.push_subscriptions
+
+    assert_no_enqueued_jobs(only: Notification::PushJob) do
+      Notification.create!(user: user_without_subs, card: cards(:layout), source: events(:layout_commented), creator: users(:kevin))
+    end
+  end
+
+  test "updating a notification with a new source enqueues push job" do
+    notification = notifications(:logo_mentioned_david)
+    new_event = events(:logo_published)
+
+    assert_enqueued_with(job: Notification::PushJob) do
+      notification.update!(source: new_event)
+    end
+  end
+
+  test "reading or unreading a notification does not enqueue push job" do
+    notification = notifications(:logo_mentioned_david)
+
+    assert_no_enqueued_jobs(only: Notification::PushJob) do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "push says what the tray says for an event" do
+    notification = notifications(:logo_assignment_kevin)
+    event = notification.source
+
+    expected_title = ApplicationController.helpers.event_notification_title(event)
+    expected_body = ApplicationController.helpers.event_notification_body(event)
+
+    assert_equal expected_title, notification.title
+    assert_equal expected_body, notification.body
+
+    payload = notification.push_payload
+    assert_equal expected_title, payload[:title]
+    assert_equal expected_body, payload[:body]
+  end
+
+  test "push says what the tray says for a mention" do
+    notification = notifications(:logo_mentioned_david)
+    mention = notification.source
+
+    expected_title = "#{mention.mentioner.first_name} @mentioned you"
+    expected_body = mention.source.mentionable_content.truncate(200)
+
+    assert_equal expected_title, notification.title
+    assert_equal expected_body, notification.body
+
+    payload = notification.push_payload
+    assert_equal expected_title, payload[:title]
+    assert_equal expected_body, payload[:body]
+  end
+
+  test "push payload includes card path with account slug" do
+    notification = notifications(:logo_mentioned_david)
+    card = notification.card
+
+    expected_path = Rails.application.routes.url_helpers.card_path(card, script_name: @account.slug)
+
+    assert_equal expected_path, notification.push_path
+    assert_equal expected_path, notification.push_payload[:path]
+    assert_equal expected_path, notification.push_payload.dig(:data, :path)
+    assert_equal card.id, notification.push_payload.dig(:data, :card_id)
+  end
+
+  test "deliver_push delivers to all user push subscriptions" do
+    second_sub = Push::Subscription.create!(
+      account: @account,
+      user: @user,
+      endpoint: "https://push.example.com/sub/2",
+      p256dh_key: "p256dh2",
+      auth_key: "auth2"
+    )
+
+    notification = notifications(:logo_mentioned_david)
+
+    delivered_endpoints = []
+    Push::Subscription.any_instance.stubs(:deliver).with do |payload|
+      delivered_endpoints << true
+      true
+    end
+
+    with_env("VAPID_PUBLIC_KEY" => "pub", "VAPID_PRIVATE_KEY" => "priv") do
+      notification.deliver_push
+    end
+
+    assert_equal 2, delivered_endpoints.size
+  end
+
+  test "push job performs delivery" do
+    notification = notifications(:logo_mentioned_david)
+    notification.expects(:deliver_push)
+
+    Notification::PushJob.perform_now(notification)
+  end
+
+  test "notifier triggers push delivery when notification lands in tray" do
+    event = events(:layout_commented)
+    recipient = users(:kevin)
+
+    notifications(:layout_commented_kevin).destroy
+
+    Push::Subscription.create!(
+      account: @account,
+      user: recipient,
+      endpoint: "https://push.example.com/sub/kevin",
+      p256dh_key: "p256dh_kevin",
+      auth_key: "auth_kevin"
+    )
+
+    notifications = nil
+    assert_enqueued_with(job: Notification::PushJob) do
+      notifications = Notifier.for(event).notify
+    end
+
+    assert_includes notifications.map(&:user), recipient
+  end
+
+  private
+    def with_env(vars)
+      originals = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
