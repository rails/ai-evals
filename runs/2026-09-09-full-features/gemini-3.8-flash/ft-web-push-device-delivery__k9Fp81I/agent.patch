diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..6b0bffb
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,35 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validates :endpoint, uniqueness: true
+
+  def deliver(payload)
+    return unless Push.enabled?
+
+    message = payload.is_a?(String) ? payload : JSON.generate(payload)
+
+    vapid = {
+      public_key: Push.public_key,
+      private_key: Push.private_key
+    }
+    vapid[:subject] = ENV["VAPID_SUBJECT"] if ENV["VAPID_SUBJECT"].present?
+
+    WebPush.payload_send(
+      message: message,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: vapid
+    )
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy
+  rescue WebPush::ResponseError => e
+    if e.response.is_a?(Net::HTTPGone) || e.response.is_a?(Net::HTTPNotFound)
+      destroy
+    else
+      raise
+    end
+  end
+end
