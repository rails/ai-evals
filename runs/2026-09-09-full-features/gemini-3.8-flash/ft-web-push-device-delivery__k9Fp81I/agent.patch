+    ENV["VAPID_PUBLIC_KEY"].presence || Rails.application.credentials.vapid_public_key
+  end
+
+  def self.private_key
+    ENV["VAPID_PRIVATE_KEY"].presence || Rails.application.credentials.vapid_private_key
