diff --git a/app/controllers/users/push_subscriptions_controller.rb b/app/controllers/users/push_subscriptions_controller.rb
new file mode 100644
index 0000000..5296997
--- /dev/null
+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,32 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_permission
+
+  def create
+    subscription = Push::Subscription.find_or_initialize_by(endpoint: push_subscription_params[:endpoint])
+    subscription.update!(
+      push_subscription_params.merge(
+        account: Current.account,
+        user: @user,
+        user_agent: request.user_agent
+      )
+    )
+
+    head :created
+  rescue ActiveRecord::RecordNotUnique
+    retry
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_permission
+      head :forbidden unless Current.user == @user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..1b95efe
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,166 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "details" ]
+  static values = {
+    subscriptionUrl: String,
+    publicKey: String
+  }
+
+  async connect() {
+    this.update()
+
+    if (this.#isGranted && "serviceWorker" in navigator) {
+      try {
+        const registration = await navigator.serviceWorker.ready
+        const subscription = await registration.pushManager.getSubscription()
+        if (subscription) {
+          this.element.classList.add("notifications--on")
+        } else {
+          this.element.classList.remove("notifications--on")
+        }
+      } catch (error) {
+        console.error("Error checking push subscription", error)
+      }
+    }
+  }
+
+  update() {
+    this.detailsTargets.forEach(target => {
+      target.hidden = !this.#isDenied
+    })
+
+    if (this.#isGranted) {
+      this.element.classList.add("notifications--on")
+    } else {
+      this.element.classList.remove("notifications--on")
+    }
+  }
+
+  async enable() {
+    if (!("Notification" in window)) return
+
+    try {
+      const permission = await this.#requestPermission()
+      this.update()
+
+      if (permission === "granted") {
+        await this.#subscribe()
+        this.element.classList.add("notifications--on")
+        this.detailsTargets.forEach(target => {
+          target.hidden = true
+        })
+      } else if (permission === "denied") {
+        this.element.classList.remove("notifications--on")
+        this.detailsTargets.forEach(target => {
+          target.hidden = false
+        })
+      }
+    } catch (error) {
+      console.error("Failed to enable push notifications", error)
+    }
+  }
+
+  async disable() {
+    try {
+      if ("serviceWorker" in navigator) {
+        const registration = await navigator.serviceWorker.ready
+        const subscription = await registration.pushManager.getSubscription()
+        if (subscription) {
+          await subscription.unsubscribe()
+        }
+      }
+      this.element.classList.remove("notifications--on")
+    } catch (error) {
+      console.error("Failed to disable push notifications", error)
+    }
+  }
+
+  async #subscribe() {
+    const registration = await navigator.serviceWorker.ready
+    let subscription = await registration.pushManager.getSubscription()
+
+    if (!subscription) {
+      const options = { userVisibleOnly: true }
+      const key = this.#publicKey
+      if (key) {
+        options.applicationServerKey = this.#urlBase64ToUint8Array(key)
+      }
+      subscription = await registration.pushManager.subscribe(options)
+    }
+
+    const { p256dh, auth } = this.#extractKeys(subscription)
+
+    await post(this.subscriptionUrlValue, {
+      body: {
+        push_subscription: {
+          endpoint: subscription.endpoint,
+          p256dh_key: p256dh,
+          auth_key: auth
+        }
+      }
+    })
+  }
+
+  get #publicKey() {
+    return this.hasPublicKeyValue && this.publicKeyValue.length > 0
+      ? this.publicKeyValue
+      : document.querySelector('meta[name="vapid-public-key"]')?.content
+  }
+
+  #extractKeys(subscription) {
+    const json = subscription.toJSON()
+    let p256dh = json.keys?.p256dh
+    let auth = json.keys?.auth
+
+    if (!p256dh && subscription.getKey) {
+      const buffer = subscription.getKey("p256dh")
+      if (buffer) p256dh = this.#arrayBufferToBase64(buffer)
+    }
+
+    if (!auth && subscription.getKey) {
+      const buffer = subscription.getKey("auth")
+      if (buffer) auth = this.#arrayBufferToBase64(buffer)
+    }
+
+    return { p256dh, auth }
+  }
+
+  #arrayBufferToBase64(buffer) {
+    const bytes = new Uint8Array(buffer)
+    let binary = ""
+    for (let i = 0; i < bytes.byteLength; i++) {
+      binary += String.fromCharCode(bytes[i])
+    }
+    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
+  }
+
+  #urlBase64ToUint8Array(base64String) {
+    const padding = "=".repeat((4 - (base64String.length % 4)) % 4)
+    const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/")
+    const rawData = window.atob(base64)
+    const outputArray = new Uint8Array(rawData.length)
+    for (let i = 0; i < rawData.length; ++i) {
+      outputArray[i] = rawData.charCodeAt(i)
+    }
+    return outputArray
+  }
+
+  async #requestPermission() {
+    return new Promise(resolve => {
+      const result = Notification.requestPermission(resolve)
+      if (result) {
+        resolve(result)
+      }
+    })
+  }
+
+  get #isGranted() {
+    return window.Notification?.permission === "granted"
+  }
+
+  get #isDenied() {
+    return window.Notification?.permission === "denied"
+  }
+}
