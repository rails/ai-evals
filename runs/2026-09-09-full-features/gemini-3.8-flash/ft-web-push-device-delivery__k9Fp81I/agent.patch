+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @account = @user.account
+    @vapid_key = WebPush.generate_key
+    @client_key = WebPush.generate_key
+
+    @subscription = Push::Subscription.create!(
+      account: @account,
+      user: @user,
+      endpoint: "https://fcm.googleapis.com/fcm/send/test-token",
+      p256dh_key: @client_key.public_key,
+      auth_key: "auth-secret-key-1234"
+    )
+  end
+
+  test "validates required fields" do
+    assert @subscription.valid?
+
+    assert_not Push::Subscription.new(user: @user).valid?
+    assert_not Push::Subscription.new(endpoint: "https://example.com", user: @user).valid?
+    assert_not Push::Subscription.new(endpoint: "https://example.com", p256dh_key: "key", user: @user).valid?
+  end
+
+  test "validates endpoint uniqueness" do
+    duplicate = Push::Subscription.new(
+      account: @account,
+      user: users(:kevin),
+      endpoint: @subscription.endpoint,
+      p256dh_key: "different_key",
+      auth_key: "different_auth"
+    )
+
+    assert_not duplicate.valid?
+    assert_includes duplicate.errors[:endpoint], "has already been taken"
+  end
+
+  test "belongs to user and account" do
+    assert_equal @user, @subscription.user
+    assert_equal @account, @subscription.account
+  end
+
+  test "deliver sends web push when push is enabled" do
+    with_env("VAPID_PUBLIC_KEY" => @vapid_key.public_key, "VAPID_PRIVATE_KEY" => @vapid_key.private_key) do
+      stub_request(:post, @subscription.endpoint).to_return(status: 201, body: "")
+
+      payload = { title: "New card", body: "David added a card", path: "/cards/1" }
+      @subscription.deliver(payload)
+
+      assert_requested :post, @subscription.endpoint do |req|
+        req.headers["Authorization"].start_with?("vapid t=")
+      end
+    end
+  end
+
+  test "deliver does nothing when push is disabled" do
+    with_env("VAPID_PUBLIC_KEY" => nil, "VAPID_PRIVATE_KEY" => nil) do
+      payload = { title: "New card", body: "David added a card" }
+      @subscription.deliver(payload)
+
+      assert_not_requested :post, @subscription.endpoint
+    end
+  end
+
+  test "deliver destroys subscription on 410 Gone (expired)" do
+    with_env("VAPID_PUBLIC_KEY" => @vapid_key.public_key, "VAPID_PRIVATE_KEY" => @vapid_key.private_key) do
+      stub_request(:post, @subscription.endpoint).to_return(status: 410, body: "Gone")
+
+      assert_difference -> { Push::Subscription.count }, -1 do
+        @subscription.deliver({ title: "Test", body: "Test body" })
+      end
+    end
+  end
+
+  test "deliver destroys subscription on 404 Not Found (invalid)" do
+    with_env("VAPID_PUBLIC_KEY" => @vapid_key.public_key, "VAPID_PRIVATE_KEY" => @vapid_key.private_key) do
+      stub_request(:post, @subscription.endpoint).to_return(status: 404, body: "Not Found")
+
+      assert_difference -> { Push::Subscription.count }, -1 do
+        @subscription.deliver({ title: "Test", body: "Test body" })
+      end
+    end
+  end
+
+  private
+    def with_env(vars)
+      originals = vars.keys.index_with { |key| ENV[key] }
+      vars.each { |key, value| ENV[key] = value }
+      yield
+    ensure
+      originals.each { |key, value| ENV[key] = value }
+    end
+end
