index 0000000..fe223d4
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,89 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create creates a push subscription" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user),
+        params: {
+          push_subscription: {
+            endpoint: "https://push.example.com/sub/123",
+            p256dh_key: "test_p256dh_key",
+            auth_key: "test_auth_key"
+          }
+        },
+        headers: { "User-Agent" => "Custom Browser 1.0" }
+    end
+
+    assert_response :created
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/sub/123", subscription.endpoint
+    assert_equal "test_p256dh_key", subscription.p256dh_key
+    assert_equal "test_auth_key", subscription.auth_key
+    assert_equal "Custom Browser 1.0", subscription.user_agent
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create updates existing subscription when endpoint is already registered" do
+    subscription = Push::Subscription.create!(
+      account: @user.account,
+      user: @user,
+      endpoint: "https://push.example.com/sub/123",
+      p256dh_key: "old_key",
+      auth_key: "old_auth"
+    )
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user),
+        params: {
+          push_subscription: {
+            endpoint: "https://push.example.com/sub/123",
+            p256dh_key: "new_key",
+            auth_key: "new_auth"
+          }
+        }
+    end
+
+    assert_response :created
+    assert_equal "new_key", subscription.reload.p256dh_key
+    assert_equal "new_auth", subscription.auth_key
+  end
+
+  test "cannot create push subscription for another user" do
+    other_user = users(:kevin)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(other_user),
+        params: {
+          push_subscription: {
+            endpoint: "https://push.example.com/sub/456",
+            p256dh_key: "key",
+            auth_key: "auth"
+          }
+        }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "unauthenticated user cannot create push subscription" do
+    sign_out
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user),
+        params: {
+          push_subscription: {
+            endpoint: "https://push.example.com/sub/789",
+            p256dh_key: "key",
+            auth_key: "auth"
+          }
+        }
+    end
+
+    assert_response :redirect
+  end
+end
