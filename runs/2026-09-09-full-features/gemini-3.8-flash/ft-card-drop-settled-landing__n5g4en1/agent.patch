diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..233fccb
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,277 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+export default class extends Controller {
+  static classes = [ "dragged", "hoverContainer" ]
+
+  connect() {
+    this.draggedCard = null
+    this.sourceColumn = null
+    this.hoveredColumn = null
+
+    this.#ensureCardsAreDraggable()
+
+    this.handleFrameLoad = () => this.#ensureCardsAreDraggable()
+    this.element.addEventListener("turbo:frame-load", this.handleFrameLoad)
+  }
+
+  disconnect() {
+    this.#clearHover()
+    if (this.handleFrameLoad) {
+      this.element.removeEventListener("turbo:frame-load", this.handleFrameLoad)
+    }
+  }
+
+  get draggedClassName() {
+    return this.hasDraggedClass ? this.draggedClass : "drag-and-drop__dragged-item"
+  }
+
+  get hoverContainerClassName() {
+    return this.hasHoverContainerClass ? this.hoverContainerClass : "drag-and-drop__hover-container"
+  }
+
+  dragstart(event) {
+    if (window.matchMedia("(max-width: 639px)").matches) return
+
+    if (event.target.closest("button, input, textarea, select, dialog, [contenteditable]")) {
+      return
+    }
+
+    const card = event.target.closest(".card")
+    if (!card || !this.element.contains(card)) return
+
+    this.draggedCard = card
+    this.sourceColumn = card.closest(".cards")
+    if (!this.sourceColumn) return
+
+    if (event.dataTransfer) {
+      event.dataTransfer.effectAllowed = "move"
+      event.dataTransfer.setData("text/plain", card.id || card.dataset.cardId || "")
+    }
+
+    requestAnimationFrame(() => {
+      if (this.draggedCard) {
+        this.draggedCard.classList.add(this.draggedClassName)
+      }
+    })
+  }
+
+  dragover(event) {
+    if (!this.draggedCard || !this.sourceColumn) return
+
+    const column = event.target.closest(".cards")
+    if (column && column !== this.sourceColumn && this.element.contains(column)) {
+      event.preventDefault()
+      if (event.dataTransfer) {
+        event.dataTransfer.dropEffect = "move"
+      }
+      this.#setHoveredColumn(column)
+    } else {
+      this.#clearHover()
+    }
+  }
+
+  dragenter(event) {
+    this.dragover(event)
+  }
+
+  dragleave(event) {
+    if (!this.element.contains(event.relatedTarget)) {
+      this.#clearHover()
+    }
+  }
+
+  dragend(event) {
+    if (this.draggedCard) {
+      this.draggedCard.classList.remove(this.draggedClassName)
+    }
+    this.#clearHover()
+    this.draggedCard = null
+    this.sourceColumn = null
+  }
+
+  drop(event) {
+    if (!this.draggedCard || !this.sourceColumn) return
+
+    const targetColumn = event.target.closest(".cards")
+    if (!targetColumn || targetColumn === this.sourceColumn || !this.element.contains(targetColumn)) {
+      this.#clearHover()
+      return
+    }
+
+    event.preventDefault()
+
+    const card = this.draggedCard
+    const sourceColumn = this.sourceColumn
+
+    card.classList.remove(this.draggedClassName)
+    this.#clearHover()
+
+    this.draggedCard = null
+    this.sourceColumn = null
+
+    // 1. Instantly move the card in the DOM
+    this.#moveCardInDOM(card, sourceColumn, targetColumn)
+
+    // 2. Persist the move to the server in the background
+    this.#persistCardMove(card, sourceColumn, targetColumn)
+  }
+
+  // Private
+
+  #setHoveredColumn(column) {
+    if (this.hoveredColumn === column) return
+
+    this.#clearHover()
+    this.hoveredColumn = column
+    this.hoveredColumn.classList.add(this.hoverContainerClassName)
+  }
+
+  #clearHover() {
+    if (this.hoveredColumn) {
+      this.hoveredColumn.classList.remove(this.hoverContainerClassName)
+      this.hoveredColumn = null
+    }
+  }
+
+  #moveCardInDOM(card, sourceColumn, targetColumn) {
+    this.#insertCardIntoColumn(card, targetColumn)
+    this.#updateCardVisualState(card, targetColumn)
+    this.#updateExpanderCount(sourceColumn, -1)
+    this.#updateExpanderCount(targetColumn, 1)
+    this.#ensureEmptyPlaceholder(sourceColumn)
+  }
+
+  #insertCardIntoColumn(card, targetColumn) {
+    const targetList = targetColumn.querySelector(".cards__list")
+    if (!targetList) return
+
+    const isSpecialColumn = targetColumn.id === "not-now" || targetColumn.id === "closed-cards"
+    const isGolden = card.classList.contains("golden-effect")
+
+    if (isSpecialColumn || isGolden) {
+      const firstCard = targetList.querySelector(".card")
+      if (firstCard && firstCard !== card) {
+        firstCard.before(card)
+      } else {
+        targetList.prepend(card)
+      }
+    } else {
+      const goldenCards = targetList.querySelectorAll(".card.golden-effect")
+      if (goldenCards.length > 0) {
+        const lastGolden = goldenCards[goldenCards.length - 1]
+        lastGolden.after(card)
+      } else {
+        const firstCard = targetList.querySelector(".card")
+        if (firstCard && firstCard !== card) {
+          firstCard.before(card)
+        } else {
+          targetList.prepend(card)
+        }
+      }
+    }
+  }
+
+  #updateCardVisualState(card, targetColumn) {
+    const targetId = targetColumn.id
+
+    if (targetId === "not-now") {
+      card.classList.remove("card--active")
+      card.classList.add("card--postponed")
+    } else if (targetId === "closed-cards") {
+      card.classList.remove("card--active", "card--postponed")
+    } else {
+      card.classList.remove("card--postponed")
+      card.classList.add("card--active")
+    }
+
+    if (targetId !== "not-now" && targetId !== "closed-cards") {
+      card.querySelectorAll(".card__closed").forEach(el => el.remove())
+    }
+  }
+
+  #updateExpanderCount(column, delta) {
+    const countEl = column.querySelector(".cards__expander-count")
+    if (!countEl) return
+
+    const text = countEl.textContent.trim()
+    if (text.includes("+")) return
+
+    const currentCount = parseInt(text, 10)
+    if (!isNaN(currentCount)) {
+      const newCount = Math.max(0, currentCount + delta)
+      countEl.textContent = newCount > 99 ? "99+" : newCount
+    }
+  }
+
+  #ensureEmptyPlaceholder(column) {
+    const list = column.querySelector(".cards__list")
+    if (!list) return
+
+    const hasCards = list.querySelectorAll(".card").length > 0
+    if (!hasCards && !list.querySelector(".blank-slate")) {
+      const defaultSlate = document.createElement("div")
+      defaultSlate.className = "blank-slate blank-slate--default"
+      defaultSlate.textContent = "No cards here"
+
+      const dragSlate = document.createElement("div")
+      dragSlate.className = "blank-slate blank-slate--drag overflow-ellipsis"
+      dragSlate.textContent = "Drag cards here"
+
+      list.appendChild(defaultSlate)
+      list.appendChild(dragSlate)
+    }
+  }
+
+  #persistCardMove(card, sourceColumn, targetColumn) {
+    const targetId = targetColumn.id
+    const columnId = targetColumn.dataset.columnId
+
+    const cardUrl = card.querySelector(".card__link")?.getAttribute("href")
+    const triageUrl = card.dataset.cardTriageUrl || (cardUrl ? `${cardUrl}/triage` : null)
+    const notNowUrl = card.dataset.cardNotNowUrl || (cardUrl ? `${cardUrl}/not_now` : null)
+    const closureUrl = card.dataset.cardClosureUrl || (cardUrl ? `${cardUrl}/closure` : null)
+
+    let requestPromise = null
+
+    if (targetId === "not-now") {
+      if (notNowUrl) {
+        requestPromise = post(notNowUrl, { responseKind: "json" })
+      }
+    } else if (targetId === "closed-cards") {
+      if (closureUrl) {
+        requestPromise = post(closureUrl, { responseKind: "json" })
+      }
+    } else if (targetId === "maybe") {
+      if (triageUrl) {
+        requestPromise = destroy(triageUrl, { responseKind: "json" })
+      }
+    } else if (columnId) {
+      if (triageUrl) {
+        requestPromise = post(triageUrl, {
+          query: { column_id: columnId },
+          body: { column_id: columnId },
+          responseKind: "json"
+        })
+      }
+    }
+
+    if (requestPromise) {
+      requestPromise.then(response => {
+        if (!response.ok) {
+          console.error("Card move failed with status:", response.statusCode)
+          window.location.reload()
+        }
+      }).catch(error => {
+        console.error("Card move failed with error:", error)
+        window.location.reload()
+      })
+    }
+  }
+
+  #ensureCardsAreDraggable() {
+    this.element.querySelectorAll(".card").forEach(card => {
+      card.draggable = true
+    })
+  }
+}
