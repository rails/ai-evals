diff --git a/app/models/notification/bundlable.rb b/app/models/notification/bundlable.rb
new file mode 100644
index 0000000..ba46206
--- /dev/null
+++ b/app/models/notification/bundlable.rb
@@ -0,0 +1,39 @@
+module Notification::Bundlable
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :bundle_items, class_name: "Notification::Bundle::Item", foreign_key: :notification_id, dependent: :destroy
+    has_many :bundles, through: :bundle_items, class_name: "Notification::Bundle"
+
+    after_save_commit :add_to_bundle, if: :should_bundle?
+  end
+
+  def bundle
+    bundles.open.first || bundles.chronologically.last
+  end
+
+  def bundle=(bundle)
+    bundle&.add_notification(self)
+  end
+
+  def bundle_notification
+    add_to_bundle
+  end
+
+  def bundle_now
+    add_to_bundle
+  end
+
+  private
+    def should_bundle?
+      (previously_new_record? || source_id_previously_changed?) && bundlable?
+    end
+
+    def bundlable?
+      creator&.system? != true && user&.active? && account&.active? && user.bundle_email_frequency != "never"
+    end
+
+    def add_to_bundle
+      Notification::Bundle.for(self)
+    end
+end
diff --git a/app/models/notification/bundle.rb b/app/models/notification/bundle.rb
new file mode 100644
index 0000000..81b17ca
--- /dev/null
+++ b/app/models/notification/bundle.rb
@@ -0,0 +1,113 @@
+class Notification::Bundle < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  has_many :items, class_name: "Notification::Bundle::Item", foreign_key: :bundle_id, dependent: :destroy
+  has_many :notifications, through: :items
+
+  scope :open, -> { where(delivered_at: nil) }
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :chronologically, -> { order(:starts_at, :created_at) }
+
+  validates :starts_at, :ends_at, presence: true
+  validate :no_overlapping_windows
+
+  class << self
+    def for(notification)
+      user = notification.user
+      return unless user&.settings&.bundle_email_enabled?
+
+      user.with_lock do
+        open_bundle = user.notification_bundles.open.chronologically.last
+
+        if open_bundle
+          if Time.current >= open_bundle.ends_at && notification.created_at >= open_bundle.ends_at
+            open_bundle.deliver_now
+            create_for(notification)
+          else
+            open_bundle.add_notification(notification)
+            open_bundle
+          end
+        else
+          create_for(notification)
+        end
+      end
+    end
+
+    def create_for(notification)
+      user = notification.user
+      duration = user.settings.bundle_duration
+      return unless duration
+
+      last_bundle = user.notification_bundles.chronologically.last
+      starts_at = [ notification.created_at, Time.current ].compact.max
+      if last_bundle && starts_at < last_bundle.ends_at
+        starts_at = last_bundle.ends_at
+      end
+      ends_at = starts_at + duration
+
+      bundle = user.notification_bundles.create!(
+        account: notification.account,
+        starts_at: starts_at,
+        ends_at: ends_at
+      )
+      bundle.add_notification(notification)
+      bundle.deliver_later
+      bundle
+    end
+  end
+
+  def add_notification(notification)
+    items.find_or_create_by!(
+      account: account,
+      notification: notification
+    )
+  end
+
+  def open?
+    delivered_at.nil?
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def deliver_later
+    Notification::BundleDeliveryJob.set(wait_until: ends_at).perform_later(self)
+  end
+
+  def deliver_now
+    return if delivered?
+
+    transaction do
+      update!(delivered_at: Time.current)
+
+      if should_send_email?
+        NotificationMailer.digest(self).deliver_now
+      end
+    end
+  end
+
+  private
+    def should_send_email?
+      user.active? &&
+        user.settings&.bundle_email_enabled? &&
+        notifications.any? &&
+        user.identity&.email_address.present?
+    end
+
+    def no_overlapping_windows
+      return unless user_id && starts_at && ends_at
+
+      overlapping = self.class
+        .where(user_id: user_id)
+        .where.not(id: id)
+        .where("starts_at < ? AND ends_at > ?", ends_at, starts_at)
+
+      if overlapping.exists?
+        errors.add(:base, "Nobody should ever end up with two overlapping windows")
+      end
+    end
+end
+
+NotificationBundle = Notification::Bundle
