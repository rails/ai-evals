new file mode 100644
index 0000000..e101e0d
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,22 @@
+class NotificationMailer < ApplicationMailer
+  default template_path: "mailers/notification_mailer"
+
+  def digest(bundle_or_user, notifications = nil)
+    if bundle_or_user.is_a?(Notification::Bundle)
+      @bundle = bundle_or_user
+      @user = @bundle.user
+      @account = @bundle.account
+      @notifications = @bundle.notifications.includes(:creator, :card, source: [ :creator ]).ordered
+    else
+      @user = bundle_or_user
+      @account = @user.account
+      @notifications = notifications || @user.notifications.ordered
+    end
+
+    mail(
+      to: @user.identity.email_address,
+      subject: "Fizzy notification digest"
+    )
+  end
+  alias_method :bundle, :digest
+end
