@@ -0,0 +1,52 @@
+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:david)
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    @notification = notifications(:logo_mentioned_david)
+    @bundle = Notification::Bundle.create!(
+      account: @user.account,
+      user: @user,
+      starts_at: Time.current,
+      ends_at: 4.hours.from_now
+    )
+    @bundle.add_notification(@notification)
+  end
+
+  test "digest sends to user email address" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+  end
+
+  test "digest has correct subject" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert_equal "Fizzy notification digest", email.subject
+  end
+
+  test "digest has both HTML and text parts" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert email.html_part.present?, "Email should have HTML part"
+    assert email.text_part.present?, "Email should have text part"
+  end
+
+  test "digest contains board name and notification info" do
+    email = NotificationMailer.digest(@bundle)
+
+    assert_match @notification.card.board.name, email.body.encoded
+    assert_match @notification.creator.name, email.body.encoded
+  end
+
+  test "Notification::BundleMailer alias works" do
+    email = Notification::BundleMailer.digest(@bundle)
+
+    assert_equal [ @user.identity.email_address ], email.to
+  end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..f0d351f
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,364 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+  setup do
+    @user = users(:david)
+    @user.settings.update!(bundle_email_frequency: :never)
+    @card = cards(:logo)
+    @creator = users(:kevin)
+    @user.notifications.destroy_all
+    @user.notification_bundles.destroy_all
+  end
+
+  test "bundle_email_frequency settings" do
+    assert_equal "never", @user.bundle_email_frequency
+    assert_nil @user.settings.bundle_duration
+
+    @user.bundle_email_frequency = "every_few_hours"
+    assert_equal "every_few_hours", @user.bundle_email_frequency
+    assert_equal 4.hours, @user.settings.bundle_duration
+
+    @user.bundle_email_frequency = "daily"
+    assert_equal "daily", @user.bundle_email_frequency
+    assert_equal 1.day, @user.settings.bundle_duration
+
+    @user.bundle_email_frequency = "weekly"
+    assert_equal "weekly", @user.bundle_email_frequency
+    assert_equal 1.week, @user.settings.bundle_duration
+  end
+
+  test "no bundle created when frequency is never" do
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      create_notification(@user, @card)
+    end
+  end
+
+  test "clock starts when the first notification lands" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    now = Time.current.change(usec: 0)
+
+    travel_to now do
+      assert_difference -> { Notification::Bundle.count }, 1 do
+        create_notification(@user, @card)
+      end
+
+      bundle = @user.notification_bundles.last
+      assert_equal now, bundle.starts_at
+      assert_equal now + 4.hours, bundle.ends_at
+      assert_nil bundle.delivered_at
+      assert bundle.open?
+    end
+  end
+
+  test "daily frequency creates 24-hour window" do
+    @user.settings.update!(bundle_email_frequency: :daily)
+    now = Time.current.change(usec: 0)
+
+    travel_to now do
+      create_notification(@user, @card)
+
+      bundle = @user.notification_bundles.last
+      assert_equal now, bundle.starts_at
+      assert_equal now + 1.day, bundle.ends_at
+    end
+  end
+
+  test "weekly frequency creates 7-day window" do
+    @user.settings.update!(bundle_email_frequency: :weekly)
+    now = Time.current.change(usec: 0)
+
+    travel_to now do
+      create_notification(@user, @card)
+
+      bundle = @user.notification_bundles.last
+      assert_equal now, bundle.starts_at
+      assert_equal now + 1.week, bundle.ends_at
+    end
+  end
+
+  test "notifications arriving later belong in the window that has already opened" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    card2 = cards(:layout)
+
+    now = Time.current.change(usec: 0)
+    travel_to now do
+      n1 = create_notification(@user, @card)
+      bundle = @user.notification_bundles.last
+      assert_equal [ n1 ], bundle.notifications.to_a
+
+      # Travel 2 hours later, within the 4-hour window
+      travel 2.hours
+      assert_no_difference -> { Notification::Bundle.count } do
+        n2 = create_notification(@user, card2)
+        assert_equal [ n1, n2 ].sort_by(&:id), bundle.reload.notifications.to_a.sort_by(&:id)
+      end
+
+      # Window time did not change
+      assert_equal now, bundle.starts_at
+      assert_equal now + 4.hours, bundle.ends_at
+    end
+  end
+
+  test "late arriving notifications with earlier timestamps belong in the open window" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    now = Time.current.change(usec: 0)
+
+    travel_to now do
+      n1 = create_notification(@user, @card)
+      bundle = @user.notification_bundles.last
+
+      # Notification with older created_at arrives
+      travel 1.hour
+      card2 = cards(:layout)
+      event = card2.events.create!(board: card2.board, action: "card_assigned", creator: @creator)
+      n2 = Notification.create!(
+        user: @user,
+        card: card2,
+        source: event,
+        creator: @creator,
+        created_at: now - 30.minutes
+      )
+
+      assert_equal 1, @user.notification_bundles.count
+      assert_includes bundle.reload.notifications, n2
+    end
+  end
+
+  test "nobody should ever end up with two overlapping windows" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    now = Time.current.change(usec: 0)
+
+    bundle1 = @user.notification_bundles.create!(
+      account: @user.account,
+      starts_at: now,
+      ends_at: now + 4.hours
+    )
+
+    # Overlapping window: starts inside bundle1
+    overlapping1 = @user.notification_bundles.build(
+      account: @user.account,
+      starts_at: now + 1.hour,
+      ends_at: now + 5.hours
+    )
+    assert_not overlapping1.valid?
+    assert_includes overlapping1.errors[:base], "Nobody should ever end up with two overlapping windows"
+
+    # Overlapping window: ends inside bundle1
+    overlapping2 = @user.notification_bundles.build(
+      account: @user.account,
+      starts_at: now - 1.hour,
+      ends_at: now + 2.hours
+    )
+    assert_not overlapping2.valid?
+    assert_includes overlapping2.errors[:base], "Nobody should ever end up with two overlapping windows"
+
+    # Non-overlapping window: starts exactly at ends_at of bundle1
+    non_overlapping = @user.notification_bundles.build(
+      account: @user.account,
+      starts_at: now + 4.hours,
+      ends_at: now + 8.hours
+    )
+    assert non_overlapping.valid?
+  end
+
+  test "after window delivers, next notification starts new non-overlapping window" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    now = Time.current.change(usec: 0)
+
+    travel_to now do
+      n1 = create_notification(@user, @card)
+      bundle1 = @user.notification_bundles.last
+
+      # Deliver bundle1 at 4 hours
+      travel 4.hours
+      bundle1.deliver_now
+      assert bundle1.delivered?
+
+      # Notification arrives at 5 hours
+      travel 1.hour
+      n2 = create_notification(@user, cards(:layout))
+
+      assert_equal 2, @user.notification_bundles.count
+      bundle2 = @user.notification_bundles.last
+
+      assert_equal [ n1 ], bundle1.notifications.to_a
+      assert_equal [ n2 ], bundle2.notifications.to_a
+
+      assert_equal now + 5.hours, bundle2.starts_at
+      assert_equal now + 9.hours, bundle2.ends_at
+
+      # Ensure no overlap between bundle1 and bundle2
+      assert bundle1.ends_at <= bundle2.starts_at
+    end
+  end
+
+  test "deliver_now sends one email for the window with all notifications" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    n1 = create_notification(@user, @card)
+    n2 = create_notification(@user, cards(:layout))
+
+    bundle = @user.notification_bundles.last
+    assert_equal 2, bundle.notifications.count
+
+    assert_emails 1 do
+      bundle.deliver_now
+    end
+
+    assert bundle.delivered?
+  end
+
+  test "deliver_now does not send email if frequency changed to never" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    create_notification(@user, @card)
+    bundle = @user.notification_bundles.last
+
+    @user.settings.update!(bundle_email_frequency: :never)
+
+    assert_no_emails do
+      bundle.deliver_now
+    end
+
+    assert bundle.delivered?
+  end
+
+  test "deliver_now is idempotent" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    create_notification(@user, @card)
+    bundle = @user.notification_bundles.last
+
+    assert_emails 1 do
+      bundle.deliver_now
+    end
+
+    assert_no_emails do
+      bundle.deliver_now
+    end
+  end
+
+  test "enqueues delivery job with wait_until set to bundle ends_at" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    now = Time.current.change(usec: 0)
+
+    travel_to now do
+      assert_enqueued_with(job: Notification::BundleDeliveryJob, at: now + 4.hours) do
+        create_notification(@user, @card)
+      end
+    end
+  end
+
+  test "delivery job delivers the bundle" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    create_notification(@user, @card)
+    bundle = @user.notification_bundles.last
+
+    assert_emails 1 do
+      Notification::BundleDeliveryJob.perform_now(bundle)
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "subsequent event on same card updates notification in the existing bundle without duplicates" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    n1 = create_notification(@user, @card)
+    bundle = @user.notification_bundles.last
+
+    assert_equal 1, bundle.notifications.count
+
+    # Second event on same card
+    event2 = @card.events.create!(board: @card.board, action: "comment_created", creator: @creator)
+    n1.update!(source: event2)
+
+    assert_equal 1, @user.notification_bundles.count
+    assert_equal 1, bundle.reload.notifications.count
+    assert_equal event2, bundle.notifications.first.source
+  end
+
+  test "notifications from inactive user are not bundled" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    @user.update!(active: false)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      create_notification(@user, @card)
+    end
+  end
+
+  test "notifications created by system user are not bundled" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    system_user = users(:system)
+
+    event = @card.events.create!(board: @card.board, action: "card_assigned", creator: system_user)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      Notification.create!(
+        user: @user,
+        card: @card,
+        source: event,
+        creator: system_user
+      )
+    end
+  end
+
+  test "bundle with deleted notifications marks delivered but sends no email" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    notification = create_notification(@user, @card)
+    bundle = @user.notification_bundles.last
+
+    notification.destroy
+
+    assert_no_emails do
+      bundle.deliver_now
+    end
+
+    assert bundle.delivered?
+  end
+
+  test "late arriving notification after previous window delivers starts non-overlapping window" do
+    @user.settings.update!(bundle_email_frequency: :every_few_hours)
+    now = Time.current.change(usec: 0)
+
+    travel_to now do
+      create_notification(@user, @card)
+      bundle1 = @user.notification_bundles.last
+
+      # Deliver bundle1 at 4 hours
+      travel 4.hours
+      bundle1.deliver_now
+
+      # Late arriving notification lands at 4h 5m with timestamp 3h 50m
+      travel 5.minutes
+      card2 = cards(:layout)
+      event = card2.events.create!(board: card2.board, action: "card_assigned", creator: @creator)
+      n2 = Notification.create!(
+        user: @user,
+        card: card2,
+        source: event,
+        creator: @creator,
+        created_at: now + 3.hours + 50.minutes
+      )
+
+      assert_equal 2, @user.notification_bundles.count
+      bundle2 = @user.notification_bundles.last
+
+      # bundle2 cannot start before bundle1 ended
+      assert bundle2.starts_at >= bundle1.ends_at
+      assert bundle2.starts_at >= bundle1.ends_at
+      assert_equal now + 4.hours + 5.minutes, bundle2.starts_at
+      assert_equal now + 8.hours + 5.minutes, bundle2.ends_at
+    end
+  end
+
+  private
+    def create_notification(user, card)
+      event = card.events.create!(board: card.board, action: "card_assigned", creator: @creator)
+      Notification.create!(
+        user: user,
+        card: card,
+        source: event,
+        creator: @creator
+      )
+    end
+end
