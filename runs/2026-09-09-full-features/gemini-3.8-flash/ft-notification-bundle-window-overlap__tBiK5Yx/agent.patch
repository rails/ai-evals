+<h1 class="title">Here’s what happened in Fizzy</h1>
+<p class="subtitle">You have <%= pluralize(@notifications.size, "new notification") %>.</p>
+
+<% @notifications.group_by { |n| n.card.board }.each_with_index do |(board, notifications), index| %>
+  <% if index > 0 %>
+    <hr class="notification__board-separator">
+  <% end %>
+
+  <h2 class="notification__board">
+    <%= link_to board.name, board_url(board, script_name: @account.slug) %>
+  </h2>
+
+  <% notifications.each do |notification| %>
+    <div class="notification">
+      <p class="card__title">
+        <%= link_to notification.card.title.presence || "Card #{notification.card.number}", card_url(notification.card, script_name: @account.slug) %>
+      </p>
+      <p class="notification__author">
+        <%= notification.creator.name %>
+      </p>
+      <div class="notification__details">
+        <%= notification.payload.body %>
+      </div>
+    </div>
+  <% end %>
+<% end %>
+
+<p class="footer">
+  <%= link_to "Change notification settings", notifications_settings_url(script_name: @account.slug) %>
+</p>
