+require "test_helper"
+
+class Board::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @account = @board.account
+  end
+
+  test "new board has 0 bytes_used" do
+    board = @account.boards.create!(name: "New Board", creator: users(:david))
+    assert_equal 0, board.bytes_used
+  end
+
+  test "calculates card image attachment in background" do
+    card = @board.cards.create!(title: "Card with image", creator: users(:david))
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      card.image.attach(blob)
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "calculates card description embeds in background" do
+    card = @board.cards.create!(title: "Card with embed", creator: users(:david))
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("card description file content"),
+      filename: "file.txt",
+      content_type: "text/plain"
+    )
+
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      card.description = ActionText::Content.new("Description").append_attachables(blob)
+      card.save!
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "calculates comment embeds in background" do
+    card = @board.cards.create!(title: "Card with comment", creator: users(:david), status: "published")
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("comment attachment content"),
+      filename: "comment.txt",
+      content_type: "text/plain"
+    )
+
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      comment = card.comments.create!(body: "Initial")
+      comment.body = ActionText::Content.new("Comment text").append_attachables(blob)
+      comment.save!
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "calculates board public_description embeds in background" do
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("board description attachment"),
+      filename: "board.txt",
+      content_type: "text/plain"
+    )
+
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      @board.public_description = ActionText::Content.new("Board description").append_attachables(blob)
+      @board.save!
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "updates storage when embed is removed" do
+    card = @board.cards.create!(title: "Card with embed", creator: users(:david))
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("card description file content"),
+      filename: "file.txt",
+      content_type: "text/plain"
+    )
+
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      card.description = ActionText::Content.new("Description").append_attachables(blob)
+      card.save!
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      card.description = ActionText::Content.new("Description without attachments")
+      card.save!
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "updates storage when comment is deleted" do
+    card = @board.cards.create!(title: "Card with comment", creator: users(:david), status: "published")
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("comment attachment content"),
+      filename: "comment.txt",
+      content_type: "text/plain"
+    )
+
+    comment = nil
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      comment = card.comments.create!(body: "Initial")
+      comment.body = ActionText::Content.new("Comment text").append_attachables(blob)
+      comment.save!
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      comment.destroy!
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "updates storage when card is deleted" do
+    card = @board.cards.create!(title: "Card to delete", creator: users(:david))
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      card.image.attach(blob)
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      card.destroy!
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "updates storage when card is moved between boards" do
+    board2 = @account.boards.create!(name: "Board 2", creator: users(:david))
+    card = @board.cards.create!(title: "Card to move", creator: users(:david))
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      card.image.attach(blob)
+    end
+
+    assert_equal blob.byte_size, @board.reload.bytes_used
+    assert_equal 0, board2.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      card.update!(board: board2)
+    end
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal blob.byte_size, board2.reload.bytes_used
+    assert_equal blob.byte_size, @account.reload.bytes_used
+  end
+
+  test "does not count avatars, exports, or imports" do
+    users(:david).avatar.attach(
+      io: File.open(file_fixture("avatar.png")),
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+    export = @account.exports.create!(user: users(:david))
+    export.file.attach(
+      io: StringIO.new("export content"),
+      filename: "export.zip",
+      content_type: "application/zip"
+    )
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "replacing card image updates storage" do
+    card = @board.cards.create!(title: "Card with replacing image", creator: users(:david))
+    blob1 = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    blob2 = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("avatar.png")),
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      card.image.attach(blob1)
+    end
+    assert_equal blob1.byte_size, @board.reload.bytes_used
+
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      card.image.attach(blob2)
+    end
+    assert_equal blob2.byte_size, @board.reload.bytes_used
+    assert_equal blob2.byte_size, @account.reload.bytes_used
+  end
+
+  test "multiple cards and comments on same board" do
+    card1 = @board.cards.create!(title: "Card 1", creator: users(:david), status: "published")
+    card2 = @board.cards.create!(title: "Card 2", creator: users(:david), status: "published")
+
+    blob1 = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    blob2 = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("embed 1"),
+      filename: "embed1.txt",
+      content_type: "text/plain"
+    )
+    blob3 = ActiveStorage::Blob.create_and_upload!(
+      io: StringIO.new("comment embed"),
+      filename: "comment_embed.txt",
+      content_type: "text/plain"
+    )
+
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      card1.image.attach(blob1)
+      card1.description = ActionText::Content.new("Desc").append_attachables(blob2)
+      card1.save!
+
+      comment = card2.comments.create!(body: "Comment")
+      comment.body = ActionText::Content.new("Comment").append_attachables(blob3)
+      comment.save!
+    end
+
+    total_expected = blob1.byte_size + blob2.byte_size + blob3.byte_size
+    assert_equal total_expected, @board.reload.bytes_used
+    assert_equal total_expected, @account.reload.bytes_used
+
+    # Deleting card1 removes its image and description embed, leaving card2's comment embed
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      card1.destroy!
+    end
+
+    assert_equal blob3.byte_size, @board.reload.bytes_used
+    assert_equal blob3.byte_size, @account.reload.bytes_used
+  end
+end
