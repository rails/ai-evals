index 0000000..9d45f83
--- /dev/null
+++ b/app/models/concerns/active_storage_attachment/storage.rb
@@ -0,0 +1,28 @@
+module ActiveStorageAttachment::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_commit :refresh_board_storage_later, on: %i[ create destroy ]
+  end
+
+  def board_for_storage
+    case record
+    when Card
+      record.board if name == "image"
+    when ActionText::RichText
+      case record.record
+      when Board
+        record.record
+      when Card
+        record.record.board
+      when Comment
+        record.record.card&.board
+      end
+    end
+  end
+
+  private
+    def refresh_board_storage_later
+      board_for_storage&.refresh_storage_later
+    end
+end
