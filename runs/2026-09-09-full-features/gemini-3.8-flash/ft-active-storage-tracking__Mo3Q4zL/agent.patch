diff --git a/test/models/account/storage_test.rb b/test/models/account/storage_test.rb
new file mode 100644
index 0000000..947e56d
--- /dev/null
+++ b/test/models/account/storage_test.rb
@@ -0,0 +1,135 @@
+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts(:"37s")
+  end
+
+  test "new account has 0 bytes_used" do
+    account = Account.create!(name: "Brand New Account")
+    assert_equal 0, account.bytes_used
+  end
+
+  test "account usage sums across all its boards" do
+    board1 = @account.boards.create!(name: "Board 1", creator: users(:david))
+    board2 = @account.boards.create!(name: "Board 2", creator: users(:david))
+
+    card1 = board1.cards.create!(title: "Card 1", creator: users(:david))
+    blob1 = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    card2 = board2.cards.create!(title: "Card 2", creator: users(:david))
+    blob2 = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("avatar.png")),
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+
+    perform_enqueued_jobs only: Board::CalculateStorageJob do
+      card1.image.attach(blob1)
+      card2.image.attach(blob2)
+    end
+
+    assert_equal blob1.byte_size, board1.reload.bytes_used
+    assert_equal blob2.byte_size, board2.reload.bytes_used
+    assert_equal blob1.byte_size + blob2.byte_size, @account.reload.bytes_used
+  end
+
+  test "destroying a board updates account bytes_used" do
+    board1 = @account.boards.create!(name: "Board 1", creator: users(:david))
+    board2 = @account.boards.create!(name: "Board 2", creator: users(:david))
+
+    card1 = board1.cards.create!(title: "Card 1", creator: users(:david))
+    blob1 = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    card2 = board2.cards.create!(title: "Card 2", creator: users(:david))
+    blob2 = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("avatar.png")),
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+
+    perform_enqueued_jobs only: [ Board::CalculateStorageJob, Account::CalculateStorageJob ] do
+      card1.image.attach(blob1)
+      card2.image.attach(blob2)
+    end
+
+    assert_equal blob1.byte_size + blob2.byte_size, @account.reload.bytes_used
+
+    perform_enqueued_jobs only: [ Board::CalculateStorageJob, Account::CalculateStorageJob ] do
+      board1.destroy!
+    end
+
+    assert_equal blob2.byte_size, @account.reload.bytes_used
+  end
+
+  test "moving a card between boards keeps account bytes_used unchanged" do
+    board1 = @account.boards.create!(name: "Board 1", creator: users(:david))
+    board2 = @account.boards.create!(name: "Board 2", creator: users(:david))
+
+    card = board1.cards.create!(title: "Card", creator: users(:david))
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+
+    perform_enqueued_jobs only: [ Board::CalculateStorageJob, Account::CalculateStorageJob ] do
+      card.image.attach(blob)
+    end
+
+    initial_bytes = @account.reload.bytes_used
+    assert_equal blob.byte_size, initial_bytes
+
+    perform_enqueued_jobs only: [ Board::CalculateStorageJob, Account::CalculateStorageJob ] do
+      card.update!(board: board2)
+    end
+
+    assert_equal 0, board1.reload.bytes_used
+    assert_equal blob.byte_size, board2.reload.bytes_used
+    assert_equal initial_bytes, @account.reload.bytes_used
+  end
+
+  test "account bytes_used ignores avatars and exports" do
+    users(:david).avatar.attach(
+      io: File.open(file_fixture("avatar.png")),
+      filename: "avatar.png",
+      content_type: "image/png"
+    )
+    export = @account.exports.create!(user: users(:david))
+    export.file.attach(
+      io: StringIO.new("fake export content"),
+      filename: "export.zip",
+      content_type: "application/zip"
+    )
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "refresh_storage_later enqueues Account::CalculateStorageJob" do
+    assert_enqueued_with(job: Account::CalculateStorageJob, args: [ @account ]) do
+      @account.refresh_storage_later
+    end
+  end
+
+  test "calculate_bytes_used returns sum of boards calculate_bytes_used" do
+    board = @account.boards.create!(name: "Board", creator: users(:david))
+    card = board.cards.create!(title: "Card", creator: users(:david))
+    blob = ActiveStorage::Blob.create_and_upload!(
+      io: File.open(file_fixture("moon.jpg")),
+      filename: "moon.jpg",
+      content_type: "image/jpeg"
+    )
+    card.image.attach(blob)
+
+    assert_equal blob.byte_size, @account.calculate_bytes_used
+  end
+end
