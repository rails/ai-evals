+module Account::Storage
+  extend ActiveSupport::Concern
+
+  def bytes_used
+    self[:bytes_used] || 0
+  end
+
+  def refresh_storage_later
+    Account::CalculateStorageJob.perform_later(self)
+  end
+
+  def refresh_storage_now
+    new_bytes = boards.sum(:bytes_used)
+    update_column(:bytes_used, new_bytes)
+    self[:bytes_used] = new_bytes
+    new_bytes
+  end
+
+  def calculate_bytes_used
+    boards.sum { |board| board.calculate_bytes_used }
+  end
+end
