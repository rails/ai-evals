+++ b/app/models/board/storage.rb
@@ -0,0 +1,44 @@
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit :refresh_account_storage_later
+  end
+
+  def bytes_used
+    self[:bytes_used] || 0
+  end
+
+  def refresh_storage_later
+    Board::CalculateStorageJob.perform_later(self)
+  end
+
+  def refresh_storage_now
+    new_bytes = calculate_bytes_used
+    update_column(:bytes_used, new_bytes)
+    self[:bytes_used] = new_bytes
+    account&.refresh_storage_now
+    new_bytes
+  end
+
+  def calculate_bytes_used
+    board_card_ids = cards.select(:id)
+
+    rich_text_ids = ActionText::RichText.where(account_id: account_id)
+      .where(record_type: "Board", record_id: id)
+      .or(ActionText::RichText.where(account_id: account_id, record_type: "Card", record_id: board_card_ids))
+      .or(ActionText::RichText.where(account_id: account_id, record_type: "Comment", record_id: Comment.where(card_id: board_card_ids).select(:id)))
+      .select(:id)
+
+    attachments = ActiveStorage::Attachment.where(account_id: account_id)
+      .where(record_type: "ActionText::RichText", name: "embeds", record_id: rich_text_ids)
+      .or(ActiveStorage::Attachment.where(account_id: account_id, record_type: "Card", name: "image", record_id: board_card_ids))
+
+    ActiveStorage::Blob.where(account_id: account_id, id: attachments.select(:blob_id)).sum(:byte_size)
+  end
+
+  private
+    def refresh_account_storage_later
+      account&.refresh_storage_later
+    end
+end
