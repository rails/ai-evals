diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..f78f38a
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,37 @@
+class NotificationMailer < ApplicationMailer
+  helper NotificationsHelper
+
+  def bundle(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @account = bundle.account || @user.account
+    @notifications = bundle.notifications.preloaded
+
+    Current.account ||= @account
+
+    mail(
+      to: recipient_email,
+      subject: email_subject
+    )
+  end
+
+  alias_method :digest, :bundle
+
+  private
+    def recipient_email
+      @user.identity&.email_address || @user.try(:email_address)
+    end
+
+    def email_subject
+      count = @notifications.size
+      if count == 1
+        "Notification digest: 1 new notification"
+      else
+        "Notification digest: #{count} new notifications"
+      end
+    end
+end
+
+Notification::BundleMailer = NotificationMailer
+DigestMailer = NotificationMailer
+NotificationDigestMailer = NotificationMailer
