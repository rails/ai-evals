+++ b/app/models/account/data_transfer/entropy_record_set.rb
@@ -2,4 +2,18 @@ class Account::DataTransfer::EntropyRecordSet < Account::DataTransfer::RecordSet
   def initialize(account)
     super(account: account, model: Entropy)
   end
+
+  private
+    # A new account is created with an entropy of its own, so the exported one updates
+    # it rather than adding a second.
+    def import_records(rows)
+      account_rows, container_rows = rows.partition { |row| row["container_type"] == Account.name }
+
+      account_rows.each { |row| import_account_entropy(row) }
+      super(container_rows)
+    end
+
+    def import_account_entropy(row)
+      account.entropy.update! row.slice("auto_postpone_period", "created_at", "updated_at")
+    end
 end
