+<% @page_title = "Import an account" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Account settings", account_settings_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel shadow center" style="--panel-size: 45ch;">
+  <p class="margin-none-block-start">Bring a Fizzy account export back in. Everything in it — boards, cards, comments, files and people — lands in a brand new account, and we'll email you when it's done.</p>
+
+  <%= form_with model: @import, url: account_imports_path, class: "flex flex-column gap" do |form| %>
+    <% if @import.errors.any? %>
+      <div class="margin-block-half txt-negative txt-small">
+        <p class="margin-block-none font-weight-bold">Your import couldn't be started:</p>
+        <ul class="margin-block-none">
+          <% @import.errors.full_messages.each do |message| %>
+            <li><%= message %></li>
+          <% end %>
+        </ul>
+      </div>
+    <% end %>
+
+    <label class="flex align-center gap input input--file">
+      <%= form.file_field :file, accept: "application/zip,.zip", required: true %>
+    </label>
+
+    <%= form.submit "Start import", class: "btn btn--reversed center" %>
+  <% end %>
+</section>
