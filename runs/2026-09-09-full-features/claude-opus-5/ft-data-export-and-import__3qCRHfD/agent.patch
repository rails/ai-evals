diff --git a/app/jobs/account/reindex_search_job.rb b/app/jobs/account/reindex_search_job.rb
new file mode 100644
index 0000000..97a612d
--- /dev/null
+++ b/app/jobs/account/reindex_search_job.rb
@@ -0,0 +1,23 @@
+# Rebuilds the search index for an account, for when its records landed in the
+# database without going through the usual callbacks — after an import, say.
+class Account::ReindexSearchJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  def perform(account)
+    Current.with_account(account) do
+      reindex account.cards.published.includes(:rich_text_description)
+      reindex Comment.where(account_id: account.id).joins(:card).merge(Card.published).includes(:rich_text_body, :card)
+    end
+  end
+
+  private
+    def reindex(records)
+      records.find_each do |record|
+        record.reindex
+      rescue StandardError => error
+        Rails.error.report(error, handled: true, context: { record_type: record.class.name, record_id: record.id })
+      end
+    end
+end
