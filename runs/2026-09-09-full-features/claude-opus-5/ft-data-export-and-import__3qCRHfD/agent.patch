 class Account::DataTransfer::AccountRecordSet < Account::DataTransfer::RecordSet
+  # Ids and external ids belong to the installation, not to the export, so the
+  # imported account keeps the ones it was given when it was created.
+  IMPORTABLE_ATTRIBUTES = %w[ name cards_count created_at ].freeze
+
   def initialize(account)
     super(account: account, model: Account)
   end
 
+  # The account is created before anything is imported into it, so all that's left
+  # here is restoring its own attributes and mapping its old id onto the new one.
+  def import(zip, ids)
+    with_zip(zip) do
+      read_attributes(paths.first).then do |exported|
+        ids.register exported["id"], account.id
+        account.update! exported.slice(*importable_attributes)
+      end
+    end
+  end
+
   private
