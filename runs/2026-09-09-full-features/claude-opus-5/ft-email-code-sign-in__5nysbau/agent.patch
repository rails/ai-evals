diff --git a/app/models/magic_link.rb b/app/models/magic_link.rb
new file mode 100644
index 0000000..6469467
--- /dev/null
+++ b/app/models/magic_link.rb
@@ -0,0 +1,74 @@
+# A magic link is a short code we email to someone so they can sign in without
+# a password or a passkey.
+#
+# Nothing is stored server side: the pending authentication travels with the
+# person as a signed token carrying a digest of the code we emailed them, and
+# both the token and the code stop working after EXPIRES_IN.
+class MagicLink
+  CODE_LENGTH = 6
+  CODE_CHARACTERS = %w[ A B C D E F G H J K L M N P Q R S T U V W X Y Z 2 3 4 5 6 7 8 9 ].freeze
+  EXPIRES_IN = 15.minutes
+  TOKEN_PURPOSE = "magic_link"
+
+  attr_reader :identity, :code
+
+  class << self
+    def deliver_to(identity)
+      new(identity: identity, code: generate_code).tap(&:deliver_later)
+    end
+
+    def find_by_token(token)
+      if (global_id = parse_token(token)) && (identity = locate(global_id))
+        new identity: identity, code_digest: global_id.params["code_digest"]
+      end
+    end
+
+    def generate_code
+      CODE_LENGTH.times.map { CODE_CHARACTERS.sample(random: SecureRandom) }.join
+    end
+
+    def digest(code)
+      OpenSSL::HMAC.hexdigest "SHA256", Rails.application.secret_key_base, normalize(code)
+    end
+
+    def normalize(code)
+      code.to_s.strip.upcase
+    end
+
+    private
+      def parse_token(token)
+        SignedGlobalID.parse(token, for: TOKEN_PURPOSE) if token.present?
+      end
+
+      def locate(global_id)
+        global_id.find only: Identity
+      rescue ActiveRecord::RecordNotFound
+        nil
+      end
+  end
+
+  def initialize(identity:, code: nil, code_digest: nil)
+    @identity = identity
+    @code = code
+    @code_digest = code_digest || self.class.digest(code)
+  end
+
+  def token
+    identity.to_sgid(for: TOKEN_PURPOSE, code_digest: code_digest, expires_in: EXPIRES_IN).to_s
+  end
+
+  def deliver_later
+    IdentityMailer.magic_link(identity: identity, code: code).deliver_later
+  end
+
+  def authenticate(code)
+    identity if matches?(code)
+  end
+
+  private
+    attr_reader :code_digest
+
+    def matches?(code)
+      code.present? && ActiveSupport::SecurityUtils.secure_compare(code_digest, self.class.digest(code))
+    end
+end
