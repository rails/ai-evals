diff --git a/app/controllers/concerns/magic_link_authentication.rb b/app/controllers/concerns/magic_link_authentication.rb
new file mode 100644
index 0000000..f735070
--- /dev/null
+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,42 @@
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def deliver_magic_link_to(identity)
+      remember_pending_authentication identity.email_address
+      set_pending_authentication_token MagicLink.deliver_to(identity).token
+    end
+
+    def remember_pending_authentication(email_address)
+      clear_pending_authentication
+      session[:pending_authentication_email_address] = email_address
+    end
+
+    def pending_authentication_email_address
+      session[:pending_authentication_email_address]
+    end
+
+    def pending_magic_link
+      MagicLink.find_by_token pending_authentication_token
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token]
+    end
+
+    def set_pending_authentication_token(token)
+      cookies[:pending_authentication_token] = { value: token, httponly: true, same_site: :lax }
+    end
+
+    def clear_pending_authentication
+      cookies.delete :pending_authentication_token
+      session.delete :pending_authentication_email_address
+    end
+
+    def magic_link_delivered
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path }
+        format.json { render json: { pending_authentication_token: pending_authentication_token }, status: :created }
+      end
+    end
+end
