@@ -0,0 +1,33 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half <%= "shake" if flash[:alert] %>">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap-half txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true,
+              autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false,
+              maxlength: MagicLink::CODE_LENGTH, placeholder: "Enter your code…" %>
+      </label>
+    </div>
+
+    <p>
+      We emailed a <%= MagicLink::CODE_LENGTH %>-character code to <strong><%= @email_address %></strong>.
+      It expires in <%= distance_of_time_in_words MagicLink::EXPIRES_IN %>.
+    </p>
+
+    <button type="submit" id="enter_code" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Let’s go</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <div class="margin-block-start">
+    <%= link_to "Use a different email address", new_session_path, class: "btn btn--plain txt-link center txt-small" %>
+  </div>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
