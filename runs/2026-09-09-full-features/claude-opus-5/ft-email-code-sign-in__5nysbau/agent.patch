@@ -0,0 +1,72 @@
+class Sessions::MagicLinksController < ApplicationController
+  include Joining, MagicLinkAuthentication
+
+  # Entering a code happens both untenanted, when signing in or signing up, and
+  # tenanted, when joining an account with a join code.
+  skip_before_action :require_account
+  require_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  before_action :ensure_pending_authentication, only: :new
+
+  def new
+    @email_address = pending_authentication_email_address
+  end
+
+  def create
+    if identity = pending_magic_link&.authenticate(params[:code])
+      start_session_for identity
+    else
+      invalid_code
+    end
+  end
+
+  private
+    def ensure_pending_authentication
+      redirect_to new_session_path unless pending_authentication_email_address
+    end
+
+    def start_session_for(identity)
+      clear_pending_authentication
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to after_magic_link_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def after_magic_link_url
+      if user = redeem_pending_join_code
+        after_joining_url(user)
+      else
+        after_authentication_url
+      end
+    end
+
+    def redeem_pending_join_code
+      if code = session.delete(:pending_join_code)
+        Account::JoinCode.find_by(code: code)&.redeem_for(Current.identity)
+      end
+    end
+
+    def invalid_code
+      message = "That code didn't work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: message }
+        format.json { render json: { message: message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_magic_link_path, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
