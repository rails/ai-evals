diff --git a/test/models/magic_link_test.rb b/test/models/magic_link_test.rb
new file mode 100644
index 0000000..9ed569e
--- /dev/null
+++ b/test/models/magic_link_test.rb
@@ -0,0 +1,79 @@
+require "test_helper"
+
+class MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "deliver_to emails a code to the identity" do
+    magic_link = nil
+
+    assert_emails 1 do
+      perform_enqueued_jobs do
+        magic_link = MagicLink.deliver_to(@identity)
+      end
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ @identity.email_address ], email.to
+    assert_includes email.subject, magic_link.code
+  end
+
+  test "codes are unguessable and easy to read out loud" do
+    codes = 20.times.map { MagicLink.generate_code }
+
+    assert_equal 20, codes.uniq.size
+    codes.each do |code|
+      assert_equal MagicLink::CODE_LENGTH, code.length
+      assert_match(/\A[A-HJ-NP-Z2-9]+\z/, code)
+    end
+  end
+
+  test "authenticating with the emailed code" do
+    magic_link = MagicLink.deliver_to(@identity)
+
+    assert_equal @identity, MagicLink.find_by_token(magic_link.token).authenticate(magic_link.code)
+  end
+
+  test "codes are case insensitive and tolerate surrounding whitespace" do
+    magic_link = MagicLink.deliver_to(@identity)
+
+    assert_equal @identity, MagicLink.find_by_token(magic_link.token).authenticate(" #{magic_link.code.downcase}\n")
+  end
+
+  test "authenticating with the wrong code" do
+    magic_link = MagicLink.deliver_to(@identity)
+
+    assert_nil MagicLink.find_by_token(magic_link.token).authenticate("NOPE12")
+    assert_nil MagicLink.find_by_token(magic_link.token).authenticate("")
+    assert_nil MagicLink.find_by_token(magic_link.token).authenticate(nil)
+  end
+
+  test "codes expire after fifteen minutes" do
+    magic_link = MagicLink.deliver_to(@identity)
+    token = magic_link.token
+
+    travel MagicLink::EXPIRES_IN - 1.minute
+    assert_equal @identity, MagicLink.find_by_token(token).authenticate(magic_link.code)
+
+    travel 2.minutes
+    assert_nil MagicLink.find_by_token(token)
+  end
+
+  test "tokens can't be forged" do
+    assert_nil MagicLink.find_by_token(nil)
+    assert_nil MagicLink.find_by_token("")
+    assert_nil MagicLink.find_by_token("nonsense")
+    assert_nil MagicLink.find_by_token(@identity.to_sgid(for: "something_else").to_s)
+  end
+
+  test "tokens for deleted identities are useless" do
+    magic_link = MagicLink.deliver_to(@identity)
+    token = magic_link.token
+    @identity.destroy!
+
+    assert_nil MagicLink.find_by_token(token)
+  end
+end
