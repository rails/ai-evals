+      code = request_magic_link_for @identity
+
+      post session_magic_link_path, params: { code: " #{code.downcase} " }
+
+      assert_redirected_to landing_path
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create with the wrong code" do
+    untenanted do
+      request_magic_link_for @identity
+
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: "NOPE12" }
+      end
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create without a pending authentication" do
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: "ABC123" }
+      end
+
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create with an expired code" do
+    untenanted do
+      code = request_magic_link_for @identity
+
+      travel MagicLink::EXPIRES_IN + 1.minute
+
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: code }
+      end
+
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create returns a session token via JSON" do
+    untenanted do
+      code = request_magic_link_for @identity
+
+      post session_magic_link_path(format: :json), params: { code: code }
+
+      assert_response :success
+      assert @response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "create with the wrong code via JSON" do
+    untenanted do
+      request_magic_link_for @identity
+
+      post session_magic_link_path(format: :json), params: { code: "NOPE12" }
+
+      assert_response :unauthorized
+    end
+  end
+
+  test "create is rate limited" do
+    untenanted do
+      request_magic_link_for @identity
+      Rails.cache.stubs(:increment).returns(11)
+
+      post session_magic_link_path, params: { code: "ABC123" }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
+
+  private
+    def request_magic_link_for(identity)
+      post session_path, params: { email_address: identity.email_address }
+      magic_link_code
+    end
+
+    def magic_link_code
+      perform_enqueued_jobs
+      ActionMailer::Base.deliveries.last.subject[/\b[A-Z2-9]{#{MagicLink::CODE_LENGTH}}\b/]
+    end
+end
