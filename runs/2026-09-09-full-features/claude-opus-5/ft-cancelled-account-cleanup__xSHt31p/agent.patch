diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..baa8de9
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,34 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled beyond the grace period" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account.id)
+    assert_empty User.where(account_id: account.id)
+  end
+
+  test "leaves accounts within the grace period alone" do
+    account = accounts(:"37s")
+    account.cancel(initiated_by: users(:david))
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day
+
+    Account::IncinerateDueJob.perform_now
+
+    assert Account.exists?(account.id)
+  end
+
+  test "leaves active accounts alone" do
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..b996d44
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "incineration_due only includes accounts cancelled beyond the grace period" do
+    @account.cancel(initiated_by: @user)
+
+    assert_not_includes Account.incineration_due, @account
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    assert_includes Account.incineration_due, @account
+  end
+
+  test "incineration_due excludes active accounts" do
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    assert_empty Account.incineration_due
+  end
+
+  test "incinerate removes the account and all its data" do
+    board = @account.boards.first
+    card = @account.cards.first
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_not Board.exists?(board.id)
+    assert_not Card.exists?(card.id)
+    assert_empty User.where(account_id: @account.id)
+    assert_empty Account::Cancellation.where(account_id: @account.id)
+  end
+
+  test "incinerate leaves no records behind for the account" do
+    @account.incinerate
+
+    assert_empty tables_with_records_for(@account)
+  end
+
+  test "incinerate_all_due incinerates accounts past the grace period only" do
+    @account.cancel(initiated_by: @user)
+    recently_cancelled = accounts(:initech)
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    recently_cancelled.cancel(initiated_by: users(:mike))
+
+    Account.incinerate_all_due
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(recently_cancelled.id)
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  private
+    def tables_with_records_for(account)
+      connection = ActiveRecord::Base.connection
+
+      connection.tables.select do |table|
+        connection.column_exists?(table, :account_id) &&
+          connection.select_value("SELECT COUNT(*) FROM #{connection.quote_table_name(table)} WHERE account_id = #{connection.quote(account.id)}").to_i > 0
+      end
+    end
+end
