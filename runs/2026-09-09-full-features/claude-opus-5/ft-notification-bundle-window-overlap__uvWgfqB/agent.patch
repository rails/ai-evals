+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @settings = users(:david).settings
+  end
+
+  test "email digests are bundled every few hours by default" do
+    assert_predicate @settings, :every_few_hours?
+    assert_equal 4.hours, @settings.bundle_email_window
+  end
+
+  test "bundle email window per frequency" do
+    assert_nil frequency(:never).bundle_email_window
+    assert_equal 4.hours, frequency(:every_few_hours).bundle_email_window
+    assert_equal 1.day, frequency(:daily).bundle_email_window
+    assert_equal 1.week, frequency(:weekly).bundle_email_window
+  end
+
+  test "unknown frequencies are invalid" do
+    @settings.bundle_email_frequency = "hourly"
+
+    assert_not @settings.valid?
+  end
+
+  private
+    def frequency(frequency)
+      @settings.tap { it.bundle_email_frequency = frequency }
+    end
+end
