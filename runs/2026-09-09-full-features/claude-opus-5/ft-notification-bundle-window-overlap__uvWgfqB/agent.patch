+
+class NotificationMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @bundle = @user.notification_bundles.create!(starts_at: 1.week.ago, ends_at: Time.current)
+    @bundle.notifications = @user.notifications
+  end
+
+  test "bundle" do
+    email = NotificationMailer.bundle(@bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_equal "3 new notifications in 37signals", email.subject
+
+    @bundle.notifications.each do |notification|
+      assert_match notification.card.board.name, email.body.encoded
+      assert_match notification.payload.title, email.body.encoded
+    end
+  end
+end
