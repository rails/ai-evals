@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Notification::BundleableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.notifications.destroy_all
+  end
+
+  test "a new notification is bundled for email" do
+    notification = create_notification
+
+    assert_equal notification.bundle, @user.notification_bundles.sole
+  end
+
+  test "an updated notification is bundled into the window running when it was updated" do
+    notification = create_notification
+    notification.bundle.update!(delivered_at: Time.current)
+
+    travel_to 5.hours.from_now do
+      notification.update!(source: events(:layout_published), creator: users(:david))
+    end
+
+    assert_not notification.reload.bundle.delivered?
+    assert_equal 2, @user.notification_bundles.count
+  end
+
+  test "notifications from the system user are not bundled" do
+    assert_nil create_notification(creator: users(:system)).bundle
+  end
+
+  test "notifications for deactivated people are not bundled" do
+    @user.deactivate
+
+    assert_nil create_notification.bundle
+  end
+
+  private
+    def create_notification(creator: users(:david))
+      @user.notifications.create!(source: events(:layout_commented), creator: creator)
+    end
+end
