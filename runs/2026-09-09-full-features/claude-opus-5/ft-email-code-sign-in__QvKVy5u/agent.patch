+      assert_not cookies[:pending_authentication_token].present?
+    end
+  end
+
+  test "create accepts a lowercase code with whitespace around it" do
+    identity = identities(:kevin)
+
+    untenanted do
+      code = request_sign_in_code_for identity.email_address
+
+      post session_magic_link_path, params: { code: " #{code.downcase} " }
+
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "create signs up someone we've never seen before" do
+    untenanted do
+      code = request_sign_in_code_for "stranger@example.com"
+
+      assert_difference -> { Identity.count }, 1 do
+        post session_magic_link_path, params: { code: code }
+      end
+
+      assert cookies[:session_token].present?
+      assert_equal "stranger@example.com", Session.last.identity.email_address
+    end
+  end
+
+  test "create with the wrong code" do
+    untenanted do
+      request_sign_in_code_for identities(:kevin).email_address
+
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: "WR0NG2" }
+      end
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "That code didn’t work. Try again.", flash[:alert]
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create with a code that's more than fifteen minutes old" do
+    untenanted do
+      code = request_sign_in_code_for identities(:kevin).email_address
+
+      travel 16.minutes do
+        assert_no_difference -> { Session.count } do
+          post session_magic_link_path, params: { code: code }
+        end
+      end
+
+      assert_redirected_to new_session_path
+      assert_not cookies[:session_token].present?
+    end
+  end
+
+  test "create without a code on the way" do
+    untenanted do
+      assert_no_difference -> { Session.count } do
+        post session_magic_link_path, params: { code: "ABC234" }
+      end
+
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "create via JSON returns a session token" do
+    identity = identities(:kevin)
+
+    untenanted do
+      code = request_sign_in_code_for identity.email_address
+
+      post session_magic_link_path(format: :json), params: { code: code }
+
+      assert_response :success
+      assert_equal cookies[:session_token], response.parsed_body["session_token"]
+      assert_equal identity, Session.last.identity
+    end
+  end
+
+  test "create with the wrong code via JSON" do
+    untenanted do
+      request_sign_in_code_for identities(:kevin).email_address
+
+      post session_magic_link_path(format: :json), params: { code: "WR0NG2" }
+
+      assert_response :unauthorized
+    end
+  end
+
+  test "create is rate limited" do
+    untenanted do
+      request_sign_in_code_for identities(:kevin).email_address
+      Rails.cache.stubs(:increment).returns(11)
+
+      post session_magic_link_path, params: { code: "WR0NG2" }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
+
+  private
+    def request_sign_in_code_for(email_address)
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        post session_path, params: { email_address: email_address }
+      end
+
+      ActionMailer::Base.deliveries.last.subject.split.first
+    end
+end
