+class Sessions::MagicLinksController < ApplicationController
+  include SignInCodes
+
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: :rate_limit_exceeded
+
+  layout "public"
+
+  before_action :set_pending_authentication
+
+  def new
+  end
+
+  def create
+    if @pending_authentication.authenticates?(params[:code])
+      clear_pending_authentication
+      terminate_session if Current.session
+      start_new_session_for @pending_authentication.identity
+
+      signed_in
+    else
+      code_didnt_work
+    end
+  end
+
+  private
+    def set_pending_authentication
+      unless @pending_authentication = pending_authentication
+        code_expired
+      end
+    end
+
+    def code_expired
+      code_expired_message = "That code has expired. Enter your email address to get a new one."
+
+      respond_to do |format|
+        format.html { redirect_to new_session_url(script_name: nil), alert: code_expired_message }
+        format.json { render json: { message: code_expired_message }, status: :unauthorized }
+      end
+    end
+
+    def signed_in
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def code_didnt_work
+      code_didnt_work_message = "That code didn’t work. Try again."
+
+      respond_to do |format|
+        format.html { redirect_to sign_in_code_url, alert: code_didnt_work_message }
+        format.json { render json: { message: code_didnt_work_message }, status: :unauthorized }
+      end
+    end
+
+    def rate_limit_exceeded
+      rate_limit_exceeded_message = "Try again later."
+
+      respond_to do |format|
+        format.html { redirect_to sign_in_code_url, alert: rate_limit_exceeded_message }
+        format.json { render json: { message: rate_limit_exceeded_message }, status: :too_many_requests }
+      end
+    end
+end
