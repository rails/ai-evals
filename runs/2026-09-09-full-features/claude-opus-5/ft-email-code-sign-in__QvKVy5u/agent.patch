new file mode 100644
index 0000000..c7371c4
--- /dev/null
+++ b/app/controllers/concerns/sign_in_codes.rb
@@ -0,0 +1,40 @@
+# Gets people into Fizzy by emailing them a short-lived sign-in code, and
+# remembers who is waiting for one while they go and read their email.
+module SignInCodes
+  extend ActiveSupport::Concern
+
+  private
+    def deliver_sign_in_code(email_address, return_to: nil)
+      PendingAuthentication.new(email_address: email_address).tap do |pending_authentication|
+        pending_authentication.deliver_code_later
+        set_pending_authentication pending_authentication, return_to: return_to
+      end
+    end
+
+    def set_pending_authentication(pending_authentication, return_to: nil)
+      cookies[:pending_authentication_token] = {
+        value: pending_authentication.token, httponly: true, same_site: :lax
+      }
+
+      session[:return_to_after_authenticating] = return_to if return_to
+    end
+
+    def pending_authentication
+      PendingAuthentication.find_by_token cookies[:pending_authentication_token]
+    end
+
+    def clear_pending_authentication
+      cookies.delete :pending_authentication_token
+    end
+
+    def sign_in_code_sent(pending_authentication)
+      respond_to do |format|
+        format.html { redirect_to sign_in_code_url }
+        format.json { render json: { pending_authentication_token: pending_authentication.token }, status: :created }
+      end
+    end
+
+    def sign_in_code_url
+      new_session_magic_link_url script_name: nil
+    end
+end
