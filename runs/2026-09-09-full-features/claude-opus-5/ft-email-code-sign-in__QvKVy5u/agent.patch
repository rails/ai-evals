diff --git a/test/models/pending_authentication_test.rb b/test/models/pending_authentication_test.rb
new file mode 100644
index 0000000..661fbf0
--- /dev/null
+++ b/test/models/pending_authentication_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class PendingAuthenticationTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  test "generates a six character code" do
+    pending_authentication = PendingAuthentication.new(email_address: "someone@example.com")
+
+    assert_match(/\A[A-Z2-9]{6}\z/, pending_authentication.code)
+  end
+
+  test "normalizes the email address" do
+    pending_authentication = PendingAuthentication.new(email_address: " SomeOne@Example.com ")
+
+    assert_equal "someone@example.com", pending_authentication.email_address
+  end
+
+  test "requires a valid email address" do
+    assert PendingAuthentication.new(email_address: "someone@example.com").valid?
+    assert_not PendingAuthentication.new(email_address: "not-an-email").valid?
+    assert_not PendingAuthentication.new(email_address: "").valid?
+  end
+
+  test "round trips through a signed token" do
+    pending_authentication = PendingAuthentication.new(email_address: "someone@example.com")
+
+    restored = PendingAuthentication.find_by_token(pending_authentication.token)
+
+    assert_equal pending_authentication.email_address, restored.email_address
+    assert_equal pending_authentication.code, restored.code
+  end
+
+  test "token expires after fifteen minutes" do
+    token = PendingAuthentication.new(email_address: "someone@example.com").token
+
+    travel 14.minutes do
+      assert_not_nil PendingAuthentication.find_by_token(token)
+    end
+
+    travel 16.minutes do
+      assert_nil PendingAuthentication.find_by_token(token)
+    end
+  end
+
+  test "tampered and missing tokens are ignored" do
+    assert_nil PendingAuthentication.find_by_token(nil)
+    assert_nil PendingAuthentication.find_by_token("")
+    assert_nil PendingAuthentication.find_by_token("nope")
+  end
+
+  test "authenticates the code it was created with" do
+    pending_authentication = PendingAuthentication.new(email_address: "someone@example.com")
+
+    assert pending_authentication.authenticates?(pending_authentication.code)
+    assert pending_authentication.authenticates?(" #{pending_authentication.code.downcase} ")
+    assert_not pending_authentication.authenticates?("ABC123")
+    assert_not pending_authentication.authenticates?(nil)
+    assert_not pending_authentication.authenticates?("")
+  end
+
+  test "knows whether an identity exists for the email address" do
+    assert PendingAuthentication.new(email_address: identities(:kevin).email_address).known?
+    assert_not PendingAuthentication.new(email_address: "stranger@example.com").known?
+  end
+
+  test "identity finds the existing identity" do
+    identity = identities(:kevin)
+
+    assert_no_difference -> { Identity.count } do
+      assert_equal identity, PendingAuthentication.new(email_address: identity.email_address).identity
+    end
+  end
+
+  test "identity creates a new identity when nobody has the email address" do
+    assert_difference -> { Identity.count }, 1 do
+      identity = PendingAuthentication.new(email_address: "stranger@example.com").identity
+      assert_equal "stranger@example.com", identity.email_address
+    end
+  end
+
+  test "delivers the code by email" do
+    pending_authentication = PendingAuthentication.new(email_address: "someone@example.com")
+
+    assert_emails 1 do
+      pending_authentication.deliver_code_later
+    end
+
+    email = ActionMailer::Base.deliveries.last
+    assert_equal [ "someone@example.com" ], email.to
+    assert_includes email.subject, pending_authentication.code
+  end
+end
