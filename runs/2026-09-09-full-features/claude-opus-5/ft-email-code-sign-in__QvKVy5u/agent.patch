diff --git a/app/models/pending_authentication.rb b/app/models/pending_authentication.rb
new file mode 100644
index 0000000..9f302a5
--- /dev/null
+++ b/app/models/pending_authentication.rb
@@ -0,0 +1,62 @@
+# Someone who has asked to get into Fizzy with their email address, but hasn't
+# proved that the address is theirs yet.
+#
+# We email them a short code, and keep nothing on the server while we wait for
+# them to type it back to us: the email address and the code travel in a signed
+# token that lives in their browser and expires along with the code.
+class PendingAuthentication
+  include ActiveModel::Model
+
+  CODE_LENGTH = 6
+  CODE_CHARACTERS = ("A".."Z").to_a - %w[ I O ] + ("2".."9").to_a
+  EXPIRES_IN = 15.minutes
+
+  attr_reader :email_address, :code
+
+  validates :email_address, format: { with: URI::MailTo::EMAIL_REGEXP }
+
+  class << self
+    def find_by_token(token)
+      if payload = verifier.verified(token.to_s)
+        new email_address: payload["email_address"], code: payload["code"]
+      end
+    end
+
+    def verifier
+      Rails.application.message_verifier(:pending_authentication)
+    end
+  end
+
+  def initialize(email_address:, code: nil)
+    @email_address = Identity.normalize_value_for(:email_address, email_address)
+    @code = code || SecureRandom.alphanumeric(CODE_LENGTH, chars: CODE_CHARACTERS)
+  end
+
+  def token
+    @token ||= self.class.verifier.generate(
+      { "email_address" => email_address, "code" => code }, expires_in: EXPIRES_IN
+    )
+  end
+
+  def deliver_code_later
+    IdentityMailer.sign_in_code(email_address: email_address, code: code).deliver_later
+  end
+
+  def authenticates?(entered_code)
+    entered_code.present? &&
+      ActiveSupport::SecurityUtils.secure_compare(code, normalize_code(entered_code))
+  end
+
+  def known?
+    Identity.exists? email_address: email_address
+  end
+
+  def identity
+    Identity.find_or_create_by! email_address: email_address
+  end
+
+  private
+    def normalize_code(entered_code)
+      entered_code.to_s.strip.upcase.delete("^A-Z0-9")
+    end
+end
