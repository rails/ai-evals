@@ -0,0 +1,72 @@
+require "test_helper"
+
+class Account::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription! \
+      plan_key: Plan::UNLIMITED.key,
+      stripe_customer_id: "cus_1",
+      stripe_subscription_id: "sub_1",
+      status: "active",
+      current_period_end: 20.days.from_now
+  end
+
+  test "the plan comes from the plan key" do
+    assert_equal Plan::UNLIMITED, @subscription.plan
+
+    @subscription.plan = Plan::UNLIMITED_PLUS
+    assert_equal Plan::UNLIMITED_PLUS.key, @subscription.plan_key
+  end
+
+  test "an unknown plan key falls back to free" do
+    @subscription.update! plan_key: "monthly_v0"
+    assert_equal Plan::FREE, @subscription.plan
+  end
+
+  test "trialing and past due still count as active" do
+    assert @subscription.active?
+
+    @subscription.update! status: "trialing"
+    assert @subscription.active?
+
+    @subscription.update! status: "past_due"
+    assert @subscription.active?
+
+    @subscription.update! status: "canceled"
+    assert_not @subscription.active?
+  end
+
+  test "cancelling at the end of the period" do
+    Stripe::Subscription.expects(:update).with("sub_1", cancel_at_period_end: true).once
+
+    @subscription.cancel_later
+
+    assert @subscription.cancelling?
+    assert @subscription.active?, "access lasts until the period ends"
+  end
+
+  test "resuming a cancelled subscription" do
+    Stripe::Subscription.stubs(:update)
+
+    @subscription.cancel_later
+    @subscription.resume
+
+    assert_not @subscription.cancelling?
+  end
+
+  test "cancelling right away" do
+    Stripe::Subscription.expects(:cancel).with("sub_1").once
+
+    @subscription.cancel_now
+
+    assert_not @subscription.active?
+    assert_equal Plan::FREE, @account.reload.plan
+  end
+
+  test "what's due next" do
+    assert_nil @subscription.next_amount_due_in_dollars
+
+    @subscription.update! next_amount_due_in_cents: 2_000
+    assert_equal 20, @subscription.next_amount_due_in_dollars
+  end
+end
diff --git a/saas/test/models/billing/event_test.rb b/saas/test/models/billing/event_test.rb
new file mode 100644
index 0000000..04a4c7d
--- /dev/null
+++ b/saas/test/models/billing/event_test.rb
@@ -0,0 +1,92 @@
+require "test_helper"
+
+class Billing::EventTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_1")
+    @account.reload_subscription
+  end
+
+  test "a completed checkout starts the subscription" do
+    process \
+      type: "checkout.session.completed",
+      data: { object: {
+        customer: "cus_1",
+        subscription: "sub_1",
+        client_reference_id: @account.id,
+        metadata: { account_id: @account.id, plan_key: Plan::UNLIMITED.key }
+      } }
+
+    assert_equal "sub_1", @subscription.reload.stripe_subscription_id
+    assert_equal Plan::UNLIMITED, @subscription.plan
+    assert @subscription.active?
+    assert_equal Plan::UNLIMITED, @account.reload.plan
+  end
+
+  test "a subscription update tracks the plan, status and period" do
+    period_end = 1.month.from_now.to_i
+
+    with_stripe_prices do
+      process \
+        type: "customer.subscription.updated",
+        data: { object: {
+          id: "sub_1",
+          customer: "cus_1",
+          status: "active",
+          items: { data: [ { price: { id: "price_unlimited_plus" }, current_period_end: period_end } ] }
+        } }
+    end
+
+    @subscription.reload
+    assert_equal Plan::UNLIMITED_PLUS, @subscription.plan
+    assert_equal "active", @subscription.status
+    assert_equal period_end, @subscription.current_period_end.to_i
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+  end
+
+  test "a deleted subscription ends the plan" do
+    @subscription.update! stripe_subscription_id: "sub_1", plan_key: Plan::UNLIMITED.key, status: "active"
+
+    process \
+      type: "customer.subscription.deleted",
+      data: { object: { id: "sub_1", customer: "cus_1", status: "canceled" } }
+
+    assert_not @subscription.reload.active?
+    assert_equal Plan::FREE, @account.reload.plan
+  end
+
+  test "an upcoming invoice records what's next" do
+    process type: "invoice.upcoming", data: { object: { customer: "cus_1", amount_due: 2_500 } }
+
+    assert_equal 2_500, @subscription.reload.next_amount_due_in_cents
+    assert_equal 25, @subscription.next_amount_due_in_dollars
+  end
+
+  test "events for customers we don't know are ignored" do
+    assert_nothing_raised do
+      process type: "customer.subscription.updated", data: { object: { id: "sub_9", customer: "cus_9", status: "active" } }
+    end
+
+    assert_nil @subscription.reload.status
+  end
+
+  test "events we don't care about are ignored" do
+    assert_nothing_raised do
+      process type: "customer.created", data: { object: { id: "cus_1" } }
+    end
+  end
+
+  private
+    def process(event)
+      Billing::Event.new(event).process
+    end
+
+    def with_stripe_prices
+      ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+      ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_unlimited_plus"
+      yield
+    ensure
+      ENV.delete("STRIPE_MONTHLY_V1_PRICE_ID")
+      ENV.delete("STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+    end
+end
diff --git a/saas/test/models/plan_test.rb b/saas/test/models/plan_test.rb
new file mode 100644
index 0000000..96da69b
--- /dev/null
+++ b/saas/test/models/plan_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class PlanTest < ActiveSupport::TestCase
+  test "the approved prices and allowances" do
+    assert_equal 0, Plan::FREE.price
+    assert_equal 1_000, Plan::FREE.card_limit
+    assert_equal 1.gigabyte, Plan::FREE.storage_limit
+
+    assert_equal 20, Plan::UNLIMITED.price
+    assert_nil Plan::UNLIMITED.card_limit
+    assert_equal 5.gigabytes, Plan::UNLIMITED.storage_limit
+
+    assert_equal 25, Plan::UNLIMITED_PLUS.price
+    assert_nil Plan::UNLIMITED_PLUS.card_limit
+    assert_equal 500.gigabytes, Plan::UNLIMITED_PLUS.storage_limit
+  end
+
+  test "paid plans exclude the free one" do
+    assert_equal [ Plan::UNLIMITED, Plan::UNLIMITED_PLUS ], Plan.paid
+  end
+
+  test "find by key" do
+    assert_equal Plan::UNLIMITED, Plan.find("monthly_v1")
+    assert_nil Plan.find("nope")
+    assert_nil Plan.find(nil)
+    assert_raises(ArgumentError) { Plan.find!("nope") }
+  end
+
+  test "find by stripe price id" do
+    with_env "STRIPE_MONTHLY_V1_PRICE_ID" => "price_unlimited" do
+      assert_equal Plan::UNLIMITED, Plan.find_by_stripe_price_id("price_unlimited")
+      assert_nil Plan.find_by_stripe_price_id("price_unknown")
+      assert_nil Plan.find_by_stripe_price_id(nil)
+    end
+  end
+
+  private
+    def with_env(values)
+      original = values.transform_values { |_| nil }.merge(ENV.slice(*values.keys))
+      ENV.update(values)
+      yield
+    ensure
+      original.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
+    end
+end
