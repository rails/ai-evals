+<% if Current.user.admin? %>
+  <section class="settings__section settings__section--plan">
+    <header>
+      <h2 class="divider">Plan</h2>
+      <div>
+        This account is on the <strong><%= Current.account.plan.name %></strong> plan<%= " (comped)" if Current.account.comped? %>.
+        <% if Current.account.plan.paid? %>
+          <%= number_to_currency(Current.account.plan.price) %>/month.
+        <% end %>
+      </div>
+    </header>
+
+    <ul class="list-unindented margin-block-half txt-small">
+      <li>
+        <% if Current.account.unlimited_cards? %>
+          Unlimited cards
+        <% else %>
+          <%= number_with_delimiter(Current.account.cards_used) %> of <%= number_with_delimiter(Current.account.card_limit) %> cards used
+        <% end %>
+      </li>
+      <li><%= number_to_human_size(Current.account.bytes_used) %> of <%= number_to_human_size(Current.account.storage_limit) %> storage used</li>
+      <% if subscription = Current.account.active_subscription %>
+        <% if subscription.cancelling? %>
+          <li>Your subscription ends <%= subscription.cancel_at.to_fs(:long) %>.</li>
+        <% elsif subscription.current_period_end %>
+          <li>Renews <%= subscription.current_period_end.to_fs(:long) %>.</li>
+        <% end %>
+      <% end %>
+    </ul>
+
+    <div class="flex gap-half">
+      <% if Current.account.plan != Plan::UNLIMITED_PLUS %>
+        <%= link_to "Upgrade", saas.billing_upgrade_path, class: "btn" %>
+      <% end %>
+
+      <% if Current.account.active_subscription %>
+        <%= button_to "Manage billing", saas.billing_portal_path, class: "btn" %>
+      <% end %>
+    </div>
+  </section>
+<% end %>
