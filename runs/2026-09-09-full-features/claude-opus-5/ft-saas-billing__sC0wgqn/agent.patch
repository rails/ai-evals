@@ -0,0 +1,18 @@
+# Stripe posts subscription changes here. We only trust signed payloads.
+class Stripe::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_forgery_protection
+
+  def create
+    Billing::Event.new(verified_event).process
+    head :ok
+  rescue Billing::Webhook::VerificationError
+    head :bad_request
+  end
+
+  private
+    def verified_event
+      Billing::Webhook.verify payload: request.raw_post, signature: request.headers["Stripe-Signature"]
+    end
+end
