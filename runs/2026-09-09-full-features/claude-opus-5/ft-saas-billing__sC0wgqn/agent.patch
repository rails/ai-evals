+      assert_select "strong", text: "Free"
+      assert_select "a", text: "Upgrade"
+      assert_select "li", text: /5 of 1,000 cards used/
+    end
+  end
+
+  test "paid accounts can manage their billing" do
+    @account.create_subscription! stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1",
+      status: "active", plan_key: Plan::UNLIMITED.key, current_period_end: 20.days.from_now
+
+    sign_in_as :kevin
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select ".settings__section--plan" do
+      assert_select "strong", text: "Unlimited"
+      assert_select "li", text: /Unlimited cards/
