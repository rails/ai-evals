diff --git a/saas/app/models/billing/webhook.rb b/saas/app/models/billing/webhook.rb
new file mode 100644
index 0000000..18de644
--- /dev/null
+++ b/saas/app/models/billing/webhook.rb
@@ -0,0 +1,12 @@
+# Stripe signs everything it posts to us. Anything we can't verify is noise.
+class Billing::Webhook
+  class VerificationError < StandardError; end
+
+  class << self
+    def verify(payload:, signature:)
+      Stripe::Webhook.construct_event(payload, signature, Billing.webhook_secret)
+    rescue Stripe::SignatureVerificationError, JSON::ParserError => error
+      raise VerificationError, error.message
+    end
+  end
+end
diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..559028c
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,109 @@
+# The plans we sell. Stripe knows the prices by their price ids, we know them by
+# their keys, and Queenbee knows them by their short names.
+class Plan
+  attr_reader :key, :name, :short_name, :price_in_cents, :card_limit, :storage_limit, :stripe_price_id_variable
+
+  class << self
+    def all
+      ALL
+    end
+
+    def paid
+      PAID
+    end
+
+    def free
+      FREE
+    end
+
+    def find(key)
+      all.find { |plan| plan.key == key.to_s } if key.present?
+    end
+
+    def find!(key)
+      find(key) || raise(ArgumentError, "Unknown plan: #{key.inspect}")
+    end
+
+    def find_by_stripe_price_id(price_id)
+      paid.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == price_id } if price_id.present?
+    end
+  end
+
+  def initialize(key:, name:, short_name:, price_in_cents:, storage_limit:, card_limit: nil, stripe_price_id_variable: nil)
+    @key = key
+    @name = name
+    @short_name = short_name
+    @price_in_cents = price_in_cents
+    @card_limit = card_limit
+    @storage_limit = storage_limit
+    @stripe_price_id_variable = stripe_price_id_variable
+  end
+
+  FREE = new \
+    key: "free",
+    name: "Free",
+    short_name: "FreeV1",
+    price_in_cents: 0,
+    card_limit: 1_000,
+    storage_limit: 1.gigabyte
+
+  UNLIMITED = new \
+    key: "monthly_v1",
+    name: "Unlimited",
+    short_name: "MonthlyV1",
+    price_in_cents: 2_000,
+    storage_limit: 5.gigabytes,
+    stripe_price_id_variable: "STRIPE_MONTHLY_V1_PRICE_ID"
+
+  UNLIMITED_PLUS = new \
+    key: "monthly_extra_storage_v1",
+    name: "Unlimited+",
+    short_name: "MonthlyExtraStorageV1",
+    price_in_cents: 2_500,
+    storage_limit: 500.gigabytes,
+    stripe_price_id_variable: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+
+  ALL = [ FREE, UNLIMITED, UNLIMITED_PLUS ].freeze
+  PAID = (ALL - [ FREE ]).freeze
+
+  # What support hands out when they comp an account: everything, on the house.
+  COMPED = UNLIMITED_PLUS
+
+  def free?
+    price_in_cents.zero?
+  end
+
+  def paid?
+    !free?
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def price
+    price_in_cents / 100
+  end
+
+  def stripe_price_id
+    ENV[stripe_price_id_variable] if stripe_price_id_variable
+  end
+
+  def ==(other)
+    other.is_a?(Plan) && other.key == key
+  end
+  alias eql? ==
+
+  def hash
+    key.hash
+  end
+
+  def to_param
+    key
+  end
+
+  # Queenbee identifies subscriptions by their short name.
+  def to_s
+    short_name
+  end
+end
