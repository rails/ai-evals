diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..397620f
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    @subscription = @account.create_subscription!(stripe_customer_id: "cus_1")
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+  end
+
+  teardown do
+    ENV.delete("STRIPE_WEBHOOK_SECRET")
+  end
+
+  test "a signed subscription change is applied" do
+    post_webhook \
+      type: "checkout.session.completed",
+      data: { object: {
+        customer: "cus_1",
+        subscription: "sub_1",
+        client_reference_id: @account.id,
+        metadata: { plan_key: Plan::UNLIMITED.key }
+      } }
+
+    assert_response :ok
+    assert_equal Plan::UNLIMITED, @subscription.reload.plan
+    assert @subscription.active?
+  end
+
+  test "an unsigned payload is refused" do
+    untenanted do
+      post "/stripe/webhooks", params: { type: "checkout.session.completed" }.to_json,
+        headers: { "Stripe-Signature" => "t=1,v1=nonsense", "CONTENT_TYPE" => "application/json" }
+    end
+
+    assert_response :bad_request
+    assert_nil @subscription.reload.stripe_subscription_id
+  end
+
+  test "no authentication required" do
+    post_webhook type: "customer.created", data: { object: { id: "cus_1" } }
+
+    assert_response :ok
+  end
+
+  private
+    def post_webhook(event)
+      payload = event.to_json
+
+      untenanted do
+        post "/stripe/webhooks", params: payload,
+          headers: { "Stripe-Signature" => signature_header(payload), "CONTENT_TYPE" => "application/json" }
+      end
+    end
+
+    def signature_header(payload)
+      timestamp = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, ENV["STRIPE_WEBHOOK_SECRET"])
+      Stripe::Webhook::Signature.generate_header(timestamp, signature)
+    end
+end
diff --git a/saas/test/models/account/billable_test.rb b/saas/test/models/account/billable_test.rb
new file mode 100644
index 0000000..321b275
--- /dev/null
+++ b/saas/test/models/account/billable_test.rb
@@ -0,0 +1,88 @@
+require "test_helper"
+
+class Account::BillableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "accounts start out free" do
+    assert_equal Plan::FREE, @account.plan
+    assert_not @account.paid?
+    assert_nil @account.active_subscription
+  end
+
+  test "an active subscription brings its own plan and storage allowance" do
+    subscribe_to Plan::UNLIMITED
+
+    assert_equal Plan::UNLIMITED, @account.plan
+    assert @account.paid?
+    assert_equal 5.gigabytes, @account.storage_limit
+    assert @account.unlimited_cards?
+  end
+
+  test "an inactive subscription doesn't" do
+    subscribe_to Plan::UNLIMITED, status: "canceled"
+
+    assert_equal Plan::FREE, @account.plan
+    assert_not @account.paid?
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "storage exceptions still win" do
+    @account.add_storage_exception 10.gigabytes
+    assert_equal 10.gigabytes, @account.storage_limit
+  end
+
+  test "comping an account" do
+    assert_not @account.comped?
+
+    @account.comp
+
+    assert @account.comped?
+    assert_equal Plan::COMPED, @account.plan
+    assert @account.unlimited_cards?
+
+    @account.comp
+    assert_equal 1, Account::BillingWaiver.where(account_id: @account.id).count
+  end
+
+  test "uncomping an account" do
+    @account.comp
+    @account.uncomp
+
+    assert_not @account.comped?
+    assert_equal Plan::FREE, @account.plan
+  end
+
+  test "cancelling an account cancels its subscription at the end of the period" do
+    subscription = subscribe_to Plan::UNLIMITED
+    period_end = subscription.current_period_end
+
+    Stripe::Subscription.expects(:update).with("sub_1", cancel_at_period_end: true).once
+
+    @account.cancel(initiated_by: users(:mike))
+
+    assert_equal period_end.to_i, subscription.reload.cancel_at.to_i
+  end
+
+  test "incinerating an account cancels its subscription right away" do
+    subscription = subscribe_to Plan::UNLIMITED
+
+    Stripe::Subscription.expects(:cancel).with("sub_1").once
+
+    @account.incinerate
+
+    assert_not Account::Subscription.exists?(subscription.id)
+  end
+
+  private
+    def subscribe_to(plan, status: "active")
+      @account.create_subscription!(
+        plan_key: plan.key,
+        stripe_customer_id: "cus_1",
+        stripe_subscription_id: "sub_1",
+        status: status,
+        current_period_end: 20.days.from_now
+      ).tap { @account.reload_subscription }
+    end
+end
