diff --git a/saas/app/models/billing/checkout.rb b/saas/app/models/billing/checkout.rb
new file mode 100644
index 0000000..b0f381f
--- /dev/null
+++ b/saas/app/models/billing/checkout.rb
@@ -0,0 +1,37 @@
+# A hosted Stripe checkout for one of our paid plans.
+class Billing::Checkout
+  attr_reader :account, :plan, :success_url, :cancel_url
+
+  def initialize(account:, plan:, success_url:, cancel_url:)
+    @account = account
+    @plan = plan
+    @success_url = success_url
+    @cancel_url = cancel_url
+  end
+
+  def url
+    session.url
+  end
+
+  private
+    def session
+      Stripe::Checkout::Session.create(session_attributes)
+    end
+
+    def session_attributes
+      {
+        mode: "subscription",
+        customer: Billing::Customer.new(account).id,
+        client_reference_id: account.id,
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        success_url: success_url,
+        cancel_url: cancel_url,
+        metadata: metadata,
+        subscription_data: { metadata: metadata }
+      }
+    end
+
+    def metadata
+      { account_id: account.id, external_account_id: account.external_account_id, plan_key: plan.key }
+    end
+end
diff --git a/saas/app/models/billing/customer.rb b/saas/app/models/billing/customer.rb
new file mode 100644
index 0000000..9a54f20
--- /dev/null
+++ b/saas/app/models/billing/customer.rb
@@ -0,0 +1,29 @@
+# The Stripe customer we bill for an account. Created on the first checkout and
+# remembered on the account's subscription from then on.
+class Billing::Customer
+  attr_reader :account
+
+  def initialize(account)
+    @account = account
+  end
+
+  def id
+    account.subscription&.stripe_customer_id || create.id
+  end
+
+  private
+    def create
+      Stripe::Customer.create(customer_attributes).tap do |customer|
+        account.create_subscription! stripe_customer_id: customer.id
+        account.reload_subscription
+      end
+    end
+
+    def customer_attributes
+      {
+        name: account.name,
+        email: account.owner_email,
+        metadata: { account_id: account.id, external_account_id: account.external_account_id }
+      }
+    end
+end
diff --git a/saas/app/models/billing/event.rb b/saas/app/models/billing/event.rb
new file mode 100644
index 0000000..c28d5d6
--- /dev/null
+++ b/saas/app/models/billing/event.rb
@@ -0,0 +1,99 @@
+# A subscription change, as told by Stripe. Stripe is the source of truth: we
+# only mirror what it sends so the app knows what an account is entitled to.
+class Billing::Event
+  attr_reader :event
+
+  def initialize(event)
+    @event = normalize(event)
+  end
+
+  def process
+    case type
+    when "checkout.session.completed"
+      complete_checkout
+    when "customer.subscription.created", "customer.subscription.updated", "customer.subscription.deleted"
+      record_subscription
+    when "invoice.upcoming", "invoice.payment_succeeded", "invoice.payment_failed"
+      record_invoice
+    end
+  end
+
+  def type
+    event[:type]
+  end
+
+  private
+    def normalize(event)
+      hash = event.respond_to?(:to_hash) ? event.to_hash : event
+      hash.deep_symbolize_keys
+    end
+
+    def object
+      event.dig(:data, :object) || {}
+    end
+
+    def complete_checkout
+      if subscription = subscription_for(customer_id: object[:customer], account_id: object[:client_reference_id])
+        subscription.update! \
+          stripe_subscription_id: object[:subscription] || subscription.stripe_subscription_id,
+          plan_key: plan_key_from_metadata || subscription.plan_key,
+          status: "active"
+      end
+    end
+
+    def record_subscription
+      if subscription = subscription_for(customer_id: object[:customer], account_id: account_id_from_metadata)
+        subscription.update! \
+          stripe_subscription_id: object[:id],
+          plan_key: plan_key_from_price || plan_key_from_metadata || subscription.plan_key,
+          status: deleted? ? "canceled" : object[:status],
+          current_period_end: timestamp(current_period_end),
+          cancel_at: deleted? ? Time.current : timestamp(object[:cancel_at])
+      end
+    end
+
+    def record_invoice
+      if subscription = subscription_for(customer_id: object[:customer])
+        subscription.update! next_amount_due_in_cents: object[:amount_due]
+      end
+    end
+
+    def deleted?
+      type == "customer.subscription.deleted"
+    end
+
+    def subscription_for(customer_id: nil, account_id: nil)
+      Account::Subscription.find_by(stripe_customer_id: customer_id) ||
+        Account::Subscription.find_by(account_id: account_id)
+    end
+
+    def account_id_from_metadata
+      object.dig(:metadata, :account_id)
+    end
+
+    def plan_key_from_metadata
+      object.dig(:metadata, :plan_key)
+    end
+
+    def plan_key_from_price
+      Plan.find_by_stripe_price_id(price_id)&.key
+    end
+
+    def price_id
+      subscription_item&.dig(:price, :id)
+    end
+
+    # Stripe moved the period boundaries onto the subscription's items, but
+    # still sends them at the top level on older API versions.
+    def current_period_end
+      object[:current_period_end] || subscription_item&.dig(:current_period_end)
+    end
+
+    def subscription_item
+      object.dig(:items, :data)&.first
+    end
+
+    def timestamp(seconds)
+      Time.at(seconds).utc if seconds.present?
+    end
+end
