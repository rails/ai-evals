+require "test_helper"
+
+class Admin::Accounts::OverriddenLimitsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "staff can override and reset an account's usage" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(@account),
+        params: { overridden_limit: { card_count: 1_000, bytes_used: 2.gigabytes } }
+    end
+
+    assert_redirected_to account_path_for(@account)
+    assert_equal 1_000, @account.reload.cards_used
+    assert_equal 2.gigabytes, @account.bytes_used
+    assert @account.exceeding_card_limit?
+
+    untenanted { delete saas.admin_account_overridden_limit_path(@account) }
+
+    assert_redirected_to account_path_for(@account)
+    assert_nil @account.reload.overridden_limit
+    assert_not @account.exceeding_card_limit?
+  end
+
+  test "blank fields leave the real usage alone" do
+    sign_in_as :david
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(@account),
+        params: { overridden_limit: { card_count: "950", bytes_used: "" } }
+    end
+
+    assert_equal 950, @account.reload.cards_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "non-staff cannot" do
+    sign_in_as :jz
+
+    untenanted do
+      post saas.admin_account_overridden_limit_path(@account), params: { overridden_limit: { card_count: 1_000 } }
+    end
+
+    assert_response :forbidden
+    assert_nil @account.reload.overridden_limit
+  end
+
+  private
+    def account_path_for(account)
+      untenanted { saas.admin_account_path(account) }
+    end
+end
