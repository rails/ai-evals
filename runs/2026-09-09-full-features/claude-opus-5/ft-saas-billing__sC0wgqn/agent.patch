diff --git a/saas/app/models/account/card_limited.rb b/saas/app/models/account/card_limited.rb
new file mode 100644
index 0000000..94db170
--- /dev/null
+++ b/saas/app/models/account/card_limited.rb
@@ -0,0 +1,27 @@
+# Free accounts get a finite number of cards. They can keep drafting when they
+# run out, but they can't publish another one until they upgrade.
+module Account::CardLimited
+  extend ActiveSupport::Concern
+
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  def card_limit
+    plan.card_limit
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def cards_remaining
+    [ card_limit - cards_used, 0 ].max unless unlimited_cards?
+  end
+
+  def exceeding_card_limit?
+    !unlimited_cards? && cards_used >= card_limit
+  end
+
+  def nearing_card_limit?
+    !unlimited_cards? && !exceeding_card_limit? && cards_remaining <= NEAR_CARD_LIMIT_THRESHOLD
+  end
+end
diff --git a/saas/app/models/account/limit_overridable.rb b/saas/app/models/account/limit_overridable.rb
new file mode 100644
index 0000000..e063fcc
--- /dev/null
+++ b/saas/app/models/account/limit_overridable.rb
@@ -0,0 +1,32 @@
+# Support can pin an account's usage to whatever numbers they need to see, so
+# the limits can be exercised without filling an account up for real.
+module Account::LimitOverridable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+  end
+
+  def cards_used
+    overridden_limit&.card_count || cards_count
+  end
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    if overridden_limit
+      overridden_limit.update!(card_count: card_count, bytes_used: bytes_used)
+    else
+      create_overridden_limit!(card_count: card_count, bytes_used: bytes_used)
+    end
+
+    reload_overridden_limit
+  end
+
+  def reset_limits
+    overridden_limit&.destroy
+    reload_overridden_limit
+  end
+end
