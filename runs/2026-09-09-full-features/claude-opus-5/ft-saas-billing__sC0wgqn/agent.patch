@@ -0,0 +1,58 @@
+require "test_helper"
+
+class Billing::CheckoutsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:"37s")
+  end
+
+  test "admins are sent to Stripe's hosted checkout" do
+    sign_in_as :kevin
+
+    Stripe::Customer.expects(:create).returns(stripe_object(id: "cus_1"))
+    Stripe::Checkout::Session.expects(:create).with do |attributes|
+      attributes[:mode] == "subscription" && attributes[:customer] == "cus_1" && attributes[:client_reference_id] == @account.id
+    end.returns(stripe_object(url: "https://checkout.stripe.com/c/pay/test"))
+
+    post saas.billing_checkouts_path(plan_key: Plan::UNLIMITED.key)
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/test"
+    assert_equal "cus_1", @account.reload.subscription.stripe_customer_id
+  end
+
+  test "the stripe customer is reused" do
+    @account.create_subscription! stripe_customer_id: "cus_existing"
+    sign_in_as :kevin
+
+    Stripe::Customer.expects(:create).never
+    Stripe::Checkout::Session.expects(:create).returns(stripe_object(url: "https://checkout.stripe.com/c/pay/test"))
+
+    post saas.billing_checkouts_path(plan_key: Plan::UNLIMITED_PLUS.key)
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/test"
+  end
+
+  test "an unknown plan goes back to the pitch" do
+    sign_in_as :kevin
+
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.billing_checkouts_path(plan_key: "free")
+
+    assert_redirected_to saas.billing_upgrade_path
+  end
+
+  test "members cannot check out" do
+    sign_in_as :jz
+
+    Stripe::Checkout::Session.expects(:create).never
+
+    post saas.billing_checkouts_path(plan_key: Plan::UNLIMITED.key)
+
+    assert_response :forbidden
+  end
+
+  private
+    def stripe_object(attributes)
+      Stripe::StripeObject.construct_from(attributes)
+    end
+end
