diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..5a6b205
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,54 @@
+# The Stripe side of an account: who we bill, for what, and how it's going.
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due ]
+
+  belongs_to :account
+
+  scope :active, -> { where(status: ACTIVE_STATUSES) }
+
+  def plan
+    Plan.find(plan_key) || Plan.free
+  end
+
+  def plan=(plan)
+    self.plan_key = plan&.key
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def cancelling?
+    cancel_at.present?
+  end
+
+  def next_amount_due_in_dollars
+    next_amount_due_in_cents / 100 if next_amount_due_in_cents
+  end
+
+  # Let the current period play out, then stop billing.
+  def cancel_later
+    if stripe_subscription_id.present?
+      Stripe::Subscription.update(stripe_subscription_id, cancel_at_period_end: true)
+    end
+
+    update! cancel_at: current_period_end || Time.current
+  end
+
+  # Stop billing right now. Used when an account is incinerated.
+  def cancel_now
+    if stripe_subscription_id.present?
+      Stripe::Subscription.cancel(stripe_subscription_id)
+    end
+
+    update! status: "canceled", cancel_at: Time.current, next_amount_due_in_cents: nil
+  end
+
+  # Pick up where we left off after an account is reactivated.
+  def resume
+    if stripe_subscription_id.present? && cancel_at.present? && active?
+      Stripe::Subscription.update(stripe_subscription_id, cancel_at_period_end: false)
+      update! cancel_at: nil
+    end
+  end
+end
