+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account</h2>
+    </header>
+
+    <ul class="margin-block-half txt-small txt-align-start">
+      <li>ID: <%= @account.external_account_id %></li>
+      <li>Owner: <%= @account.owner_email || "None" %></li>
+      <li>Created: <%= @account.created_at.to_fs(:long) %></li>
+      <li>Plan: <strong><%= @account.plan.name %></strong><%= " (comped)" if @account.comped? %></li>
+      <li>
+        Cards: <%= number_with_delimiter(@account.cards_used) %>
+        <% if @account.unlimited_cards? %>
+          (unlimited)
+        <% else %>
+          of <%= number_with_delimiter(@account.card_limit) %>
+        <% end %>
+      </li>
+      <li>Storage: <%= number_to_human_size(@account.bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %></li>
+      <% if subscription = @account.subscription %>
+        <li>Stripe customer: <%= subscription.stripe_customer_id %></li>
+        <li>Stripe subscription: <%= subscription.stripe_subscription_id || "None" %> (<%= subscription.status || "none" %>)</li>
+      <% end %>
+      <% if @account.overridden_limit %>
+        <li>
+          Overridden usage:
+          <%= @account.overridden_limit.card_count || "—" %> cards,
+          <%= @account.overridden_limit.bytes_used || "—" %> bytes
+        </li>
+      <% end %>
+    </ul>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Comp</h2>
+    </header>
+
+    <div class="flex gap-half margin-block-half">
+      <% if @account.comped? %>
+        <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn" %>
+      <% else %>
+        <%= button_to "Comp", saas.admin_account_comp_path(@account), method: :post, class: "btn" %>
+      <% end %>
+    </div>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Override usage</h2>
+      <div class="txt-small txt-ink-medium">Pretend this account has used this many cards and bytes. Leave a field blank to use the real number.</div>
+    </header>
+
+    <%= form_with url: saas.admin_account_overridden_limit_path(@account), method: :post, scope: :overridden_limit, class: "flex flex-column gap-half margin-block-half" do |form| %>
+      <label class="flex flex-column gap-quarter txt-align-start">
+        Card count
+        <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, min: 0, class: "input" %>
+      </label>
+
+      <label class="flex flex-column gap-quarter txt-align-start">
+        Bytes used
+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, min: 0, class: "input" %>
+      </label>
+
+      <div class="flex gap-half">
+        <%= form.submit "Override", class: "btn" %>
+      </div>
+    <% end %>
+
+    <%= button_to "Reset", saas.admin_account_overridden_limit_path(@account), method: :delete, class: "btn" %>
+
+    <div class="margin-block-start">
+      <%= link_to "All accounts", saas.admin_accounts_path, class: "btn" %>
+    </div>
+  </div>
+</section>
