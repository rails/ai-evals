+++ b/app/controllers/activities_controller.rb
@@ -0,0 +1,25 @@
+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activities
+  end
+
+  private
+    def activities
+      activities = Current.user.accessible_events.activities.preloaded.reverse_chronologically
+      activities = activities.where(creator_id: creator_ids) if creator_ids.any?
+      activities = activities.where(board_id: board_ids) if board_ids.any?
+      activities
+    end
+
+    def creator_ids
+      ids_param :creator_ids
+    end
+
+    def board_ids
+      ids_param :board_ids
+    end
+
+    def ids_param(name)
+      Array(params[name]).grep(String)
+    end
+end
diff --git a/app/helpers/activities_helper.rb b/app/helpers/activities_helper.rb
new file mode 100644
index 0000000..48199b4
--- /dev/null
+++ b/app/helpers/activities_helper.rb
@@ -0,0 +1,16 @@
+module ActivitiesHelper
+  def activity_particulars(activity)
+    case activity.action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(activity.assignee_ids) }
+    when "card_board_changed"
+      { old_board: activity.details["old_board"].to_s, new_board: activity.details["new_board"].to_s }
+    when "card_title_changed"
+      { old_title: activity.details["old_title"].to_s, new_title: activity.details["new_title"].to_s }
+    when "card_triaged"
+      { column: activity.details["column"].to_s }
+    else
+      {}
+    end
+  end
+end
