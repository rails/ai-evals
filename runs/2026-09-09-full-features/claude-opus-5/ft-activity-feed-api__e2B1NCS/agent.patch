+++ b/docs/api/sections/activities.md
@@ -0,0 +1,81 @@
+# Activities
+
+Activities are the events that happen in an account: cards being added, assigned, moved, renamed, closed, and commented on. They're the same events you see in the activity timeline of the web app.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activity you have access to, newest first. Results can be filtered using query parameters.
+
+__Query Parameters:__
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Filter by the ID(s) of the user who created the activity |
+| `board_ids[]` | Filter by board ID(s) |
+
+__Actions:__
+
+| Action | Description |
+|--------|-------------|
+| `card_published` | A card was added |
+| `card_assigned` | A card was assigned |
+| `card_unassigned` | A card was unassigned |
+| `card_title_changed` | A card was renamed |
+| `card_board_changed` | A card was moved to another board |
+| `card_triaged` | A card was moved to a column |
+| `card_sent_back_to_triage` | A card was moved back to "Maybe?" |
+| `card_postponed` | A card was moved to "Not Now" |
+| `card_auto_postponed` | A card was moved to "Not Now" due to inactivity |
+| `card_closed` | A card was moved to "Done" |
+| `card_reopened` | A card was reopened |
+| `comment_created` | A comment was posted on a card |
+
+The `eventable` is the card the activity happened on, or the comment that was posted, matching the representations returned by the cards and comments endpoints. The `url` opens the card, jumping to the comment for `comment_created` activity.
+
+The `particulars` carry the details specific to each action:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Every other action returns an empty `particulars` object.
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.534Z",
+    "description": "David Heinemeier Hansson assigned Jason Fried to &quot;First!&quot;",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a7"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/4",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5vaeq985jlvwv3arl4srq2",
+      "number": 4,
+      "title": "First!",
+      "status": "published",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/4"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohcm",
+      "name": "Fizzy",
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zkft4hj9qq0lsn9ohcm"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
+
+The `eventable`, `board`, and `creator` objects are abbreviated above. They're returned in full, just like the cards, comments, boards, and users endpoints return them.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..76da8e2
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,157 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "index" do
+    get activities_path
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert_includes activity_ids, events(:logo_published).id
+  end
+
+  test "index with an access token" do
+    get activities_path, env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    assert_response :success
+    assert_includes activity_ids, events(:logo_published).id
+  end
+
+  test "index returns the newest activity first" do
+    get activities_path
+
+    created_ats = @response.parsed_body.map { it["created_at"] }
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "index is paginated" do
+    get activities_path(page: 2)
+
+    assert_response :success
+    assert_empty @response.parsed_body
+  end
+
+  test "index includes the event attributes" do
+    get activities_path
+
+    activity = find_activity events(:logo_published)
+
+    assert_equal "card_published", activity["action"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(cards(:logo)), activity["url"]
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_match "David added", activity["description"]
+  end
+
+  test "index points comment activity at the comment" do
+    comment = comments(:layout_overflowing_david)
+
+    get activities_path
+
+    activity = find_activity events(:layout_commented)
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_match "David commented on", activity["description"]
+  end
+
+  test "index includes assignment particulars" do
+    get activities_path
+
+    assert_equal [ users(:jz).id ], find_activity(events(:logo_assignment_jz)).dig("particulars", "assignee_ids")
+  end
+
+  test "index includes title change particulars" do
+    event = events(:logo_published)
+    event.update! action: "card_title_changed", particulars: { particulars: { old_title: "Old", new_title: "New" } }
+
+    get activities_path
+
+    activity = find_activity event
+
+    assert_equal "Old", activity.dig("particulars", "old_title")
+    assert_equal "New", activity.dig("particulars", "new_title")
+  end
+
+  test "index includes board change particulars" do
+    event = events(:logo_published)
+    event.update! action: "card_board_changed", particulars: { particulars: { new_board: "Writebook" } }
+
+    get activities_path
+
+    activity = find_activity event
+
+    assert_equal "", activity.dig("particulars", "old_board")
+    assert_equal "Writebook", activity.dig("particulars", "new_board")
+  end
+
+  test "index includes triage particulars" do
+    event = events(:logo_published)
+    event.update! action: "card_triaged", particulars: { particulars: { column: "Doing" } }
+
+    get activities_path
+
+    assert_equal "Doing", find_activity(event).dig("particulars", "column")
+  end
+
+  test "index omits deprecated collection change activity" do
+    event = events(:logo_published)
+    event.update! action: "card_collection_changed"
+
+    get activities_path
+
+    assert_not_includes activity_ids, event.id
+  end
+
+  test "index filters by creator" do
+    get activities_path(creator_ids: [ users(:kevin).id ])
+
+    assert_not_empty @response.parsed_body
+    assert_equal [ users(:kevin).id ], @response.parsed_body.map { it.dig("creator", "id") }.uniq
+  end
+
+  test "index filters by a single creator id" do
+    get activities_path(creator_ids: users(:kevin).id)
+
+    assert_not_empty @response.parsed_body
+    assert_equal [ users(:kevin).id ], @response.parsed_body.map { it.dig("creator", "id") }.uniq
+  end
+
+  test "index filters by board" do
+    get activities_path(board_ids: [ boards(:private).id ])
+
+    assert_empty @response.parsed_body
+  end
+
+  test "index ignores bogus filters" do
+    get activities_path(creator_ids: { nonsense: "nope" })
+
+    assert_response :success
+    assert_not_empty @response.parsed_body
+  end
+
+  test "index only returns accessible activity" do
+    event = events(:logo_published)
+    event.update! board: boards(:private)
+
+    get activities_path
+
+    assert_not_includes activity_ids, event.id
+  end
+
+  private
+    def activity_ids
+      @response.parsed_body.map { it["id"] }
+    end
+
+    def find_activity(event)
+      @response.parsed_body.find { it["id"] == event.id }
+    end
+end
