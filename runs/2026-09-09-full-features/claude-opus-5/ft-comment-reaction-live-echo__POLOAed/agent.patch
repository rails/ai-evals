diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..d58c2e6
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,30 @@
+class Reaction < ApplicationRecord
+  MAX_CONTENT_LENGTH = 16
+  EMOJI_ONLY = /\A(?=.*\p{Extended_Pictographic})[\p{Extended_Pictographic}\p{Emoji_Modifier}\p{Regional_Indicator}\u{FE0E}\u{FE0F}\u{200D}[:space:]]+\z/
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  validates :content, presence: true, length: { maximum: MAX_CONTENT_LENGTH }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+  scope :preloaded, -> { preload(reacter: [ :avatar_attachment, :account ]) }
+
+  after_create :register_card_activity
+
+  delegate :card, to: :comment
+
+  def by?(user)
+    reacter_id == user&.id
+  end
+
+  def emoji?
+    content.to_s.match? EMOJI_ONLY
+  end
+
+  private
+    def register_card_activity
+      card.touch_last_active_at
+    end
+end
