+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "reacting defaults to the current user and the comment's account" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal @comment.account, reaction.account
+    assert_equal @comment.card, reaction.card
+  end
+
+  test "content is required" do
+    reaction = @comment.reactions.build(content: "")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "content is limited to 16 characters" do
+    assert @comment.reactions.build(content: "x" * 16).valid?
+    assert_not @comment.reactions.build(content: "x" * 17).valid?
+  end
+
+  test "reacting registers activity on the card" do
+    assert_changes -> { @comment.card.reload.last_active_at } do
+      @comment.reactions.create!(content: "👍")
+    end
+  end
+
+  test "reacting touches the comment so cached renderings are refreshed" do
+    assert_changes -> { @comment.reload.updated_at } do
+      @comment.reactions.create!(content: "👍")
+    end
+  end
+
+  test "reactions are removed along with their comment" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    @comment.destroy
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "by? knows who left the reaction" do
+    reaction = @comment.reactions.create!(content: "👍")
+
+    assert reaction.by?(users(:david))
+    assert_not reaction.by?(users(:kevin))
+    assert_not reaction.by?(nil)
+  end
+
+  test "reacting broadcasts a refresh to everyone looking at the card" do
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts @comment.card do
+        @comment.reactions.create!(content: "👍")
+      end
+    end
+  end
+
+  test "removing a reaction broadcasts a refresh to everyone looking at the card" do
+    reaction = reactions(:logo_agreement_kevin_yes)
+
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts reaction.card do
+        reaction.destroy!
+      end
+    end
+  end
+
+  test "emoji only reactions are told apart from text ones" do
+    assert @comment.reactions.build(content: "👍").emoji?
+    assert @comment.reactions.build(content: "❤️").emoji?
+    assert_not @comment.reactions.build(content: "Yes!").emoji?
+    assert_not @comment.reactions.build(content: "OK 👍").emoji?
+  end
+end
