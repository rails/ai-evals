diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..244ae65
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,122 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as :kevin
+
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "👍" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_equal users(:kevin), @comment.reactions.last.reacter
+    assert_turbo_stream action: :append, target: dom_id(@comment, :reactions_list)
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Nice" } }, as: :json
+    end
+
+    assert_response :created
+    reaction = @comment.reactions.last
+    assert_equal card_comment_reaction_path(@card, @comment, reaction, format: :json), @response.headers["Location"]
+    assert_equal "Nice", @response.parsed_body["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.dig("reacter", "id")
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "Flat" }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create with too long content" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "x" * 17 } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create on a comment that belongs to another card" do
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, comments(:layout_overflowing_david)),
+        params: { reaction: { content: "ok" } }, as: :json
+    end
+
+    assert_response :not_found
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(cards(:logo), comments(:logo_agreement_kevin)), as: :json
+
+    assert_response :success
+    assert_equal [ reactions(:logo_agreement_kevin_yes).id ], @response.parsed_body.map { it["id"] }
+    assert_equal users(:david).id, @response.parsed_body.first.dig("reacter", "id")
+  end
+
+  test "destroy your own reaction" do
+    reaction = reactions(:logo_agreement_jz_thumbs_up)
+
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(@card, reaction.comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :remove, target: dom_id(reaction)
+  end
+
+  test "destroy as JSON" do
+    reaction = reactions(:logo_agreement_jz_thumbs_up)
+
+    assert_difference -> { Reaction.count }, -1 do
+      delete card_comment_reaction_path(@card, reaction.comment, reaction), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy someone else's reaction is forbidden" do
+    reaction = reactions(:logo_agreement_kevin_yes)
+
+    assert_no_difference -> { Reaction.count } do
+      delete card_comment_reaction_path(@card, reaction.comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "reactions show up on the card page" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(reactions(:logo_agreement_kevin_yes))}", text: /Yes!/
+    assert_select "##{dom_id(comments(:logo_agreement_kevin), :reactions)} .reactions__trigger"
+  end
+  test "reacting to a system comment is forbidden" do
+    system_comment = comments(:logo_1)
+
+    assert_no_difference -> { Reaction.count } do
+      post card_comment_reactions_path(@card, system_comment), params: { reaction: { content: "👍" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "system comments don't offer reactions" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(comments(:logo_1), :reactions)}", false
+  end
+end
