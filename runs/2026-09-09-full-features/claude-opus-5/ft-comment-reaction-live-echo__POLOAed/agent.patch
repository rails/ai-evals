+++ b/test/system/reactions_test.rb
@@ -0,0 +1,99 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+
+    @card = cards(:layout)
+    @comment = comments(:layout_overflowing_david)
+  end
+
+  test "leaving a reaction on a comment" do
+    visit card_url(@card)
+
+    within_reactions_for @comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Nice!"
+      click_on "Add this reaction"
+
+      assert_selector ".reaction", text: "Nice!"
+      assert_no_selector ".reaction__form"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_equal "Nice!", @comment.reactions.sole.content
+  end
+
+  test "canceling a reaction leaves the button behind" do
+    visit card_url(@card)
+
+    within_reactions_for @comment do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Nope"
+      click_on "Cancel this reaction"
+
+      assert_no_selector ".reaction__form"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_empty @comment.reactions
+  end
+
+  test "removing your own reaction" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    visit card_url(@card)
+
+    within_reactions_for @comment do
+      find("##{dom_id(reaction)}").click
+      click_on "Remove your reaction"
+
+      assert_no_selector "##{dom_id(reaction)}"
+    end
+
+    assert_empty @comment.reactions.reload
+  end
+
+  test "someone else's reaction can't be removed" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:david))
+
+    visit card_url(@card)
+
+    within_reactions_for @comment do
+      find("##{dom_id(reaction)}").click
+
+      assert_no_selector ".reaction__delete", visible: true
+    end
+  end
+
+  test "reactions left by others show up without reloading" do
+    visit card_url(@card)
+    within_reactions_for(@comment) { assert_selector ".reactions__trigger" }
+    wait_for_cable_subscriptions
+
+    react_elsewhere_with "🎉"
+
+    assert_selector ".reaction", text: "🎉", wait: 5
+  end
+
+  private
+    def within_reactions_for(comment, &block)
+      within "##{dom_id(comment, :reactions)}", &block
+    end
+
+    def react_elsewhere_with(content)
+      Current.user = users(:david)
+      @comment.reactions.create!(content: content)
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    ensure
+      Current.user = nil
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
