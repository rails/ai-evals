index 0000000..ef0e9b7
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,23 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Reactions are rendered inside cached comments, so who left one is settled
+// here, in the browser: only your own reactions offer a way to remove them.
+export default class extends Controller {
+  static values = { reacterId: String }
+
+  connect() {
+    if (this.#mine) this.element.classList.add("reaction--deleteable")
+  }
+
+  toggle() {
+    if (this.#mine) this.element.classList.toggle("expanded")
+  }
+
+  remove() {
+    this.element.classList.add("reaction--deleting")
+  }
+
+  get #mine() {
+    return this.reacterIdValue === window.Current?.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..025c38e
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,24 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Swaps the "add a reaction" button for a small form, and back again once the
+// reaction has been left or the form is dismissed.
+export default class extends Controller {
+  static targets = [ "template", "trigger", "form", "input" ]
+
+  open() {
+    if (this.hasFormTarget) return
+
+    this.triggerTarget.hidden = true
+    this.element.insertBefore(this.templateTarget.content.cloneNode(true), this.triggerTarget)
+    this.formTarget.classList.add("expanded")
+    this.inputTarget.focus()
+  }
+
+  close(event) {
+    if (event?.detail?.success === false) return
+    if (!this.hasFormTarget) return
+
+    this.formTarget.remove()
+    this.triggerTarget.hidden = false
+  }
+}
