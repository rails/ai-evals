diff --git a/test/models/multi_tenancy_test.rb b/test/models/multi_tenancy_test.rb
new file mode 100644
index 0000000..fc7ace6
--- /dev/null
+++ b/test/models/multi_tenancy_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+
+class MultiTenancyTest < ActiveSupport::TestCase
+  # Global records aren't owned by a single account: an identity signs in once
+  # and can hold users in many accounts, so its sessions, magic links, passkeys
+  # and access tokens live outside any tenant. Accounts (and the sequence that
+  # numbers them) are the tenant, not tenant data.
+  GLOBAL_TABLES = %w[
+    account_external_id_sequences
+    accounts
+    action_pack_passkeys
+    identities
+    identity_access_tokens
+    magic_links
+    sessions
+  ].freeze
+
+  # Rails bookkeeping and the Solid Queue/Cache/Cable backends (which normally
+  # live in their own databases) hold no account data either.
+  INTERNAL_TABLES = %w[ ar_internal_metadata schema_migrations ].freeze
+  INTERNAL_TABLE_PREFIX = "solid_"
+
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+    @user = users(:david)
+  end
+
+  test "every table that holds an account's data has a required account_id" do
+    tenant_tables.each do |table|
+      account_id = column_for(table, "account_id")
+
+      assert account_id, "#{table} has no account_id"
+      assert_not account_id.null, "#{table}.account_id allows NULL"
+    end
+  end
+
+  test "every account_id is indexed" do
+    tenant_tables.each do |table|
+      assert connection.index_exists?(table, :account_id), "#{table}.account_id isn't indexed"
+    end
+  end
+
+  test "global tables stay global" do
+    GLOBAL_TABLES.each do |table|
+      assert_nil column_for(table, "account_id"), "#{table} shouldn't be account scoped"
+    end
+  end
+
+  test "records derive their account from the record they hang off" do
+    assert_equal @account, Access.create!(board: boards(:private), user: @user).account
+    assert_equal @account, Assignment.create!(card: @card, assignee: @user, assigner: @user).account
+    assert_equal @account, Closure.create!(card: cards(:buy_domain), user: @user).account
+    assert_equal @account, Tagging.create!(card: cards(:shipping), tag: tags(:web)).account
+    assert_equal @account, Watch.create!(card: cards(:buy_domain), user: @user).account
+    assert_equal @account, Pin.create!(card: cards(:layout), user: @user).account
+    assert_equal @account, Reaction.create!(reactable: @card, reacter: @user, content: "🎉").account
+    assert_equal @account, Mention.create!(source: @card, mentioner: @user, mentionee: users(:jz)).account
+    assert_equal @account, Card::Goldness.create!(card: cards(:layout)).account
+    assert_equal @account, Card::NotNow.create!(card: cards(:layout), user: @user).account
+    assert_equal @account, Card::ActivitySpike.create!(card: cards(:layout)).account
+    assert_equal @account, Board::Publication.create!(board: boards(:private)).account
+    assert_equal @account, User::Settings.create!(user: users(:jason)).account
+    assert_equal @account, Search::Query.create!(user: @user, terms: "hi").account
+    assert_equal @account, Entropy.create!(container: board_without_entropy, auto_postpone_period: 3.days).account
+    assert_equal @account, Storage::Total.create!(owner: boards(:private)).account
+  end
+
+  test "webhook records derive their account from the webhook" do
+    webhook = webhooks(:active)
+
+    assert_equal @account, webhook.delinquency_tracker.account
+    assert_equal @account, Webhook::Delivery.create!(webhook: webhook, event: events(:logo_published)).account
+  end
+
+  test "attachments, blobs and rich text belong to an account" do
+    @card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+
+    assert_equal @account, @card.image_attachment.account
+    assert_equal @account, @card.image.blob.account
+    @card.image.variant(resize_to_limit: [ 10, 10 ]).processed
+    assert_equal @account, ActiveStorage::VariantRecord.sole.account
+
+    @card.update! description: "Hello"
+    assert_equal @account, @card.rich_text_description.account
+  end
+
+  test "filter join rows belong to an account" do
+    filter = Filter.create!(creator: @user, fields: { indexed_by: :all }.to_json, params_digest: SecureRandom.hex)
+
+    filter.tags = [ tags(:web) ]
+    filter.boards = [ @board ]
+    filter.assignees = [ @user ]
+    filter.creators = [ @user ]
+    filter.closers = [ @user ]
+
+    %w[ filters_tags boards_filters assignees_filters creators_filters closers_filters ].each do |join_table|
+      assert_equal [ @account.id ], account_ids_in(join_table), "#{join_table} isn't account scoped"
+    end
+  end
+
+  private
+    def board_without_entropy
+      @account.boards.create!(name: "Ideas", creator: @user)
+    end
+
+    def connection
+      ApplicationRecord.connection
+    end
+
+    def tenant_tables
+      (connection.tables - GLOBAL_TABLES - INTERNAL_TABLES).reject { |table| table.start_with?(INTERNAL_TABLE_PREFIX) }
+    end
+
+    def column_for(table, name)
+      connection.columns(table).find { |column| column.name == name }
+    end
+
+    def account_ids_in(table)
+      connection.select_values("SELECT DISTINCT account_id FROM #{table}").map do |value|
+        ActiveRecord::Type::Uuid.new.deserialize(value)
+      end
+    end
+end
