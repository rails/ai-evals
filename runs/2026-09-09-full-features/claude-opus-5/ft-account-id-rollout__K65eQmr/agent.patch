+    # An account_id lifted straight off the parent record.
+    def from(parent_table, foreign_key, parent_column: "account_id")
+      "SELECT #{parent_table}.#{parent_column} FROM #{parent_table} " \
+        "WHERE #{parent_table}.id = #{foreign_key}"
+    end
+
+    # An account_id resolved through a polymorphic association. `:account` means
+    # the associated record is the account itself.
+    def through_polymorphic(table, association, parents)
+      clauses = parents.map do |type, parent_table|
+        lookup = if parent_table == :account
+          from("accounts", "#{table}.#{association}_id", parent_column: "id")
+        else
+          from(parent_table, "#{table}.#{association}_id")
+        end
+
+        "WHEN #{table}.#{association}_type = '#{type}' THEN (#{lookup})"
+      end
+
+      "SELECT CASE #{clauses.join(' ')} END"
+    end
+  end
+
+  # Tables that need the column added.
+  NEW_COLUMNS = %w[
+    accesses
+    action_text_rich_texts
+    active_storage_attachments
+    active_storage_blobs
+    active_storage_variant_records
+    assignees_filters
+    assigners_filters
+    assignments
+    board_publications
+    boards_filters
+    card_activity_spikes
+    card_goldnesses
+    card_not_nows
+    closers_filters
+    closures
+    creators_filters
+    entropies
+    filters_tags
+    mentions
+    pins
+    reactions
+    search_queries
+    storage_totals
+    taggings
+    user_settings
+    watches
+    webhook_delinquency_trackers
+    webhook_deliveries
