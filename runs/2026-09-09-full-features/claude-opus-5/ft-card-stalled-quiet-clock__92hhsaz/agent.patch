diff --git a/app/models/card/stalling.rb b/app/models/card/stalling.rb
new file mode 100644
index 0000000..b91a010
--- /dev/null
+++ b/app/models/card/stalling.rb
@@ -0,0 +1,83 @@
+# Cards that get a burst of attention and then go cold. A burst is a flurry of
+# comments from several people landing within a third of the board's auto-close
+# period, an assignment, or a reopening. When a card that had a burst goes quiet
+# for the stall period, it's stalled. Any activity on the card bumps
+# +last_active_at+, which resets the stall.
+module Card::Stalling
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+
+  BURST_WINDOW_DIVISOR = 3
+  BURST_COMMENTS = 3
+  BURST_COMMENTERS = 2
+  BURST_EVENT_ACTIONS = %w[ card_assigned card_reopened ].freeze
+
+  class_methods do
+    def stalled(as_of: Time.now)
+      active.with_burst.where(last_active_at: ..(as_of - STALL_PERIOD))
+    end
+
+    def with_burst
+      with_burst_windows.where("#{burst_events_condition} OR #{burst_comments_condition}")
+    end
+
+    private
+      # Makes each board's effective auto-close period (board override, else
+      # account default) available to the burst conditions below.
+      def with_burst_windows
+        joins(board: :account)
+          .left_outer_joins(board: :entropy)
+          .joins("LEFT OUTER JOIN entropies AS account_entropies ON account_entropies.account_id = accounts.id AND account_entropies.container_type = 'Account' AND account_entropies.container_id = accounts.id")
+      end
+
+      def burst_events_condition
+        <<~SQL.squish
+          EXISTS (
+            SELECT 1 FROM events AS burst_events
+            WHERE burst_events.eventable_type = 'Card' AND burst_events.eventable_id = cards.id
+              AND burst_events.action IN (#{BURST_EVENT_ACTIONS.map { |action| connection.quote(action) }.join(", ")})
+          )
+        SQL
+      end
+
+      # Opens a window on every comment and counts the comments landing within
+      # it, ignoring the system's own bookkeeping comments.
+      def burst_comments_condition
+        <<~SQL.squish
+          EXISTS (
+            SELECT 1 FROM comments AS burst_comments
+              JOIN users AS burst_creators ON burst_creators.id = burst_comments.creator_id AND burst_creators.role != 'system'
+              JOIN comments AS windowed_comments ON windowed_comments.card_id = burst_comments.card_id
+                AND windowed_comments.created_at >= burst_comments.created_at
+                AND burst_comments.created_at >= #{connection.date_subtract("windowed_comments.created_at", burst_window)}
+              JOIN users AS windowed_creators ON windowed_creators.id = windowed_comments.creator_id AND windowed_creators.role != 'system'
+            WHERE burst_comments.card_id = cards.id
+            GROUP BY burst_comments.id
+            HAVING COUNT(*) >= #{BURST_COMMENTS} AND COUNT(DISTINCT windowed_comments.creator_id) >= #{BURST_COMMENTERS}
+          )
+        SQL
+      end
+
+      def burst_window
+        "COALESCE(entropies.auto_postpone_period, account_entropies.auto_postpone_period) / #{BURST_WINDOW_DIVISOR.to_f}"
+      end
+  end
+
+  def stalled?
+    active? && quiet_for_stall_period? && burst?
+  end
+
+  def stalled_since
+    last_active_at if stalled?
+  end
+
+  def burst?
+    self.class.where(id: id).with_burst.exists?
+  end
+
+  private
+    def quiet_for_stall_period?
+      last_active_at.present? && last_active_at <= STALL_PERIOD.ago
+    end
+end
