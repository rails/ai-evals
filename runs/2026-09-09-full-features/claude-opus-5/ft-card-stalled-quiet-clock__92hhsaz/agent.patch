diff --git a/test/models/card/stalling_test.rb b/test/models/card/stalling_test.rb
new file mode 100644
index 0000000..d67b690
--- /dev/null
+++ b/test/models/card/stalling_test.rb
@@ -0,0 +1,186 @@
+require "test_helper"
+
+class Card::StallingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+  end
+
+  test "cards without a burst of attention never stall" do
+    go_quiet @card
+
+    assert_not @card.burst?
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "a flurry of comments from several people is a burst" do
+    comment_on @card, users(:david), 10.weeks.ago
+    comment_on @card, users(:kevin), 9.weeks.ago
+    comment_on @card, users(:kevin), 8.weeks.ago
+
+    assert @card.burst?
+
+    go_quiet @card
+
+    assert @card.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "comments landing outside the burst window aren't a burst" do
+    comment_on @card, users(:david), 20.weeks.ago
+    comment_on @card, users(:kevin), 15.weeks.ago
+    comment_on @card, users(:kevin), 10.weeks.ago
+
+    go_quiet @card
+
+    assert_not @card.burst?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "the burst window follows the board auto-close period" do
+    entropies(:writebook_board).update! auto_postpone_period: 3.days
+
+    comment_on @card, users(:david), 10.weeks.ago
+    comment_on @card, users(:kevin), 10.weeks.ago + 2.days
+    comment_on @card, users(:kevin), 10.weeks.ago + 4.days
+    go_quiet @card
+
+    assert_not @card.burst?
+    assert_not_includes Card.stalled, @card
+
+    entropies(:writebook_board).update! auto_postpone_period: 90.days
+    @card.reload
+
+    assert @card.burst?
+    assert_includes Card.stalled, @card
+  end
+
+  test "the burst window falls back to the account auto-close period" do
+    entropies(:writebook_board).destroy
+    @card.reload
+
+    comment_on @card, users(:david), 10.weeks.ago
+    comment_on @card, users(:kevin), 10.weeks.ago + 20.days
+    comment_on @card, users(:kevin), 10.weeks.ago + 25.days
+    go_quiet @card
+
+    assert_not @card.burst?
+    assert_not_includes Card.stalled, @card
+
+    comment_on @card, users(:jz), 10.weeks.ago + 26.days
+    go_quiet @card
+
+    assert @card.burst?
+    assert_includes Card.stalled, @card
+  end
+
+  test "comments from a single person aren't a burst" do
+    3.times { |index| comment_on @card, users(:david), (10 - index).weeks.ago }
+
+    go_quiet @card
+
+    assert_not @card.burst?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "system comments don't count towards a burst" do
+    comment_on @card, users(:david), 10.weeks.ago
+    comment_on @card, users(:kevin), 9.weeks.ago
+    comment_on @card, accounts("37s").system_user, 9.weeks.ago
+
+    go_quiet @card
+
+    assert_not @card.burst?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "assigning someone is a burst" do
+    @card.toggle_assignment users(:kevin)
+
+    assert @card.burst?
+
+    go_quiet @card
+
+    assert @card.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "reopening a card is a burst" do
+    @card.close
+    @card.reopen
+    @card.reload
+
+    assert @card.burst?
+
+    go_quiet @card
+
+    assert @card.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "a card that saw activity in the last two weeks isn't stalled" do
+    @card.toggle_assignment users(:kevin)
+    @card.update! last_active_at: 13.days.ago
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity resets the stall" do
+    @card.toggle_assignment users(:kevin)
+    go_quiet @card
+    assert @card.stalled?
+
+    @card.touch_last_active_at
+
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "closed, postponed and drafted cards aren't stalled" do
+    @card.toggle_assignment users(:kevin)
+    go_quiet @card
+
+    @card.close
+    go_quiet @card
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.reload.reopen
+    @card.postpone
+    go_quiet @card
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.resume
+    @card.reload.update! status: :drafted
+    go_quiet @card
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "stalled_since reports when the card went quiet" do
+    @card.toggle_assignment users(:kevin)
+    go_quiet @card
+
+    assert_equal @card.last_active_at, @card.stalled_since
+    assert_nil cards(:logo).stalled_since
+  end
+
+  test "cards indexed by stalled" do
+    @card.toggle_assignment users(:kevin)
+    go_quiet @card
+
+    assert_equal [ @card ], Card.indexed_by("stalled").to_a
+  end
+
+  private
+    def go_quiet(card, since: 3.weeks.ago)
+      card.update! last_active_at: since
+    end
+
+    def comment_on(card, creator, created_at)
+      card.comments.create! creator: creator, body: "Something", created_at: created_at
+    end
+end
