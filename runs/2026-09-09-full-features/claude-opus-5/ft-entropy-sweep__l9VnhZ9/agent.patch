+# The entropy sweep looks for cards that haven't been active since their board's
+# auto-postpone deadline. That's a range condition on last_active_at within a set of
+# boards, so index both columns together to avoid scanning every card in the install.
+class AddBoardIdAndLastActiveAtIndexToCards < ActiveRecord::Migration[8.2]
+  def change
+    add_index :cards, [ :board_id, :last_active_at ]
+    remove_index :cards, :board_id
+  end
+end
