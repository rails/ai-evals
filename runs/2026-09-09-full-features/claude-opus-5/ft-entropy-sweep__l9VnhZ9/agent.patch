diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..379f8f8 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,49 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due ignores cards whose board and account have no entropy configured" do
+    entropies(:writebook_board).destroy
+    entropies("37s_account").destroy
+
+    cards(:logo).update!(last_active_at: 10.years.ago)
+
+    assert_no_difference -> { Card.postponed.count } do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "due_to_be_postponed skips cards that are closed or already postponed" do
+    cards(:logo, :shipping).each do |card|
+      card.update!(last_active_at: entropies(:writebook_board).auto_postpone_period.seconds.ago - 2.days)
+    end
+    cards(:radio).update!(last_active_at: entropies(:miltons_wish_list_board).auto_postpone_period.seconds.ago - 2.days)
+
+    cards(:logo).close(user: users(:david))
+    cards(:shipping).postpone(user: users(:david))
+
+    assert_not_includes Card.due_to_be_postponed, cards(:logo)
+    assert_not_includes Card.due_to_be_postponed, cards(:shipping)
+    assert_includes Card.due_to_be_postponed, cards(:radio)
+  end
+
+  test "the entropy sweep resolves deadlines without reading every card" do
+    skip unless sqlite?
+
+    plan = query_plan_for(Card.due_to_be_postponed)
+
+    assert_no_match(/SCAN cards/, plan, "the entropy sweep should not read every card:\n#{plan}")
+    assert_match(/index_cards_on_board_id_and_last_active_at/, plan)
+  end
+
+  private
+    def sqlite?
+      ActiveRecord::Base.connection.adapter_name == "SQLite"
+    end
+
+    def query_plan_for(relation)
+      ActiveRecord::Base.connection
+        .select_all("EXPLAIN QUERY PLAN #{relation.to_sql}")
+        .rows.map(&:last).join("\n")
+    end
 end
