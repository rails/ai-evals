diff --git a/saas/app/models/account/subscription.rb b/saas/app/models/account/subscription.rb
new file mode 100644
index 0000000..b20dc04
--- /dev/null
+++ b/saas/app/models/account/subscription.rb
@@ -0,0 +1,58 @@
+# The Stripe-backed subscription for an account. Stripe owns the truth: we
+# mirror what its webhooks tell us so that plan lookups never need a round trip.
+class Account::Subscription < SaasRecord
+  ACTIVE_STATUSES = %w[ active trialing past_due ].freeze
+
+  belongs_to :account
+
+  scope :active, -> { where(status: ACTIVE_STATUSES) }
+
+  validates :stripe_customer_id, presence: true
+
+  class << self
+    def find_by_stripe_event(stripe_object)
+      find_by(stripe_subscription_id: stripe_object[:id]) ||
+        find_by(stripe_customer_id: stripe_object[:customer])
+    end
+  end
+
+  def plan
+    Plan.find(plan_key) || Plan.free
+  end
+
+  def plan=(plan)
+    self.plan_key = plan.key
+  end
+
+  def active?
+    status.in?(ACTIVE_STATUSES)
+  end
+
+  def canceling?
+    cancel_at.present?
+  end
+
+  def next_amount_due_in_dollars
+    next_amount_due_in_cents / 100 if next_amount_due_in_cents
+  end
+
+  def cancel_later
+    if stripe_subscription_id.present?
+      handling_stripe_errors { Stripe::Subscription.update(stripe_subscription_id, cancel_at_period_end: true) }
+    end
+  end
+
+  def cancel_now
+    if stripe_subscription_id.present?
+      handling_stripe_errors { Stripe::Subscription.cancel(stripe_subscription_id) }
+    end
+  end
+
+  private
+    def handling_stripe_errors
+      yield
+    rescue Stripe::StripeError => error
+      Rails.error.report(error, handled: true)
+      nil
+    end
+end
