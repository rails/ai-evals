+    subscription = @account.reload.subscription
+    assert_equal "cus_1", subscription.stripe_customer_id
+    assert_equal "sub_1", subscription.stripe_subscription_id
+    assert_equal Plan::UNLIMITED, subscription.plan
+    assert @account.subscribed?
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "subscription updates are mirrored" do
+    @account.create_subscription! plan_key: Plan::UNLIMITED.key, status: "active",
+      stripe_customer_id: "cus_2", stripe_subscription_id: "sub_2"
+
+    period_end = 30.days.from_now.to_i
+
+    post_event \
+      type: "customer.subscription.updated",
+      data: { object: {
+        id: "sub_2", customer: "cus_2", status: "past_due", current_period_end: period_end,
+        metadata: { account_id: @account.id, plan_key: Plan::UNLIMITED_PLUS.key } } }
+
+    assert_response :success
+
+    subscription = @account.reload.subscription
+    assert_equal "past_due", subscription.status
+    assert_equal Plan::UNLIMITED_PLUS, subscription.plan
+    assert_equal Time.at(period_end).utc.to_i, subscription.current_period_end.to_i
+    assert_equal 500.gigabytes, @account.storage_limit
+  end
+
+  test "deleted subscriptions drop the account back to free" do
+    @account.create_subscription! plan_key: Plan::UNLIMITED.key, status: "active",
+      stripe_customer_id: "cus_3", stripe_subscription_id: "sub_3"
+
+    post_event type: "customer.subscription.deleted", data: { object: { id: "sub_3", customer: "cus_3", status: "canceled" } }
+
+    assert_response :success
+    assert_equal Plan::FREE, @account.reload.plan
+    assert_equal 1_000, @account.card_limit
+  end
+
+  test "invoices record the next amount due" do
+    @account.create_subscription! plan_key: Plan::UNLIMITED.key, status: "active",
+      stripe_customer_id: "cus_4", stripe_subscription_id: "sub_4"
+
+    post_event type: "invoice.upcoming", data: { object: { customer: "cus_4", subscription: "sub_4", amount_due: 2000 } }
+
+    assert_response :success
+    assert_equal 2000, @account.reload.subscription.next_amount_due_in_cents
+  end
+
+  test "unknown events are acknowledged" do
+    post_event type: "customer.created", data: { object: { id: "cus_5" } }
+
+    assert_response :success
+  end
+
+  test "subscriptions created outside checkout are recorded" do
+    post_event \
+      type: "customer.subscription.created",
+      data: { object: {
+        id: "sub_new", customer: "cus_new", status: "active",
+        items: { data: [ { price: { id: Plan::UNLIMITED_PLUS.stripe_price_id } } ] },
+        metadata: { account_id: @account.id } } }
+
+    assert_response :success
+    assert_equal Plan::UNLIMITED_PLUS, @account.reload.subscription.plan
+    assert_equal "sub_new", @account.subscription.stripe_subscription_id
+  end
+
+  test "unsigned events are taken at face value in development and test" do
+    untenanted do
+      post "/stripe/webhooks",
+        params: { type: "customer.subscription.deleted", data: { object: { id: "sub_none" } } }.to_json,
+        headers: { "Content-Type" => "application/json" }
+    end
+
+    assert_response :success
+  end
+
+  test "unsigned requests are refused in production" do
+    Rails.stubs(:env).returns(ActiveSupport::EnvironmentInquirer.new("production"))
+
+    untenanted do
+      post "/stripe/webhooks", params: { type: "customer.subscription.deleted" }.to_json, headers: { "Content-Type" => "application/json" }
+    end
+
+    assert_response :bad_request
+  end
+
+  test "badly signed requests are refused"  do
+    Stripe::Webhook.stubs(:construct_event).raises(Stripe::SignatureVerificationError.new("nope", "t=1"))
+
+    untenanted do
+      post "/stripe/webhooks", params: "{}", headers: { "Stripe-Signature" => "bogus", "Content-Type" => "application/json" }
+    end
+
+    assert_response :bad_request
+  end
+
+  private
+    def post_event(event)
+      Stripe::Webhook.stubs(:construct_event).returns(event.with_indifferent_access)
+
+      untenanted do
+        post "/stripe/webhooks", params: event.to_json, headers: { "Stripe-Signature" => "signed", "Content-Type" => "application/json" }
+      end
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..8dd8f26
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "accounts start on the free plan" do
+    assert_equal Plan::FREE, @account.plan
+    assert_not @account.subscribed?
+    assert_equal 1_000, @account.card_limit
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "an active subscription brings its own plan and storage allowance" do
+    subscribe @account, plan: Plan::UNLIMITED
+
+    assert_equal Plan::UNLIMITED, @account.reload.plan
+    assert @account.subscribed?
+    assert_nil @account.card_limit
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "the bigger plan brings more storage" do
+    subscribe @account, plan: Plan::UNLIMITED_PLUS
+
+    assert_equal 500.gigabytes, @account.reload.storage_limit
+  end
+
+  test "a canceled subscription falls back to free" do
+    subscribe @account, plan: Plan::UNLIMITED, status: "canceled"
+
+    assert_equal Plan::FREE, @account.reload.plan
+    assert_not @account.subscribed?
+  end
+
+  test "comping lifts the limits" do
+    @account.comp
+
+    assert @account.comped?
+    assert_nil @account.card_limit
+    assert_equal 500.gigabytes, @account.storage_limit
+
+    @account.uncomp
+
+    assert_not @account.comped?
+    assert_equal 1_000, @account.card_limit
+  end
+
+  test "comping twice is harmless" do
+    @account.comp
+    assert_no_difference -> { Account::BillingWaiver.count } do
+      @account.comp
+    end
+  end
+
+  test "overriding limits and resetting them" do
+    @account.override_limits(card_count: 999, bytes_used: 2.gigabytes)
+
+    assert_equal 999, @account.cards_used
+    assert_equal 2.gigabytes, @account.storage_used
+    assert @account.exceeding_storage_limit?
+
+    @account.reset_overridden_limits
+
+    assert_equal @account.cards_count, @account.cards_used
+    assert_equal @account.bytes_used, @account.storage_used
+  end
+
+  test "storage exceptions still win over the plan allowance" do
+    @account.add_storage_exception 10.gigabytes
+
+    assert_equal 10.gigabytes, @account.storage_limit
+  end
+
+  test "canceling an account cancels its subscription at the end of the period" do
+    subscribe @account, plan: Plan::UNLIMITED
+
+    Stripe::Subscription.expects(:update).with(@account.subscription.stripe_subscription_id, cancel_at_period_end: true)
+
+    @account.cancel(initiated_by: @account.system_user)
+  end
+
+  test "incinerating an account cancels its subscription right away" do
+    subscribe @account, plan: Plan::UNLIMITED
+
+    Stripe::Subscription.expects(:cancel).with(@account.subscription.stripe_subscription_id)
+
+    @account.incinerate
+  end
+
+  test "canceling an account without a subscription does not reach Stripe" do
+    Stripe::Subscription.expects(:update).never
+
+    @account.cancel(initiated_by: @account.system_user)
+  end
+
+  private
+    def subscribe(account, plan:, status: "active")
+      account.create_subscription! plan_key: plan.key, status: status,
+        stripe_customer_id: "cus_#{SecureRandom.hex(4)}", stripe_subscription_id: "sub_#{SecureRandom.hex(4)}"
+    end
+end
diff --git a/saas/test/models/account/card_limited_test.rb b/saas/test/models/account/card_limited_test.rb
new file mode 100644
index 0000000..79e6c40
--- /dev/null
+++ b/saas/test/models/account/card_limited_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class Account::CardLimitedTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+  end
+
+  test "free accounts run out of cards at 1,000" do
+    @account.update_column :cards_count, 999
+    assert_not @account.exceeding_card_limit?
+    assert_equal 1, @account.cards_remaining
+
+    @account.update_column :cards_count, 1_000
+    assert @account.exceeding_card_limit?
+    assert_equal 0, @account.cards_remaining
+  end
+
+  test "the warning counts down from 100 cards out" do
+    @account.update_column :cards_count, 899
+    assert_not @account.nearing_card_limit?
+
+    @account.update_column :cards_count, 900
+    assert @account.nearing_card_limit?
+    assert_equal 100, @account.cards_remaining
+
+    @account.update_column :cards_count, 950
+    assert_equal 50, @account.cards_remaining
+  end
+
+  test "an exhausted account is not nearing the limit anymore" do
+    @account.update_column :cards_count, 1_200
+
+    assert @account.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+  end
+
+  test "paid accounts have no card limit" do
+    @account.create_subscription! plan_key: Plan::UNLIMITED.key, status: "active", stripe_customer_id: "cus_1"
+    @account.update_column :cards_count, 100_000
+
+    assert_not @account.reload.exceeding_card_limit?
+    assert_not @account.nearing_card_limit?
+    assert_nil @account.cards_remaining
+  end
+
+  test "overridden card counts drive the limit" do
+    @account.override_limits(card_count: 1_000, bytes_used: nil)
+
+    assert @account.exceeding_card_limit?
+  end
+end
