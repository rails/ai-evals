diff --git a/saas/app/controllers/stripe/webhooks_controller.rb b/saas/app/controllers/stripe/webhooks_controller.rb
new file mode 100644
index 0000000..3ea190f
--- /dev/null
+++ b/saas/app/controllers/stripe/webhooks_controller.rb
@@ -0,0 +1,40 @@
+# Stripe posts subscription changes here. Signed requests are verified against
+# the webhook signing secret; unsigned ones are only taken at face value in
+# development and test, where there is no Stripe to sign them.
+class Stripe::WebhooksController < ApplicationController
+  allow_unauthenticated_access
+  disallow_account_scope
+  skip_forgery_protection
+
+  before_action :set_event
+
+  def create
+    Billing::Event.new(@event).process
+
+    head :ok
+  end
+
+  private
+    def set_event
+      @event = verified_event or head :bad_request
+    end
+
+    def verified_event
+      if signature.present?
+        Stripe::Webhook.construct_event(payload, signature, Billing.webhook_secret)
+      elsif Rails.env.local?
+        JSON.parse(payload)
+      end
+    rescue JSON::ParserError, Stripe::SignatureVerificationError => error
+      Rails.error.report(error, handled: true)
+      nil
+    end
+
+    def payload
+      request.body.read
+    end
+
+    def signature
+      request.headers["Stripe-Signature"]
+    end
+end
diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..9f153dc
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,62 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, class_name: "Account::Subscription", dependent: :destroy
+    has_one :billing_waiver, class_name: "Account::BillingWaiver", dependent: :destroy
+    has_one :overridden_limit, class_name: "Account::OverriddenLimit", dependent: :destroy
+
+    set_callback :cancel, :after, -> { subscription&.cancel_later }
+    set_callback :incinerate, :before, -> { subscription&.cancel_now }
+  end
+
+  def plan
+    if comped?
+      Plan.comped
+    elsif subscribed?
+      subscription.plan
+    else
+      Plan.free
+    end
+  end
+
+  def subscribed?
+    subscription&.active? || false
+  end
+
+  def paying?
+    subscribed? && !comped?
+  end
+
+  def upgradable?
+    !comped? && plan != Plan::UNLIMITED_PLUS
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy
+    reload_billing_waiver
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    attributes = { card_count: card_count.presence, bytes_used: bytes_used.presence }
+
+    if overridden_limit
+      overridden_limit.update!(attributes)
+    else
+      create_overridden_limit!(attributes)
+    end
+  end
+
+  def reset_overridden_limits
+    overridden_limit&.destroy
+    reload_overridden_limit
+  end
+end
