diff --git a/saas/app/models/billing/checkout.rb b/saas/app/models/billing/checkout.rb
new file mode 100644
index 0000000..08f4e80
--- /dev/null
+++ b/saas/app/models/billing/checkout.rb
@@ -0,0 +1,42 @@
+# Hands an account off to Stripe's hosted checkout for one of the paid plans.
+class Billing::Checkout
+  attr_reader :account, :plan
+
+  def initialize(account:, plan:)
+    @account = account
+    @plan = plan
+  end
+
+  def url(success_url:, cancel_url:)
+    session(success_url: success_url, cancel_url: cancel_url).url
+  end
+
+  private
+    def session(success_url:, cancel_url:)
+      Stripe::Checkout::Session.create(**session_attributes(success_url: success_url, cancel_url: cancel_url))
+    end
+
+    def session_attributes(success_url:, cancel_url:)
+      {
+        mode: "subscription",
+        line_items: [ { price: plan.stripe_price_id, quantity: 1 } ],
+        client_reference_id: account.id,
+        success_url: success_url,
+        cancel_url: cancel_url,
+        metadata: metadata,
+        subscription_data: { metadata: metadata }
+      }.merge(customer_attributes)
+    end
+
+    def customer_attributes
+      if (customer_id = account.subscription&.stripe_customer_id).present?
+        { customer: customer_id }
+      else
+        { customer_email: account.owner_email }.compact
+      end
+    end
+
+    def metadata
+      { account_id: account.id, plan_key: plan.key }
+    end
+end
diff --git a/saas/app/models/billing/event.rb b/saas/app/models/billing/event.rb
new file mode 100644
index 0000000..4712265
--- /dev/null
+++ b/saas/app/models/billing/event.rb
@@ -0,0 +1,120 @@
+# Applies a Stripe webhook event to our mirror of the subscription.
+class Billing::Event
+  HANDLED_TYPES = %w[
+    checkout.session.completed
+    customer.subscription.created
+    customer.subscription.updated
+    customer.subscription.deleted
+    invoice.upcoming
+    invoice.paid
+    invoice.payment_succeeded
+  ].freeze
+
+  attr_reader :event
+
+  def initialize(event)
+    @event = normalize(event)
+  end
+
+  def type
+    event[:type]
+  end
+
+  def object
+    event.dig(:data, :object) || {}
+  end
+
+  def handled?
+    type.in?(HANDLED_TYPES)
+  end
+
+  def process
+    case type
+    when "checkout.session.completed"                         then complete_checkout
+    when "customer.subscription.created",
+         "customer.subscription.updated"                      then record_subscription
+    when "customer.subscription.deleted"                      then cancel_subscription
+    when "invoice.upcoming", "invoice.paid",
+         "invoice.payment_succeeded"                          then record_next_amount_due
+    end
+  end
+
+  private
+    def normalize(event)
+      hash = event.respond_to?(:to_hash) ? event.to_hash : event
+      hash.deep_symbolize_keys.with_indifferent_access
+    end
+
+    def complete_checkout
+      if account
+        subscription_for(account).update! \
+          stripe_customer_id: object[:customer],
+          stripe_subscription_id: object[:subscription],
+          plan_key: plan_key || Plan::UNLIMITED.key,
+          status: "active"
+      end
+    end
+
+    def record_subscription
+      if subscription = existing_subscription || (subscription_for(account) if account)
+        subscription.update! \
+          stripe_customer_id: object[:customer] || subscription.stripe_customer_id,
+          stripe_subscription_id: object[:id],
+          plan_key: plan_key || subscription.plan_key,
+          status: object[:status] || "active",
+          current_period_end: timestamp(current_period_end),
+          cancel_at: timestamp(object[:cancel_at])
+      end
+    end
+
+    def cancel_subscription
+      existing_subscription&.update! status: "canceled", cancel_at: nil, current_period_end: nil
+    end
+
+    def record_next_amount_due
+      if subscription = existing_subscription
+        subscription.update! next_amount_due_in_cents: object[:amount_due] || object[:amount_paid] || object[:total]
+      end
+    end
+
+    def existing_subscription
+      @existing_subscription ||= Account::Subscription.find_by(stripe_subscription_id: subscription_id) ||
+        Account::Subscription.find_by(stripe_customer_id: object[:customer])
+    end
+
+    def subscription_for(account)
+      account.subscription || account.build_subscription(stripe_customer_id: object[:customer], plan_key: Plan.free.key)
+    end
+
+    def subscription_id
+      if type.start_with?("customer.subscription")
+        object[:id]
+      else
+        object[:subscription]
+      end
+    end
+
+    def account
+      @account ||= Account.find_by(id: account_id) if account_id.present?
+    end
+
+    def account_id
+      object.dig(:metadata, :account_id) || object[:client_reference_id]
+    end
+
+    def plan_key
+      Plan.find_by_stripe_price_id(price_id)&.key || object.dig(:metadata, :plan_key).presence
+    end
+
+    def price_id
+      object.dig(:items, :data, 0, :price, :id) || object.dig(:plan, :id)
+    end
+
+    def current_period_end
+      object[:current_period_end] || object.dig(:items, :data, 0, :current_period_end)
+    end
+
+    def timestamp(seconds)
+      Time.at(seconds).utc if seconds.present?
+    end
+end
