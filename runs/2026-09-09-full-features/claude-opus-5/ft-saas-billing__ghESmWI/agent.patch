@@ -0,0 +1,84 @@
+require "test_helper"
+
+class Admin::AccountsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @account = accounts(:initech)
+    sign_in_as :david
+  end
+
+  test "index lists the accounts" do
+    untenanted do
+      get saas.admin_accounts_path
+
+      assert_response :success
+      assert_select "a[href=?]", saas.admin_account_path(@account), text: @account.name
+    end
+  end
+
+  test "non-staff cannot list the accounts" do
+    logout_and_sign_in_as :jz
+
+    untenanted { get saas.admin_accounts_path }
+
+    assert_response :forbidden
+  end
+
+  test "show has the support tools" do
+    untenanted { get saas.admin_account_path(@account) }
+
+    assert_response :success
+    assert_select "button", text: "Comp"
+    assert_select "label", text: "Card count"
+    assert_select "label", text: "Bytes used"
+    assert_select "button", text: "Override"
+    assert_select "button", text: "Reset"
+  end
+
+  test "comping and uncomping an account" do
+    untenanted do
+      post saas.admin_account_comp_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert @account.reload.comped?
+
+      get saas.admin_account_path(@account)
+      assert_select "button", text: "Uncomp"
+
+      delete saas.admin_account_comp_path(@account)
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_not @account.reload.comped?
+    end
+  end
+
+  test "overriding and resetting the limits" do
+    untenanted do
+      post saas.admin_account_overridden_limit_path(@account),
+        params: { overridden_limit: { card_count: 1_000, bytes_used: 2.gigabytes } }
+
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_equal 1_000, @account.reload.cards_used
+      assert_equal 2.gigabytes, @account.storage_used
+      assert @account.exceeding_card_limit?
+
+      patch saas.admin_account_overridden_limit_path(@account),
+        params: { overridden_limit: { card_count: 5, bytes_used: "" } }
+
+      assert_equal 5, @account.reload.cards_used
+      assert_nil @account.overridden_limit.bytes_used
+
+      delete saas.admin_account_overridden_limit_path(@account)
+
+      assert_redirected_to saas.admin_account_path(@account)
+      assert_nil @account.reload.overridden_limit
+      assert_not @account.exceeding_card_limit?
+    end
+  end
+
+  test "non-staff cannot comp an account" do
+    logout_and_sign_in_as :jz
+
+    untenanted { post saas.admin_account_comp_path(@account) }
+
+    assert_response :forbidden
+    assert_not @account.reload.comped?
+  end
+end
