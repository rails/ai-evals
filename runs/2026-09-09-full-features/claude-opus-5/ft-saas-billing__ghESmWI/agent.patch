+require "test_helper"
+
+class Account::BillingsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "admins see their plan and an upgrade in settings" do
+    get account_settings_path
+
+    assert_response :success
+    assert_select "a", text: "Upgrade"
+    assert_select "strong", text: Plan::FREE.name
+  end
+
+  test "members don't see the plan in settings" do
+    logout_and_sign_in_as :david
+
+    get account_settings_path
+
+    assert_response :success
+    assert_select "a", text: "Upgrade", count: 0
+  end
+
+  test "show lists the plans" do
+    get saas.account_billing_path
+
+    assert_response :success
+    Plan.all.each do |plan|
+      assert_select "strong", text: plan.name
+    end
+    assert_select "button", text: "Upgrade"
+  end
+
+  test "show requires an admin" do
+    logout_and_sign_in_as :david
+
+    get saas.account_billing_path
+
+    assert_response :forbidden
+  end
+
+  test "checkout redirects to Stripe" do
+    Stripe::Checkout::Session.expects(:create).with do |attributes|
+      attributes[:line_items].first[:price] == Plan::UNLIMITED.stripe_price_id &&
+        attributes[:client_reference_id] == Current.account.id
+    end.returns(stub(url: "https://checkout.stripe.com/c/pay/cs_test"))
+
+    post saas.account_billing_checkouts_path(plan: Plan::UNLIMITED.key)
+
+    assert_redirected_to "https://checkout.stripe.com/c/pay/cs_test"
+  end
+
+  test "checkout refuses unknown plans" do
+    post saas.account_billing_checkouts_path(plan: "gold")
+
+    assert_response :not_found
+  end
+
+  test "portal redirects to Stripe" do
+    Current.account.create_subscription! plan_key: Plan::UNLIMITED.key, status: "active", stripe_customer_id: "cus_portal"
+
+    Stripe::BillingPortal::Session.expects(:create).returns(stub(url: "https://billing.stripe.com/p/session"))
+
+    post saas.account_billing_portal_path
+
+    assert_redirected_to "https://billing.stripe.com/p/session"
+  end
+
+  test "portal needs a customer" do
+    post saas.account_billing_portal_path
+
+    assert_response :forbidden
+  end
+end
