+<% @page_title = "Plans and billing" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center">
+    <h2 class="divider txt-medium margin-block-start">Your plan</h2>
+
+    <p class="txt-small">
+      This account is on the <strong><%= @account.plan.name %></strong> plan,
+      using <strong><%= number_with_delimiter(@account.cards_used) %></strong>
+      <%= @account.card_limit ? "of #{number_with_delimiter(@account.card_limit)}" : "" %> cards
+      and <strong><%= number_to_human_size(@account.storage_used) %></strong>
+      of <%= number_to_human_size(@account.storage_limit) %> storage.
+    </p>
+
+    <% if @account.subscription.present? %>
+      <%= button_to "Manage billing", saas.account_billing_portal_path, class: "btn" %>
+    <% end %>
+
+    <h2 class="divider txt-medium margin-block-start">Plans</h2>
+
+    <ul class="list-style-none margin-none pad-none flex flex-column gap">
+      <% @plans.each do |plan| %>
+        <li class="flex align-center gap-half">
+          <div class="flex-item-grow">
+            <strong><%= plan.name %></strong>
+            <span class="txt-small">
+              <%= plan.paid? ? "$#{plan.price_in_dollars}/month" : "Free" %> •
+              <%= plan.unlimited_cards? ? "Unlimited cards" : "#{number_with_delimiter(plan.card_limit)} cards" %> •
+              <%= number_to_human_size(plan.storage_limit) %>
+            </span>
+          </div>
+
+          <% if plan == @account.plan %>
+            <span class="txt-small">Current plan</span>
+          <% elsif plan.paid? %>
+            <%= button_to "Upgrade", saas.account_billing_checkouts_path(plan: plan.key), class: "btn btn--reversed" %>
+          <% end %>
+        </li>
+      <% end %>
+    </ul>
+  </div>
+</div>
