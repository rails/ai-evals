diff --git a/saas/app/models/plan.rb b/saas/app/models/plan.rb
new file mode 100644
index 0000000..6c34055
--- /dev/null
+++ b/saas/app/models/plan.rb
@@ -0,0 +1,110 @@
+# The plans hosted Fizzy sells. Free is the plan every account starts on; the
+# paid ones are backed by a Stripe price, whose id comes from the environment
+# so each Stripe environment (development, staging, production) can point at
+# its own prices.
+class Plan
+  attr_reader :key, :name, :price_in_cents, :card_limit, :storage_limit, :stripe_price_id_variable
+
+  def initialize(key:, name:, storage_limit:, price_in_cents: 0, card_limit: nil, stripe_price_id_variable: nil)
+    @key = key
+    @name = name
+    @storage_limit = storage_limit
+    @price_in_cents = price_in_cents
+    @card_limit = card_limit
+    @stripe_price_id_variable = stripe_price_id_variable
+  end
+
+  FREE = new \
+    key: "free",
+    name: "Free",
+    price_in_cents: 0,
+    card_limit: 1_000,
+    storage_limit: 1.gigabyte
+
+  UNLIMITED = new \
+    key: "monthly_v1",
+    name: "Unlimited",
+    price_in_cents: 20_00,
+    storage_limit: 5.gigabytes,
+    stripe_price_id_variable: "STRIPE_MONTHLY_V1_PRICE_ID"
+
+  UNLIMITED_PLUS = new \
+    key: "monthly_extra_storage_v1",
+    name: "Unlimited+",
+    price_in_cents: 25_00,
+    storage_limit: 500.gigabytes,
+    stripe_price_id_variable: "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"
+
+  # Comped accounts don't pay and aren't limited.
+  COMPED = new \
+    key: "comped",
+    name: "Comped",
+    price_in_cents: 0,
+    storage_limit: 500.gigabytes
+
+  ALL = [ FREE, UNLIMITED, UNLIMITED_PLUS ].freeze
+  PAID = [ UNLIMITED, UNLIMITED_PLUS ].freeze
+
+  class << self
+    def all
+      ALL
+    end
+
+    def paid
+      PAID
+    end
+
+    def free
+      FREE
+    end
+
+    def comped
+      COMPED
+    end
+
+    def find(key)
+      ALL.find { |plan| plan.key == key.to_s } || (COMPED if key.to_s == COMPED.key)
+    end
+
+    def find_by_stripe_price_id(price_id)
+      PAID.find { |plan| plan.stripe_price_id.present? && plan.stripe_price_id == price_id }
+    end
+  end
+
+  def stripe_price_id
+    ENV[stripe_price_id_variable] if stripe_price_id_variable
+  end
+
+  def free?
+    self == FREE
+  end
+
+  def paid?
+    price_in_cents.positive?
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def price_in_dollars
+    price_in_cents / 100
+  end
+
+  def to_s
+    name
+  end
+
+  def to_param
+    key
+  end
+
+  def ==(other)
+    other.is_a?(Plan) && other.key == key
+  end
+  alias eql? ==
+
+  def hash
+    key.hash
+  end
+end
