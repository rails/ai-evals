diff --git a/app/models/webhook/delivery/attempt.rb b/app/models/webhook/delivery/attempt.rb
new file mode 100644
index 0000000..6c80ad2
--- /dev/null
+++ b/app/models/webhook/delivery/attempt.rb
@@ -0,0 +1,86 @@
+# Performs the HTTP POST for a delivery and reports back what the receiver said,
+# so the delivery log can show how it went.
+class Webhook::Delivery::Attempt
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+  OPEN_TIMEOUT = 5
+  READ_TIMEOUT = 10
+
+  TIMEOUT_ERRORS = [ Net::OpenTimeout, Net::ReadTimeout, Timeout::Error ].freeze
+  UNREACHABLE_ERRORS = [
+    SocketError, IOError, SystemCallError, URI::Error, OpenSSL::SSL::SSLError,
+    Net::HTTPBadResponse, Net::HTTPHeaderSyntaxError, Net::ProtocolError
+  ].freeze
+
+  attr_reader :delivery, :request, :response
+
+  delegate :webhook, :event, to: :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def perform
+    @request = { headers: headers }
+    @response = post
+    self
+  end
+
+  def state
+    if response[:error].present?
+      :errored
+    else
+      :completed
+    end
+  end
+
+  private
+    def headers
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => payload.content_type,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601,
+        "X-Webhook-Signature" => signature
+      }
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest "SHA256", webhook.signing_secret, payload.body
+    end
+
+    def payload
+      @payload ||= Webhook::Payload.new(webhook, event)
+    end
+
+    def post
+      if destination.blocked?
+        { error: "destination_unreachable" }
+      else
+        summarize http.post(uri.request_uri, payload.body, headers)
+      end
+    rescue *TIMEOUT_ERRORS
+      { error: "timeout" }
+    rescue *UNREACHABLE_ERRORS
+      { error: "destination_unreachable" }
+    end
+
+    def summarize(response)
+      { code: response.code.to_i, headers: response.each_header.to_h }
+    end
+
+    def http
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.ipaddr = destination.ip if destination.ip
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = OPEN_TIMEOUT
+        http.read_timeout = READ_TIMEOUT
+      end
+    end
+
+    def destination
+      @destination ||= Webhook::Destination.new(uri)
+    end
+
+    def uri
+      @uri ||= webhook.uri
+    end
+end
diff --git a/app/models/webhook/delivery/delivering.rb b/app/models/webhook/delivery/delivering.rb
new file mode 100644
index 0000000..8373a89
--- /dev/null
+++ b/app/models/webhook/delivery/delivering.rb
@@ -0,0 +1,26 @@
+# Sends the delivery to the receiver, exactly once. Claiming the delivery is an
+# atomic transition out of the pending state, so duplicate or retried jobs find
+# nothing left to send.
+module Webhook::Delivery::Delivering
+  extend ActiveSupport::Concern
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later self
+  end
+
+  def deliver_now
+    if webhook.active? && claim
+      record Webhook::Delivery::Attempt.new(self).perform
+    end
+  end
+
+  private
+    def claim
+      self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+    end
+
+    def record(attempt)
+      update! state: attempt.state, request: attempt.request, response: attempt.response
+      webhook.delivered self
+    end
+end
diff --git a/app/models/webhook/destination.rb b/app/models/webhook/destination.rb
new file mode 100644
index 0000000..c34ded9
--- /dev/null
+++ b/app/models/webhook/destination.rb
@@ -0,0 +1,47 @@
+# Works out where a webhook should be posted. Receivers are addressed by the
+# public IP their host resolves to, so a payload URL can't be aimed at an
+# address inside our own network.
+class Webhook::Destination
+  RESOLUTION_ERRORS = [ Resolv::ResolvError, Resolv::ResolvTimeout, SocketError, SystemCallError, IOError ].freeze
+
+  attr_reader :uri
+
+  def initialize(uri)
+    @uri = uri
+  end
+
+  def blocked?
+    addresses.any? && public_addresses.empty?
+  end
+
+  def ip
+    public_addresses.first
+  end
+
+  private
+    # A host that doesn't resolve has no address to vet, and nothing to connect
+    # to either, so it's left to fail on its own like any other bad destination.
+    def addresses
+      @addresses ||= resolved_addresses.presence || system_addresses
+    end
+
+    def public_addresses
+      @public_addresses ||= addresses
+        .reject { |address| SsrfProtection.blocked_address?(address) }
+        .sort_by { |address| address.include?(":") ? 1 : 0 }
+    end
+
+    def resolved_addresses
+      SsrfProtection.resolve_addresses uri.host
+    rescue *RESOLUTION_ERRORS
+      []
+    end
+
+    # The resolver Net::HTTP would use itself, consulted only when the public
+    # DNS servers are unavailable.
+    def system_addresses
+      Addrinfo.getaddrinfo(uri.host, uri.port, nil, :STREAM).map(&:ip_address)
+    rescue *RESOLUTION_ERRORS
+      []
+    end
+end
diff --git a/app/models/webhook/payload.rb b/app/models/webhook/payload.rb
new file mode 100644
index 0000000..3ba7df9
--- /dev/null
+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,79 @@
+# Builds the body we POST to a receiver: the full event as JSON, or a chat
+# message when the URL points at Slack, Campfire, or Basecamp.
+class Webhook::Payload
+  attr_reader :webhook, :event
+
+  def initialize(webhook, event)
+    @webhook = webhook
+    @event = event
+  end
+
+  def content_type
+    if webhook.for_campfire?
+      "text/html"
+    else
+      "application/json"
+    end
+  end
+
+  def body
+    @body ||=
+      if webhook.for_slack?
+        { text: message_text }.to_json
+      elsif webhook.for_basecamp?
+        { content: message_html }.to_json
+      elsif webhook.for_campfire?
+        message_html
+      else
+        event_json
+      end
+  end
+
+  private
+    def message_text
+      [ description, eventable_url ].compact.join(" ")
+    end
+
+    def description
+      CGI.unescapeHTML event.description_for(nil).to_plain_text
+    end
+
+    def eventable_url
+      Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **url_options) if event.eventable
+    end
+
+    def message_html
+      render formats: :html
+    end
+
+    def event_json
+      render formats: :json
+    end
+
+    def render(formats:)
+      renderer.render template: "webhooks/event", formats: formats, assigns: { event: event }
+    end
+
+    def renderer
+      @renderer ||= ApplicationController.renderer.new \
+        http_host: http_host, https: url_options[:protocol].to_s == "https", script_name: account.slug
+    end
+
+    def http_host
+      [ url_options[:host], url_options[:port] ].compact.join(":")
+    end
+
+    def url_options
+      @url_options ||= default_url_options.merge(script_name: account.slug)
+    end
+
+    def account
+      webhook.board.account
+    end
+
+    def default_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+end
