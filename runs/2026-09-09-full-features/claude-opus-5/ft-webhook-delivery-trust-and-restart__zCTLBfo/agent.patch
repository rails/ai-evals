diff --git a/app/models/event/relaying.rb b/app/models/event/relaying.rb
new file mode 100644
index 0000000..9ac64e5
--- /dev/null
+++ b/app/models/event/relaying.rb
@@ -0,0 +1,25 @@
+# Relays events to the board's webhooks. Each subscribed webhook gets its own
+# delivery record, which is what guarantees a single POST per event: deliveries
+# are unique per webhook and event, and only a pending one can be sent.
+module Event::Relaying
+  extend ActiveSupport::Concern
+
+  included do
+    has_many :webhook_deliveries, class_name: "Webhook::Delivery", dependent: :delete_all
+
+    after_create_commit :relay_later
+  end
+
+  def relay_later
+    Event::RelayJob.perform_later self
+  end
+
+  def relay_now
+    webhooks_to_relay.each { |webhook| webhook.deliver_later self }
+  end
+
+  private
+    def webhooks_to_relay
+      board.webhooks.active.subscribed_to(action)
+    end
+end
