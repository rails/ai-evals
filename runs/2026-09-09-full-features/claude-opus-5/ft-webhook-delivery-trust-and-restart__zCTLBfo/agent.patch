@@ -0,0 +1,70 @@
+require "test_helper"
+
+class Webhook::PayloadTest < ActiveSupport::TestCase
+  test "events are posted as JSON" do
+    payload = Webhook::Payload.new(webhooks(:active), events(:logo_published))
+
+    assert_equal "application/json", payload.content_type
+
+    body = JSON.parse(payload.body)
+    assert_equal events(:logo_published).id, body["id"]
+    assert_equal "card_published", body["action"]
+    assert_equal cards(:logo).title, body.dig("eventable", "title")
+    assert_equal boards(:writebook).name, body.dig("board", "name")
+    assert_equal users(:david).name, body.dig("creator", "name")
+  end
+
+  test "comment events are posted as JSON" do
+    payload = Webhook::Payload.new(webhooks(:active), events(:layout_commented))
+
+    body = JSON.parse(payload.body)
+    assert_equal "comment_created", body["action"]
+    assert_equal events(:layout_commented).eventable_id, body.dig("eventable", "id")
+  end
+
+  test "Slack gets a message" do
+    payload = Webhook::Payload.new(slack_webhook, events(:logo_published))
+
+    assert_equal "application/json", payload.content_type
+
+    body = JSON.parse(payload.body)
+    assert_includes body["text"], users(:david).name
+    assert_includes body["text"], cards(:logo).title
+    assert_includes body["text"], "/cards/#{cards(:logo).number}"
+  end
+
+  test "Campfire gets an HTML message" do
+    payload = Webhook::Payload.new(campfire_webhook, events(:logo_published))
+
+    assert_equal "text/html", payload.content_type
+    assert_includes payload.body, users(:david).name
+    assert_includes payload.body, "/cards/#{cards(:logo).number}"
+  end
+
+  test "Basecamp gets a chat line" do
+    payload = Webhook::Payload.new(basecamp_webhook, events(:logo_published))
+
+    assert_equal "application/json", payload.content_type
+
+    body = JSON.parse(payload.body)
+    assert_includes body["content"], users(:david).name
+    assert_includes body["content"], "/cards/#{cards(:logo).number}"
+  end
+
+  private
+    def slack_webhook
+      build_webhook "https://hooks.slack.com/services/T12345678/B12345678/abcdefghijklmnopqrstuvwx" # gitleaks:allow
+    end
+
+    def campfire_webhook
+      build_webhook "https://chat.example.com/rooms/123/456-bot-key/messages"
+    end
+
+    def basecamp_webhook
+      build_webhook "https://3.basecamp.com/999/integrations/token/buckets/111/chats/222/lines"
+    end
+
+    def build_webhook(url)
+      Webhook.new name: "Chat", url: url, board: boards(:writebook), signing_secret: "secret"
+    end
+end
