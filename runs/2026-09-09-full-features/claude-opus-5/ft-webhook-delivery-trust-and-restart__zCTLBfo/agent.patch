diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..94d06ad
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,53 @@
+# Keeps score of how a webhook's receiver is behaving so we can switch off the
+# ones that keep failing. A receiver that fails MAX_CONSECUTIVE_FAILURES times
+# in a row within FAILURE_WINDOW is deactivated. Any success, or a failure that
+# arrives after the window has closed, starts the count over.
+class Webhook::DelinquencyTracker < ApplicationRecord
+  MAX_CONSECUTIVE_FAILURES = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def track(delivery)
+    if delivery.failed?
+      track_failure
+    else
+      track_success
+    end
+  end
+
+  def track_failure
+    record_failure
+    webhook.deactivate if delinquent?
+  end
+
+  def track_success
+    reset
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil unless never_failed?
+  end
+
+  def delinquent?
+    consecutive_failures_count >= MAX_CONSECUTIVE_FAILURES && within_failure_window?
+  end
+
+  private
+    def record_failure
+      if within_failure_window?
+        update! consecutive_failures_count: consecutive_failures_count + 1
+      else
+        update! consecutive_failures_count: 1, first_failure_at: Time.current
+      end
+    end
+
+    def within_failure_window?
+      first_failure_at.present? && first_failure_at > FAILURE_WINDOW.ago
+    end
+
+    def never_failed?
+      consecutive_failures_count.to_i.zero? && first_failure_at.nil?
+    end
+end
