@@ -0,0 +1,59 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  test "creating an event enqueues a relay" do
+    assert_enqueued_with job: Event::RelayJob do
+      create_event action: "card_published"
+    end
+  end
+
+  test "relay_now creates a delivery for every subscribed active webhook" do
+    event = create_event action: "card_published"
+
+    assert_difference -> { webhooks(:active).deliveries.count }, +1 do
+      event.relay_now
+    end
+
+    delivery = webhooks(:active).deliveries.find_by(event: event)
+    assert delivery.pending?
+    assert_enqueued_with job: Webhook::DeliveryJob, args: [ delivery ]
+  end
+
+  test "relay_now skips webhooks that aren't subscribed to the action" do
+    event = create_event action: "card_triaged"
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.relay_now
+    end
+  end
+
+  test "relay_now skips deactivated webhooks" do
+    webhooks(:active).deactivate
+    event = create_event action: "card_published"
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.relay_now
+    end
+  end
+
+  test "relay_now skips webhooks on other boards" do
+    event = create_event action: "card_published", board: boards(:private)
+
+    assert_no_difference -> { Webhook::Delivery.count } do
+      event.relay_now
+    end
+  end
+
+  test "relay_now delivers an event exactly once" do
+    event = create_event action: "card_published"
+
+    assert_difference -> { Webhook::Delivery.count }, +1 do
+      2.times { event.relay_now }
+    end
+  end
+
+  private
+    def create_event(action:, board: boards(:writebook))
+      Event.create! board: board, creator: users(:david), eventable: cards(:logo), action: action
+    end
+end
