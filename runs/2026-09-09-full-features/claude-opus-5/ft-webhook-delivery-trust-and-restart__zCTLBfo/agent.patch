@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "webhooks track delinquency from the start" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+
+    assert webhook.delinquency_tracker.present?
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "tracking a successful delivery resets the count" do
+    @tracker.update! consecutive_failures_count: 3, first_failure_at: 10.minutes.ago
+
+    @tracker.track webhook_deliveries(:successfully_completed)
+
+    assert_equal 0, @tracker.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+    assert @webhook.reload.active?
+  end
+
+  test "tracking failures counts them within the window" do
+    @tracker.track webhook_deliveries(:errored)
+    assert_equal 1, @tracker.consecutive_failures_count
+    assert @tracker.first_failure_at.present?
+
+    @tracker.track webhook_deliveries(:unsuccessfully_completed)
+    assert_equal 2, @tracker.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "ten failures in a row within an hour deactivates the webhook" do
+    9.times { @tracker.track_failure }
+
+    assert @webhook.reload.active?
+
+    assert_changes -> { @webhook.reload.active? }, from: true, to: false do
+      @tracker.track_failure
+    end
+
+    assert @tracker.delinquent?
+  end
+
+  test "failures spread beyond the window start the count over" do
+    9.times { @tracker.track_failure }
+    @tracker.update! first_failure_at: 2.hours.ago
+
+    @tracker.track_failure
+
+    assert_equal 1, @tracker.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "a success in between spares the webhook" do
+    9.times { @tracker.track_failure }
+    @tracker.track_success
+    5.times { @tracker.track_failure }
+
+    assert_equal 5, @tracker.consecutive_failures_count
+    assert @webhook.reload.active?
+  end
+
+  test "reactivating a webhook forgives past failures" do
+    webhook = webhooks(:inactive)
+
+    webhook.activate
+
+    assert webhook.active?
+    assert_equal 0, webhook.delinquency_tracker.reload.consecutive_failures_count
+    assert_nil webhook.delinquency_tracker.first_failure_at
+  end
+end
