@@ -0,0 +1,61 @@
+require "test_helper"
+
+class WebhookDeliveryTest < ActiveSupport::TestCase
+  setup do
+    stub_dns_resolution "93.184.216.34"
+
+    @webhook = webhooks(:active)
+    @request = stub_request(:post, @webhook.url).with { |request| @posted_body = request.body }.to_return(status: 200)
+
+    Current.user = users(:david)
+  end
+
+  test "an event is relayed to the board's webhooks" do
+    card = cards(:logo)
+
+    assert_difference -> { @webhook.deliveries.count }, +1 do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        card.close
+      end
+    end
+
+    assert_requested @request
+
+    delivery = @webhook.deliveries.ordered.first
+    assert_equal "card_closed", delivery.event.action
+    assert delivery.succeeded?
+    assert_equal 200, delivery.response[:code]
+
+    payload = JSON.parse(@posted_body)
+    assert_equal "card_closed", payload["action"]
+    assert_equal card.id, payload.dig("eventable", "id")
+  end
+
+  test "an event isn't relayed twice" do
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      cards(:logo).close
+    end
+
+    event = @webhook.deliveries.ordered.first.event
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+        event.relay_now
+      end
+    end
+
+    assert_requested @request, times: 1
+  end
+
+  test "a receiver that keeps failing is switched off" do
+    stub_request(:post, @webhook.url).to_return(status: 503)
+    @webhook.delinquency_tracker.update! consecutive_failures_count: 9, first_failure_at: 5.minutes.ago
+
+    perform_enqueued_jobs only: [ Event::RelayJob, Webhook::DeliveryJob ] do
+      cards(:logo).close
+    end
+
+    assert_not @webhook.reload.active?
+    assert @webhook.deliveries.ordered.first.failed?
+  end
+end
