@@ -0,0 +1,139 @@
+require "test_helper"
+
+class Webhook::DeliveringTest < ActiveSupport::TestCase
+  setup do
+    stub_dns_resolution "93.184.216.34"
+
+    @delivery = webhook_deliveries(:pending)
+    @webhook = @delivery.webhook
+  end
+
+  test "deliver_now posts the payload and logs the response" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    @delivery.deliver_now
+
+    assert_requested request
+    assert @delivery.reload.completed?
+    assert @delivery.succeeded?
+    assert_equal 200, @delivery.response[:code]
+    assert_equal "fizzy/1.0.0 Webhook", @delivery.request[:headers]["User-Agent"]
+    assert_equal "application/json", @delivery.request[:headers]["Content-Type"]
+    assert_equal @delivery.event.created_at.utc.iso8601, @delivery.request[:headers]["X-Webhook-Timestamp"]
+  end
+
+  test "deliver_now signs the payload with the webhook's secret" do
+    body = nil
+    stub_request(:post, @webhook.url).to_return(status: 200).with { |request| body = request.body }
+
+    @delivery.deliver_now
+
+    expected = OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, body)
+    assert_equal expected, @delivery.reload.request[:headers]["X-Webhook-Signature"]
+    assert_equal @delivery.event.id, JSON.parse(body)["id"]
+  end
+
+  test "deliver_now posts to a pinned public address" do
+    request = stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 204)
+
+    @delivery.deliver_now
+
+    assert_requested request
+    assert @delivery.reload.succeeded?
+  end
+
+  test "deliver_now delivers exactly once" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    3.times { @delivery.deliver_now }
+
+    assert_requested request, times: 1
+  end
+
+  test "deliver_now doesn't deliver a delivery claimed elsewhere" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+    @delivery.update! state: :in_progress
+
+    @delivery.deliver_now
+
+    assert_not_requested request
+    assert @delivery.reload.in_progress?
+  end
+
+  test "deliver_now logs an unsuccessful response" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+
+    @delivery.deliver_now
+
+    assert @delivery.reload.completed?
+    assert @delivery.failed?
+    assert_equal 500, @delivery.response[:code]
+    assert_equal 1, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+
+  test "deliver_now logs an unreachable destination" do
+    stub_dns_resolution "10.0.0.1"
+    request = stub_request(:post, @webhook.url)
+
+    @delivery.deliver_now
+
+    assert_not_requested request
+    assert @delivery.reload.errored?
+    assert @delivery.failed?
+    assert_equal "destination_unreachable", @delivery.response[:error]
+  end
+
+  test "deliver_now logs a timeout" do
+    stub_request(:post, @webhook.url).to_timeout
+
+    @delivery.deliver_now
+
+    assert @delivery.reload.errored?
+    assert_equal "timeout", @delivery.response[:error]
+  end
+
+  test "deliver_now deactivates a webhook that keeps failing" do
+    stub_request(:post, @webhook.url).to_return(status: 500)
+    @webhook.delinquency_tracker.update! consecutive_failures_count: 9, first_failure_at: 10.minutes.ago
+
+    @delivery.deliver_now
+
+    assert_not @webhook.reload.active?
+  end
+
+  test "deliver_now skips a webhook that was switched off" do
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+    @webhook.deactivate
+
+    @delivery.deliver_now
+
+    assert_not_requested request
+    assert @delivery.reload.pending?
+  end
+
+  test "deliver_now posts by name when the destination can't be resolved" do
+    Resolv::DNS.unstub(:open)
+    request = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    @delivery.deliver_now
+
+    assert_requested request
+    assert @delivery.reload.succeeded?
+  end
+
+  test "deliver_later enqueues the delivery" do
+    assert_enqueued_with job: Webhook::DeliveryJob, args: [ @delivery ] do
+      @delivery.deliver_later
+    end
+  end
+
+  test "cleanup keeps a week of deliveries" do
+    fresh = Webhook::Delivery.create! webhook: @webhook, event: events(:layout_commented), created_at: 2.days.ago
+    stale = Webhook::Delivery.create! webhook: @webhook, event: events(:logo_assignment_david), created_at: 8.days.ago
+
+    Webhook::Delivery.cleanup
+
+    assert Webhook::Delivery.exists?(fresh.id)
+    assert_not Webhook::Delivery.exists?(stale.id)
+  end
+end
