+require "test_helper"
+
+class Webhook::DestinationTest < ActiveSupport::TestCase
+  test "addresses the public IP a host resolves to" do
+    stub_dns_resolution "93.184.216.34"
+
+    destination = destination_for("https://api.example.com/webhooks")
+
+    assert_not destination.blocked?
+    assert_equal "93.184.216.34", destination.ip
+  end
+
+  test "prefers an IPv4 address" do
+    stub_dns_resolution "2606:2800:220:1:248:1893:25c8:1946", "93.184.216.34"
+
+    assert_equal "93.184.216.34", destination_for("https://api.example.com/webhooks").ip
+  end
+
+  test "blocks a host that only resolves to internal addresses" do
+    stub_dns_resolution "10.0.0.1", "127.0.0.1"
+
+    destination = destination_for("https://api.example.com/webhooks")
+
+    assert destination.blocked?
+    assert_nil destination.ip
+  end
+
+  test "blocks an internal address given as the host" do
+    destination = destination_for("http://169.254.169.254/latest/meta-data")
+
+    assert destination.blocked?
+    assert_nil destination.ip
+  end
+
+  test "a host that doesn't resolve isn't blocked, just unreachable" do
+    destination = destination_for("https://nowhere.invalid/webhooks")
+
+    assert_not destination.blocked?
+    assert_nil destination.ip
+  end
+
+  private
+    def destination_for(url)
+      Webhook::Destination.new URI.parse(url)
+    end
+end
