+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @card = cards(:logo)
+  end
+
+  test "show a card of a published board" do
+    get public_board_card_path(@board.public_key, @card)
+
+    assert_response :success
+    assert_select "h1", /The logo isn't big enough/
+  end
+
+  test "drafted cards aren't public" do
