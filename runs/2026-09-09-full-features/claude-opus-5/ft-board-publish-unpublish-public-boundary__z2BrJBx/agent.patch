diff --git a/app/controllers/public/boards_controller.rb b/app/controllers/public/boards_controller.rb
new file mode 100644
index 0000000..314dbac
--- /dev/null
+++ b/app/controllers/public/boards_controller.rb
@@ -0,0 +1,16 @@
+class Public::BoardsController < PublicController
+  CARDS_PER_COLUMN = 15
+
+  def show
+    @columns = @board.columns.sorted
+    @stream_cards = public_cards_in(@board.cards.awaiting_triage)
+    @cards_by_column = @columns.index_with { |column| public_cards_in(column.cards.active) }
+
+    fresh_when etag: [ @board, @stream_cards, @cards_by_column.values ]
+  end
+
+  private
+    def public_cards_in(cards)
+      cards.latest.with_golden_first.preloaded.limit(CARDS_PER_COLUMN).to_a
+    end
+end
