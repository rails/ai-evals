+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "admins can publish a board" do
+    sign_in_as :kevin
+
+    post board_publication_path(@board)
+
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+    assert @board.public_key.present?
+  end
+
+  test "admins can unpublish a board" do
+    sign_in_as :kevin
+    @board.publish
+
+    delete board_publication_path(@board)
+
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "non-admins can't publish a board" do
+    sign_in_as :david
+
+    post board_publication_path(@board)
+
+    assert_response :forbidden
+    assert_not @board.reload.published?
+  end
+
+  test "non-admins can't unpublish a board" do
+    sign_in_as :david
+    @board.publish
+
+    delete board_publication_path(@board)
+
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+
+  test "publishing via json returns the board with its public url" do
+    sign_in_as :kevin
+
+    post board_publication_path(@board, format: :json)
+
+    assert_response :created
+    assert_equal public_board_url(@board.reload.public_key), response.parsed_body["public_url"]
+  end
+
+  test "unpublishing via json" do
+    sign_in_as :kevin
+    @board.publish
+
+    delete board_publication_path(@board, format: :json)
+
+    assert_response :no_content
+    assert_not @board.reload.published?
+  end
+
+  test "publishing twice keeps the same key" do
+    sign_in_as :kevin
+
+    post board_publication_path(@board)
+    key = @board.reload.public_key
+
+    post board_publication_path(@board)
+    assert_equal key, @board.reload.public_key
+  end
+
+  test "board settings offer publishing to admins" do
+    sign_in_as :kevin
+
+    get edit_board_path(@board)
+
+    assert_response :success
+    assert_select "form[action=?]", board_publication_path(@board)
+  end
+
+  test "board settings don't offer publishing to non-admins" do
+    sign_in_as :david
+
+    get edit_board_path(@board)
+
+    assert_response :success
+    assert_select "form[action=?]", board_publication_path(@board), false
+  end
+
+  test "board settings show the public url of a published board" do
+    sign_in_as :kevin
+    @board.publish
+
+    get edit_board_path(@board)
+
+    assert_response :success
+    assert_select "input[value=?]", public_board_url(@board.public_key)
+  end
+end
