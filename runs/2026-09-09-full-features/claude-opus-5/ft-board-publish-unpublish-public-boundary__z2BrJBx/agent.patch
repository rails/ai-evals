diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..9d1ad30
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,45 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards aren't published by default" do
+    assert_not @board.published?
+    assert_nil @board.public_key
+    assert_nil @board.public_url
+  end
+
+  test "publishing generates a public key" do
+    @board.publish
+
+    assert @board.published?
+    assert @board.public_key.present?
+    assert_includes Board.published, @board
+  end
+
+  test "publishing an already published board keeps its key" do
+    @board.publish
+    key = @board.public_key
+
+    @board.publish
+
+    assert_equal key, @board.reload.public_key
+  end
+
+  test "unpublishing removes the public key" do
+    @board.publish
+    @board.unpublish
+
+    assert_not @board.published?
+    assert_nil @board.reload.public_key
+    assert_not_includes Board.published, @board
+  end
+
+  test "public url is tenanted" do
+    @board.publish
+
+    assert_equal "http://example.com#{@board.account.slug}/public/boards/#{@board.public_key}", @board.public_url
+  end
+end
