diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..45616e5
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,43 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  PUBLIC_KEY_LENGTH = 24
+
+  included do
+    scope :published, -> { where.not(public_key: nil) }
+  end
+
+  def publish
+    update!(public_key: generate_public_key) unless published?
+    self
+  end
+
+  def unpublish
+    update!(public_key: nil)
+  end
+
+  def published?
+    public_key.present?
+  end
+
+  def public_url(**options)
+    if published?
+      Rails.application.routes.url_helpers.public_board_url(public_key, **url_options, **options)
+    end
+  end
+
+  private
+    def generate_public_key
+      loop do
+        candidate = SecureRandom.base58(PUBLIC_KEY_LENGTH)
+        break candidate unless account.boards.exists?(public_key: candidate)
+      end
+    end
+
+    def url_options
+      base_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options || {}
+
+      base_options.merge(script_name: account.slug)
+    end
+end
