+# Multi-tenancy was rolled out on the core tables only: everything else relied
+# on walking associations to find the account a row belonged to. This finishes
+# the job so every table holding an account's data carries its own account_id,
+# required and indexed. Rows that can no longer be traced back to an account are
+# orphans and get dropped.
+#
+# Left untenanted on purpose:
+#
+#   * accounts, account_external_id_sequences: the tenants and their id sequence.
+#   * identities, identity_access_tokens, magic_links, sessions,
+#     action_pack_passkeys: global identity and authentication records, shared by
+#     an identity across all of its accounts.
+#   * the filters habtm join tables: both sides are tenanted already, and Active
+#     Record inserts those rows without a model to default the account from.
+class FinishAccountIdRollout < ActiveRecord::Migration[8.2]
+  # Tables that already have an account_id column, paired with the association
+  # used to backfill the rows that are still missing one. Ordered so parents are
+  # cleaned up before their children.
+  EXISTING = [
+    [ "users",                nil ],
+    [ "tags",                 nil ],
+    [ "account_join_codes",   nil ],
+    [ "account_imports",      nil ],
+    [ "boards",               [ "users", "creator_id" ] ],
+    [ "columns",              [ "boards", "board_id" ] ],
+    [ "webhooks",             [ "boards", "board_id" ] ],
+    [ "events",               [ "boards", "board_id" ] ],
+    [ "cards",                [ "boards", "board_id" ] ],
+    [ "comments",             [ "cards", "card_id" ] ],
+    [ "steps",                [ "cards", "card_id" ] ],
+    [ "filters",              [ "users", "creator_id" ] ],
+    [ "notifications",        [ "users", "user_id" ] ],
+    [ "notification_bundles", [ "users", "user_id" ] ],
+    [ "push_subscriptions",   [ "users", "user_id" ] ]
+  ].freeze
+
+  # Tables getting a brand new account_id, backfilled from a single association.
+  NEW = [
+    [ "accesses",                     [ "boards", "board_id" ] ],
+    [ "board_publications",           [ "boards", "board_id" ] ],
+    [ "webhook_deliveries",           [ "webhooks", "webhook_id" ] ],
+    [ "webhook_delinquency_trackers", [ "webhooks", "webhook_id" ] ],
+    [ "assignments",                  [ "cards", "card_id" ] ],
+    [ "taggings",                     [ "cards", "card_id" ] ],
+    [ "watches",                      [ "cards", "card_id" ] ],
+    [ "pins",                         [ "cards", "card_id" ] ],
+    [ "closures",                     [ "cards", "card_id" ] ],
+    [ "card_goldnesses",              [ "cards", "card_id" ] ],
+    [ "card_not_nows",                [ "cards", "card_id" ] ],
+    [ "card_activity_spikes",         [ "cards", "card_id" ] ],
+    [ "user_settings",                [ "users", "user_id" ] ],
+    [ "search_queries",               [ "users", "user_id" ] ]
+  ].freeze
+
+  # Tables getting a brand new account_id, backfilled through a polymorphic
+  # association: the owner type decides which table to read the account from.
+  POLYMORPHIC = [
+    [ "entropies",      "container",  { "Account" => "accounts", "Board" => "boards" } ],
+    [ "storage_totals", "owner",      { "Account" => "accounts", "Board" => "boards" } ],
+    [ "mentions",       "source",     { "Card" => "cards", "Comment" => "comments" } ],
+    [ "reactions",      "reactable",  { "Card" => "cards", "Comment" => "comments" } ]
+  ].freeze
+
+  # Attachments hang off both domain records and Active Storage's own variant
+  # records, so their account is resolved in two passes (see #up).
+  ATTACHMENT_RECORDS = {
+    "Card" => "cards",
+    "Comment" => "comments",
+    "Board" => "boards",
+    "User" => "users",
+    "Export" => "exports",
+    "Account::Import" => "account_imports",
+    "ActionText::RichText" => "action_text_rich_texts",
+    "ActiveStorage::VariantRecord" => "active_storage_variant_records"
+  }.freeze
+
