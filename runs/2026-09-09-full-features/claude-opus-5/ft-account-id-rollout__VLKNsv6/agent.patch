+    def backfill_from_parent(table, parent_table, foreign_key)
+      execute <<~SQL.squish
+        UPDATE #{table}
+        SET account_id = (
+          SELECT #{account_id_column(parent_table)} FROM #{parent_table}
+          WHERE #{parent_table}.id = #{table}.#{foreign_key}
+        )
+        WHERE #{table}.account_id IS NULL
+      SQL
+    end
+
+    def backfill_from_polymorphic_parent(table, association, records)
+      records.each do |record_type, parent_table|
+        execute <<~SQL.squish
+          UPDATE #{table}
+          SET account_id = (
+            SELECT #{account_id_column(parent_table)} FROM #{parent_table}
+            WHERE #{parent_table}.id = #{table}.#{association}_id
+          )
+          WHERE #{table}.account_id IS NULL
+            AND #{table}.#{association}_type = #{quote(record_type)}
+        SQL
+      end
+    end
+
+    def backfill_attachments
+      backfill_from_polymorphic_parent "active_storage_attachments", "record", ATTACHMENT_RECORDS
+    end
+
+    def backfill_blobs
+      execute <<~SQL.squish
+        UPDATE active_storage_blobs
+        SET account_id = (
+          SELECT active_storage_attachments.account_id FROM active_storage_attachments
+          WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+            AND active_storage_attachments.account_id IS NOT NULL
+          LIMIT 1
+        )
+        WHERE active_storage_blobs.account_id IS NULL
+      SQL
+    end
+
+    def backfill_variant_records
+      backfill_from_parent "active_storage_variant_records", "active_storage_blobs", "blob_id"
+    end
+
+    # Rows we couldn't trace back to a live account are orphans: drop them, then
+    # lock the column down and index it.
+    def require_account_id(table)
+      drop_orphans table
+      change_column_null table, :account_id, false
+      add_index table, :account_id unless indexed_by_account_id?(table)
+    end
+
+    def drop_orphans(table)
+      execute <<~SQL.squish
+        DELETE FROM #{table}
+        WHERE #{table}.account_id IS NULL
+          OR NOT EXISTS (SELECT 1 FROM accounts WHERE accounts.id = #{table}.account_id)
+      SQL
+    end
