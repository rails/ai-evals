+    add_account_id "action_text_rich_texts"
+    backfill_from_polymorphic_parent "action_text_rich_texts", "record", RICH_TEXT_RECORDS
+    require_account_id "action_text_rich_texts"
+
+    add_account_id "active_storage_attachments"
+    add_account_id "active_storage_blobs"
+    add_account_id "active_storage_variant_records"
+
+    # Domain records first, then their blobs, then the variants derived from
+    # those blobs, then the attachments and blobs of the variants themselves.
+    backfill_attachments
+    backfill_blobs
+    backfill_variant_records
+    backfill_attachments
+    backfill_blobs
+
+    require_account_id "active_storage_attachments"
+    require_account_id "active_storage_blobs"
+    require_account_id "active_storage_variant_records"
