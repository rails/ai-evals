diff --git a/test/models/account/multi_tenancy_test.rb b/test/models/account/multi_tenancy_test.rb
new file mode 100644
index 0000000..39e3299
--- /dev/null
+++ b/test/models/account/multi_tenancy_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+
+class Account::MultiTenancyTest < ActiveSupport::TestCase
+  # Rows that don't belong to a single account: the accounts themselves, the
+  # global identity/session records shared across accounts, and Rails' own
+  # bookkeeping.
+  GLOBAL_TABLES = %w[
+    account_external_id_sequences
+    accounts
+    action_pack_passkeys
+    ar_internal_metadata
+    identities
+    identity_access_tokens
+    magic_links
+    schema_migrations
+    sessions
+  ].freeze
+
+  # Habtm join tables only pair two records that are tenanted already, and
+  # Active Record inserts their rows without going through a model.
+  JOIN_TABLES = %w[
+    assignees_filters
+    assigners_filters
+    boards_filters
+    closers_filters
+    creators_filters
+    filters_tags
+  ].freeze
+
+  test "every table holding an account's data has a required account_id" do
+    tenanted_tables.each do |table|
+      account_id = connection.columns(table).find { |column| column.name == "account_id" }
+
+      assert account_id, "#{table} has no account_id column"
+      assert_not account_id.null, "#{table}.account_id must be required"
+    end
+  end
+
+  test "every account_id is indexed" do
+    tenanted_tables.each do |table|
+      assert connection.indexes(table).any? { |index| Array(index.columns).first == "account_id" },
+        "#{table}.account_id must be indexed"
+    end
+  end
+
+test "tenanted records get their account from their parent" do
+  board = boards(:writebook)
+  card = cards(:radio)
+
+  assert_equal board.account, assigned_account(Access.new(board: board, user: users(:david)))
+  assert_equal board.account, assigned_account(Board::Publication.new(board: board))
+  assert_equal card.account, assigned_account(Assignment.new(card: card, assignee: users(:mike), assigner: users(:mike)))
+  assert_equal card.account, assigned_account(Watch.new(card: card, user: users(:mike)))
+  assert_equal card.account, assigned_account(Reaction.new(reactable: card, reacter: users(:mike)))
+  assert_equal card.account, assigned_account(Mention.new(source: card, mentioner: users(:mike), mentionee: users(:mike)))
+  assert_equal users(:david).account, assigned_account(User::Settings.new(user: users(:david)))
+  assert_equal users(:david).account, assigned_account(Search::Query.new(user: users(:david), terms: "fizz"))
+end
+
+  private
+    # belongs_to defaults are filled in on validation.
+    def assigned_account(record)
+      record.validate
+      record.account
+    end
+
+    def connection
+      ActiveRecord::Base.connection
+    end
+
+    def tenanted_tables
+      connection.tables - GLOBAL_TABLES - JOIN_TABLES
+    end
+end
