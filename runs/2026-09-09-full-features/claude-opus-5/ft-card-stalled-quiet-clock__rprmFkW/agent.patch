diff --git a/app/models/card/stalling.rb b/app/models/card/stalling.rb
new file mode 100644
index 0000000..949c6c3
--- /dev/null
+++ b/app/models/card/stalling.rb
@@ -0,0 +1,56 @@
+# Cards that get a burst of attention and then go quiet are stalled. A burst is
+# either a flurry of comments -- three or more of them, from at least two
+# different people, within a third of the board's auto-postpone period -- or
+# someone taking ownership of the card by assigning it or reopening it.
+#
+# Once a card has burst, any activity on it resets the stall clock. If nothing
+# happens for a couple of weeks after the last activity, the card is stalled.
+module Card::Stalling
+  extend ActiveSupport::Concern
+
+  STALL_PERIOD = 2.weeks
+  BURST_PERIOD_FRACTION = 3
+  BURST_COMMENTS = 3
+  BURST_COMMENTERS = 2
+  BURST_ACTIONS = %w[ card_assigned card_reopened ].freeze
+
+  included do
+    scope :bursted, -> { where.not(bursted_at: nil) }
+    scope :stalled, -> { bursted.where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def stalled?
+    bursted? && last_active_at <= STALL_PERIOD.ago
+  end
+
+  def stalled_since
+    last_active_at + STALL_PERIOD if bursted?
+  end
+
+  def bursted?
+    bursted_at.present?
+  end
+
+  def burst_period
+    auto_postpone_period / BURST_PERIOD_FRACTION
+  end
+
+  def track_burst(event)
+    record_burst event.created_at if bursting?(event)
+  end
+
+  private
+    def bursting?(event)
+      event.action.in?(BURST_ACTIONS) || (event.action.comment_created? && commenting_burst?)
+    end
+
+    def commenting_burst?
+      commenter_ids = comments.by_user.where(created_at: burst_period.seconds.ago..).pluck(:creator_id)
+
+      commenter_ids.length >= BURST_COMMENTS && commenter_ids.uniq.length >= BURST_COMMENTERS
+    end
+
+    def record_burst(time)
+      update_column :bursted_at, time
+    end
+end
