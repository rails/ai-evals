diff --git a/test/integration/card_stalling_test.rb b/test/integration/card_stalling_test.rb
new file mode 100644
index 0000000..7f5c73e
--- /dev/null
+++ b/test/integration/card_stalling_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class CardStallingTest < ActionDispatch::IntegrationTest
+  test "a burst of comments followed by silence stalls the card" do
+    card = cards(:text)
+
+    sign_in_as :kevin
+    post card_comments_path(card), params: { comment: { body: "Let's get this out the door" } }, as: :turbo_stream
+    post card_comments_path(card), params: { comment: { body: "Starting on it" } }, as: :turbo_stream
+
+    logout_and_sign_in_as :david
+    post card_comments_path(card), params: { comment: { body: "I'll help" } }, as: :turbo_stream
+
+    assert card.reload.bursted?
+    assert_not card.stalled?
+
+    travel 3.weeks do
+      get cards_path(indexed_by: "stalled")
+      assert_response :success
+      assert_select "##{dom_id(card, :article)} .card__stalled", text: /Stalled/
+
+      post card_comments_path(card), params: { comment: { body: "Bumping this" } }, as: :turbo_stream
+      assert_not card.reload.stalled?
+
+      get cards_path(indexed_by: "stalled")
+      assert_select "##{dom_id(card, :article)}", false
+    end
+  end
+end
diff --git a/test/models/card/stalling_test.rb b/test/models/card/stalling_test.rb
new file mode 100644
index 0000000..d7ac21c
--- /dev/null
+++ b/test/models/card/stalling_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Card::StallingTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:text)
+  end
+
+  test "a flurry of comments from several people bursts the card" do
+    comment_by :david, "Looking into this"
+    comment_by :kevin, "Me too"
+    assert_not @card.reload.bursted?
+
+    comment_by :david, "Almost there"
+    assert @card.reload.bursted?
+  end
+
+  test "comments from a single person don't burst the card" do
+    3.times { comment_by :david, "Thinking out loud" }
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "comments spread beyond a third of the auto-postpone period don't burst the card" do
+    travel_to (@card.burst_period.seconds * 2).ago do
+      comment_by :david, "Way back when"
+      comment_by :kevin, "Indeed"
+    end
+
+    comment_by :david, "Bumping this"
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "system comments don't count towards a burst" do
+    comment_by :system, "Card was moved"
+    comment_by :system, "Card was moved again"
+    comment_by :david, "What's going on?"
+
+    assert_not @card.reload.bursted?
+  end
+
+  test "assigning someone bursts the card" do
+    @card.toggle_assignment users(:kevin)
+
+    assert @card.reload.bursted?
+  end
+
+  test "reopening bursts the card" do
+    @card.close
+    assert_not @card.reload.bursted?
+
+    @card.reopen
+    assert @card.reload.bursted?
+  end
+
+  test "a bursted card stalls after two weeks without activity" do
+    @card.toggle_assignment users(:kevin)
+    assert_not @card.reload.stalled?
+
+    @card.update_column :last_active_at, 2.weeks.ago - 1.day
+    assert @card.reload.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "cards that never bursted never stall" do
+    @card.update_column :last_active_at, 1.year.ago
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "activity on a stalled card resets it" do
+    @card.toggle_assignment users(:kevin)
+    @card.update_column :last_active_at, 3.weeks.ago
+    assert @card.reload.stalled?
+
+    comment_by :kevin, "Still working on this"
+
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "stalled cards are listed by the stalled index" do
+    @card.toggle_assignment users(:kevin)
+    @card.update_column :last_active_at, 3.weeks.ago
+
+    assert_equal [ @card ], Card.indexed_by("stalled").to_a
+  end
+
+  test "burst period is a third of the board's auto-postpone period" do
+    entropies(:writebook_board).update! auto_postpone_period: 30.days
+
+    assert_equal 10.days.to_i, @card.reload.burst_period
+  end
