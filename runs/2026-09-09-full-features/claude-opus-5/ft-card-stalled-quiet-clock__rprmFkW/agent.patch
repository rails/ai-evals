diff --git a/db/migrate/20260715120000_add_bursted_at_to_cards.rb b/db/migrate/20260715120000_add_bursted_at_to_cards.rb
new file mode 100644
index 0000000..c8aabcb
--- /dev/null
+++ b/db/migrate/20260715120000_add_bursted_at_to_cards.rb
@@ -0,0 +1,35 @@
+class AddBurstedAtToCards < ActiveRecord::Migration[8.2]
+  def change
+    add_column :cards, :bursted_at, :datetime
+
+    reversible do |dir|
+      dir.up { backfill_bursts }
+    end
+
+    add_index :cards, [ :account_id, :bursted_at, :last_active_at ]
+  end
+
+  private
+    # Cards that were assigned or reopened in the past already had their burst of
+    # attention, so flag them to let them stall. Comment flurries aren't backfilled:
+    # they get detected as new comments land.
+    def backfill_bursts
+      execute(<<~SQL)
+        UPDATE cards
+        SET bursted_at = (
+          SELECT MAX(events.created_at)
+          FROM events
+          WHERE events.eventable_type = 'Card'
+            AND events.eventable_id = cards.id
+            AND events.action IN ('card_assigned', 'card_reopened')
+        )
+        WHERE EXISTS (
+          SELECT 1
+          FROM events
+          WHERE events.eventable_type = 'Card'
+            AND events.eventable_id = cards.id
+            AND events.action IN ('card_assigned', 'card_reopened')
+        )
+      SQL
+    end
+end
