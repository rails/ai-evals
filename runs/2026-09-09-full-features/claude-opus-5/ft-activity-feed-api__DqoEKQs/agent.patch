--- /dev/null
+++ b/test/models/event/particulars_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "assignment particulars carry the assignee ids" do
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, events(:logo_assignment_jz).activity_particulars)
+  end
+
+  test "board change particulars carry the old and new board" do
+    event = events(:logo_published)
+    event.update! action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Writebook", "new_board" => "Fizzy" } }
+
+    assert_equal({ old_board: "Writebook", new_board: "Fizzy" }, event.activity_particulars)
+  end
+
+  test "title change particulars carry the old and new title" do
+    event = events(:logo_published)
+    event.update! action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } }
+
+    assert_equal({ old_title: "Old", new_title: "New" }, event.activity_particulars)
+  end
+
+  test "triage particulars carry the column" do
+    event = events(:logo_published)
+    event.update! action: "card_triaged", particulars: { "particulars" => { "column" => "Doing" } }
+
+    assert_equal({ column: "Doing" }, event.activity_particulars)
+  end
+
+  test "missing particulars are returned as empty strings" do
+    event = events(:logo_published)
+    event.update! action: "card_triaged", particulars: {}
+
+    assert_equal({ column: "" }, event.activity_particulars)
+  end
+
+  test "other events have no particulars" do
+    assert_equal({}, events(:logo_published).activity_particulars)
+    assert_equal({}, events(:layout_commented).activity_particulars)
+  end
+end
diff --git a/test/models/event_test.rb b/test/models/event_test.rb
new file mode 100644
index 0000000..adb98ed
--- /dev/null
+++ b/test/models/event_test.rb
@@ -0,0 +1,23 @@
+require "test_helper"
+
+class EventTest < ActiveSupport::TestCase
+  test "activity excludes deprecated collection changes and includes title changes" do
+    events(:text_published).update_columns(action: "card_collection_changed")
+    events(:shipping_published).update_columns(action: "card_title_changed")
+
+    actions = Event.activity.pluck(:action)
+
+    assert_not_includes actions, "card_collection_changed"
+    assert_includes actions, "card_title_changed"
+  end
+
+  test "latest first" do
+    assert_equal Event.order(created_at: :desc).first, Event.latest_first.first
+  end
+
+  test "created by and on boards ignore blank filters" do
+    assert_equal Event.count, Event.created_by(nil).on_boards([]).count
+    assert_equal Event.where(creator: users(:kevin)).count, Event.created_by([ users(:kevin).id ]).count
+    assert_equal Event.where(board: boards(:writebook)).count, Event.on_boards([ boards(:writebook).id ]).count
+  end
+end
