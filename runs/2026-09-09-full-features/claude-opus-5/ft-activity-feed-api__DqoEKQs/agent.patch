+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from activity
+  end
+
+  private
+    def activity
+      Current.user.accessible_events
+        .activity
+        .created_by(creator_ids)
+        .on_boards(board_ids)
+        .preloaded
+        .latest_first
+    end
+
+    def creator_ids
+      ids_from_param :creator_ids
+    end
+
+    def board_ids
+      ids_from_param :board_ids
+    end
+
+    def ids_from_param(name)
+      Array(params[name]).map(&:to_s).compact_blank
+    end
+end
