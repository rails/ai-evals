@@ -0,0 +1,85 @@
+# Activity
+
+Activity is the stream of events that happened in an account: cards being added, closed, moved,
+renamed, assigned, and commented on. It's the same activity you see in the Fizzy timeline.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activity, newest first. Only activity on boards you have access to is returned.
+
+| Parameter | Type | Required | Description |
+|-----------|------|----------|-------------|
+| `creator_ids[]` | array | No | Only return activity created by these users |
+| `board_ids[]` | array | No | Only return activity that happened on these boards |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.401Z",
+    "description": "David Heinemeier Hansson assigned Jason to &quot;Layout is broken&quot;",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a7"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/2",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 2,
+      "title": "Layout is broken",
+      "status": "published"
+    },
+    "board": {
+      "id": "03f5v9zkft4hj9qq0lsn9ohdn",
+      "name": "Writebook"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson"
+    }
+  }
+]
+```
+
+`eventable`, `board`, and `creator` are the same representations returned by the
+[cards](cards.md), [comments](comments.md), [boards](boards.md), and [users](users.md) endpoints.
+They're abbreviated in the example above.
+
+`eventable_type` is either `Card` or `Comment`. For card activity, `url` opens the card. For
+comment activity, it opens the card where the comment was posted and jumps to the comment.
+
+`description` is the plain-text version of the description shown in the Fizzy timeline.
+
+### Actions
+
+| Action | Description |
+|--------|-------------|
+| `card_published` | A card was added |
+| `card_closed` | A card was moved to Done |
+| `card_reopened` | A card was reopened |
+| `card_postponed` | A card was moved to Not Now |
+| `card_auto_postponed` | A card was moved to Not Now due to inactivity |
+| `card_triaged` | A card was moved to a column |
+| `card_sent_back_to_triage` | A card was moved back to Maybe? |
+| `card_board_changed` | A card was moved to another board |
+| `card_title_changed` | A card was renamed |
+| `card_assigned` | People were assigned to a card |
+| `card_unassigned` | People were unassigned from a card |
+| `comment_created` | A comment was posted on a card |
+
+### Particulars
+
+`particulars` carries the details that are specific to each kind of activity:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+| Everything else | `{}` |
+
+Board, title, and column values that weren't recorded are returned as empty strings.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..c7855f4
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  test "index returns activity newest first" do
+    sign_in_as :david
+    get activities_path
+    assert_response :success
+
+    ids = @response.parsed_body.map { it["id"] }
+
+    assert_equal events(:layout_assignment_jz).id, ids.first
+    assert_includes ids, events(:logo_published).id
+    assert_equal ids, ids.sort_by { |id| [ -Event.find(id).created_at.to_f ] }
+  end
+
+  test "index omits deprecated collection changed events and includes title changes" do
+    events(:text_published).update_columns(action: "card_collection_changed")
+    events(:shipping_published).update_columns action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } }
+
+    sign_in_as :david
+    get activities_path
+    ids = @response.parsed_body.map { it["id"] }
+
+    assert_not_includes ids, events(:text_published).id
+    assert_includes ids, events(:shipping_published).id
+  end
+
+  test "index includes event details" do
+    sign_in_as :david
+    get activities_path
+
+    activity = @response.parsed_body.find { it["id"] == events(:logo_published).id }
+
+    assert_equal "card_published", activity["action"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:logo).id, activity["eventable"]["id"]
+    assert_equal boards(:writebook).id, activity["board"]["id"]
+    assert_equal users(:david).id, activity["creator"]["id"]
+    assert_equal card_url(cards(:logo)), activity["url"]
+    assert_equal({}, activity["particulars"])
+    assert_includes activity["description"], "David added"
+  end
+
+  test "index links comment activity to the comment on its card" do
+    sign_in_as :david
+    get activities_path
+
+    activity = @response.parsed_body.find { it["id"] == events(:layout_commented).id }
+    comment = comments(:layout_overflowing_david)
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comment.id, activity["eventable"]["id"]
+    assert_equal card_url(comment.card, anchor: "comment_#{comment.id}"), activity["url"]
+  end
+
+  test "index includes particulars for assignments" do
+    sign_in_as :david
+    get activities_path
+
+    activity = @response.parsed_body.find { it["id"] == events(:layout_assignment_jz).id }
+
+    assert_equal [ users(:jz).id ], activity["particulars"]["assignee_ids"]
+  end
+
+  test "index includes particulars for board changes" do
+    events(:shipping_closed).update_columns action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Writebook", "new_board" => "Private board" } }
+
+    sign_in_as :david
+    get activities_path
+    activity = @response.parsed_body.find { it["id"] == events(:shipping_closed).id }
+
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Private board" }, activity["particulars"])
+  end
+
+  test "index returns missing particulars as empty strings" do
+    events(:shipping_closed).update_columns action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old" } }
+
+    sign_in_as :david
+    get activities_path
+    activity = @response.parsed_body.find { it["id"] == events(:shipping_closed).id }
+
+    assert_equal({ "old_title" => "Old", "new_title" => "" }, activity["particulars"])
+  end
+
+  test "index includes particulars for triage" do
+    events(:shipping_closed).update_columns action: "card_triaged",
+      particulars: { "particulars" => { "column" => "Doing" } }
+
+    sign_in_as :david
+    get activities_path
+    activity = @response.parsed_body.find { it["id"] == events(:shipping_closed).id }
+
+    assert_equal({ "column" => "Doing" }, activity["particulars"])
+  end
+
+  test "index filters by creator" do
+    sign_in_as :david
+    get activities_path(creator_ids: [ users(:kevin).id ])
+
+    creator_ids = @response.parsed_body.map { it.dig("creator", "id") }.uniq
+    assert_equal [ users(:kevin).id ], creator_ids
+  end
+
+  test "index filters by board" do
+    events(:shipping_closed).update_columns(board_id: boards(:private).id)
+
+    sign_in_as :kevin
+    get activities_path(board_ids: [ boards(:private).id ])
+
+    assert_equal [ events(:shipping_closed).id ], @response.parsed_body.map { it["id"] }
+  end
+
+  test "index skips activity on inaccessible boards" do
+    events(:shipping_closed).update_columns(board_id: boards(:private).id)
+
+    sign_in_as :david
+    get activities_path
+
+    assert_not_includes @response.parsed_body.map { it["id"] }, events(:shipping_closed).id
+  end
+
+  test "index includes activity on private boards for members" do
+    events(:shipping_closed).update_columns(board_id: boards(:private).id)
+
+    sign_in_as :kevin
+    get activities_path
+
+    assert_includes @response.parsed_body.map { it["id"] }, events(:shipping_closed).id
+  end
+
+  test "index is paginated" do
+    sign_in_as :david
+    get activities_path(page: 1)
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+  end
+
+  test "index is available with an access token" do
+    get activities_path, env: { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+
+    assert_response :success
+  end
+end
diff --git a/test/models/event/particulars_test.rb b/test/models/event/particulars_test.rb
