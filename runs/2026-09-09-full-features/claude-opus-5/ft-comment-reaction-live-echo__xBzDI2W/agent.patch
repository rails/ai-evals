+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "reacting registers activity on the card" do
+    assert_changes -> { @comment.card.reload.last_active_at } do
+      @comment.reactions.create! content: "🎉"
+    end
+  end
+
+  test "reacting touches the comment so everyone sees it" do
+    assert_changes -> { @comment.reload.updated_at } do
+      @comment.reactions.create! content: "🎉"
+    end
+  end
+
+  test "reactions are limited to 16 characters" do
+    reaction = @comment.reactions.build(content: "a" * 17)
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "is too long (maximum is 16 characters)"
+
+    assert @comment.reactions.build(content: "a" * 16).valid?
+  end
+
+  test "reactions require content" do
+    assert_not @comment.reactions.build(content: "").valid?
+  end
+
+  test "reactions are left by the current user in the comment's account" do
+    reaction = @comment.reactions.create! content: "👍"
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal @comment.account, reaction.account
+    assert reaction.by?(users(:david))
+    assert_not reaction.by?(users(:kevin))
+  end
+
+  test "emoji only reactions are recognized" do
+    assert @comment.reactions.build(content: "👍").emoji?
+    assert_not @comment.reactions.build(content: "So true").emoji?
+    assert_not @comment.reactions.build(content: "Yes 👍").emoji?
+  end
+
+  test "reactions are removed along with their comment" do
+    assert_difference -> { Reaction.count }, -2 do
+      @comment.destroy
+    end
+  end
+end
