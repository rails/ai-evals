+require "test_helper"
+
+class ReactionsTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "comments show their reactions and a button to add one" do
+    get card_path(@card)
+
+    assert_response :success
+    assert_select "##{dom_id(@comment, :reactions_list)} .reaction", 2
+    assert_select "##{dom_id(reactions(:logo_agreement_kevin_by_david))} .reaction__delete[data-only-visible-to-reacter]"
+    assert_select "##{dom_id(@comment, :reactions_list)} + .reaction__form"
+    assert_select ".reactions__trigger", minimum: 1
+  end
+
+  test "reacting lands in the strip" do
+    post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🥳" } }, as: :turbo_stream
+    assert_response :success
+
+    get card_path(@card)
+
+    assert_select "##{dom_id(@comment, :reactions_list)} .reaction", 3
+    assert_select "##{dom_id(Reaction.last)}", text: /🥳/
+  end
+
+  test "removing your reaction takes it out of the strip" do
+    reaction = @comment.reactions.create! content: "👀", reacter: users(:kevin)
+
+    delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    assert_response :success
+
+    get card_path(@card)
+
+    assert_select "##{dom_id(reaction)}", false
+  end
+end
