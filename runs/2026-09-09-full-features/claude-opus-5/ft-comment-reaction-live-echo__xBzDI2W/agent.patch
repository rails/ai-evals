+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    Current.user = users(:kevin)
+
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "adding a reaction to a comment" do
+    visit card_url(@card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Nice one"
+      click_on "Add this reaction"
+
+      assert_selector ".reaction", text: "Nice one"
+      assert_no_selector ".reaction__input", visible: true
+      assert_selector ".reactions__trigger"
+    end
+
+    assert @comment.reactions.exists?(content: "Nice one", reacter: users(:david))
+  end
+
+  test "canceling a reaction" do
+    visit card_url(@card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Never mind"
+      click_on "Cancel"
+
+      assert_no_selector ".reaction__input", visible: true
+      assert_selector ".reactions__trigger"
+      assert_no_text "Never mind"
+    end
+
+    assert_not @comment.reactions.exists?(content: "Never mind")
+  end
+
+  test "removing your own reaction" do
+    reaction = react_elsewhere(content: "Oops", reacter: users(:david))
+
+    visit card_url(@card)
+
+    within_reactions do
+      assert_selector "##{dom_id(reaction)}"
+      find("##{dom_id(reaction)}").click
+
+      within "##{dom_id(reaction)}" do
+        click_on "Remove your reaction"
+      end
+
+      assert_no_selector "##{dom_id(reaction)}"
+    end
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "reactions left by others land without reloading" do
+    visit card_url(@card)
+    wait_for_cable_subscriptions
+
+    reaction = react_elsewhere(content: "🎉", reacter: users(:kevin))
+    perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+
+    assert_selector "##{dom_id(reaction)}", text: "🎉", wait: 5
+  end
+
+  private
+    def within_reactions(&block)
+      within "##{dom_id(@comment, :reactions)}", &block
+    end
+
+    def react_elsewhere(content:, reacter:)
+      @comment.reactions.create! content: content, reacter: reacter
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
