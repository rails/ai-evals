diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..05cbeb2
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,26 @@
+<% @page_title = @search.query? ? "Search: #{@search.query}" : "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span class="overflow-ellipsis">Search</span>
+  </h1>
+<% end %>
+
+<section class="search">
+  <%= form_with url: search_path, method: :get, class: "search__form" do |form| %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards and comments…",
+          class: "input full-width", autofocus: true, autocomplete: "off", autocorrect: "off",
+          data: { "1p-ignore": "true" } %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @search.query? %>
+    <% if @results.any? %>
+      <ol class="search__results">
+        <%= render partial: "searches/result", collection: @results, as: :result %>
+      </ol>
+    <% else %>
+      <div class="blank-slate">No cards match “<%= @search.query %>”</div>
+    <% end %>
+  <% end %>
+</section>
