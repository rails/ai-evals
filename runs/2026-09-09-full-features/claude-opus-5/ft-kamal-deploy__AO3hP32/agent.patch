+namespace :vapid do
+  desc "Generate a VAPID key pair for web push notifications"
+  task :keys do
+    require "web_push"
+
+    key = WebPush.generate_key
+
+    puts "VAPID_PUBLIC_KEY=#{key.public_key}"
+    puts "VAPID_PRIVATE_KEY=#{key.private_key}"
+  end
+end
diff --git a/test/deploy_config_test.rb b/test/deploy_config_test.rb
new file mode 100644
index 0000000..03c6e03
--- /dev/null
+++ b/test/deploy_config_test.rb
@@ -0,0 +1,97 @@
+require "test_helper"
+require "kamal"
+
+# Fizzy's default deploy is one box: a Linux server with Docker, SQLite, everything in one
+# container, SSL from the proxy. These tests pin that shape so a fork only has to fill in
+# its host name, its mail server and its secrets before running `kamal setup`.
+class DeployConfigTest < ActiveSupport::TestCase
+  DEPLOY_FILE = Rails.root.join("config/deploy.yml")
+  SECRETS_FILE = Rails.root.join(".kamal/secrets")
+
+  test "deploy config is a valid Kamal configuration" do
+    assert_nothing_raised { config }
+  end
+
+  test "everything runs on one box" do
+    assert_equal [ "web" ], config.roles.map(&:name)
+    assert_equal 1, config.all_hosts.size
+  end
+
+  test "background jobs run on the box, inside Puma" do
+    assert_not_equal "false", clear_env["SOLID_QUEUE_IN_PUMA"].to_s
+  end
+
+  test "proxy terminates SSL for the host the app links to" do
+    assert config.proxy.ssl?
+    assert_equal [ clear_env["APP_HOST"] ], config.proxy.deploy_options[:host]
+    assert_equal "/up", config.proxy.deploy_options[:"health-check-path"]
+  end
+
+  test "app runs in production on SQLite with files on disk" do
+    assert_equal "production", clear_env["RAILS_ENV"]
+    assert_equal "sqlite", clear_env["DATABASE_ADAPTER"]
+    assert_equal "local", clear_env["ACTIVE_STORAGE_SERVICE"]
+  end
+
+  test "databases and uploads live in a volume so they survive the next deploy" do
+    assert_includes config.volume_args, "fizzy_storage:/rails/storage"
+
+    production_databases.each do |database|
+      assert database.start_with?("storage/"),
+        "#{database} lives outside the mounted volume and wouldn't survive a deploy"
+    end
+  end
+
+  test "mail server is configured, with its password kept secret" do
+    assert clear_env["SMTP_ADDRESS"].present?
+    assert clear_env["MAILER_FROM_ADDRESS"].present?
+    assert_includes secret_keys, "SMTP_PASSWORD"
+  end
+
+  test "secrets are referenced from .kamal/secrets" do
+    assert_includes secret_keys, "SECRET_KEY_BASE"
+
+    (secret_keys + [ "KAMAL_REGISTRY_PASSWORD" ]).each do |secret|
+      assert_match(/^#{secret}=/, SECRETS_FILE.read, "#{secret} is missing from .kamal/secrets")
+    end
+  end
+
+  test "every environment variable the deploy sets is used by the app" do
+    (clear_env.keys + secret_keys).each do |name|
+      assert app_reads_env?(name), "#{name} is set by config/deploy.yml but never read"
+    end
+  end
+
+  private
+    def config
+      @config ||= Kamal::Configuration.create_from(config_file: DEPLOY_FILE)
+    end
+
+    def env
+      config.role(:web).env(config.primary_host)
+    end
+
+    def clear_env
+      env.clear
+    end
+
+    def secret_keys
+      env.secret_keys
+    end
+
+    def production_databases
+      ActiveRecord::Base.configurations.configs_for(env_name: "production").map(&:database)
+    end
+
+    APP_ENV_SOURCES = %w[ config app lib bin Dockerfile ]
+
+    def app_reads_env?(name)
+      # RAILS_ENV and Kamal's own registry password are read by Rails and Kamal themselves.
+      return true if name.in?(%w[ RAILS_ENV KAMAL_REGISTRY_PASSWORD ])
+
+      APP_ENV_SOURCES.any? do |path|
+        # Skip the deploy config itself: it declares these, it doesn't read them.
+        system("grep", "-qr", "--exclude=deploy*.yml", "--", name, Rails.root.join(path).to_s)
+      end
+    end
+end
