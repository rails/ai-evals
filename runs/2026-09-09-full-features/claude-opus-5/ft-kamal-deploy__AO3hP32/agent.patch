@@ -0,0 +1,31 @@
+# Secrets for `kamal deploy`, referenced from config/deploy.yml.
+#
+# This file is a shell-ish template: every line is `NAME=value`, and values can
+# read from your environment or shell out to a password manager. Nothing in here
+# should be a literal secret you commit -- keep the actual values outside the
+# repo.
+#
+# The simplest setup: export these in your shell (or keep them in an untracked
+# .env file you source) before running kamal.
+#
+#   export KAMAL_REGISTRY_PASSWORD=...   # GitHub personal access token, or your registry password
+#   export SECRET_KEY_BASE=$(bin/rails secret)
+#   export SMTP_PASSWORD=...             # Password for your mail server
+#   export VAPID_PUBLIC_KEY=...          # bin/rails vapid:keys
+#   export VAPID_PRIVATE_KEY=...
+
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+SMTP_PASSWORD=$SMTP_PASSWORD
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
+
+# Prefer a password manager? Kamal can fetch them for you, e.g. with 1Password:
+#
+#   SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from Vault/Fizzy \
+#     KAMAL_REGISTRY_PASSWORD SECRET_KEY_BASE SMTP_PASSWORD VAPID_PUBLIC_KEY VAPID_PRIVATE_KEY)
+#   KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
+#   SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)
+#   SMTP_PASSWORD=$(kamal secrets extract SMTP_PASSWORD $SECRETS)
+#   VAPID_PUBLIC_KEY=$(kamal secrets extract VAPID_PUBLIC_KEY $SECRETS)
+#   VAPID_PRIVATE_KEY=$(kamal secrets extract VAPID_PRIVATE_KEY $SECRETS)
