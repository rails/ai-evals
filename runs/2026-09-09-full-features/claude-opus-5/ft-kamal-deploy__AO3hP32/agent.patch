--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,126 @@
+# Kamal configuration for running Fizzy on one box.
+#
+# One Linux server with Docker: web, background jobs (Solid Queue runs inside
+# Puma), the SQLite databases and the uploaded files all live in a single
+# container. Kamal's proxy sits in front and terminates SSL for you with an
+# automatic Let's Encrypt certificate. Everything that must survive a deploy is
+# kept in the `fizzy_storage` Docker volume.
+#
+# Before your first deploy:
+#
+#   1. Replace every example.com below with your own host name and mail server.
+#   2. Set your image name and container registry.
+#   3. Fill in .kamal/secrets with your secrets.
+#   4. Run `kamal setup`.
+#
+# See docs/deployment.md for the full walkthrough.
+
+# Name of the app, used to name containers, volumes and the proxy service.
+service: fizzy
+
+# Where your image is pushed to and pulled from. Use your own account/repo.
+image: your-user/fizzy
+
+# One box runs everything. Jobs are not a separate role: Puma boots Solid Queue
+# in-process (see config/puma.rb), so background jobs run on this same server.
+servers:
+  web:
+    - fizzy.example.com
+
+# Kamal's proxy terminates SSL on ports 80/443 and forwards to Thruster inside
+# the container. Point your DNS A/AAAA record at the box first: Let's Encrypt
+# has to reach http://fizzy.example.com to issue the certificate.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+  app_port: 80
+  healthcheck:
+    path: /up
+
+# Credentials for your image host. This example uses the GitHub container
+# registry; `password` reads KAMAL_REGISTRY_PASSWORD from .kamal/secrets.
+registry:
+  server: ghcr.io
+  username: your-user
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Kamal connects as root by default. Deploying as another user? Make sure it can
+# run Docker, then tell Kamal about it:
+#
+# ssh:
+#   user: deploy
+
+# Build for the architecture of your server. Use `arch: arm64` for ARM boxes
+# (Ampere, Graviton, Hetzner CAX, …).
+builder:
+  arch: amd64
+
+env:
+  clear:
+    # Fizzy runs in production mode, on SQLite, with everything on this box.
+    RAILS_ENV: production
+    DATABASE_ADAPTER: sqlite
+
+    # Uploads go to the disk service, which writes into /rails/storage.
+    ACTIVE_STORAGE_SERVICE: local
+
+    # Background jobs run inside Puma on this same box.
+    SOLID_QUEUE_IN_PUMA: true
+    JOB_CONCURRENCY: 1
+
+    # One box, one small SQLite database: a couple of Puma workers is plenty.
+    # Raise this if your server has more cores to spare.
+    WEB_CONCURRENCY: 2
+
+    # Your host name. Used for the links Fizzy puts in emails, so it has to
+    # match the `proxy.host` above.
+    APP_HOST: fizzy.example.com
+
+    # Your mail server. Fizzy signs people in by emailing them a magic link,
+    # so outbound email has to work. SMTP_PASSWORD is a secret, see below.
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_USER_NAME: fizzy@example.com
+    SMTP_DOMAIN: example.com
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@example.com>
+
+    # Self-hosted Fizzy is single account: the first person to sign up owns the
+    # install, and signups close after that. Uncomment to host many accounts.
+    # MULTI_TENANT: true
+
+  secret:
+    # Rails needs this to sign cookies. Generate one with `bin/rails secret`.
+    - SECRET_KEY_BASE
+
+    # Password for the SMTP account above. Drop this line if your mail server
+    # doesn't need authentication (and clear SMTP_USER_NAME too).
+    - SMTP_PASSWORD
+
+    # Web push notifications. Generate a pair with `bin/rails vapid:keys`.
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# The one thing that must outlive the container: SQLite databases (primary,
+# cache, queue, cable) and uploaded files, all under /rails/storage.
+volumes:
+  - fizzy_storage:/rails/storage
+
+# Serve assets from the previous container until the new one takes over, so a
+# deploy doesn't 404 stylesheets for people mid-request.
+asset_path: /rails/public/assets
+
+# Keep the disk on a small box tidy.
+retain_containers: 2
+
+logging:
+  driver: json-file
+  options:
+    max-size: 100m
+    max-file: 3
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  dbconsole: app exec --interactive --reuse "bin/rails dbconsole"
+  logs: app logs --follow
+  shell: app exec --interactive --reuse "bash"
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..a1ef882 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -80,6 +80,41 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Canonical host for the URLs Fizzy generates outside of a request, like the
+  # magic sign-in links in emails. Set APP_HOST to the host name you serve
+  # Fizzy from (see config/deploy.yml).
+  if app_host = ENV["APP_HOST"].presence
+    url_options = { host: app_host, protocol: config.force_ssl ? "https" : "http" }
+
+    config.action_controller.default_url_options = url_options
+    config.action_mailer.default_url_options = url_options
+  end
+
+  # Deliver email through your own mail server, configured with SMTP_* env
+  # vars. Fizzy signs people in by emailing them a magic link, so a working
+  # mail server is required. Setting SMTP_ADDRESS turns this on.
+  if smtp_address = ENV["SMTP_ADDRESS"].presence
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = {
+      address: smtp_address,
+      port: Integer(ENV.fetch("SMTP_PORT", 587)),
+      domain: ENV["SMTP_DOMAIN"].presence || app_host,
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true",
+      open_timeout: 10,
+      read_timeout: 10
+    }.compact
+
+    # A relay on your own network may not need credentials, so only
+    # authenticate when a user name is given.
+    if smtp_user_name = ENV["SMTP_USER_NAME"].presence
+      config.action_mailer.smtp_settings.merge!(
+        user_name: smtp_user_name,
+        password: ENV["SMTP_PASSWORD"],
+        authentication: ENV.fetch("SMTP_AUTHENTICATION", "plain")
+      )
+    end
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
