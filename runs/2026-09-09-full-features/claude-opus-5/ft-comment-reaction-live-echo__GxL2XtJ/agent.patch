+<div id="<%= dom_id(comment, :new_reaction) %>" class="flex align-center"
+    data-controller="reactions"
+    data-reactions-expanded-class="reaction expanded">
+  <button class="reactions__trigger btn btn--circle"
+      data-controller="tooltip" data-reactions-target="trigger" data-action="reactions#expand">
+    <%= image_tag "boost-color.svg", alt: "", aria: { hidden: true } %>
+    <span class="for-screen-reader">React to this comment</span>
+  </button>
+
+  <%= form_with url: card_comment_reactions_path(comment.card, comment), scope: :reaction,
