index 0000000..ad03494
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,41 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Reveals a way to remove your own reaction when you click on it.
+export default class extends Controller {
+  static classes = [ "deleteable", "deleting", "expanded" ]
+  static values = { reacterId: String }
+
+  connect() {
+    this.markOwnReaction()
+  }
+
+  markOwnReaction() {
+    this.element.classList.toggle(this.deleteableClass, this.#reactedByCurrentUser)
+
+    if (this.#reactedByCurrentUser) {
+      this.element.setAttribute("tabindex", "0")
+    } else {
+      this.element.removeAttribute("tabindex")
+    }
+  }
+
+  toggle() {
+    if (this.#reactedByCurrentUser) this.element.classList.toggle(this.expandedClass)
+  }
+
+  collapse() {
+    this.element.classList.remove(this.expandedClass)
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (!this.element.contains(target)) this.collapse()
+  }
+
+  deleting() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  get #reactedByCurrentUser() {
+    return this.reacterIdValue === Current.user?.id
+  }
+}
