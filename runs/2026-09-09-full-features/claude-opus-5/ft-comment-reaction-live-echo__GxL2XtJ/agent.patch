+    <%= form.button class: "reaction__submit-btn btn borderless" do %>
+      <%= icon_tag "check" %>
+      <span class="for-screen-reader">Add this reaction</span>
+    <% end %>
+
+    <button type="button" class="reaction__cancel-btn btn borderless" data-action="reactions#collapse">
+      <%= icon_tag "close" %>
+      <span class="for-screen-reader">Cancel this reaction</span>
+    </button>
+  <% end %>
