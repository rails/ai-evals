@@ -0,0 +1,24 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Turns the "react" button into an inline form for a new reaction, and back again.
+export default class extends Controller {
+  static classes = [ "expanded" ]
+  static targets = [ "trigger", "form", "input" ]
+
+  expand() {
+    this.#toggle(true)
+    this.inputTarget.focus()
+  }
+
+  collapse() {
+    this.formTarget.reset()
+    this.#toggle(false)
+    this.triggerTarget.focus()
+  }
+
+  #toggle(expanded) {
+    this.formTarget.classList.toggle(this.expandedClass, expanded)
+    this.formTarget.hidden = !expanded
+    this.triggerTarget.hidden = expanded
+  }
+}
