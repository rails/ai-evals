diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..651c9ea
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,83 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    @comment = comments(:logo_agreement_jz)
+    Current.user = users(:kevin)
+  end
+
+  test "reacting defaults to the current user and the comment's account" do
+    reaction = @comment.reactions.create!(content: "🎉")
+
+    assert_equal users(:kevin), reaction.reacter
+    assert_equal @comment.account, reaction.account
+  end
+
+  test "content is required" do
+    reaction = @comment.reactions.new(content: "  ")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors.messages[:content], "can't be blank"
+  end
+
+  test "content is limited to 16 characters" do
+    assert @comment.reactions.new(content: "a" * 16).valid?
+    assert_not @comment.reactions.new(content: "a" * 17).valid?
+  end
+
+  test "content is stripped" do
+    assert_equal "👍", @comment.reactions.create!(content: " 👍 ").content
+  end
+
+  test "emoji only reactions" do
+    assert @comment.reactions.new(content: "👍").emoji?
+    assert @comment.reactions.new(content: "❤️").emoji?
+    assert_not @comment.reactions.new(content: "Agreed!").emoji?
+    assert_not @comment.reactions.new(content: "Great 👍").emoji?
+  end
+
+  test "reacting touches the comment and its card" do
+    assert_changes -> { @comment.reload.updated_at } do
+      assert_changes -> { @comment.card.reload.updated_at } do
+        travel_to 1.minute.from_now do
+          @comment.reactions.create!(content: "👍")
+        end
+      end
+    end
+  end
+
+  test "reacting refreshes the card for everyone looking at it" do
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts @comment.card do
+        @comment.reactions.create!(content: "👍")
+      end
+    end
+  end
+
+  test "unreacting refreshes the card for everyone looking at it" do
+    perform_enqueued_jobs do
+      assert_turbo_stream_broadcasts @comment.card do
+        reactions(:logo_agreement_jz_applause_by_kevin).destroy!
+      end
+    end
+  end
+
+  test "reactions are listed chronologically" do
+    assert_equal [ reactions(:logo_agreement_jz_applause_by_kevin), reactions(:logo_agreement_jz_agreed_by_jz) ],
+      @comment.reactions.to_a
+  end
+
+  test "destroying a reacter destroys their reactions" do
+    reaction = reactions(:logo_agreement_jz_applause_by_kevin)
+
+    users(:kevin).destroy!
+
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroying a comment destroys its reactions" do
+    assert_difference -> { Reaction.count }, -2 do
+      @comment.destroy!
+    end
+  end
+end
diff --git a/test/system/comment_reactions_test.rb b/test/system/comment_reactions_test.rb
new file mode 100644
index 0000000..becae50
--- /dev/null
+++ b/test/system/comment_reactions_test.rb
@@ -0,0 +1,98 @@
+require "application_system_test_case"
+
+class CommentReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+
+    @card = cards(:layout)
+    @comment = comments(:layout_overflowing_david)
+  end
+
+  test "reacting to a comment" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "👍"
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "👍"
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_equal "👍", @comment.reactions.sole.content
+  end
+
+  test "canceling a reaction" do
+    visit card_url(@card)
+
+    within_reactions do
+      find(".reactions__trigger").click
+      find(".reaction__input").fill_in with: "Nope"
+      find(".reaction__cancel-btn").click
+
+      assert_no_selector ".reaction__input"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_empty @comment.reactions
+  end
+
+  test "removing your own reaction" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:kevin))
+
+    visit card_url(@card)
+
+    within_reactions do
+      assert_no_selector ".reaction__delete"
+
+      find("##{dom_id(reaction)}").click
+      find("##{dom_id(reaction)} .reaction__delete").click
+
+      assert_no_selector ".reaction"
+    end
+
+    assert_empty @comment.reactions.reload
+  end
+
+  test "reactions left by other people can't be removed" do
+    reaction = @comment.reactions.create!(content: "👍", reacter: users(:jz))
+
+    visit card_url(@card)
+
+    within_reactions do
+      find("##{dom_id(reaction)}").click
+
+      assert_no_selector ".reaction__delete"
+    end
+  end
+
+  test "reactions left elsewhere land without reloading" do
+    visit card_url(@card)
+    within_reactions { assert_no_selector ".reaction" }
+
+    react_elsewhere
+
+    within_reactions { assert_selector ".reaction", text: "🎉", wait: 5 }
+  end
+
+  private
+    def within_reactions(&block)
+      within "##{dom_id(@comment, :reactions)}", &block
+    end
+
+    def react_elsewhere
+      wait_for_cable_subscriptions
+      @comment.reactions.create!(content: "🎉", reacter: users(:jz))
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
