new file mode 100644
index 0000000..7ca0964
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,120 @@
+# Fizzy on one box.
+#
+# This is a complete Kamal configuration for running Fizzy on a single Linux
+# server with Docker: web, background jobs, SQLite and uploaded files all live
+# in one container, and Kamal's proxy terminates SSL for you with an automatic
+# Let's Encrypt certificate.
+#
+# Fill in the four things below (or export the matching environment variables),
+# add your secrets to .kamal/secrets, and then run:
+#
+#   bin/kamal setup
+#
+# See docs/deployment.md for the full walkthrough.
+<%
+  # 1. The hostname people will use, e.g. "fizzy.example.com". It must already
+  #    resolve to your server so the proxy can get an SSL certificate for it.
+  host = ENV.fetch("FIZZY_HOST", "fizzy.example.com")
+
+  # 2. The server Kamal deploys to: an IP address or a DNS name you can SSH
+  #    into. Defaults to the hostname above.
+  server = ENV.fetch("FIZZY_SERVER", host)
+
+  # 3. Where your built image is pushed. Any registry works; the default is the
+  #    GitHub Container Registry for the account that forked Fizzy.
+  registry_server = ENV.fetch("FIZZY_REGISTRY_SERVER", "ghcr.io")
+  registry_username = ENV.fetch("FIZZY_REGISTRY_USERNAME", "your-github-username")
+  image = ENV.fetch("FIZZY_IMAGE", "#{registry_username}/fizzy")
+
+  # 4. The mail server that sends the magic links people sign in with. The
+  #    password is a secret, so it lives in .kamal/secrets instead.
+  smtp_address = ENV.fetch("FIZZY_SMTP_ADDRESS", "smtp.example.com")
+  smtp_port = ENV.fetch("FIZZY_SMTP_PORT", "587")
+  smtp_user_name = ENV.fetch("FIZZY_SMTP_USER_NAME", "fizzy@example.com")
+  mailer_from_address = ENV.fetch("FIZZY_MAILER_FROM_ADDRESS", "Fizzy <#{smtp_user_name}>")
+%>
+
+# Name of your application. Used to uniquely configure containers.
+service: fizzy
+
+# Name of the container image.
+image: <%= image %>
+
+# One box runs everything: Puma serves web requests and, because
+# SOLID_QUEUE_IN_PUMA is on, it supervises the Solid Queue workers too.
+servers:
+  web:
+    - <%= server %>
+
+# Kamal's proxy terminates SSL with an automatic Let's Encrypt certificate for
+# the host below. Thruster inside the container listens on port 80.
+proxy:
+  ssl: true
+  host: <%= host %>
+  app_port: 80
+  healthcheck:
+    path: /up
+
+# Credentials for your image host.
+registry:
+  server: <%= registry_server %>
+  username: <%= registry_username %>
+
+  # Always use an access token rather than a real password (see .kamal/secrets).
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+# Inject ENV variables into containers. Secrets come from .kamal/secrets.
+env:
+  clear:
+    # The canonical host, used for the links in outgoing emails.
+    APP_HOST: <%= host %>
+
+    # Outgoing mail. SMTP_PASSWORD is set as a secret below.
+    SMTP_ADDRESS: <%= smtp_address %>
+    SMTP_PORT: <%= smtp_port %>
+    SMTP_USER_NAME: <%= smtp_user_name %>
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+    MAILER_FROM_ADDRESS: <%= mailer_from_address %>
+
+    # Everything in one container: SQLite databases under /rails/storage,
+    # uploaded files on the same disk, background jobs inside Puma.
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: true
+
+    # A small box doesn't need many processes. Raise these if yours is bigger.
+    WEB_CONCURRENCY: 2
+    JOB_CONCURRENCY: 1
+
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+# The SQLite databases, the job queue and the uploaded files all live here, so
+# this volume is what makes your data survive the next deploy. Back it up!
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, ensuring old versions remain available while new
+# ones are deployed.
+asset_path: /rails/public/assets
+
+# Configure the image builder. Set FIZZY_ARCH=arm64 for an ARM server.
+builder:
+  arch: <%= ENV.fetch("FIZZY_ARCH", "amd64") %>
+
+# Kamal connects as root by default. Deploying as someone else? Add them to the
+# docker group on the server and uncomment:
+# ssh:
+#   user: app
+
+# Handy shortcuts: bin/kamal console, bin/kamal shell, bin/kamal logs, bin/kamal dbc.
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+  dbc: app exec --interactive --reuse "bin/rails dbconsole"
diff --git a/config/environments/production.rb b/config/environments/production.rb
index 7e81725..b668c76 100644
--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -80,6 +80,36 @@ Rails.application.configure do
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
 
+  # Self-hosted installs are configured through the environment: APP_HOST is the canonical
+  # hostname and the SMTP_* variables point at the mail server that sends the magic links
+  # people sign in with. See config/deploy.yml and docs/deployment.md.
+  #
+  # fizzy-saas sets these itself, in saas/config/environments/production.rb.
+  if (app_host = ENV["APP_HOST"].presence || ENV["APP_FQDN"].presence)
+    url_options = { host: app_host, protocol: config.force_ssl ? "https" : "http" }
+
+    config.action_controller.default_url_options = url_options
+    config.action_mailer.default_url_options = url_options
+
+    # Models and jobs generate URLs outside of a request, e.g. for exports and webhooks.
+    config.after_initialize { Rails.application.routes.default_url_options = url_options }
+  end
+
+  if (smtp_address = ENV["SMTP_ADDRESS"].presence)
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.perform_deliveries = true
+    config.action_mailer.raise_delivery_errors = true
+    config.action_mailer.smtp_settings = {
+      address: smtp_address,
+      port: Integer(ENV.fetch("SMTP_PORT", 587)),
+      domain: ENV["SMTP_DOMAIN"].presence || app_host,
+      user_name: ENV["SMTP_USER_NAME"].presence,
+      password: ENV["SMTP_PASSWORD"].presence,
+      authentication: ENV["SMTP_AUTHENTICATION"].presence,
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true"
+    }.compact
+  end
+
   # Enable locale fallbacks for I18n (makes lookups for any locale fall back to
   # the I18n.default_locale when a translation cannot be found).
   config.i18n.fallbacks = true
diff --git a/docs/deployment.md b/docs/deployment.md
new file mode 100644
index 0000000..4180a8c
--- /dev/null
+++ b/docs/deployment.md
@@ -0,0 +1,178 @@
+## Deploying Fizzy on one box
+
+Fizzy is happy on a single Linux server: one container runs the web server, the
+background jobs and SQLite, [Kamal](https://kamal-deploy.org)'s proxy terminates
+SSL with an automatic Let's Encrypt certificate, and your data lives in a Docker
+volume that survives every deploy.
+
+Fork the repo, fill in your hostname, your mail server and your secrets, run
+`bin/kamal setup`, and you'll have Fizzy at `https://your-host`.
+
+
+### What you need
+
+- **A Linux server** with SSH access as `root` (or a user in the `docker` group).
+  Two cores and 2 GB of memory is plenty to start. Kamal installs Docker for you
+  if it isn't there yet.
+- **A hostname**, e.g. `fizzy.example.com`, with a DNS `A`/`AAAA` record pointing
+  at the server. Ports 80 and 443 must be reachable so the proxy can request the
+  certificate.
+- **A container registry** to push the image you build to, e.g. the GitHub
+  Container Registry (`ghcr.io`) that comes with your fork.
+- **An SMTP server**. Fizzy signs people in with emailed magic links, so mail has
+  to work. Any transactional provider or your own mail server will do.
+- **Ruby and Docker on your own machine** to build and push the image. Run
+  `bin/setup` once to install the gems (see the [development
+  guide](development.md)).
+
+
+### 1. Configure your deploy
+
+Everything lives in [`config/deploy.yml`](../config/deploy.yml). Open it and
+replace the four placeholders at the top:
+
+```yaml
+host = ENV.fetch("FIZZY_HOST", "fizzy.example.com")                          # your hostname
+server = ENV.fetch("FIZZY_SERVER", host)                                     # your server's IP address
+registry_username = ENV.fetch("FIZZY_REGISTRY_USERNAME", "your-github-username")
+smtp_address = ENV.fetch("FIZZY_SMTP_ADDRESS", "smtp.example.com")           # your mail server
+```
+
+Note that image names on `ghcr.io` must be lowercase.
+
+Edit the values in place and commit them, or leave the file alone and export the
+`FIZZY_*` environment variables instead — handy if you'd rather not put your
+hostname in a public fork.
+
+The rest of the file is already set up for one box:
+
+| Setting | What it does |
+| --- | --- |
+| `servers.web` | The single server. Puma serves requests and, with `SOLID_QUEUE_IN_PUMA`, supervises the Solid Queue workers in the same container. |
+| `proxy.ssl` | Kamal's proxy gets a Let's Encrypt certificate for your host and terminates SSL. |
+| `volumes` | `fizzy_storage:/rails/storage` holds the SQLite databases, the job queue and the uploaded files. This is what survives deploys. |
+| `env.clear` | `APP_HOST` (used for links in emails), the `SMTP_*` settings, SQLite as the database, and local disk for Active Storage. |
+| `env.secret` | Pulled from [`.kamal/secrets`](../.kamal/secrets). |
+
+
+### 2. Set your secrets
+
+`.kamal/secrets` reads the values from your environment, so nothing sensitive is
+ever committed. Generate them once:
+
+```sh
+bin/rails secret                                                        # SECRET_KEY_BASE
+bin/rails runner 'key = WebPush.generate_key; puts key.public_key; puts key.private_key'  # VAPID keys
+```
+
+Then export them before deploying (a password manager, a `direnv` file outside
+the repo, or your shell profile all work):
+
+```sh
+export KAMAL_REGISTRY_PASSWORD=…   # e.g. a GitHub token with write:packages
+export SECRET_KEY_BASE=…           # keep this forever: changing it logs everyone out
+export SMTP_PASSWORD=…
+export VAPID_PUBLIC_KEY=…
+export VAPID_PRIVATE_KEY=…
+```
+
+Keep `SECRET_KEY_BASE` somewhere safe. It signs the cookies, so a new one on the
+next deploy signs everyone out.
+
+
+### 3. Deploy
+
+```sh
+bin/kamal setup
+```
+
+That installs Docker and the proxy on the server if needed, builds and pushes the
+image, boots the container, prepares the SQLite databases, and requests the SSL
+certificate. When it's done, open `https://your-host` and sign up — the first
+person to sign up gets the account.
+
+Every deploy after that is:
+
+```sh
+bin/kamal deploy
+```
+
+Migrations run automatically when the container boots.
+
+
+### Day-to-day
+
+```sh
+bin/kamal logs        # tail the logs
+bin/kamal console     # a Rails console on the server
+bin/kamal shell       # a shell in the container
+bin/kamal dbc         # a SQLite console
+bin/kamal app boot    # restart the app
+bin/kamal rollback    # go back to the previous version
+```
+
+Background jobs run inside the web container via Solid Queue's Puma plugin, so
+there's nothing else to boot. The recurring tasks in
+[`config/recurring.yml`](../config/recurring.yml) — bundled notifications, card
+postponing, cleanups — run there too.
+
+To watch the queue from the browser, mark yourself as staff and visit
+`https://your-host/admin/jobs`:
+
+```sh
+bin/kamal console
+> Identity.find_by(email_address: "you@example.com").update!(staff: true)
+```
+
+
+### Your data
+
+Everything durable is in the `fizzy_storage` Docker volume, mounted at
+`/rails/storage`:
+
+- `production.sqlite3` — the app database
+- `production_queue.sqlite3`, `production_cache.sqlite3`, `production_cable.sqlite3`
+- `production/files/` — uploaded files and image variants
+
+Deploys replace the container, never the volume, so the data stays. To back it
+up, copy it off the box on a schedule:
+
+```sh
+ssh root@your-host 'docker run --rm -v fizzy_storage:/data -v /var/backups:/backup \
+  busybox tar czf /backup/fizzy-$(date +%F).tar.gz -C /data .'
+```
+
+For a consistent SQLite snapshot, take it with the database's own backup command:
+
+```sh
+bin/kamal app exec "bin/rails runner 'ActiveRecord::Base.connection.execute(%(VACUUM INTO \"/rails/storage/backup.sqlite3\"))'"
+```
+
+
+### Tuning and options
+
+All of these are `env.clear` entries in `config/deploy.yml`:
+
+| Variable | Default | Notes |
+| --- | --- | --- |
+| `WEB_CONCURRENCY` | `2` | Puma workers. Roughly one per core. |
+| `JOB_CONCURRENCY` | `1` | Solid Queue worker processes. |
+| `RAILS_LOG_LEVEL` | `info` | Set to `debug` when something's off. |
+| `ACTIVE_STORAGE_SERVICE` | `local` | Switch to `s3` and add the `S3_*` variables from [`config/storage.oss.yml`](../config/storage.oss.yml) to keep files off the box. |
+| `DATABASE_ADAPTER` | `sqlite` | MySQL is supported too, but then you're running more than one box. |
+| `SMTP_PORT`, `SMTP_AUTHENTICATION`, `SMTP_ENABLE_STARTTLS_AUTO`, `SMTP_DOMAIN` | `587`, `plain`, `true`, your host | Match your provider. |
+| `MAILER_FROM_ADDRESS` | — | The `From:` on outgoing mail. Must be an address your mail server is allowed to send as. |
+
+Deploying to an ARM box? Set `FIZZY_ARCH=arm64` so the image is built for it.
+
+
+### Troubleshooting
+
+- **No certificate.** Check that DNS resolves to the server and that ports 80 and
+  443 are open. `bin/kamal proxy logs` shows the certificate requests.
+- **No sign-in emails.** `bin/kamal logs` shows the delivery errors. Verify the
+  `SMTP_*` values and that `MAILER_FROM_ADDRESS` is allowed by your provider.
+- **Links point at the wrong host.** `APP_HOST` in `config/deploy.yml` sets the
+  host used in emails and other generated URLs.
+- **Nothing boots.** `bin/kamal app logs` and `bin/kamal app details` tell you why;
+  a missing secret is the usual reason.
diff --git a/test/config/deploy_test.rb b/test/config/deploy_test.rb
new file mode 100644
index 0000000..9086d34
--- /dev/null
+++ b/test/config/deploy_test.rb
@@ -0,0 +1,74 @@
+require "test_helper"
+require "kamal"
+
+class DeployTest < ActiveSupport::TestCase
+  CONFIG_FILE = Rails.root.join("config/deploy.yml")
+  SECRETS_FILE = Rails.root.join(".kamal/secrets")
+
+  setup do
+    @deploy = YAML.safe_load(ERB.new(File.read(CONFIG_FILE)).result, aliases: true)
+  end
+
+  test "kamal accepts the deploy configuration" do
+    config = Kamal::Configuration.create_from(config_file: CONFIG_FILE, version: "test")
+
+    assert_equal "fizzy", config.service
+    assert_equal 1, config.all_hosts.size
+  end
+
+  test "one box runs the web server and the jobs in a single container" do
+    assert_equal [ "web" ], @deploy["servers"].keys
+    assert_equal 1, @deploy["servers"]["web"].size
+    assert_equal true, env("SOLID_QUEUE_IN_PUMA")
+    assert_equal "sqlite", env("DATABASE_ADAPTER")
+    assert_equal "local", env("ACTIVE_STORAGE_SERVICE")
+  end
+
+  test "the proxy terminates SSL for the app host" do
+    assert_equal true, @deploy["proxy"]["ssl"]
+    assert_equal env("APP_HOST"), @deploy["proxy"]["host"]
+    assert_equal 80, @deploy["proxy"]["app_port"]
+    assert_equal "/up", @deploy["proxy"].dig("healthcheck", "path")
+  end
+
+  test "data survives deploys in a volume" do
+    assert_includes @deploy["volumes"], "fizzy_storage:/rails/storage"
+  end
+
+  test "the mail server is configured" do
+    assert env("SMTP_ADDRESS").present?
+    assert env("MAILER_FROM_ADDRESS").present?
+    assert_includes @deploy["env"]["secret"], "SMTP_PASSWORD"
+  end
+
+  test "every secret referenced by the deploy configuration is declared in .kamal/secrets" do
+    declared = File.readlines(SECRETS_FILE).filter_map { |line| line[/\A([A-Z][A-Z0-9_]*)=/, 1] }
+    referenced = @deploy["env"]["secret"] + Array(@deploy["registry"]["password"])
+
+    assert_equal [], referenced - declared
+  end
+
+  test "the hostname and the mail server can be set from the environment" do
+    deploy = with_env("FIZZY_HOST" => "fizzy.example.org", "FIZZY_SMTP_ADDRESS" => "smtp.example.org") do
+      YAML.safe_load(ERB.new(File.read(CONFIG_FILE)).result, aliases: true)
+    end
+
+    assert_equal "fizzy.example.org", deploy["proxy"]["host"]
+    assert_equal "fizzy.example.org", deploy.dig("env", "clear", "APP_HOST")
+    assert_equal "fizzy.example.org", deploy["servers"]["web"].sole
+    assert_equal "smtp.example.org", deploy.dig("env", "clear", "SMTP_ADDRESS")
+  end
+
+  private
+    def env(name)
+      @deploy.dig("env", "clear", name)
+    end
+
+    def with_env(values)
+      original = ENV.to_hash
+      ENV.update(values)
+      yield
+    ensure
+      ENV.replace(original)
+    end
+end
