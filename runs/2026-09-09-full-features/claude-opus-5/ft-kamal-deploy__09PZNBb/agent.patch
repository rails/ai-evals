@@ -0,0 +1,37 @@
+# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
+# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
+# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.
+
+# Option 1: Read secrets from the environment
+#
+#   SECRET_KEY_BASE=$SECRET_KEY_BASE bin/kamal deploy
+#
+# Option 2: Read secrets via a command
+#
+#   SECRET_KEY_BASE=$(cat ~/.fizzy/secret_key_base)
+#
+# Option 3: Read secrets via a password manager CLI, e.g. 1Password
+#
+#   SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from MyVault/Fizzy \
+#     KAMAL_REGISTRY_PASSWORD SECRET_KEY_BASE SMTP_PASSWORD VAPID_PUBLIC_KEY VAPID_PRIVATE_KEY)
+#   KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
+#   SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE ${SECRETS})
+
+# An access token for the registry you push the image to. On GitHub, a personal
+# access token (classic) with the write:packages scope.
+KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
+
+# Signs cookies and other secrets. Generate one once and keep it forever,
+# otherwise everyone gets logged out on the next deploy:
+#
+#   bin/rails secret
+SECRET_KEY_BASE=$SECRET_KEY_BASE
+
+# The password for the SMTP_USER_NAME configured in config/deploy.yml.
+SMTP_PASSWORD=$SMTP_PASSWORD
+
+# Web push notifications. Generate a pair once with:
+#
+#   bin/rails runner 'key = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{key.public_key}"; puts "VAPID_PRIVATE_KEY=#{key.private_key}"'
+VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
+VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
