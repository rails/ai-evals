+++ b/test/models/account/storage_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @account = accounts("37s")
+  end
+
+  test "accounts without attachments use no storage" do
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "adding up the storage used by every board" do
+    cards(:logo).image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    boards(:private).update! public_description: embedding(create_blob)
+    perform_enqueued_jobs
+
+    assert_equal 2 * moon_size, @account.bytes_used
+  end
+
+  test "ignoring the storage used by other accounts" do
+    cards(:logo).image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    perform_enqueued_jobs
+
+    assert_equal moon_size, @account.bytes_used
+    assert_equal 0, accounts(:initech).bytes_used
+  end
+
+  private
+    def create_blob
+      ActiveStorage::Blob.create_and_upload! io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    end
+
+    def embedding(blob)
+      %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+
+    def moon_size
+      file_fixture("moon.jpg").size
+    end
+end
diff --git a/test/models/board/storage_test.rb b/test/models/board/storage_test.rb
new file mode 100644
index 0000000..598198f
--- /dev/null
+++ b/test/models/board/storage_test.rb
@@ -0,0 +1,145 @@
+require "test_helper"
+
+class Board::StorageTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "boards without attachments use no storage" do
+    assert_equal 0, @board.bytes_used
+  end
+
+  test "counting card images" do
+    attach_image_to @card
+    perform_enqueued_jobs
+
+    assert_bytes_used moon_size, @board
+  end
+
+  test "counting files embedded in card descriptions" do
+    @card.update! description: embedding(create_blob)
+    perform_enqueued_jobs
+
+    assert_bytes_used moon_size, @board
+  end
+
+  test "counting files embedded in comments" do
+    @card.comments.create! body: embedding(create_blob)
+    perform_enqueued_jobs
+
+    assert_bytes_used moon_size, @board
+  end
+
+  test "counting files embedded in the board description" do
+    @board.update! public_description: embedding(create_blob)
+    perform_enqueued_jobs
+
+    assert_bytes_used moon_size, @board
+  end
+
+  test "ignoring attachments that belong to no board" do
+    users(:david).avatar.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "counting attachments that no background job has caught up with yet" do
+    attach_image_to @card
+
+    assert_equal moon_size, Board.find(@board.id).bytes_used
+  end
+
+  test "counting on the fly caches the total for the next read" do
+    attach_image_to @card
+    clear_enqueued_jobs
+
+    assert_equal moon_size, Board.find(@board.id).bytes_used
+
+    perform_enqueued_jobs
+
+    assert_equal moon_size, @board.reload.read_attribute(:bytes_used)
+  end
+
+  test "removing an embedded file frees up its storage" do
+    @card.update! description: embedding(create_blob)
+    @card.update! description: "Nothing to see here"
+    perform_enqueued_jobs
+
+    assert_bytes_used 0, @board
+  end
+
+  test "purging a card image frees up its storage" do
+    attach_image_to @card
+    perform_enqueued_jobs
+    assert_bytes_used moon_size, @board
+
+    @card.image.purge_later
+    perform_enqueued_jobs
+
+    assert_bytes_used 0, @board
+  end
+
+  test "destroying a card frees up its storage" do
+    attach_image_to @card
+    @card.destroy
+    perform_enqueued_jobs
+
+    assert_bytes_used 0, @board
+  end
+
+  test "destroying a comment frees up its storage" do
+    comment = @card.comments.create! body: embedding(create_blob)
+    comment.destroy
+    perform_enqueued_jobs
+
+    assert_bytes_used 0, @board
+  end
+
+  test "moving a card takes its storage along" do
+    other_board = boards(:private)
+
+    attach_image_to @card
+    @card.move_to other_board
+    perform_enqueued_jobs
+
+    assert_bytes_used 0, @board
+    assert_bytes_used moon_size, other_board
+  end
+
+  test "recalculating in the background caches the total" do
+    attach_image_to @card
+    assert_nil @board.reload.read_attribute(:bytes_used)
+
+    perform_enqueued_jobs
+
+    assert_equal moon_size, @board.reload.read_attribute(:bytes_used)
+  end
+
+  private
+    def assert_bytes_used(expected, board)
+      board.reload
+
+      assert_equal expected, board.read_attribute(:bytes_used), "Expected the total to be cached in the background"
+      assert_equal expected, board.bytes_used
+    end
+
+    def attach_image_to(card)
+      card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    end
+
+    def create_blob
+      ActiveStorage::Blob.create_and_upload! io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    end
+
+    def embedding(blob)
+      %(<action-text-attachment sgid="#{blob.attachable_sgid}"></action-text-attachment>)
+    end
+
+    def moon_size
+      file_fixture("moon.jpg").size
+    end
+end
