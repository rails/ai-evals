--- a/config/initializers/active_storage.rb
+++ b/config/initializers/active_storage.rb
@@ -26,6 +26,32 @@ ActiveSupport.on_load(:active_storage_record) do
   end
 end
 
+module ActiveStorage
+  module Extensions
+    module Attachment
+      extend ActiveSupport::Concern
+
+      included do
+        after_commit :recalculate_board_bytes_used_later, on: [ :create, :destroy ]
+      end
+
+      # Purging an attachment deletes it without running any callbacks.
+      def delete
+        super.tap { recalculate_board_bytes_used_later }
+      end
+
+      private
+        def recalculate_board_bytes_used_later
+          record.try(:board)&.recalculate_bytes_used_later
+        end
+    end
+  end
+end
+
+ActiveSupport.on_load(:active_storage_attachment) do
+  include ActiveStorage::Extensions::Attachment
+end
+
 module ActiveStorageControllerExtensions
   extend ActiveSupport::Concern
 
