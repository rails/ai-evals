+class User::Export::CardWriter
+  Entry = Struct.new(:path, :blob, :owner)
+
+  attr_reader :card
+
+  def initialize(card)
+    @card = card
+    @filenames = Set.new
+  end
+
+  def write_to(zip)
+    zip.add_file "#{directory}/card.json", card_json.to_json
+
+    files.each do |file|
+      zip.add_file(file.path, compress: false) do |sink|
+        file.blob.download { |chunk| sink.write(chunk) }
+      end
+    end
+  end
+
+  private
+    def directory
+      "cards/#{card.number}"
+    end
+
+    def card_json
+      {
+        id: card.id,
+        number: card.number,
+        title: card.title,
+        description: card.description.to_plain_text,
+        description_html: card.description.to_s,
+        status: card.status,
+        closed: card.closed?,
+        closed_at: card.closed_at&.utc,
+        postponed: card.postponed?,
+        golden: card.golden?,
+        tags: card.tags.map(&:title).sort,
+        board: { id: card.board.id, name: card.board.name },
+        column: card.column && { id: card.column.id, name: card.column.name },
+        creator: user_json(card.creator),
+        assignees: card.assignees.map { |user| user_json(user) },
+        steps: card.steps.map { |step| { content: step.content, completed: step.completed? } },
+        reactions: reactions_json(card.reactions),
+        files: files_json(card),
+        comments: card.comments.chronologically.map { |comment| comment_json(comment) },
+        created_at: card.created_at.utc,
+        last_active_at: card.last_active_at.utc
+      }
+    end
+
+    def comment_json(comment)
+      {
+        id: comment.id,
+        body: comment.body.to_plain_text,
+        body_html: comment.body.to_s,
+        creator: user_json(comment.creator),
+        reactions: reactions_json(comment.reactions),
+        files: files_json(comment),
+        created_at: comment.created_at.utc,
+        updated_at: comment.updated_at.utc
+      }
+    end
+
+    def user_json(user)
+      { id: user.id, name: user.name, email_address: user.identity&.email_address }
+    end
+
+    def reactions_json(reactions)
+      reactions.map { |reaction| { content: reaction.content, reacter: user_json(reaction.reacter) } }
+    end
+
+    def files_json(owner)
+      files.select { |file| file.owner == owner }.collect do |file|
+        { path: file.path, filename: file.blob.filename.to_s, content_type: file.blob.content_type, byte_size: file.blob.byte_size }
+      end
+    end
+
+    # Every picture and file attached to the card and its comments
+    def files
+      @files ||= [].tap do |files|
+        files << file_for(card.image.blob, card) if card.image.attached?
+        card.attachments.each { |attachment| files << file_for(attachment.blob, card) }
+        card.comments.each { |comment| comment.attachments.each { |attachment| files << file_for(attachment.blob, comment) } }
+      end
+    end
+
+    def file_for(blob, owner)
+      Entry.new("#{directory}/files/#{unique_filename_for(blob)}", blob, owner)
+    end
+
+    def unique_filename_for(blob)
+      filename = blob.filename.sanitized
+      filename = "#{blob.filename.base}-#{blob.id.last(6)}.#{blob.filename.extension}" if @filenames.include?(filename)
+      @filenames << filename
+      filename
+    end
+end
