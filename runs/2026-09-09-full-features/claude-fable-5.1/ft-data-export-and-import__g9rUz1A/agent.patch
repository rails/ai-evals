--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,75 @@
+# A ZIP file of someone's data, put together in the background and emailed as a download link.
+# Which data goes in the file is up to each kind of export.
+class Export < ApplicationRecord
+  DOWNLOAD_EXPIRY = 1.day
+
+  belongs_to :account
+  belongs_to :user
+
+  has_one_attached :file
+
+  enum :status, %w[ pending processing completed failed ].index_by(&:itself), default: :pending
+
+  scope :expired, -> { where(completed_at: ...DOWNLOAD_EXPIRY.ago) }
+  scope :stale, -> { where(status: :failed, updated_at: ...DOWNLOAD_EXPIRY.ago) }
+  scope :in_progress, -> { where(status: %i[ pending processing ]) }
+
+  after_create_commit :process_later
+
+  class << self
+    def cleanup
+      expired.or(stale).find_each(&:destroy)
+    end
+  end
+
+  def process_later
+    ExportJob.perform_later(self)
+  end
+
+  def process_now
+    processing!
+    write_file
+    update! status: :completed, completed_at: Time.current
+    ExportMailer.ready(self).deliver_later
+  rescue => error
+    failed!
+    ExportMailer.failed(self).deliver_later
+    raise
+  end
+
+  def downloadable?
+    completed? && !expired?
+  end
+
+  def expired?
+    completed_at.present? && completed_at < DOWNLOAD_EXPIRY.ago
+  end
+
+  def expires_at
+    completed_at + DOWNLOAD_EXPIRY if completed_at
+  end
+
+  def accessible_to?(user)
+    user == self.user
+  end
+
+  def filename
+    "fizzy-#{name.parameterize}-#{created_at.strftime("%Y%m%d%H%M")}.zip"
+  end
+
+  private
+    def write_file
+      ZipFile.create_for(file, filename: filename) do |zip|
+        write_to(zip)
+      end
+    end
+
+    # Template methods
+    def name
+      raise NotImplementedError
+    end
+
+    def write_to(zip)
+      raise NotImplementedError
+    end
+end
