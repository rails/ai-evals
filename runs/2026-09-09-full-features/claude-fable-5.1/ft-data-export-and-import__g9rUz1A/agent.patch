+++ b/app/models/account/data_transfer.rb
@@ -0,0 +1,10 @@
+# Moves whole accounts between Fizzy instances as ZIP files.
+#
+# An export holds a manifest.json header, one directory per table with the account's rows
+# serialized as JSON in batches, and the contents of every file under files/. Imports read
+# that structure back, creating a brand new account with fresh IDs for every record.
+module Account::DataTransfer
+  FORMAT = "fizzy-account-export"
+  VERSION = 1
+  MANIFEST_FILENAME = "manifest.json"
+end
