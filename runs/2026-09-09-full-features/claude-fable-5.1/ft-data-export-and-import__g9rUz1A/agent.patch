+<% @page_title = "Import a Fizzy account" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Import an account</h1>
+
+  <p class="margin-none">Bring back an account exported from Fizzy. You’ll get a brand new account with everything in it: boards, cards, comments, files, and people.</p>
+
+  <%= form_with model: @import, url: account_imports_path, scope: :import, class: "flex flex-column gap", data: { turbo: false } do |form| %>
+    <label class="flex flex-column gap-half">
+      <span class="txt-medium">Export file (.zip)</span>
+      <%= form.file_field :file, required: true, accept: "application/zip,.zip", class: "input full-width" %>
+    </label>
+
+    <p class="txt-small margin-none">Importing can take a while for big accounts. We’ll email you at <strong><%= Current.identity.email_address %></strong> when it’s done.</p>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Import</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
