@@ -0,0 +1,93 @@
+require "test_helper"
+
+class Account::ExportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as users(:kevin)
+  end
+
+  test "an admin can request an export of the account" do
+    assert_difference -> { Account::Export.count }, +1 do
+      assert_enqueued_with job: ExportJob do
+        post account_exports_url
+      end
+    end
+
+    export = Account::Export.last
+    assert_equal accounts(:"37s"), export.account
+    assert_equal users(:kevin), export.user
+    assert_redirected_to account_settings_url
+    assert_match(/download link/, flash[:notice])
+  end
+
+  test "only one export runs at a time per account" do
+    post account_exports_url
+
+    assert_no_difference -> { Account::Export.count } do
+      post account_exports_url
+    end
+    assert_redirected_to account_settings_url
+
+    Account::Export.last.update!(status: :completed, completed_at: Time.current)
+
+    assert_difference -> { Account::Export.count }, +1 do
+      post account_exports_url
+    end
+  end
+
+  test "members can't export the account" do
+    logout_and_sign_in_as users(:david)
+
+    assert_no_difference -> { Account::Export.count } do
+      post account_exports_url
+    end
+
+    assert_response :forbidden
+  end
+
+  test "a completed export redirects to its file" do
+    export = Account::Export.create!(account: accounts(:"37s"), user: users(:kevin))
+    export.process_now
+
+    get account_export_url(export)
+    assert_redirected_to rails_blob_path(export.file, disposition: "attachment")
+
+    follow_redirect!
+    assert_response :redirect
+  end
+
+  test "an export that isn't ready yet explains so" do
+    export = Account::Export.create!(account: accounts(:"37s"), user: users(:kevin))
+
+    get account_export_url(export)
+    assert_response :success
+    assert_select "h2", text: /still packing up/
+  end
+
+  test "an expired export can't be downloaded anymore" do
+    export = Account::Export.create!(account: accounts(:"37s"), user: users(:kevin))
+    export.process_now
+
+    travel Export::DOWNLOAD_EXPIRY + 1.minute do
+      get account_export_url(export)
+    end
+
+    assert_response :success
+    assert_select "h2", text: /expired/
+  end
+
+  test "exports from other accounts can't be found" do
+    export = Account::Export.create!(account: accounts(:initech), user: users(:mike))
+
+    get account_export_url(export)
+    assert_response :not_found
+  end
+
+  test "the settings page offers exports to admins" do
+    get account_settings_url
+    assert_select "form[action=?]", account_exports_path
+
+    logout_and_sign_in_as users(:david)
+    get account_settings_url
+    assert_select "form[action=?]", account_exports_path, count: 0
+  end
+end
