+<% @page_title = "Export" %>
+<% back_path = @export.is_a?(Account::Export) ? account_settings_path : user_path(Current.user) %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<div class="settings margin-block-start-half">
+  <div class="settings__panel panel shadow center txt-align-center">
+    <% if @export.expired? %>
+      <h2 class="txt-large margin-block-end-half">This download link has expired</h2>
+      <p>Download links work for <%= distance_of_time_in_words(Export::DOWNLOAD_EXPIRY) %>. You can request a fresh export at any time.</p>
+    <% elsif @export.failed? %>
+      <h2 class="txt-large margin-block-end-half">This export couldn’t be completed</h2>
+      <p>Something went wrong while packing up your data. Please request a new export.</p>
+    <% else %>
+      <h2 class="txt-large margin-block-end-half">We’re still packing up your data</h2>
+      <p>You’ll get an email with a download link as soon as it’s ready.</p>
