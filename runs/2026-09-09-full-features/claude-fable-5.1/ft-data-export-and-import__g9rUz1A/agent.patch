+class ExportMailerPreview < ActionMailer::Preview
+  def ready
+    ExportMailer.ready(export)
+  end
+
+  def failed
+    ExportMailer.failed(export.tap(&:failed!))
+  end
+
+  private
+    def export
+      user = User.active.joins(:identity).sample
+      Current.account = user.account
+
+      Account::Export.new(account: user.account, user: user, status: :completed, completed_at: Time.current, created_at: Time.current).tap do |export|
+        export.define_singleton_method(:process_later) { }
+        export.save!
+      end
+    end
+end
