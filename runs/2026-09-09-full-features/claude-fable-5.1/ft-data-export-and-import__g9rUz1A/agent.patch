@@ -0,0 +1,22 @@
+<% @page_title = "Importing an account" %>
+
+<div class="panel panel--centered flex flex-column gap">
+  <% if @import.completed? %>
+    <h1 class="txt-x-large font-weight-black margin-none">Your import is done</h1>
+    <p class="margin-none"><strong><%= @import.account.name %></strong> is ready, with all of its boards, cards, comments, files, and people.</p>
+    <%= link_to "Go to #{@import.account.name}", landing_path(script_name: @import.account.slug), class: "btn btn--link center txt-medium" %>
+  <% elsif @import.failed? %>
+    <h1 class="txt-x-large font-weight-black margin-none">Your import couldn’t be completed</h1>
+    <p class="margin-none">Nothing was imported. Here’s what went wrong:</p>
+    <p class="margin-none"><strong><%= @import.failure_reason %></strong></p>
+    <%= link_to "Try again with another file", new_account_import_path, class: "btn center" %>
+  <% else %>
+    <h1 class="txt-x-large font-weight-black margin-none">We’re importing your account</h1>
+    <p class="margin-none">This can take a while for big accounts. We’ll email you at <strong><%= @import.identity.email_address %></strong> when it’s done, or if something goes wrong.</p>
+    <%= link_to "Choose an account", session_menu_path, class: "btn center" %>
+  <% end %>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
