+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin
+  before_action :set_export, only: :show
+
+  def create
+    exports.create!(user: Current.user) if exports.in_progress.none?
+
+    redirect_to account_settings_path, notice: "We’re packing up your account. You’ll get an email with a download link when it’s ready."
+  end
+
+  def show
+    if @export.downloadable?
+      redirect_to rails_blob_path(@export.file, disposition: "attachment")
+    else
+      render "exports/show"
+    end
+  end
+
+  private
+    def exports
+      Account::Export.where(account: Current.account)
+    end
+
+    def set_export
+      @export = exports.find(params[:id])
+    end
+end
