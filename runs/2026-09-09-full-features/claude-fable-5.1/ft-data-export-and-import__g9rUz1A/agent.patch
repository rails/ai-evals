+class Account::DataTransfer::Exporter
+  attr_reader :account
+
+  def initialize(account)
+    @account = account
+  end
+
+  def export_to(zip)
+    zip.add_file Account::DataTransfer::MANIFEST_FILENAME, manifest_header.to_json
+
+    Account::DataTransfer::Manifest.new(account).each_record_set do |record_set|
+      record_set.export_to(zip)
+    end
+  end
+
+  private
+    def manifest_header
+      {
+        format: Account::DataTransfer::FORMAT,
+        version: Account::DataTransfer::VERSION,
+        exported_at: Time.current.utc.iso8601(6),
+        account: { id: account.id, name: account.name }
+      }
+    end
+end
diff --git a/app/models/account/data_transfer/filter_record_set.rb b/app/models/account/data_transfer/filter_record_set.rb
new file mode 100644
index 0000000..4c4d470
--- /dev/null
+++ b/app/models/account/data_transfer/filter_record_set.rb
@@ -0,0 +1,30 @@
+# Filters keep IDs of cards and columns in their fields, and a digest of all their params
+# that has to be worked out again once every ID they point at has been remapped.
+class Account::DataTransfer::FilterRecordSet < Account::DataTransfer::RecordSet
+  REMAPPED_FIELDS = %w[ card_ids column_ids ]
+
+  def initialize(account)
+    super(account: account, model: Filter)
+  end
+
+  private
+    def deserialize(row, id_mapper)
+      super.tap do |values|
+        if fields = values["fields"]
+          REMAPPED_FIELDS.each do |name|
+            fields[name] = fields[name].map { |id| id_mapper.map(id) } if fields[name].is_a?(Array)
+          end
+        end
+      end
+    end
+
+    # Digests cover the tags, boards and people a filter refers to, so they can only be worked
+    # out once those join rows are in: filter resources are imported right before filters.
+    def import_rows(rows)
+      super
+
+      Filter.where(id: rows.map { |row| row["id"] }).find_each do |filter|
+        filter.update_columns params_digest: Filter.digest_params(filter.as_params)
+      end
+    end
+end
diff --git a/app/models/account/data_transfer/filter_resource_record_set.rb b/app/models/account/data_transfer/filter_resource_record_set.rb
new file mode 100644
index 0000000..7c3414f
--- /dev/null
+++ b/app/models/account/data_transfer/filter_resource_record_set.rb
@@ -0,0 +1,27 @@
+# The join tables between filters and the boards, tags and users they filter by have no account
+# of their own, so their rows are found through the account's filters.
+class Account::DataTransfer::FilterResourceRecordSet < Account::DataTransfer::RecordSet
+  RESOURCES = %i[ tags boards assignees creators closers ]
+
+  def self.all_for(account)
+    RESOURCES.map { |resource| new(account, resource) }
+  end
+
+  def initialize(account, resource)
+    super(account: account, model: Filter.const_get("HABTM_#{resource.to_s.camelize}"))
+  end
+
+  # Join rows have no primary key to batch by, but there are only a handful of them per filter
+  def export_to(zip)
+    with_zip(zip) do
+      records.to_a.each_slice(BATCH_SIZE).with_index do |batch, index|
+        write_rows batch.map { |record| serialize(record) }, index: index
+      end
+    end
+  end
+
+  private
+    def records
+      model.where(filter_id: Filter.where(account_id: account.id).select(:id))
+    end
+end
diff --git a/app/models/account/data_transfer/id_mapper.rb b/app/models/account/data_transfer/id_mapper.rb
new file mode 100644
index 0000000..aa11e69
--- /dev/null
+++ b/app/models/account/data_transfer/id_mapper.rb
@@ -0,0 +1,28 @@
+# Every imported record gets a new ID, so that the same export can be imported more than once,
+# even into the instance it came from. IDs are derived deterministically from the original ID
+# and a salt unique to the import, so every reference to a record maps to the same new ID
+# without keeping the whole mapping in memory. The UUIDv7 timestamp is preserved to keep
+# records sorting in the same order they did before.
+class Account::DataTransfer::IdMapper
+  def initialize(salt)
+    @salt = salt.to_s
+  end
+
+  def map(uuid)
+    if uuid.present?
+      ActiveRecord::Type::Uuid.hex_to_base36 remapped_hex(uuid)
+    end
+  end
+
+  private
+    def remapped_hex(uuid)
+      timestamp = ActiveRecord::Type::Uuid.base36_to_hex(uuid).first(12)
+      random = Digest::SHA256.hexdigest("#{@salt}/#{uuid}")
+
+      timestamp + "7" + random[0, 3] + variant_nibble(random[3]) + random[4, 15]
+    end
+
+    def variant_nibble(hex_digit)
+      ((hex_digit.hex & 0x3) | 0x8).to_s(16)
+    end
+end
diff --git a/app/models/account/data_transfer/importer.rb b/app/models/account/data_transfer/importer.rb
new file mode 100644
index 0000000..cb3cfc0
--- /dev/null
+++ b/app/models/account/data_transfer/importer.rb
@@ -0,0 +1,51 @@
+# Creates a brand new account out of an export. Everything happens in a single transaction and
+# uploaded files are discarded on failure, so an import that can't be completed leaves nothing behind.
+class Account::DataTransfer::Importer
+  class InvalidFile < StandardError; end
+
+  attr_reader :zip, :id_mapper
+
+  def initialize(zip, id_mapper:)
+    @zip = zip
+    @id_mapper = id_mapper
+  end
+
+  def import
+    header = read_manifest_header
+
+    Account.transaction do
+      manifest.each_record_set { |record_set| record_set.import_from(zip, id_mapper) }
+
+      Account.find(id_mapper.map(header.dig("account", "id"))).tap do |account|
+        yield account if block_given?
+      end
+    end
+  rescue
+    manifest.each_record_set(&:rollback_import)
+    raise
+  end
+
+  private
+    def read_manifest_header
+      unless zip.exists?(Account::DataTransfer::MANIFEST_FILENAME)
+        raise InvalidFile, "The file doesn't look like a Fizzy account export"
+      end
+
+      JSON.parse(zip.read(Account::DataTransfer::MANIFEST_FILENAME)).tap do |header|
+        unless header["format"] == Account::DataTransfer::FORMAT && header.dig("account", "id").present?
+          raise InvalidFile, "The file doesn't look like a Fizzy account export"
+        end
+
+        if header["version"].to_i > Account::DataTransfer::VERSION
+          raise InvalidFile, "The file was exported by a newer version of Fizzy and can't be imported here"
+        end
+      end
+    rescue JSON::ParserError
+      raise InvalidFile, "The file doesn't look like a Fizzy account export"
+    end
+
+    # Imports have no account until the account record set creates one
+    def manifest
+      @manifest ||= Account::DataTransfer::Manifest.new(nil)
+    end
+end
