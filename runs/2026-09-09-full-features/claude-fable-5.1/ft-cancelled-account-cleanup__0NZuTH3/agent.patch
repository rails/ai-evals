diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..48ca1ee
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,39 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than 30 days ago" do
+    due = accounts(:"37s")
+    due.cancel(initiated_by: users(:david))
+
+    travel 31.days
+
+    recently_cancelled = accounts(:initech)
+    recently_cancelled.cancel(initiated_by: users(:kevin))
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(due.id)
+    assert_empty User.where(account_id: due.id)
+    assert_empty Board.where(account_id: due.id)
+    assert_empty Card.where(account_id: due.id)
+
+    assert Account.exists?(recently_cancelled.id)
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  test "leaves active accounts alone" do
+    travel 31.days
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  test "is scheduled as a recurring task" do
+    recurring = Rails.application.config_for(:recurring, env: "production")
+
+    assert_equal "Account::IncinerateDueJob", recurring.dig(:incinerate_due_accounts, :class)
+  end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..7fc64be
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @account.cancel(initiated_by: users(:david))
+  end
+
+  test "due for incineration once the grace period has passed" do
+    assert_not @account.due_for_incineration?
+    assert_not_includes Account.due_for_incineration, @account
+
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    assert @account.due_for_incineration?
+    assert_includes Account.due_for_incineration, @account
+  end
+
+  test "active accounts are never due for incineration" do
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    assert_not accounts(:initech).due_for_incineration?
+    assert_not_includes Account.due_for_incineration, accounts(:initech)
+  end
+
+  test "incinerate removes the account and everything in it" do
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    @account.incinerate
+
+    assert_not Account.exists?(@account.id)
+    assert_empty records_belonging_to(@account)
+    assert_empty Storage::Total.where(owner: @account)
+  end
+
+  test "incinerate removes the storage ledger" do
+    Storage::Entry.record account: @account, board: boards(:writebook), delta: 100, operation: "attach"
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    @account.incinerate
+
+    assert_empty Storage::Entry.where(account_id: @account.id)
+  end
+
+  test "incinerate purges blobs that were never attached" do
+    blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("orphaned"), filename: "orphaned.txt")
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+
+    assert_enqueued_with job: ActiveStorage::PurgeJob, args: [ blob ] do
+      @account.incinerate
+    end
+  end
+
+  test "incinerate does nothing before the grace period has passed" do
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert @account.reload.cancelled?
+  end
+
+  test "incinerate does nothing if the account was reactivated in the meantime" do
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+    Account.find(@account.id).reactivate
+
+    assert_no_difference -> { Account.count } do
+      @account.incinerate
+    end
+
+    assert @account.reload.active?
+  end
+
+  test "incinerate_due only incinerates the accounts that are due" do
+    recently_cancelled = accounts(:initech)
+    travel Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day
+    recently_cancelled.cancel(initiated_by: users(:kevin))
+
+    assert_difference -> { Account.count }, -1 do
+      Account.incinerate_due
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert Account.exists?(recently_cancelled.id)
+    assert Account.exists?(accounts(:acme).id)
+  end
+
+  private
+    def records_belonging_to(account)
+      Rails.application.eager_load!
+
+      account_scoped_models.flat_map do |model|
+        model.unscoped.where(account_id: account.id).to_a
+      end
+    end
+
+    def account_scoped_models
+      ActiveRecord::Base.descendants.select do |model|
+        !model.abstract_class? && model.table_exists? && model.base_class == model && model.column_names.include?("account_id")
+      end
+    end
+end
