diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..e4e1308 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,39 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    has_many :blobs, class_name: "ActiveStorage::Blob"
+
+    scope :due_for_incineration, -> { joins(:cancellation).merge(Account::Cancellation.older_than(INCINERATION_GRACE_PERIOD)) }
+  end
+
+  class_methods do
+    def incinerate_due
+      due_for_incineration.find_each(&:incinerate)
+    end
+  end
+
+  # Permanently removes the account and everything in it. Only proceeds if the account
+  # is still due, so an account reactivated in the meantime is left alone.
+  def incinerate
+    with_lock do
+      if due_for_incineration?
+        purge_unattached_blobs
+        destroy!
+      end
+    end
+  end
+
+  def due_for_incineration?
+    cancelled? && cancellation.older_than?(INCINERATION_GRACE_PERIOD)
+  end
+
+  private
+    # Blobs still attached to a record are purged along with it, but blobs uploaded and
+    # never attached would otherwise be left behind.
+    def purge_unattached_blobs
+      blobs.unattached.find_each(&:purge_later)
+    end
 end
