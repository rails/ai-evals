diff --git a/app/models/card/entropy.rb b/app/models/card/entropy.rb
index 62de5fc..2a79b5c 100644
--- a/app/models/card/entropy.rb
+++ b/app/models/card/entropy.rb
@@ -1,4 +1,9 @@
 class Card::Entropy
+  STALLED_AFTER = 2.weeks
+  BURST_COMMENTS_COUNT = 3
+  BURST_COMMENTERS_COUNT = 2
+  BURST_EVENT_ACTIONS = %w[ card_assigned card_reopened ]
+
   attr_reader :card, :auto_clean_period
 
   class << self
@@ -21,4 +26,49 @@ class Card::Entropy
   def days_before_reminder
     (auto_clean_period * 0.25).seconds.in_days.round
   end
+
+  # A card that got a burst of attention and has since gone quiet for a couple of weeks.
+  def stalled?
+    stallable? && inactive_for_too_long?
+  end
+
+  # When the card will be (or was) considered stalled, unless it sees activity before that.
+  def stalled_at
+    card.last_active_at + STALLED_AFTER if stallable?
+  end
+
+  def stallable?
+    card.active? && burst?
+  end
+
+  # A card gets a burst when several people pile comments on it within a third of
+  # the auto-clean period, or when someone is assigned to it or reopens it. The
+  # window is anchored to the card's last activity, so any new activity resets it.
+  def burst?
+    burst_of_comments? || burst_event?
+  end
+
+  def burst_period
+    auto_clean_period / 3
+  end
+
+  private
+    def burst_of_comments?
+      comments, commenters = card.comments.by_user.where(created_at: burst_window)
+        .pick(Arel.sql("COUNT(*)"), Arel.sql("COUNT(DISTINCT comments.creator_id)"))
+
+      comments >= BURST_COMMENTS_COUNT && commenters >= BURST_COMMENTERS_COUNT
+    end
+
+    def burst_event?
+      card.events.where(action: BURST_EVENT_ACTIONS, created_at: burst_window).exists?
+    end
+
+    def burst_window
+      (card.last_active_at - burst_period)..
+    end
+
+    def inactive_for_too_long?
+      card.last_active_at <= STALLED_AFTER.ago
+    end
 end
