+
+class Card::Entropic::StalledTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @card = cards(:logo)
+    @card.comments.delete_all
+    @card.events.delete_all
+    @card.update! last_active_at: 3.weeks.ago
+  end
+
+  test "stalled scope includes cards with a burst of comments that went quiet" do
+    travel_to 3.weeks.ago do
+      @card.comments.create! creator: users(:david), body: "one"
+      @card.comments.create! creator: users(:jz), body: "two"
+      @card.comments.create! creator: users(:david), body: "three"
+    end
+
+    assert_equal [ @card ], Card.stalled.to_a
+    assert_equal [ @card ], Card.indexed_by("stalled").to_a
+  end
+
+  test "stalled scope ignores comments from a single person" do
+    travel_to 3.weeks.ago do
+      3.times { |i| @card.comments.create! creator: users(:david), body: "comment #{i}" }
+    end
+
+    assert_empty Card.stalled
+  end
+
+  test "stalled scope includes assigned and reopened cards that went quiet" do
+    travel_to(3.weeks.ago) { @card.toggle_assignment users(:david) }
+
+    radio = cards(:radio)
+    radio.update! last_active_at: 3.weeks.ago
+    travel_to(3.weeks.ago) { radio.events.create! action: "card_reopened", creator: radio.creator, board: radio.board }
+
+    assert_equal [ @card, radio ].to_set, Card.stalled.to_set
+  end
+
+  test "stalled scope excludes cards with recent activity" do
+    travel_to(1.week.ago) { @card.toggle_assignment users(:david) }
+
+    assert_empty Card.stalled
+  end
+
+  test "stalled scope excludes closed and postponed cards" do
+    travel_to(3.weeks.ago) { @card.toggle_assignment users(:david) }
+    assert_includes Card.stalled, @card
+
+    @card.postpone
+    @card.update! last_active_at: 3.weeks.ago
+    assert_empty Card.stalled
+
+    @card.resume
+    @card.close
+    @card.update! last_active_at: 3.weeks.ago
+    assert_empty Card.stalled
+  end
+
+  test "stalled scope uses the burst window of the board period, falling back to the account" do
+    travel_to(3.weeks.ago - 20.days) { @card.comments.create! creator: users(:david), body: "one" }
+    travel_to(3.weeks.ago - 4.days) { @card.comments.create! creator: users(:jz), body: "two" }
+    travel_to(3.weeks.ago) { @card.comments.create! creator: users(:david), body: "three" }
+
+    # Board period of 90 days: 30 day window
+    assert_includes Card.stalled, @card
+
+    # Account period of 30 days: 10 day window
+    entropies(:writebook_board).destroy
+    assert_not_includes Card.stalled, @card
+    assert_not @card.reload.stalled?
+  end
+end
diff --git a/test/models/card/entropy_test.rb b/test/models/card/entropy_test.rb
new file mode 100644
index 0000000..bda38b6
--- /dev/null
+++ b/test/models/card/entropy_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class Card::EntropyTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+
+    @card = cards(:logo)
+    @card.comments.delete_all
+    @card.events.delete_all
+    @card.update! last_active_at: 3.weeks.ago
+  end
+
+  test "three comments from two people within a third of the period is a burst" do
+    travel_to 3.weeks.ago do
+      @card.comments.create! creator: users(:david), body: "one"
+      @card.comments.create! creator: users(:jz), body: "two"
+      @card.comments.create! creator: users(:david), body: "three"
+    end
+
+    assert @card.reload.entropy.burst?
+    assert @card.stalled?
+  end
+
+  test "three comments from a single person is not a burst" do
+    travel_to 3.weeks.ago do
+      3.times { |i| @card.comments.create! creator: users(:david), body: "comment #{i}" }
+    end
+
+    assert_not @card.reload.entropy.burst?
+    assert_not @card.stalled?
+  end
+
+  test "system comments do not count towards a burst" do
+    travel_to 3.weeks.ago do
+      @card.comments.create! creator: users(:david), body: "one"
+      @card.comments.create! creator: users(:jz), body: "two"
+      @card.comments.create! creator: accounts("37s").system_user, body: "system"
+    end
+
+    assert_not @card.reload.entropy.burst?
+  end
+
+  test "comments spread over more than a third of the period is not a burst" do
+    burst_period = @card.auto_postpone_period / 3
+
+    travel_to(3.weeks.ago - burst_period - 1.day) { @card.comments.create! creator: users(:david), body: "one" }
+    travel_to(3.weeks.ago - 1.day) { @card.comments.create! creator: users(:jz), body: "two" }
+    travel_to(3.weeks.ago) { @card.comments.create! creator: users(:david), body: "three" }
+
+    assert_not @card.reload.entropy.burst?
+    assert_not @card.stalled?
+  end
+
+  test "an assignment is a burst" do
+    travel_to(3.weeks.ago) { @card.toggle_assignment users(:david) }
+
+    assert @card.reload.entropy.burst?
+    assert @card.stalled?
+  end
+
+  test "reopening is a burst" do
+    travel_to(4.weeks.ago) { @card.close }
+    travel_to(3.weeks.ago) { @card.reopen }
+
+    assert @card.reload.entropy.burst?
+    assert @card.stalled?
+  end
+
+  test "a card with a burst is not stalled until two weeks of silence" do
+    travel_to(1.week.ago) { @card.toggle_assignment users(:david) }
+    @card.reload
+
+    assert @card.entropy.burst?
+    assert_not @card.stalled?
+    assert_equal @card.last_active_at + 2.weeks, @card.entropy.stalled_at
+  end
+
+  test "any activity resets a stalled card" do
+    travel_to(3.weeks.ago) { @card.toggle_assignment users(:david) }
+    assert @card.reload.stalled?
+
+    @card.comments.create! creator: users(:kevin), body: "poke"
+    assert_not @card.reload.stalled?
+  end
+
+  test "a lone comment long after a burst does not keep the card stalled" do
+    entropies(:writebook_board).update! auto_postpone_period: 30.days
+
+    travel_to(6.weeks.ago) { @card.toggle_assignment users(:david) }
+    travel_to(3.weeks.ago) { @card.comments.create! creator: users(:kevin), body: "still here?" }
+
+    assert_not @card.reload.stalled?
+  end
+
+  test "closed, postponed and drafted cards are never stalled" do
+    travel_to(3.weeks.ago) { @card.toggle_assignment users(:david) }
+    assert @card.reload.stalled?
+
+    @card.close
+    @card.update! last_active_at: 3.weeks.ago
+    assert_not @card.reload.stalled?
+    assert_nil @card.entropy.stalled_at
+
+    @card.postpone
+    @card.update! last_active_at: 3.weeks.ago
+    assert_not @card.reload.stalled?
+
+    @card.resume
+    @card.update! status: :drafted, last_active_at: 3.weeks.ago
+    assert_not @card.reload.stalled?
+  end
+
+  test "stalled_at is nil without a burst" do
+    assert_nil @card.entropy.stalled_at
+  end
+end
