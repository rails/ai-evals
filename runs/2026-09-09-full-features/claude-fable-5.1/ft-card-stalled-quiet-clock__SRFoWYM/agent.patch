+        .with_entropy_periods
+        .where("last_active_at > #{connection.date_subtract('?', EFFECTIVE_AUTO_POSTPONE_PERIOD_SQL)}", now)
+        .where("last_active_at <= #{connection.date_subtract('?', "#{EFFECTIVE_AUTO_POSTPONE_PERIOD_SQL} * 0.75")}", now)
+    end
+
+    # Cards that had a burst of attention (see Card::Entropy) and then went quiet.
+    # The burst is looked for within a third of the auto-postpone period leading up
+    # to the card's last activity, so any new activity resets the card.
+    scope :stalled, -> do
+      burst_window_start = connection.date_subtract("cards.last_active_at", "#{EFFECTIVE_AUTO_POSTPONE_PERIOD_SQL} / 3")
+
+      burst_of_comments = Comment.by_user
+        .where("comments.card_id = cards.id")
+        .where("comments.created_at >= #{burst_window_start}")
+        .group(:card_id)
+        .having("COUNT(*) >= ? AND COUNT(DISTINCT comments.creator_id) >= ?", Card::Entropy::BURST_COMMENTS_COUNT, Card::Entropy::BURST_COMMENTERS_COUNT)
+        .select(1)
