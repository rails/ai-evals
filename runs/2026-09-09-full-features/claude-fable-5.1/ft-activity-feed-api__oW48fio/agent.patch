@@ -8,4 +8,24 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def details
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: detail(:old_board), new_board: detail(:new_board) }
+    when "card_title_changed"
+      { old_title: detail(:old_title), new_title: detail(:new_title) }
+    when "card_triaged"
+      { column: detail(:column) }
+    else
+      {}
+    end
+  end
+
+  private
+    def detail(name)
+      particulars.dig("particulars", name.to_s).to_s
+    end
 end
