@@ -0,0 +1,77 @@
+# Activities
+
+Activities are the events that make up the account timeline: cards being added, assigned,
+moved, renamed, closed, reopened, postponed, and commented on.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activities across the boards the current user has access to,
+sorted newest first.
+
+| Parameter | Type | Required | Description |
+|-----------|------|----------|-------------|
+| `creator_ids[]` | array | No | Only include activities performed by these users |
+| `board_ids[]` | array | No | Only include activities from these boards |
+
+The `action` is one of `card_published`, `card_assigned`, `card_unassigned`, `card_closed`,
+`card_reopened`, `card_postponed`, `card_auto_postponed`, `card_board_changed`,
+`card_title_changed`, `card_triaged`, `card_sent_back_to_triage`, or `comment_created`.
+
+The `eventable` is the [card](cards.md) or [comment](comments.md) the activity refers to, as
+indicated by `eventable_type`. The `url` opens the card in Fizzy; for comments, it jumps to the
+comment on its card.
+
+The `particulars` object holds details specific to the kind of activity:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+| Everything else | `{}` |
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_assigned",
+    "eventable_type": "Card",
+    "created_at": "2025-12-05T19:36:35.534Z",
+    "description": "David Heinemeier Hansson assigned Jason Fried to &quot;Plain text mentions&quot;",
+    "particulars": {
+      "assignee_ids": [ "03f5v9zjw7pz8717a4no1h8a8" ]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/3",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 3,
+      "title": "Plain text mentions",
+      "status": "published",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/3"
+    },
+    "board": {
+      "id": "03f5v9zjw7pz8717a4no1h8a9",
+      "name": "Product",
+      "all_access": true,
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zjw7pz8717a4no1h8a9"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  }
+]
+```
+
+The `eventable`, `board`, and `creator` objects are abbreviated above; they use the same
+representations as the [cards](cards.md), [comments](comments.md), [boards](boards.md),
+and [users](users.md) endpoints.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..f2ec946
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,181 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index as JSON" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+    assert @response.parsed_body.any? { |activity| activity["id"] == events(:layout_assignment_jz).id }
+  end
+
+  test "index without an explicit format returns JSON" do
+    get activities_path
+
+    assert_response :success
+    assert_equal "application/json", @response.media_type
+  end
+
+  test "index includes event attributes" do
+    get activities_path, as: :json
+
+    event = events(:layout_assignment_jz)
+    activity = @response.parsed_body.find { |activity| activity["id"] == event.id }
+
+    assert_equal "card_assigned", activity["action"]
+    assert_equal event.created_at.utc.as_json, activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal card_url(cards(:layout)), activity["url"]
+    assert_equal cards(:layout).id, activity.dig("eventable", "id")
+    assert_equal cards(:layout).number, activity.dig("eventable", "number")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_not_nil activity.dig("creator", "avatar_url")
+  end
+
+  test "index renders comment events with the comment and a link to it on the card" do
+    get activities_path, as: :json
+
+    event = events(:layout_commented)
+    activity = @response.parsed_body.find { |activity| activity["id"] == event.id }
+
+    assert_equal "comment_created", activity["action"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comments(:layout_overflowing_david).id, activity.dig("eventable", "id")
+    assert_equal card_url(cards(:layout), anchor: dom_id(comments(:layout_overflowing_david))), activity["url"]
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "index exposes assignment particulars" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == events(:layout_assignment_jz).id }
+
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity["particulars"])
+  end
+
+  test "index exposes title change particulars" do
+    event = track_event_as(:david, cards(:logo), "title_changed", particulars: { old_title: "Old", new_title: "New" })
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == event.id }
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, activity["particulars"])
+  end
+
+  test "index exposes board change particulars" do
+    event = track_event_as(:david, cards(:logo), "board_changed", particulars: { old_board: "Writebook", new_board: "Other" })
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == event.id }
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Other" }, activity["particulars"])
+  end
+
+  test "index exposes triage particulars" do
+    event = track_event_as(:david, cards(:logo), "triaged", particulars: { column: "In Progress" })
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == event.id }
+    assert_equal({ "column" => "In Progress" }, activity["particulars"])
+  end
+
+  test "index returns empty strings for missing particulars" do
+    event = track_event_as(:david, cards(:logo), "board_changed")
+
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == event.id }
+    assert_equal({ "old_board" => "", "new_board" => "" }, activity["particulars"])
+  end
+
+  test "index returns empty particulars for other events" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == events(:logo_published).id }
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "index excludes deprecated collection changed events" do
+    event = track_event_as(:david, cards(:logo), "collection_changed", particulars: { new_collection: "Other" })
+
+    get activities_path, as: :json
+
+    assert_not @response.parsed_body.any? { |activity| activity["id"] == event.id }
+  end
+
+  test "index is ordered newest first" do
+    get activities_path, as: :json
+
+    created_ats = @response.parsed_body.map { |activity| activity["created_at"] }
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "index only includes events from accessible boards" do
+    inaccessible = track_event_as(:kevin, cards(:logo), "published", board: boards(:private))
+    boards(:private).accesses.destroy_all
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_not @response.parsed_body.any? { |activity| activity["id"] == inaccessible.id }
+  end
+
+  test "index filtered by creator" do
+    get activities_path(creator_ids: [ users(:kevin).id ]), as: :json
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity.dig("creator", "id") == users(:kevin).id }
+  end
+
+  test "index filtered by board" do
+    private_event = track_event_as(:kevin, cards(:logo), "published", board: boards(:private))
+
+    get activities_path(board_ids: [ boards(:private).id ]), as: :json
+
+    assert_response :success
+    assert_equal [ private_event.id ], @response.parsed_body.map { |activity| activity["id"] }
+  end
+
+  test "index is paginated" do
+    Current.set(user: users(:david), account: accounts(:"37s")) do
+      40.times { |i| cards(:logo).track_event(:closed).update!(created_at: i.days.ago) }
+    end
+
+    expected_ids = users(:kevin).activities_for(Filter.new(creator: users(:kevin))).map(&:id)
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.map { |activity| activity["id"] })
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  private
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+
+    def track_event_as(user, card, action, **attributes)
+      Current.set(user: users(user), account: users(user).account) do
+        card.track_event(action, **attributes)
+      end
+    end
+end
