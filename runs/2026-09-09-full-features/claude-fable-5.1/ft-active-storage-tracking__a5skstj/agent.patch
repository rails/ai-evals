@@ -0,0 +1,11 @@
+class Board::RecalculateBytesUsedJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  # Recalculations of the same board run one at a time, so a burst of uploads from many
+  # users queues up harmlessly and the last one to run always sees the final state.
+  limits_concurrency key: ->(board) { board }
+
+  def perform(board)
+    board.recalculate_bytes_used_now
+  end
+end
