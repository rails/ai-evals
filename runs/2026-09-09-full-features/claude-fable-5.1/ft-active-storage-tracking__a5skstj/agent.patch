+++ b/test/models/account/storage_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class Account::StorageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+  end
+
+  test "bytes used sums all boards" do
+    boards(:writebook).update_columns bytes_used: 100
+    boards(:private).update_columns bytes_used: 50
+
+    @account.recalculate_bytes_used_now
+
+    assert_equal 150, @account.reload.bytes_used
+  end
+
+  test "destroying a board releases its usage" do
+    boards(:writebook).update_columns bytes_used: 100
+    boards(:private).update_columns bytes_used: 50
+    @account.recalculate_bytes_used_now
+
+    boards(:private).destroy
+    perform_storage_recalculations
+
+    assert_equal 100, @account.reload.bytes_used
+  end
+
+  test "recalculation runs in the background, one account at a time" do
+    assert_enqueued_with job: Account::RecalculateBytesUsedJob, args: [ @account ] do
+      @account.recalculate_bytes_used_later
+    end
+
+    job = Account::RecalculateBytesUsedJob.new(@account)
+    assert_equal 1, job.concurrency_limit
+    assert_includes job.concurrency_key, @account.id
+  end
+
+  private
+    def perform_storage_recalculations
+      perform_enqueued_jobs only: Account::RecalculateBytesUsedJob
+    end
+end
diff --git a/test/models/board/storage_test.rb b/test/models/board/storage_test.rb
new file mode 100644
index 0000000..2c49073
--- /dev/null
+++ b/test/models/board/storage_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class Board::StorageTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+    @account = @board.account
+    @card = cards(:logo)
+    @image_size = file_fixture("moon.jpg").size
+  end
+
+  test "bytes used starts at zero" do
+    assert_equal 0, @board.bytes_used
+    assert_equal 0, @account.bytes_used
+  end
+
+  test "attaching a card image is counted on the board and the account" do
+    attach_image_to @card
+    perform_storage_recalculations
+
+    assert_equal @image_size, @board.reload.bytes_used
+    assert_equal @image_size, @account.reload.bytes_used
+  end
+
+  test "removing a card image is no longer counted" do
+    attach_image_to @card
+    perform_storage_recalculations
+    assert_equal @image_size, @board.reload.bytes_used
+
+    @card.update! image: nil
+    perform_storage_recalculations
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "files embedded in card descriptions are counted" do
+    @card.update! description: "<p>Look: #{embed_html}</p>"
+    perform_storage_recalculations
+
+    assert_equal @image_size, @board.reload.bytes_used
+  end
+
+  test "files embedded in comments are counted" do
+    @card.comments.create! body: "<p>Look: #{embed_html}</p>", creator: users(:david)
+    perform_storage_recalculations
+
+    assert_equal @image_size, @board.reload.bytes_used
+  end
+
+  test "files embedded in the board description are counted" do
+    @board.update! public_description: "<p>Look: #{embed_html}</p>"
+    perform_storage_recalculations
+
+    assert_equal @image_size, @board.reload.bytes_used
+  end
+
+  test "files no longer embedded are not counted" do
+    @card.update! description: "<p>Look: #{embed_html}</p>"
+    perform_storage_recalculations
+    assert_equal @image_size, @board.reload.bytes_used
+
+    @card.update! description: "<p>No more image</p>"
+    perform_storage_recalculations
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "destroying a comment releases its files" do
+    comment = @card.comments.create! body: "<p>Look: #{embed_html}</p>", creator: users(:david)
+    perform_storage_recalculations
+    assert_equal @image_size, @board.reload.bytes_used
+
+    comment.destroy
+    perform_storage_recalculations
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "destroying a card releases its image and files" do
+    attach_image_to @card
+    @card.update! description: "<p>Look: #{embed_html}</p>"
+    @card.comments.create! body: "<p>Look: #{embed_html}</p>", creator: users(:david)
+    perform_storage_recalculations
+    assert_equal @image_size * 3, @board.reload.bytes_used
+
+    @card.destroy
+    perform_storage_recalculations
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "moving a card moves its usage to the other board" do
+    Current.session = sessions(:david)
+    other_board = boards(:private)
+
+    attach_image_to @card
+    perform_storage_recalculations
+    assert_equal @image_size, @board.reload.bytes_used
+    assert_equal 0, other_board.reload.bytes_used
+
+    @card.move_to(other_board)
+    perform_storage_recalculations
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal @image_size, other_board.reload.bytes_used
+    assert_equal @image_size, @account.reload.bytes_used
+  end
+
+  test "recalculating counts everything on the board and nothing else" do
+    attach_image_to @card
+    @card.update! description: "<p>Look: #{embed_html}</p>"
+    @card.comments.create! body: "<p>Look: #{embed_html}</p>", creator: users(:david)
+    @board.update! public_description: "<p>Look: #{embed_html}</p>"
+    attach_image_to cards(:radio)
+    users(:david).avatar.attach io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg"
+
+    @board.recalculate_bytes_used_now
+
+    assert_equal @image_size * 4, @board.reload.bytes_used
+    assert_equal @image_size * 4, @account.reload.bytes_used
+  end
+
+  test "recalculation runs in the background, one board at a time" do
+    assert_enqueued_with job: Board::RecalculateBytesUsedJob, args: [ @board ] do
+      @board.recalculate_bytes_used_later
+    end
+
+    job = Board::RecalculateBytesUsedJob.new(@board)
+    assert_equal 1, job.concurrency_limit
+    assert_includes job.concurrency_key, @board.id
+  end
+
+  private
+    def perform_storage_recalculations
+      perform_enqueued_jobs only: [ Board::RecalculateBytesUsedJob, Account::RecalculateBytesUsedJob ]
+    end
+
+    def attach_image_to(card)
+      card.image.attach io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg"
+    end
+
