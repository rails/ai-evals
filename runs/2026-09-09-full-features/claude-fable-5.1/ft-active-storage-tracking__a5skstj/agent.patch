diff --git a/app/models/board/storage.rb b/app/models/board/storage.rb
new file mode 100644
index 0000000..4163df9
--- /dev/null
+++ b/app/models/board/storage.rb
@@ -0,0 +1,41 @@
+# Storage usage counts card images plus the files embedded in the board description,
+# card descriptions and comments. It's stored in +bytes_used+ and recalculated in the
+# background whenever an attachment is added or removed, so reads stay cheap and
+# concurrent uploads never contend over a counter.
+module Board::Storage
+  extend ActiveSupport::Concern
+
+  included do
+    after_destroy_commit -> { account.recalculate_bytes_used_later }, unless: :destroyed_by_association
+  end
+
+  def board
+    self
+  end
+
+  def recalculate_bytes_used_later
+    Board::RecalculateBytesUsedJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used_now
+    update_columns bytes_used: calculate_bytes_used
+    account.recalculate_bytes_used_now
+  end
+
+  private
+    def calculate_bytes_used
+      card_image_bytes + embedded_bytes_in(self) + embedded_bytes_in(cards) + embedded_bytes_in(Comment.where(card: cards))
+    end
+
+    def card_image_bytes
+      attached_bytes cards, name: :image
+    end
+
+    def embedded_bytes_in(records)
+      attached_bytes ActionText::RichText.where(record: records), name: :embeds
+    end
+
+    def attached_bytes(records, name:)
+      ActiveStorage::Blob.joins(:attachments).merge(ActiveStorage::Attachment.where(record: records, name: name)).sum(:byte_size)
+    end
+end
