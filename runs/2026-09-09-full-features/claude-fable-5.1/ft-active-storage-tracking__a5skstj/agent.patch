--- /dev/null
+++ b/app/models/account/storage.rb
@@ -0,0 +1,14 @@
+# Storage usage is the sum of what all the account's boards use. Boards recalculate
+# their own usage in the background and roll it up into the account, so reading
+# +bytes_used+ is always a plain column read no matter how much has been uploaded.
+module Account::Storage
+  extend ActiveSupport::Concern
+
+  def recalculate_bytes_used_later
+    Account::RecalculateBytesUsedJob.perform_later(self)
+  end
+
+  def recalculate_bytes_used_now
+    with_lock { update_columns bytes_used: boards.sum(:bytes_used) }
+  end
+end
