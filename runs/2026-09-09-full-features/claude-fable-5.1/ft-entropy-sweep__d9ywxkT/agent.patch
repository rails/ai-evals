diff --git a/app/models/board/entropic.rb b/app/models/board/entropic.rb
index d3e48d6..87a492a 100644
--- a/app/models/board/entropic.rb
+++ b/app/models/board/entropic.rb
@@ -18,4 +18,23 @@ module Board::Entropic
   def auto_postpone_period_in_days=(value)
     self.auto_postpone_period = value.to_i.days.to_i
   end
+
+  # Cards on this board that have been inactive for longer than the effective auto-postpone
+  # period (the board's own, falling back to the account's). The cutoff is resolved here and
+  # handed to the database as a constant, so this is an indexed lookup on the board's cards.
+  def cards_due_to_be_postponed
+    if period = entropy&.auto_postpone_period
+      cards.inactive_since(period.seconds.ago)
+    else
+      cards.none
+    end
+  end
+
+  def auto_postpone_due_cards
+    system_user = nil
+
+    cards_due_to_be_postponed.find_each do |card|
+      card.auto_postpone(user: system_user ||= account.system_user)
+    end
+  end
 end
