diff --git a/test/models/board/entropic_test.rb b/test/models/board/entropic_test.rb
new file mode 100644
index 0000000..66d660f
--- /dev/null
+++ b/test/models/board/entropic_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class Board::EntropicTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "cards due to be postponed uses the board's own period" do
+    period = entropies(:writebook_board).auto_postpone_period
+
+    cards(:logo).update!(last_active_at: 1.day.ago - period)
+    cards(:shipping).update!(last_active_at: 1.day.from_now - period)
+
+    assert_equal [ cards(:logo) ], boards(:writebook).cards_due_to_be_postponed.to_a
+  end
+
+  test "cards due to be postponed falls back to the account's period" do
+    entropies(:writebook_board).destroy
+    period = entropies("37s_account").auto_postpone_period
+
+    cards(:logo).update!(last_active_at: 1.day.ago - period)
+    cards(:shipping).update!(last_active_at: 1.day.from_now - period)
+
+    assert_equal [ cards(:logo) ], boards(:writebook).reload.cards_due_to_be_postponed.to_a
+  end
+
+  test "cards due to be postponed is empty when neither the board nor the account define a period" do
+    entropies(:writebook_board).destroy
+    entropies("37s_account").destroy
+    cards(:logo).update!(last_active_at: 2.years.ago)
+
+    assert_empty boards(:writebook).reload.cards_due_to_be_postponed
+  end
+
+  test "cards due to be postponed only includes active cards" do
+    long_ago = 1.day.ago - entropies(:writebook_board).auto_postpone_period
+    cards(:logo, :layout, :text, :shipping).each { |card| card.update!(last_active_at: long_ago) }
+
+    cards(:layout).close
+    cards(:text).postpone
+    cards(:shipping).update!(status: :drafted, last_active_at: long_ago)
+
+    assert_equal [ cards(:logo) ], boards(:writebook).cards_due_to_be_postponed.to_a
+  end
+
+  test "cards due to be postponed is scoped to this board and its own cutoff" do
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+    cards(:radio).update!(last_active_at: 1.day.ago - entropies(:miltons_wish_list_board).auto_postpone_period)
+
+    assert_equal [ cards(:logo) ], boards(:writebook).cards_due_to_be_postponed.to_a
+    assert_equal [ cards(:radio) ], boards(:miltons_wish_list).cards_due_to_be_postponed.to_a
+  end
+
+  test "auto postpone due cards postpones them on behalf of the account's system user" do
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      boards(:writebook).auto_postpone_due_cards
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert_equal accounts("37s").system_user, cards(:logo).postponed_by
+  end
+
+  test "auto postpone due cards does not look up the system user when nothing is due" do
+    assert_no_queries_match(/FROM "users"/) do
+      boards(:writebook).auto_postpone_due_cards
+    end
+  end
+
+  test "auto postpone due cards queries the board's cards against a fixed cutoff instead of joining entropy settings" do
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+
+    assert_no_queries_match(/FROM "cards".*entropies/) do
+      boards(:writebook).auto_postpone_due_cards
+    end
+  end
+end
diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..5c22eb7 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,55 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone all due does not touch active cards, or cards inactive for less than their period" do
+    period = entropies(:writebook_board).auto_postpone_period
+    cards(:logo).update!(last_active_at: 1.hour.ago)
+    cards(:shipping).update!(last_active_at: 1.day.from_now - period)
+    cards(:layout).update!(last_active_at: 1.day.ago - period)
+
+    Card.auto_postpone_all_due
+
+    assert cards(:layout).reload.postponed?
+    assert_not cards(:logo).reload.postponed?
+    assert_not cards(:shipping).reload.postponed?
+  end
+
+  test "auto postpone all due is idempotent" do
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+
+    assert_difference -> { Card.postponed.count }, +1 do
+      Card.auto_postpone_all_due
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "auto postpone all due skips boards whose account has no entropy configured" do
+    entropies(:writebook_board).destroy
+    entropies("37s_account").destroy
+    cards(:logo).update!(last_active_at: 2.years.ago)
+
+    assert_no_difference -> { Card.postponed.count } do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "auto postpone all due sweeps board by board rather than joining every card against its entropy settings" do
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+
+    assert_no_queries_match(/FROM "cards".*JOIN "boards"/) do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "due to be postponed scope agrees with the per-board sweep" do
+    cards(:logo).update!(last_active_at: 1.day.ago - entropies(:writebook_board).auto_postpone_period)
+    cards(:radio).update!(last_active_at: 1.day.ago - entropies(:miltons_wish_list_board).auto_postpone_period)
+    cards(:shipping).update!(last_active_at: 1.day.from_now - entropies(:writebook_board).auto_postpone_period)
+
+    swept = Board.all.flat_map { |board| board.cards_due_to_be_postponed.to_a }
+
+    assert_equal cards(:logo, :radio).to_set, Card.due_to_be_postponed.to_set
+    assert_equal Card.due_to_be_postponed.to_set, swept.to_set
+  end
 end
