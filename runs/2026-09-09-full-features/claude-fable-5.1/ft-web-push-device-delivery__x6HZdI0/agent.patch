diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..863bcbb 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,40 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+// Push notifications - a push says what the tray says and opens the card it's about
+self.addEventListener("push", (event) => {
+  const notification = event.data?.json()
+
+  if (notification) {
+    event.waitUntil(
+      self.registration.showNotification(notification.title, {
+        body: notification.body,
+        icon: "/app-icon-192.png",
+        tag: notification.tag,
+        renotify: true,
+        data: { path: notification.path }
+      })
+    )
+  }
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+
+  if (event.notification.data?.path) {
+    event.waitUntil(openCard(new URL(event.notification.data.path, self.location.origin).href))
+  }
+})
+
+async function openCard(url) {
+  const clients = await self.clients.matchAll({ type: "window" })
+  const client = clients.find(client => client.url === url) || clients[0]
+
+  if (client) {
+    await client.focus()
+    if (client.url !== url) await client.navigate(url)
+  } else {
+    await self.clients.openWindow(url)
+  }
+}
