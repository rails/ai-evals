+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,103 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = push_subscriptions(:kevin_laptop)
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "register creates a subscription for a new endpoint" do
+    kevin = users(:kevin)
+
+    assert_difference -> { kevin.push_subscriptions.count }, +1 do
+      subscription = kevin.push_subscriptions.register(endpoint: "https://push.example.com/send/new", p256dh_key: "p256dh", auth_key: "auth", user_agent: "Firefox")
+
+      assert_equal kevin.account, subscription.account
+      assert_equal "https://push.example.com/send/new", subscription.endpoint
+      assert_equal "Firefox", subscription.user_agent
+    end
+  end
+
+  test "register refreshes the keys of an endpoint the browser hands us again" do
+    kevin = users(:kevin)
+
+    assert_no_difference -> { kevin.push_subscriptions.count } do
+      subscription = kevin.push_subscriptions.register(endpoint: @subscription.endpoint, p256dh_key: "rotated-p256dh", auth_key: "rotated-auth", user_agent: "Chrome")
+
+      assert_equal @subscription, subscription
+      assert_equal "rotated-p256dh", @subscription.reload.p256dh_key
+      assert_equal "rotated-auth", @subscription.auth_key
+      assert_equal "Chrome", @subscription.user_agent
+    end
+  end
+
+  test "register keeps the same endpoint separate per user" do
+    david = users(:david)
+
+    assert_difference -> { Push::Subscription.count }, +1 do
+      david.push_subscriptions.register(endpoint: @subscription.endpoint, p256dh_key: "p256dh", auth_key: "auth")
+    end
+  end
+
+  test "deliver pushes what the tray says, signed with the VAPID keys" do
+    with_push_enabled do
+      WebPush.expects(:payload_send).with do |message:, endpoint:, p256dh:, auth:, vapid:, **|
+        payload = JSON.parse(message)
+
+        assert_equal "The logo isn't big enough", payload["title"]
+        assert_equal "Assigned to Kevin", payload["body"]
+        assert_equal "#{@notification.account.slug}/cards/#{@notification.card.number}", payload["path"]
+        assert_equal @subscription.endpoint, endpoint
+        assert_equal @subscription.p256dh_key, p256dh
+        assert_equal @subscription.auth_key, auth
+        assert_equal PushTestHelper::VAPID_PUBLIC_KEY, vapid[:public_key]
+        assert_equal PushTestHelper::VAPID_PRIVATE_KEY, vapid[:private_key]
+        assert_match /\Amailto:/, vapid[:subject]
+      end
+
+      @subscription.deliver(@notification)
+    end
+  end
+
+  test "deliver forgets subscriptions the push service says are gone" do
+    WebPush.stubs(:payload_send).raises(push_service_error(WebPush::ExpiredSubscription, "410 Gone"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver(@notification)
+    end
+  end
+
+  test "deliver forgets subscriptions the push service doesn't recognize" do
+    WebPush.stubs(:payload_send).raises(push_service_error(WebPush::InvalidSubscription, "404 Not Found"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.deliver(@notification)
+    end
+  end
+
+  test "deliver lets other push service failures through so the job can retry" do
+    WebPush.stubs(:payload_send).raises(push_service_error(WebPush::PushServiceError, "503 Service Unavailable"))
+
+    assert_no_difference -> { Push::Subscription.count } do
+      assert_raises WebPush::PushServiceError do
+        @subscription.deliver(@notification)
+      end
+    end
+  end
+
+  test "deliver_later enqueues a delivery for the subscription" do
+    assert_enqueued_with job: Push::Subscription::DeliverJob, args: [ @subscription, @notification ] do
+      @subscription.deliver_later(@notification)
+    end
+  end
+
+  test "deactivating a user removes their subscriptions" do
+    assert_difference -> { Push::Subscription.count }, -2 do
+      users(:kevin).destroy
+    end
+  end
+  private
+    def push_service_error(error_class, status)
+      error_class.new(stub(inspect: status, body: ""), "push.example.com")
+    end
+end
