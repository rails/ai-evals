+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,28 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+
+  def create
+    @push_subscription = @user.push_subscriptions.register(**push_subscription_params, user_agent: request.user_agent)
+
+    respond_to do |format|
+      format.json { render status: :created }
+    end
+  end
+
+  def destroy
+    @user.push_subscriptions.find(params[:id]).destroy
+
+    head :no_content
+  end
+
+  private
+    def set_user
+      @user = Current.identity.users.find(params[:user_id])
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ]).tap do |subscription|
+        subscription.require([ :endpoint, :p256dh_key, :auth_key ])
+      end.to_h.symbolize_keys
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..49a37e8
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,117 @@
+import { Controller } from "@hotwired/stimulus"
+import { post, destroy } from "@rails/request.js"
+
+// Turns push notifications on or off for the device you're using. The browser hands us
+// the subscription it got from its push service, and we hand that on to the server.
+export default class extends Controller {
+  static targets = [ "status", "toggle", "details", "blocked", "unsupported" ]
+  static classes = [ "on" ]
+  static values = { subscriptionsUrl: String, vapidPublicKey: String }
+
+  async connect() {
+    if (this.#supported) {
+      this.statusTarget.hidden = false
+      await this.#refresh()
+    } else {
+      this.unsupportedTarget.hidden = false
+    }
+  }
+
+  async subscribe() {
+    await this.#whileBusy(async () => {
+      if (await Notification.requestPermission() === "granted") {
+        await this.#register(await this.#createSubscription())
+      }
+    })
+  }
+
+  async unsubscribe() {
+    await this.#whileBusy(async () => {
+      const subscription = await this.#subscription
+
+      if (subscription) {
+        await this.#unregister()
+        await subscription.unsubscribe()
+      }
+    })
+  }
+
+  // Private
+
+  async #refresh() {
+    const subscription = await this.#subscription
+    const permission = Notification.permission
+    const on = permission === "granted" && !!subscription
+    const blocked = permission === "denied"
+
+    if (on) {
+      // Keep the server current with whatever the push service has handed this browser
+      await this.#register(subscription).catch(error => console.warn(error))
+    }
+
+    this.element.classList.toggle(this.onClass, on)
+    this.statusTarget.hidden = blocked
+    this.blockedTarget.hidden = !blocked
+    this.detailsTargets.forEach(details => details.hidden = !blocked)
+  }
+
+  async #createSubscription() {
+    const registration = await navigator.serviceWorker.ready
+
+    return await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: this.#applicationServerKey
+    })
+  }
+
+  async #register(subscription) {
+    const { endpoint, keys } = subscription.toJSON()
+
+    const response = await post(this.subscriptionsUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } },
+      responseKind: "json"
+    })
+
+    if (response.ok) {
+      this.subscriptionId = (await response.json).id
+    } else {
+      throw new Error(`Couldn't register the push subscription (${response.statusCode})`)
+    }
+  }
+
+  async #unregister() {
+    if (this.subscriptionId) {
+      await destroy(`${this.subscriptionsUrlValue}/${this.subscriptionId}`, { responseKind: "json" })
+      this.subscriptionId = null
+    }
+  }
+
+  async #whileBusy(callback) {
+    this.toggleTargets.forEach(toggle => toggle.disabled = true)
+
+    try {
+      await callback()
+    } catch (error) {
+      console.warn("Push notifications couldn't be switched:", error)
+    } finally {
+      await this.#refresh()
+      this.toggleTargets.forEach(toggle => toggle.disabled = false)
+    }
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window && this.hasVapidPublicKeyValue
+  }
+
+  get #subscription() {
+    return navigator.serviceWorker.ready.then(registration => registration.pushManager.getSubscription())
+  }
+
+  // VAPID keys travel as base64url, but PushManager wants the raw bytes
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - this.vapidPublicKeyValue.length % 4) % 4)
+    const base64 = (this.vapidPublicKeyValue + padding).replace(/-/g, "+").replace(/_/g, "/")
+
+    return Uint8Array.from(atob(base64), character => character.charCodeAt(0))
+  }
+}
diff --git a/app/jobs/push/subscription/deliver_job.rb b/app/jobs/push/subscription/deliver_job.rb
new file mode 100644
index 0000000..b1b0643
--- /dev/null
+++ b/app/jobs/push/subscription/deliver_job.rb
@@ -0,0 +1,13 @@
+class Push::Subscription::DeliverJob < ApplicationJob
+  queue_as :backend
+
+  discard_on ActiveJob::DeserializationError
+
+  # Push services hiccup, and so do the pipes to them. Try again in a while.
+  retry_on WebPush::PushServiceError, WebPush::TooManyRequests, wait: :polynomially_longer
+  retry_on Net::OpenTimeout, Net::ReadTimeout, Socket::ResolutionError, wait: :polynomially_longer
+
+  def perform(subscription, notification)
+    subscription.deliver(notification)
+  end
+end
