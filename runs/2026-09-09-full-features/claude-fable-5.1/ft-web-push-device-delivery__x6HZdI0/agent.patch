diff --git a/test/jobs/push/subscription/deliver_job_test.rb b/test/jobs/push/subscription/deliver_job_test.rb
new file mode 100644
index 0000000..a0690a1
--- /dev/null
+++ b/test/jobs/push/subscription/deliver_job_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class Push::Subscription::DeliverJobTest < ActiveJob::TestCase
+  setup do
+    @subscription = push_subscriptions(:kevin_laptop)
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "delivers the notification to the subscription" do
+    with_push_enabled do
+      WebPush.expects(:payload_send).with { |endpoint:, **| endpoint == @subscription.endpoint }
+
+      perform_enqueued_jobs do
+        @subscription.deliver_later(@notification)
+      end
+    end
+  end
+
+  test "discards the delivery when the notification is gone by the time it runs" do
+    WebPush.expects(:payload_send).never
+
+    @subscription.deliver_later(@notification)
+    @notification.destroy
+
+    assert_nothing_raised do
+      perform_enqueued_jobs
+    end
+  end
+
+  test "retries when the push service is having a bad day" do
+    with_push_enabled do
+      WebPush.stubs(:payload_send).raises(WebPush::PushServiceError.new(stub(inspect: "503", body: ""), "push.example.com"))
+
+      perform_enqueued_jobs(only: Push::Subscription::DeliverJob, at: Time.current) do
+        @subscription.deliver_later(@notification)
+      end
+
+      assert_enqueued_with job: Push::Subscription::DeliverJob
+    end
+  end
+end
