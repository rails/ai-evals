diff --git a/app/models/notification/pushing.rb b/app/models/notification/pushing.rb
new file mode 100644
index 0000000..5f38bbd
--- /dev/null
+++ b/app/models/notification/pushing.rb
@@ -0,0 +1,30 @@
+# Whatever lands in someone's tray also reaches the devices they've turned push on for.
+module Notification::Pushing
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: :landed_in_tray?
+  end
+
+  def push_later
+    if Push.enabled?
+      user.push_subscriptions.each { |subscription| subscription.deliver_later(self) }
+    end
+  end
+
+  # A push says what the tray says and opens the card it's about.
+  def push_payload
+    renderer.render(layout: false, template: "notifications/push", assigns: { notification: self }, formats: :json)
+  end
+
+  private
+    # New notifications land in the tray, and so do existing ones when something new happens
+    # on their card. Reading or unreading one is the person's own doing, so no push for that.
+    def landed_in_tray?
+      previously_new_record? || source_id_previously_changed?
+    end
+
+    def renderer
+      ApplicationController.renderer.new(script_name: account.slug)
+    end
+end
diff --git a/app/models/push.rb b/app/models/push.rb
new file mode 100644
index 0000000..371da61
--- /dev/null
+++ b/app/models/push.rb
@@ -0,0 +1,30 @@
+# Web Push delivery to browsers, signed with the VAPID key pair that ops
+# provide as VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY.
+module Push
+  class << self
+    def table_name_prefix
+      "push_"
+    end
+
+    def enabled?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"]
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"]
+    end
+
+    # Push services want to know who's knocking: a mailto: or https: URL for the app server.
+    def vapid_subject
+      ENV.fetch("VAPID_SUBJECT") { "mailto:#{Mail::Address.new(ApplicationMailer.default[:from]).address}" }
+    end
+
+    def vapid
+      { subject: vapid_subject, public_key: vapid_public_key, private_key: vapid_private_key }
+    end
+  end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..784bf9b
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,35 @@
+# A browser's subscription with its push service, handed to us so that notifications
+# landing in someone's tray also reach the phone or desktop they turned it on from.
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :p256dh_key, :auth_key, presence: true
+  validates :endpoint, presence: true, format: { with: %r{\Ahttps://}i, message: "must be an https URL" }
+
+  class << self
+    # Browsers hand us the same endpoint again when they re-subscribe or refresh their keys.
+    def register(endpoint:, p256dh_key:, auth_key:, user_agent: nil)
+      find_or_initialize_by(endpoint: endpoint).tap do |subscription|
+        subscription.update!(p256dh_key: p256dh_key, auth_key: auth_key, user_agent: user_agent)
+      end
+    end
+  end
+
+  def deliver_later(notification)
+    DeliverJob.perform_later(self, notification)
+  end
+
+  def deliver(notification)
+    WebPush.payload_send \
+      message: notification.push_payload,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: Push.vapid,
+      urgency: "high"
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    # The browser let go of this subscription, so there's nobody left to deliver to.
+    destroy
+  end
+end
