@@ -0,0 +1,90 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:kevin)
+    sign_in_as @user
+  end
+
+  test "create registers the subscription the browser got from its push service" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: subscription_params, as: :json,
+        headers: { "User-Agent" => "Mozilla/5.0 Firefox/125.0" }
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.find(@response.parsed_body["id"])
+    assert_equal "https://push.example.com/send/kevin-tablet", subscription.endpoint
+    assert_equal "BTabletP256dh", subscription.p256dh_key
+    assert_equal "tabletAuth", subscription.auth_key
+    assert_equal "Mozilla/5.0 Firefox/125.0", subscription.user_agent
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create refreshes a subscription the browser hands us again" do
+    existing = push_subscriptions(:kevin_laptop)
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), as: :json,
+        params: { push_subscription: { endpoint: existing.endpoint, p256dh_key: "fresh-p256dh", auth_key: "fresh-auth" } }
+    end
+
+    assert_response :created
+    assert_equal existing.id, @response.parsed_body["id"]
+    assert_equal "fresh-p256dh", existing.reload.p256dh_key
+    assert_equal "fresh-auth", existing.auth_key
+  end
+
+  test "create requires the subscription's endpoint and keys" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: "https://push.example.com/send/keyless" } }, as: :json
+    end
+
+    assert_response :bad_request
+  end
+
+test "create only takes endpoints on a push service, not just anywhere" do
+  assert_no_difference -> { Push::Subscription.count } do
+    post user_push_subscriptions_path(@user), as: :json,
+      params: { push_subscription: { endpoint: "http://169.254.169.254/latest/meta-data", p256dh_key: "p256dh", auth_key: "auth" } }
+  end
+
+  assert_response :unprocessable_entity
+end
+
+  test "create can't register a subscription for somebody else" do
+    david = users(:david)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(david), params: subscription_params, as: :json
+    end
+
+    assert_response :not_found
+  end
+
+  test "destroy forgets the subscription" do
+    subscription = push_subscriptions(:kevin_phone)
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      delete user_push_subscription_path(@user, subscription), as: :json
+    end
+
+    assert_response :no_content
+  end
+
+  test "destroy can't reach somebody else's subscription" do
+    subscription = push_subscriptions(:david_laptop)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      delete user_push_subscription_path(users(:david), subscription), as: :json
+    end
+
+    assert_response :not_found
+  end
+
+  private
+    def subscription_params
+      { push_subscription: { endpoint: "https://push.example.com/send/kevin-tablet", p256dh_key: "BTabletP256dh", auth_key: "tabletAuth" } }
+    end
+end
