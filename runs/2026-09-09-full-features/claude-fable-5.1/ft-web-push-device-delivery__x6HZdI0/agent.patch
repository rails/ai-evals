+require "test_helper"
+
+class Notification::PushingTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    notifications(:layout_commented_kevin).destroy
+  end
+
+  test "a notification landing in the tray is pushed to each of the user's devices" do
+    with_push_enabled do
+      notification = Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+
+      @kevin.push_subscriptions.each do |subscription|
+        assert_enqueued_with job: Push::Subscription::DeliverJob, args: [ subscription, notification ]
+      end
+      assert_enqueued_jobs 2, only: Push::Subscription::DeliverJob
+    end
+  end
+
+  test "nothing is pushed when the VAPID keys aren't configured" do
+    with_push_disabled do
+      assert_no_enqueued_jobs only: Push::Subscription::DeliverJob do
+        Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+      end
+    end
+  end
+
+  test "nothing is pushed to users without subscriptions" do
+    with_push_enabled do
+      assert_no_enqueued_jobs only: Push::Subscription::DeliverJob do
+        Notification.create!(user: users(:jz), source: events(:layout_commented), creator: users(:david))
+      end
+    end
+  end
+
+  test "a notification bumped back into the tray by a new source is pushed again" do
+    with_push_enabled do
+      notification = notifications(:logo_assignment_kevin)
+      notification.read
+
+      assert_enqueued_jobs 2, only: Push::Subscription::DeliverJob do
+        notification.source_type_will_change!
+        notification.update!(source: mentions(:logo_comment_david_mention_by_jz), read_at: nil, unread_count: notification.unread_count + 1)
+      end
+    end
+  end
+
+  test "reading and unreading a notification isn't pushed" do
+    with_push_enabled do
+      notification = notifications(:logo_assignment_kevin)
+
+      assert_no_enqueued_jobs only: Push::Subscription::DeliverJob do
+        notification.read
+        notification.unread
+      end
+    end
+  end
+
+  test "push payload says what the tray says and points at the card" do
+    notification = notifications(:logo_assignment_kevin)
+    payload = JSON.parse(notification.push_payload)
+
+    assert_equal "The logo isn't big enough", payload["title"]
+    assert_equal "Assigned to Kevin", payload["body"]
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.number}", payload["path"]
+    assert_equal "card_#{notification.card.id}", payload["tag"]
+  end
+
+  test "push payload for a mention" do
+    notification = notifications(:logo_mentioned_david)
+    payload = JSON.parse(notification.push_payload)
+
+    assert_equal "JZ @mentioned you", payload["title"]
+    assert_equal "I agree.", payload["body"]
+    assert_match %r{\A#{notification.account.slug}/cards/#{notification.card.number}#comment_}, payload["path"]
+  end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
