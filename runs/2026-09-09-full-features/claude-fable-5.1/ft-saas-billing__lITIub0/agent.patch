@@ -0,0 +1,119 @@
+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title"><%= @page_title %></h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow txt-align-start">
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Account</h2>
+    </header>
+
+    <dl class="margin-block-half">
+      <dt class="txt-x-small txt-ink-medium">ID</dt>
+      <dd>#<%= @account.external_account_id %> <span class="txt-x-small txt-ink-medium">(<%= @account.id %>)</span></dd>
+
+      <dt class="txt-x-small txt-ink-medium">Owner</dt>
+      <dd><%= @account.owner_name || "No owner" %> <span class="txt-x-small txt-ink-medium"><%= @account.owner_email %></span></dd>
+
+      <dt class="txt-x-small txt-ink-medium">Created</dt>
+      <dd><%= time_ago_in_words(@account.created_at) %> ago</dd>
+
+      <dt class="txt-x-small txt-ink-medium">Status</dt>
+      <dd><%= @account.cancelled? ? "Cancelled" : "Active" %></dd>
+    </dl>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Plan</h2>
+    </header>
+
+    <dl class="margin-block-half">
+      <dt class="txt-x-small txt-ink-medium">Plan</dt>
+      <dd><%= @account.plan.proper_name %> — <%= plan_price(@account.plan) %>, <%= plan_allowance(@account.plan) %></dd>
+
+      <dt class="txt-x-small txt-ink-medium">Subscription</dt>
+      <dd>
+        <% if subscription = @account.subscription %>
+          <%= subscription.status || "none" %>
+          <% if subscription.stripe_subscription_id %>
+            <span class="txt-x-small txt-ink-medium"><%= subscription.stripe_subscription_id %></span>
+          <% end %>
+          <% if subscription.current_period_end %>
+            • period ends <%= subscription.current_period_end.to_date %>
+          <% end %>
+          <% if subscription.cancel_at %>
+            • cancels <%= subscription.cancel_at.to_date %>
+          <% end %>
+          <br>
+          <span class="txt-x-small txt-ink-medium">Stripe customer <%= subscription.stripe_customer_id %></span>
+        <% else %>
+          None
+        <% end %>
+      </dd>
+
+      <dt class="txt-x-small txt-ink-medium">Comped</dt>
+      <dd class="flex align-center gap-half">
+        <%= @account.comped? ? "Yes" : "No" %>
+        <% if @account.comped? %>
+          <%= button_to "Uncomp", saas.admin_account_comp_path(@account), method: :delete, class: "btn txt-small" %>
+        <% else %>
+          <%= button_to "Comp", saas.admin_account_comp_path(@account), method: :post, class: "btn txt-small" %>
+        <% end %>
+      </dd>
+    </dl>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Usage</h2>
+    </header>
+
+    <dl class="margin-block-half">
+      <dt class="txt-x-small txt-ink-medium">Card count</dt>
+      <dd>
+        <%= number_with_delimiter(@account.card_count) %>
+        <% if @account.card_limit %>of <%= number_with_delimiter(@account.card_limit) %><% end %>
+        <% if @account.overridden_limit&.card_count %>
+          <span class="txt-x-small txt-ink-medium">(overridden; actually <%= number_with_delimiter(@account.cards_count) %>)</span>
+        <% end %>
+      </dd>
+
+      <dt class="txt-x-small txt-ink-medium">Bytes used</dt>
+      <dd>
+        <%= number_to_human_size(@account.bytes_used) %> of <%= number_to_human_size(@account.storage_limit) %>
+        <% if @account.overridden_limit&.bytes_used %>
+          <span class="txt-x-small txt-ink-medium">(overridden; actually <%= number_to_human_size(@account.storage_total&.bytes_stored || 0) %>)</span>
+        <% end %>
+        <% if @account.storage_exception %>
+          <span class="txt-x-small txt-ink-medium">(storage exception: <%= number_to_human_size(@account.storage_exception.bytes_allowed) %>)</span>
+        <% end %>
+      </dd>
+    </dl>
+
+    <header>
+      <h2 class="divider txt-medium margin-block-start">Override usage</h2>
+      <div class="txt-small txt-ink-medium">Make the account look like it's using this much. Leave a field blank to keep the real number.</div>
+    </header>
+
+    <%= form_with url: saas.admin_account_overridden_limit_path(@account), method: :patch, scope: :overridden_limit, class: "flex flex-column gap-half margin-block-half" do |form| %>
+      <label class="flex flex-column gap-quarter">
+        <%= form.label :card_count, "Card count", class: "txt-x-small txt-ink-medium" %>
+        <%= form.number_field :card_count, value: @account.overridden_limit&.card_count, min: 0, class: "input" %>
+      </label>
+
+      <label class="flex flex-column gap-quarter">
+        <%= form.label :bytes_used, "Bytes used", class: "txt-x-small txt-ink-medium" %>
+        <%= form.number_field :bytes_used, value: @account.overridden_limit&.bytes_used, min: 0, class: "input" %>
+      </label>
+
+      <div class="flex gap-half">
+        <%= form.button "Override", class: "btn btn--link" %>
+      </div>
+    <% end %>
+
+    <% if @account.limits_overridden? %>
+      <%= button_to "Reset", saas.admin_account_overridden_limit_path(@account), method: :delete, class: "btn txt-small" %>
+    <% end %>
+
+    <%= link_to "All accounts", saas.admin_accounts_path, class: "btn margin-block-start" %>
+  </div>
+</section>
