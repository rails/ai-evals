+<section class="settings__section" id="plan">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <div>
+      This account is on the <strong><%= account.plan.proper_name %></strong> plan<%= " (complimentary)" if account.comped? && !account.active_subscription %>:
+      <%= plan_price(account.plan) %>, <%= plan_allowance(account.plan) %>.
+    </div>
+  </header>
+
+  <div class="txt-small">
+    Using
+    <% if account.card_limit %>
+      <strong><%= number_with_delimiter(account.card_count) %></strong> of <%= number_with_delimiter(account.card_limit) %> cards and
+    <% end %>
+    <strong><%= number_to_human_size(account.bytes_used) %></strong> of <%= number_to_human_size(account.storage_limit) %> storage.
+  </div>
+
+  <% if subscription = account.active_subscription %>
+    <div class="txt-small">
+      <% if subscription.canceling? %>
+        Your subscription ends <%= local_datetime_tag subscription.cancel_at, style: :date %>.
+      <% elsif subscription.current_period_end %>
+        Next payment of <%= number_to_currency(subscription.next_amount_due) %> on <%= local_datetime_tag subscription.current_period_end, style: :date %>.
+      <% end %>
+    </div>
+
+    <% if Current.user.admin? %>
+      <%= button_to "Manage billing", account_billing_portal_path, method: :post, class: "btn", form: { data: { turbo: false } } %>
+    <% end %>
+  <% elsif account.upgradable? %>
+    <% if Current.user.admin? %>
+      <ul class="list-unindented flex flex-column gap-half margin-block-half">
+        <% account.plan.upgrades.each do |plan| %>
+          <li class="flex align-center gap justify-space-between">
+            <div class="txt-align-start">
+              <strong><%= plan.proper_name %></strong> — <%= plan_price(plan) %>
+              <div class="txt-small"><%= plan_allowance(plan).upcase_first %></div>
+            </div>
+            <%= button_to "Upgrade", account_billing_checkout_path(plan: plan.short_name), method: :post, class: "btn btn--link", form: { data: { turbo: false } } %>
+          </li>
+        <% end %>
+      </ul>
+    <% else %>
+      <div class="txt-small">Ask an account admin to upgrade for more cards and storage.</div>
+    <% end %>
+  <% end %>
+</section>
