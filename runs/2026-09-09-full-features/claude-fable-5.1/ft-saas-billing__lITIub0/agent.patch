+              #<%= account.external_account_id %> •
+              <%= account.owner_email || "No owner" %> •
+              <%= account.plan.proper_name %><%= " (comped)" if account.comped? %>
+            </span>
+          </div>
+
+          <div class="txt-medium txt-ink-medium txt-align-end">
+            <strong><%= number_with_delimiter(account.card_count) %></strong>
+            <span class="txt-x-small">cards</span>
+            <br>
+            <span class="txt-x-small"><%= time_ago_in_words(account.created_at) %> ago</span>
+          </div>
+        </li>
+      <% end %>
