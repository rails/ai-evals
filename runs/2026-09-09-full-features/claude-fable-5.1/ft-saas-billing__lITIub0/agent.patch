+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @card = cards(:unfinished_thoughts)
+  end
+
+  test "the create buttons give way to an upgrade pitch once out of cards" do
