+
+    <% if @page.empty? %>
+      <p class="txt-ink-medium">No accounts found.</p>
+    <% end %>
+
+    <% unless @page.last? %>
+      <%= link_to "Next page", saas.admin_accounts_path(page: @page.next_param, q: params[:q].presence), class: "btn" %>
+    <% end %>
+  </div>
+</section>
