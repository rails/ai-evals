+      <%= button_to "Manage billing", account_subscription_portal_path, method: :post, class: "btn settings-subscription__button", form: { data: { turbo: false } } %>
+    <% end %>
+  <% else %>
+    <div class="txt-small">
+      Using <strong><%= number_with_delimiter(account.cards_used) %></strong> of <%= account.unlimited_cards? ? "unlimited" : number_with_delimiter(account.card_limit) %> cards
+      and <strong><%= number_to_human_size(account.bytes_used) %></strong> of <%= number_to_human_size(account.storage_limit) %> storage.
+    </div>
+
+    <% if Current.user.admin? && !account.comped? %>
+      <%= link_to "Upgrade", account_subscription_path, class: "btn btn--link settings-subscription__button" %>
+    <% end %>
+  <% end %>
+</section>
