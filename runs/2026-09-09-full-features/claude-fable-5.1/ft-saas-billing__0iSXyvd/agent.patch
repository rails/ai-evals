+<section class="settings__section settings-subscription">
+  <header>
+    <h2 class="divider">Plan</h2>
+    <div>
+      You're on the <strong><%= account.plan.name %></strong> plan<%= " (complimentary)" if account.comped? && !account.subscribed? %>:
+      <%= plan_summary(account.plan) %>.
+    </div>
+  </header>
+
+  <% if params[:upgraded] && !account.subscribed? %>
+    <div class="txt-small"><strong>Thanks for upgrading!</strong> Stripe is letting us know — your new plan will show up here in a moment.</div>
+  <% end %>
+
+  <% if subscription = account.active_subscription %>
+    <div class="txt-small">
+      <% if subscription.canceling? %>
+        Your subscription ends <%= local_datetime_tag subscription.cancel_at, style: :date %>.
+      <% elsif subscription.current_period_end %>
+        Renews <%= local_datetime_tag subscription.current_period_end, style: :date %><%= " for #{plan_price_tag(subscription.next_amount_due_in_cents)}" if subscription.next_amount_due_in_cents %>.
