diff --git a/saas/app/models/account/card_limited.rb b/saas/app/models/account/card_limited.rb
new file mode 100644
index 0000000..ceefa8c
--- /dev/null
+++ b/saas/app/models/account/card_limited.rb
@@ -0,0 +1,26 @@
+module Account::CardLimited
+  extend ActiveSupport::Concern
+
+  NEAR_CARD_LIMIT_THRESHOLD = 100
+
+  # nil when the plan places no limit on cards
+  def card_limit
+    plan.card_limit
+  end
+
+  def unlimited_cards?
+    card_limit.nil?
+  end
+
+  def cards_remaining
+    [ card_limit - cards_used, 0 ].max unless unlimited_cards?
+  end
+
+  def exceeding_card_limit?
+    !unlimited_cards? && cards_used >= card_limit
+  end
+
+  def nearing_card_limit?
+    !unlimited_cards? && !exceeding_card_limit? && cards_remaining <= NEAR_CARD_LIMIT_THRESHOLD
+  end
+end
diff --git a/saas/app/models/account/limit_overridable.rb b/saas/app/models/account/limit_overridable.rb
new file mode 100644
index 0000000..173126e
--- /dev/null
+++ b/saas/app/models/account/limit_overridable.rb
@@ -0,0 +1,36 @@
+# Lets support pretend an account has used a given number of cards or bytes, so
+# the limit experience can be checked without filling an account with data.
+module Account::LimitOverridable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :overridden_limit, dependent: :destroy
+  end
+
+  def cards_used
+    overridden_limit&.card_count || cards_count
+  end
+
+  def bytes_used
+    overridden_limit&.bytes_used || super
+  end
+
+  def limits_overridden?
+    overridden_limit.present?
+  end
+
+  def override_limits(card_count: nil, bytes_used: nil)
+    attributes = { card_count: card_count.presence, bytes_used: bytes_used.presence }
+
+    if overridden_limit
+      overridden_limit.update!(attributes)
+    else
+      create_overridden_limit!(attributes)
+    end
+  end
+
+  def reset_limit_overrides
+    overridden_limit&.destroy!
+    reset_overridden_limit
+  end
+end
