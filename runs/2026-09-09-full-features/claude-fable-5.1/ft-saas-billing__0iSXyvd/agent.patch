+module StripeTestHelper
+  def stripe_subscription_object(id: "sub_1", customer: "cus_1", status: "active", price_id: ENV["STRIPE_MONTHLY_V1_PRICE_ID"],
+    unit_amount: 20_00, period_end: 30.days.from_now, cancel_at: nil, cancel_at_period_end: false, metadata: {})
+    {
+      id: id, object: "subscription", customer: customer, status: status,
+      cancel_at: cancel_at&.to_i, cancel_at_period_end: cancel_at_period_end, metadata: metadata,
+      items: {
+        object: "list",
+        data: [ {
+          id: "si_1", object: "subscription_item", quantity: 1, current_period_end: period_end.to_i,
+          price: { id: price_id, object: "price", unit_amount: unit_amount, currency: "usd", recurring: { interval: "month" } }
+        } ]
+      }
+    }
+  end
+
+  def stripe_checkout_session_object(account:, plan: Plan.find("unlimited"), customer: "cus_1", subscription: "sub_1", payment_status: "paid")
+    {
+      id: "cs_test_1", object: "checkout.session", mode: "subscription", status: "complete", payment_status: payment_status,
+      client_reference_id: account.id, customer: customer, subscription: subscription,
+      metadata: { account_id: account.id, plan_key: plan.key }
+    }
+  end
+
+  def stripe_event(type, object)
+    { id: "evt_#{SecureRandom.hex(8)}", object: "event", type: type, api_version: Stripe.api_version, created: Time.now.to_i,
+      data: { object: object } }
+  end
+
+  def stripe_webhook_headers(payload, secret: ENV["STRIPE_WEBHOOK_SECRET"], timestamp: Time.now)
+    signature = Stripe::Webhook::Signature.compute_signature(timestamp, payload, secret)
+    { "Stripe-Signature" => Stripe::Webhook::Signature.generate_header(timestamp, signature), "Content-Type" => "application/json" }
+  end
+
+  def post_stripe_webhook(type, object, **options)
+    payload = stripe_event(type, object).to_json
+
+    untenanted do
+      post "/stripe/webhooks", params: payload, headers: stripe_webhook_headers(payload, **options)
+    end
+  end
+end
