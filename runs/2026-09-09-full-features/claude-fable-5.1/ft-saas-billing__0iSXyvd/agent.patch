+require "test_helper"
+
+class Card::CardLimited::CreationTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+  end
+
+  test "cannot create cards via the API once the free cards are used up" do
+    @account.update_column(:cards_count, 1_000)
+
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "One too many" } }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "can still draft cards in the browser once the free cards are used up" do
+    @account.update_column(:cards_count, 1_000)
+    @board.cards.drafted.where(creator: users(:mike)).destroy_all
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug)
+    end
+
+    assert_response :redirect
+    assert Card.last.drafted?
+  end
+
+  test "can create cards via the API with free cards to spare" do
+    @account.update_column(:cards_count, 999)
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "The last one" } }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "a paid plan lifts the limit" do
+    @account.update_column(:cards_count, 5_000)
+    @account.create_subscription!(stripe_customer_id: "cus_1", stripe_subscription_id: "sub_1", plan_key: "unlimited", status: "active")
+
+    assert_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Unlimited" } }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "a comp lifts the limit" do
+    @account.update_column(:cards_count, 5_000)
+    @account.comp
+
+    post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "On the house" } }, as: :json
+
+    assert_response :created
+  end
+
+  test "an overridden card count counts" do
+    @account.override_limits(card_count: 1_000)
+
+    post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Overridden" } }, as: :json
+
+    assert_response :forbidden
+  end
+
+  test "staff can create cards via the API even when the limit is reached" do
+    @account.update_column(:cards_count, 1_000)
+    Identity.any_instance.stubs(:staff?).returns(true)
+
+    post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Staff card" } }, as: :json
+
+    assert_response :created
+  end
+end
