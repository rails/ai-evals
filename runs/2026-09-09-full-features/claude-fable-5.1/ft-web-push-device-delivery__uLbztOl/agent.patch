+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create registers the browser's subscription for the current user" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: subscription_params, headers: { "User-Agent" => "Fizzy Test Browser" }
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/subscription/abc", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal "Fizzy Test Browser", subscription.user_agent
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: subscription_params, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create is idempotent for the same subscription" do
+    post user_push_subscriptions_path(@user), params: subscription_params
+    assert_response :created
+
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      post user_push_subscriptions_path(@user), params: subscription_params
+    end
+
+    assert_response :created
+  end
+
+  test "create requires the subscription details" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: "https://push.example.com/subscription/abc" } }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create is forbidden for other users" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: subscription_params
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create requires authentication" do
+    sign_out
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: subscription_params
+    end
+
+    assert_response :redirect
+  end
+
+  private
+    def subscription_params
+      { push_subscription: { endpoint: "https://push.example.com/subscription/abc", p256dh_key: "p256dh-key", auth_key: "auth-key" } }
+    end
+end
