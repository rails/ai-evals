+module Push
+  extend self
+
+  def table_name_prefix
+    "push_"
+  end
+
+  def vapid
+    Rails.configuration.x.vapid
+  end
+
+  # Web push needs a VAPID key pair to sign deliveries. Without one there's
+  # nothing for browsers to subscribe to, so the feature stays off.
+  def configured?
+    vapid.public_key.present? && vapid.private_key.present?
+  end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..5105127
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,21 @@
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+  # Deliveries are best effort: a subscription the push service no longer
+  # recognizes is dropped, and other push service errors are only logged.
+  def push(**params)
+    notification(**params).deliver
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized => error
+    Rails.logger.info "Destroying push subscription #{id}: #{error.message}"
+    destroy
+  rescue WebPush::ResponseError => error
+    Rails.logger.warn "Couldn't deliver push notification to subscription #{id}: #{error.message}"
+  end
+
+  def notification(**params)
+    WebPush::Notification.new(**params, endpoint: endpoint, p256dh_key: p256dh_key, auth_key: auth_key)
+  end
+end
