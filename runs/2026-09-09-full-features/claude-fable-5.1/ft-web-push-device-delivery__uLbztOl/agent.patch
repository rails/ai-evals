+++ b/app/controllers/users/push_subscriptions_controller.rb
@@ -0,0 +1,22 @@
+class Users::PushSubscriptionsController < ApplicationController
+  before_action :set_user
+  before_action :ensure_current_user
+
+  def create
+    @user.push_subscriptions.find_or_initialize_by(push_subscription_params).update!(user_agent: request.user_agent)
+    head :created
+  end
+
+  private
+    def set_user
+      @user = Current.account.users.find(params[:user_id])
+    end
+
+    def ensure_current_user
+      head :forbidden unless @user == Current.user
+    end
+
+    def push_subscription_params
+      params.expect(push_subscription: [ :endpoint, :p256dh_key, :auth_key ])
+    end
+end
diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..d66baff
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,143 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+// Turns web push notifications on or off for the browser in use. The browser
+// hands us the subscription it got from its push service, and we register it
+// with the server so whatever lands in the tray also reaches this device.
+export default class extends Controller {
+  static classes = [ "on" ]
+  static targets = [ "details", "enableButton" ]
+  static values = { subscriptionsUrl: String, vapidPublicKey: String }
+
+  async connect() {
+    if (this.#supported) {
+      await this.#refresh()
+    } else {
+      this.#displayBlocked()
+    }
+  }
+
+  async enable() {
+    this.enableButtonTarget.disabled = true
+
+    try {
+      if (this.#supported && await this.#requestPermission() === "granted") {
+        await this.#subscribe()
+      } else {
+        this.#displayBlocked()
+      }
+    } finally {
+      this.enableButtonTarget.disabled = false
+    }
+  }
+
+  async disable() {
+    const subscription = await this.#currentSubscription()
+    await subscription?.unsubscribe()
+    this.#displayOff()
+  }
+
+  async #refresh() {
+    if (Notification.permission === "denied") {
+      this.#displayBlocked()
+    } else {
+      const subscription = await this.#currentSubscription()
+
+      if (subscription && this.#signedWithCurrentKey(subscription)) {
+        // Keep the server in sync for this account, in case the browser subscribed from another one
+        await this.#save(subscription)
+        this.#displayOn()
+      } else if (subscription) {
+        // The VAPID key pair changed since this browser subscribed
+        await subscription.unsubscribe()
+        if (Notification.permission === "granted") await this.#subscribe()
+      }
+    }
+  }
+
+  async #requestPermission() {
+    try {
+      return await Notification.requestPermission()
+    } catch {
+      return "denied"
+    }
+  }
+
+  async #subscribe() {
+    try {
+      const registration = await this.#serviceWorkerRegistration()
+      const subscription = await registration.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+
+      await this.#save(subscription)
+      this.#displayOn()
+    } catch (error) {
+      console.error("Couldn't subscribe to push notifications", error)
+      this.#displayBlocked()
+    }
+  }
+
+  async #save(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+
+    return post(this.subscriptionsUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: p256dh, auth_key: auth } }
+    })
+  }
+
+  async #currentSubscription() {
+    const registration = await this.#serviceWorkerRegistration()
+    return registration.pushManager.getSubscription()
+  }
+
+  async #serviceWorkerRegistration() {
+    const registration = await navigator.serviceWorker.getRegistration("/")
+    if (!registration) await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+
+    return navigator.serviceWorker.ready
+  }
+
+  #signedWithCurrentKey(subscription) {
+    const key = subscription.options?.applicationServerKey
+    if (!key) return true
+
+    const current = this.#applicationServerKey
+    const existing = new Uint8Array(key)
+
+    return existing.length === current.length && existing.every((byte, index) => byte === current[index])
+  }
+
+  #displayOn() {
+    this.element.classList.add(this.onClass)
+    this.#hideDetails()
+  }
+
+  #displayOff() {
+    this.element.classList.remove(this.onClass)
+    this.#hideDetails()
+  }
+
+  #displayBlocked() {
+    this.element.classList.remove(this.onClass)
+    this.detailsTargets.forEach(details => details.hidden = false)
+    if (this.hasEnableButtonTarget) this.enableButtonTarget.hidden = true
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach(details => details.hidden = true)
+    if (this.hasEnableButtonTarget) this.enableButtonTarget.hidden = false
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  get #applicationServerKey() {
+    const base64 = this.vapidPublicKeyValue.replace(/-/g, "+").replace(/_/g, "/").replace(/=+$/, "")
+    const padded = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, "=")
+
+    return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+  }
+}
