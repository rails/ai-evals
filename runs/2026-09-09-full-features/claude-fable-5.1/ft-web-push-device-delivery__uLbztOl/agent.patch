new file mode 100644
index 0000000..d8a847b
--- /dev/null
+++ b/test/lib/web_push/notification_test.rb
@@ -0,0 +1,43 @@
+require "test_helper"
+
+class WebPush::NotificationTest < ActiveSupport::TestCase
+  setup do
+    # Keys a browser would hand us with its push subscription
+    browser_key = OpenSSL::PKey::EC.generate("prime256v1")
+    @p256dh_key = Base64.urlsafe_encode64(browser_key.public_key.to_octet_string(:uncompressed), padding: false)
+    @auth_key = Base64.urlsafe_encode64(SecureRandom.random_bytes(16), padding: false)
+
+    @notification = WebPush::Notification.new \
+      title: "RE: The logo isn't big enough", body: "I agree.", path: "/897362094/cards/1#comment_1", tag: "abc",
+      endpoint: "https://push.example.com/subscription/abc", p256dh_key: @p256dh_key, auth_key: @auth_key
+  end
+
+  test "message is what the service worker shows and opens" do
+    assert_equal({
+      title: "RE: The logo isn't big enough",
+      options: { body: "I agree.", icon: "/app-icon-192.png", data: { path: "/897362094/cards/1#comment_1" }, tag: "abc", renotify: true }
+    }, @notification.message)
+  end
+
+  test "deliver sends an encrypted, VAPID-signed push to the subscription's endpoint" do
+    stub_request(:post, "https://push.example.com/subscription/abc").to_return(status: 201)
+
+    @notification.deliver
+
+    assert_requested :post, "https://push.example.com/subscription/abc" do |request|
+      request.headers["Content-Encoding"] == "aes128gcm" &&
+        request.headers["Urgency"] == "high" &&
+        request.headers["Authorization"].start_with?("vapid t=") &&
+        request.headers["Authorization"].include?("k=#{Push.vapid.public_key.delete("=")}") &&
+        request.body.present? && !request.body.include?("I agree.")
+    end
+  end
+
+  test "deliver raises when the subscription is gone" do
+    stub_request(:post, "https://push.example.com/subscription/abc").to_return(status: 410)
+
+    assert_raises WebPush::ExpiredSubscription do
+      @notification.deliver
+    end
+  end
+end
diff --git a/test/models/notification/pushable_test.rb b/test/models/notification/pushable_test.rb
