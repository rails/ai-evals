diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..0af26fe 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -64,4 +64,28 @@ self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
 
+// Push notifications: show what the tray says, and open the card it's about
+self.addEventListener("push", (event) => {
+  const { title, options } = event.data.json()
+  event.waitUntil(self.registration.showNotification(title, options))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openPath(event.notification.data?.path || "/"))
+})
+
+async function openPath(path) {
+  const url = new URL(path, self.location.origin).href
+  const windows = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+  const client = windows.find(window => window.url === url) || windows[0]
+
+  if (client) {
+    await client.focus()
+    if (client.url !== url && "navigate" in client) await client.navigate(url)
+  } else {
+    await self.clients.openWindow(url)
+  }
+}
+
 TurboOffline.start()
