@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.com/subscription/abc", p256dh_key: "p256dh-key", auth_key: "auth-key")
+  end
+
+  test "belongs to the user's account" do
+    assert_equal accounts(:"37s"), @subscription.account
+  end
+
+  test "notification carries the subscription's keys" do
+    notification = @subscription.notification(title: "Title", body: "Body", path: "/cards/1")
+
+    assert_equal "https://push.example.com/subscription/abc", notification.endpoint
+    assert_equal "p256dh-key", notification.p256dh_key
+    assert_equal "auth-key", notification.auth_key
+    assert_equal "Title", notification.title
+    assert_equal "Body", notification.body
+    assert_equal "/cards/1", notification.path
+  end
+
+  test "push delivers a notification" do
+    WebPush.expects(:payload_send).with do |options|
+      options[:endpoint] == "https://push.example.com/subscription/abc" &&
+        options[:p256dh] == "p256dh-key" &&
+        options[:auth] == "auth-key" &&
+        JSON.parse(options[:message]).dig("options", "data", "path") == "/cards/1"
+    end
+
+    @subscription.push(title: "Title", body: "Body", path: "/cards/1")
+  end
+
+  test "push destroys the subscription when the push service no longer knows it" do
+    [ WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized ].each do |error|
+      subscription = users(:kevin).push_subscriptions.create!(endpoint: "https://push.example.com/#{error.name.demodulize}", p256dh_key: "p256dh-key", auth_key: "auth-key")
+      WebPush.stubs(:payload_send).raises(error.new(stub(code: "410", body: ""), "push.example.com"))
+
+      subscription.push(title: "Title", body: "Body", path: "/cards/1")
+
+      assert_not Push::Subscription.exists?(subscription.id)
+    end
+  end
+
+  test "push keeps the subscription through other push service errors" do
+    WebPush.stubs(:payload_send).raises(WebPush::PushServiceError.new(stub(code: "500", body: ""), "push.example.com"))
+
+    assert_nothing_raised do
+      @subscription.push(title: "Title", body: "Body", path: "/cards/1")
+    end
+
+    assert Push::Subscription.exists?(@subscription.id)
+  end
+
+  test "subscriptions go away with the user" do
+    users(:kevin).destroy
+
+    assert_not Push::Subscription.exists?(@subscription.id)
+  end
+
+  test "subscriptions go away when the user is deactivated" do
+    users(:kevin).deactivate
+
+    assert_not Push::Subscription.exists?(@subscription.id)
+  end
+end
