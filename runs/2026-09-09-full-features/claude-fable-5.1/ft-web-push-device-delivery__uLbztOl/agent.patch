@@ -0,0 +1,99 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @subscription = @kevin.push_subscriptions.create!(endpoint: "https://push.example.com/subscription/kevin", p256dh_key: "p256dh-key", auth_key: "auth-key")
+  end
+
+  test "a notification landing in the tray is pushed to the user's subscriptions" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_with job: Notification::PushJob do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "a notification bumped by a new source is pushed again" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_enqueued_with job: Notification::PushJob, args: [ notification ] do
+      notification.update!(source: events(:logo_published), read_at: nil, unread_count: notification.unread_count + 1)
+    end
+  end
+
+  test "reading or unreading a notification doesn't push" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "nothing is pushed for users without subscriptions" do
+    @subscription.destroy
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notifications(:layout_commented_kevin).destroy
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "nothing is pushed without a VAPID key pair" do
+    Push.stubs(:configured?).returns(false)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notifications(:layout_commented_kevin).destroy
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "push says what the tray says and opens the card it's about" do
+    notification = notifications(:logo_assignment_kevin)
+    payload = notification.push_payload
+
+    assert_equal "The logo isn't big enough", payload[:title]
+    assert_equal "Assigned to Kevin", payload[:body]
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.number}", payload[:path]
+    assert_equal notification.id, payload[:tag]
+  end
+
+  test "push for a mention opens the comment it's about" do
+    notification = notifications(:logo_mentioned_david)
+    payload = notification.push_payload
+
+    assert_equal "JZ @mentioned you", payload[:title]
+    assert_equal "I agree.", payload[:body]
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.number}#comment_#{notification.source.source.id}", payload[:path]
+  end
+
+  test "push now delivers to every subscription of the user" do
+    other_subscription = @kevin.push_subscriptions.create!(endpoint: "https://push.example.com/subscription/kevin-phone", p256dh_key: "p256dh-key", auth_key: "auth-key")
+    notification = notifications(:logo_assignment_kevin)
+
+    endpoints = []
+    WebPush.expects(:payload_send).twice.with { |options| endpoints << options[:endpoint] }
+
+    perform_enqueued_jobs only: Notification::PushJob do
+      notification.push_later
+    end
+
+    assert_equal [ @subscription.endpoint, other_subscription.endpoint ].sort, endpoints.sort
+  end
+
+  test "push now renders the message with account-scoped paths" do
+    notification = notifications(:logo_assignment_kevin)
+
+    WebPush.expects(:payload_send).with do |options|
+      message = JSON.parse(options[:message])
+      message["title"] == "The logo isn't big enough" &&
+        message.dig("options", "body") == "Assigned to Kevin" &&
+        message.dig("options", "data", "path") == "#{notification.account.slug}/cards/#{notification.card.number}"
+    end
+
+    perform_enqueued_jobs only: Notification::PushJob do
+      notification.push_later
+    end
+  end
+end
