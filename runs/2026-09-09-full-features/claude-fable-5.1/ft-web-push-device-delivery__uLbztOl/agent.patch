diff --git a/app/models/notification/pushable.rb b/app/models/notification/pushable.rb
new file mode 100644
index 0000000..9f568c9
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,44 @@
+# Whatever lands in someone's tray also reaches the browsers they've turned
+# push notifications on for. The push says what the tray says, and opens the
+# card it's about.
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: :pushable?
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self)
+  end
+
+  def push_now
+    if source.present? && card.present?
+      payload = push_payload
+
+      user.push_subscriptions.each do |subscription|
+        subscription.push(**payload)
+      end
+    end
+  end
+
+  def push_payload
+    tray_summary.symbolize_keys.merge(path: push_path, tag: id)
+  end
+
+  private
+    # A new source is what lands a notification in the tray, whether the
+    # notification was just created or resurfaced for a card already there.
+    def pushable?
+      source_id_previously_changed? && Push.configured? && user.push_subscriptions.exists?
+    end
+
+    def tray_summary
+      JSON.parse ApplicationController.renderer.render \
+        partial: "notifications/notification/#{source_type.underscore}/body", formats: :json, locals: { notification: self }
+    end
+
+    def push_path
+      Rails.application.routes.url_helpers.polymorphic_url(notifiable_target, only_path: true, script_name: account.slug)
+    end
+end
