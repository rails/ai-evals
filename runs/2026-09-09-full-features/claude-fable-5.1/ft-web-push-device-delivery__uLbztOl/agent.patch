diff --git a/config/initializers/web_push.rb b/config/initializers/web_push.rb
new file mode 100644
index 0000000..f74ee68
--- /dev/null
+++ b/config/initializers/web_push.rb
@@ -0,0 +1,26 @@
+# Web push notifications are signed with a VAPID key pair that ops provide as
+# VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY. Generate a pair with:
+#
+#   bin/rails web_push:vapid_key
+#
+# Without a pair, push notifications stay off. In development and test, a pair
+# is generated on first boot and kept in tmp/vapid_key.json.
+Rails.application.configure do
+  config.x.vapid.public_key = ENV["VAPID_PUBLIC_KEY"].presence
+  config.x.vapid.private_key = ENV["VAPID_PRIVATE_KEY"].presence
+  config.x.vapid.subject = ENV["BASE_URL"].presence || "mailto:#{Mail::Address.new(ENV.fetch("MAILER_FROM_ADDRESS", "support@fizzy.do")).address}"
+
+  if Rails.env.local? && config.x.vapid.public_key.blank? && config.x.vapid.private_key.blank?
+    key_file = Rails.root.join("tmp/vapid_key.json")
+
+    unless key_file.exist?
+      key = WebPush.generate_key
+      key_file.dirname.mkpath
+      key_file.write JSON.pretty_generate(public_key: key.public_key, private_key: key.private_key)
+    end
+
+    key = JSON.parse(key_file.read)
+    config.x.vapid.public_key = key["public_key"]
+    config.x.vapid.private_key = key["private_key"]
+  end
+end
