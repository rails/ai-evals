+namespace :web_push do
+  desc "Generate a VAPID key pair for signing web push notifications"
+  task :vapid_key do
+    require "web_push"
+
+    key = WebPush.generate_key
+
+    puts "VAPID_PUBLIC_KEY=#{key.public_key}"
+    puts "VAPID_PRIVATE_KEY=#{key.private_key}"
