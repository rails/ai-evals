diff --git a/lib/web_push/notification.rb b/lib/web_push/notification.rb
new file mode 100644
index 0000000..9b7467e
--- /dev/null
+++ b/lib/web_push/notification.rb
@@ -0,0 +1,39 @@
+# A single web push message for one browser subscription, signed with the
+# instance's VAPID key pair. The service worker shows `title` and `body` and
+# opens `path` when the notification is clicked.
+class WebPush::Notification
+  ICON_PATH = "/app-icon-192.png"
+
+  attr_reader :title, :body, :path, :tag, :endpoint, :p256dh_key, :auth_key
+
+  def initialize(title:, body:, path:, endpoint:, p256dh_key:, auth_key:, tag: nil)
+    @title, @body, @path, @tag = title, body, path, tag
+    @endpoint, @p256dh_key, @auth_key = endpoint, p256dh_key, auth_key
+  end
+
+  def deliver
+    WebPush.payload_send \
+      message: JSON.generate(message),
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: vapid_identification,
+      urgency: "high"
+  end
+
+  def message
+    { title: title, options: options }
+  end
+
+  private
+    def options
+      { body: body, icon: ICON_PATH, data: { path: path } }.tap do |options|
+        # Tagged notifications replace an earlier one about the same thing, like the tray does
+        options.merge!(tag: tag, renotify: true) if tag.present?
+      end
+    end
+
+    def vapid_identification
+      { subject: Push.vapid.subject, public_key: Push.vapid.public_key, private_key: Push.vapid.private_key }
+    end
+end
