@@ -0,0 +1,39 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "details for assignment changes" do
+    assert_equal({ assignee_ids: [ users(:jz).id ] }, events(:logo_assignment_jz).details)
+  end
+
+  test "details for board changes" do
+    event = build_event("card_board_changed", old_board: "Writebook", new_board: "Campfire")
+
+    assert_equal({ old_board: "Writebook", new_board: "Campfire" }, event.details)
+  end
+
+  test "details for title changes" do
+    event = build_event("card_title_changed", old_title: "Old", new_title: "New")
+
+    assert_equal({ old_title: "Old", new_title: "New" }, event.details)
+  end
+
+  test "details for triage" do
+    assert_equal({ column: "Doing" }, build_event("card_triaged", column: "Doing").details)
+  end
+
+  test "details use empty strings for missing values" do
+    assert_equal({ old_board: "", new_board: "" }, build_event("card_board_changed").details)
+    assert_equal({ old_title: "", new_title: "" }, build_event("card_title_changed").details)
+    assert_equal({ column: "" }, build_event("card_triaged").details)
+  end
+
+  test "details are empty for other events" do
+    assert_equal({}, events(:logo_published).details)
+    assert_equal({}, events(:layout_commented).details)
+  end
+
+  private
+    def build_event(action, **particulars)
+      cards(:logo).events.build action: action, creator: users(:david), particulars: particulars.presence ? { particulars: particulars } : {}
+    end
+end
