@@ -0,0 +1,136 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_equal users(:kevin).accessible_events.activities.count, @response.parsed_body.count
+
+    ids = @response.parsed_body.map { |activity| activity["id"] }
+    assert_equal users(:kevin).accessible_events.activities.reverse_chronologically.ids, ids
+  end
+
+  test "index includes the event details" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == events(:layout_assignment_jz).id }
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ], activity.keys
+    assert_equal "card_assigned", activity["action"]
+    assert_equal events(:layout_assignment_jz).description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity["particulars"])
+    assert_equal card_url(cards(:layout)), activity["url"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal cards(:layout).id, activity["eventable"]["id"]
+    assert_equal cards(:layout).title, activity["eventable"]["title"]
+    assert_equal boards(:writebook).id, activity["board"]["id"]
+    assert_equal users(:david).id, activity["creator"]["id"]
+  end
+
+  test "index links comment events to the comment on the card" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |activity| activity["id"] == events(:layout_commented).id }
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal comments(:layout_overflowing_david).id, activity["eventable"]["id"]
+    assert_equal card_url(cards(:layout), anchor: "comment_#{comments(:layout_overflowing_david).id}"), activity["url"]
+  end
+
+  test "index includes title changes and omits collection changes" do
+    title_changed = track_event(cards(:logo), "card_title_changed", particulars: { old_title: "Old", new_title: "New" })
+    collection_changed = track_event(cards(:logo), "card_collection_changed", particulars: { new_collection: "Elsewhere" })
+
+    get activities_path, as: :json
+
+    ids = @response.parsed_body.map { |activity| activity["id"] }
+    assert_includes ids, title_changed.id
+    assert_not_includes ids, collection_changed.id
+  end
+
+  test "index exposes particulars for board, title, and triage changes" do
+    board_changed = track_event(cards(:logo), "card_board_changed", particulars: { old_board: "Writebook", new_board: "Campfire" })
+    title_changed = track_event(cards(:logo), "card_title_changed", particulars: { old_title: "Old", new_title: "New" })
+    triaged = track_event(cards(:logo), "card_triaged", particulars: { column: "Doing" })
+    triaged_without_column = track_event(cards(:logo), "card_triaged")
+
+    get activities_path, as: :json
+
+    activities = @response.parsed_body.index_by { |activity| activity["id"] }
+    assert_equal({ "old_board" => "Writebook", "new_board" => "Campfire" }, activities[board_changed.id]["particulars"])
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, activities[title_changed.id]["particulars"])
+    assert_equal({ "column" => "Doing" }, activities[triaged.id]["particulars"])
+    assert_equal({ "column" => "" }, activities[triaged_without_column.id]["particulars"])
+    assert_equal({}, activities[events(:logo_published).id]["particulars"])
+  end
+
+  test "index filtered by creators" do
+    get activities_path(creator_ids: [ users(:kevin).id ]), as: :json
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |activity| activity["creator"]["id"] == users(:kevin).id }
+  end
+
+  test "index filtered by boards" do
+    private_event = private_card.events.first
+
+    get activities_path(board_ids: [ boards(:private).id ]), as: :json
+
+    assert_response :success
+    assert_equal [ private_event.id ], @response.parsed_body.map { |activity| activity["id"] }
+  end
+
+  test "index only includes activity from accessible boards" do
+    private_event = private_card.events.first
+
+    logout_and_sign_in_as :jz
+    get activities_path, as: :json
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert_not_includes @response.parsed_body.map { |activity| activity["id"] }, private_event.id
+  end
+
+  test "index is paginated" do
+    40.times { track_event(cards(:logo), "card_reopened") }
+
+    expected_ids = users(:kevin).accessible_events.activities.reverse_chronologically.ids
+    actual_ids = []
+    next_page = activities_path(format: :json)
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+
+      page_count += 1
+      actual_ids.concat(@response.parsed_body.map { |activity| activity["id"] })
+      next_page = next_page_from_link_header(@response.headers["Link"])
+    end
+
+    assert_equal expected_ids, actual_ids
+    assert_operator page_count, :>, 1
+  end
+
+  private
+    def track_event(card, action, particulars: nil)
+      card.events.create! action: action, creator: users(:kevin), board: card.board, particulars: particulars ? { particulars: particulars } : {}
+    end
+
+    def private_card
+      Current.set(user: users(:kevin)) do
+        boards(:private).cards.create! title: "Secret", creator: users(:kevin), status: "published"
+      end
+    end
+
+    def next_page_from_link_header(link_header)
+      url = link_header&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      URI.parse(url).request_uri if url
+    end
+end
