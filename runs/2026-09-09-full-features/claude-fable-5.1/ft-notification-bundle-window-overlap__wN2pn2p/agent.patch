+class Notification::BundleMailer < ApplicationMailer
+  def digest(bundle)
+    @bundle = bundle
+    @user = bundle.user
+    @notifications = bundle.notifications.unread.preloaded.order(updated_at: :desc)
+
+    mail to: @user.identity.email_address, subject: subject
+  end
+
+  private
+    def subject
+      "#{@notifications.size} new #{"notification".pluralize(@notifications.size)} in #{@bundle.account.name}"
+    end
+
+    def default_url_options
+      super.merge(script_name: @bundle.account.slug)
+    end
+end
