+<tr>
+  <td>
+    <h1 class="title">Here’s what happened in <%= @bundle.account.name %></h1>
+    <p class="subtitle">
+      <%= pluralize(@notifications.size, "notification") %> since
+      <%= @bundle.window_starts_at.in_time_zone(@user.timezone).strftime("%A, %B %-d at %-l:%M %p") %>
+    </p>
+
+    <% @notifications.group_by { it.card.board }.each_with_index do |(board, notifications), index| %>
