diff --git a/test/mailers/notification/bundle_mailer_test.rb b/test/mailers/notification/bundle_mailer_test.rb
new file mode 100644
index 0000000..3619786
--- /dev/null
+++ b/test/mailers/notification/bundle_mailer_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Notification::BundleMailerTest < ActionMailer::TestCase
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @bundle = @user.notification_bundles.create!(window_starts_at: 1.day.ago)
+    @user.notifications.update_all(bundle_id: @bundle.id)
+  end
+
+  test "digest goes to the person with one email for the whole window" do
+    email = Notification::BundleMailer.digest(@bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ @user.identity.email_address ], email.to
+    assert_equal "3 new notifications in 37signals", email.subject
+    assert email.html_part.present?
+    assert email.text_part.present?
+  end
+
+  test "digest lists each unread notification with account-scoped links" do
+    notifications(:logo_assignment_kevin).read
+    email = Notification::BundleMailer.digest(@bundle)
+
+    assert_equal "2 new notifications in 37signals", email.subject
+    assert_match "Layout is broken", email.html_part.body.encoded
+    assert_match "Buy domain", email.html_part.body.encoded
+    assert_no_match "The logo isn", email.html_part.body.encoded
+    assert_match %r{http://example.com#{@user.account.slug}/cards/#{cards(:layout).number}}, email.html_part.body.encoded
+    assert_match %r{http://example.com#{@user.account.slug}/cards/#{cards(:layout).number}}, email.text_part.body.encoded
+  end
+
+  test "digest groups notifications by board" do
+    email = Notification::BundleMailer.digest(@bundle)
+
+    assert_match cards(:layout).board.name, email.html_part.body.encoded
+    assert_match cards(:buy_domain).board.name, email.html_part.body.encoded
+  end
+
+  test "digest links to notification settings to change the frequency" do
+    email = Notification::BundleMailer.digest(@bundle)
+
+    assert_match "daily", email.html_part.body.encoded
+    assert_match %r{http://example.com#{@user.account.slug}/notifications/settings}, email.html_part.body.encoded
+  end
+end
diff --git a/test/mailers/previews/notification/bundle_mailer_preview.rb b/test/mailers/previews/notification/bundle_mailer_preview.rb
new file mode 100644
index 0000000..75721c5
--- /dev/null
+++ b/test/mailers/previews/notification/bundle_mailer_preview.rb
@@ -0,0 +1,17 @@
+class Notification::BundleMailerPreview < ActionMailer::Preview
+  def digest
+    bundle = Notification::Bundle.joins(:notifications).distinct.sample || sample_bundle
+    Current.account = bundle.account
+
+    Notification::BundleMailer.digest(bundle)
+  end
+
+  private
+    def sample_bundle
+      user = User.active.joins(:notifications).distinct.sample
+
+      user.notification_bundles.create!(window_starts_at: 1.day.ago, window_ends_at: Time.current).tap do |bundle|
+        user.notifications.unread.limit(5).update_all(bundle_id: bundle.id)
+      end
+    end
+end
diff --git a/test/models/notification/bundle_test.rb b/test/models/notification/bundle_test.rb
new file mode 100644
index 0000000..0dd5e02
--- /dev/null
+++ b/test/models/notification/bundle_test.rb
@@ -0,0 +1,177 @@
+require "test_helper"
+
+class Notification::BundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:kevin)
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    @notification = notifications(:logo_assignment_kevin)
+  end
+
+  test "the clock starts when the first notification lands" do
+    travel_to Time.current do
+      bundle = Notification::Bundle.for(land(@notification))
+
+      assert_equal Time.current, bundle.window_starts_at
+      assert_equal 4.hours.from_now, bundle.window_ends_at
+      assert_not bundle.delivered?
+    end
+  end
+
+  test "window length follows the person's frequency" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+    bundle = Notification::Bundle.for(land(@notification))
+    assert_equal bundle.window_starts_at + 1.day, bundle.window_ends_at
+
+    @user.settings.update!(bundle_email_frequency: "weekly")
+    bundle = Notification::Bundle.for(land(notifications(:layout_commented_kevin), at: 2.days.from_now))
+    assert_equal bundle.window_starts_at + 1.week, bundle.window_ends_at
+  end
+
+  test "notifications landing within an open window share it" do
+    first = Notification::Bundle.for(land(@notification))
+    second = Notification::Bundle.for(land(notifications(:layout_commented_kevin), at: 1.hour.from_now))
+
+    assert_equal first, second
+    assert_equal 1, @user.notification_bundles.count
+  end
+
+  test "a notification landing after the window closes opens a new one" do
+    travel_to Time.current do
+      first = Notification::Bundle.for(land(@notification))
+      second = Notification::Bundle.for(land(notifications(:layout_commented_kevin), at: 5.hours.from_now))
+
+      assert_not_equal first, second
+      assert_equal 5.hours.from_now, second.window_starts_at
+    end
+  end
+
+  test "late notifications belong to the window that had already opened" do
+    first = travel_to(3.hours.ago) { Notification::Bundle.for(land(@notification)) }
+    late = land(notifications(:layout_commented_kevin), at: 2.hours.ago)
+
+    travel_to 2.hours.from_now do
+      assert first.window_ends_at.past?
+      assert_equal first, Notification::Bundle.for(late)
+    end
+  end
+
+  test "late notifications never reopen a window that was already delivered" do
+    first = Notification::Bundle.for(land(@notification))
+    first.update!(delivered_at: Time.current)
+
+    second = Notification::Bundle.for(land(notifications(:layout_commented_kevin), at: 1.hour.from_now))
+
+    assert_not_equal first, second
+    assert_equal first.window_ends_at, second.window_starts_at
+    assert_no_overlapping_windows
+  end
+
+  test "late notifications landing in a gap join the next window still open" do
+    first = Notification::Bundle.for(land(@notification))
+    first.update!(delivered_at: Time.current)
+    second = Notification::Bundle.for(land(notifications(:layout_commented_kevin), at: 6.hours.from_now))
+
+    late = land(notifications(:buy_domain_sent_back_to_triage_kevin), at: 5.hours.from_now)
+
+    assert_equal second, Notification::Bundle.for(late)
+    assert_no_overlapping_windows
+  end
+
+  test "windows never overlap however out of order notifications arrive" do
+    [ 0, 3, 5, 1, 9, 4, 30, 2 ].each do |hours|
+      bundle = Notification::Bundle.for(land(@notification, at: hours.hours.from_now))
+      bundle.update!(delivered_at: Time.current) if hours.odd?
+    end
+
+    assert_operator @user.notification_bundles.count, :>, 1
+    assert_no_overlapping_windows
+  end
+
+  test "deliver emails the bundle once and marks it delivered" do
+    bundle = Notification::Bundle.for(land(@notification))
+    @notification.update_column :bundle_id, bundle.id
+
+    assert_enqueued_emails 1 do
+      bundle.deliver
+    end
+    assert bundle.reload.delivered?
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+  end
+
+  test "deliver skips the email when nothing is left unread" do
+    bundle = Notification::Bundle.for(land(@notification))
+    @notification.update_column :bundle_id, bundle.id
+    @notification.read
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver skips the email once the person turned bundles off" do
+    bundle = Notification::Bundle.for(land(@notification))
+    @notification.update_column :bundle_id, bundle.id
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver skips the email for deactivated people" do
+    bundle = Notification::Bundle.for(land(@notification))
+    @notification.update_column :bundle_id, bundle.id
+    @user.deactivate
+
+    assert_no_enqueued_emails do
+      bundle.deliver
+    end
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver_all_due delivers pending bundles whose window has closed" do
+    due = travel_to(5.hours.ago) { Notification::Bundle.for(land(@notification)) }
+    open = Notification::Bundle.for(land(notifications(:layout_commented_kevin)))
+
+    assert_enqueued_with(job: Notification::Bundle::DeliveryJob, args: [ due ]) do
+      Notification::Bundle.deliver_all_due
+    end
+    assert_no_enqueued_jobs(only: Notification::Bundle::DeliveryJob) { }
+
+    perform_enqueued_jobs only: Notification::Bundle::DeliveryJob
+
+    assert due.reload.delivered?
+    assert_not open.reload.delivered?
+  end
+
+  test "deliver_all_due enqueues deliveries within the bundle's account" do
+    Current.account = nil
+    due = travel_to(5.hours.ago) { Notification::Bundle.for(land(@notification)) }
+
+    Notification::Bundle.deliver_all_due
+
+    job = enqueued_jobs.find { it["job_class"] == "Notification::Bundle::DeliveryJob" }
+    assert_equal due.account.to_gid, job["account"]
+  end
+
+  private
+    def land(notification, at: Time.current)
+      notification.tap { it.update_column :updated_at, at }
+    end
+
+    def assert_no_overlapping_windows
+      windows = @user.notification_bundles.chronologically.to_a
+
+      windows.each_cons(2) do |earlier, later|
+        assert earlier.window_ends_at <= later.window_starts_at,
+          "#{earlier.window_starts_at}–#{earlier.window_ends_at} overlaps #{later.window_starts_at}–#{later.window_ends_at}"
+      end
+    end
+end
diff --git a/test/models/notification/bundleable_test.rb b/test/models/notification/bundleable_test.rb
new file mode 100644
index 0000000..3cd8013
--- /dev/null
+++ b/test/models/notification/bundleable_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Notification::BundleableTest < ActiveSupport::TestCase
+  setup do
+    @user = users(:david)
+    @user.settings.update!(bundle_email_frequency: "daily")
+    @notification = notifications(:logo_mentioned_david)
+  end
+
+  test "bundle_later enqueues Notification::BundleJob" do
+    assert_enqueued_with(job: Notification::BundleJob, args: [ @notification ]) do
+      @notification.bundle_later
+    end
+  end
+
+  test "bundle_later is called after notification is created" do
+    assert_enqueued_with(job: Notification::BundleJob) do
+      @user.notifications.create!(source: events(:layout_published), creator: users(:jason))
+    end
+  end
+
+  test "bundle_later is called when notification source changes" do
+    assert_enqueued_with(job: Notification::BundleJob) do
+      @notification.update!(source: events(:logo_published))
+    end
+  end
+
+  test "bundle_later is not called for other updates" do
+    assert_no_enqueued_jobs only: Notification::BundleJob do
+      @notification.read
+    end
+  end
+
+  test "bundle_now files the notification into its window" do
+    assert_difference -> { @user.notification_bundles.count }, 1 do
+      @notification.bundle_now
+    end
+
+    assert @notification.reload.bundle.covers?(@notification.updated_at)
+    assert_includes @notification.bundle.notifications, @notification
+  end
+
+  test "bundle_now keeps a notification in its open window when more activity lands" do
+    @notification.update!(source: events(:logo_published))
+    @notification.bundle_now
+    bundle = @notification.reload.bundle
+
+    @notification.update!(source: events(:logo_assignment_david))
+    @notification.bundle_now
+
+    assert_equal bundle, @notification.reload.bundle
+  end
+
+  test "bundle_now moves a notification to a new window once its old one was delivered" do
+    @notification.bundle_now
+    delivered = @notification.reload.bundle
+    delivered.update!(delivered_at: Time.current)
+
+    travel_to 2.days.from_now do
+      @notification.update!(source: events(:logo_published))
+      @notification.bundle_now
+    end
+
+    assert_not_equal delivered, @notification.reload.bundle
+    assert_equal 2, @user.notification_bundles.count
+  end
+
+  test "bundle_now does nothing for people who never want bundle emails" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      @notification.bundle_now
+    end
+
+    assert_nil @notification.reload.bundle
+  end
+
+  test "bundle_now does nothing for system notifications" do
+    @notification.update!(creator: users(:system))
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      @notification.bundle_now
+    end
+  end
+
+  test "bundle_now does nothing for cancelled accounts" do
+    @user.account.cancel(initiated_by: @user)
+
+    assert_no_difference -> { Notification::Bundle.count } do
+      @notification.bundle_now
+    end
+  end
+
+  test "bundle_now leaves the notification untouched otherwise" do
+    assert_no_changes -> { @notification.reload.updated_at } do
+      assert_no_turbo_stream_broadcasts [ @user, :notifications ] do
+        @notification.bundle_now
+      end
+    end
+  end
+end
diff --git a/test/models/user/settings_test.rb b/test/models/user/settings_test.rb
