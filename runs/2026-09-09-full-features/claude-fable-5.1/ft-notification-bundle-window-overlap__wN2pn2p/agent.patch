+++ b/test/models/user/settings_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class User::SettingsTest < ActiveSupport::TestCase
+  setup do
+    @settings = users(:david).settings
+  end
+
+  test "bundle emails are off by default" do
+    assert @settings.never?
+    assert_not @settings.bundles_email?
+    assert_nil @settings.bundle_email_window
+  end
+
+  test "each frequency has a window" do
+    assert_equal 4.hours, @settings.tap { it.bundle_email_frequency = "every_few_hours" }.bundle_email_window
+    assert_equal 1.day, @settings.tap { it.bundle_email_frequency = "daily" }.bundle_email_window
+    assert_equal 1.week, @settings.tap { it.bundle_email_frequency = "weekly" }.bundle_email_window
+    assert @settings.bundles_email?
+  end
+
+  test "frequency must be one of the known ones" do
+    @settings.bundle_email_frequency = "hourly"
+
+    assert_not @settings.valid?
+    assert @settings.errors.of_kind?(:bundle_email_frequency, :inclusion)
+  end
+end
