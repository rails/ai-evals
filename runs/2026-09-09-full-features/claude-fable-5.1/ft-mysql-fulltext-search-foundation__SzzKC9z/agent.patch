+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "terms are the distinct words of the query" do
+    assert_equal %w[ logo big ], Search.new("  logo   big logo ").terms
+    assert_equal "logo big logo", Search.new("  logo   big logo ").query
+  end
+
+  test "a search without terms is blank and finds nothing" do
+    assert Search.new(nil).blank?
+    assert Search.new("   ").blank?
+    assert_empty Search.new("   ").cards
+  end
+
+  test "cards are found newest first" do
+    cards(:text).update! created_at: 1.day.ago
+    cards(:logo).update! created_at: 2.days.ago
+    cards(:layout).update! created_at: 3.days.ago
+
+    assert_equal [ cards(:text), cards(:logo), cards(:layout) ], Search.new("is").cards.to_a
+  end
+
+  test "cards are only found on boards the searcher can access" do
+    private_card = boards(:private).cards.create! title: "Secret logo plans", status: :published
+
+    assert_includes Search.new("logo", searcher: users(:kevin)).cards, private_card
+    assert_not_includes Search.new("logo", searcher: users(:david)).cards, private_card
+    assert_includes Search.new("logo", searcher: users(:david)).cards, cards(:logo)
+  end
+
+  test "revoking access removes cards from the results right away" do
+    board = boards(:writebook)
+    board.update! all_access: false
+
