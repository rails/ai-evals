new file mode 100644
index 0000000..ae6ad74
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,34 @@
+module SearchesHelper
+  EXCERPT_RADIUS = 120
+
+  def search_field_tag(search)
+    text_field_tag :q, search.query,
+      type: "search",
+      placeholder: "Search cards and comments…",
+      class: "input",
+      autofocus: search.blank?,
+      autocorrect: "off",
+      autocomplete: "off",
+      aria: { label: "Search cards and comments" },
+      data: { "1p-ignore": "true" }
+  end
+
+  # Wraps every occurrence of the search terms in <mark>, escaping any other markup in the text.
+  def highlight_search_terms(text, search)
+    highlight text.to_s, search.terms
+  end
+
+  # A highlighted window of plain text around the first term found in the content, or nothing when none is found.
+  def search_excerpt(content, search)
+    text = content.respond_to?(:to_plain_text) ? content.to_plain_text : content.to_s
+
+    if snippet = excerpt(text.squish, search_terms_pattern(search), radius: EXCERPT_RADIUS)
+      highlight_search_terms snippet, search
+    end
+  end
+
+  private
+    def search_terms_pattern(search)
+      Regexp.union(search.terms.collect { |term| Regexp.new(Regexp.escape(term), Regexp::IGNORECASE) })
+    end
+end
