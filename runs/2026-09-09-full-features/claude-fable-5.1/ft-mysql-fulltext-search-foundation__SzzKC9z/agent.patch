+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,49 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "matching by title, ignoring case" do
+    assert_equal [ cards(:logo) ], Card.matching("LOGO").to_a
+  end
+
+  test "matching by description" do
+    cards(:shipping).update! description: "Launch before the <strong>conference</strong>"
+
+    assert_equal [ cards(:shipping) ], Card.matching("conference").to_a
+  end
+
+  test "matching by the body of a comment, without duplicating cards with several matching comments" do
+    cards(:layout).comments.create! body: "Still overflowing on my screen"
+
+    assert_equal [ cards(:layout) ], Card.matching("overflowing").to_a
+    assert_equal [ cards(:layout) ], Card.matching("container").to_a
+  end
+
+  test "matching requires every term, wherever each one appears" do
+    assert_equal [ cards(:layout) ], Card.matching(%w[ layout overflowing ]).to_a
+    assert_empty Card.matching(%w[ layout haggis ])
+  end
+
+  test "matching treats LIKE wildcards literally" do
+    cards(:logo).update! title: "Make the logo 100% bigger"
+
+    assert_equal [ cards(:logo) ], Card.matching("100%").to_a
+    assert_empty Card.matching("_")
+    assert_empty Card.matching("!")
+  end
+
+  test "comments matching no terms at all" do
+    assert_empty Comment.matching_any([])
+  end
+
+  test "comments matching any term" do
+    comments = Comment.matching_any(%w[ overflowing agree ])
+
+    assert_includes comments, comments(:layout_overflowing_david)
+    assert_includes comments, comments(:logo_agreement_jz)
+    assert_not_includes comments, comments(:logo_agreement_kevin)
+  end
+end
