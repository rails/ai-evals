@@ -0,0 +1,14 @@
+module Comment::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    # Comments whose body contains at least one of the terms.
+    scope :matching_any, ->(terms) do
+      if terms = Array(terms).presence
+        joins(:rich_text_body).where(terms.collect { |term| like_condition("action_text_rich_texts.body", term) }.join(" OR "))
+      else
+        none
+      end
+    end
+  end
+end
diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..c518822
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,28 @@
+class Search
+  attr_reader :query, :searcher
+
+  def initialize(query, searcher: Current.user)
+    @query, @searcher = query.to_s.squish, searcher
+  end
+
+  def terms
+    @terms ||= query.split.uniq
+  end
+
+  def blank?
+    terms.empty?
+  end
+
+  def cards
+    if blank?
+      Card.none
+    else
+      searcher.accessible_cards.published.preloaded.matching(terms).reverse_chronologically
+    end
+  end
+
+  # Comments on the given cards that contain one of the terms, keyed by card id, so results can show what matched.
+  def matching_comments_by_card_id(cards)
+    Comment.where(card: cards).matching_any(terms).with_rich_text_body.preload(creator: :avatar_attachment).chronologically.group_by(&:card_id)
+  end
+end
