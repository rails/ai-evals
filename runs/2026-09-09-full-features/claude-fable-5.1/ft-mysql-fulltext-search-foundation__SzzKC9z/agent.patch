+    <div class="blank-slate">No cards match “<%= @search.query %>”</div>
+  <% else %>
+    <div class="search__results" id="search_results">
+      <%= with_automatic_pagination :search_results, @page do %>
+        <%= render partial: "searches/result", collection: @page.records, as: :card,
+              locals: { search: @search, matching_comments_by_card_id: @matching_comments_by_card_id } %>
+      <% end %>
+    </div>
+  <% end %>
+</section>
