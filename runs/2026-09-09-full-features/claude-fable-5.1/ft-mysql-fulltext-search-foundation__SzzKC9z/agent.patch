diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..f9bfd63
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,127 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "show finds cards by title, highlighting the matched words" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "#search_results article", count: 1
+    assert_select "article#search_result_card_#{cards(:logo).id}" do
+      assert_select "a[href=?]", card_path(cards(:logo))
+      assert_select "mark", text: "logo"
+    end
+  end
+
+  test "show finds cards by description" do
+    cards(:shipping).update! description: "We should launch before the <strong>conference</strong>"
+
+    get search_path(q: "conference")
+
+    assert_response :success
+    assert_select "article#search_result_card_#{cards(:shipping).id}" do
+      assert_select "mark", text: "conference"
+    end
+  end
+
+  test "show finds cards by the body of a comment, showing the matching comment" do
+    get search_path(q: "overflowing")
+
+    assert_response :success
+    assert_select "#search_results article", count: 1
+    assert_select "article#search_result_card_#{cards(:layout).id}" do
+      assert_select "a#search_result_comment_#{comments(:layout_overflowing_david).id} mark", text: "overflowing"
+    end
+  end
+
+  test "show requires every word to match, whichever field it appears in" do
+    get search_path(q: "layout overflowing")
+
+    assert_response :success
+    assert_select "article#search_result_card_#{cards(:layout).id}"
+
+    get search_path(q: "layout haggis")
+
+    assert_response :success
+    assert_select "#search_results", count: 0
+  end
+
+  test "show lists newest cards first" do
+    cards(:text).update! created_at: 1.day.ago
+    cards(:logo).update! created_at: 2.days.ago
+    cards(:layout).update! created_at: 3.days.ago
+
+    get search_path(q: "is")
+
+    assert_response :success
+    assert_equal [ cards(:text), cards(:logo), cards(:layout) ].collect { |card| "search_result_card_#{card.id}" },
+      css_select("#search_results article[id^=search_result_card_]").collect { |li| li["id"] }
+  end
+
+  test "show only returns cards from boards the user can access" do
+    private_card = with_current_user(:kevin) do
+      boards(:private).cards.create! title: "Secret logo plans", status: :published, creator: users(:kevin)
+    end
+
+    get search_path(q: "logo")
+    assert_select "article#search_result_card_#{private_card.id}"
+
+    logout_and_sign_in_as :david
+    get search_path(q: "logo")
+    assert_response :success
+    assert_select "article#search_result_card_#{private_card.id}", count: 0
+    assert_select "article#search_result_card_#{cards(:logo).id}"
+  end
+
+  test "show never returns draft cards or their comments" do
+    draft = with_current_user(:kevin) do
+      boards(:writebook).cards.create!(title: "Draft about the logo", creator: users(:kevin), status: :published).tap do |card|
+        card.comments.create! body: "Overflowing draft comment", creator: users(:kevin)
+        card.update_columns status: "drafted"
+      end
+    end
+
+    get search_path(q: "logo")
+    assert_select "article#search_result_card_#{draft.id}", count: 0
+
+    get search_path(q: "overflowing")
+    assert_select "article#search_result_card_#{draft.id}", count: 0
+  end
+
+  test "show never returns cards from other accounts" do
+    get search_path(q: "radio")
+
+    assert_response :success
+    assert_select "article#search_result_card_#{cards(:radio).id}", count: 0
+  end
+
+  test "show with a blank query" do
+    get search_path
+    assert_response :success
+    assert_select "#search_results", count: 0
+
+    get search_path(q: "   ")
+    assert_response :success
+    assert_select "#search_results", count: 0
+  end
+
+  test "show escapes LIKE wildcards and markup in the query" do
+    get search_path(q: "%")
+    assert_response :success
+    assert_select "#search_results", count: 0
+
+    get search_path(q: "<script>alert(1)</script>")
+    assert_response :success
+    assert_no_match "<script>alert(1)</script>", response.body
+  end
+
+  test "show as JSON" do
+    get search_path(q: "logo", format: :json)
+
+    assert_response :success
+    assert_equal [ cards(:logo).number ], response.parsed_body.pluck("number")
+  end
+end
diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
