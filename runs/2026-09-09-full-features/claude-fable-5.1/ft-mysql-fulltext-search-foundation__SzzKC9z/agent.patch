diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..dcc9efd
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,44 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    # Cards containing every term somewhere in their title, description, or the body of one of their comments.
+    scope :matching, ->(terms) do
+      Array(terms).reduce(all) { |cards, term| cards.where(matching_term_condition(term)) }
+    end
+  end
+
+  class_methods do
+    def matching_term_condition(term)
+      [
+        like_condition("cards.title", term),
+        description_matching_condition(term),
+        comment_matching_condition(term)
+      ].join(" OR ")
+    end
+
+    private
+      def description_matching_condition(term)
+        <<~SQL.squish
+          EXISTS (
+            SELECT 1 FROM action_text_rich_texts descriptions
+            WHERE descriptions.record_type = 'Card' AND descriptions.name = 'description'
+              AND descriptions.record_id = cards.id
+              AND #{like_condition("descriptions.body", term)}
+          )
+        SQL
+      end
+
+      def comment_matching_condition(term)
+        <<~SQL.squish
+          EXISTS (
+            SELECT 1 FROM comments
+            INNER JOIN action_text_rich_texts bodies
+              ON bodies.record_type = 'Comment' AND bodies.name = 'body' AND bodies.record_id = comments.id
+            WHERE comments.card_id = cards.id
+              AND #{like_condition("bodies.body", term)}
+          )
+        SQL
+      end
+  end
+end
