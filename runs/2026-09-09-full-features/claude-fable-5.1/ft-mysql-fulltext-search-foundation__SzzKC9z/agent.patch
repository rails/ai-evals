@@ -2,4 +2,13 @@ class ApplicationRecord < ActiveRecord::Base
   primary_abstract_class
 
   configure_replica_connections
+
+  # `!` is the LIKE escape character because a literal backslash is quoted differently by SQLite and MySQL.
+  LIKE_ESCAPE = "!"
+
+  class << self
+    def like_condition(column, term)
+      sanitize_sql_array [ "#{column} LIKE ? ESCAPE '#{LIKE_ESCAPE}'", "%#{sanitize_sql_like(term, LIKE_ESCAPE)}%" ]
+    end
+  end
 end
