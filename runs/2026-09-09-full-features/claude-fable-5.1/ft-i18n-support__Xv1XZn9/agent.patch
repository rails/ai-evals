diff --git a/app/controllers/concerns/current_locale.rb b/app/controllers/concerns/current_locale.rb
new file mode 100644
index 0000000..f10c91b
--- /dev/null
+++ b/app/controllers/concerns/current_locale.rb
@@ -0,0 +1,36 @@
+module CurrentLocale
+  extend ActiveSupport::Concern
+
+  included do
+    around_action :switch_locale
+
+    etag { I18n.locale }
+    fragment_cache_key { I18n.locale }
+  end
+
+  private
+    def switch_locale(&)
+      resume_session unless authenticated? # Pages open to everyone resume the session later than this
+      remember_locale params[:locale] if I18n.locale_available?(params[:locale])
+      I18n.with_locale(Current.identity&.locale || locale_from_cookie || I18n.default_locale, &)
+    end
+
+    def remember_locale(locale)
+      cookies.permanent[:locale] = locale
+      Current.identity&.update!(locale: locale)
+    end
+
+    def locale_from_cookie
+      cookies[:locale] if I18n.locale_available?(cookies[:locale])
+    end
+
+    # A locale chosen before signing in sticks to the identity. Otherwise, the identity's
+    # locale follows them into this browser, so a clean browser speaks their language too.
+    def carry_locale_over_to(identity)
+      if locale_from_cookie
+        identity.update!(locale: locale_from_cookie) unless identity.locale == locale_from_cookie
+      elsif identity.locale
+        cookies.permanent[:locale] = identity.locale
+      end
+    end
+end
