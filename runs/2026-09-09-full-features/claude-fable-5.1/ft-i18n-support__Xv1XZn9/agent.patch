+          caption: "Fizzy orientation"
+        passkey:
+          title: "Then, set up a Passkey"
+          description_html: "<p>Passkeys let you sign in securely without using passwords or email codes. To set one up, open the Fizzy menu and go to “<b><strong>My Profile > Manage Passkeys</b></strong>”. Using a passkey is optional, but recommended.</p>"
+          alt: "Demo of adding a passkey"
+          caption: "Create a passkey to sign in without passwords or email codes"
+        invite:
+          title: "Now, grab the invite link to invite someone else"
+          description_html: "<p>Open the Fizzy menu, select “<b><strong>+ Add people</b></strong>”, then copy the invite link. You can give this link to someone else so they can make a login for themselves in your account.</p>"
+          alt: "Demo of copying invite link"
+          caption: "Get a link to invite co-workers"
+        home:
+          title: "Then, head back home to check out activity"
+          description_html: "<p>Hit “1” or pull down the Fizzy menu and select “Home”.</p>"
+          alt: "Demo of visiting Home"
+          caption: "Go back to Home for Latest Activity"
+        assigned_to_me:
+          title: "Now, check out all cards assigned to you"
+          description_html: "<p>Pull down the Fizzy menu at the top of the screen, and select “<b><strong>Assigned to me</b></strong>” or just hit “2” on your keyboard any time.</p>"
+          alt: "Demo of navigating to 'Assigned to Me'"
+          caption: "See all cards assigned to me"
+        menu:
+          title: "Then, open the Fizzy menu"
+          description_html: "<p>The Fizzy menu is how you get around the app. Click “<b><strong>Fizzy</b></strong>” at the top of the screen or hit the “J” key on your keyboard to pop it open.</p>"
+          alt: "Demo of opening the main menu"
+          caption: "Open the Fizzy menu"
+        assign:
+          title: "Next, assign this card to yourself"
+          description_html: "<p>Click the little head with the + next to it, then pick yourself.</p>"
+          alt: "Demo of assigning a card"
+          caption: "Assign this to yourself"
+        tag:
+          title: "Now, tag this card “Design” then move it to YES"
+          description_html: "<p>Click the little Tag icon, type “design”, then “<b><strong>Create tag</b></strong>”. Then, move the card to the new “YES” column you created in the previous step.</p>"
+          alt: "Demo of tagging a card"
+          caption: "Tag this #design"
+        columns:
