diff --git a/test/i18n_test.rb b/test/i18n_test.rb
new file mode 100644
index 0000000..431ee11
--- /dev/null
+++ b/test/i18n_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class I18nTest < ActiveSupport::TestCase
+  test "every locale we offer has the same set of translation keys" do
+    english_keys, japanese_keys = app_translation_keys(:en), app_translation_keys(:ja)
+
+    assert_empty english_keys - japanese_keys, "Missing from ja"
+    assert_empty japanese_keys - english_keys, "Missing from en"
+  end
+
+  test "interpolations match between locales" do
+    translations = { en: app_translations(:en), ja: app_translations(:ja) }
+
+    app_translation_keys(:en).each do |key|
+      english, japanese = translations[:en][key], translations[:ja][key]
+      assert_equal interpolations_in(english), interpolations_in(japanese), "Interpolations differ for #{key}"
+    end
+  end
+
+  private
+    def app_translation_keys(locale)
+      app_translations(locale).keys
+    end
+
+    def app_translations(locale)
+      Dir[Rails.root.join("config/locales/#{locale}/*.yml")].each_with_object({}) do |file, translations|
+        translations.merge! flatten(YAML.load_file(file).fetch(locale.to_s))
+      end
+    end
+
+    def flatten(hash, prefix = nil)
+      hash.each_with_object({}) do |(key, value), flat|
+        full_key = [ prefix, key ].compact.join(".")
+        value.is_a?(Hash) ? flat.merge!(flatten(value, full_key)) : flat[full_key] = value
+      end
+    end
+
+    def interpolations_in(string)
+      string.to_s.scan(/%\{(\w+)\}/).flatten.sort
+    end
+end
diff --git a/test/integration/locale_test.rb b/test/integration/locale_test.rb
new file mode 100644
index 0000000..5750199
--- /dev/null
+++ b/test/integration/locale_test.rb
@@ -0,0 +1,144 @@
+require "test_helper"
+
+class LocaleTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+  end
+
+  test "pages render in English by default" do
+    get cards_path
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_match "Skip to main content", response.body
+    assert_nil identities(:david).reload.locale
+  end
+
+  test "?locale=ja switches to Japanese and sticks for the session" do
+    get cards_path(locale: "ja")
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_match "本文へスキップ", response.body
+    assert_no_match "Skip to main content", response.body
+
+    get cards_path
+    assert_select "html[lang=ja]"
+
+    get notifications_path
+    assert_select "html[lang=ja]"
+    assert_select "h1", text: "通知"
+  end
+
+  test "the chosen locale is remembered on the identity and follows them into a clean browser" do
+    get cards_path(locale: "ja")
+    assert_equal "ja", identities(:david).reload.locale
+
+    reset!
+    sign_in_as :david
+
+    get cards_path
+    assert_select "html[lang=ja]"
+    assert_equal "ja", cookies[:locale]
+  end
+
+  test "a locale chosen before signing in sticks to the identity" do
+    reset!
+
+    untenanted { get new_session_path(locale: "ja") }
+    assert_select "html[lang=ja]"
+
+    sign_in_as :david
+
+    assert_equal "ja", identities(:david).reload.locale
+    get cards_path
+    assert_select "html[lang=ja]"
+  end
+
+  test "unavailable locales never break a page and do not switch anything" do
+    get cards_path(locale: "xx")
+
+    assert_response :success
+    assert_select "html[lang=en]"
+    assert_nil identities(:david).reload.locale
+    assert_nil cookies[:locale].presence
+
+    get cards_path(locale: "ja")
+    get cards_path(locale: "xx")
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+  end
+
+  test "a tampered locale cookie is ignored" do
+    cookies[:locale] = "xx"
+    get cards_path
+
+    assert_response :success
+    assert_select "html[lang=en]"
+  end
+
+  test "switching locale invalidates cached responses" do
+    get cards_path
+    english_etag = response.headers["ETag"]
+
+    get cards_path(locale: "ja")
+    assert_not_equal english_etag, response.headers["ETag"]
+  end
+
+  test "sign-in pages speak the chosen language before there is a session" do
+    reset!
+
+    untenanted { get new_session_path(locale: "ja") }
+    assert_select "h1", text: "Fizzyにサインイン"
+
+    untenanted { post session_path, params: { email_address: identities(:david).email_address } }
+    untenanted { follow_redirect! }
+    assert_select "h1", text: "メールを確認してください"
+  end
+
+  test "emails go out in the recipient's language" do
+    identities(:david).update! locale: "ja"
+
+    email = MagicLinkMailer.sign_in_instructions(identities(:david).send_magic_link)
+    assert_match "確認コード", email.subject
+    assert_match "6文字の確認コード", email.html_part.body.to_s
+
+    email = MagicLinkMailer.sign_in_instructions(identities(:jz).send_magic_link)
+    assert_match "Your Fizzy code is", email.subject
+  end
+
+  test "static error pages are served in both languages" do
+    %w[ 400 404 406-unsupported-browser 422 500 ].each do |page|
+      html = Rails.public_path.join("#{page}.html").read
+
+      assert_match "Back home", html
+      assert_match "ホームに戻る", html
+    end
+  end
+end
+
+class PublicPageLocaleTest < ActionDispatch::IntegrationTest
+  test "choosing a locale on a page open to everyone still sticks to the signed-in identity" do
+    sign_in_as :david
+    board = boards(:writebook)
+    board.publish
+
+    get public_board_path(board.publication.key, locale: "ja")
+
+    assert_response :success
+    assert_select "html[lang=ja]"
+    assert_equal "ja", identities(:david).reload.locale
+  end
+
+  test "signed-out visitors can switch public pages too" do
+    board = boards(:writebook)
+    board.publish
+
+    get public_board_path(board.publication.key, locale: "ja")
+    assert_select "html[lang=ja]"
+
+    get public_board_path(board.publication.key)
+    assert_select "html[lang=ja]"
+  end
+end
