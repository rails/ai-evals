+<% @page_title = "Check your email" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_magic_link_path, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
+    <p class="margin-none">
+      <% if @email_address.present? %>
+        We sent a code to <strong><%= @email_address %></strong>.
+      <% else %>
+        We sent you a code.
+      <% end %>
+      Enter it below to get into Fizzy.
+    </p>
+
+    <div class="flex align-center justify-center gap">
+      <%= form.text_field :code, class: "input", required: true, autofocus: true, autocomplete: "one-time-code",
