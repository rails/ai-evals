+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small txt-subtle margin-block-start">
+    The code works for <%= distance_of_time_in_words(MagicLink::EXPIRY) %>.
+    Didn’t get it? <%= link_to "Start over", new_session_path %> to request another one.
+  </p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
