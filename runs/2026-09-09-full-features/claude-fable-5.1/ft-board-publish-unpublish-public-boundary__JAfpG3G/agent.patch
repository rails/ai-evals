diff --git a/app/views/boards/edit/_publication.html.erb b/app/views/boards/edit/_publication.html.erb
new file mode 100644
index 0000000..fafb72f
--- /dev/null
+++ b/app/views/boards/edit/_publication.html.erb
@@ -0,0 +1,41 @@
+<div id="<%= dom_id(board, :publication) %>" class="margin-block-end">
+  <h2 class="divider txt-large">Public link</h2>
+
+  <% if board.published? %>
+    <% url = public_board_url(board.public_key) %>
+    <p class="margin-none-block-start">Anyone with this secret link can view this board and its cards without signing in.</p>
+
+    <div class="flex align-center gap-half">
+      <input type="text" class="input flex-item-grow" value="<%= url %>" readonly>
+
+      <%= tag.button class: "btn btn--circle txt-small", data: {
+            controller: "copy-to-clipboard", action: "copy-to-clipboard#copy",
+            copy_to_clipboard_success_class: "btn--success", copy_to_clipboard_content_value: url } do %>
+        <%= icon_tag "copy-paste" %>
+        <span class="for-screen-reader">Copy public link</span>
+      <% end %>
+    </div>
+
+    <% if Current.user.admin? %>
+      <div class="flex justify-center margin-block-start">
+        <%= button_to board_publication_path(board), method: :delete, class: "btn txt-negative txt-small borderless", form: { data: { turbo_confirm: "Are you sure you want to unpublish this board? The public link will stop working." } } do %>
+          <%= icon_tag "lock" %>
+          <span>Unpublish this board</span>
+        <% end %>
+      </div>
+    <% end %>
+  <% else %>
+    <p class="margin-none-block-start">Publish this board to get a secret link that anyone can use to view it without signing in.</p>
+
+    <% if Current.user.admin? %>
+      <div class="flex justify-center margin-block-start">
+        <%= button_to board_publication_path(board), method: :post, class: "btn btn--link" do %>
+          <%= icon_tag "globe" %>
+          <span>Publish this board</span>
+        <% end %>
+      </div>
+    <% else %>
+      <p class="txt-small">Only admins can publish boards.</p>
+    <% end %>
+  <% end %>
+</div>
