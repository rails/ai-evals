diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
new file mode 100644
index 0000000..38c410f
--- /dev/null
+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are not published by default" do
+    assert_not @board.published?
+    assert_nil @board.public_key
+  end
+
+  test "publish creates a publication with a secret key" do
+    assert_difference -> { Board::Publication.count }, +1 do
+      @board.publish
+    end
+
+    assert @board.published?
+    assert @board.public_key.present?
+    assert_equal @board.account, @board.publication.account
+  end
+
+  test "publishing an already published board keeps the same key" do
+    @board.publish
+    key = @board.public_key
+
+    assert_no_difference -> { Board::Publication.count } do
+      @board.publish
+    end
+
+    assert_equal key, @board.reload.public_key
+  end
+
+  test "unpublish removes the publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.unpublish
+    end
+
+    assert_not @board.reload.published?
+    assert_nil @board.public_key
+  end
+
+  test "unpublishing a board that isn't published is a no-op" do
+    assert_nothing_raised { @board.unpublish }
+    assert_not @board.published?
+  end
+
+  test "publishing and unpublishing touches the board" do
+    assert_changes -> { @board.reload.updated_at } do
+      @board.publish
+    end
+
+    assert_changes -> { @board.reload.updated_at } do
+      @board.unpublish
+    end
+  end
+
+  test "find_by_public_key!" do
+    @board.publish
+
+    assert_equal @board, Board.find_by_public_key!(@board.public_key)
+    assert_equal @board, Current.account.boards.find_by_public_key!(@board.public_key)
+
+    assert_raises ActiveRecord::RecordNotFound do
+      Board.find_by_public_key!("nope")
+    end
+
+    assert_raises ActiveRecord::RecordNotFound do
+      accounts(:initech).boards.find_by_public_key!(@board.public_key)
+    end
+  end
+
+  test "published scope" do
+    assert_empty Board.published
+
+    @board.publish
+
+    assert_equal [ @board ], Board.published.to_a
+  end
+
+  test "destroying the board destroys the publication" do
+    @board.publish
+
+    assert_difference -> { Board::Publication.count }, -1 do
+      @board.destroy
+    end
+  end
+
+  test "cards on published boards are publicly accessible" do
+    card = cards(:logo)
+    comment = card.comments.first
+
+    assert_not card.publicly_accessible?
+    assert_not comment.publicly_accessible?
+
+    @board.publish
+    card.reload
+
+    assert card.publicly_accessible?
+    assert comment.reload.publicly_accessible?
+
+    card.update!(status: :drafted)
+    assert_not card.publicly_accessible?
+  end
+end
