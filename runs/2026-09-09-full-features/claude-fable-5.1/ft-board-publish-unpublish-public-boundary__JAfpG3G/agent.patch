+require "test_helper"
+
+class Public::Boards::CardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @card = cards(:logo)
+  end
+
+  test "show" do
+    get public_board_card_path(@board.public_key, @card)
+
+    assert_response :success
+    assert_select "h1", text: @card.title
+    assert_select "##{dom_id(@card.comments.first)}"
+    assert_select "a[href='#{public_board_path(@board.public_key)}']"
+  end
+
+  test "show does not render private links or actions" do
+    get public_board_card_path(@board.public_key, @card)
+
+    assert_response :success
+    assert_select "form", count: 0
+    assert_select "a[href='#{card_path(@card)}']", count: 0
+    assert_select "a[href='#{edit_card_path(@card)}']", count: 0
+    assert_select "a[href='#{user_path(@card.creator)}']", count: 0
+  end
+
+  test "show a drafted card" do
+    @card.update!(status: :drafted)
+
+    get public_board_card_path(@board.public_key, @card)
+
+    assert_response :not_found
+  end
+
+  test "show a card from another board" do
+    card = with_current_user(:kevin) { boards(:private).cards.create!(title: "Secret", status: :published) }
+
+    get public_board_card_path(@board.public_key, card)
+
+    assert_response :not_found
+  end
+
+  test "show when the board is unpublished" do
+    @board.unpublish
+
+    get public_board_card_path(@board.public_key, @card)
+
+    assert_response :not_found
+  end
+
+  test "show with an unknown card number" do
+    get public_board_card_path(@board.public_key, 999_999)
+
+    assert_response :not_found
+  end
+end
