+++ b/app/helpers/public/columns_helper.rb
@@ -0,0 +1,18 @@
+module Public::ColumnsHelper
+  def public_column_tag(id:, name:, collapsed: true, selected: nil, data: {}, **properties, &block)
+    classes = token_list("cards", properties.delete(:class), "is-collapsed": collapsed, "is-expanded": !collapsed)
+
+    data = {
+      column_name: name,
+      collapsible_columns_target: "column",
+      action: "turbo:before-morph-attribute->collapsible-columns#preventToggle focus->collapsible-columns#focusOnColumn"
+    }.merge(data)
+
+    tag.section(id: id, class: classes, tabindex: "0", "aria-selected": selected, data: data, **properties) do
+      tag.div(class: "cards__transition-container", data: {
+        controller: "css-variable-counter",
+        css_variable_counter_property_name_value: "--card-count"
+      }, &block)
+    end
+  end
+end
