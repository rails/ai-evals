+    assert_select "a[href='#{public_board_card_path(@board.public_key, cards(:buy_domain))}']"
+    assert_select "turbo-frame[src='#{public_board_column_path(@board.public_key, columns(:writebook_triage))}']"
+  end
+
+  test "show does not render private links or actions" do
+    get public_board_path(@board.public_key)
+
+    assert_response :success
+    assert_select "a[href='#{board_path(@board)}']", count: 0
+    assert_select "a[href='#{card_path(cards(:buy_domain))}']", count: 0
+    assert_select "form", count: 0
+  end
+
+  test "show while signed in" do
+    sign_in_as :kevin
+
+    get public_board_path(@board.public_key)
+
+    assert_response :success
+  end
+
+  test "show while signed in as a user from another account" do
+    sign_in_as :mike
+
+    get public_board_path(@board.public_key)
+
+    assert_response :success
+  end
+
+  test "show with an unknown key" do
+    get public_board_path("unknown")
+
+    assert_response :not_found
+  end
+
+  test "show an unpublished board" do
+    @board.unpublish
+
+    get public_board_path(@board.public_key)
+
+    assert_response :not_found
+  end
+
+  test "show a board with an old key after republishing" do
+    old_key = @board.public_key
+    @board.unpublish
+    @board.reload.publish
+
+    get public_board_path(old_key)
+    assert_response :not_found
+
+    get public_board_path(@board.public_key)
+    assert_response :success
+  end
+
+  test "show a board from another account" do
+    get public_board_path(@board.public_key, script_name: accounts(:initech).slug)
+
+    assert_response :not_found
+  end
+
+  test "show is fresh when board has not changed" do
+    get public_board_path(@board.public_key)
+    etag = response.headers["ETag"]
+
+    get public_board_path(@board.public_key), headers: { "If-None-Match" => etag }
+    assert_response :not_modified
+  end
+end
