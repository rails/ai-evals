diff --git a/app/models/board/publishable.rb b/app/models/board/publishable.rb
new file mode 100644
index 0000000..b8c5b92
--- /dev/null
+++ b/app/models/board/publishable.rb
@@ -0,0 +1,31 @@
+module Board::Publishable
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :publication, dependent: :destroy, class_name: "Board::Publication"
+
+    scope :published, -> { joins(:publication) }
+  end
+
+  class_methods do
+    def find_by_public_key!(key)
+      published.find_by! board_publications: { key: key }
+    end
+  end
+
+  def publish
+    publication || create_publication!
+  end
+
+  def unpublish
+    publication&.destroy
+  end
+
+  def published?
+    publication.present?
+  end
+
+  def public_key
+    publication&.key
+  end
+end
