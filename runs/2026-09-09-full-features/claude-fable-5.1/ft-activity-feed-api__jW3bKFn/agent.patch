index 31ecd66..057c4f1 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,44 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def old_board_name
+    particular_value "old_board"
+  end
+
+  def new_board_name
+    particular_value "new_board"
+  end
+
+  def old_title
+    particular_value "old_title"
+  end
+
+  def new_title
+    particular_value "new_title"
+  end
+
+  def column_name
+    particular_value "column"
+  end
+
+  def exposed_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { assignee_ids: Array(assignee_ids) }
+    when "card_board_changed"
+      { old_board: old_board_name, new_board: new_board_name }
+    when "card_title_changed"
+      { old_title: old_title, new_title: new_title }
+    when "card_triaged"
+      { column: column_name }
+    else
+      {}
+    end
+  end
+
+  private
+    def particular_value(key)
+      particulars.dig("particulars", key).to_s
+    end
 end
