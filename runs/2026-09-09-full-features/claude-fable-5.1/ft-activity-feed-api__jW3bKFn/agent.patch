@@ -0,0 +1,97 @@
+# Activities
+
+Activities are the events that make up the account's activity timeline: cards being added, assigned, moved, closed, commented on, and so on.
+
+## `GET /:account_slug/activities`
+
+Returns a paginated list of activity from all boards the current user can access, newest first.
+
+| Parameter | Description |
+|-----------|-------------|
+| `creator_ids[]` | Only include activity by the given user ID(s) |
+| `board_ids[]` | Only include activity from the given board ID(s) |
+
+Each activity has an `action` describing what happened. Possible values: `card_published`, `card_assigned`, `card_unassigned`,
+`card_closed`, `card_reopened`, `card_postponed`, `card_auto_postponed`, `card_board_changed`, `card_title_changed`,
+`card_triaged`, `card_sent_back_to_triage`, and `comment_created`.
+
+The `description` is a plain-text, HTML-escaped sentence describing the activity, as shown in the timeline.
+
+The `eventable` is the card or comment the activity is about, depending on `eventable_type` (`Card` or `Comment`).
+For card activity, `url` opens the card. For comment activity, it opens the card and jumps to the comment.
+
+The `particulars` object holds action-specific details:
+
+| Action | Particulars |
+|--------|-------------|
+| `card_assigned`, `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` |
+
+Other actions have empty `particulars`.
+
+__Response:__
+
+```json
+[
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho2",
+    "action": "card_assigned",
+    "created_at": "2025-12-05T19:36:35.534Z",
+    "description": "David Heinemeier Hansson assigned Jason Fried to &quot;Plain text mentions&quot;",
+    "particulars": {
+      "assignee_ids": ["03f5v9zjw7pz8717a4no1h8a8"]
+    },
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/3",
+    "eventable_type": "Card",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnikz",
+      "number": 3,
+      "title": "Plain text mentions",
+      "status": "published",
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/3"
+    },
+    "board": {
+      "id": "03f5v9zjw7pz8717a4no1h8a9",
+      "name": "Product",
+      "all_access": true,
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/boards/03f5v9zjw7pz8717a4no1h8a9"
+    },
+    "creator": {
+      "id": "03f5v9zjw7pz8717a4no1h8a7",
+      "name": "David Heinemeier Hansson",
+      "role": "owner",
+      "active": true,
+      "email_address": "david@example.com",
+      "created_at": "2025-12-05T19:36:35.401Z",
+      "url": "http://app.fizzy.localhost:3006/897362094/users/03f5v9zjw7pz8717a4no1h8a7"
+    }
+  },
+  {
+    "id": "03f5va03bpuvkcjemcxl73ho3",
+    "action": "comment_created",
+    "created_at": "2025-12-05T19:30:12.001Z",
+    "description": "Jason Fried commented on &quot;Plain text mentions&quot;",
+    "particulars": {},
+    "url": "http://app.fizzy.localhost:3006/897362094/cards/3#comment_03f5v9zo9qlcwwpyc0ascnil0",
+    "eventable_type": "Comment",
+    "eventable": {
+      "id": "03f5v9zo9qlcwwpyc0ascnil0",
+      "created_at": "2025-12-05T19:30:12.001Z",
+      "updated_at": "2025-12-05T19:30:12.001Z",
+      "body": {
+        "plain_text": "This looks great!",
+        "html": "<div class=\"action-text-content\">This looks great!</div>"
+      },
+      "url": "http://app.fizzy.localhost:3006/897362094/cards/3/comments/03f5v9zo9qlcwwpyc0ascnil0"
+    },
+    "board": { "...": "..." },
+    "creator": { "...": "..." }
+  }
+]
+```
+
+The `eventable`, `board`, and `creator` objects use the same representations as the [Cards](cards.md), [Comments](comments.md),
+[Boards](boards.md), and [Users](users.md) endpoints.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..578d823
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,131 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns activity newest first" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_kind_of Array, @response.parsed_body
+
+    created_ats = @response.parsed_body.map { |activity| activity["created_at"] }
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "index includes card activity attributes" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:logo_assignment_jz).id }
+    event = events(:logo_assignment_jz)
+
+    assert_equal "card_assigned", activity["action"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_includes activity["description"], "David assigned JZ to"
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity["particulars"])
+    assert_equal card_url(cards(:logo)), activity["url"]
+
+    assert_equal cards(:logo).id, activity.dig("eventable", "id")
+    assert_equal cards(:logo).number, activity.dig("eventable", "number")
+    assert_equal boards(:writebook).id, activity.dig("board", "id")
+    assert_equal users(:david).id, activity.dig("creator", "id")
+    assert_not_nil activity.dig("creator", "avatar_url")
+  end
+
+  test "index includes comment activity attributes" do
+    get activities_path, as: :json
+
+    activity = @response.parsed_body.find { |a| a["id"] == events(:layout_commented).id }
+    comment = comments(:layout_overflowing_david)
+
+    assert_equal "comment_created", activity["action"]
+    assert_equal "Comment", activity["eventable_type"]
+    assert_includes activity["description"], "David commented on"
+    assert_equal({}, activity["particulars"])
+    assert_equal card_url(comment.card, anchor: "comment_#{comment.id}"), activity["url"]
+    assert_equal comment.id, activity.dig("eventable", "id")
+    assert_equal comment.body.to_plain_text, activity.dig("eventable", "body", "plain_text")
+  end
+
+  test "index exposes particulars for board, title, and triage changes" do
+    card = cards(:logo)
+    board_changed = card.events.create!(action: "card_board_changed", creator: users(:david), board: card.board,
+      particulars: { particulars: { old_board: "Old", new_board: "New" } })
+    title_changed = card.events.create!(action: "card_title_changed", creator: users(:david), board: card.board,
+      particulars: { particulars: { old_title: "Before", new_title: "After" } })
+    triaged = card.events.create!(action: "card_triaged", creator: users(:david), board: card.board,
+      particulars: { particulars: { column: "Doing" } })
+    triaged_without_column = card.events.create!(action: "card_triaged", creator: users(:david), board: card.board)
+
+    get activities_path, as: :json
+
+    activities = @response.parsed_body.index_by { |a| a["id"] }
+
+    assert_equal({ "old_board" => "Old", "new_board" => "New" }, activities[board_changed.id]["particulars"])
+    assert_equal({ "old_title" => "Before", "new_title" => "After" }, activities[title_changed.id]["particulars"])
+    assert_equal({ "column" => "Doing" }, activities[triaged.id]["particulars"])
+    assert_equal({ "column" => "" }, activities[triaged_without_column.id]["particulars"])
+    assert_equal({}, activities[events(:logo_published).id]["particulars"])
+  end
+
+  test "index omits deprecated collection changed events" do
+    card = cards(:logo)
+    collection_changed = card.events.create!(action: "card_collection_changed", creator: users(:david), board: card.board,
+      particulars: { particulars: { old_collection: "Old", new_collection: "New" } })
+
+    get activities_path, as: :json
+
+    assert_not_includes @response.parsed_body.map { |a| a["id"] }, collection_changed.id
+  end
+
+  test "index filters by creator" do
+    get activities_path(creator_ids: [ users(:kevin).id ]), as: :json
+
+    assert_response :success
+    assert @response.parsed_body.any?
+    assert @response.parsed_body.all? { |a| a.dig("creator", "id") == users(:kevin).id }
+  end
+
+  test "index filters by board" do
+    card = cards(:logo)
+    private_event = card.events.create!(action: "card_published", creator: users(:kevin), board: boards(:private))
+
+    get activities_path(board_ids: [ boards(:private).id ]), as: :json
+
+    assert_equal [ private_event.id ], @response.parsed_body.map { |a| a["id"] }
+  end
+
+  test "index only returns activity from accessible boards" do
+    card = cards(:logo)
+    private_event = card.events.create!(action: "card_published", creator: users(:kevin), board: boards(:private))
+
+    logout_and_sign_in_as :david
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.map { |a| a["id"] }, private_event.id
+
+    get activities_path(board_ids: [ boards(:private).id ]), as: :json
+
+    assert_response :success
+    assert_not_includes @response.parsed_body.map { |a| a["id"] }, private_event.id
+  end
+
+  test "index is paginated" do
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_nil @response.headers["Link"]
+
+    card = cards(:logo)
+    120.times { card.events.create!(action: "card_published", creator: users(:kevin), board: card.board) }
+
+    get activities_path, as: :json
+
+    assert_response :success
+    assert_match %r{activities.*page=2}, @response.headers["Link"]
+  end
+end
