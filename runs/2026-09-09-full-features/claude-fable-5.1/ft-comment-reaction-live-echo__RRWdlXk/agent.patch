--- /dev/null
+++ b/app/helpers/reactions_helper.rb
@@ -0,0 +1,11 @@
+module ReactionsHelper
+  EMOJI_ONLY_PATTERN = /\A[\p{Extended_Pictographic}\p{Emoji_Presentation}\p{Emoji_Modifier}\u200d\ufe0f\u20e3\u{1F1E6}-\u{1F1FF}\s]+\z/
+
+  def reaction_content_classes(reaction)
+    class_names "txt-small", "txt-medium": emoji_only_reaction?(reaction)
+  end
+
+  def emoji_only_reaction?(reaction)
+    reaction.content.match?(EMOJI_ONLY_PATTERN)
+  end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..ec19e48
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,28 @@
+import { Controller } from "@hotwired/stimulus"
+
+// A single reaction in the strip. Reactions left by the current user can be
+// clicked to reveal the button that removes them.
+export default class extends Controller {
+  static classes = [ "deleteable", "expanded" ]
+  static values = { reacterId: String }
+
+  connect() {
+    this.element.classList.toggle(this.deleteableClass, this.#reactedByCurrentUser)
+  }
+
+  toggle() {
+    if (this.#reactedByCurrentUser) this.element.classList.toggle(this.expandedClass)
+  }
+
+  collapse() {
+    this.element.classList.remove(this.expandedClass)
+  }
+
+  collapseOnClickOutside({ target }) {
+    if (!this.element.contains(target)) this.collapse()
+  }
+
+  get #reactedByCurrentUser() {
+    return this.reacterIdValue === window.Current?.user?.id
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..7256670
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,31 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Swaps the "add a reaction" button for a small inline form, and back again.
+// While the form is open, the element is marked permanent so a broadcasted page
+// refresh can't morph away a reaction in progress.
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+  static classes = [ "expanded" ]
+
+  expand() {
+    this.element.setAttribute("data-turbo-permanent", "")
+    this.triggerTarget.hidden = true
+    this.formTarget.hidden = false
+    this.formTarget.classList.add(this.expandedClass)
+    this.inputTarget.focus()
+  }
+
+  collapse() {
+    this.formTarget.reset()
+    this.formTarget.classList.remove(this.expandedClass)
+    this.formTarget.hidden = true
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+    this.element.removeAttribute("data-turbo-permanent")
+  }
+
+  pick(event) {
+    this.inputTarget.value = event.currentTarget.dataset.emoji
+    this.formTarget.requestSubmit()
+  }
+}
