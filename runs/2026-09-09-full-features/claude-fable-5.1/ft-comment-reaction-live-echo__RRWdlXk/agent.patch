+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "reacting to a comment defaults the reacter and account" do
+    reaction = comments(:logo_agreement_kevin).reactions.create!(content: "🎉")
+
+    assert_equal users(:david), reaction.reacter
+    assert_equal accounts("37s"), reaction.account
+    assert_equal cards(:logo), reaction.card
+  end
+
+  test "content is required" do
+    reaction = comments(:logo_agreement_kevin).reactions.build(content: "")
+
+    assert_not reaction.valid?
+    assert_includes reaction.errors[:content], "can't be blank"
+  end
+
+  test "content is limited to 16 characters" do
+    reaction = comments(:logo_agreement_kevin).reactions.build(content: "x" * 17)
+    assert_not reaction.valid?
+
+    reaction.content = "x" * 16
+    assert reaction.valid?
+  end
+
+  test "reacting touches the comment and its card" do
+    comment = comments(:logo_agreement_kevin)
+
+    assert_changes -> { comment.reload.updated_at } do
+      assert_changes -> { comment.card.reload.updated_at } do
+        comment.reactions.create!(content: "👀")
+      end
+    end
+  end
+
+  test "reactions are destroyed along with their comment" do
+    comment = comments(:logo_agreement_jz)
+    assert comment.reactions.any?
+
+    assert_difference -> { Reaction.count }, -comment.reactions.count do
+      comment.destroy
+    end
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..48088a8
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,136 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "adding a reaction with the inline input" do
+    visit card_url(@card)
+
+    within_reactions do
+      assert_no_selector ".reaction__form"
+      click_on "Add a reaction"
+
+      fill_in "Your reaction", with: "Love it 🎉"
+      click_on "Add reaction"
+
+      assert_selector ".reaction", text: "Love it 🎉"
+      assert_no_selector ".reaction__form"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_equal "Love it 🎉", @comment.reactions.sole.content
+    assert_equal users(:david), @comment.reactions.sole.reacter
+  end
+
+  test "cancelling puts the button back without reacting" do
+    visit card_url(@card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Nope"
+      click_on "Cancel"
+
+      assert_no_selector ".reaction__form"
+      assert_selector ".reactions__trigger"
+    end
+
+    assert_empty @comment.reactions
+  end
+
+  test "picking an emoji reacts right away" do
+    visit card_url(@card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      click_on "Pick an emoji"
+      click_on "Party popper"
+
+      assert_selector ".reaction", text: "🎉"
+    end
+
+    assert_equal "🎉", @comment.reactions.sole.content
+  end
+
+  test "removing your own reaction, but not someone else's" do
+    mine = @comment.reactions.create!(content: "👍", reacter: users(:david))
+    theirs = @comment.reactions.create!(content: "👀", reacter: users(:kevin))
+
+    visit card_url(@card)
+
+    within_reactions do
+      assert_selector "##{dom_id(mine)}.reaction--deleteable"
+      assert_no_selector "##{dom_id(theirs)}.reaction--deleteable"
+
+      find("##{dom_id(theirs)}").click
+      assert_no_selector "##{dom_id(theirs)} .reaction__delete", visible: :visible
+
+      find("##{dom_id(mine)}").click
+      within "##{dom_id(mine)}" do
+        click_on "Remove your reaction"
+      end
+
+      assert_no_selector "##{dom_id(mine)}"
+      assert_selector "##{dom_id(theirs)}"
+    end
+
+    assert_not Reaction.exists?(mine.id)
+    assert Reaction.exists?(theirs.id)
+  end
+
+  test "reactions left elsewhere show up without reloading" do
+    visit card_url(@card)
+    within_reactions { assert_no_selector ".reaction" }
+
+    react_elsewhere
+
+    within_reactions do
+      assert_selector ".reaction", text: "👏", wait: 5
+    end
+  end
+
+  test "a reaction in progress survives reactions landing elsewhere" do
+    visit card_url(@card)
+
+    within_reactions do
+      click_on "Add a reaction"
+      fill_in "Your reaction", with: "Still typ"
+    end
+
+    react_elsewhere
+
+    within_reactions do
+      assert_selector ".reaction", text: "👏", wait: 5
+      assert_field "Your reaction", with: "Still typ"
+
+      fill_in "Your reaction", with: "Still typing"
+      click_on "Add reaction"
+
+      assert_selector ".reaction", text: "Still typing"
+      assert_selector ".reaction", text: "👏"
+      assert_no_selector ".reaction__form"
+    end
+  end
+
+  private
+    def within_reactions(&block)
+      within "##{dom_id(@comment, :reactions)}", &block
+    end
+
+    def react_elsewhere
+      wait_for_cable_subscriptions
+      @comment.reactions.create!(content: "👏", reacter: users(:kevin))
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob
+    end
+
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
