+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,132 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "index as JSON" do
+    get card_comment_reactions_path(@card, @comment), as: :json
+
+    assert_response :success
+    assert_equal @comment.reactions.count, @response.parsed_body.count
+    assert_equal reactions(:logo_agreement_jz_thumbs_up_kevin).id, @response.parsed_body.first["id"]
+    assert_equal "👍", @response.parsed_body.first["content"]
+    assert_equal users(:kevin).id, @response.parsed_body.first.dig("reacter", "id")
+  end
+
+  test "new renders the emoji picker" do
+    get new_card_comment_reaction_path(@card, @comment)
+
+    assert_response :success
+    assert_select "turbo-frame##{dom_id(@comment, :emoji_picker)} .reaction__emoji-list button[data-emoji]", count: EmojiHelper::REACTIONS.size
+  end
+
+  test "create" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action=replace][target=?]", dom_id(@comment, :reactions)
+
+    reaction = @comment.reactions.last
+    assert_equal "🎉", reaction.content
+    assert_equal users(:kevin), reaction.reacter
+    assert_select "##{dom_id(reaction)}", text: /🎉/
+    assert_select "##{dom_id(@comment, :new_reaction)} .reactions__trigger"
+    assert_select "##{dom_id(@comment, :new_reaction)} form.reaction__form[hidden]"
+  end
+
+  test "create broadcasts a refresh to everyone looking at the card" do
+    assert_turbo_stream_broadcasts @card, count: 1 do
+      perform_enqueued_jobs only: Turbo::Streams::BroadcastStreamJob do
+        post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+      end
+    end
+  end
+
+  test "create with content over 16 characters is rejected" do
+    assert_no_difference -> { @comment.reactions.count } do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "This is far too long" } }, as: :json
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { reaction: { content: "Great 👍" } }, as: :json
+    end
+
+    assert_response :created
+    reaction = @comment.reactions.last
+    assert_equal card_comment_reaction_path(@card, @comment, reaction, format: :json), @response.headers["Location"]
+    assert_equal reaction.id, @response.parsed_body["id"]
+    assert_equal "Great 👍", @response.parsed_body["content"]
+    assert_equal card_comment_reaction_url(@card, @comment, reaction), @response.parsed_body["url"]
+  end
+
+  test "create as JSON with flat params" do
+    assert_difference -> { @comment.reactions.count }, +1 do
+      post card_comment_reactions_path(@card, @comment), params: { content: "👏" }, as: :json
+    end
+
+    assert_response :created
+    assert_equal "👏", @comment.reactions.last.content
+  end
+
+  test "create on an inaccessible card" do
+    card, comment = with_current_user(:kevin) do
+      card = boards(:private).cards.create!(title: "Private", status: :published)
+      [ card, card.comments.create!(body: "Private") ]
+    end
+
+    logout_and_sign_in_as :david
+
+    post card_comment_reactions_path(card, comment), params: { reaction: { content: "👀" } }, as: :json
+
+    assert_response :not_found
+  end
+
+  test "show as JSON" do
+    reaction = reactions(:logo_agreement_jz_thumbs_up_kevin)
+
+    get card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :success
+    assert_equal reaction.id, @response.parsed_body["id"]
+  end
+
+  test "destroy" do
+    reaction = reactions(:logo_agreement_jz_thumbs_up_kevin)
+
+    assert_difference -> { @comment.reactions.count }, -1 do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_select "turbo-stream[action=remove][target=?]", dom_id(reaction)
+  end
+
+  test "destroy as JSON" do
+    reaction = reactions(:logo_agreement_jz_thumbs_up_kevin)
+
+    delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+
+    assert_response :no_content
+    assert_not Reaction.exists?(reaction.id)
+  end
+
+  test "destroy another user's reaction is forbidden" do
+    reaction = reactions(:logo_agreement_jz_nice_david)
+
+    assert_no_difference -> { @comment.reactions.count } do
+      delete card_comment_reaction_path(@card, @comment, reaction), as: :json
+    end
+
+    assert_response :forbidden
+  end
+end
