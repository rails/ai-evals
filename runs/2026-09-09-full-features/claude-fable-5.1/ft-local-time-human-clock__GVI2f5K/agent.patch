diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..23ddbb4
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,38 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_datetime_tag sends the raw UTC timestamp for the browser to render" do
+    time = Time.zone.parse("2025-09-12 13:42:00 UTC")
+
+    Time.use_zone("America/Chicago") do
+      assert_dom_equal <<~HTML.strip, local_datetime_tag(time.in_time_zone)
+        <time datetime="2025-09-12T13:42:00Z" class="local-time-value" data-controller="local-time"
+          data-local-time-style-value="relative" data-action="turbo:morph-element->local-time#render:self"></time>
+      HTML
+    end
+  end
+
+  test "local_datetime_tag renders the same HTML whatever the server's timezone" do
+    time = Time.zone.parse("2025-09-12 13:42:00 UTC")
+
+    chicago = Time.use_zone("America/Chicago") { local_datetime_tag(time.in_time_zone) }
+    auckland = Time.use_zone("Pacific/Auckland") { local_datetime_tag(time.in_time_zone) }
+
+    assert_equal chicago, auckland
+  end
+
+  test "local_datetime_tag accepts a style" do
+    assert_dom "time[data-local-time-style-value=datetime]", local_datetime_tag(Time.current, style: :datetime)
+  end
+
+  test "local_datetime_tag merges classes and data attributes" do
+    html = local_datetime_tag(Time.current, id: "stamp", class: "card__timestamp", data: { bridge__stamp_target: "description" })
+
+    assert_dom "time#stamp.local-time-value.card__timestamp[data-controller=local-time][data-bridge--stamp-target=description]", html
+  end
+
+  private
+    def assert_dom(selector, html)
+      assert_select Nokogiri::HTML.fragment(html), selector
+    end
+end
