diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..2963523
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,37 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatDateTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+
+// Turns the raw timestamp in a <time datetime> attribute into words, in the
+// viewer's own timezone. Relative styles are refreshed so "1:42 PM" becomes
+// "yesterday" once midnight passes.
+export default class extends Controller {
+  static values = { style: { type: String, default: "relative" } }
+
+  #timer
+
+  connect() {
+    this.render()
+
+    if (this.#isRelative) {
+      this.#timer = setInterval(this.render.bind(this), REFRESH_INTERVAL)
+    }
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  render() {
+    this.element.textContent = formatDateTime(this.#date, this.styleValue)
+  }
+
+  get #isRelative() {
+    return this.styleValue === "relative"
+  }
+
+  get #date() {
+    return new Date(this.element.getAttribute("datetime"))
+  }
+}
diff --git a/app/javascript/helpers/date_helpers.js b/app/javascript/helpers/date_helpers.js
index b0c4ffb..7c90587 100644
--- a/app/javascript/helpers/date_helpers.js
+++ b/app/javascript/helpers/date_helpers.js
@@ -42,3 +42,75 @@ function buildDateFormatter(timezone) {
     return new Intl.DateTimeFormat("en-US", options)
   }
 }
+
+// Formatting for display. Unlike the day-boundary helpers above, these follow
+// the browser's own timezone: the words a person reads should match their clock.
+export function formatDateTime(date, style = "relative", now = new Date()) {
+  switch (style) {
+    case "time":
+      return formatTime(date)
+    case "date":
+      return formatDate(date, now)
+    case "full_date":
+      return formatDate(date, now, { withYear: true })
+    case "datetime":
+      return `${formatWeekdayDate(date, now)}, ${formatTime(date)}`
+    case "short_datetime":
+      return formatters.shortDateTime.format(date)
+    default:
+      return formatRelativeDateTime(date, now)
+  }
+}
+
+// Looking back: "1:42 PM" earlier today, "yesterday", "5 days ago", then "Sep 12"
+// once older than a week. Looking ahead it stays a countdown: "today", "tomorrow", "in 3 days".
+function formatRelativeDateTime(date, now) {
+  const days = differenceInLocalDays(now, date)
+
+  if (days === 0) {
+    return date <= now ? formatTime(date) : "today"
+  } else if (days === 1) {
+    return "tomorrow"
+  } else if (days > 1) {
+    return `in ${days} days`
+  } else if (days === -1) {
+    return "yesterday"
+  } else if (days > -7) {
+    return `${-days} days ago`
+  } else {
+    return formatDate(date, now)
+  }
+}
+
+function formatTime(date) {
+  return formatters.time.format(date).replace(/\u202f/g, " ")
+}
+
+function formatDate(date, now, { withYear = !sameYear(date, now) } = {}) {
+  return (withYear ? formatters.dateWithYear : formatters.date).format(date)
+}
+
+function formatWeekdayDate(date, now) {
+  return (sameYear(date, now) ? formatters.weekdayDate : formatters.weekdayDateWithYear).format(date)
+}
+
+function sameYear(date, now) {
+  return date.getFullYear() === now.getFullYear()
+}
+
+function differenceInLocalDays(fromDate, toDate) {
+  return Math.round((beginningOfLocalDay(toDate) - beginningOfLocalDay(fromDate)) / (1000 * 60 * 60 * 24))
+}
+
+function beginningOfLocalDay(date) {
+  return new Date(date.getFullYear(), date.getMonth(), date.getDate())
+}
+
+const formatters = {
+  time: new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }),
+  date: new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" }),
+  dateWithYear: new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }),
+  weekdayDate: new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" }),
+  weekdayDateWithYear: new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric" }),
+  shortDateTime: new Intl.DateTimeFormat("en-US", { dateStyle: "short", timeStyle: "short" })
+}
