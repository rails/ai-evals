diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..7ca7cb6 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,26 @@
 module TimeHelper
+  # Renders a <time> element that the browser turns into words, so times always
+  # read in the viewer's own timezone and the HTML can be cached and shared
+  # between people. The server only sends the raw UTC timestamp.
+  #
+  # Styles, rendered by the local-time Stimulus controller:
+  #
+  #   :relative       – "1:42 PM", "yesterday", "5 days ago", "Sep 12", "tomorrow", "in 3 days"
+  #   :time           – "1:42 PM"
+  #   :date           – "Sep 12", or "Sep 12, 2024" outside the current year
+  #   :full_date      – "Sep 12, 2025"
+  #   :datetime       – "Friday, September 12, 1:42 PM"
+  #   :short_datetime – "9/12/25, 1:42 PM"
+  def local_datetime_tag(datetime, style: :relative, data: {}, **attributes)
+    tag.time \
+      datetime: datetime.utc.iso8601,
+      class: token_list("local-time-value", attributes.delete(:class)),
+      data: local_time_data(style).merge(data),
+      **attributes
+  end
+
+  private
+    def local_time_data(style)
+      { controller: "local-time", local_time_style_value: style, action: "turbo:morph-element->local-time#render:self" }
+    end
 end
