@@ -0,0 +1,28 @@
+module Push
+  class << self
+    def table_name_prefix
+      "push_"
+    end
+
+    def enabled?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      Rails.application.config.x.vapid.public_key
+    end
+
+    def vapid_private_key
+      Rails.application.config.x.vapid.private_key
+    end
+
+    # Who push services may contact about a misbehaving application server.
+    def vapid_subject
+      "mailto:#{Mail::Address.new(ApplicationMailer.default[:from].to_s).address}"
+    end
+
+    def vapid_identification
+      { subject: vapid_subject, public_key: vapid_public_key, private_key: vapid_private_key }
+    end
+  end
+end
diff --git a/app/models/push/notification.rb b/app/models/push/notification.rb
new file mode 100644
