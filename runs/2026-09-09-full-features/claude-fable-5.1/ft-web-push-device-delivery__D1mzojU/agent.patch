+++ b/app/models/push/notification.rb
@@ -0,0 +1,22 @@
+# What the service worker shows when a push arrives: the same title and body
+# as the tray, and the path to the card it's about to open on click.
+class Push::Notification
+  attr_reader :title, :body, :path, :tag, :badge
+
+  def initialize(title:, body:, path:, tag: nil, badge: nil)
+    @title, @body, @path, @tag, @badge = title, body, path, tag, badge
+  end
+
+  def as_json(*)
+    {
+      title: title,
+      options: {
+        body: body,
+        icon: "/app-icon-192.png",
+        tag: tag,
+        renotify: tag.present?,
+        data: { path: path, badge: badge }
+      }
+    }
+  end
+end
diff --git a/app/models/push/subscription.rb b/app/models/push/subscription.rb
new file mode 100644
index 0000000..df2a15c
--- /dev/null
+++ b/app/models/push/subscription.rb
@@ -0,0 +1,23 @@
+# A browser's subscription with its push service, as handed to us by the
+# Push API. One per device the user turned notifications on for, tied to the
+# session it was created in so that logging out on that device ends it.
+class Push::Subscription < ApplicationRecord
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  belongs_to :session, optional: true
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+
+  def push(notification)
+    WebPush.payload_send \
+      message: notification.to_json,
+      endpoint: endpoint,
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: Push.vapid_identification,
+      ttl: 1.day.to_i
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription, WebPush::Unauthorized
+    # The push service dropped this subscription, or it was signed with a key pair we've since rotated.
+    destroy
+  end
+end
