diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..3e933e6
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,149 @@
+import { Controller } from "@hotwired/stimulus"
+import { post } from "@rails/request.js"
+
+// Web push for the device at hand. The server renders whether this session has
+// a subscription; here we make sure the browser agrees, subscribe or
+// unsubscribe on request, and point at whatever setting stands in the way.
+export default class extends Controller {
+  static targets = [ "status", "details", "unsupported" ]
+  static classes = [ "on" ]
+  static values = { vapidPublicKey: String, subscriptionsUrl: String }
+
+  connect() {
+    this.#hideDetails()
+
+    if (this.#supported) {
+      this.#reconcile()
+    } else {
+      this.#revealUnsupported()
+    }
+  }
+
+  async subscribe() {
+    if (await this.#requestPermission() === "granted") {
+      const subscription = await this.#subscribeWithPushService()
+      await this.#register(subscription)
+      this.#turnOn()
+    } else {
+      this.#revealDetails()
+    }
+  }
+
+  async unsubscribe() {
+    const subscription = await this.#existingSubscription()
+    await subscription?.unsubscribe()
+    this.#turnOff()
+  }
+
+  // Private
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  async #reconcile() {
+    if (Notification.permission === "denied") {
+      this.#turnOff()
+      this.#revealDetails()
+    } else if (this.#on && !await this.#subscribedWithPushService()) {
+      this.#turnOff()
+    }
+  }
+
+  async #requestPermission() {
+    if (Notification.permission === "default") {
+      return await Notification.requestPermission()
+    } else {
+      return Notification.permission
+    }
+  }
+
+  async #subscribedWithPushService() {
+    const subscription = await this.#existingSubscription()
+    return subscription && this.#signedByUs(subscription)
+  }
+
+  async #subscribeWithPushService() {
+    const registration = await this.#serviceWorkerRegistration()
+    const existing = await registration.pushManager.getSubscription()
+
+    if (existing && this.#signedByUs(existing)) {
+      return existing
+    } else {
+      await existing?.unsubscribe()
+      return registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: this.#applicationServerKey })
+    }
+  }
+
+  async #existingSubscription() {
+    const registration = await navigator.serviceWorker.getRegistration()
+    return registration?.pushManager.getSubscription()
+  }
+
+  async #serviceWorkerRegistration() {
+    return await navigator.serviceWorker.getRegistration() ||
+      await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+  }
+
+  async #register(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+
+    const response = await post(this.subscriptionsUrlValue, {
+      body: { push_subscription: { endpoint, p256dh_key: p256dh, auth_key: auth } }
+    })
+
+    if (!response.ok) throw new Error(`Registering the push subscription failed with ${response.statusCode}`)
+  }
+
+  // Push services reject messages signed with a key other than the one the
+  // subscription was created with, as happens when the VAPID key pair is rotated.
+  #signedByUs(subscription) {
+    const key = subscription.options?.applicationServerKey
+    return key ? encodeBase64Url(new Uint8Array(key)) === trimBase64Url(this.vapidPublicKeyValue) : true
+  }
+
+  get #applicationServerKey() {
+    return decodeBase64Url(this.vapidPublicKeyValue)
+  }
+
+  get #on() {
+    return this.element.classList.contains(this.onClass)
+  }
+
+  #turnOn() {
+    this.element.classList.add(this.onClass)
+    this.#hideDetails()
+  }
+
+  #turnOff() {
+    this.element.classList.remove(this.onClass)
+  }
+
+  #hideDetails() {
+    this.detailsTargets.forEach(details => details.hidden = true)
+  }
+
+  #revealDetails() {
+    this.detailsTargets.forEach(details => details.hidden = false)
+  }
+
+  #revealUnsupported() {
+    this.#turnOff()
+    this.statusTarget.hidden = true
+    this.unsupportedTarget.hidden = false
+  }
+}
+
+function decodeBase64Url(string) {
+  const base64 = trimBase64Url(string).replace(/-/g, "+").replace(/_/g, "/")
+  const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, "=")
+  return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+}
+
+function encodeBase64Url(bytes) {
+  return trimBase64Url(btoa(String.fromCharCode(...bytes)).replace(/\+/g, "-").replace(/\//g, "_"))
+}
+
+function trimBase64Url(string) {
+  return string.replace(/=+$/, "")
+}
diff --git a/app/jobs/notification/push_job.rb b/app/jobs/notification/push_job.rb
new file mode 100644
index 0000000..a74c745
--- /dev/null
+++ b/app/jobs/notification/push_job.rb
@@ -0,0 +1,11 @@
+class Notification::PushJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  # Push services rate limit and have outages, and are sometimes just slow to answer.
+  retry_on WebPush::TooManyRequests, WebPush::PushServiceError,
+    Net::OpenTimeout, Net::ReadTimeout, Socket::ResolutionError, wait: :polynomially_longer
+
+  def perform(notification)
+    notification.push_now
+  end
+end
