diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..5b0da97
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,73 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+  end
+
+  test "create registers this device for the current user and session" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: push_subscription_params }
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.last
+    assert_equal "https://push.example.com/send/abc123", subscription.endpoint
+    assert_equal "p256dh-key", subscription.p256dh_key
+    assert_equal "auth-key", subscription.auth_key
+    assert_equal @user.account, subscription.account
+    assert_equal Session.last, subscription.session
+  end
+
+  test "create is idempotent for a subscription the browser already handed us" do
+    subscription = @user.push_subscriptions.create!(push_subscription_params)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: push_subscription_params }
+    end
+
+    assert_response :created
+    assert_equal Session.last, subscription.reload.session
+  end
+
+  test "create as JSON" do
+    assert_difference -> { @user.push_subscriptions.count }, +1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: push_subscription_params }, as: :json
+    end
+
+    assert_response :created
+  end
+
+  test "create requires the subscription details" do
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: { endpoint: "https://push.example.com/send/abc123" } }
+    end
+
+    assert_response :unprocessable_entity
+  end
+
+  test "create is forbidden for other users" do
+    other_user = users(:kevin)
+
+    assert_no_difference -> { Push::Subscription.count } do
+      post user_push_subscriptions_path(other_user), params: { push_subscription: push_subscription_params }
+    end
+
+    assert_response :forbidden
+  end
+
+  test "logging out drops the subscriptions registered in that session" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: push_subscription_params }
+
+    assert_difference -> { @user.push_subscriptions.count }, -1 do
+      sign_out
+    end
+  end
+
+  private
+    def push_subscription_params
+      { endpoint: "https://push.example.com/send/abc123", p256dh_key: "p256dh-key", auth_key: "auth-key" }
+    end
+end
diff --git a/test/models/notification/pushing_test.rb b/test/models/notification/pushing_test.rb
new file mode 100644
index 0000000..aa895c6
--- /dev/null
+++ b/test/models/notification/pushing_test.rb
@@ -0,0 +1,95 @@
+require "test_helper"
+
+class Notification::PushingTest < ActiveSupport::TestCase
+  setup do
+    @kevin = users(:kevin)
+    @subscription = @kevin.push_subscriptions.create!(
+      endpoint: "https://push.example.com/send/abc123", p256dh_key: "p256dh-key", auth_key: "auth-key")
+  end
+
+  test "a notification landing in the tray is pushed later" do
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_with job: Notification::PushJob do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "a notification landing in the tray again for a new source is pushed again" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_enqueued_with job: Notification::PushJob, args: [ notification ] do
+      notification.update!(source: events(:logo_assignment_jz), unread_count: notification.unread_count + 1)
+    end
+  end
+
+  test "marking a notification read or unread doesn't push" do
+    notification = notifications(:logo_assignment_kevin)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "nothing is enqueued when push isn't configured" do
+    notifications(:layout_commented_kevin).destroy
+
+    Push.stubs(:enabled?).returns(false)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      Notification.create!(user: @kevin, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "push says what the tray says and opens the card it's about" do
+    notification = notifications(:logo_assignment_kevin)
+    pushed = notification.push_notification
+
+    assert_equal "The logo isn't big enough", pushed.title
+    assert_equal "Assigned to Kevin", pushed.body
+    assert_equal "#{accounts(:"37s").slug}/cards/#{cards(:logo).number}", pushed.path
+    assert_equal notification.id, pushed.tag
+    assert_equal @kevin.notifications.unread.count, pushed.badge
+  end
+
+  test "push for a mention says who mentioned you and opens the comment" do
+    notification = notifications(:logo_mentioned_david)
+    pushed = notification.push_notification
+
+    assert_equal "JZ @mentioned you", pushed.title
+    assert_equal notification.source.source.mentionable_content.truncate(200), pushed.body
+    assert_equal "#{accounts(:"37s").slug}/cards/#{cards(:logo).number}##{ActionView::RecordIdentifier.dom_id(notification.source.source)}", pushed.path
+  end
+
+  test "push_now delivers to every device the user turned notifications on for" do
+    other = @kevin.push_subscriptions.create!(endpoint: "https://push.example.com/send/def456", p256dh_key: "p256dh-key", auth_key: "auth-key")
+    notification = notifications(:logo_assignment_kevin)
+
+    WebPush.expects(:payload_send).with { |endpoint:, **| endpoint == @subscription.endpoint }
+    WebPush.expects(:payload_send).with { |endpoint:, **| endpoint == other.endpoint }
+
+    notification.push_now
+  end
+
+  test "push_now performs within the account so the path carries the account slug" do
+    notification = notifications(:logo_assignment_kevin)
+
+    WebPush.expects(:payload_send).with do |message:, **|
+      JSON.parse(message).dig("options", "data", "path").start_with?(accounts(:"37s").slug)
+    end
+
+    perform_enqueued_jobs only: Notification::PushJob do
+      notification.push_later
+    end
+  end
+
+  test "push_now doesn't deliver to deactivated users" do
+    notification = notifications(:logo_assignment_kevin)
+    @kevin.update!(active: false)
+
+    WebPush.expects(:payload_send).never
+
+    notification.push_now
+  end
+end
diff --git a/test/models/push/subscription_test.rb b/test/models/push/subscription_test.rb
new file mode 100644
index 0000000..ec6cae4
--- /dev/null
+++ b/test/models/push/subscription_test.rb
@@ -0,0 +1,66 @@
+require "test_helper"
+
+class Push::SubscriptionTest < ActiveSupport::TestCase
+  setup do
+    @subscription = users(:kevin).push_subscriptions.create!(
+      endpoint: "https://push.example.com/send/abc123", p256dh_key: "p256dh-key", auth_key: "auth-key")
+    @notification = Push::Notification.new(title: "Title", body: "Body", path: "/cards/1", tag: "n1", badge: 3)
+  end
+
+  test "belongs to the user's account" do
+    assert_equal accounts(:"37s"), @subscription.account
+  end
+
+  test "push sends the encrypted notification to the push service, signed with our VAPID key" do
+    WebPush.expects(:payload_send).with do |message:, endpoint:, p256dh:, auth:, vapid:, **|
+      payload = JSON.parse(message)
+
+      assert_equal "Title", payload["title"]
+      assert_equal "Body", payload.dig("options", "body")
+      assert_equal "/cards/1", payload.dig("options", "data", "path")
+      assert_equal 3, payload.dig("options", "data", "badge")
+      assert_equal "n1", payload.dig("options", "tag")
+
+      assert_equal "https://push.example.com/send/abc123", endpoint
+      assert_equal "p256dh-key", p256dh
+      assert_equal "auth-key", auth
+      assert_equal Push.vapid_public_key, vapid[:public_key]
+      assert_equal Push.vapid_private_key, vapid[:private_key]
+      assert_equal "mailto:support@fizzy.do", vapid[:subject]
+    end
+
+    @subscription.push(@notification)
+  end
+
+  test "push drops a subscription the push service no longer knows about" do
+    WebPush.stubs(:payload_send).raises(WebPush::ExpiredSubscription.new(stub(code: "410", message: "Gone", body: ""), "push.example.com"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.push(@notification)
+    end
+  end
+
+  test "push drops a subscription that was signed with a rotated key pair" do
+    WebPush.stubs(:payload_send).raises(WebPush::Unauthorized.new(stub(code: "403", message: "Forbidden", body: ""), "push.example.com"))
+
+    assert_difference -> { Push::Subscription.count }, -1 do
+      @subscription.push(@notification)
+    end
+  end
+
+  test "push leaves the subscription alone when the push service is having trouble" do
+    WebPush.stubs(:payload_send).raises(WebPush::PushServiceError.new(stub(code: "503", message: "Unavailable", body: ""), "push.example.com"))
+
+    assert_no_difference -> { Push::Subscription.count } do
+      assert_raises WebPush::PushServiceError do
+        @subscription.push(@notification)
+      end
+    end
+  end
+
+  test "deactivating a user drops their subscriptions" do
+    assert_difference -> { Push::Subscription.count }, -1 do
+      users(:kevin).deactivate
+    end
+  end
+end
