diff --git a/app/models/notification/pushing.rb b/app/models/notification/pushing.rb
new file mode 100644
index 0000000..269afc8
--- /dev/null
+++ b/app/models/notification/pushing.rb
@@ -0,0 +1,46 @@
+module Notification::Pushing
+  extend ActiveSupport::Concern
+
+  included do
+    # A notification lands in the tray when it's created, and again when a new source surfaces it.
+    after_save_commit :push_later, if: :source_id_previously_changed?
+  end
+
+  def push_later
+    Notification::PushJob.perform_later(self) if Push.enabled?
+  end
+
+  def push_now
+    if pushable?
+      user.push_subscriptions.each do |subscription|
+        subscription.push(push_notification)
+      end
+    end
+  end
+
+  def push_notification
+    Push::Notification.new \
+      title: push_title,
+      body: push_body,
+      path: push_path,
+      tag: id,
+      badge: user.notifications.unread.count
+  end
+
+  private
+    def pushable?
+      Push.enabled? && user.active? && account.active?
+    end
+
+    def push_title
+      ApplicationController.helpers.notification_title(self)
+    end
+
+    def push_body
+      ApplicationController.helpers.notification_body(self)
+    end
+
+    def push_path
+      Rails.application.routes.url_helpers.polymorphic_path(notifiable_target, script_name: account.slug, only_path: true)
+    end
+end
