diff --git a/config/initializers/web_push.rb b/config/initializers/web_push.rb
new file mode 100644
index 0000000..1495f94
--- /dev/null
+++ b/config/initializers/web_push.rb
@@ -0,0 +1,19 @@
+# Web push notifications are signed with a VAPID key pair, which ops provide as
+# VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY. Generate a pair with `bin/rails push:vapid_keys`.
+#
+# Development and test fall back to a key pair generated on first boot and kept in
+# tmp/, so push works locally without any setup. Without a key pair, push is off.
+Rails.application.configure do
+  public_key, private_key = ENV["VAPID_PUBLIC_KEY"].presence, ENV["VAPID_PRIVATE_KEY"].presence
+
+  if public_key.nil? && private_key.nil? && Rails.env.local?
+    pem_path = Rails.root.join("tmp/vapid_key.pem")
+    File.write(pem_path, WebPush.generate_key.to_pem) unless pem_path.exist?
+
+    local_key = WebPush::VapidKey.from_pem(pem_path.read)
+    public_key, private_key = local_key.public_key, local_key.private_key
+  end
+
+  config.x.vapid.public_key = public_key
+  config.x.vapid.private_key = private_key
+end
