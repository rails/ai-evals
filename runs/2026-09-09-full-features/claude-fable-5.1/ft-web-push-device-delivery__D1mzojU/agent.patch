diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..659aec5 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -64,4 +64,37 @@ self.addEventListener("activate", (event) => {
   event.waitUntil(self.clients.claim())
 })
 
+// Push notifications: show what the tray shows, and open the card it's about on click
+self.addEventListener("push", (event) => {
+  if (event.data) event.waitUntil(showPushNotification(event.data.json()))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openNotificationPath(event.notification.data?.path))
+})
+
+async function showPushNotification({ title, options }) {
+  await self.registration.showNotification(title, options)
+
+  if ("setAppBadge" in navigator && options.data?.badge != null) {
+    await navigator.setAppBadge(options.data.badge)
+  }
+}
+
+async function openNotificationPath(path) {
+  if (!path) return
+
+  const url = new URL(path, self.location.origin).href
+  const windowClients = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+  const client = windowClients.find(client => "navigate" in client)
+
+  if (client) {
+    await client.focus()
+    await client.navigate(url).catch(() => self.clients.openWindow(url))
+  } else {
+    await self.clients.openWindow(url)
+  }
+}
+
 TurboOffline.start()
