+export function formatLocalTime(date, style, now = new Date()) {
+  switch (style) {
+    case "time":
+      return formatTime(date)
+    case "date":
+      return formatDate(date, now)
+    case "full_date":
+      return format(date, { month: "short", day: "numeric", year: "numeric" })
+    case "weekday":
