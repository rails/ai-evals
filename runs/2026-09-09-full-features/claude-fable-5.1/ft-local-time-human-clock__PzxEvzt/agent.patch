diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..5531801 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,20 @@
 module TimeHelper
+  # Renders a <time> element the browser fills in via the local-time Stimulus
+  # controller, so the words a person sees follow their own clock rather than
+  # the server's, and the markup stays cacheable across timezones.
+  #
+  # Styles:
+  #   :relative  – "1:42 PM" today, "yesterday", "in 3 days", otherwise "Sep 12" (default)
+  #   :day       – like :relative, but reads "today" instead of a time of day
+  #   :time      – "1:42 PM"
+  #   :date      – "Sep 12", or "Sep 12, 2024" outside the current year
+  #   :full_date – "Sep 12, 2025"
+  #   :weekday   – "Friday, September 12"
+  #   :datetime  – "9/12/25, 1:42 PM"
+  def local_datetime_tag(datetime, style: :relative, **attributes)
+    utc = datetime.in_time_zone.utc
+    data = attributes.delete(:data).to_h.merge(local_time_target: "time", local_time_style: style)
+
+    tag.time utc.iso8601, datetime: utc.iso8601, data: data, **attributes
+  end
 end
