diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..94ba9d5
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,58 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, formatFullDateTime } from "helpers/date_helpers"
+
+const REFRESH_INTERVAL = 60_000 // 1 minute (in milliseconds)
+const STYLES_WITH_TITLE = [ "relative", "day", "date" ]
+
+// Fills <time> elements rendered by TimeHelper#local_datetime_tag with words in
+// the browser's own timezone. The server only sends the raw timestamp, so the
+// same HTML can be cached and shared between people anywhere in the world.
+export default class extends Controller {
+  static targets = [ "time" ]
+
+  #timer
+
+  connect() {
+    this.#timer = setInterval(() => this.#renderAll(), REFRESH_INTERVAL)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  timeTargetConnected(target) {
+    this.#render(target)
+  }
+
+  // Morphing writes the server's fallback text back into the element, so
+  // render it again once the morph has finished with it.
+  morph({ target }) {
+    if (this.#isTimeTarget(target)) {
+      this.#render(target)
+    }
+  }
+
+  #renderAll() {
+    this.timeTargets.forEach(target => this.#render(target))
+  }
+
+  #render(target) {
+    const date = new Date(target.getAttribute("datetime"))
+    if (isNaN(date)) return
+
+    const style = target.dataset.localTimeStyle || "relative"
+    const text = formatLocalTime(date, style)
+
+    if (target.textContent !== text) {
+      target.textContent = text
+    }
+
+    if (STYLES_WITH_TITLE.includes(style)) {
+      target.title = formatFullDateTime(date)
+    }
+  }
+
+  #isTimeTarget(element) {
+    return element instanceof Element && element.matches(`[data-${this.identifier}-target~="time"]`)
+  }
+}
