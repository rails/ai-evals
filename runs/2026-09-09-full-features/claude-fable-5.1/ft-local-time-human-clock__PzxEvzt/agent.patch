diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..025cc54
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,29 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "local_datetime_tag sends the raw timestamp in UTC for the browser to render" do
+    Time.use_zone("America/New_York") do
+      time = Time.zone.local(2025, 9, 12, 13, 42)
+
+      assert_dom_equal <<~HTML.strip, local_datetime_tag(time)
+        <time datetime="2025-09-12T17:42:00Z" data-local-time-target="time" data-local-time-style="relative">2025-09-12T17:42:00Z</time>
+      HTML
+    end
+  end
+
+  test "local_datetime_tag renders dates as midnight in the current timezone" do
+    Time.use_zone("America/New_York") do
+      assert_dom_equal <<~HTML.strip, local_datetime_tag(Date.new(2025, 9, 12), style: :weekday)
+        <time datetime="2025-09-12T04:00:00Z" data-local-time-target="time" data-local-time-style="weekday">2025-09-12T04:00:00Z</time>
+      HTML
+    end
+  end
+
+  test "local_datetime_tag keeps other attributes and data" do
+    time = Time.utc(2025, 9, 12, 13, 42)
+
+    assert_dom_equal <<~HTML.strip, local_datetime_tag(time, style: :date, class: "card__timestamp", data: { other_target: "description" })
+      <time datetime="2025-09-12T13:42:00Z" class="card__timestamp" data-other-target="description" data-local-time-target="time" data-local-time-style="date">2025-09-12T13:42:00Z</time>
+    HTML
+  end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..a065451
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,71 @@
+require "application_system_test_case"
+
+class LocalTimeTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as users(:kevin)
+    @card = cards(:logo)
+  end
+
+  test "comments read in the viewer's own clock" do
+    today = comment_created_at(2.hours.ago)
+    yesterday = comment_created_at(1.day.ago.change(hour: 22))
+    earlier_this_week = comment_created_at(5.days.ago)
+    long_ago = comment_created_at(Time.zone.local(2020, 9, 12, 13, 42))
+
+    visit card_path(@card)
+
+    assert_selector "##{dom_id(today)} time", text: browser_time(today.created_at)
+    assert_selector "##{dom_id(yesterday)} time", text: "yesterday"
+    assert_selector "##{dom_id(earlier_this_week)} time", text: "5 days ago"
+    assert_selector "##{dom_id(long_ago)} time", text: "Sep 12, 2020"
+    assert_no_text(/\d{4}-\d{2}-\d{2}T/)
+  end
+
+  test "entropy notice reads in days" do
+    auto_clean_at 1.day.from_now.change(hour: 9)
+    visit card_path(@card)
+    assert_selector ".card-perma__closure-message", text: "Moves to “Not Now” tomorrow if there’s no activity."
+
+    auto_clean_at 3.days.from_now.change(hour: 9)
+    visit card_path(@card)
+    assert_selector ".card-perma__closure-message", text: "Moves to “Not Now” in 3 days if there’s no activity."
+  end
+
+  test "times are rendered again after a morph" do
+    comment = comment_created_at(5.days.ago)
+
+    visit card_path(@card)
+    assert_selector "##{dom_id(comment)} time", text: "5 days ago"
+
+    morph_page
+
+    assert_selector "##{dom_id(comment)} time", text: "5 days ago"
+    assert_no_text(/\d{4}-\d{2}-\d{2}T/)
+  end
+
+  private
+    def comment_created_at(time)
+      @card.comments.create!(creator: users(:kevin), body: "Posted #{time}", created_at: time)
+    end
+
+    def auto_clean_at(time)
+      @card.update_columns(last_active_at: time - @card.entropy.auto_clean_period)
+    end
+
+    def browser_time(time)
+      page.evaluate_script <<~JS
+        new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit" }).format(new Date(#{time.to_i * 1000}))
+      JS
+    end
+
+    def morph_page
+      page.execute_script <<~JS
+        document.addEventListener("turbo:morph", () => document.body.dataset.morphed = true, { once: true })
+        Turbo.session.refresh(window.location.href)
+      JS
+
+      assert_selector "body[data-morphed]"
+    end
+end
