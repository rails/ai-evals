diff --git a/test/models/account/tenancy_test.rb b/test/models/account/tenancy_test.rb
new file mode 100644
index 0000000..c176b34
--- /dev/null
+++ b/test/models/account/tenancy_test.rb
@@ -0,0 +1,85 @@
+require "test_helper"
+
+class Account::TenancyTest < ActiveSupport::TestCase
+  # Global identity, session and authentication records aren't owned by any one account.
+  GLOBAL_TABLES = %w[
+    accounts account_external_id_sequences identities identity_access_tokens magic_links sessions action_pack_passkeys
+  ]
+
+  # Headless join tables behind Filter's has_and_belongs_to_many associations, only ever reached through their filter.
+  FILTER_JOIN_TABLES = %w[ assignees_filters assigners_filters boards_filters closers_filters creators_filters filters_tags ]
+
+  test "every table holding an account's data has a required, indexed account_id" do
+    tenant_tables.each do |table|
+      column = connection.columns(table).find { |c| c.name == "account_id" }
+
+      assert column, "#{table} is missing account_id"
+      assert_not column.null, "#{table}.account_id should be required"
+      assert connection.indexes(table).any? { |index| index.columns.first == "account_id" }, "#{table}.account_id should be indexed"
+    end
+  end
+
+  test "records derive their account from the record they belong to" do
+    card, board, user = cards(:logo), boards(:writebook), users(:david)
+
+    assert_equal card.account, Watch.create!(card: card, user: user).account
+    assert_equal card.account, Reaction.create!(reactable: card, content: "👍", reacter: user).account
+    assert_equal card.account, Mention.create!(source: comments(:logo_1), mentioner: user, mentionee: user).account
+    assert_equal board.account, Board::Publication.create!(board: board).account
+    assert_equal user.account, Search::Query.create!(user: user, terms: "logo").account
+    assert_equal board.account, Storage::Total.create!(owner: board).account
+
+    new_board = board.account.boards.create!(name: "Fresh", creator: user)
+    assert_equal board.account, Entropy.create!(container: new_board, auto_postpone_period: 7.days.to_i).account
+  end
+
+  test "accounts contain their own entropy and storage totals" do
+    account = accounts(:initech)
+
+    assert_equal account, account.entropy.account
+    assert_equal account, Storage::Total.create!(owner: account).account
+  end
+
+  test "blobs, attachments, variants and rich texts belong to the account whose data they store" do
+    card = cards(:logo)
+    blob = ActiveStorage::Blob.create_and_upload!(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+    assert_equal Current.account, blob.account
+
+    card.image.attach(blob)
+    assert_equal card.account, card.image.attachment.account
+
+    variant = ActiveStorage::VariantRecord.create!(blob: blob, variation_digest: "digest")
+    assert_equal blob.account, variant.account
+
+    card.update!(description: "<p>Hello</p>")
+    assert_equal card.account, card.rich_text_description.account
+  end
+
+  test "blobs can't be created outside an account" do
+    Current.without_account do
+      assert_raises ActiveRecord::RecordInvalid do
+        ActiveStorage::Blob.create_and_upload!(io: StringIO.new("x"), filename: "x.txt", content_type: "text/plain")
+      end
+    end
+  end
+
+  test "tag titles are unique per account, not globally" do
+    assert_difference -> { Tag.count }, 2 do
+      accounts(:"37s").tags.create!(title: "shared")
+      accounts(:initech).tags.create!(title: "shared")
+    end
+
+    assert_raises ActiveRecord::RecordNotUnique do
+      accounts(:initech).tags.create!(title: "shared")
+    end
+  end
+
+  private
+    def connection
+      ActiveRecord::Base.connection
+    end
+
+    def tenant_tables
+      connection.tables - GLOBAL_TABLES - FILTER_JOIN_TABLES - %w[ schema_migrations ar_internal_metadata ] - connection.tables.grep(/\Asearch_records_fts/)
+    end
+end
