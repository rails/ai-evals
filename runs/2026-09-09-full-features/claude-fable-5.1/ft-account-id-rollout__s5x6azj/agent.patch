+# Finishes the account_id rollout. The first pass put a nullable account_id on the core
+# tables and left the rest for later. Now every table holding an account's data gets a
+# required, indexed account_id, backfilled from the record it hangs off. Rows whose
+# account can't be determined are orphans and are dropped.
+#
+# Global identity, session and authentication tables are the exceptions, as are the
+# headless filter join tables, which are only ever reached through their filter.
+class AddAccountIdToAllTenantTables < ActiveRecord::Migration[8.2]
+  UNTENANTED_TABLES = %i[
+    accesses assignments board_publications card_activity_spikes card_goldnesses card_not_nows
+    closures entropies mentions pins reactions search_queries storage_totals taggings user_settings
+    watches webhook_delinquency_trackers webhook_deliveries
+    action_text_rich_texts active_storage_attachments active_storage_blobs active_storage_variant_records
+  ]
+
+  OPTIONALLY_TENANTED_TABLES = %i[
+    account_imports account_join_codes boards cards columns comments events filters
+    notification_bundles notifications push_subscriptions steps tags users webhooks
+  ]
+
+  # Tables whose account_id was already covered by an index before this migration.
+  PREVIOUSLY_INDEXED_TABLES = %i[ account_imports cards users ]
+
+  def up
+    UNTENANTED_TABLES.each { |table| add_column table, :account_id, :uuid }
+
+    backfill_account_ids
+    drop_orphans
+
+    (UNTENANTED_TABLES + OPTIONALLY_TENANTED_TABLES).each do |table|
+      change_column_null table, :account_id, false
+      add_index table, :account_id unless PREVIOUSLY_INDEXED_TABLES.include?(table)
+    end
+
+    remove_index :tags, :title
+    add_index :tags, [ :account_id, :title ], unique: true
+  end
+
+  def down
+    remove_index :tags, [ :account_id, :title ]
+    add_index :tags, :title, unique: true
+
+    OPTIONALLY_TENANTED_TABLES.each do |table|
+      remove_index table, :account_id unless PREVIOUSLY_INDEXED_TABLES.include?(table)
+      change_column_null table, :account_id, true
+    end
+
+    UNTENANTED_TABLES.each { |table| remove_column table, :account_id }
+  end
+
+  private
+    # Parents before children, so each table can copy from an already-backfilled one.
+    def backfill_account_ids
+      backfill :boards, from: :users, via: :creator_id
+
+      backfill :cards, from: :boards, via: :board_id
+      backfill :columns, from: :boards, via: :board_id
+      backfill :events, from: :boards, via: :board_id
+      backfill :webhooks, from: :boards, via: :board_id
+      backfill :accesses, from: :boards, via: :board_id
+      backfill :board_publications, from: :boards, via: :board_id
+
+      backfill :comments, from: :cards, via: :card_id
+      backfill :steps, from: :cards, via: :card_id
+      backfill :assignments, from: :cards, via: :card_id
+      backfill :card_activity_spikes, from: :cards, via: :card_id
+      backfill :card_goldnesses, from: :cards, via: :card_id
+      backfill :card_not_nows, from: :cards, via: :card_id
+      backfill :closures, from: :cards, via: :card_id
+      backfill :pins, from: :cards, via: :card_id
+      backfill :taggings, from: :cards, via: :card_id
+      backfill :watches, from: :cards, via: :card_id
+
+      backfill :filters, from: :users, via: :creator_id
+      backfill :notifications, from: :users, via: :user_id
+      backfill :notification_bundles, from: :users, via: :user_id
+      backfill :push_subscriptions, from: :users, via: :user_id
+      backfill :search_queries, from: :users, via: :user_id
+      backfill :user_settings, from: :users, via: :user_id
+
+      backfill :webhook_deliveries, from: :webhooks, via: :webhook_id
+      backfill :webhook_delinquency_trackers, from: :webhooks, via: :webhook_id
+
+      backfill_from_children :tags, from: :taggings, via: :tag_id
+      backfill_from_parent_type :mentions, as: :source, from: { "Card" => :cards, "Comment" => :comments }
+      backfill_from_parent_type :reactions, as: :reactable, from: { "Card" => :cards, "Comment" => :comments }
+      backfill_from_parent_type :entropies, as: :container, from: { "Account" => :accounts, "Board" => :boards }
+      backfill_from_parent_type :storage_totals, as: :owner, from: { "Account" => :accounts, "Board" => :boards }
+
+      backfill_attachments
+    end
+
+    # Blobs take their account from whatever they're attached to, and variants take theirs
+    # from the blob they were generated from. Attachments hanging off variants and blobs
+    # (variant images, preview images) can only be resolved once those are known.
+    def backfill_attachments
+      backfill_from_parent_type :action_text_rich_texts, as: :record, from: { "Card" => :cards, "Comment" => :comments, "Board" => :boards }
+
+      backfill_from_parent_type :active_storage_attachments, as: :record, from: {
+        "Card" => :cards,
+        "User" => :users,
+        "Export" => :exports,
+        "Account::Import" => :account_imports,
+        "ActionText::RichText" => :action_text_rich_texts
+      }
+      backfill_from_children :active_storage_blobs, from: :active_storage_attachments, via: :blob_id
+      backfill :active_storage_variant_records, from: :active_storage_blobs, via: :blob_id
+
+      backfill_from_parent_type :active_storage_attachments, as: :record, from: {
+        "ActiveStorage::VariantRecord" => :active_storage_variant_records,
+        "ActiveStorage::Blob" => :active_storage_blobs
+      }
+      backfill_from_children :active_storage_blobs, from: :active_storage_attachments, via: :blob_id
+    end
+
+    # Copies the account from the parent row referenced by the foreign key.
+    def backfill(table, from:, via:, where: nil)
+      execute <<~SQL.squish
+        UPDATE #{table}
+        SET account_id = (SELECT #{from}.account_id FROM #{from} WHERE #{from}.id = #{table}.#{via})
+        WHERE #{table}.account_id IS NULL #{"AND #{where}" if where}
+      SQL
+    end
+
+    # Copies the account from a polymorphic parent, one type at a time. A parent that is
+    # itself an account needs no lookup: it is the account.
+    def backfill_from_parent_type(table, as:, from:)
+      from.each do |type, parent_table|
+        if parent_table == :accounts
+          execute "UPDATE #{table} SET account_id = #{as}_id WHERE account_id IS NULL AND #{as}_type = 'Account'"
+        else
+          backfill table, from: parent_table, via: "#{as}_id", where: "#{table}.#{as}_type = '#{type}'"
+        end
+      end
+    end
+
+    # Copies the account from any child row pointing back at this one, for tables that only
+    # learn their account through what refers to them (a tag's taggings, a blob's attachments).
+    def backfill_from_children(table, from:, via:)
+      execute <<~SQL.squish
+        UPDATE #{table}
+        SET account_id = (
+          SELECT #{from}.account_id FROM #{from}
+          WHERE #{from}.#{via} = #{table}.id AND #{from}.account_id IS NOT NULL
+          LIMIT 1
+        )
+        WHERE #{table}.account_id IS NULL
+      SQL
+    end
+
+    def drop_orphans
+      (UNTENANTED_TABLES + OPTIONALLY_TENANTED_TABLES).each do |table|
+        execute "DELETE FROM #{table} WHERE account_id IS NULL"
+      end
+    end
+end
