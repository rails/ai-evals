diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..d23d211
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,128 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+import { FetchRequest } from "@rails/request.js"
+import { nextEventLoopTick } from "helpers/timing_helpers"
+
+// How a dropped card gets to each kind of column, using the URLs the card already carries
+const DESTINATIONS = {
+  column: { method: "post", url: "cardTriageUrl", query: container => ({ column_id: container.dataset.dragAndDropColumnId }) },
+  stream: { method: "delete", url: "cardTriageUrl" },
+  not_now: { method: "post", url: "cardNotNowUrl" },
+  closed: { method: "post", url: "cardClosureUrl" }
+}
+
+// Columns keep golden cards on top, so a dropped card lands right below them
+const GOLDEN_ITEM_SELECTOR = ".golden-effect"
+
+// Moves cards between the columns of a board by dragging them around. Columns keep their
+// own order, so a dropped card lands where the server will put it — at the top — before the
+// change is saved, and the response leaves the board as it already looks.
+export default class extends Controller {
+  static targets = [ "container", "list", "item" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  #draggedItem = null
+  #hoveredContainer = null
+
+  async start(event) {
+    const item = this.#itemContaining(event.target)
+    if (!item) return
+
+    this.#draggedItem = item
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", item.id)
+
+    await nextEventLoopTick() // Let the browser take the drag image before dimming the card
+    item.classList.add(this.draggedItemClass)
+  }
+
+  hover(event) {
+    if (!this.#draggedItem) return
+
+    const container = this.#dropTargetContaining(event.target)
+    this.#highlight(container)
+
+    if (container) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  drop(event) {
+    const item = this.#draggedItem
+    const container = this.#dropTargetContaining(event.target)
+    if (!item || !container) return
+
+    event.preventDefault()
+    this.end()
+    this.#place(item, container)
+    this.#save(item, container)
+  }
+
+  end() {
+    this.#draggedItem?.classList.remove(this.draggedItemClass)
+    this.#draggedItem = null
+    this.#highlight(null)
+  }
+
+  // Private
+
+  #itemContaining(target) {
+    return this.itemTargets.find(item => item.contains(target))
+  }
+
+  #dropTargetContaining(target) {
+    const container = this.containerTargets.find(container => container.contains(target))
+    return container && !container.contains(this.#draggedItem) ? container : null
+  }
+
+  #highlight(container) {
+    if (container === this.#hoveredContainer) return
+
+    this.#hoveredContainer?.classList.remove(this.hoverContainerClass)
+    container?.classList.add(this.hoverContainerClass)
+    this.#hoveredContainer = container
+  }
+
+  #place(item, container) {
+    const list = this.listTargets.find(list => container.contains(list))
+    if (!list) return
+
+    const items = this.itemTargets.filter(other => list.contains(other))
+    const successor = this.#isGolden(item) ? items[0] : items.find(other => !this.#isGolden(other))
+
+    if (successor) {
+      successor.before(item)
+    } else if (items.length) {
+      items.at(-1).after(item)
+    } else {
+      list.prepend(item)
+    }
+  }
+
+  #isGolden(item) {
+    return item.matches(GOLDEN_ITEM_SELECTOR)
+  }
+
+  async #save(item, container) {
+    const response = await this.#requestFor(item, container).perform().catch(() => null)
+
+    if (!response?.ok) {
+      this.#reloadBoard()
+    }
+  }
+
+  #requestFor(item, container) {
+    const destination = DESTINATIONS[container.dataset.dragAndDropDestination]
+
+    return new FetchRequest(destination.method, item.dataset[destination.url], {
+      query: destination.query?.(container),
+      responseKind: "turbo-stream"
+    })
+  }
+
+  // The save didn't take, so show the board the way the server has it
+  #reloadBoard() {
+    Turbo.visit(location.href, { action: "replace" })
+  }
+}
