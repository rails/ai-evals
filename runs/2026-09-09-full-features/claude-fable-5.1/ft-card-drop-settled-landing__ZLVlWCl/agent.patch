+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    @board = boards(:writebook)
+    visit board_url(@board)
+  end
+
+  test "dragging a card into a column moves it there right away" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+    wait_for_column dom_id(column)
+
+    drag card, to: dom_id(column)
+
+    within "##{dom_id(column)}" do
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+      assert_selector ".cards__expander-count", text: "2", wait: 5
+    end
+    assert_equal column, card.reload.column
+    assert_no_selector "#maybe ##{dom_id(card, :article)}"
+  end
+
+  test "dragging a card to Done closes it" do
+    card = cards(:text)
+    expand_column dom_id(columns(:writebook_in_progress))
+    wait_for_column "closed-cards"
+
+    drag card, to: "closed-cards"
+
+    within "#closed-cards" do
+      assert_selector "##{dom_id(card, :article)}", visible: :all
+      assert_selector ".cards__expander-count", text: "2", wait: 5
+    end
+    assert card.reload.closed?
+    assert_no_selector "##{dom_id(columns(:writebook_in_progress))} ##{dom_id(card, :article)}"
+  end
+
+  test "dragging a card to Not Now postpones it and back to Maybe? resumes it" do
+    card = cards(:text)
+    expand_column dom_id(columns(:writebook_in_progress))
+    wait_for_column "not-now"
+
+    drag card, to: "not-now"
+
+    within("#not-now") { assert_selector ".cards__expander-count", text: "1", wait: 5 }
+    assert card.reload.postponed?
+
+    expand_column "not-now"
+    drag card, to: "maybe"
+
+    within("#maybe") { assert_selector "##{dom_id(card, :article)}" }
+    within("#not-now") { assert_selector ".cards__expander-count", text: "0", visible: :all, wait: 5 }
+    assert card.reload.awaiting_triage?
+  end
+
+  test "a dropped card stays where it landed once the move is saved" do
+    cards(:text).gild
+    visit board_url(@board)
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+    expand_column dom_id(column)
+
+    drag card, to: dom_id(column)
+
+    order_after_drop = card_order_in(dom_id(column))
+    assert_equal [ dom_id(cards(:text), :article), dom_id(card, :article) ], order_after_drop
+
+    within("##{dom_id(column)}") { assert_selector ".cards__expander-count", text: "2", visible: :all, wait: 5 }
+    assert_equal column, card.reload.column
+    sleep 1 # Give the refreshed column time to settle
+    assert_equal order_after_drop, card_order_in(dom_id(column))
+  end
+
+  test "while dragging, the card dims and the column under the pointer lights up" do
+    card = cards(:buy_domain)
+    column = columns(:writebook_in_progress)
+    wait_for_column dom_id(column)
+
+    dispatch_drag_event "dragstart", on: dom_id(card, :article)
+    assert_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item"
+
+    dispatch_drag_event "dragover", on: dom_id(column)
+    assert_selector "##{dom_id(column)}.drag-and-drop__hover-container"
+
+    dispatch_drag_event "dragover", on: "maybe"
+    assert_no_selector "##{dom_id(column)}.drag-and-drop__hover-container"
+    assert_no_selector "#maybe.drag-and-drop__hover-container", visible: :all # The card is already there
+
+    dispatch_drag_event "dragend", on: dom_id(card, :article)
+    assert_no_selector "##{dom_id(card, :article)}.drag-and-drop__dragged-item"
+    assert_no_selector ".drag-and-drop__hover-container", visible: :all
+    assert_nil card.reload.column
+  end
+
+  test "dropping a card on the column it is in does nothing" do
+    card = cards(:text)
+    column = columns(:writebook_in_progress)
+    expand_column dom_id(column)
+
+    drag card, to: dom_id(column)
+
+    within("##{dom_id(column)}") { assert_selector "##{dom_id(card, :article)}", visible: :all }
+    assert_equal column, card.reload.column
+  end
+
+  private
+    def drag(card, to:)
+      find("##{dom_id(card, :article)}", visible: :all).drag_to find("##{to}")
+    end
+
+    def expand_column(id)
+      find("##{id} .cards__expander").click
+      assert_selector "##{id}.is-expanded"
+      wait_for_column id
+    end
+
+    def dispatch_drag_event(name, on:)
+      page.execute_script(<<~JS, find("##{on}", visible: :all))
+        arguments[0].dispatchEvent(new DragEvent("#{name}", { bubbles: true, cancelable: true, dataTransfer: new DataTransfer() }))
+      JS
+    end
+
+    def card_order_in(id)
+      all("##{id} .card", visible: :all).map { |card| card[:id] }
+    end
+
+    def wait_for_column(id)
+      assert_selector "##{id} .cards__list[data-drag-and-drop-target]", visible: :all
+    end
+end
