@@ -0,0 +1,43 @@
+<% @page_title = "Accounts" %>
+
+<% content_for :header do %>
+  <h1 class="header__title">
+    <%= link_to "Statistics", saas.admin_stats_path %> /
+    <%= @page_title %>
+  </h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <header>
+      <h2 class="divider txt-medium margin-block-start"><%= pluralize @accounts.size, "account" %></h2>
+    </header>
+
+    <ul class="list-style-none margin-block-half flex flex-column gap-half">
