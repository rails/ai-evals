+++ b/app/models/webhook/payload.rb
@@ -0,0 +1,45 @@
+# The JSON body we POST to a webhook receiver about an event.
+class Webhook::Payload
+  attr_reader :event
+
+  def initialize(event)
+    @event = event
+  end
+
+  def to_json(*)
+    JSON.generate(as_json)
+  end
+
+  def as_json
+    { event: event_attributes }
+  end
+
+  private
+    def event_attributes
+      {
+        id: event.id,
+        action: event.action.to_s,
+        created_at: event.created_at.utc.iso8601(3),
+        creator: { id: event.creator_id, name: event.creator.name },
+        eventable: {
+          type: event.eventable_type,
+          id: event.eventable_id,
+          url: eventable_url
+        }
+      }
+    end
+
+    def eventable_url
+      Rails.application.routes.url_helpers.polymorphic_url(event.eventable, **url_options)
+    end
+
+    def url_options
+      default_url_options.merge(script_name: event.account.slug)
+    end
+
+    def default_url_options
+      Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+    end
+end
