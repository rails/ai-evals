+    assert_equal "destination_unreachable", @delivery.response[:error]
+    assert_nil @delivery.response_summary[:code]
+  end
+
+  test "deliver is only performed once" do
+    stub = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    @delivery.deliver
+    @delivery.deliver
+
+    assert_requested stub, times: 1
+  end
+
+  test "deliver_later enqueues the delivery" do
+    assert_enqueued_with(job: Webhook::Delivery::DeliverJob, args: [ @delivery ]) do
+      @delivery.deliver_later
+    end
+  end
+
+  test "cleanup keeps a week of deliveries" do
+    stale_delivery = webhook_deliveries(:successfully_completed)
