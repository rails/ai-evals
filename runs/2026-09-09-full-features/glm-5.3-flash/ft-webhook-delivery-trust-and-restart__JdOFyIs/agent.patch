@@ -0,0 +1,69 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+  end
+
+  test "is created along with the webhook" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+
+    assert webhook.reload.delinquency_tracker.present?
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "switches off a webhook that keeps failing over an hour" do
+    started_at = Time.current
+
+    10.times do |index|
+      travel_to(started_at + index * 6.minutes) do
+        Webhook::DelinquencyTracker.record_failure(@webhook)
+      end
+    end
+
+    assert_not @webhook.reload.active?
+    assert_not Webhook::DelinquencyTracker.exists?(webhook: @webhook)
+  end
+
+  test "keeps a webhook that failed less than ten times in a row active" do
+    9.times { Webhook::DelinquencyTracker.record_failure(@webhook) }
+
+    assert @webhook.reload.active?
+    assert_equal 9, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "clears the count when a delivery succeeds" do
+    3.times { Webhook::DelinquencyTracker.record_failure(@webhook) }
+
+    Webhook::DelinquencyTracker.track(successful_delivery)
+
+    assert_not Webhook::DelinquencyTracker.exists?(webhook: @webhook)
+  end
+
+  test "starts counting over when the failures have gone quiet" do
+    3.times { Webhook::DelinquencyTracker.record_failure(@webhook) }
+
+    travel 2.hours do
+      Webhook::DelinquencyTracker.record_failure(@webhook)
+    end
+
+    assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+    assert_in_delta Time.current, @webhook.delinquency_tracker.first_failure_at, 1.second
+  end
+
+  test "switches off a webhook whose deliveries keep failing" do
+    stub_request(:post, @webhook.url).to_timeout
+
+    10.times do
+      event = boards(:writebook).events.create!(action: "card_published", creator: users(:david), eventable: cards(:logo))
+      @webhook.deliver_later(event).deliver
+    end
+
+    assert_not @webhook.reload.active?
+  end
+
+  private
+    def successful_delivery
+      Webhook::Delivery.new(webhook: @webhook, event: events(:logo_published), state: :completed, response: { code: 200 })
+    end
+end
