diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..177ac65
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,56 @@
+# Keeps count of how many deliveries in a row a webhook has failed, so that a
+# receiver that keeps failing can be switched off before it becomes a nuisance.
+class Webhook::DelinquencyTracker < ApplicationRecord
+  CONSECUTIVE_FAILURES_LIMIT = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  class << self
+    def track(delivery)
+      if delivery.succeeded?
+        clear(delivery.webhook)
+      else
+        record_failure(delivery.webhook)
+      end
+    end
+
+    def clear(webhook)
+      find_by(webhook: webhook)&.destroy
+    end
+
+    def record_failure(webhook)
+      find_or_create_by!(webhook: webhook).record_failure
+    end
+  end
+
+  def record_failure
+    with_lock do
+      self.first_failure_at ||= Time.current
+      restart if stale?
+
+      self.consecutive_failures_count += 1
+
+      if consecutive_failures_count >= CONSECUTIVE_FAILURES_LIMIT
+        webhook.deactivate
+        destroy
+      else
+        save!
+      end
+    end
+  end
+
+  private
+    # Failures only count while they keep coming: when the last failure is
+    # older than the window, the webhook has been quiet for a while and we
+    # start counting from scratch again.
+    def stale?
+      updated_at < FAILURE_WINDOW.ago
+    end
+
+    def restart
+      self.first_failure_at = Time.current
+      self.consecutive_failures_count = 0
+    end
+end
