diff --git a/app/javascript/helpers/page_language.js b/app/javascript/helpers/page_language.js
new file mode 100644
index 0000000..a3f6b46
--- /dev/null
+++ b/app/javascript/helpers/page_language.js
@@ -0,0 +1,10 @@
+// The document language comes from the server, which sets it from the
+// person's locale.
+export function pageLanguage() {
+  return document.documentElement.lang || "en"
+}
+
+// Picks the copy for the page language, falling back to English.
+export function pageCopy(copies) {
+  return copies[pageLanguage()] || copies.en
+}
