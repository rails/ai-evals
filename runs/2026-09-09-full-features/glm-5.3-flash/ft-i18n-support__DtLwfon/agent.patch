+      - day
+
+  time:
+    formats:
+      default: "%a, %d %b %Y %H:%M:%S %z"
+      short: "%d %b %H:%M"
+      long: "%B %d, %Y %H:%M"
+      card_stamp: "%b %d, %Y"
+      bridge_date: "%b %e"
+      notification_bundle: "%-l%P on %A, %B %-d"
+      only_time: "%H:%M"
+    am: am
