diff --git a/app/models/identity/magic_link.rb b/app/models/identity/magic_link.rb
new file mode 100644
index 0000000..8f3b798
--- /dev/null
+++ b/app/models/identity/magic_link.rb
@@ -0,0 +1,73 @@
+class Identity::MagicLink < ApplicationRecord
+  CODE_LENGTH = 6
+  EXPIRY_DURATION = 15.minutes
+  CODE_CHARACTERS = %w[ A B C D E F G H J K L M N P Q R S T U V W X Y Z 2 3 4 5 6 7 8 9 ].freeze
+  PENDING_AUTHENTICATION_TOKEN_PURPOSE = :pending_authentication
+
+  belongs_to :identity
+
+  scope :active, -> { where(expires_at: Time.current..) }
+
+  before_create :generate_code, if: -> { code.blank? }
+  before_create :stamp_expiry, if: -> { expires_at.nil? }
+
+  class << self
+    # Emails a code to the identity, throwing away any magic links still
+    # outstanding for them. Returns the fresh magic link.
+    def deliver_to(identity)
+      where(identity: identity).destroy_all
+      create!(identity: identity).tap(&:deliver_later)
+    end
+
+    # Returns the identity a code was emailed to when the pending authentication
+    # token and the code match, or nil when they don't. A magic link only works
+    # once and for fifteen minutes.
+    def authenticate(pending_authentication_token, code)
+      magic_link = find_by_pending_authentication_token(pending_authentication_token)
+      return unless magic_link&.active?
+      return unless ActiveSupport::SecurityUtils.secure_compare(magic_link.code, normalize(code))
+
+      magic_link.consume
+      magic_link.identity
+    end
+
+    def find_by_pending_authentication_token(token)
+      find_signed(token, purpose: PENDING_AUTHENTICATION_TOKEN_PURPOSE)
+    end
+
+    private
+      def normalize(code)
+        code.to_s.strip.upcase
+      end
+  end
+
+  def active?
+    expires_at > Time.current
+  end
+
+  # What the browser carries from asking for a code to submitting it. Generated
+  # once, so it reads back the same wherever it's used.
+  def pending_authentication_token
+    @pending_authentication_token ||= signed_id(purpose: PENDING_AUTHENTICATION_TOKEN_PURPOSE, expires_in: EXPIRY_DURATION)
+  end
+
+  def consume
+    self.class.where(identity: identity).destroy_all
+  end
+
+  def deliver_later
+    IdentityMailer.magic_link(self).deliver_later
+  end
+
+  private
+    def generate_code
+      loop do
+        self.code = CODE_CHARACTERS.sample(CODE_LENGTH).join
+        break unless self.class.exists?(code: code)
+      end
+    end
+
+    def stamp_expiry
+      self.expires_at = EXPIRY_DURATION.from_now
+    end
+end
diff --git a/app/views/join_codes/magic_links/new.html.erb b/app/views/join_codes/magic_links/new.html.erb
