index 0000000..06a340c
--- /dev/null
+++ b/app/views/join_codes/magic_links/new.html.erb
@@ -0,0 +1,36 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <p class="txt-medium margin-none">
+    <% if @magic_link %>
+      We sent a code to <strong><%= @magic_link.identity.email_address %></strong>. Enter it to join <%= @join_code.account.name %>.
+    <% else %>
+      We sent a code to your email address. Enter it to join <%= @join_code.account.name %>.
+    <% end %>
+  </p>
+
+  <% if @magic_link && Rails.env.local? %>
+    <p class="txt-small txt-subtle margin-none">Psst, here’s your code: <strong><%= @magic_link.code %></strong></p>
+  <% end %>
+
+  <%= form_with url: join_magic_link_path(join_code: @join_code.code), class: "flex flex-column gap-half txt-medium", data: { controller: "form" } do |form| %>
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, maxlength: Identity::MagicLink::CODE_LENGTH, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", placeholder: "Enter your code…" %>
+      </label>
+    </div>
+
+    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Let’s go</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p class="txt-small txt-subtle margin-block-start">Didn’t get it? <%= link_to "Try again", join_path(code: @join_code.code), class: "txt-link" %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
