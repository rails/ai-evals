+  test "create without a pending authentication token" do
+    reset!
+
+    untenanted do
+      post session_magic_link_path, params: { code: @magic_link.code }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+    end
+
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create with the wrong code" do
+    untenanted do
+      post session_magic_link_path, params: { code: "NOPE99" }
+
+      assert_redirected_to new_session_magic_link_path
+      assert_equal "That code didn't work. Try again.", flash[:alert]
+    end
+
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create with a code that was emailed for another magic link" do
+    other = Identity::MagicLink.deliver_to(identities(:jz))
+
+    untenanted do
+      post session_magic_link_path, params: { code: other.code }
+
+      assert_redirected_to new_session_magic_link_path
+    end
+  end
+
+  test "create with an expired code" do
+    travel Identity::MagicLink::EXPIRY_DURATION + 1.second do
+      untenanted do
+        post session_magic_link_path, params: { code: @magic_link.code }
+
+        assert_redirected_to new_session_magic_link_path
+      end
+    end
+  end
+
+  test "create with a code that was already used" do
+    untenanted do
+      post session_magic_link_path, params: { code: @magic_link.code }
+
+      assert_redirected_to landing_url
+    end
+
+    sign_out
+
+    untenanted do
+      post session_magic_link_path, params: { code: @magic_link.code }
+
+      assert_redirected_to new_session_magic_link_path
+    end
+  end
+
+  test "create that doesn't work via JSON" do
+    untenanted do
+      post session_magic_link_path(format: :json), params: { code: "NOPE99" }
+
+      assert_response :unauthorized
+      assert_equal "That code didn't work. Try again.", @response.parsed_body["message"]
+    end
+  end
+
+  test "create is rate limited" do
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      post session_magic_link_path, params: { code: @magic_link.code }
+
+      assert_redirected_to new_session_path
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
+end
