index 0000000..9f0c5d0
--- /dev/null
+++ b/test/models/identity/magic_link_test.rb
@@ -0,0 +1,104 @@
+require "test_helper"
+
+class Identity::MagicLinkTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @identity = identities(:kevin)
+  end
+
+  test "deliver_to emails a code to the identity" do
+    assert_emails 1 do
+      @magic_link = Identity::MagicLink.deliver_to(@identity)
+    end
+
+    assert_equal [ @identity.email_address ], ActionMailer::Base.deliveries.last.to
+    assert_includes ActionMailer::Base.deliveries.last.subject, @magic_link.code
+  end
+
+  test "deliver_to throws away magic links that are still outstanding" do
+    outstanding = Identity::MagicLink.deliver_to(@identity)
+    Identity::MagicLink.deliver_to(@identity)
+
+    assert_nil Identity::MagicLink.authenticate(outstanding.pending_authentication_token, outstanding.code)
+  end
+
+  test "deliver_to generates a code of the right shape" do
+    @magic_link = Identity::MagicLink.deliver_to(@identity)
+
+    assert_equal Identity::MagicLink::CODE_LENGTH, @magic_link.code.length
+    assert (@magic_link.code.chars - Identity::MagicLink::CODE_CHARACTERS).empty?
+  end
+
+  test "deliver_to stamps an expiry" do
+    freeze_time do
+      @magic_link = Identity::MagicLink.deliver_to(@identity)
+
+      assert_equal Identity::MagicLink::EXPIRY_DURATION.from_now, @magic_link.expires_at
+    end
+  end
+
+  test "authenticate returns the identity the code was emailed to" do
+    @magic_link = Identity::MagicLink.deliver_to(@identity)
+
+    assert_equal @identity, Identity::MagicLink.authenticate(@magic_link.pending_authentication_token, @magic_link.code)
+  end
+
+  test "authenticate ignores casing and surrounding whitespace" do
+    @magic_link = Identity::MagicLink.deliver_to(@identity)
+
+    assert_equal @identity, Identity::MagicLink.authenticate(@magic_link.pending_authentication_token, " #{@magic_link.code.downcase} ")
+  end
+
+  test "authenticate consumes the magic link" do
+    @magic_link = Identity::MagicLink.deliver_to(@identity)
+
+    Identity::MagicLink.authenticate(@magic_link.pending_authentication_token, @magic_link.code)
+
+    assert_nil Identity::MagicLink.authenticate(@magic_link.pending_authentication_token, @magic_link.code)
+  end
+
+  test "authenticate with a code that was emailed for another magic link" do
+    @magic_link = Identity::MagicLink.deliver_to(@identity)
+    other = Identity::MagicLink.deliver_to(identities(:david))
+
+    assert_nil Identity::MagicLink.authenticate(@magic_link.pending_authentication_token, other.code)
+  end
+
+  test "authenticate with the wrong code" do
+    @magic_link = Identity::MagicLink.deliver_to(@identity)
+
+    assert_nil Identity::MagicLink.authenticate(@magic_link.pending_authentication_token, "NOPE99")
+  end
+
+  test "authenticate with a token for another purpose" do
+    @magic_link = Identity::MagicLink.deliver_to(@identity)
+
+    assert_nil Identity::MagicLink.authenticate(@identity.transfer_id, @magic_link.code)
+  end
+
+  test "authenticate with a garbage token" do
+    @magic_link = Identity::MagicLink.deliver_to(@identity)
+
+    assert_nil Identity::MagicLink.authenticate("garbage", @magic_link.code)
+    assert_nil Identity::MagicLink.authenticate(nil, @magic_link.code)
+  end
+
+  test "authenticate with an expired code" do
+    @magic_link = Identity::MagicLink.deliver_to(@identity)
+
+    travel Identity::MagicLink::EXPIRY_DURATION + 1.second do
+      assert_nil Identity::MagicLink.authenticate(@magic_link.pending_authentication_token, @magic_link.code)
+    end
+  end
+
+  test "active?" do
+    @magic_link = Identity::MagicLink.create!(identity: @identity, code: "ABC234")
+
+    assert @magic_link.active?
+
