diff --git a/app/controllers/concerns/magic_link_authentication.rb b/app/controllers/concerns/magic_link_authentication.rb
new file mode 100644
index 0000000..ad28e68
--- /dev/null
+++ b/app/controllers/concerns/magic_link_authentication.rb
@@ -0,0 +1,41 @@
+# Carries a magic link from asking for a code to submitting the one that
+# arrived by email, all in the same browser.
+module MagicLinkAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    # Emails a code to the identity and remembers the magic link in the browser,
+    # so the code can be submitted from where it was asked for.
+    def deliver_magic_link_to(identity)
+      magic_link = Identity::MagicLink.deliver_to(identity)
+      remember_pending_authentication_token(magic_link)
+      magic_link
+    end
+
+    # Signs in the identity a code was emailed to, when the request carries their
+    # pending authentication token and a code that matches it. Returns the
+    # identity, or nil when it didn't work.
+    def sign_in_with_magic_link
+      if identity = Identity::MagicLink.authenticate(pending_authentication_token, params[:code])
+        forget_pending_authentication_token
+        start_new_session_for identity
+        identity
+      end
+    end
+
+    def remember_pending_authentication_token(magic_link)
+      cookies[:pending_authentication_token] = {
+        value: magic_link.pending_authentication_token,
+        httponly: true,
+        same_site: :lax
+      }
+    end
+
+    def pending_authentication_token
+      cookies[:pending_authentication_token]
+    end
+
+    def forget_pending_authentication_token
+      cookies.delete(:pending_authentication_token)
+    end
+end
