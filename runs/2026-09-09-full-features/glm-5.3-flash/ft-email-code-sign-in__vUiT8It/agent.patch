+require "test_helper"
+
+class JoinCodes::MagicLinksControllerTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  setup do
+    @account = accounts("37s")
+    @join_code = account_join_codes(:"37s")
+    @identity = Identity.create!(email_address: "newbie@example.com")
+    @magic_link = Identity::MagicLink.deliver_to(@identity)
+    cookies[:pending_authentication_token] = @magic_link.pending_authentication_token
+  end
+
+  test "new" do
+    get new_join_magic_link_path(join_code: @join_code.code, script_name: @account.slug)
+
+    assert_response :success
+    assert_in_body @account.name
+    assert_in_body @identity.email_address
+  end
+
+  test "new with an invalid code" do
+    get new_join_magic_link_path(join_code: "INVALID-CODE", script_name: @account.slug)
+
+    assert_response :not_found
+  end
+
+  test "create joins the account" do
+    assert_difference -> { User.count }, 1 do
+      post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug), params: { code: @magic_link.code }
+    end
+
+    assert_redirected_to new_users_verification_url(script_name: @account.slug)
+    assert cookies[:session_token].present?
+    assert_equal @join_code.account, User.find_by!(identity: @identity).account
+  end
+
+  test "create for someone who is all set up" do
+    user = users(:david)
+    magic_link = Identity::MagicLink.deliver_to(user.identity)
+    cookies[:pending_authentication_token] = magic_link.pending_authentication_token
+
+    post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug), params: { code: magic_link.code }
+
+    assert_redirected_to landing_url(script_name: @account.slug)
+  end
+
+  test "create with the wrong code" do
+    assert_no_difference -> { User.count } do
+      post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug), params: { code: "NOPE99" }
+    end
+
+    assert_redirected_to new_join_magic_link_url(join_code: @join_code.code, script_name: @account.slug)
+    assert_equal "That code didn't work. Try again.", flash[:alert]
+    assert_not cookies[:session_token].present?
+  end
+
+  test "create with an expired code" do
+    travel Identity::MagicLink::EXPIRY_DURATION + 1.second do
+      post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug), params: { code: @magic_link.code }
+
+      assert_redirected_to new_join_magic_link_url(join_code: @join_code.code, script_name: @account.slug)
+    end
+  end
+
+  test "create with an inactive code" do
+    @join_code.update!(usage_count: @join_code.usage_limit)
+
+    post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug), params: { code: @magic_link.code }
+
+    assert_response :gone
+  end
+
+  test "create is rate limited" do
+    Rails.cache.stubs(:increment).returns(11)
+
+    post join_magic_link_path(join_code: @join_code.code, script_name: @account.slug), params: { code: @magic_link.code }
+
+    assert_response :too_many_requests
+  end
+end
