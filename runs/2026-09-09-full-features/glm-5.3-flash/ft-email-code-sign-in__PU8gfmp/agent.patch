diff --git a/test/mailers/user_mailer_test.rb b/test/mailers/user_mailer_test.rb
new file mode 100644
index 0000000..8740814
--- /dev/null
+++ b/test/mailers/user_mailer_test.rb
@@ -0,0 +1,30 @@
+require "test_helper"
+
+class UserMailerTest < ActionMailer::TestCase
+  test "email code is addressed to the email address the code was issued for" do
+    email_code = EmailCode.new(email_address: "someone@37signals.com", code: "ABC234")
+
+    email = UserMailer.email_code(email_code)
+
+    assert_equal [ "someone@37signals.com" ], email.to
+  end
+
+  test "email code has the code in the subject" do
+    email_code = EmailCode.new(email_address: "someone@37signals.com", code: "ABC234")
+
+    email = UserMailer.email_code(email_code)
+
+    assert_equal "ABC234 is your Fizzy sign-in code", email.subject
+  end
+
+  test "email code has both HTML and text parts" do
+    email_code = EmailCode.new(email_address: "someone@37signals.com", code: "ABC234")
+
+    email = UserMailer.email_code(email_code)
+
+    assert email.html_part.present?, "Email should have HTML part"
+    assert email.text_part.present?, "Email should have text part"
+    assert_match "ABC234", email.html_part.body.encoded
+    assert_match "ABC234", email.text_part.body.encoded
+  end
+end
diff --git a/test/models/email_code_test.rb b/test/models/email_code_test.rb
new file mode 100644
index 0000000..70683f4
--- /dev/null
+++ b/test/models/email_code_test.rb
@@ -0,0 +1,108 @@
+require "test_helper"
+
+class EmailCodeTest < ActiveSupport::TestCase
+  test "issues a six character code" do
+    email_code = EmailCode.create!(email_address: "someone@37signals.com")
+
+    assert_equal 6, email_code.code.length
+    assert_match /\A[#{EmailCode::CODE_CHARACTERS.join}]{6}\z/, email_code.code
+  end
+
+  test "issues codes that are unique among the ones that haven't expired" do
+    email_codes = 20.times.map { EmailCode.issue("someone@37signals.com") }
+
+    assert_equal email_codes.map(&:code).uniq.size, email_codes.size
+  end
+
+  test "issues codes that work for fifteen minutes" do
+    freeze_time
+
+    email_code = EmailCode.create!(email_address: "someone@37signals.com")
+
+    assert_in_delta 15.minutes.from_now, email_code.expires_at, 1
+    assert_not email_code.expired?
+  end
+
+  test "issues codes by email, with the code in the subject" do
+    email_code = EmailCode.issue("someone@37signals.com")
+    email = UserMailer.email_code(email_code)
+
+    assert_equal [ "someone@37signals.com" ], email.to
+    assert_equal "#{email_code.code} is your Fizzy sign-in code", email.subject
+    assert_match email_code.code, email.body.encoded
+  end
+
+  test "issues codes for a specific join code" do
+    email_code = EmailCode.issue("someone@37signals.com", join_code: account_join_codes(:"37s"))
+
+    assert_equal account_join_codes(:"37s"), email_code.join_code
+  end
+
+  test "normalizes the email address" do
+    email_code = EmailCode.create!(email_address: " SOMEONE@37signals.com ")
+
+    assert_equal "someone@37signals.com", email_code.email_address
+  end
+
+  test "verifies the code that was issued, whatever case it's entered in" do
+    email_code = EmailCode.issue("someone@37signals.com")
+
+    assert_equal email_code, EmailCode.verify(" #{email_code.code.downcase} ")
+  end
+
+  test "a code only verifies once" do
+    email_code = EmailCode.issue("someone@37signals.com")
+
+    assert_equal email_code, EmailCode.verify(email_code.code)
+    assert_nil EmailCode.verify(email_code.code)
+  end
+
+  test "doesn't verify the wrong code" do
+    EmailCode.issue("someone@37signals.com")
+
+    assert_nil EmailCode.verify("XXXXXX")
+    assert_nil EmailCode.verify(nil)
+    assert_nil EmailCode.verify("")
+  end
+
+  test "doesn't verify an expired code" do
+    email_code = EmailCode.create!(email_address: "someone@37signals.com", expires_at: 1.minute.ago)
+
+    assert email_code.expired?
+    assert_nil EmailCode.verify(email_code.code)
+  end
+
+  test "doesn't verify a code that just expired" do
+    freeze_time do
+      email_code = EmailCode.issue("someone@37signals.com")
+
+      travel 16.minutes
+
+      assert email_code.expired?
+      assert_nil EmailCode.verify(email_code.code)
+    end
+  end
+
+  test "doesn't verify a code that was consumed by another one with the same code" do
+    email_code = EmailCode.create!(email_address: "someone@37signals.com", code: "ABC234")
+
+    assert_equal email_code, EmailCode.verify("ABC234")
+    assert_nil EmailCode.verify("ABC234")
+  end
+
+  test "cleans up codes that can no longer be verified" do
+    stale = EmailCode.create!(email_address: "someone@37signals.com", expires_at: 1.minute.ago)
+    EmailCode.create!(email_address: "someone-else@37signals.com")
+
+    assert_difference -> { EmailCode.count }, -1 do
+      EmailCode.cleanup
+    end
+
+    assert_not_equal stale.id, EmailCode.last.id
+  end
+
+  test "is invalid without an email address" do
+    assert_not EmailCode.new(email_address: "not-an-email").valid?
+    assert_not EmailCode.new.valid?
+  end
+end
