diff --git a/app/controllers/concerns/email_code_authentication.rb b/app/controllers/concerns/email_code_authentication.rb
new file mode 100644
index 0000000..22e5a85
--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,92 @@
+# Signing in, signing up, and joining by email all work the same way: we send a
+# code to the email address, and the person enters it on the next screen.
+module EmailCodeAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    # Sends a code to the email address, then hands over to the screen where the
+    # code is entered.
+    def send_email_code_to(email_address, join_code: nil)
+      email_code = EmailCode.issue(email_address, join_code:)
+      session[:email_code_email_address] = email_code.email_address
+
+      respond_to do |format|
+        format.html { redirect_to new_session_code_path(script_name: nil) }
+        format.json { head :accepted }
+      end
+    end
+
+    def verify_email_code
+      if email_code = EmailCode.verify(params.expect(:code))
+        forget_email_code_email_address
+        continue_with_email_code(email_code)
+      else
+        invalid_email_code
+      end
+    end
+
+    def continue_with_email_code(email_code)
+      if join_code = email_code.join_code
+        join_account_with join_code, email_code
+      elsif identity = Identity.find_by(email_address: email_code.email_address)
+        sign_in_with identity
+      else
+        sign_up_with email_code
+      end
+    end
+
+    def invalid_email_code
+      respond_to do |format|
+        format.html { redirect_to new_session_code_path(script_name: nil), alert: "That code didn't work. It may have expired." }
+        format.json { render json: { message: "That code didn't work." }, status: :unprocessable_entity }
+      end
+    end
+
+    def sign_in_with(identity)
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to after_authentication_url }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def sign_up_with(email_code)
+      identity = Identity.create!(email_address: email_code.email_address)
+      start_new_session_for identity
+
+      respond_to do |format|
+        format.html { redirect_to new_signup_completion_path(script_name: nil) }
+        format.json { render json: { session_token: session_token } }
+      end
+    end
+
+    def join_account_with(join_code, email_code)
+      identity = Identity.find_or_create_by!(email_address: email_code.email_address)
+      start_new_session_for identity
+
+      if join_code.active?
+        join_code.redeem_if { |account| identity.join(account) }
+        user = User.active.find_by!(account: join_code.account, identity: identity)
+        redirect_after_joining user, account: join_code.account
+      else
+        redirect_to join_path(code: join_code.code, script_name: join_code.account.slug)
+      end
+    end
+
+    def redirect_after_joining(user, account:)
+      if user.setup?
+        redirect_to landing_url(script_name: account.slug)
+      else
+        redirect_to new_users_verification_url(script_name: account.slug)
+      end
+    end
+
+    def email_code_email_address
+      session[:email_code_email_address]
+    end
+
+    def forget_email_code_email_address
+      session.delete(:email_code_email_address)
+    end
+end
