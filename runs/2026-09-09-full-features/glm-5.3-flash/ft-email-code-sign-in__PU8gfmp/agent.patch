diff --git a/app/models/email_code.rb b/app/models/email_code.rb
new file mode 100644
index 0000000..7b67298
--- /dev/null
+++ b/app/models/email_code.rb
@@ -0,0 +1,65 @@
+class EmailCode < ApplicationRecord
+  CODE_LENGTH = 6
+  CODE_CHARACTERS = %w[ 2 3 4 5 6 7 8 9 A B C D E F G H J K L M N P Q R S T U V W X Y Z ].freeze
+  VALID_FOR = 15.minutes
+
+  belongs_to :join_code, class_name: "Account::JoinCode", optional: true
+
+  normalizes :email_address, with: ->(value) { value.strip.downcase.presence }
+
+  validates :email_address, presence: true, format: { with: URI::MailTo::EMAIL_REGEXP }
+
+  scope :unexpired, -> { where(expires_at: Time.current..) }
+  scope :expired, -> { where(expires_at: ...Time.current) }
+
+  before_create :set_code, if: -> { code.blank? }
+  before_create :set_expires_at, if: -> { expires_at.blank? }
+
+  class << self
+    # Codes that can no longer be verified are just hanging around.
+    def cleanup
+      expired.delete_all
+    end
+
+    def issue(email_address, join_code: nil)
+      create!(email_address:, join_code:).tap(&:deliver_later)
+    end
+
+    def verify(candidate)
+      if email_code = unexpired.find_by(code: code_for(candidate))
+        email_code.consume
+        email_code
+      end
+    end
+
+    private
+      def code_for(candidate)
+        candidate.to_s.strip.upcase.presence
+      end
+  end
+
+  def deliver_later
+    UserMailer.email_code(self).deliver_later
+  end
+
+  def expired?
+    expires_at.past?
+  end
+
+  # Codes are single use: once a code verifies, it can't verify again.
+  def consume
+    destroy!
+  end
+
+  private
+    def set_code
+      self.code = loop do
+        candidate = Array.new(CODE_LENGTH) { CODE_CHARACTERS.sample(random: SecureRandom) }.join
+        break candidate unless self.class.unexpired.exists?(code: candidate)
+      end
+    end
+
+    def set_expires_at
+      self.expires_at = VALID_FOR.from_now
+    end
+end
diff --git a/app/views/sessions/codes/new.html.erb b/app/views/sessions/codes/new.html.erb
new file mode 100644
index 0000000..ff1c1e0
--- /dev/null
+++ b/app/views/sessions/codes/new.html.erb
@@ -0,0 +1,32 @@
+<% @page_title = "Enter your code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+
+  <%= form_with url: session_code_path, class: "flex flex-column gap-half txt-medium", data: { controller: "form" } do |form| %>
+    <% if @email_address %>
+      <p>We sent a six-character code to <strong><%= @email_address %></strong>. Enter it to continue.</p>
+    <% else %>
+      <p>Enter the six-character code we sent to your email address.</p>
+    <% end %>
+
+    <div class="flex align-center gap">
+      <label class="flex align-center gap input input--actor">
+        <%= form.text_field :code, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", maxlength: EmailCode::CODE_LENGTH, placeholder: "Enter your code…", autocapitalize: "characters", spellcheck: false %>
+      </label>
+    </div>
+
+    <button type="submit" id="log_in" class="btn btn--link center txt-medium" data-form-target="submit">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <div class="margin-block-start">
+    <%= link_to "Use a different email address", new_session_path, class: "btn btn--plain txt-link center txt-small" %>
+  </div>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
