--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,116 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "create publishes the board" do
+    board = boards(:writebook)
+
+    post board_publication_path(board), as: :json
+    assert_response :created
+
+    assert board.reload.published?
+    assert_not_nil board.public_key
+  end
+
+  test "create as JSON returns the board with its public url" do
+    board = boards(:writebook)
+
+    post board_publication_path(board), as: :json
+    assert_response :created
+
+    assert_equal untenanted { public_board_url(board.reload.public_key) }, @response.parsed_body["public_url"]
+  end
+
+  test "create redirects back to the board settings" do
+    board = boards(:writebook)
+
+    post board_publication_path(board)
+    assert_redirected_to edit_board_path(board)
+    assert_equal "Board published", flash[:notice]
+  end
+
+  test "create requires an admin" do
+    logout_and_sign_in_as :jz
+    board = boards(:writebook)
+
+    post board_publication_path(board), as: :json
+    assert_response :forbidden
+
+    assert_not board.reload.published?
+  end
+
+  test "create requires board access" do
+    logout_and_sign_in_as :jz
+    board = boards(:private)
+
+    post board_publication_path(board), as: :json
+    assert_response :not_found
+
+    assert_not board.reload.published?
+  end
+
+  test "destroy unpublishes the board" do
+    board = boards(:writebook)
+    board.publish
+
+    delete board_publication_path(board), as: :json
+    assert_response :no_content
+
+    assert_not board.reload.published?
+  end
+
+  test "destroy redirects back to the board settings" do
+    board = boards(:writebook)
+    board.publish
+
+    delete board_publication_path(board)
+    assert_redirected_to edit_board_path(board)
+    assert_equal "Board unpublished", flash[:notice]
+  end
+
