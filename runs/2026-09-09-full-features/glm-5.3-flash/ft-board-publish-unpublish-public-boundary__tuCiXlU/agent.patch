+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  test "show a published board without an account" do
+    board = boards(:writebook)
+    board.publish
+
+    untenanted do
+      get public_board_path(board.public_key)
+      assert_response :success
+
+      assert_select "h1", board.name
+    end
+  end
+
+  test "show a published board of another account" do
+    board = boards(:miltons_wish_list)
+    board.publish
+
+    untenanted do
+      get public_board_path(board.public_key)
+      assert_response :success
+    end
+  end
+
+  test "does not show a board that was unpublished again" do
+    board = boards(:writebook)
+    board.publish
+    board.unpublish
+
+    untenanted do
+      get public_board_path(board.public_key)
+      assert_response :not_found
+    end
+  end
+
+  test "does not show an unknown key" do
+    untenanted do
+      get public_board_path("not-a-key")
+      assert_response :not_found
+    end
+  end
+
+  test "supports conditional GET" do
+    board = boards(:writebook)
+    board.publish
+
+    get public_board_path(board.public_key)
+    assert_response :success
+    etag = response.headers["ETag"]
+
+    get public_board_path(board.public_key), headers: { "If-None-Match" => etag }
+    assert_response :not_modified
+  end
+
+  test "is not indexed by search engines" do
+    board = boards(:writebook)
+    board.publish
+
+    get public_board_path(board.public_key)
+    assert_equal "none", response.headers["X-Robots-Tag"]
+  end
+end
diff --git a/test/models/board/publication_test.rb b/test/models/board/publication_test.rb
new file mode 100644
index 0000000..ebc53fb
--- /dev/null
+++ b/test/models/board/publication_test.rb
@@ -0,0 +1,51 @@
+require "test_helper"
+
+class Board::PublicationTest < ActiveSupport::TestCase
+  test "boards are not published by default" do
+    assert_not boards(:writebook).published?
+    assert_not Board.published.include?(boards(:writebook))
+  end
+
+  test "publish sets published_at and a secret public key" do
+    board = boards(:writebook)
+
+    assert_changes -> { board.reload.published_at }, from: nil do
+      board.publish
+    end
+
+    assert board.reload.published?
+    assert_not_nil board.public_key
+    assert Board.published.include?(board)
+  end
+
+  test "publish keeps an already assigned public key" do
+    board = boards(:writebook)
+    board.update_column :public_key, "some-key"
+
+    board.publish
+
+    assert_equal "some-key", board.reload.public_key
+  end
+
+  test "unpublish clears published_at but keeps the public key" do
+    board = boards(:writebook)
+    board.publish
+
+    board.unpublish
+
+    assert_not board.reload.published?
+    assert_not_nil board.public_key
+    assert_not Board.published.include?(board)
+  end
+
+  test "public_url is nil when the board is not published" do
+    assert_nil boards(:writebook).public_url
+  end
+
+  test "public_url points to the public board page" do
+    board = boards(:writebook)
+    board.publish
+
+    assert_equal "/public/boards/#{board.reload.public_key}", URI.parse(board.reload.public_url).path
+  end
+end
