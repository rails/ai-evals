@@ -0,0 +1,14 @@
+# Controllers serving published boards to anyone with the secret link. No account
+# prefix and no authentication: the key in the URL is the credential.
+class Public::BaseController < ApplicationController
+  allow_unauthenticated_access
+  skip_before_action :require_account
+
+  layout "public"
+
+  private
+    def set_board
+      @board = Board.published.find_by!(public_key: params[:key])
+      Current.account = @board.account
+    end
+end
