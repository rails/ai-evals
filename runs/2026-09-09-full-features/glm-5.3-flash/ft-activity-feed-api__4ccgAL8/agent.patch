+++ b/app/models/user/timelined.rb
@@ -8,4 +8,13 @@ module User::Timelined
   def timeline_for(day, filter:)
     User::DayTimeline.new(self, day, filter)
   end
+
+  def activities(filter:)
+    events = Event.preloaded.where(board: boards).where(action: Event::ACTIVITY_ACTIONS)
+    events = events.where(creator_id: filter.creators.ids) if filter.creators.present?
+    # Narrowing by +filter.board_ids+ rather than +filter.boards+ keeps the request
+    # empty when it only asks for boards the user has no access to.
+    events = events.where(board: filter.board_ids) if filter.board_ids.present?
+    events.newest_first
+  end
 end
