diff --git a/app/models/event/particulars.rb b/app/models/event/particulars.rb
index 31ecd66..9577ebb 100644
--- a/app/models/event/particulars.rb
+++ b/app/models/event/particulars.rb
@@ -8,4 +8,30 @@ module Event::Particulars
   def assignees
     @assignees ||= User.where id: assignee_ids
   end
+
+  def api_particulars
+    case action
+    when "card_assigned", "card_unassigned"
+      { "assignee_ids" => Array(assignee_ids) }
+    when "card_board_changed"
+      { "old_board" => detail("old_board"), "new_board" => detail("new_board") }
+    when "card_title_changed"
+      { "old_title" => detail("old_title"), "new_title" => detail("new_title") }
+    when "card_triaged"
+      { "column" => detail("column") }
+    else
+      {}
+    end
+  end
+
+  private
+    # Details like the old title or the new board are nested under a
+    # "particulars" key, unlike +assignee_ids+, which sits at the top level.
+    def details
+      particulars.to_h.fetch("particulars", {})
+    end
+
+    def detail(name)
+      details[name].to_s
+    end
 end
diff --git a/app/models/user/timelined.rb b/app/models/user/timelined.rb
