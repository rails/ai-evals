@@ -0,0 +1,17 @@
+class ActivitiesController < ApplicationController
+  include FilterScoped
+
+  # Activity is only exposed through the API, so requests without an explicit format
+  # are answered with JSON as well. This has to happen before authentication, which
+  # only accepts bearer tokens for JSON requests.
+  prepend_before_action :serve_json
+
+  def index
+    set_page_and_extract_portion_from Current.user.activities(filter: @filter)
+  end
+
+  private
+    def serve_json
+      request.format = :json
+    end
+end
