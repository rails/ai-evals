@@ -0,0 +1,178 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @bearer_token = { "HTTP_AUTHORIZATION" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+  end
+
+  test "returns activity as json for the current user" do
+    get activities_path(format: :json), env: @bearer_token
+
+    assert_response :success
+    activities = @response.parsed_body
+    assert activities.present?
+    assert activities.all? { |activity| activity["board"]["name"] == "Writebook" }
+  end
+
+  test "exposes the documented attributes" do
+    get activities_path(format: :json), env: @bearer_token
+
+    activity = @response.parsed_body.find { |a| a["action"] == "card_published" }
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ], activity.keys
+    assert_equal "Card", activity["eventable_type"]
+    assert_includes activity["description"], "David added"
+    assert_equal card_url(cards(:logo)), activity["url"]
+    assert_equal cards(:logo).id, activity["eventable"]["id"]
+    assert_equal boards(:writebook).id, activity["board"]["id"]
+    assert_equal users(:david).id, activity["creator"]["id"]
+  end
+
+  test "returns a flat array, newest first" do
+    get activities_path(format: :json), env: @bearer_token
+
+    created_ats = @response.parsed_body.collect { |a| Time.zone.parse(a["created_at"]) }
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "includes card_title_changed and omits card_collection_changed" do
+    Current.user = users(:david)
+    cards(:logo).update!(title: "Renamed")
+
+    get activities_path(format: :json), env: @bearer_token
+
+    actions = @response.parsed_body.collect { |a| a["action"] }
+    assert_includes actions, "card_title_changed"
+    assert_not_includes actions, "card_collection_changed"
+  end
+
+  test "exposes assignment particulars" do
+    get activities_path(format: :json), env: @bearer_token
+
+    activity = @response.parsed_body.find { |a| a["action"] == "card_assigned" }
+    assert_equal [ users(:jz).id ], activity["particulars"]["assignee_ids"]
+  end
+
+  test "exposes board particulars" do
+    events(:logo_published).update_columns(action: "card_board_changed",
+      particulars: { "particulars" => { "old_board" => "Old", "new_board" => "Writebook" } })
+
+    get activities_path(format: :json), env: @bearer_token
+
+    activity = @response.parsed_body.find { |a| a["action"] == "card_board_changed" }
+    assert_equal({ "old_board" => "Old", "new_board" => "Writebook" }, activity["particulars"])
+  end
+
+  test "returns empty strings for missing board particulars" do
+    events(:logo_published).update_columns(action: "card_board_changed", particulars: {})
+
+    get activities_path(format: :json), env: @bearer_token
+
+    activity = @response.parsed_body.find { |a| a["action"] == "card_board_changed" }
+    assert_equal({ "old_board" => "", "new_board" => "" }, activity["particulars"])
+  end
+
+  test "exposes title particulars" do
+    events(:logo_published).update_columns(action: "card_title_changed",
+      particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } })
+
+    get activities_path(format: :json), env: @bearer_token
+
+    activity = @response.parsed_body.find { |a| a["action"] == "card_title_changed" }
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, activity["particulars"])
+  end
+
+  test "exposes triage particulars" do
+    events(:logo_published).update_columns(action: "card_triaged",
+      particulars: { "particulars" => { "column" => "Triage" } })
+
+    get activities_path(format: :json), env: @bearer_token
+
+    activity = @response.parsed_body.find { |a| a["action"] == "card_triaged" }
+    assert_equal({ "column" => "Triage" }, activity["particulars"])
+  end
+
+  test "returns empty particulars for other events" do
+    get activities_path(format: :json), env: @bearer_token
+
+    activity = @response.parsed_body.find { |a| a["action"] == "card_published" }
+    assert_equal({}, activity["particulars"])
+  end
+
+  test "links comment events to the commented card, anchored at the comment" do
+    get activities_path(format: :json), env: @bearer_token
+
+    activity = @response.parsed_body.find { |a| a["action"] == "comment_created" }
+    comment = comments(:layout_overflowing_david)
+    assert_equal card_url(comment.card, anchor: "comment_#{comment.id}"), activity["url"]
+    assert_equal comment.id, activity["eventable"]["id"]
+  end
+
+  test "filters by creator" do
+    get activities_path(format: :json, creator_ids: [ users(:kevin).id ]), env: @bearer_token
+
+    creators = @response.parsed_body.collect { |a| a["creator"]["id"] }.uniq
+    assert_equal [ users(:kevin).id ], creators
+  end
+
+  test "filters by board" do
+    Current.user = users(:david)
+    board = Current.account.boards.create!(name: "Elsewhere", all_access: true, creator: users(:david))
+    card = board.cards.create!(title: "Elsewhere card", creator: users(:david), column: board.columns.first)
+    card.publish
+    card.reload
+
+    get activities_path(format: :json, board_ids: [ board.id ]), env: @bearer_token
+
+    assert_not_empty @response.parsed_body
+    assert_equal [ board.id ], @response.parsed_body.collect { |a| a["board"]["id"] }.uniq
+  end
+
+  test "returns nothing when filtering by a board you cannot access" do
+    get activities_path(format: :json, board_ids: [ boards(:private).id ]), env: @bearer_token
+
+    assert_empty @response.parsed_body
+  end
+
+  test "only returns activity the current user can access" do
+    Current.user = users(:kevin)
+    Current.account.boards.create!(name: "Secret", all_access: false, creator: users(:kevin)).tap do |board|
+      card = board.cards.create!(title: "Secret card", creator: users(:kevin), status: "published", column: board.columns.first)
+      card.events.create!(action: "card_published", creator: users(:kevin), board: board, eventable: card)
+    end
+
+    get activities_path(format: :json), env: @bearer_token
+
+    assert_not_includes @response.parsed_body.collect { |a| a["board"]["name"] }, "Secret"
+  end
+
+  test "paginates with a link header to the next page" do
+    Current.user = users(:david)
+    20.times do |i|
+      card = cards(:logo)
+      card.events.create!(action: "card_postponed", creator: users(:david), board: card.board, eventable: card,
+        created_at: 2.hours.ago + i.minutes)
+    end
+
+    get activities_path(format: :json), env: @bearer_token
+    assert_response :success
+    assert_equal 15, @response.parsed_body.size
+
+    next_url = @response.headers["Link"].match(%r{<(.*?)>; rel="next"})[1]
+    get next_url, env: @bearer_token
+    assert_response :success
+    assert_equal 16, @response.parsed_body.size
+  end
+
+  test "fails to authenticate with an invalid access token" do
+    get activities_path(format: :json), env: { "HTTP_AUTHORIZATION" => "Bearer nonsense" }
+
+    assert_response :unauthorized
+  end
+
+  test "answers json when the request asks for no format" do
+    get activities_path, env: @bearer_token
+
+    assert_response :success
+    assert_equal "application/json", @response.media_type
+  end
+end
diff --git a/test/models/event/particulars_test.rb b/test/models/event/particulars_test.rb
