+module ActivitiesHelper
+  # Card events link to the card itself, comment events link to the card the
+  # comment was posted on, anchored at the comment.
+  def event_url(event)
+    if event.action.comment_created?
+      card_url event.eventable.card, anchor: dom_id(event.eventable)
+    else
+      card_url event.eventable
+    end
+  end
+end
