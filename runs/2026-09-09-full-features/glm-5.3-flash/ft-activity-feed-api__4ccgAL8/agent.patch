@@ -0,0 +1,46 @@
+require "test_helper"
+
+class User::ActivitiesTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:david)
+    cards(:logo).update!(title: "Renamed")
+  end
+
+  test "returns activity from the boards the user can access, newest first" do
+    created_ats = users(:david).activities(filter: empty_filter).collect(&:created_at)
+
+    assert created_ats.present?
+    assert_equal created_ats.sort.reverse, created_ats
+  end
+
+  test "returns the same kinds of events as the timeline, plus title changes, minus collection changes" do
+    actions = users(:david).activities(filter: empty_filter).collect(&:action).uniq
+
+    assert_includes actions, "card_title_changed"
+    assert_not_includes actions, "card_collection_changed"
+  end
+
+  test "filters by creators" do
+    activities = users(:david).activities(filter: empty_filter(creator_ids: [ users(:kevin).id ]))
+
+    assert activities.present?
+    assert activities.all? { |event| event.creator_id == users(:kevin).id }
+  end
+
+  test "filters by boards" do
+    board = boards(:writebook)
+    activities = users(:david).activities(filter: empty_filter(board_ids: [ board.id ]))
+
+    assert activities.present?
+    assert activities.all? { |event| event.board_id == board.id }
+  end
+
+  test "ignores boards the user cannot access" do
+    assert_empty users(:david).activities(filter: empty_filter(board_ids: [ boards(:private).id ]))
+  end
+
+  private
+    def empty_filter(**params)
+      Current.user.filters.from_params(params)
+    end
+end
