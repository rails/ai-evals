index 0000000..6769c1c
--- /dev/null
+++ b/test/models/event/particulars_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Event::ParticularsTest < ActiveSupport::TestCase
+  test "assignment events expose the assignees" do
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, events(:logo_assignment_jz).api_particulars)
+  end
+
+  test "board change events expose the old and the new board" do
+    event = events(:logo_published).tap do |e|
+      e.update_columns(action: "card_board_changed", particulars: { "particulars" => { "old_board" => "Old", "new_board" => "Writebook" } })
+    end
+
+    assert_equal({ "old_board" => "Old", "new_board" => "Writebook" }, event.api_particulars)
+  end
+
+  test "title change events expose the old and the new title" do
+    event = events(:logo_published).tap do |e|
+      e.update_columns(action: "card_title_changed", particulars: { "particulars" => { "old_title" => "Old", "new_title" => "New" } })
+    end
+
+    assert_equal({ "old_title" => "Old", "new_title" => "New" }, event.api_particulars)
+  end
+
+  test "triage events expose the column" do
+    event = events(:logo_published).tap do |e|
+      e.update_columns(action: "card_triaged", particulars: { "particulars" => { "column" => "Triage" } })
+    end
+
+    assert_equal({ "column" => "Triage" }, event.api_particulars)
+  end
+
+  test "other events expose no particulars" do
+    assert_equal({}, events(:logo_published).api_particulars)
+  end
+
+  test "missing values are exposed as empty strings" do
+    event = events(:logo_published).tap do |e|
+      e.update_columns(action: "card_board_changed", particulars: {})
+    end
+
+    assert_equal({ "old_board" => "", "new_board" => "" }, event.api_particulars)
+  end
+
+  test "exposes no particulars for unsaved events" do
+    assert_equal({ "assignee_ids" => [] }, Event.new(action: "card_assigned").api_particulars)
+  end
+end
diff --git a/test/models/user/activities_test.rb b/test/models/user/activities_test.rb
