diff --git a/app/controllers/concerns/locale.rb b/app/controllers/concerns/locale.rb
new file mode 100644
index 0000000..d622482
--- /dev/null
+++ b/app/controllers/concerns/locale.rb
@@ -0,0 +1,51 @@
+# Picks the locale for every request and remembers the ones people choose.
+#
+# An explicit `?locale=ja` switches the locale and the choice sticks for the
+# rest of the session and in future visits from the same browser. People who
+# signed in get their choice remembered on their identity, so their next sign
+# in starts in the language they picked, even from a clean browser.
+module Locale
+  extend ActiveSupport::Concern
+
+  included do
+    before_action :set_locale
+
+    etag { I18n.locale }
+  end
+
+  private
+    def set_locale
+      I18n.locale = requested_locale || remembered_locale || identity_locale || I18n.default_locale
+
+      remember_locale if requested_locale
+    end
+
+    # An explicit `?locale=` from the URL. Locales we don't offer are ignored so
+    # an unknown value never switches anything nor breaks the page.
+    def requested_locale
+      if locale = params[:locale].presence
+        locale if Fizzy.locale?(locale)
+      end
+    end
+
+    def remembered_locale
+      if locale = session[:locale] || cookies[:locale]
+        locale if Fizzy.locale?(locale)
+      end
+    end
+
+    def identity_locale
+      if identity = Current.identity
+        identity.locale if Fizzy.locale?(identity.locale)
+      end
+    end
+
+    def remember_locale
+      session[:locale] = requested_locale
+      cookies.permanent[:locale] = { value: requested_locale, same_site: :lax }
+
+      if identity = Current.identity
+        identity.update(locale: requested_locale) unless identity.locale == requested_locale
+      end
+    end
+end
