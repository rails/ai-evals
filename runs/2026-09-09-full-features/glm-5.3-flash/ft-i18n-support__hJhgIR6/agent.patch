diff --git a/tmpwork/extract.rb b/tmpwork/extract.rb
new file mode 100644
index 0000000..3e4261b
--- /dev/null
+++ b/tmpwork/extract.rb
@@ -0,0 +1,47 @@
+# Extract candidate user-facing English strings.
+strings = Hash.new { |h, k| h[k] = [] }
+
+ERB_FILES = Dir["app/views/**/*.erb"] + Dir["saas/app/views/**/*.erb"]
+RB_FILES  = Dir["app/controllers/**/*.rb"] + Dir["app/helpers/**/*.rb"] + Dir["app/mailers/**/*.rb"] + Dir["app/models/**/*.rb"] + Dir["lib/**/*.rb"] + Dir["saas/app/**/*.rb"]
+
+def add(strings, s, f)
+  s = s.strip
+  return if s.empty?
+  return unless s.match?(/[A-Za-z]/)
+  strings[s] << f
+end
+
+ERB_FILES.each do |f|
+  src = File.read(f)
+  src.split(/(<%.*?%>)/m).each_with_index do |chunk, i|
+    if i.odd?
+      # ERB code: extract quoted strings
+      chunk.scan(/"((?:[^"\\]|\\.)*)"|'((?:[^'\\]|\\.)*)'/m) do |m|
+        s = m[0] || m[1]
+        next unless s
+        next if s.match?(/[\s]/) == false && s.length > 3  # single word long? keep anyway
+        add(strings, s, f)
+      end
+    else
+      chunk.scan(/>([^<>]*?)</m) do |m|
+        add(strings, m[0], f)
+      end
+      chunk.scan(/\b(aria-label|aria-description|title|placeholder|alt|label|data-confirm|value)\s*=\s*"([^"]*)"/) do |m|
+        add(strings, m[1], f)
+      end
+    end
+  end
+end
+
+RB_FILES.each do |f|
+  src = File.read(f)
+  src.scan(/"((?:[^"\\]|\\.)*)"|'((?:[^'\\]|\\.)*)'/m) do |m|
+    s = m[0] || m[1]
+    next unless s
+    add(strings, s, f)
+  end
+end
+
+strings = strings.select { |k, v| k.length >= 2 }
+puts "unique: #{strings.size}"
+strings.sort_by { |k, v| [-v.size, k] }.each { |k, v| puts "#{k.inspect}\t#{v.uniq.join(",")}" }
