+ENTITIES = {
+  "&nbsp;" => "\u00A0", "&gt;" => ">", "&lt;" => "<", "&amp;" => "&",
+  "&middot;" => "\u00B7", "&larr;" => "\u2190", "&rarr;" => "\u2192", "&hellip;" => "\u2026"
+}
+
+# English text as it appears in the source -> canonical (entity-unescaped) English
+def unescape_entities(s)
+  s.gsub(/&(?:nbsp|gt|lt|amp|middot|larr|rarr|hellip);/) { |e| ENTITIES[e] }
+end
+
+# I18n keys must not contain "." (the key separator)
+def key_for(english)
+  unescape_entities(english).delete(".").strip
+end
+
+def load_dict(path = "tmpwork/ja.txt")
+  dict = {}
+  File.readlines(path).map(&:strip).reject(&:empty?).each do |line|
+    english, japanese = line.split("|||", 2)
+    abort "Bad line: #{line.inspect}" unless japanese
+    english = english.strip
+    japanese = japanese.strip
+    dict[english] = japanese
+  end
+  dict
+end
+
+def key_conflicts(dict)
+  keys = Hash.new { |h, k| h[k] = [] }
+  dict.each_key { |e| keys[key_for(e)] << e }
+  keys.select { |k, v| v.uniq.size > 1 }
+end
diff --git a/tmpwork/lits.rb b/tmpwork/lits.rb
new file mode 100644
index 0000000..6dc0f38
--- /dev/null
+++ b/tmpwork/lits.rb
@@ -0,0 +1,18 @@
+texts = Hash.new { |h, k| h[k] = [] }
+ERB = Dir["app/views/**/*.erb"]
+RB = Dir["app/controllers/**/*.rb"] + Dir["app/helpers/**/*.rb"] + Dir["app/mailers/**/*.rb"] + Dir["app/models/**/*.rb"] + Dir["app/jobs/**/*.rb"]
+
+def natural?(s)
+  return false if s.match?(/[->_\/=#{}`\[\]{}$@\\]/)
+  return false if s.match?(/\A[a-z0-9_.\-]+\z/)
+  s.match?(/[A-Za-z]/) && s.length >= 2
+end
+
+(ERB + RB).each do |f|
+  File.read(f).scan(/"((?:[^"\\]|\\.)*)"|'((?:[^'\\]|\\.)*)'/m) do |m|
+    s = (m[0] || m[1]).to_s
+    next unless natural?(s)
+    (texts[s] << f)
+  end
+end
+texts.sort_by { |k, v| [-v.size, k] }.each { |k, v| puts "#{k}\t||| #{v.uniq.join(",")}" }
