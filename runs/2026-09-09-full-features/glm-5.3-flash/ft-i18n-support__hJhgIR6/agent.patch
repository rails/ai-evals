diff --git a/tmpwork/generate.rb b/tmpwork/generate.rb
new file mode 100644
index 0000000..56433b1
--- /dev/null
+++ b/tmpwork/generate.rb
@@ -0,0 +1,84 @@
+require_relative "lib"
+require_relative "instructions"
+require_relative "calendar"
+
+dict = load_dict
+
+entries = {}
+conflicts = []
+dict.each do |english, japanese|
+  key = key_for(english)
+  if entries.key?(key) && entries[key][:en] != unescape_entities(english)
+    conflicts << [ key, entries[key][:en], english ]
+  end
+  entries[key] ||= { en: unescape_entities(english), ja: japanese }
+end
+abort "Key conflicts:\n#{conflicts.map(&:inspect).join("\n")}" if conflicts.any?
+
+flat_en = {}
+flat_ja = {}
+entries.each do |key, values|
+  flat_en[key] = values[:en]
+  flat_ja[key] = values[:ja]
+end
+
+INSTRUCTIONS.each do |key, values|
+  namespace = key.split(".")
+  sub_en, sub_ja = flat_en, flat_ja
+  namespace[0..-2].each do |part|
+    sub_en[part] ||= {}
+    sub_ja[part] ||= {}
+    sub_en = sub_en[part]
+    sub_ja = sub_ja[part]
+  end
+  sub_en[namespace.last] = values[:en]
+  sub_ja[namespace.last] = values[:ja]
+end
+
+PLURALS.each do |key, values|
+  namespace = key.split(".")
+  sub_en, sub_ja = flat_en, flat_ja
+  namespace[0..-2].each do |part|
+    sub_en[part] ||= {}
+    sub_ja[part] ||= {}
+    sub_en = sub_en[part]
+    sub_ja = sub_ja[part]
+  end
+  sub_en[namespace.last] = values[:en]
+  sub_ja[namespace.last] = values[:ja]
+end
+
+def emit_yaml(locale, flat, calendar)
+  body = flat.sort_by { |k, _| k.downcase }
+  calendar.each do |key, value|
+    body << [ key, value ]
+  end
+
+  header = <<~HEADER
+    # Translations for Fizzy.
+    #
+    # Most keys are the English strings they replace, with the "." characters
+    # removed because I18n reserves them for scoping. Keys under `instructions`
+    # contain markup and are named with Rails' `_html` convention.
+  HEADER
+
+  header + "#{locale}:\n" + dump(body.to_h, 2)
+end
+
+def dump(hash, indent)
+  pad = " " * indent
+  hash.map do |key, value|
+    if value.is_a?(Hash)
+      "#{pad}#{key.inspect}:\n#{dump(value, indent + 2)}"
+    elsif value.is_a?(Array)
+      items = value.map { |item| item.nil? ? "~" : item.is_a?(Symbol) ? ":#{item}" : item.to_s.inspect }
+      "#{pad}#{key.inspect}: [#{items.join(", ")}]\n"
+    else
+      "#{pad}#{key.inspect}: #{value.is_a?(Symbol) ? ":#{value}" : value.to_s.inspect}\n"
+    end
+  end.join
+end
+
+File.write("config/locales/en.yml", emit_yaml(:en, flat_en, CALENDAR["en"]))
+File.write("config/locales/ja.yml", emit_yaml(:ja, flat_ja, CALENDAR["ja"]))
+puts "keys: #{flat_en.size} + calendar"
