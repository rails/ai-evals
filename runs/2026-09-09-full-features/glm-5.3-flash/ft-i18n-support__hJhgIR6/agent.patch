diff --git a/tmpwork/patch3.rb b/tmpwork/patch3.rb
new file mode 100644
index 0000000..d89a209
--- /dev/null
+++ b/tmpwork/patch3.rb
@@ -0,0 +1,30 @@
+p = "tmpwork/repair.rb"
+s = File.read(p)
+old = "    bytes = unmangle(line)\n    text, slots = rebuild(bytes)\n    next text if slots.empty?\n"
+new = "    bytes = unmangle(line)\n    text, slots = rebuild(bytes)\n    has_newline = line.end_with?(NEWLINE)\n    text += NEWLINE if has_newline && !text.end_with?(NEWLINE)\n    text = patch_text(text, slots, known, frequency, choices, index) unless slots.empty?\n"
+abort "no match" unless s.include?(old)
+s = s.sub(old, new)
+old2 = "    text = rebuild(bytes).first\n    text += NEWLINE if line.end_with?(NEWLINE) && !text.end_with?(NEWLINE)\n    text\n"
+new2 = "    text\n"
+abort "no match 2" unless s.include?(old2)
+s = s.sub(old2, new2)
+helper = <<'RUBY'
+# Re-guesses the lost bytes in an already repaired line of text.
+def patch_text(text, slots, known, frequency, choices, index)
+  bytes = unmangle(text)
+  slots.reverse.each_with_index do |slot, reverse_index|
+    number = slots.size - 1 - reverse_index
+    options = candidates(bytes, slot)
+    winner = options.select { |characters| characters.each_char.all? { |c| known.include?(c) } }
+                   .max_by { |characters| characters.each_char.sum { |c| frequency[c].to_i } }
+    winner ||= choices.dig(index, number) && options[choices.dig(index, number)]
+    next unless winner
+    position = options.index(winner)
+    bytes.insert(slot[:lead] + 1 + position, LOST)
+  end
+  rebuild(bytes).first
+end
+
+RUBY
+s = s.sub("def repair_lines(lines, choices = {})", helper + "def repair_lines(lines, choices = {})")
+File.write(p, s)
diff --git a/tmpwork/patch4.rb b/tmpwork/patch4.rb
new file mode 100644
index 0000000..dd97130
--- /dev/null
+++ b/tmpwork/patch4.rb
@@ -0,0 +1,36 @@
+p = "tmpwork/repair.rb"
+s = File.read(p)
+marker_start = s.index("def repair_lines(lines, choices = {})")
+marker_end = s.index("if __FILE__ == $PROGRAM_NAME")
+abort "markers" unless marker_start && marker_end
+new = <<'RUBY'
+def repair_lines(lines, choices = {})
+  # Every character that decodes cleanly anywhere in the corpus is fair game.
+  corpus = lines.flat_map { |line| unmangle(line).pack("C*").scrub.each_char.to_a }
+  known = corpus.to_set
+  frequency = corpus.tally
+
+  lines.map.with_index do |line, index|
+    bytes = unmangle(line)
+    text, slots = rebuild(bytes)
+
+    unless slots.empty?
+      slots.each_with_index.reverse_each do |slot, number|
+        options = candidates(bytes, slot)
+        winner = options.select { |characters| characters.each_char.all? { |c| known.include?(c) } }
+                       .max_by { |characters| characters.each_char.sum { |c| frequency[c].to_i } }
+        winner ||= choices.dig(index, number) && options[choices.dig(index, number)]
+        next unless winner
+        bytes.insert(slot[:lead] + 1 + options.index(winner), LOST)
+      end
+      text = rebuild(bytes).first
+    end
+
+    text += NEWLINE if line.end_with?(NEWLINE) && !text.end_with?(NEWLINE)
+    text
+  end
+end
+
+RUBY
+s = s[0...marker_start] + new + s[marker_end..]
+File.write(p, s)
diff --git a/tmpwork/patch5.rb b/tmpwork/patch5.rb
new file mode 100644
index 0000000..738b7d9
--- /dev/null
+++ b/tmpwork/patch5.rb
@@ -0,0 +1,15 @@
+p = "tmpwork/repair.rb"
+s = File.read(p)
+marker_start = s.index("if __FILE__ == $PROGRAM_NAME")
+new = <<'RUBY'
+if __FILE__ == $PROGRAM_NAME
+  require_relative "choices"
+  fixed = repair_lines(File.readlines(ARGV[0]), CHOICES)
+  bad = fixed.each_with_index.select { |line, _| !line.valid_encoding? }
+  abort "still invalid: #{bad.map(&:last).join(",")}" unless bad.empty?
+  File.write(ARGV[0], fixed.join)
+  puts "repaired #{ARGV[0]}: #{fixed.size} lines"
+end
+RUBY
+s = s[0...marker_start] + new
+File.write(p, s)
