diff --git a/tmpwork/verify.rb b/tmpwork/verify.rb
new file mode 100644
index 0000000..7d716aa
--- /dev/null
+++ b/tmpwork/verify.rb
@@ -0,0 +1,34 @@
+# Verify every translation key used in the code exists in both locale files,
+# and that en/ja have the same key tree.
+require "yaml"
+
+def flatten(hash, prefix = "")
+  hash.flat_map do |key, value|
+    path = prefix.empty? ? key : "#{prefix}.#{key}"
+    value.is_a?(Hash) ? flatten(value, path) : [ path ]
+  end
+end
+
+en = YAML.load_file("config/locales/en.yml")["en"]
+ja = YAML.load_file("config/locales/ja.yml")["ja"]
+
+en_keys = flatten(en).sort
+ja_keys = flatten(ja).sort
+
+puts "en keys: #{en_keys.size}, ja keys: #{ja_keys.size}"
+puts "missing in ja: #{(en_keys - ja_keys).inspect}" if (en_keys - ja_keys).any?
+puts "missing in en: #{(ja_keys - en_keys).inspect}" if (ja_keys - en_keys).any?
+
+used = {}
+files = Dir["app/views/**/*.erb"] + Dir["app/controllers/**/*.rb"] + Dir["app/helpers/**/*.rb"] +
+        Dir["app/mailers/**/*.rb"] + Dir["app/models/**/*.rb"] + Dir["app/jobs/**/*.rb"] + Dir["lib/**/*.rb"]
+files.each do |f|
+  src = File.read(f)
+  src.scan(/\bt\(\s*"((?:[^"\\]|\\.)*)"/) { |m| used[m[0].gsub('\\"', '"')] = [] << f }
+end
+
+missing = used.keys.reject { |k| en.key?(k) || en_keys.include?(k) || en.dig(*k.split(".")) }
+puts "keys used in code: #{used.size}"
+bad = used.keys.select { |k| !en_keys.include?(k) }
+puts "used but missing from locales: #{bad.size}"
+bad.each { |k| puts "  #{k.inspect}" }
