+def edit(path, replacements)
+  src = File.read(path)
+  replacements.each do |old, new|
+    abort "#{path}: not found:\n#{old}" unless src.include?(old)
+    src = src.sub(old, new)
+  end
+  File.write(path, src)
+  puts "edited #{path}"
+end
