+strings = Hash.new { |h, k| h[k] = [] }
+
+ERB_FILES = Dir["app/views/**/*.erb"] + Dir["saas/app/views/**/*.erb"]
+RB_FILES  = Dir["app/controllers/**/*.rb"] + Dir["app/helpers/**/*.rb"] + Dir["app/mailers/**/*.rb"] + Dir["app/models/**/*.rb"] + Dir["lib/**/*.rb"] + Dir["saas/app/**/*.rb"]
+
+def add(strings, s, f)
+  s = s.to_s.strip
+  return if s.empty? || s.length < 2
+  return unless s.match?(/[A-Za-z]/)
+  strings[s] << f
+end
+
+def natural?(s)
+  return false if s.match?(/[->_\/=#{}`\[\]{}]/)
+  return false if s.match?(/\b(btn|icon|txt|flex|gap|full|width|hide|on|off|native|touch|true|false)\b/)
+  return false if s.match?(/^[a-z]/) && !s.include?(" ")
+  s.include?(" ") && s.match?(/[A-Za-z]/)
+end
+
+ERB_FILES.each do |f|
+  src = File.read(f)
+  src.split(/(<%.*?%>)/m).each_with_index do |chunk, i|
+    if i.odd?
+      chunk.scan(/"((?:[^"\\]|\\.)*)"|'((?:[^'\\]|\\.)*)'/m) do |m|
+        s = m[0] || m[1]
+        next unless s
+        add(strings, s, f) if natural?(s)
+      end
+    else
+      chunk.scan(/>([^<>]*?)</m) do |m|
+        add(strings, m[0], f)
+      end
+      chunk.scan(/\b(aria-label|aria-description|title|placeholder|alt|label|data-confirm|value)\s*=\s*"([^"]*)"/) do |m|
+        add(strings, m[1], f)
+      end
+    end
+  end
+end
+
+RB_FILES.each do |f|
+  src = File.read(f)
+  src.scan(/"((?:[^"\\]|\\.)*)"|'((?:[^'\\]|\\.)*)'/m) do |m|
+    s = m[0] || m[1]
+    next unless s
+    add(strings, s, f) if natural?(s)
+  end
+end
+
+strings = strings.select { |k, v| k.length >= 2 }
+puts "unique: #{strings.size}"
+strings.sort_by { |k, v| [-v.size, k] }.each { |k, v| puts "#{k.inspect}\t#{v.uniq.join(",")}" }
