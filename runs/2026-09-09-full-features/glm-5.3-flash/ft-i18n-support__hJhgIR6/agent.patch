diff --git a/lib/fizzy.rb b/lib/fizzy.rb
index e009c8f..38d2654 100644
--- a/lib/fizzy.rb
+++ b/lib/fizzy.rb
@@ -1,5 +1,13 @@
 module Fizzy
+  # Locales Fizzy speaks, keyed by locale code with the name we show people.
+  LOCALES = { "en" => "English", "ja" => "日本語" }.freeze
+
   class << self
+    # Whether we offer the given locale, so unknown ones can be ignored.
+    def locale?(code)
+      LOCALES.key?(code.to_s)
+    end
+
     def saas?
       return @saas if defined?(@saas)
       @saas = !!(((ENV["SAAS"] || File.exist?(File.expand_path("../tmp/saas.txt", __dir__))) && ENV["SAAS"] != "false"))
