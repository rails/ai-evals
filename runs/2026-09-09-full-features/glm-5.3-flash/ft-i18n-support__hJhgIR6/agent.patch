diff --git a/tmpwork/leftover.rb b/tmpwork/leftover.rb
new file mode 100644
index 0000000..05cf4f5
--- /dev/null
+++ b/tmpwork/leftover.rb
@@ -0,0 +1,28 @@
+require_relative "lib"
+
+# Report English text that is still hardcoded in views.
+dict = load_dict
+report = Hash.new { |h, k| h[k] = [] }
+Dir["app/views/**/*.erb"].each do |f|
+  src = File.read(f)
+  chunks = src.split(/(<%.*?%>)/m)
+  chunks.each_with_index do |chunk, i|
+    if i.odd?
+      next
+      # code chunk leftovers checked elsewhere
+    else
+      part = chunk.gsub(/(<style[^>]*>.*?<\/style>|<script[^>]*>.*?<\/script>)/m) { "" }
+      part.scan(/>([^<>]*)</m) do |m|
+        body = m[0]
+        s = body.strip
+        next if s.empty? || !s.match?(/[A-Za-z]/)
+        next if s.match?(/\A\W+\z/)
+        report[s] << "#{f}: #{body.inspect}"
+      end
+    end
+  end
+end
+report.sort_by { |k, v| k }.each do |s, locs|
+  next if s.length < 2
+  puts "#{s.inspect}\n    #{locs.uniq.join("\n    ")}"
+end
