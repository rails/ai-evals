diff --git a/tmpwork/repair.rb b/tmpwork/repair.rb
new file mode 100644
index 0000000..4969633
--- /dev/null
+++ b/tmpwork/repair.rb
@@ -0,0 +1,119 @@
+# Repairs text that lost its way in transit: every non-ASCII byte was re-encoded
+# as the equivalent Latin-1 character, while NBSP became a space and C1 control
+# bytes turned into tabs, newlines, spaces or disappeared entirely.
+SUSPECTS = [ 0x09, 0x0A, 0x20 ].freeze
+
+def unmangle(line)
+  bytes = line.dup.force_encoding("BINARY").bytes
+  orig = []
+  i = 0
+  while i < bytes.size
+    b = bytes[i]
+    if (b == 0xC2 || b == 0xC3) && bytes[i + 1] && bytes[i + 1] >= 0x80
+      orig << bytes[i, 2].pack("C*").force_encoding("UTF-8").ord
+      i += 2
+    else
+      orig << b
+      i += 1
+    end
+  end
+  orig
+end
+
+# Rebuilds valid UTF-8 and reports the sequences where a byte went missing.
+def rebuild(bytes)
+  out = []
+  slots = []
+  need = 0
+  lead = nil
+  i = 0
+  while i < bytes.size
+    b = bytes[i]
+    if need > 0
+      if b >= 0x80 && b < 0xC0
+        out << b
+        need -= 1
+      elsif SUSPECTS.include?(b)
+        slots << { lead: lead, at: i, replace: true }
+        out << 0x85
+        need -= 1
+      else
+        slots << { lead: lead, at: i, replace: false }
+        out << 0x85
+        need -= 1
+        next
+      end
+    elsif b == 0xA0
+      out += [ 0xC2, 0xA0 ] # an orphan NBSP: its lead byte went missing
+      lead = i
+      need = 0
+    else
+      out << b
+      lead = i
+      need = b < 0xC0 ? 0 : b < 0xE0 ? 1 : b < 0xF0 ? 2 : 3
+    end
+    i += 1
+  end
+  slots << { lead: lead, at: bytes.size, replace: false } if need > 0
+  [ out.pack("C*").force_encoding("UTF-8"), slots ]
+end
+
+def char_length(first_byte)
+  first_byte < 0xC0 ? 0 : first_byte < 0xE0 ? 1 : first_byte < 0xF0 ? 2 : 3
+end
+
+# A lost byte is always in the C1/NBSP neighbourhood, so its value has to be
+# guessed from the rest of the text.
+def candidates(bytes, slot)
+  (0x80..0xA0).filter_map do |byte|
+    modified = bytes.dup
+    if slot[:replace]
+      modified[slot[:at]] = byte
+    else
+      modified.insert(slot[:at], byte)
+    end
+    length = char_length(modified[slot[:lead]])
+    next if length.zero?
+    character = modified[slot[:lead], length + 1].pack("C*").force_encoding("UTF-8")
+    next unless character.valid_encoding? && character.each_char.one?
+    { replace: slot[:replace], index: slot[:at], byte: byte, char: character }
+  end
+end
+
+def repair_lines(lines, choices = {})
+  corpus = lines.flat_map { |line| unmangle(line).pack("C*").force_encoding("UTF-8").scrub.each_char.to_a }
+  known = corpus.to_set
+  frequency = corpus.tally
+
+  lines.map.with_index do |line, index|
+    bytes = unmangle(line)
+    text, slots = rebuild(bytes)
+
+    unless slots.empty?
+      slots.each_with_index.reverse_each do |slot, number|
+        winner = candidates(bytes, slot).select { |option| known.include?(option[:char]) }
+                                        .max_by { |option| frequency[option[:char]].to_i }
+        winner ||= choices.dig(index, number)
+        if winner
+          if winner[:replace]
+            bytes[slot[:at]] = winner[:byte]
+          else
+            bytes.insert(winner[:index], winner[:byte])
+          end
+        end
+      end
+      text = rebuild(bytes).first
+    end
+
+    text += "\n" if line.end_with?("\n") && !text.end_with?("\n")
+    text
+  end
+end
+
+if __FILE__ == $PROGRAM_NAME
+  fixed = repair_lines(File.readlines(ARGV[0]))
+  bad = fixed.each_with_index.select { |line, _| !line.valid_encoding? }
+  abort "still invalid: #{bad.map(&:last).join(",")}" unless bad.empty?
+  File.write(ARGV[0], fixed.join)
+  puts "repaired #{ARGV[0]}: #{fixed.size} lines"
+end
diff --git a/tmpwork/rewrite.rb b/tmpwork/rewrite.rb
new file mode 100644
index 0000000..822cc29
--- /dev/null
+++ b/tmpwork/rewrite.rb
@@ -0,0 +1,78 @@
+require_relative "lib"
+
+dict = load_dict
+key_by_english = dict.keys.to_h { |e| [ e, key_for(e) ] }
+
+def key_literal(key) = key.inspect
+def t_tag(key) = "<%= t(#{key_literal(key)}) %>"
+def t_call(key) = "t(#{key_literal(key)})"
+
+LITERAL_PREFIXES = [
+  /\b(?:link_to|button_to)\s+/,
+  /\b(?:form\.)?submit\s+/,
+  /(?:\A|[{,\s])(?:placeholder|title|alt|aria_label|label|confirm|notice|alert|subject|description)\s*:\s*/,
+  /@page_title\s*=\s*/,
+  /flash\[:[a-z_]+\]\s*=\s*/,
+  /\btag\.[a-z_]+\s+/,
+].freeze
+
+SKIP_BLOCK = /(<style[^>]*>.*?<\/style>|<script[^>]*>.*?<\/script>)/m
+
+def rewrite_code(code, dict, key_by_english)
+  LITERAL_PREFIXES.reduce(code) do |result, prefix|
+    result.gsub(/(#{prefix})"((?:[^"\\]|\\.)*)"/) do
+      head, literal = Regexp.last_match(1), Regexp.last_match(2)
+      english = unescape_entities(literal.gsub('\\"', '"'))
+      if dict.key?(english)
+        "#{head}#{t_call(key_by_english[english])}"
+      else
+        "#{head}\"#{literal}\""
+      end
+    end
+  end
+end
+
+def rewrite_text(text, dict, key_by_english)
+  parts = text.split(SKIP_BLOCK)
+  parts.each_with_index.map do |part, i|
+    next part if i.odd?
+    part.gsub(/>([^<>]*)</) do
+      whole, body = Regexp.last_match(0), Regexp.last_match(1)
+      lead = body[/\A\s*/]
+      trail = body[/\s*\z/]
+      english = body.strip
+      next whole if english.empty?
+      next whole if body != lead + english + trail # irregular spacing, handle by hand
+      next whole unless dict.key?(english)
+      canonical = dict.keys.find { |e| unescape_entities(e).strip == unescape_entities(english) }
+      if canonical
+        i = whole.index(body)
+        whole[0...i] + lead + t_tag(key_by_english[canonical]) + trail + whole[(i + body.length)..]
+      else
+        whole
+      end
+    end
+  end.join
+end
+
+used = {}
+files = ARGV[0] == "--all" ? Dir["app/views/**/*.erb"] + Dir["saas/app/views/**/*.erb"] : ARGV
+files.each do |file|
+  src = File.read(file)
+  chunks = src.split(/(<%.*?%>)/m)
+  out = chunks.each_with_index.map do |chunk, i|
+    if i.odd?
+      new_code = rewrite_code(chunk, dict, key_by_english)
+      new_code.scan(/t\("((?:[^"\\]|\\.)*)"/) { |m| used[m[0].gsub('\\"', '"')] = true }
+      new_code
+    else
+      new_text = rewrite_text(chunk, dict, key_by_english)
+      new_text.scan(/t\("((?:[^"\\]|\\.)*)"/) { |m| used[m[0].gsub('\\"', '"')] = true }
+      new_text
+    end
+  end.join
+  File.write(file, out) unless out == src
+end
+
+puts "keys used: #{used.size}"
+File.write("tmpwork/used_keys.json", JSON.pretty_generate(used.keys.sort))
diff --git a/tmpwork/scan.rb b/tmpwork/scan.rb
new file mode 100644
index 0000000..9602618
--- /dev/null
+++ b/tmpwork/scan.rb
@@ -0,0 +1,13 @@
+texts = Hash.new { |h,k| h[k] = [] }
+Dir["app/views/**/*.erb"].each do |f|
+  File.read(f).split(/(<%.*?%>)/m).each_with_index do |chunk, i|
+    next if i.odd?
+    chunk.scan(/>([^<>]*?)</m).each do |m|
+      s = m[0].to_s.strip
+      next if s.empty? || !s.match?(/[A-Za-z]/)
+      (texts[s] << f) 
+    end
+  end
+end
+puts "unique: #{texts.size}"
+texts.sort_by { |k, v| [-v.size, k] }.each { |k, v| puts "#{v.size}\t#{k.inspect}\t#{v.uniq.size}" }
