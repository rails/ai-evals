diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..1417622
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,51 @@
+class ZipFile::Reader
+  CHUNK_SIZE = 1.megabyte
+
+  class MissingEntry < StandardError; end
+
+  class UnreadableArchive < StandardError; end
+
+  attr_reader :entries
+
+  # The IO must be seekable, which is what ActiveStorage hands out when a blob
+  # is opened for reading. Entries are read one at a time, so archives of any
+  # size can be consumed without buffering their contents in memory.
+  def initialize(io)
+    @io = io
+    @entries = ZipKit::FileReader.read_zip_structure(io: io).index_by(&:filename)
+  rescue ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::ReadError => error
+    raise UnreadableArchive, "This archive can't be read (#{error.message})"
+  end
+
+  def exists?(path)
+    entries.key?(path)
+  end
+
+  def glob(pattern)
+    entries.keys.select { |entry| File.fnmatch(pattern, entry) }.sort
+  end
+
+  def read(path)
+    contents = +""
+
+    open(path) { |chunk| contents << chunk }
+    contents
+  end
+
+  def read_json(path)
+    JSON.parse(read(path))
+  end
+
+  def open(path)
+    entry = entries.fetch(path) { raise MissingEntry, "No entry #{path.inspect} in the archive" }
+    extractor = entry.extractor_from(@io)
+
+    return enum_for(__method__, path) unless block_given?
+
+    until extractor.eof?
+      if chunk = extractor.extract(CHUNK_SIZE)
+        yield chunk
+      end
+    end
+  end
+end
