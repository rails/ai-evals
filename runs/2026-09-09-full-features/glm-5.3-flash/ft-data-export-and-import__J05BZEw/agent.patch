index 0000000..2e03a06
--- /dev/null
+++ b/test/controllers/account/imports_controller_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class Account::ImportsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "new" do
+    get new_account_import_path
+    assert_response :success
+  end
+
+  test "create" do
+    assert_difference "Import.count" do
+      post account_imports_path, params: {
+        import: { file: fixture_file_upload("moon.jpg", "image/jpeg") }
+      }
+    end
+
+    import = Import.last
+    assert_equal users(:kevin), import.user
+    assert import.pending?
+    assert import.file.attached?
+    assert_redirected_to account_settings_path
+
+    assert_enqueued_with job: Account::DataTransfer::ImportJob do
+      import.process_later
+    end
+  end
+
+  test "create without a file" do
+    assert_no_difference "Import.count" do
+      post account_imports_path, params: { import: { file: "" } }
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "create performs the import and emails the result" do
+    export = Export.start(users(:kevin), kind: :account)
+    export.process_now
+
+    post account_imports_path, params: {
+      import: { file: file_with_content("account.zip", export.file.download) }
+    }
+    assert_enqueued_emails 1 do
+      perform_enqueued_jobs only: Account::DataTransfer::ImportJob
+    end
+
+    import = Import.last
+    assert import.reload.completed?, import.error
+    assert_not_nil import.imported_account
+  end
+
+  private
+    def file_with_content(filename, contents)
+      Rack::Test::UploadedFile.new(StringIO.new(contents), "application/zip", original_filename: filename)
+    end
+end
