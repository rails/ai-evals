diff --git a/app/models/account/data_transfer/cards_scope.rb b/app/models/account/data_transfer/cards_scope.rb
new file mode 100644
index 0000000..4ddfecf
--- /dev/null
+++ b/app/models/account/data_transfer/cards_scope.rb
@@ -0,0 +1,148 @@
+# Narrows an export down to the cards a person can see, plus everything those
+# cards depend on: their boards, columns, comments, steps, tags, reactions,
+# events and attachments. The rest of the account stays behind, so nobody gets
+# to read anything they couldn't read in Fizzy either.
+class Account::DataTransfer::CardsScope
+  # Record sets that are part of an export of the cards a person can see, and
+  # the records each of them is scoped down to.
+  SCOPED_MODELS = {
+    ::Card => :cards,
+    ::Comment => :comments,
+    ::Board => :boards,
+    ::Column => :columns,
+    ::Tag => :tags,
+    ::Entropy => :entropies,
+    ::Access => :accesses,
+    ::User => :users,
+    ::User::Settings => :user_settings,
+    ::Identity => :identities,
+    ::ActionText::RichText => :rich_texts,
+    ::ActiveStorage::Attachment => :attachments,
+    ::ActiveStorage::Blob => :blobs,
+    ::ActiveStorage::VariantRecord => :variant_records
+  }.freeze
+
+  # Records that hang directly off a card.
+  CARD_DEPENDENT_MODELS = [
+    ::Step, ::Assignment, ::Tagging, ::Closure, ::Card::Goldness, ::Card::NotNow,
+    ::Card::ActivitySpike, ::Watch, ::Pin, ::Notification
+  ].freeze
+
+  # Records that hang off a card through a polymorphic association.
+  POLYMORPHIC_MODELS = {
+    ::Reaction => :reactable,
+    ::Mention => :source,
+    ::Event => :eventable
+  }.freeze
+
+  MODELS = [ ::Account, *SCOPED_MODELS.keys, *CARD_DEPENDENT_MODELS, *POLYMORPHIC_MODELS.keys ].freeze
+
+  def initialize(account, cards)
+    @account = account
+    @cards = cards
+  end
+
+  def include?(model)
+    MODELS.include?(model)
+  end
+
+  def records_for(model)
+    if scope = SCOPED_MODELS[model]
+      send(scope)
+    elsif CARD_DEPENDENT_MODELS.include?(model)
+      card_dependents(model)
+    elsif association = POLYMORPHIC_MODELS[model]
+      polymorphic_dependents(model, association)
+    else
+      model.none
+    end
+  end
+
+  private
+    attr_reader :account, :cards
+
+    def comments
+      Comment.where(account_id: account.id, card_id: cards)
+    end
+
+    def boards
+      account.boards.where(id: cards.select(:board_id))
+    end
+
+    def columns
+      account.columns.where(board_id: boards)
+    end
+
+    def tags
+      account.tags.where(id: taggings.select(:tag_id))
+    end
+
+    def entropies
+      Entropy.where(account_id: account.id, container_type: "Board", container_id: boards)
+        .or(Entropy.where(account_id: account.id, container: account))
+    end
+
+    def accesses
+      Access.where(account_id: account.id, board_id: boards)
+    end
+
+    def users
+      # Everyone on the account is visible to everyone on the account.
+      account.users
+    end
+
+    def user_settings
+      User::Settings.where(account_id: account.id)
+    end
+
+    def identities
+      Identity.where(id: account.users.select(:identity_id))
+    end
+
+    def taggings
+      Tagging.where(account_id: account.id, card_id: cards)
+    end
+
+    def rich_texts
+      account_rich_texts.where(record_type: "Card", record_id: cards)
+        .or(account_rich_texts.where(record_type: "Comment", record_id: comments))
+    end
+
+    def attachments
+      account_attachments.where(record_type: "Card", record_id: cards)
+        .or(account_attachments.where(record_type: "ActionText::RichText", record_id: rich_texts))
+    end
+
+    def blobs
+      account_blobs.where(id: attachments.select(:blob_id)).where.not(id: internal_blob_ids)
+    end
+
+    def variant_records
+      ActiveStorage::VariantRecord.where(account_id: account.id, blob_id: blobs)
+    end
+
+    def card_dependents(model)
+      model.where(account_id: account.id, card_id: cards)
+    end
+
+    def polymorphic_dependents(model, association)
+      model.where(account_id: account.id).where(association => cards)
+        .or(model.where(account_id: account.id).where(association => comments))
+    end
+
+    def internal_blob_ids
+      account_attachments.where(record_type: Account::DataTransfer::RecordSet::INTERNAL_RECORD_TYPES).select(:blob_id)
+    end
+
+    def account_rich_texts
+      ActionText::RichText.where(account_id: account.id)
+    end
+
+    def account_attachments
+      ActiveStorage::Attachment.where(account_id: account.id)
+    end
+
+    def account_blobs
+      ActiveStorage::Blob.where(account_id: account.id)
+    end
+end
