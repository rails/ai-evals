diff --git a/test/mailers/account_mailer_test.rb b/test/mailers/account_mailer_test.rb
index 8d41ddf..e699ea3 100644
--- a/test/mailers/account_mailer_test.rb
+++ b/test/mailers/account_mailer_test.rb
@@ -55,3 +55,65 @@ class AccountMailerTest < ActionMailer::TestCase
     assert_match /deleted/i, email.body.encoded
   end
 end
+
+class AccountMailerExportAndImportTest < ActionMailer::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @account = accounts(:"37s")
+  end
+
+  test "export ready" do
+    export = export_with_status(:completed)
+
+    email = AccountMailer.export_ready(export)
+
+    assert_equal [ export.user.identity.email_address ], email.to
+    assert_match export.account.name, email.body.encoded
+    assert_match "/exports/#{export.token}", email.body.encoded
+  end
+
+  test "export failed" do
+    export = export_with_status(:failed, error: "Boom")
+
+    email = AccountMailer.export_failed(export)
+
+    assert_equal [ export.user.identity.email_address ], email.to
+    assert_match "Boom", email.body.encoded
+  end
+
+  test "import completed" do
+    import = import_with_status(:completed, account_external_id: @account.external_account_id)
+
+    email = AccountMailer.import_completed(import)
+
+    assert_equal [ import.user.identity.email_address ], email.to
+    assert_match @account.name, email.body.encoded
+  end
+
+  test "import failed" do
+    import = import_with_status(:failed, error: "This file doesn't look like a Fizzy account export")
+
+    email = AccountMailer.import_failed(import)
+
+    assert_equal [ import.user.identity.email_address ], email.to
+    assert_match "doesn't look like a Fizzy account export", email.body.encoded
+  end
+
+  private
+    def import_with_status(status, account_external_id: nil, error: nil)
+      import = Import.new(user: users(:kevin))
+      import.file.attach(io: StringIO.new("zip"), filename: "account.zip", content_type: "application/zip")
+      import.save!
+      import.update!(status: status, account_external_id: account_external_id, error: error)
+
+      import
+    end
+
+    def export_with_status(status, error: nil)
+      export = Export.start(users(:kevin), kind: :account)
+      export.process_now if status == :completed
+      export.update!(status: status, error: error) if error
+
+      export
+    end
+end
diff --git a/test/models/account/data_transfer/export_test.rb b/test/models/account/data_transfer/export_test.rb
new file mode 100644
index 0000000..d1bc55a
--- /dev/null
+++ b/test/models/account/data_transfer/export_test.rb
@@ -0,0 +1,121 @@
+require "test_helper"
+
+class Account::DataTransfer::ExportTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @account = accounts(:"37s")
+    @card = cards(:logo)
+    @card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg")
+  end
+
+  test "exports the whole account as one archive" do
+    export = export_account_for(users(:jason))
+    export.process_now
+
+    assert export.reload.completed?
+    assert export.file.attached?
+    assert_equal "37signals-#{Date.current.iso8601}.zip", export.filename
+
+    with_archive(export) do |reader|
+      manifest = reader.read_json("manifest.json")
+      assert_equal Account::DataTransfer::Manifest::VERSION, manifest["version"]
+      assert_equal @account.name, manifest.dig("account", "name")
+
+      assert_equal @account.boards.count, reader.read_json("boards/000001.json").size
+      assert_equal Comment.where(account: @account).count, reader.read_json("comments/000001.json").size
+      assert_equal @account.users.count, reader.read_json("users/000001.json").size
+      assert_equal Identity.where(id: @account.users.select(:identity_id)).count, reader.read_json("identities/000001.json").size
+    end
+  end
+
+  test "export includes the contents of the files attached to cards" do
+    export = export_account_for(users(:jason))
+    export.process_now
+
+    contents = export.file.open { |io| ZipFile::Reader.new(io).read("files/#{@card.image.key}") }
+
+    assert_equal @card.image.download, contents
+  end
+
+  test "the archive is attached to the account it was exported from" do
+    export = export_account_for(users(:jason))
+
+    assert_equal @account, export.account
+
+    export.process_now
+
+    assert_equal @account.id, export.file.blob.account_id
+  end
+
+  test "exports only the cards the person can see" do
+    private_board = boards(:private)
+    secret_card = Card.create!(board: private_board, column: private_board.columns.first,
+      creator: users(:kevin), title: "Secret stuff", status: "published")
+
+    export = Export.start(users(:david), kind: :cards)
+    export.process_now
+
+    assert export.reload.completed?
+
+    with_archive(export) do |reader|
+      card_ids = reader.read_json("cards/000001.json").map { it["id"] }
+      board_ids = reader.read_json("boards/000001.json").map { it["id"] }
+
+      assert_equal users(:david).accessible_cards.count, card_ids.size
+      assert_includes card_ids, @card.id
+      assert_not_includes card_ids, secret_card.id
+
+      assert_includes board_ids, boards(:writebook).id
+      assert_not_includes board_ids, private_board.id
+
+      assert_empty reader.glob("webhooks/*.json")
+      assert_empty reader.glob("filters/*.json")
+    end
+  end
+
+  test "a completed export can be downloaded for a day" do
+    export = export_account_for(users(:jason))
+    export.process_now
+
+    assert export.reload.downloadable?
+    assert_not export.expired?
+    assert_in_delta Export::EXPIRES_AFTER.from_now, export.expires_at, 1.second
+
+    export.update!(expires_at: 1.minute.ago)
+
+    assert_not export.downloadable?
+    assert Export.expired.include?(export)
+  end
+
+  test "purging expired exports deletes them" do
+    export = export_account_for(users(:jason))
+    export.process_now
+    export.update!(expires_at: 1.minute.ago)
+
+    Export.purge_expired
+
+    assert_nil Export.find_by(id: export.id)
+  end
+
+  test "a failed export is marked as such and says why" do
+    export = export_account_for(users(:jason))
+    Account::DataTransfer::Manifest.any_instance.stubs(:write_to).raises(StandardError, "Boom")
+
+    export.process_now
+
+    assert export.reload.failed?
+    assert_equal "Boom", export.error
+    assert_not export.file.attached?
+  end
+
+  private
+    def export_account_for(user)
+      Export.start(user, kind: :account)
+    end
+
+    def with_archive(export)
+      export.file.open do |io|
+        yield ZipFile::Reader.new(io)
+      end
+    end
+end
diff --git a/test/models/account/data_transfer/import_test.rb b/test/models/account/data_transfer/import_test.rb
