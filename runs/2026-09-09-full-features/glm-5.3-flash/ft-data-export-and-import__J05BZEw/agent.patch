new file mode 100644
index 0000000..3a41fa1
--- /dev/null
+++ b/app/models/export.rb
@@ -0,0 +1,69 @@
+class Export < ApplicationRecord
+  EXPIRES_AFTER = 1.day
+
+  belongs_to :user
+  has_one_attached :file
+
+  has_secure_token :token
+
+  enum :kind, %w[ account cards ].index_by(&:itself), default: :account
+  enum :status, %w[ pending completed failed ].index_by(&:itself), default: :pending
+
+  scope :expired, -> { completed.where(expires_at: ...Time.current) }
+
+  class << self
+    def start(user, kind:)
+      create!(user: user, kind: kind)
+    end
+
+    def purge_expired
+      expired.find_each(&:destroy)
+    end
+
+    def purge_expired_later
+      Account::DataTransfer::PurgeExpiredExportsJob.perform_later
+    end
+  end
+
+  def process_later
+    Account::DataTransfer::ExportJob.perform_later(self)
+  end
+
+  def process_now
+    return if completed?
+
+    ZipFile.create_for(file, filename: filename) { |writer| manifest.write_to(writer) }
+    update!(status: :completed, expires_at: EXPIRES_AFTER.from_now)
+
+    AccountMailer.export_ready(self).deliver_later
+  rescue StandardError => error
+    update!(status: :failed, error: error.message)
+
+    AccountMailer.export_failed(self).deliver_later
+    Rails.error.report(error, context: { export_id: id, kind: kind })
+  end
+
+  def downloadable?
+    completed? && !expired?
+  end
+
+  def expired?
+    expires_at.present? && expires_at.past?
+  end
+
+  def account
+    user.account
+  end
+
+  def manifest
+    if cards?
+      Account::DataTransfer::Manifest.for_accessible_cards(account, user)
+    else
+      Account::DataTransfer::Manifest.for_account(account)
+    end
+  end
+
+  def filename
+    "#{account.name.parameterize}-#{Date.current.iso8601}.zip"
+  end
+end
diff --git a/app/models/import.rb b/app/models/import.rb
new file mode 100644
index 0000000..f26b366
--- /dev/null
+++ b/app/models/import.rb
@@ -0,0 +1,55 @@
+class Import < ApplicationRecord
+  belongs_to :user
+  has_one_attached :file
+
+  enum :status, %w[ pending completed failed ].index_by(&:itself), default: :pending
+
+  validates :file, presence: true
+
+  def process_later
+    Account::DataTransfer::ImportJob.perform_later(self)
+  end
+
+  def process_now
+    return if completed?
+
+    imported = import_account
+    reindex_search(imported)
+    reconcile_storage_for(imported)
+
+    update!(status: :completed, account_external_id: imported.external_account_id)
+
+    AccountMailer.import_completed(self).deliver_later
+  rescue StandardError => error
+    update!(status: :failed, error: error.message)
+
+    AccountMailer.import_failed(self).deliver_later
+    Rails.error.report(error, context: { import_id: id })
+  end
+
+  # The account the account file was brought into Fizzy from. The account it
+  # creates is only known once the import has completed.
+  def account
+    user.account
+  end
+
+  def imported_account
+    Account.find_by(external_account_id: account_external_id) if account_external_id
+  end
+
+  private
+    def import_account
+      file.open { |io| Account::DataTransfer::Importer.new(io).import }
+    end
+
+    # Records are inserted exactly as they were exported, so the search index
+    # has to be built from scratch.
+    def reindex_search(account)
+      account.cards.published.includes(:rich_text_description).find_each(&:reindex)
+      Comment.where(account: account).joins(:card).merge(Card.published).includes(:rich_text_body).find_each(&:reindex)
+    end
+
+    def reconcile_storage_for(account)
+      Storage::ReconcileJob.perform_later(account)
+    end
+end
