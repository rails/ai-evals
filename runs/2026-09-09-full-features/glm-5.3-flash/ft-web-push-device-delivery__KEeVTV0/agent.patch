diff --git a/app/views/pwa/service_worker.js.erb b/app/views/pwa/service_worker.js.erb
index 483cba6..2f2144a 100644
--- a/app/views/pwa/service_worker.js.erb
+++ b/app/views/pwa/service_worker.js.erb
@@ -65,3 +65,40 @@ self.addEventListener("activate", (event) => {
 })
 
 TurboOffline.start()
+
+// Web push
+// ------------------------------------------------------------------------
+
+self.addEventListener("push", (event) => {
+  event.waitUntil(showNotification(event.data.json()))
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  event.waitUntil(openCard(event.notification.data?.url))
+})
+
+async function showNotification({ title, body, url, tag }) {
+  return self.registration.showNotification(title, {
+    body: body,
+    tag: tag,
+    icon: "/app-icon-192.png",
+    badge: "/app-icon-192-maskable.png",
+    data: { url: url }
+  })
+})
+
+async function openCard(url) {
+  const windows = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+  const card = windows.find((client) => client.url === url)
+
+  if (card) {
+    return card.focus()
+  } else if (windows.length > 0) {
+    const client = windows[0]
+    await client.focus()
+    return client.navigate(url || "/")
+  } else {
+    return self.clients.openWindow(url || "/")
+  }
+}
