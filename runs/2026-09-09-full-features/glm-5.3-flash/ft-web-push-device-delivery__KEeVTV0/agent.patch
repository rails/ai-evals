diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..b2fc478
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,101 @@
+import { post } from "@rails/request.js"
+import { Controller } from "@hotwired/stimulus"
+
+// Push notifications for the device you're on. Turning the switch on asks the
+// browser for permission, subscribes to the push service, and posts the
+// subscription the service handed back so we can push to this device too.
+export default class extends Controller {
+  static targets = [ "details", "switch" ]
+
+  static values = {
+    publicKey: String,
+    url: String
+  }
+
+  connect() {
+    this.#sync()
+  }
+
+  async toggle() {
+    if (this.switchTarget.checked) {
+      await this.#subscribe()
+    } else {
+      await this.#unsubscribe()
+    }
+
+    this.#sync()
+  }
+
+  // Private
+
+  async #subscribe() {
+    try {
+      if (!this.publicKeyValue) throw new Error("Push notifications are not configured on this server")
+      if ((await Notification.requestPermission()) !== "granted") return
+
+      const pushManager = await this.#pushManager()
+      const subscription = await pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: this.#applicationServerKey
+      })
+
+      await post(this.urlValue, {
+        body: JSON.stringify({ push_subscription: this.#credentials(subscription) }),
+        responseKind: "json"
+      })
+    } catch (error) {
+      this.switchTarget.checked = false
+      console.error("Notifications could not be turned on for this device", error)
+    }
+  }
+
+  async #unsubscribe() {
+    const pushManager = await this.#pushManager()
+    const subscription = await pushManager.getSubscription()
+
+    await subscription?.unsubscribe()
+  }
+
+  async #sync() {
+    let on = false
+
+    if (this.#supported) {
+      try {
+        const pushManager = await this.#pushManager()
+        on = Boolean(await pushManager.getSubscription())
+      } catch (error) {
+        console.error("Notifications are not available for this device", error)
+      }
+    }
+
+    this.switchTarget.checked = on
+    this.switchTarget.disabled = !this.#supported
+    this.element.classList.toggle("notifications--on", on)
+    this.detailsTargets.forEach((details) => { details.hidden = on })
+  }
+
+  get #supported() {
+    return "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+  }
+
+  // The service worker Fizzy already registers for offline support is the one
+  // that will receive the pushes.
+  async #pushManager() {
+    const registration = await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+
+    return registration.pushManager
+  }
+
+  get #applicationServerKey() {
+    const padding = "=".repeat((4 - (this.publicKeyValue.length % 4)) % 4)
+    const base64 = (this.publicKeyValue + padding).replaceAll("-", "+").replaceAll("_", "/")
+
+    return Uint8Array.from(atob(base64), (character) => character.charCodeAt(0))
+  }
+
+  #credentials(subscription) {
+    const { endpoint, keys: { p256dh, auth } } = subscription.toJSON()
+
+    return { endpoint, p256dh_key: p256dh, auth_key: auth }
+  }
+}
