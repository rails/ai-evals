diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..20dd558
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,74 @@
+# A device's subscription to web push, handed to us by the browser once someone
+# turned notifications on for the device they're using.
+class PushSubscription < ApplicationRecord
+  EMAIL_ADDRESS_PATTERN = /[^\s<>"',;]+@[^\s<>"',;]+/
+
+  # Everything that can go wrong while talking to a push service.
+  DELIVERY_ERRORS = [ WebPush::Error, SocketError, Net::OpenTimeout, Net::ReadTimeout,
+    Errno::ECONNREFUSED, Errno::ECONNRESET, Errno::EHOSTUNREACH, OpenSSL::SSL::SSLError ]
+
+  ENDPOINT_TIMEOUT = 5.seconds
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+
+  validates :endpoint, presence: true, uniqueness: true
+  validates :p256dh_key, :auth_key, presence: true
+
+  class << self
+    # The browser hands us the same subscription every time someone turns
+    # notifications on for a device, so we refresh the keys instead of failing.
+    # A device can only be subscribed to one person at a time, so the
+    # subscription follows whoever is turning notifications on.
+    def register(user:, endpoint:, p256dh_key:, auth_key:)
+      find_or_initialize_by(endpoint: endpoint).tap do |subscription|
+        subscription.update!(user: user, account: user.account, p256dh_key: p256dh_key, auth_key: auth_key)
+      end
+    end
+
+    # Pushes can only be sent once ops has provided the VAPID key pair.
+    def pushable?
+      vapid_public_key.present? && vapid_private_key.present?
+    end
+
+    def vapid_public_key
+      ENV["VAPID_PUBLIC_KEY"]
+    end
+
+    def vapid_private_key
+      ENV["VAPID_PRIVATE_KEY"]
+    end
+
+    def vapid_subject
+      "mailto:#{sender_email_address}"
+    end
+
+    def vapid_credentials
+      {
+        subject: vapid_subject,
+        public_key: vapid_public_key,
+        private_key: vapid_private_key
+      }
+    end
+
+    private
+      def sender_email_address
+        ENV.fetch("MAILER_FROM_ADDRESS", "Fizzy <support@fizzy.do>")[EMAIL_ADDRESS_PATTERN] || "support@fizzy.do"
+      end
+  end
+
+  def push(notification)
+    WebPush.payload_send \
+      endpoint: endpoint,
+      message: JSON.generate(Notification::Push.new(notification).payload),
+      p256dh: p256dh_key,
+      auth: auth_key,
+      vapid: PushSubscription.vapid_credentials,
+      open_timeout: ENDPOINT_TIMEOUT,
+      read_timeout: ENDPOINT_TIMEOUT
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy # The push service has forgotten this subscription, so should we.
+  rescue *DELIVERY_ERRORS => e
+    Rails.logger.warn { "Push to #{endpoint} failed: #{e.message}" }
+  end
+end
