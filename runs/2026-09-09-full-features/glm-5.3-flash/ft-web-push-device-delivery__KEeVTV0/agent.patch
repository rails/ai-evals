diff --git a/test/controllers/users/push_subscriptions_controller_test.rb b/test/controllers/users/push_subscriptions_controller_test.rb
new file mode 100644
index 0000000..b75f3a4
--- /dev/null
+++ b/test/controllers/users/push_subscriptions_controller_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :david
+
+    @user = users(:david)
+    @endpoint = "https://push.example.com/send/davids-device"
+    @push_subscription = { endpoint: @endpoint, p256dh_key: "p256dh", auth_key: "auth" }
+  end
+
+  test "create" do
+    assert_difference -> { PushSubscription.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @push_subscription }, as: :json
+    end
+
+    assert_response :created
+
+    subscription = @user.push_subscriptions.sole
+    assert_equal @endpoint, subscription.endpoint
+    assert_equal "p256dh", subscription.p256dh_key
+    assert_equal "auth", subscription.auth_key
+    assert_equal @user.account, subscription.account
+  end
+
+  test "create turns notifications on and goes back to the settings" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @push_subscription }
+
+    assert_redirected_to notifications_settings_path
+    assert_equal "Notifications turned on for this device", flash[:notice]
+  end
+
+  test "create keeps one subscription per device" do
+    @user.push_subscriptions.create!(endpoint: @endpoint, p256dh_key: "old p256dh", auth_key: "old auth")
+
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @push_subscription }, as: :json
+    end
+
+    assert_equal "p256dh", @user.push_subscriptions.sole.reload.p256dh_key
+  end
+
+  test "create for someone else is forbidden" do
+    assert_no_difference -> { PushSubscription.count } do
+      post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: @push_subscription }, as: :json
+    end
+
+    assert_response :forbidden
+  end
+
+  test "create without a subscription" do
+    post user_push_subscriptions_path(@user), as: :json
+
+    assert_response :bad_request
+  end
+end
diff --git a/test/models/notification/push_test.rb b/test/models/notification/push_test.rb
new file mode 100644
index 0000000..1e874ee
--- /dev/null
+++ b/test/models/notification/push_test.rb
@@ -0,0 +1,31 @@
+require "test_helper"
+
+class Notification::PushTest < ActiveSupport::TestCase
+  test "payload says what the tray says" do
+    notification = notifications(:layout_commented_kevin)
+    payload = Notification::Push.new(notification).payload
+
+    assert_equal notification.source.notification_title, payload[:title]
+    assert_equal notification.source.notification_body, payload[:body]
+  end
+
+  test "payload opens the card the notification is about" do
+    notification = notifications(:layout_commented_kevin)
+
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.to_param}", URI(Notification::Push.new(notification).payload[:url]).path
+  end
+
+  test "payload for a mention opens the commented card" do
+    notification = notifications(:logo_mentioned_david)
+    payload = Notification::Push.new(notification).payload
+
+    assert_equal "JZ @mentioned you", payload[:title]
+    assert_equal "#{notification.account.slug}/cards/#{notification.card.to_param}", URI(payload[:url]).path
+  end
+
+  test "payload carries a tag so a card's pushes replace each other" do
+    notification = notifications(:layout_commented_kevin)
+
+    assert_equal ActionView::RecordIdentifier.dom_id(notification), Notification::Push.new(notification).payload[:tag]
+  end
+end
diff --git a/test/models/notification_test.rb b/test/models/notification_test.rb
index 02dcbc7..02a4f81 100644
--- a/test/models/notification_test.rb
+++ b/test/models/notification_test.rb
@@ -84,4 +84,76 @@ class NotificationTest < ActiveSupport::TestCase
       notification.destroy
     end
   end
+
+  test "creating a notification enqueues a push" do
+    kevin = users(:kevin)
+    notifications(:layout_commented_kevin).destroy
+
+    assert_enqueued_with job: Notification::PushJob do
+      Notification.create!(user: kevin, source: events(:layout_commented), creator: users(:david))
+    end
+  end
+
+  test "a notification that lands in the tray again enqueues a push again" do
+    kevin = users(:kevin)
+    event = events(:layout_commented)
+
+    assert_enqueued_with job: Notification::PushJob do
+      Notifier.for(event).notify
+    end
+
+    assert_equal 2, kevin.notifications.where(card: event.card).sole.unread_count
+  end
+
+  test "reading and unreading a notification enqueues no push" do
+    notification = notifications(:layout_commented_kevin)
+
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      notification.read
+      notification.unread
+    end
+  end
+
+  test "push_now pushes to every device notifications were turned on for" do
+    with_vapid_keys do
+      phone = push_subscription_for("phone")
+      desktop = push_subscription_for("desktop")
+      stub_request(:post, phone.endpoint)
+      stub_request(:post, desktop.endpoint)
+
+      notifications(:layout_commented_kevin).push_now
+
+      assert_requested :post, phone.endpoint
+      assert_requested :post, desktop.endpoint
+    end
+  end
+
+  test "push_now pushes nothing when the instance has no VAPID key pair" do
+    stub_request(:post, "https://push.example.com/phone")
+
+    notifications(:layout_commented_kevin).push_now
+
+    assert_not_requested :post, "https://push.example.com/phone"
+  end
+
+  private
+    def push_subscription_for(device)
+      PushSubscription.register(
+        user: users(:kevin),
+        endpoint: "https://push.example.com/#{device}",
+        p256dh_key: Base64.urlsafe_encode64(OpenSSL::PKey::EC.generate("prime256v1").public_key.to_bn.to_s(2)),
+        auth_key: Base64.urlsafe_encode64(SecureRandom.random_bytes(16))
+      )
+    end
+
+    def with_vapid_keys
+      vapid_key = WebPush.generate_key
+      ENV["VAPID_PUBLIC_KEY"] = vapid_key.public_key
+      ENV["VAPID_PRIVATE_KEY"] = vapid_key.private_key
+
+      yield
+    ensure
+      ENV.delete("VAPID_PUBLIC_KEY")
+      ENV.delete("VAPID_PRIVATE_KEY")
+    end
 end
diff --git a/test/models/push_subscription_test.rb b/test/models/push_subscription_test.rb
new file mode 100644
index 0000000..dd22e72
--- /dev/null
+++ b/test/models/push_subscription_test.rb
@@ -0,0 +1,124 @@
+require "test_helper"
+
+class PushSubscriptionTest < ActiveSupport::TestCase
+  setup do
+    ENV["VAPID_PUBLIC_KEY"] = vapid_key.public_key
+    ENV["VAPID_PRIVATE_KEY"] = vapid_key.private_key
+
+    @user = users(:kevin)
+    @endpoint = "https://push.example.com/send/kevins-device"
+    @p256dh_key = p256dh_key
+    @auth_key = auth_key
+    @subscription = PushSubscription.register(user: @user, endpoint: @endpoint, p256dh_key: @p256dh_key, auth_key: @auth_key)
+  end
+
+  teardown do
+    ENV.delete("VAPID_PUBLIC_KEY")
+    ENV.delete("VAPID_PRIVATE_KEY")
+  end
+
+  test "register subscribes one of a user's devices" do
+    assert_equal @endpoint, @subscription.endpoint
+    assert_equal @p256dh_key, @subscription.p256dh_key
+    assert_equal @auth_key, @subscription.auth_key
+    assert_equal @user, @subscription.user
+    assert_equal @user.account, @subscription.account
+  end
+
+  test "register refreshes the keys when the device subscribes again" do
+    assert_no_difference -> { @user.push_subscriptions.count } do
+      PushSubscription.register(user: @user, endpoint: @endpoint, p256dh_key: p256dh_key, auth_key: auth_key)
+    end
+
+    assert_not_equal [ @p256dh_key, @auth_key ], [ @subscription.reload.p256dh_key, @subscription.auth_key ]
+  end
+
+  test "register follows the person turning notifications on for a device" do
+    david = users(:david)
+
+    PushSubscription.register(user: david, endpoint: @endpoint, p256dh_key: p256dh_key, auth_key: auth_key)
+
+    assert_equal david, @subscription.reload.user
+    assert_empty @user.push_subscriptions.reload
+  end
+
+  test "push sends the notification to the push service" do
+    stub_request(:post, @endpoint)
+
+    @subscription.push(notifications(:layout_commented_kevin))
+
+    assert_requested :post, @endpoint, times: 1
+  end
+
+  test "push encrypts the payload with the subscription keys" do
+    stub_request(:post, @endpoint).with do |request|
+      request.headers["Content-Encoding"].present? && request.headers["Authorization"].present?
+    end
+
+    @subscription.push(notifications(:layout_commented_kevin))
+
+    assert_requested :post, @endpoint, times: 1
+  end
+
+  test "push forgets a subscription the push service has expired" do
+    stub_request(:post, @endpoint).to_return(status: 410)
+
+    @subscription.push(notifications(:layout_commented_kevin))
+
+    assert_not PushSubscription.exists?(@subscription.id)
+  end
+
+  test "push keeps a subscription when the push service can't be reached" do
+    stub_request(:post, @endpoint).to_return(status: 500)
+
+    @subscription.push(notifications(:layout_commented_kevin))
+
+    assert PushSubscription.exists?(@subscription.id)
+  end
+
+  test "push survives a push service that can't be reached at all" do
+    stub_request(:post, @endpoint).to_raise(Errno::ECONNREFUSED)
+
+    @subscription.push(notifications(:layout_commented_kevin))
+
+    assert PushSubscription.exists?(@subscription.id)
+  end
+
+  test "pushable? once ops provided the VAPID key pair" do
+    assert PushSubscription.pushable?
+
+    ENV.delete("VAPID_PRIVATE_KEY")
+
+    assert_not PushSubscription.pushable?
+  end
+
+  test "vapid subject points at the address Fizzy sends email from" do
+    with_env("MAILER_FROM_ADDRESS", "Fizzy <hello@example.com>") do
+      assert_equal "mailto:hello@example.com", PushSubscription.vapid_subject
+    end
+
+    assert_equal "mailto:support@fizzy.do", PushSubscription.vapid_subject
+  end
+
+  private
+    def vapid_key
+      @vapid_key ||= WebPush.generate_key
+    end
+
+    def with_env(key, value)
+      previous = ENV[key]
+      ENV[key] = value
+      yield
+    ensure
+      ENV[key] = previous
+    end
+
+    # Keys as the browser hands them over, so a payload can actually be encrypted.
+    def p256dh_key
+      Base64.urlsafe_encode64(OpenSSL::PKey::EC.generate("prime256v1").public_key.to_bn.to_s(2))
+    end
+
+    def auth_key
+      Base64.urlsafe_encode64(SecureRandom.random_bytes(16))
+    end
+end
