new file mode 100644
index 0000000..71e3988
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,86 @@
+<%
+  # Fizzy on one box: a single Linux server with Docker running the whole app
+  # in one container, with SQLite as the database and kamal-proxy terminating
+  # SSL. See docs/deploying.md for a walk-through.
+  #
+  # Replace the values below and the two SMTP entries in env.clear, add your
+  # secrets to .kamal/secrets (see .kamal/secrets.example), and run:
+  #
+  #   bin/kamal setup
+  @host = "your-hostname.example.com"
+  @image = "your-docker-hub-username/fizzy"
+  @registry_username = "your-docker-hub-username"
+%>
+
+# Name of the application, used to name the containers, the network and the volume.
+service: fizzy
+
+# Name of the container image, pushed to your registry by `bin/kamal build`.
+image: <%= @image %>
+
+# The whole app lives in one container on this box: Puma serves requests and
+# Solid Queue runs the background jobs inside it.
+servers:
+  web:
+    hosts:
+      - <%= @host %>
+
+# Everything that has to outlive a deploy is written to /rails/storage:
+# the SQLite databases and the files uploaded through Active Storage.
+volumes:
+  - "fizzy:/rails/storage"
+
+# Bridged between deploys, so that the new container can serve the assets the
+# old one linked to.
+asset_path: /rails/public/assets
+
+# kamal-proxy listens on ports 80 and 443, gets a certificate for your host
+# from Let's Encrypt, and forwards requests to the app container.
+proxy:
+  host: <%= @host %>
+  ssl: true
+
+# Credentials for the registry your image is pushed to.
+registry:
+  server: docker.io
+  username: <%= @registry_username %>
+  password:
+    - KAMAL_REGISTRY_PASSWORD
+
+env:
+  clear:
+    RAILS_ENV: production
+
+    # Run the background jobs in the app container, next to the web server.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # The host Fizzy is served from. Links in emails and redirects point here.
+    APP_FQDN: <%= @host %>
+
+    # Your mail server. The password comes from .kamal/secrets.
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@<%= @host %>>"
+    SMTP_HOST: "your-smtp-host.example.com"
+    SMTP_PORT: 587
+    SMTP_DOMAIN: <%= @host %>
+    SMTP_USER_NAME: "your-smtp-username"
+
+  secret:
+    - RAILS_MASTER_KEY
+    - SMTP_PASSWORD
+    # Browser push notifications need a VAPID key pair. Generate one with
+    # the web-push gem (see docs/development.md), then add the two lines
+    # below and put the keys in .kamal/secrets.
+    # - VAPID_PUBLIC_KEY
+    # - VAPID_PRIVATE_KEY
+
+# Log in as a user other than root, e.g. one that is in the docker group.
+# ssh:
+#   user: app
+
+# Shortcuts for poking at the box, e.g. `bin/kamal console`.
+aliases:
+  console: app exec -i --reuse "bin/rails console"
+
+# Set to arm64 if your box is ARM, e.g. a Raspberry Pi.
+builder:
+  arch: amd64
diff --git a/config/environments/production.rb b/config/environments/production.rb
