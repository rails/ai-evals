@@ -0,0 +1,27 @@
+#!/usr/bin/env ruby
+
+# Refuse to connect while config/deploy.yml still has the values that ship with
+# the repository. Run before every command that talks to a server.
+#
+# These environment variables are available:
+# KAMAL_HOSTS, KAMAL_ROLES, KAMAL_DESTINATION, KAMAL_VERSION, KAMAL_PERFORMER
+
+config = File.read(File.expand_path("../../config/deploy.yml", __dir__))
+
+placeholders = {
+  "your-hostname.example.com" => "the @host line at the top of config/deploy.yml",
+  "your-docker-hub-username" => "the @image and @registry_username lines at the top of config/deploy.yml",
+  "your-smtp-host.example.com" => "the SMTP_HOST entry in config/deploy.yml",
+  "your-smtp-username" => "the SMTP_USER_NAME entry in config/deploy.yml"
+}
+
+still_to_do = placeholders.select { |placeholder, _| config.include?(placeholder) }
+
+if still_to_do.any?
+  warn "config/deploy.yml is not ready to deploy, fill in:"
+  still_to_do.each do |_, where|
+    warn "  - #{where}"
+  end
+  warn "Then put your secrets in .kamal/secrets, see .kamal/secrets.example."
+  exit 1
+end
diff --git a/.kamal/secrets.example b/.kamal/secrets.example
new file mode 100644
index 0000000..3a36a87
--- /dev/null
+++ b/.kamal/secrets.example
@@ -0,0 +1,22 @@
+# Copy this file to .kamal/secrets and fill in your secrets.
+#
+#   cp .kamal/secrets.example .kamal/secrets
+#
+# .kamal/secrets is ignored by git, so nothing here ends up in your repository.
+# The variables listed under `secret` in config/deploy.yml are read from here.
+
+# The password for the registry in config/deploy.yml.
+KAMAL_REGISTRY_PASSWORD=
+
+# The master key that encrypts config/credentials.yml.enc.
+# If you already have a config/master.key, the line below picks it up.
+RAILS_MASTER_KEY=$(cat config/master.key)
+
+# The password for the SMTP_USER_NAME in config/deploy.yml.
+SMTP_PASSWORD=
+
+# Browser push notifications. Optional: Fizzy works without them.
+# Generate a key pair with the web-push gem (see docs/development.md), then
+# uncomment the two lines below and the ones in config/deploy.yml.
+# VAPID_PUBLIC_KEY=
+# VAPID_PRIVATE_KEY=
