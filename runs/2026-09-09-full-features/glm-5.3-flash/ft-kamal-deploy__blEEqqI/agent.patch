--- a/config/environments/production.rb
+++ b/config/environments/production.rb
@@ -76,6 +76,43 @@ Rails.application.configure do
 
   config.action_mailer.perform_caching = false
 
+  # The host Fizzy is served from. Used to build URLs outside of a request, like
+  # the ones in emails. Set APP_FQDN in your Kamal config (see docs/deploying.md).
+  app_host = ENV["APP_FQDN"]
+  if app_host.present?
+    config.action_controller.default_url_options = { host: app_host, protocol: "https" }
+    config.action_mailer.default_url_options     = { host: app_host, protocol: "https" }
+  end
+
+  # Send email through your own mail server. Set SMTP_HOST to turn it on; the
+  # other SMTP_* variables are optional. See docs/deploying.md.
+  if ENV["SMTP_HOST"].present?
+    smtp_settings = {
+      address: ENV["SMTP_HOST"],
+      port: ENV.fetch("SMTP_PORT", 587).to_i,
+      enable_starttls_auto: ENV.fetch("SMTP_STARTTLS_AUTO", "true") != "false"
+    }
+
+    # Mail servers that expect implicit TLS, usually on port 465.
+    if ENV["SMTP_TLS"] == "true"
+      smtp_settings[:tls] = true
+      smtp_settings[:enable_starttls_auto] = false
+    end
+
+    if ENV["SMTP_USER_NAME"].present?
+      smtp_settings[:user_name]      = ENV["SMTP_USER_NAME"]
+      smtp_settings[:password]       = ENV["SMTP_PASSWORD"]
+      smtp_settings[:authentication] = ENV.fetch("SMTP_AUTHENTICATION", "plain")
+    end
+
+    if ENV["SMTP_DOMAIN"].present?
+      smtp_settings[:domain] = ENV["SMTP_DOMAIN"]
+    end
+
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings   = smtp_settings
+  end
+
   # Ignore bad email addresses and do not raise email delivery errors.
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
diff --git a/docs/deploying.md b/docs/deploying.md
new file mode 100644
index 0000000..2967ffe
--- /dev/null
+++ b/docs/deploying.md
@@ -0,0 +1,107 @@
+## Deploying on one box
+
+Fizzy ships with a Kamal config, [`config/deploy.yml`](../config/deploy.yml), that deploys the whole app to a single Linux server: one Docker container with Puma serving requests, Solid Queue running the background jobs, and SQLite for the database. [kamal-proxy](https://github.com/basecamp/kamal-proxy) runs next to it and terminates SSL, so Fizzy is served over HTTPS on the hostname you point at the box.
+
+To deploy your own copy of Fizzy, you need:
+
+* A Linux server with a hostname that resolves to it, and ports 80 and 443 open. Docker gets installed for you.
+* An SSH key that can log in to that server as `root` (or as another user that is allowed to run Docker, see `ssh.user` in the Kamal config).
+* A Docker registry to push the image to, for example [Docker Hub](https://hub.docker.com).
+* A mail server that will send Fizzy's email: magic links, notifications, exports.
+
+### 1. Fill in the config
+
+Replace the values at the top of `config/deploy.yml`:
+
+```yaml
+@host = "fizzy.example.org"          # the hostname of your server
+@image = "your-docker-hub-username/fizzy"
+@registry_username = "your-docker-hub-username"
+```
+
+and the mail server settings further down, in `env.clear`:
+
+```yaml
+SMTP_HOST: "mail.example.org"
+SMTP_PORT: 587
+SMTP_USER_NAME: "fizzy-mail"
+```
+
+Everything else in the config has a sensible default. Deploying with the placeholders still in place will be stopped by the `.kamal/hooks/pre-connect` hook, which tells you what is left to fill in.
+
+### 2. Add your secrets
+
+```sh
+cp .kamal/secrets.example .kamal/secrets
+```
+
+Then fill in `.kamal/secrets`:
+
+* `KAMAL_REGISTRY_PASSWORD` â the password or access token for `registry.username`.
+* `RAILS_MASTER_KEY` â the master key of your Fizzy checkout, created with `bin/rails credentials:edit` the first time you run it. If `config/master.key` exists, the line in `.kamal/secrets.example` picks it up for you.
+* `SMTP_PASSWORD` â the password that goes with `SMTP_USER_NAME`.
+Browser push notifications are optional. To turn them on, generate a VAPID key pair with the `web-push` gem as described in the [development guide](development.md), then uncomment the `VAPID_*` lines in `config/deploy.yml` and `.kamal/secrets.example`.
+
+`.kamal/secrets` is ignored by git, and its contents are written to an env file on your server, not into the image.
+
+### 3. Set up and deploy
+
+From the root of your checkout:
+
+```sh
+bin/kamal setup
+```
+
+This installs Docker on the box, boots the proxy, builds and pushes the image, prepares the database and starts Fizzy at `https://<your-host>`.
+
+Deploys after that are:
+
+```sh
+bin/kamal deploy
+```
+
+Migrations run when the new container boots, and the old container keeps serving until the new one is ready. If a deploy goes wrong, `bin/kamal rollback <version>` gets you back to the previous one.
+
+To look around:
+
+```sh
+bin/kamal app logs
+bin/kamal console
+```
+
+### 4. Your data
+
+Everything that has to outlive a deploy is written to `/rails/storage` in the container, which is backed by a Docker volume called `fizzy`:
+
+* `production.sqlite3`, plus the Solid Queue, Solid Cache and Solid Cable databases.
+* Files uploaded through Active Storage.
+
+Deploys, reboots and rollbacks leave the volume alone. Back it up from your machine:
+
+```sh
+bin/kamal app stop # optional: keeps the databases quiet during the backup
+ssh root@<your-host> 'docker run --rm --volume fizzy:/data:ro alpine tar -C / -czf - data' > fizzy-data.tar.gz
+bin/kamal app boot
+```
+
+Keep a copy of `.kamal/secrets` somewhere safe as well: the volume on its own is not the whole app.
+
+### 5. Accounts and mail
+
+Fizzy runs in single-account mode by default: the first account created claims the deployment, and after that nobody else can sign up. Set `MULTI_TENANT: true` in `env.clear` if you want to host many accounts, each with a path of its own.
+
+Email is sent through the SMTP server you configured. The sender is `MAILER_FROM_ADDRESS`, and the links in those emails are built from `APP_FQDN`, so both should match the hostname you deployed to.
+
+The `SMTP_*` variables map straight onto Rails' `smtp_settings`:
+
+* `SMTP_HOST` turns email delivery on. Without it, Fizzy hands mail to a local relay on `localhost`.
+* `SMTP_PORT` is the port to connect to, 587 by default.
+* `SMTP_USER_NAME` and `SMTP_PASSWORD` log in to the mail server. Leave both out to send without authenticating.
+* `SMTP_DOMAIN` is the domain used for the HELO, which some mail servers check.
+* `SMTP_TLS: true` for mail servers that expect TLS as soon as you connect, usually on port 465.
+* `SMTP_STARTTLS_AUTO: false` stops Fizzy from upgrading the connection to TLS, for relays that don't offer it.
+* `SMTP_AUTHENTICATION` is the authentication type, `plain` by default.
+
+### 6. Push notifications
+
+Browser notifications need a VAPID key pair, see step 2. Without one, everything else keeps working: Fizzy just never asks to send notifications.
diff --git a/test/lib/deployment/deploy_config_test.rb b/test/lib/deployment/deploy_config_test.rb
new file mode 100644
index 0000000..0bbd422
--- /dev/null
+++ b/test/lib/deployment/deploy_config_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+require "fileutils"
+require "kamal"
+require "securerandom"
+require "tmpdir"
+
+class DeployConfigTest < ActiveSupport::TestCase
+  PLACEHOLDERS = {
+    "your-hostname.example.com" => "fizzy.example.org",
+    "your-docker-hub-username" => "acme",
+    "your-smtp-host.example.com" => "mail.example.org",
+    "your-smtp-username" => "acme-fizzy"
+  }
+
+  setup do
+    @config = Kamal::Configuration.create_from(config_file: deploy_yml)
+    @web = @config.role("web")
+  end
+
+  test "deploys the whole app to one box" do
+    assert_equal %w[web], @config.roles.map(&:name)
+    assert_equal 1, @web.hosts.size
+  end
+
+  test "serves HTTPS from the proxy" do
+    assert @config.proxy.ssl?
+    assert_equal @web.hosts.first, @config.proxy.hosts.first
+  end
+
+  test "mounts a volume for the SQLite databases and uploaded files" do
+    assert_equal [ "--volume", "fizzy:/rails/storage" ], @config.volume_args
+  end
+
+  test "bridges the precompiled assets" do
+    assert @web.assets?
+    assert_equal "/rails/public/assets", @web.asset_path
+  end
+
+  test "runs the background jobs in the app container" do
+    assert_equal "true", @config.env.clear.fetch("SOLID_QUEUE_IN_PUMA").to_s
+  end
+
+  test "passes the app host to the container" do
+    assert_equal @web.hosts.first, @config.env.clear.fetch("APP_FQDN")
+  end
+
+  test "configures a mail server" do
+    assert_not_empty @config.env.clear.fetch("SMTP_HOST")
+    assert_not_empty @config.env.clear.fetch("MAILER_FROM_ADDRESS")
+  end
+
+  test "keeps the secrets out of the config" do
+    assert_equal [ "KAMAL_REGISTRY_PASSWORD" ], @config.raw_config.registry["password"]
+    assert_includes @config.env.secret_keys, "RAILS_MASTER_KEY"
+    assert_includes @config.env.secret_keys, "SMTP_PASSWORD"
+  end
+
+  test "secrets template covers every secret the config asks for" do
+    listed = File.read(Rails.root.join(".kamal/secrets.example")).scan(/^\s*([A-Z][A-Z_]+)=/).flatten
+
+    assert_equal (@config.env.secret_keys + [ "KAMAL_REGISTRY_PASSWORD" ]).sort, listed.sort
+  end
+
+  test "pre-connect hook lets a filled in config through" do
+    status, output = run_hook
+
+    assert_equal 0, status, output
+  end
+
+  test "pre-connect hook stops a config that still has placeholders" do
+    status, output = run_hook do |config|
+      PLACEHOLDERS.each { |placeholder, _| config << " #{placeholder}" }
+    end
+
+    assert_equal 1, status
+    assert_match "config/deploy.yml is not ready to deploy", output
+    assert_match "@host", output
+  end
+
+  private
+    def deploy_yml
+      Rails.root.join("config/deploy.yml")
+    end
+
+    def run_hook
+      hook = Rails.root.join(".kamal/hooks/pre-connect")
+
+      Dir.mktmpdir do |dir|
+        FileUtils.mkdir_p [ File.join(dir, ".kamal/hooks"), File.join(dir, "config") ]
+        FileUtils.cp hook, File.join(dir, ".kamal/hooks/pre-connect")
+
+        config = File.read(deploy_yml)
+        PLACEHOLDERS.each { |placeholder, value| config = config.gsub(placeholder, value) }
+        config = yield(config) if block_given?
+        File.write(File.join(dir, "config/deploy.yml"), config)
+
+        output = `#{File.join(dir, ".kamal/hooks/pre-connect")} 2>&1`
+        [ $?.exitstatus, output ]
+      end
+    end
+end
