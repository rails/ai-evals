diff --git a/app/models/concerns/bytes_used.rb b/app/models/concerns/bytes_used.rb
new file mode 100644
index 0000000..ed6c112
--- /dev/null
+++ b/app/models/concerns/bytes_used.rb
@@ -0,0 +1,29 @@
+# Tracks how much storage the attachments of an Account or a Board take up.
+#
+# Only card images and the images and files embedded in board descriptions, card
+# descriptions and comments are counted. A board's usage covers everything counted
+# on that board and its cards; an account's usage covers everything counted across
+# all of its boards.
+#
+# Counting means adding up potentially large amounts of attachments, so it is never
+# done inline. The value is calculated in the background (see BytesUsed::Trackable)
+# and cached in +bytes_used+.
+#
+# Models including this concern must implement +calculate_bytes_used+, which
+# returns the usage in bytes, and +update_bytes_used_later+, which enqueues the
+# background calculation.
+module BytesUsed
+  extend ActiveSupport::Concern
+
+  # The last value calculated in the background. Until a first calculation has run,
+  # the value is calculated on the spot rather than reporting nothing.
+  def bytes_used
+    self[:bytes_used] || calculate_bytes_used
+  end
+
+  # Calculates the usage and caches it in +bytes_used+.
+  def update_bytes_used
+    self.bytes_used = calculate_bytes_used
+    update_column(:bytes_used, self[:bytes_used])
+  end
+end
diff --git a/app/models/concerns/bytes_used/trackable.rb b/app/models/concerns/bytes_used/trackable.rb
new file mode 100644
index 0000000..4f0fe0f
--- /dev/null
+++ b/app/models/concerns/bytes_used/trackable.rb
@@ -0,0 +1,83 @@
+# Extends ActiveStorage::Attachment so that the usage of the boards (and, through
+# them, of the accounts) an attachment is counted on is recalculated in the
+# background whenever the attachment comes or goes. Prepended from
+# config/initializers/active_storage.rb.
+module BytesUsed::Trackable
+  extend ActiveSupport::Concern
+
+  # Attachments to these records are the only ones counted: card images and the
+  # images and files embedded in board descriptions, card descriptions and comments.
+  COUNTED_RECORD_TYPES = %w[ Card ActionText::RichText ]
+
+  prepended do
+    before_destroy :remember_usage_boards
+    after_commit :update_bytes_used_later, on: %i[ create destroy ]
+  end
+
+  # purge, purge_later and detach remove the attachment without running destroy
+  # callbacks.
+  def purge
+    recount_after_removal { super }
+  end
+
+  def purge_later
+    recount_after_removal { super }
+  end
+
+  def detach
+    recount_after_removal { super }
+  end
+
+  def update_bytes_used_later
+    if counted?
+      if usage_boards.any?
+        usage_boards.each(&:update_bytes_used_later)
+      else
+        # The record is gone, so the boards it was counted on can no longer be
+        # figured out. Recalculating the whole account still keeps its usage true.
+        account&.update_bytes_used_later
+      end
+    end
+  end
+
+  private
+    # The boards the attachment is counted on are remembered before it is removed,
+    # while its record is still around, and the usage is recalculated afterwards.
+    def recount_after_removal
+      remember_usage_boards
+      yield
+    ensure
+      update_bytes_used_later
+    end
+
+    def counted?
+      record_type.in?(COUNTED_RECORD_TYPES)
+    end
+
+    # The boards whose usage includes this attachment.
+    def usage_boards
+      @usage_boards ||=
+        case counted_record
+        when Board then [ counted_record ]
+        when Card, Comment then [ counted_record.board ]
+        else []
+        end.compact
+    end
+
+    def remember_usage_boards
+      usage_boards
+    end
+
+    # The board, card or comment this attachment is counted on, if it still exists.
+    # Attachments to rich text embeds belong to the rich text, whose record is the
+    # board, card or comment they are counted on.
+    def counted_record
+      return unless counted?
+
+      if record_type == "Card"
+        Card.find_by(id: record_id)
+      else
+        ActionText::RichText.find_by(id: record_id)&.record
+      end
+    end
+end
