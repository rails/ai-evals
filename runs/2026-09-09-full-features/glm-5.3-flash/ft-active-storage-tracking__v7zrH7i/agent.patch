@@ -0,0 +1,44 @@
+module Board::BytesUsed
+  extend ActiveSupport::Concern
+
+  include BytesUsed
+
+  included do
+    after_create_commit :update_bytes_used_later
+    after_destroy_commit :update_account_bytes_used_later
+  end
+
+  class_methods do
+    # Counts, with a single aggregate query, the storage used by the attachments
+    # belonging to +boards+: their cards' images plus the images and files embedded
+    # in board descriptions, card descriptions and comments. The cost of the query
+    # doesn't grow with the number of attachments or users involved.
+    def calculate_bytes_used(boards)
+      cards = Card.where(board_id: boards.select(:id))
+      rich_texts = ActionText::RichText.where(record_type: "Board", record_id: boards.select(:id))
+        .or(ActionText::RichText.where(record_type: "Card", record_id: cards.select(:id)))
+        .or(ActionText::RichText.where(record_type: "Comment", record_id: Comment.where(card_id: cards.select(:id)).select(:id)))
+
+      ActiveStorage::Attachment
+        .where(record_type: "Card", name: "image", record_id: cards.select(:id))
+        .or(ActiveStorage::Attachment.where(record_type: "ActionText::RichText", record_id: rich_texts.select(:id)))
+        .joins(:blob)
+        .sum("active_storage_blobs.byte_size")
+    end
+  end
+
+  def update_bytes_used_later
+    Board::UpdateBytesUsedJob.perform_later(self)
+  end
+
+  private
+    # Everything counted on this board and its cards.
+    def calculate_bytes_used
+      Board.calculate_bytes_used(Board.where(id: id))
+    end
+
+    # The board is gone, but everything it was counted on still is.
+    def update_account_bytes_used_later
+      account&.update_bytes_used_later
+    end
+end
