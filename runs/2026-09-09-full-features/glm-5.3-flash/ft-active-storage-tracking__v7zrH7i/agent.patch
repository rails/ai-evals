@@ -0,0 +1,121 @@
+require "test_helper"
+
+class Board::BytesUsedTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "counts card images, and the images and files embedded in board descriptions, card descriptions and comments" do
+    blobs = []
+    blobs << attach_image_to(@card)
+    blobs << attach_embed_to(@card, :description)
+    blobs << attach_embed_to(@board, :public_description)
+
+    comment = @card.comments.create!(creator: users(:david), body: "with an attachment")
+    blobs << attach_embed_to(comment, :body)
+
+    perform_bytes_used_jobs
+
+    assert_equal blobs.sum(&:byte_size), @board.reload.bytes_used
+  end
+
+  test "does not count remote images, user avatars or export files" do
+    @card.update! description: %(<p><action-text-attachment url="https://example.com/image.png" content-type="image/png"></action-text-attachment></p>)
+    users(:david).avatar.attach(io: file_fixture("moon.jpg").open, filename: "avatar.png", content_type: "image/jpeg")
+    accounts("37s").exports.create!(user: users(:david)).file.attach(io: StringIO.new("export"), filename: "export.zip", content_type: "application/zip")
+
+    perform_bytes_used_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "is recalculated when an attachment is removed" do
+    blob = attach_image_to(@card)
+    perform_bytes_used_jobs
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    @card.image.purge_later
+    perform_bytes_used_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "is recalculated when an embed is removed from a description" do
+    blob = attach_embed_to(@card, :description)
+    perform_bytes_used_jobs
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    @card.update! description: "<p>Nothing attached</p>"
+    perform_bytes_used_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "is recalculated when a card with an attachment is destroyed" do
+    blob = attach_image_to(@card)
+    perform_bytes_used_jobs
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    @card.destroy!
+    perform_bytes_used_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "is recalculated when a comment with an attachment is destroyed" do
+    comment = @card.comments.create!(creator: users(:david), body: "with an attachment")
+    blob = attach_embed_to(comment, :body)
+    perform_bytes_used_jobs
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    comment.destroy!
+    perform_bytes_used_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+  end
+
+  test "moves the usage of a card to the board it is moved to" do
+    other_board = boards(:private)
+    blob = attach_image_to(@card)
+    perform_bytes_used_jobs
+    assert_equal blob.byte_size, @board.reload.bytes_used
+
+    @card.move_to(other_board)
+    perform_bytes_used_jobs
+
+    assert_equal 0, @board.reload.bytes_used
+    assert_equal blob.byte_size, other_board.reload.bytes_used
+  end
+
+  test "counts all the attachments of a board with a single query" do
+    3.times do |number|
+      card = @board.cards.create!(creator: users(:david), title: "Card #{number}")
+      attach_image_to(card)
+      attach_embed_to(card, :description)
+    end
+
+    assert_queries_count(1) do
+      Board.calculate_bytes_used(Board.where(id: @board.id))
+    end
+  end
+
+  private
+    # Flushing every enqueued job would run jobs from other features that don't
+    # expect the records they were given to be gone by then.
+    def perform_bytes_used_jobs
+      perform_enqueued_jobs only: [ Board::UpdateBytesUsedJob, Account::UpdateBytesUsedJob ]
+    end
+
+    def attach_image_to(card)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      card.image.blob
+    end
+
+    def attach_embed_to(container, name)
+      blob = ActiveStorage::Blob.create_and_upload! io: file_fixture("moon.jpg").open, filename: "embed.jpg", content_type: "image/jpeg"
+      container.update!(name => "<p>With an embed: #{ActionText::Attachment.from_attachable(blob).to_html}</p>")
+      blob.reload
+    end
+end
