+module Account::BytesUsed
+  extend ActiveSupport::Concern
+
+  include BytesUsed
+
+  def update_bytes_used_later
+    Account::UpdateBytesUsedJob.perform_later(self)
+  end
+
+  private
+    # Everything counted across all of the account's boards. Boards that have never
+    # been calculated are calculated first, since the account's usage is the sum of
+    # theirs.
+    def calculate_bytes_used
+      boards.where(bytes_used: nil).find_each(&:update_bytes_used)
+      boards.sum(:bytes_used)
+    end
+end
