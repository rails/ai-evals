--- /dev/null
+++ b/test/models/account/bytes_used_test.rb
@@ -0,0 +1,78 @@
+require "test_helper"
+
+class Account::BytesUsedTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "counts everything counted across all of its boards" do
+    blobs = []
+    blobs << attach_image_to(@card)
+    blobs << attach_embed_to(@board, :public_description)
+    other_board = boards(:private)
+    blobs << attach_image_to(other_board.cards.create!(creator: users(:kevin), title: "Elsewhere"))
+
+    perform_bytes_used_jobs
+
+    assert_equal blobs.sum(&:byte_size), @account.reload.bytes_used
+  end
+
+  test "does not count attachments of other accounts" do
+    blob = attach_image_to(boards(:miltons_wish_list).cards.first)
+
+    perform_bytes_used_jobs
+
+    assert_equal 0, @account.reload.bytes_used
+    assert_equal blob.byte_size, boards(:miltons_wish_list).account.reload.bytes_used
+  end
+
+  test "does not count user avatars or export files" do
+    users(:david).avatar.attach(io: file_fixture("moon.jpg").open, filename: "avatar.png", content_type: "image/jpeg")
+    @account.exports.create!(user: users(:david)).file.attach(io: StringIO.new("export"), filename: "export.zip", content_type: "application/zip")
+
+    perform_bytes_used_jobs
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "is recalculated when a board is destroyed" do
+    board = boards(:private)
+    blob = attach_image_to(board.cards.create!(creator: users(:kevin), title: "Doomed"))
+    perform_bytes_used_jobs
+    assert_equal blob.byte_size, @account.reload.bytes_used
+
+    board.destroy!
+    perform_bytes_used_jobs
+
+    assert_equal 0, @account.reload.bytes_used
+  end
+
+  test "calculates the boards that have never been calculated" do
+    blob = attach_image_to(@card)
+    assert_nil @board[:bytes_used]
+
+    assert_equal blob.byte_size, @account.reload.bytes_used
+    assert_equal blob.byte_size, @board.reload.bytes_used
+  end
+
+  private
+    # Flushing every enqueued job would run jobs from other features that don't
+    # expect the records they were given to be gone by then.
+    def perform_bytes_used_jobs
+      perform_enqueued_jobs only: [ Board::UpdateBytesUsedJob, Account::UpdateBytesUsedJob ]
+    end
+
+    def attach_image_to(card)
+      card.image.attach(io: file_fixture("moon.jpg").open, filename: "moon.jpg", content_type: "image/jpeg")
+      card.image.blob
+    end
+
+    def attach_embed_to(container, name)
+      blob = ActiveStorage::Blob.create_and_upload! io: file_fixture("moon.jpg").open, filename: "embed.jpg", content_type: "image/jpeg"
+      container.update!(name => "<p>With an embed: #{ActionText::Attachment.from_attachable(blob).to_html}</p>")
+      blob.reload
+    end
+end
