diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..6cae49a
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,163 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index" do
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_select "h2.search__result-title"
+  end
+
+  test "finds cards by title" do
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_select "li.search__result h2.search__result-title", text: /logo/
+    assert_not_includes response.body, "I want to play my radio at a reasonable volume"
+  end
+
+  test "finds cards by description" do
+    card = cards(:layout)
+    card.update! description: "<p>The grid collapses when the sidebar is #{term} wide</p>"
+
+    get search_path, params: { q: term }
+
+    assert_response :success
+    assert_includes response.body, card_path(card)
+  end
+
+  test "finds cards by the body of any of their comments" do
+    card = cards(:buy_domain)
+    card.comments.create! creator: users(:kevin), body: "<p>I heard the #{term} is taken</p>"
+
+    get search_path, params: { q: term }
+
+    assert_response :success
+    assert_includes response.body, card_path(card)
+  end
+
+  test "wraps matched words in mark elements" do
+    card = cards(:layout)
+    card.update! description: "<p>The sidebar is #{term} wide</p>"
+
+    get search_path, params: { q: term }
+
+    assert_response :success
+    assert_select "mark", text: term
+  end
+
+  test "matches are case-insensitive" do
+    get search_path, params: { q: "LOGO" }
+
+    assert_response :success
+    assert_select "li.search__result h2.search__result-title", text: /logo/
+  end
+
+  test "requires every term of the search to match" do
+    get search_path, params: { q: "#{term} bubbly" }
+
+    assert_response :success
+    assert_not_includes response.body, "The logo isn't big enough"
+  end
+
+  test "orders results newest first" do
+    older = create_card(title: "Ancient #{term}", created_at: 3.days.ago)
+    newer = create_card(title: "Recent #{term}", created_at: 1.day.ago)
+
+    get search_path, params: { q: term }
+
+    assert_response :success
+    assert_ordered [ newer, older ], response.body
+  end
+
+  test "only shows cards from boards the person has access to" do
+    card = create_card(boards(:private), title: "Secret #{term}")
+
+    get search_path, params: { q: term }
+    assert_includes response.body, card_path(card)
+
+    logout_and_sign_in_as :david
+
+    get search_path, params: { q: term }
+    assert_not_includes response.body, card_path(card)
+  end
+
+  test "draft cards never turn up" do
+    create_card(title: "Unfinished #{term}", status: :drafted)
+
+    get search_path, params: { q: term }
+
+    assert_response :success
+    assert_not_includes response.body, "Unfinished"
+  end
+
+  test "comments on draft cards never turn up" do
+    draft = create_card(title: "A draft with comments")
+    draft.comments.create! creator: users(:kevin), body: "<p>Thinking about the #{term}</p>"
+    draft.update! status: :drafted
+
+    get search_path, params: { q: term }
+
+    assert_response :success
+    assert_not_includes response.body, "Thinking about the"
+  end
+
+  test "cards from other accounts never turn up" do
+    get search_path, params: { q: "radio" }
+
+    assert_response :success
+    assert_not_includes response.body, "I want to play my radio at a reasonable volume"
+  end
+
+  test "shows snippets of the matching description and comments" do
+    card = cards(:logo)
+    card.update! description: "<p>The whole thing is about #{term} sizes</p>"
+    card.comments.create! creator: users(:jz), body: "<p>Can we afford a #{term} like that?</p>"
+
+    get search_path, params: { q: term }
+
+    assert_select "li.search__result .search__result-snippet", text: /#{term}/, count: 2
+  end
+
+  test "renders a blank slate when nothing matches" do
+    get search_path, params: { q: "bubbly" }
+
+    assert_response :success
+    assert_includes response.body, "No cards match"
+  end
+
+  test "renders the search field without results when there is no term" do
+    get search_path
+
+    assert_response :success
+    assert_not_includes response.body, "No cards match"
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    get search_path, params: { q: "logo" }
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  private
+    def term
+      "ungular"
+    end
+
+    def create_card(board = boards(:writebook), title:, created_at: Time.current, status: :published)
+      Current.with(user: users(:kevin)) do
+        board.cards.create! title: title, creator: users(:kevin), created_at: created_at, status: status
+      end
+    end
+
+    def assert_ordered(cards, body)
+      positions = cards.collect { |card| body.index(card_path(card)) }
+      assert_equal positions.sort, positions, "Expected cards in order: #{cards.collect(&:title).inspect}"
+    end
+end
diff --git a/test/models/search_test.rb b/test/models/search_test.rb
new file mode 100644
index 0000000..c065fd1
--- /dev/null
+++ b/test/models/search_test.rb
@@ -0,0 +1,125 @@
+require "test_helper"
+
+class SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:kevin)
+  end
+
+  test "finds cards by title" do
+    assert_includes search("logo").cards, cards(:logo)
+  end
+
+  test "finds cards by description" do
+    cards(:layout).update! description: "<p>Everything is #{term} in there</p>"
+
+    assert_includes search(term).cards, cards(:layout)
+  end
+
+  test "finds cards by the body of any of their comments" do
+    cards(:buy_domain).comments.create! creator: users(:kevin), body: "<p>The #{term} is free</p>"
+
+    assert_includes search(term).cards, cards(:buy_domain)
+  end
+
+  test "finds cards matching every term of the search, whatever the field they are in" do
+    cards(:layout).update! description: "<p>Everything is #{term} in there</p>"
+
+    assert_includes search("#{term} broken").cards, cards(:layout)
+    assert_not_includes search("#{term} bubbly").cards, cards(:layout)
+  end
+
+  test "matches are case-insensitive" do
+    assert_includes search("LOGO").cards, cards(:logo)
+  end
+
+  test "orders cards newest first" do
+    oldest = create_card("Older #{term}", created_at: 2.days.ago)
+    newest = create_card("Newer #{term}", created_at: 1.day.ago)
+
+    assert_equal [ newest, oldest ], search(term).cards.to_a
+  end
+
+  test "ignores draft cards" do
+    create_card("A draft #{term}", status: :drafted)
+
+    assert_not_includes search(term).cards, Card.find_by(title: "A draft #{term}")
+  end
+
+  test "ignores the comments of draft cards" do
+    draft = create_card("A draft", status: :published)
+    draft.comments.create! creator: users(:kevin), body: "<p>The #{term} is here</p>"
+    draft.update! status: :drafted
+
+    assert_empty search(term).cards
+  end
+
+  test "only finds cards on boards the person has access to" do
+    create_card(boards(:private), "Secret #{term}")
+
+    assert_includes search(term).cards, Card.find_by(title: "Secret #{term}")
+    assert_empty Search.new(user: users(:david), term: term).cards
+  end
+
+  test "matches nothing when there is no term" do
+    assert_empty search("").cards
+    assert_empty search("   ").cards
+  end
+
+  test "terms are the individual words of the search" do
+    assert_equal %w[ the logo ], search("  the   logo ").terms
+  end
+
+  test "matching snippets are excerpts of the matching description and comments" do
+    card = cards(:logo)
+    card.update! description: "<p>The #{term} sizes are off</p>"
+    card.comments.create! creator: users(:jz), body: "<p>What about the #{term} sizes?</p>"
+
+    assert_equal [ "The #{term} sizes are off", "What about the #{term} sizes?" ], search(term).matching_snippets_for(card)
+  end
+
+  test "matching snippets are excerpts around the match" do
+    card = cards(:logo)
+    words = %w[ before ] + Array.new(Search::EXCERPT_RADIUS, "filler") + [ term ] + Array.new(Search::EXCERPT_RADIUS, "filler") + %w[ more filler ]
+    card.update! description: "<p>#{words.join(" ")}</p>"
+
+    snippet = [ Search::ELLIPSIS, words.slice(1, Search::EXCERPT_RADIUS * 2 + 1).join(" "), Search::ELLIPSIS ].join(" ")
+
+    assert_equal snippet, search(term).matching_snippets_for(card).sole
+  end
+
+  test "matching snippets are limited" do
+    card = cards(:logo)
+    5.times { |index| card.comments.create! creator: users(:kevin), body: "<p>Comment #{index} about the #{term}</p>" }
+
+    assert_equal Search::SNIPPETS_LIMIT, search(term).matching_snippets_for(card).size
+  end
+
+  test "matches accented words regardless of case" do
+    cards(:logo).update! title: "Le Caf\u00e9 isn't big enough"
+
+    assert_includes search("CAF\u00c9").cards, cards(:logo)
+  end
+
+  test "does not treat SQL wildcards in the term as wildcards" do
+    cards(:layout).update! description: "<p>Everything is 100% ungular</p>"
+    cards(:text).update! description: "<p>Everything is ungular</p>"
+
+    assert_includes search("100%").cards, cards(:layout)
+    assert_not_includes search("100%").cards, cards(:text)
+  end
+
+  private
+    def term
+      "ungular"
+    end
+
+    def search(term)
+      Search.new(user: users(:kevin), term: term)
+    end
+
+    def create_card(board = boards(:writebook), title, created_at: Time.current, status: :published)
+      Current.with(user: users(:kevin)) do
+        board.cards.create! title: title, creator: users(:kevin), created_at: created_at, status: status
+      end
+    end
+end
