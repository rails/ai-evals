diff --git a/app/views/searches/index.html.erb b/app/views/searches/index.html.erb
new file mode 100644
index 0000000..8c8134d
--- /dev/null
+++ b/app/views/searches/index.html.erb
@@ -0,0 +1,45 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <div class="header__actions header__actions--start">
+    <%= back_link_to "Home", root_path, "keydown.left@document->hotkey#click keydown.esc@document->hotkey#click" %>
+  </div>
+
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="search panel panel--wide flex center borderless unpad flex-column gap margin-block-start">
+  <div class="search__field panel pad">
+    <%= form_with url: search_path, method: :get, class: "flex full-width" do |form| %>
+      <%= form.search_field :q, value: @search.term, placeholder: "Search cards by title, description, or comment…",
+        class: "input input--transparent full-width txt-medium", autofocus: true, autocorrect: "off", autocomplete: "off",
+        aria: { label: "Search" }, data: { "1p-ignore": "true" } %>
+      <%= form.button class: "btn btn--circle borderless", name: nil do %>
+        <%= icon_tag "search" %> <span class="for-screen-reader">Search</span>
+      <% end %>
+    <% end %>
+  </div>
+
+  <% if @search.term.present? %>
+    <% if @page.records.any? %>
+      <%= with_automatic_pagination :search_results, @page do %>
+        <ul class="search__results flex flex-column unpad">
+          <% @page.records.each do |card| %>
+            <li class="search__result panel pad" id="<%= dom_id(card, :search_result) %>">
+              <%= link_to card_path(card), class: "search__result-link", data: { turbo_frame: "_top" } do %>
+                <span class="search__result-board overflow-ellipsis"><%= card.board.name %></span>
+                <h2 class="search__result-title"><%= highlight card.title, @search.terms %></h2>
+              <% end %>
+
+              <% @search.matching_snippets_for(card).each do |snippet| %>
+                <p class="search__result-snippet txt-tight-lines txt-small"><%= highlight snippet, @search.terms %></p>
+              <% end %>
+            </li>
+          <% end %>
+        </ul>
+      <% end %>
+    <% else %>
+      <div class="blank-slate">No cards match &ldquo;<%= @search.term %>&rdquo;</div>
+    <% end %>
+  <% end %>
+</section>
