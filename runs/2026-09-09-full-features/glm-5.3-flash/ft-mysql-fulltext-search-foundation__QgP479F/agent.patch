diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..dac4ad4
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,106 @@
+class Search
+  TERM_SEPARATOR = /\s+/
+  SQL_ESCAPE_CHARACTER = "!"
+  EXCERPT_RADIUS = 6 # Words shown on each side of a match
+  SNIPPETS_LIMIT = 3
+  ELLIPSIS = "\u2026"
+
+  attr_reader :user, :term
+
+  def initialize(user:, term: nil)
+    @user = user
+    @term = term.to_s.strip
+  end
+
+  # The published cards on the boards the person has access to that contain every
+  # term of the search in their title, their description, or the body of any of
+  # their comments, newest first.
+  def cards
+    terms.reduce(scope) { |cards, term| cards.where(containing(term)) }
+  end
+
+  # Excerpts of the card's description and of the bodies of its comments that
+  # match the search.
+  def matching_snippets_for(card)
+    searchable_text_of(card).filter_map { |text| excerpt_from text if matches?(text) }.first(SNIPPETS_LIMIT)
+  end
+
+  # The individual words of the search, the ones to be highlighted in the results.
+  def terms
+    term.split(TERM_SEPARATOR)
+  end
+
+  private
+    def scope
+      if terms.empty?
+        user.accessible_cards.none
+      else
+        user.accessible_cards.published.reverse_chronologically
+      end
+    end
+
+    def searchable_text_of(card)
+      [ card.description&.to_plain_text,
+        *card.comments.preloaded.collect { |comment| comment.body&.to_plain_text } ].compact_blank
+    end
+
+    def containing(term)
+      pattern = "%#{sanitize_sql_like(term.downcase)}%"
+
+      Card.arel_table[:title].lower.matches(pattern, SQL_ESCAPE_CHARACTER)
+        .or(descriptions_containing(pattern))
+        .or(comments_containing(pattern))
+    end
+
+    def descriptions_containing(pattern)
+      rich_texts = ActionText::RichText.arel_table
+
+      ActionText::RichText
+        .where(rich_texts[:name].eq("description"))
+        .where(rich_texts[:record_type].eq("Card"))
+        .where(rich_texts[:record_id].eq(Card.arel_table[:id]))
+        .where(rich_texts[:body].lower.matches(pattern, SQL_ESCAPE_CHARACTER)).arel.exists
+    end
+
+    def comments_containing(pattern)
+      comments = Comment.arel_table
+      bodies = ActionText::RichText.arel_table
+
+      comments.project(1)
+        .join(bodies)
+        .on(bodies[:record_type].eq("Comment"), bodies[:record_id].eq(comments[:id]), bodies[:name].eq("body"))
+        .where(comments[:card_id].eq(Card.arel_table[:id]).and(bodies[:body].lower.matches(pattern, SQL_ESCAPE_CHARACTER)))
+        .exists
+    end
+
+    def sanitize_sql_like(term)
+      ActiveRecord::Base.sanitize_sql_like term, SQL_ESCAPE_CHARACTER
+    end
+
+    def downcased_terms
+      @downcased_terms ||= terms.collect(&:downcase)
+    end
+
+    def matches?(text)
+      downcased = text.downcase
+      downcased_terms.all? { |term| downcased.include? term }
+    end
+
+    def excerpt_from(text)
+      words = text.split
+      index = index_of_first_matching_word(words)
+
+      if index
+        start = [ index - EXCERPT_RADIUS, 0 ].max
+        excerpt = words.slice(start, EXCERPT_RADIUS * 2 + 1).join(" ")
+
+        [ start.positive? ? ELLIPSIS : nil, excerpt, start + EXCERPT_RADIUS * 2 + 1 < words.size ? ELLIPSIS : nil ].compact.join(" ")
+      else
+        text
+      end
+    end
+
+    def index_of_first_matching_word(words)
+      words.index { |word| downcased_terms.any? { |term| word.downcase.include? term } }
+    end
+end
