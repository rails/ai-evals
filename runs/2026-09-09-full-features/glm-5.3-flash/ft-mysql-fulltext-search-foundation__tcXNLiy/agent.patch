diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..eb4a8b1
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,107 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "finds cards by title" do
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_select "mark", text: /logo/i
+  end
+
+  test "finds cards by description" do
+    cards(:layout).update! description: "The header needs a new font"
+
+    get search_path(q: "font")
+
+    assert_response :success
+    assert_select "mark", text: /font/i
+  end
+
+  test "finds cards by the body of a comment" do
+    get search_path(q: "overflowing")
+
+    assert_response :success
+    assert_select "mark", text: /overflowing/i
+  end
+
+  test "only finds cards on boards you have access to" do
+    with_current_user users(:kevin) do
+      cards(:shipping).update! title: "Radio silence"
+    end
+
+    get search_path(q: "radio")
+
+    assert_response :success
+    assert_select "mark", text: /radio/i
+    assert_select ".search__result", count: 1
+  end
+
+  test "never finds draft cards or their comments" do
+    draft = boards(:writebook).cards.create!(title: "Drafted radio plans", creator: users(:kevin), status: :drafted)
+
+    get search_path(q: "radio plans")
+
+    assert_response :success
+    assert_select "mark", count: 0
+    assert draft.drafted?
+  end
+
+  test "finds cards matching every term" do
+    get search_path(q: "logo big")
+
+    assert_response :success
+    assert_select "mark", text: /logo/i
+    assert_select "mark", text: /big/i
+  end
+
+  test "sorts results newest first" do
+    oldest = cards(:logo)
+    newest = cards(:shipping)
+    with_current_user users(:kevin) do
+      newest.update! title: "The logo needs to be shipped"
+    end
+    newest.update_column :created_at, 1.day.from_now
+
+    get search_path(q: "logo")
+
+    assert_response :success
+    assert_equal [ newest.id, oldest.id ], search_result_ids
+  end
+
+  test "blank query shows no results" do
+    get search_path
+
+    assert_response :success
+    assert_select ".blank-slate", text: /Type what you.re looking for/
+    assert_select ".search__result", count: 0
+  end
+
+  test "query without matches shows no results" do
+    get search_path(q: "haggis")
+
+    assert_response :success
+    assert_select ".blank-slate", text: /No cards match/
+    assert_select ".search__result", count: 0
+  end
+
+  test "requires authentication" do
+    sign_out
+
+    get search_path(q: "logo")
+
+    assert_redirected_to new_session_path(script_name: nil)
+  end
+
+  private
+    def search_result_ids
+      css_select(".search__result-link").collect { |link| card_id_from(link[:href]) }
+    end
+
+    def card_id_from(path)
+      Card.find_by(number: path.split("/").last).id
+    end
+end
diff --git a/test/models/card/search_test.rb b/test/models/card/search_test.rb
