+++ b/test/models/card/search_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Card::SearchTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "finds cards by title" do
+    assert_includes search_cards("logo"), cards(:logo)
+  end
+
+  test "finds cards by description" do
+    with_current_user users(:david) do
+      cards(:shipping).update! description: "Preferably before the weekend"
+    end
+
+    assert_includes search_cards("weekend"), cards(:shipping)
+  end
+
+  test "finds cards by the body of any comment on them" do
+    assert_includes search_cards("overflowing"), cards(:layout)
+  end
+
+  test "finds cards matching all the terms, wherever they are" do
+    assert_includes search_cards("overflowing container"), cards(:layout)
+    assert_not_includes search_cards("overflowing weekend"), cards(:layout)
+  end
+
+  test "only finds cards on boards you have access to" do
+    assert_not_includes search_cards("paycheck"), cards(:paycheck)
+    assert_includes Card::Search.new(users(:mike), "paycheck").cards, cards(:paycheck)
+  end
+
+  test "never finds draft cards" do
+    draft = boards(:writebook).cards.create!(title: "Unfinished radio thoughts", creator: users(:david))
+
+    assert draft.drafted?
+    assert_not_includes search_cards("unfinished radio thoughts"), draft
+  end
+
+  test "never finds comments on draft cards" do
+    card = boards(:writebook).cards.create!(title: "Radio plans", creator: users(:david), status: :published)
+    card.comments.create!(creator: users(:david), body: "Remember to bring the radio")
+    card.update! status: :drafted
+
+    assert_not_includes search_cards("remember to bring"), card
+  end
+
+  test "finds cards newest first" do
+    with_current_user users(:david) do
+      cards(:buy_domain).update! title: "Logo for the landing page"
+    end
+    cards(:buy_domain).update_column :created_at, 1.day.from_now
+
+    assert_equal [ cards(:buy_domain), cards(:logo) ], search_cards("logo")
+  end
+
+  test "is empty without terms" do
+    assert Card::Search.new(users(:david), "  ").empty?
+    assert Card::Search.new(users(:david), nil).cards.none?
+  end
+
+  private
+    def search_cards(term)
+      Card::Search.new(users(:david), term).cards
+    end
+end
