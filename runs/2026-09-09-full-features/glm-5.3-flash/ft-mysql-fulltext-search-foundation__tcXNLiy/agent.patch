+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title divider divider--fade full-width" data-bridge--title-target="header">
+    <span>Search</span>
+  </h1>
+
+  <div class="header__actions header__actions--end">
+    <%= form_with url: search_path, method: :get, class: "search__form" do %>
+      <%= label_tag :q, "Search cards", class: "for-screen-reader" %>
+      <%= text_field_tag :q, @search.query,
+            placeholder: "Search cards \u2026", class: "input", type: "search",
+            autocorrect: "off", autocapitalize: "off", autocomplete: "off", spellcheck: false,
+            "aria-label": "Search cards", data: { "1p-ignore": "true" } %>
+      <button class="btn btn--positive">Search</button>
+    <% end %>
+  </div>
+<% end %>
+
+<%= turbo_frame_tag :search_results do %>
+  <section class="search">
+    <% if @search.empty? %>
+      <div class="blank-slate">Type what you&rsquo;re looking for</div>
+    <% elsif @page.records.empty? %>
+      <div class="blank-slate">No cards match &ldquo;<%= @search.query %>&rdquo;</div>
+    <% else %>
+      <%= with_automatic_pagination :search_results, @page do %>
+        <%= render "searches/results", cards: @page.records %>
+      <% end %>
+    <% end %>
+  </section>
+<% end %>
