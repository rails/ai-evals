@@ -0,0 +1,57 @@
+module SearchesHelper
+  EXCERPT_LENGTH = 160
+
+  # Wraps every occurrence of the searched terms in <mark> tags.
+  def highlight_matches(text, terms)
+    return "" if text.blank?
+
+    content = ERB::Util.html_escape(text)
+    if terms.any?
+      content = content.gsub(search_pattern(terms)) { tag.mark(Regexp.last_match(0)) }
+    end
+
+    content.html_safe
+  end
+
+  # Shows the part of the card content that matched, so that people can see why a card turned up.
+  def search_excerpt(card, terms)
+    if text = searched_text_in(card, terms)
+      highlight_matches(excerpt_around(text, terms), terms)
+    end
+  end
+
+  private
+    def searched_text_in(card, terms)
+      contents = [ card.description&.to_plain_text, *card.comments.collect { |comment| comment.body.to_plain_text } ].compact
+
+      if matched = contents.find { |content| content.match?(search_pattern(terms)) }
+        matched
+      else
+        contents.first
+      end
+    end
+
+    def excerpt_around(text, terms, length: EXCERPT_LENGTH)
+      index = text.index(search_pattern(terms))
+
+      if index
+        start_of_excerpt = [ 0, index - length / 4 ].max
+
+        [ prefix_for(start_of_excerpt), text[start_of_excerpt, length].squish, suffix_for(text, start_of_excerpt, length) ].join
+      else
+        text.squish.first(length)
+      end
+    end
+
+    def prefix_for(start_of_excerpt)
+      "\u2026" if start_of_excerpt > 0
+    end
+
+    def suffix_for(text, start_of_excerpt, length)
+      "\u2026" if start_of_excerpt + length < text.length
+    end
+
+    def search_pattern(terms)
+      /#{terms.collect { |term| Regexp.escape(term) }.join("|")}/i
+    end
+end
