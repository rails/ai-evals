diff --git a/app/models/card/search.rb b/app/models/card/search.rb
new file mode 100644
index 0000000..221a918
--- /dev/null
+++ b/app/models/card/search.rb
@@ -0,0 +1,30 @@
+class Card::Search
+  TERM_SEPARATOR = /\s+/
+
+  attr_reader :user, :query
+
+  def initialize(user, query)
+    @user, @query = user, query.to_s
+  end
+
+  def cards
+    @cards ||= if empty?
+      Card.none
+    else
+      terms.reduce(accessible_cards) { |cards, term| cards.where(id: Card.matching(term)) }
+    end
+  end
+
+  def terms
+    @terms ||= query.split(TERM_SEPARATOR).reject(&:blank?)
+  end
+
+  def empty?
+    terms.empty?
+  end
+
+  private
+    def accessible_cards
+      user.accessible_cards.published.reverse_chronologically.preloaded.preload(comments: :rich_text_body)
+    end
+end
