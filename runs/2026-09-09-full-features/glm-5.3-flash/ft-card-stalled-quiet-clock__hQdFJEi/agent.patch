diff --git a/test/models/card/bursts_test.rb b/test/models/card/bursts_test.rb
new file mode 100644
index 0000000..1a716e3
--- /dev/null
+++ b/test/models/card/bursts_test.rb
@@ -0,0 +1,147 @@
+require "test_helper"
+
+class Card::BurstsTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = boards(:writebook).cards.create! title: "Bursty card", creator: users(:david), status: :published
+  end
+
+  test "three comments from two people burst the card" do
+    comment_as users(:david)
+    comment_as users(:jz)
+    assert_not_predicate @card.reload, :bursted?
+
+    comment_as users(:david)
+    assert_predicate @card.reload, :bursted?
+  end
+
+  test "three comments from one person do not burst the card" do
+    3.times { comment_as users(:david) }
+
+    assert_not_predicate @card.reload, :bursted?
+  end
+
+  test "system comments do not count towards a burst" do
+    2.times { comment_as users(:david) }
+    3.times { comment_as users(:system) }
+
+    assert_not_predicate @card.reload, :bursted?
+  end
+
+  test "comments spread over more than a third of the auto-postpone period do not burst the card" do
+    burst_window = (@card.board.auto_postpone_period / 3.0).seconds
+
+    comment_as users(:david), at: burst_window.ago - 1.hour
+    comment_as users(:jz), at: 1.hour.ago
+    comment_as users(:david), at: Time.current
+
+    assert_not_predicate @card.reload, :bursted?
+  end
+
+  test "comments landing within a third of the auto-postpone period burst the card" do
+    burst_window = (@card.board.auto_postpone_period / 3.0).seconds
+
+    comment_as users(:david), at: burst_window.ago + 1.hour
+    comment_as users(:jz), at: 1.hour.ago
+    comment_as users(:david), at: Time.current
+
+    assert_predicate @card.reload, :bursted?
+  end
+
+  test "assigning the card bursts it" do
+    assert_not_predicate @card, :bursted?
+
+    @card.toggle_assignment(users(:jason))
+
+    assert_predicate @card.reload, :bursted?
+  end
+
+  test "reopening the card bursts it" do
+    @card.close
+    assert_not_predicate @card.reload, :bursted?
+
+    @card.reopen
+
+    assert_predicate @card.reload, :bursted?
+  end
+
+  test "a burst is only recorded once" do
+    burst_the_card
+    bursted_at = @card.reload.bursted_at
+
+    comment_as users(:kevin), at: 1.minute.from_now
+
+    assert_equal bursted_at, @card.reload.bursted_at
+  end
+
+  test "a card that had a burst and has been quiet for two weeks is stalled" do
+    burst_the_card
+
+    assert_not_predicate @card.reload, :stalled?
+
+    travel_to 2.weeks.from_now + 1.minute do
+      assert_predicate @card.reload, :stalled?
+    end
+  end
+
+  test "a card that never bursted is never stalled" do
+    @card.update! last_active_at: 3.weeks.ago
+
+    assert_not_predicate @card, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "any activity resets the stall" do
+    burst_the_card
+
+    travel_to 2.weeks.from_now + 1.minute do
+      assert_predicate @card.reload, :stalled?
+
+      comment_as users(:david)
+      assert_not_predicate @card.reload, :stalled?
+    end
+  end
+
+  test "closed and postponed cards are not stalled" do
+    burst_the_card
+
+    travel_to 3.weeks.from_now do
+      @card.close
+      assert_not_predicate @card.reload, :stalled?
+
+      @card.reopen
+      @card.postpone(user: users(:david))
+      assert_not_predicate @card.reload, :stalled?
+    end
+
+    assert_not_includes Card.stalled, @card.reload
+  end
+
+  test "stalled scope returns stalled cards from every board" do
+    burst_the_card
+    burst_the_card cards(:buy_domain)
+
+    travel_to 3.weeks.from_now do
+      assert_equal [ @card.reload.id, cards(:buy_domain).id ].sort, Card.stalled.pluck(:id).sort
+    end
+  end
+
+  test "stalled scope works across accounts" do
+    peter = accounts(:initech).users.create! name: "Peter", identity: identities(:david), role: :member, verified_at: Time.current
+    burst_the_card cards(:radio), users(:mike), peter, users(:mike)
+
+    travel_to 3.weeks.from_now do
+      assert_includes Card.stalled, cards(:radio)
+    end
+  end
+
+  private
+    def comment_as(user, at: Time.current, card: @card)
+      card.comments.create! creator: user, body: "Something to say", created_at: at
+    end
+
+    def burst_the_card(card = @card, *people)
+      people = [ users(:david), users(:jz), users(:david) ] if people.empty?
+      people.each { |person| comment_as person, card: card }
+    end
+end
