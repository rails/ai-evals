diff --git a/app/models/card/bursts.rb b/app/models/card/bursts.rb
new file mode 100644
index 0000000..b230d86
--- /dev/null
+++ b/app/models/card/bursts.rb
@@ -0,0 +1,44 @@
+module Card::Bursts
+  extend ActiveSupport::Concern
+
+  BURST_COMMENTS = 3
+  BURST_COMMENTERS = 2
+  STALL_PERIOD = 2.weeks
+
+  included do
+    scope :bursted, -> { where.not(bursted_at: nil) }
+    scope :stalled, -> { active.bursted.where(last_active_at: ..STALL_PERIOD.ago) }
+  end
+
+  def burst_from_event(event)
+    burst at: event.created_at if event.action.card_assigned? || event.action.card_reopened?
+  end
+
+  def burst_from_comment(comment)
+    burst at: comment.created_at if burst_of_comments?(comment)
+  end
+
+  def burst(at: Time.current)
+    update! bursted_at: at unless bursted?
+  end
+
+  def bursted?
+    bursted_at.present?
+  end
+
+  def stalled?
+    active? && bursted? && last_active_at <= STALL_PERIOD.ago
+  end
+
+  private
+    def burst_of_comments?(comment)
+      comments = self.comments.by_user.where(created_at: comment.created_at - burst_period..comment.created_at)
+
+      comments.count >= BURST_COMMENTS && comments.distinct.count(:creator_id) >= BURST_COMMENTERS
+    end
+
+    # A third of the period it takes for the board to auto-postpone a card.
+    def burst_period
+      board.auto_postpone_period / 3.0
+    end
+end
