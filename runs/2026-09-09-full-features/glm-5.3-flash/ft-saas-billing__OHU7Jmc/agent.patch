+<% @page_title = @account.name %>
+
+<% content_for :header do %>
+  <h1 class="header__title">
+    <%= @page_title %>
+    <div class="txt-normal font-weight-normal">#<%= @account.external_account_id %></div>
+  </h1>
+<% end %>
+
+<section class="settings">
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Plan</h2>
+        <div>
+          <strong><%= @plan.name %></strong> &mdash; <%= @plan.description %>
+          <% if @account.comped? %>
+            <span class="txt-x-small txt-ink-medium">comped</span>
+          <% end %>
+        </div>
+      </header>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Usage</h2>
+        <div>
+          <strong><%= number_with_delimiter(@account.cards_used) %></strong> cards
+          &bull;
+          <strong><%= number_to_human_size(@account.bytes_used) %></strong>
+          of <%= number_to_human_size(@account.storage_limit) %> storage
+        </div>
+      </header>
+
+      <% if @account.overridden? %>
+        <div class="txt-x-small txt-ink-medium margin-block-start-quarter">
+          Overridden by support.
+        </div>
+      <% end %>
+    </section>
+
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Owner</h2>
+        <div>
+          <%= @account.users.owner.first&.name || "No owner" %>
+          &lt;<%= @account.users.owner.first&.identity&.email_address || "no email" %>&gt;
+        </div>
+      </header>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Billing</h2>
+        <div>Comp this account and it gets the paid product without paying for it.</div>
+      </header>
+
+      <div class="flex gap justify-start">
+        <%= button_to "Comp", saas.comp_admin_account_path(@account), class: "btn" %>
+        <%= button_to "Uncomp", saas.uncomp_admin_account_path(@account), class: "btn" %>
+      </div>
+    </section>
+  </div>
+
+  <div class="settings__panel panel shadow">
+    <section class="settings__section">
+      <header>
+        <h2 class="divider">Override</h2>
+        <div>Set what this account is measured to have used. Leave a field blank to stop overriding it.</div>
+      </header>
+
+      <%= form_with url: saas.override_admin_account_path(@account), method: :post, scope: :overridden_limit,
+            data: { controller: "form" }, class: "flex flex-column gap" do |form| %>
+        <div class="flex gap-half">
+          <label class="flex-item-grow flex flex-column gap-quarter">
+            <span class="txt-x-small">Card count</span>
+            <%= form.number_field :card_count, class: "input", min: 0, value: @account.overridden_limit&.card_count %>
+          </label>
+
+          <label class="flex-item-grow flex flex-column gap-quarter">
+            <span class="txt-x-small">Bytes used</span>
+            <%= form.number_field :bytes_used, class: "input", min: 0, value: @account.overridden_limit&.bytes_used %>
+          </label>
+        </div>
+
+        <div class="flex gap justify-start">
+          <%= form.button "Override", class: "btn" %>
+        </div>
+      <% end %>
+
+      <div class="flex gap justify-start">
+        <%= button_to "Reset", saas.reset_admin_account_path(@account), class: "btn btn--plain" %>
+      </div>
+    </section>
+  </div>
+</section>
