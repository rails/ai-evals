@@ -0,0 +1,25 @@
+require "test_helper"
+
+class Notifications::EmailFrequenciesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+
+    sign_in_as @user
+  end
+
+  test "update picks a frequency" do
+    assert_changes -> { @user.settings.reload.bundle_email_frequency }, from: "never", to: "daily" do
+      patch notifications_email_frequency_path, params: { bundle_email_frequency: "daily" }
+    end
+
+    assert_redirected_to notifications_settings_path
+  end
+
+  test "update ignores frequencies that do not exist" do
+    assert_no_changes -> { @user.settings.reload.bundle_email_frequency } do
+      patch notifications_email_frequency_path, params: { bundle_email_frequency: "hourly" }
+    end
+
+    assert_response :unprocessable_entity
+  end
+end
