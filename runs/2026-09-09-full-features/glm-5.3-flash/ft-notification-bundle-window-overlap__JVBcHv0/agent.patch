diff --git a/app/mailers/notification_mailer.rb b/app/mailers/notification_mailer.rb
new file mode 100644
index 0000000..efa0459
--- /dev/null
+++ b/app/mailers/notification_mailer.rb
@@ -0,0 +1,38 @@
+class NotificationMailer < ApplicationMailer
+  helper_method :bundle_period
+
+  def bundle(email_bundle)
+    @bundle = email_bundle
+    @notifications = email_bundle.notifications.preloaded.order(updated_at: :desc)
+
+    mail to: email_bundle.user.identity.email_address, subject: subject
+  end
+
+  private
+    def subject
+      if @notifications.size == 1
+        "1 new notification"
+      else
+        "#{@notifications.size} new notifications"
+      end
+    end
+
+    def bundle_period
+      starts_at = @bundle.starts_at
+      ends_at = @bundle.ends_at
+
+      if starts_at.to_date == ends_at.to_date
+        "#{time(starts_at)} and #{time(ends_at)} on #{date(starts_at)}"
+      else
+        "#{date(starts_at)} at #{time(starts_at)} and #{date(ends_at)} at #{time(ends_at)}"
+      end
+    end
+
+    def date(datetime)
+      datetime.strftime("%B %e").squeeze(" ")
+    end
+
+    def time(datetime)
+      datetime.strftime("%l:%M%P").strip
+    end
+end
