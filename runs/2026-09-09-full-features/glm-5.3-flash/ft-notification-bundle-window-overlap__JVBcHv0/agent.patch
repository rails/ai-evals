diff --git a/app/models/notification/email_bundle.rb b/app/models/notification/email_bundle.rb
new file mode 100644
index 0000000..5f344d5
--- /dev/null
+++ b/app/models/notification/email_bundle.rb
@@ -0,0 +1,127 @@
+class Notification::EmailBundle < ApplicationRecord
+  # How long a window stays open for each frequency a person can pick.
+  DURATIONS = {
+    "every_few_hours" => 4.hours,
+    "daily" => 1.day,
+    "weekly" => 1.week
+  }
+
+  belongs_to :account, default: -> { user.account }
+  belongs_to :user
+  has_many :notifications, inverse_of: :email_bundle, dependent: :nullify
+
+  validates :frequency, inclusion: { in: DURATIONS.keys }
+  validates :starts_at, :ends_at, presence: true
+  validate :does_not_overlap_other_bundles
+
+  scope :delivered, -> { where.not(delivered_at: nil) }
+  scope :pending, -> { where(delivered_at: nil) }
+  scope :due, -> { pending.where(ends_at: ..Time.current) }
+  scope :overlapping, ->(starts_at, ends_at) { where("starts_at < ? AND ends_at > ?", ends_at, starts_at) }
+
+  before_validation :set_ends_at
+
+  class << self
+    # Files a notification in the window that is already open. The clock starts
+    # when the first notification lands, so one that arrives late joins the
+    # window that opened before it landed instead of opening a new one in the
+    # past. A window only opens once the previous one ended, and the person is
+    # locked while looking, so nobody ever ends up holding two overlapping
+    # windows.
+    def bundle(notification)
+      frequency = notification.user.settings&.bundle_email_frequency
+      return unless DURATIONS.key?(frequency)
+
+      notification.email_bundle = window_for(notification, frequency)
+
+      # Straight to the column, so that bundling a notification neither
+      # broadcasts it nor touches it all over again.
+      notification.update_columns(email_bundle_id: notification.email_bundle.id)
+
+      notification.email_bundle
+    end
+
+    def deliver_due
+      due.find_each(&:deliver_later)
+    end
+
+    private
+      # Looked up on the class rather than through the person, whose bundles
+      # have often already been loaded by the time the next one lands.
+      def window_for(notification, frequency)
+        notification.user.lock!
+        latest = where(user: notification.user).order(ends_at: :desc).first
+
+        if latest&.pending? && notification.created_at < latest.ends_at
+          latest
+        else
+          create!(user: notification.user, frequency: frequency, starts_at: next_starts_at(latest, notification))
+        end
+      end
+
+      # A notification that lands after its window was delivered still gets a
+      # window of its own, but one that starts when the previous one ended
+      # rather than in the past it was created in.
+      def next_starts_at(latest, notification)
+        [ notification.created_at, latest&.ends_at ].compact.max
+      end
+  end
+
+  def deliver_later
+    Notification::EmailBundleJob.perform_later(self)
+  end
+
+  def deliver
+    return unless claim
+
+    if deliverable? && notifications.any?
+      Current.with_account(account) do
+        NotificationMailer.bundle(self).deliver_now
+      end
+    end
+  end
+
+  def delivered?
+    delivered_at.present?
+  end
+
+  def pending?
+    !delivered?
+  end
+
+  def duration
+    DURATIONS.fetch(frequency)
+  end
+
+  private
+    def set_ends_at
+      if starts_at && ends_at.blank? && DURATIONS.key?(frequency)
+        self.ends_at = starts_at + duration
+      end
+    end
+
+    # Marks the bundle as delivered before mailing it, so a bundle is never
+    # emailed twice even when a delivery and the sweep race each other.
+    def claim
+      time = Time.current
+      claimed = self.class.where(id: id, delivered_at: nil).update_all(delivered_at: time) == 1
+      self.delivered_at = time
+
+      claimed
+    end
+
+    def deliverable?
+      user.active? && user.identity.present?
+    end
+
+    def does_not_overlap_other_bundles
+      return unless user && starts_at && ends_at
+
+      bundles = self.class.where(user: user).overlapping(starts_at, ends_at)
+      bundles = bundles.where.not(id: id) if id
+
+      if bundles.exists?
+        errors.add(:starts_at, "overlaps another email bundle")
+      end
+    end
+end
