+require "test_helper"
+
+class NotificationMailerTest < ActionMailer::TestCase
+  test "bundle emails the person their notifications for that window" do
+    bundle = Notification::EmailBundle.create!(user: users(:kevin), frequency: "daily", starts_at: 1.day.ago)
+    notifications(:layout_commented_kevin).update!(email_bundle: bundle)
+    notifications(:buy_domain_sent_back_to_triage_kevin).update!(email_bundle: bundle)
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_emails 1 do
+      email.deliver_now
+    end
+
+    assert_equal [ "kevin@37signals.com" ], email.to
+    assert_equal "2 new notifications", email.subject
+    assert_match "Everything that happened between", email.body.encoded
+    assert_match "Buy domain", email.body.encoded
+    assert_match "See all your notifications", email.body.encoded
+  end
+
+  test "bundle subjects a single notification in the singular" do
+    bundle = Notification::EmailBundle.create!(user: users(:kevin), frequency: "daily", starts_at: 1.day.ago)
+    notifications(:layout_commented_kevin).update!(email_bundle: bundle)
+
+    email = NotificationMailer.bundle(bundle)
+
+    assert_equal "1 new notification", email.subject
+  end
+
+  test "bundle links to the account the notification came from" do
+    bundle = Notification::EmailBundle.create!(user: users(:kevin), frequency: "daily", starts_at: 1.day.ago)
+    notifications(:layout_commented_kevin).update!(email_bundle: bundle)
+
+    email = NotificationMailer.bundle(bundle.reload)
+
+    assert_match cards(:layout).title, email.body.encoded
+    assert_match %r{/#{bundle.account.external_account_id}/cards/}, email.body.encoded
+  end
+end
