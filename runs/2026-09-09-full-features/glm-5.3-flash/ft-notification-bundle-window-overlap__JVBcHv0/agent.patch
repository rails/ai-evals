diff --git a/test/models/notification/email_bundle_test.rb b/test/models/notification/email_bundle_test.rb
new file mode 100644
index 0000000..c116024
--- /dev/null
+++ b/test/models/notification/email_bundle_test.rb
@@ -0,0 +1,235 @@
+require "test_helper"
+
+class Notification::EmailBundleTest < ActiveSupport::TestCase
+  include ActionMailer::TestHelper
+
+  setup do
+    @user = users(:jz)
+  end
+
+  test "the clock starts when the first notification lands" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    notification = nil
+    travel_to Time.zone.local(2026, 7, 10, 10, 0, 0) do
+      notification = create_notification
+    end
+
+    bundle = notification.reload.email_bundle
+
+    assert_equal notification.created_at, bundle.starts_at
+    assert_equal notification.created_at + 4.hours, bundle.ends_at
+    assert_equal "every_few_hours", bundle.frequency
+    assert bundle.pending?
+  end
+
+  test "later notifications are bundled in the window that is already open" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+
+    first = nil
+    second = nil
+    travel_to Time.zone.local(2026, 7, 10, 10, 0, 0) do
+      first = create_notification
+    end
+    travel_to Time.zone.local(2026, 7, 10, 18, 0, 0) do
+      second = create_notification
+    end
+
+    assert_equal first.reload.email_bundle, second.reload.email_bundle
+    assert_equal 1, @user.email_bundles.count
+  end
+
+  test "notifications that arrive late belong in the window that has already opened" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    notification = nil
+    late = nil
+    travel_to Time.zone.local(2026, 7, 10, 10, 0, 0) do
+      notification = create_notification
+    end
+    travel_to Time.zone.local(2026, 7, 10, 13, 0, 0) do
+      late = create_notification(created_at: 2.hours.ago)
+    end
+
+    assert_equal notification.reload.email_bundle, late.reload.email_bundle
+    assert_equal 1, @user.email_bundles.count
+  end
+
+  test "a window closes for good once it ended" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    travel_to Time.zone.local(2026, 7, 10, 10, 0, 0) do
+      create_notification
+    end
+    travel_to Time.zone.local(2026, 7, 10, 14, 0, 0) do
+      create_notification
+    end
+
+    bundles = @user.email_bundles.order(:starts_at)
+
+    assert_equal [ Time.zone.local(2026, 7, 10, 10, 0, 0), Time.zone.local(2026, 7, 10, 14, 0, 0) ], bundles.map(&:starts_at)
+    assert_equal [ 4.hours, 4.hours ], bundles.map(&:duration)
+  end
+
+  test "a late notification that lands after its window was delivered gets the window that follows" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+
+    travel_to Time.zone.local(2026, 7, 10, 10, 0, 0) do
+      create_notification
+    end
+
+    delivered = @user.email_bundles.sole
+    travel_to Time.zone.local(2026, 7, 10, 14, 0, 0) do
+      delivered.deliver
+    end
+
+    late = nil
+    travel_to Time.zone.local(2026, 7, 10, 15, 0, 0) do
+      late = create_notification(created_at: 2.hours.ago)
+    end
+
+    new_bundle = late.reload.email_bundle
+
+    assert_not_equal delivered, new_bundle
+    assert_equal Time.zone.local(2026, 7, 10, 14, 0, 0), new_bundle.starts_at
+  end
+
+  test "windows never overlap, even when the frequency changes in between" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    travel_to Time.zone.local(2026, 7, 10, 10, 0, 0) do
+      create_notification
+    end
+
+    @user.settings.update!(bundle_email_frequency: "daily")
+    travel_to Time.zone.local(2026, 7, 10, 12, 0, 0) do
+      create_notification
+    end
+
+    @user.settings.update!(bundle_email_frequency: "weekly")
+    travel_to Time.zone.local(2026, 7, 10, 14, 0, 0) do
+      create_notification
+    end
+
+    bundles = @user.email_bundles.order(:starts_at)
+
+    assert_equal 2, bundles.count
+    assert_equal [ 4.hours, 1.week ], bundles.map(&:duration)
+    bundles.each_cons(2) { |before, after| assert before.ends_at <= after.starts_at }
+  end
+
+  test "no windows are opened for people who turned digests off" do
+    @user.settings.update!(bundle_email_frequency: "never")
+
+    notification = create_notification
+
+    assert_nil notification.reload.email_bundle
+    assert_empty @user.email_bundles
+  end
+
+  test "settings default to never" do
+    assert @user.settings.never?
+  end
+
+  test "frequencies are translated for people" do
+    assert_equal [ [ "Off", "never" ], [ "Every four hours", "every_few_hours" ], [ "Daily", "daily" ], [ "Weekly", "weekly" ] ],
+      User::Settings.bundle_email_frequency_options
+  end
+
+  test "deliver emails everything that landed in the window" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+    travel_to Time.zone.local(2026, 7, 10, 10, 0, 0) do
+      create_notification
+      create_notification
+    end
+
+    bundle = @user.email_bundles.sole
+
+    assert_emails 1 do
+      travel_to Time.zone.local(2026, 7, 11, 10, 0, 0) do
+        bundle.deliver
+      end
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "a window is only emailed once" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+    travel_to Time.zone.local(2026, 7, 10, 10, 0, 0) do
+      create_notification
+    end
+
+    bundle = @user.email_bundles.sole
+
+    assert_emails 1 do
+      2.times { bundle.deliver }
+    end
+  end
+
+  test "deliver skips windows that ended up empty" do
+    bundle = Notification::EmailBundle.create!(user: @user, frequency: "daily", starts_at: Time.current)
+
+    assert_emails 0 do
+      bundle.deliver
+    end
+
+    assert bundle.reload.delivered?
+  end
+
+  test "deliver_due emails every window that ended and nothing else" do
+    @user.settings.update!(bundle_email_frequency: "every_few_hours")
+    other = users(:kevin)
+    other.settings.update!(bundle_email_frequency: "daily")
+
+    travel_to Time.zone.local(2026, 7, 10, 10, 0, 0) do
+      create_notification
+      Notification::EmailBundle.create!(user: other, frequency: "daily", starts_at: 1.day.from_now)
+    end
+
+    perform_enqueued_jobs do
+      travel_to Time.zone.local(2026, 7, 10, 14, 0, 0) do
+        Notification::EmailBundle.deliver_due
+      end
+    end
+
+    assert @user.email_bundles.sole.reload.delivered?
+    assert other.email_bundles.sole.reload.pending?
+  end
+
+  test "notifications created by the notifier land in the window too" do
+    @user.settings.update!(bundle_email_frequency: "daily")
+    cards(:layout).watch_by(@user)
+
+    event = nil
+    perform_enqueued_jobs do
+      event = boards(:writebook).events.create!(action: "comment_created", creator: users(:david), eventable: comments(:layout_overflowing_david))
+    end
+
+    notification = @user.notifications.find_by(source: event)
+
+    assert_not_nil notification
+    assert_equal @user.email_bundles.sole, notification.reload.email_bundle
+  end
+
+  test "a notification is not bundled when the person has no settings" do
+    @user.settings.destroy!
+
+    assert_nothing_raised do
+      Notification.create!(user: @user, source: events(:layout_commented), creator: users(:david))
+    end
+
+    assert_empty Notification::EmailBundle.where(user: @user)
+  end
+
+  private
+    def create_notification(created_at: nil)
+      Notification.create!(user: @user, source: next_source, creator: users(:david), created_at: created_at)
+    end
+
+    # A person only ever gets one notification per card, so every notification
+    # in a window comes from a different card.
+    def next_source
+      @sources ||= %i[ layout_commented logo_published buy_domain_sent_back_to_triage text_published shipping_published ].cycle
+      events(@sources.next)
+    end
+end
