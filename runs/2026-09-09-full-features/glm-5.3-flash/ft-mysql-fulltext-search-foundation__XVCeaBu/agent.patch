diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..fedec3b
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,39 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  included do
+    # Cards carrying every word of the term, whether in their title, their
+    # description, or the body of any of their comments.
+    scope :search, ->(term) do
+      if (words = term.to_s.split).any?
+        words.inject(all) { |cards, word| cards.merge(matching(word)) }
+      else
+        none
+      end
+    end
+
+    # Cards whose title, description, or comments contain the word, wherever it
+    # appears within them.
+    scope :matching, ->(word) do
+      pattern = "%#{sanitize_sql_like(word)}%"
+
+      where("cards.title LIKE :pattern", pattern: pattern)
+        .or(where(id: with_description_matching(pattern)))
+        .or(where(id: with_comment_matching(pattern)))
+    end
+  end
+
+  class_methods do
+    def with_description_matching(pattern)
+      ActionText::RichText.where(record_type: name, name: "description")
+        .where("body LIKE :pattern", pattern: pattern)
+        .select(:record_id)
+    end
+
+    def with_comment_matching(pattern)
+      Comment.joins(:rich_text_body)
+        .where("action_text_rich_texts.body LIKE :pattern", pattern: pattern)
+        .select(:card_id)
+    end
+  end
+end
