+/* The page people land on to find cards by what's written on them */
+
+@layer components {
+  .search {
+    inline-size: min(100%, 60ch);
+    margin-inline: auto;
+  }
+
+  .search__form {
+    margin-block-start: 1.5ch;
+  }
+
+  .search__results {
+    list-style: none;
+    margin-block: 2ch;
+    padding-inline: 0;
+    text-align: start;
+  }
+
+  .search__result {
+    border-block-end: 1px solid var(--color-ink-lighter);
+
+    &:first-child {
+      border-block-start: 1px solid var(--color-ink-lighter);
+    }
+  }
+
+  .search__result-link {
+    display: block;
+    padding-block: 1.5ch;
+
+    &:hover {
+      background-color: color-mix(in srgb, var(--color-ink-lighter) 25%, transparent);
+    }
+  }
+
+  .search__result-place {
+    align-items: center;
+    color: var(--color-ink-dark);
+    display: flex;
+    font-size: var(--text-small);
+    gap: 0.5ch;
+  }
+
+  .search__result-icon {
+    inline-size: 1.1em;
+  }
+
+  .search__result-title {
+    font-size: var(--text-medium);
+    font-weight: 500;
+    margin-block: 0.25ch;
+  }
+
+  .search__result-excerpt {
+    color: var(--color-ink-dark);
+    font-size: var(--text-small);
+    margin-block: 0;
+  }
+
+  .search mark {
+    background-color: var(--color-highlight);
+    border-radius: 0.25ch;
+    color: inherit;
+    padding-inline: 0.1ch;
+  }
+}
