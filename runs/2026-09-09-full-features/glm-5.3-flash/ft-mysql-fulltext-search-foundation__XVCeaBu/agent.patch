diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..0eef1ea
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,136 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index shows the search form" do
+    get search_path
+
+    assert_response :success
+    assert_select "form[action='#{search_path}']"
+    assert_select "input[type='search'][name='q']"
+  end
+
+  test "index finds cards by title" do
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_select "li.search__result", count: 1
+    assert_select "li.search__result h2", "The logo isn't big enough"
+  end
+
+  test "index finds cards by description" do
+    with_current_user users(:kevin) do
+      cards(:text).update! description: "Make it bigger, please"
+    end
+
+    get search_path, params: { q: "bigger" }
+
+    assert_response :success
+    assert_select "li.search__result", count: 1
+    assert_select "li.search__result h2", "The text is too small"
+  end
+
+  test "index finds cards by the body of a comment" do
+    cards(:layout).comments.create! creator: users(:kevin), body: "Only on the settings page"
+
+    get search_path, params: { q: "settings" }
+
+    assert_response :success
+    assert_select "li.search__result", count: 1
+    assert_select "li.search__result h2", "Layout is broken"
+  end
+
+  test "index wraps matched words in marks" do
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_select "mark", "logo"
+  end
+
+  test "index highlights the match when it sits deep inside a long description" do
+    with_current_user users(:kevin) do
+      cards(:text).update! description: "#{"Padding " * 60}The needle is in the haystack."
+    end
+
+    get search_path, params: { q: "needle" }
+
+    assert_response :success
+    assert_select "mark", "needle"
+  end
+
+  test "index orders results newest first" do
+    with_current_user users(:kevin) do
+      cards(:buy_domain).update! title: "Another logo idea", created_at: 2.days.ago
+      cards(:shipping).update! title: "A logo, please", created_at: 2.weeks.ago
+    end
+
+    get search_path, params: { q: "logo" }
+
+    assert_response :success
+    assert_equal [ cards(:buy_domain).number, cards(:logo).number, cards(:shipping).number ], result_card_numbers
+  end
+
+  test "index only shows cards from boards you have access to" do
+    with_current_user users(:kevin) do
+      boards(:private).cards.create! title: "A logo for the private board", status: "published"
+    end
+
+    logout_and_sign_in_as :jz
+    get search_path, params: { q: "private board" }
+
+    assert_response :success
+    assert_select "li.search__result", count: 0
+  end
+
+  test "index never shows draft cards or their comments" do
+    draft = with_current_user(users(:kevin)) do
+      boards(:writebook).cards.create! title: "A drafted logo", status: "drafted"
+    end
+    comment = draft.comments.build(creator: users(:kevin), account: accounts("37s"))
+    comment.save! validate: false
+    ActionText::RichText.create! record: comment, name: "body", body: "A comment on the drafted logo", account: accounts("37s")
+
+    get search_path, params: { q: "drafted logo" }
+
+    assert_response :success
+    assert_select "li.search__result", count: 0
+  end
+
+  test "index shows a blank slate when nothing matches" do
+    get search_path, params: { q: "nothing matches this" }
+
+    assert_response :success
+    assert_select "li.search__result", count: 0
+    assert_select ".search .blank-slate", "No cards match 'nothing matches this'"
+  end
+
+  test "index shows the form without results when there is no term" do
+    get search_path, params: { q: "" }
+
+    assert_response :success
+    assert_select "li.search__result", count: 0
+    assert_select ".search .blank-slate", count: 0
+  end
+
+  test "index is safe to search for html" do
+    get search_path, params: { q: "<script>alert('x')</script>" }
+
+    assert_response :success
+    assert_no_match(/<script>/, @response.body)
+  end
+
+  test "my menu links to the search page" do
+    get my_menu_path
+
+    assert_response :success
+    assert_select "a[href='#{search_path}']"
+  end
+
+  private
+    def result_card_numbers
+      css_select("li.search__result .search__result-place").map { |place| place.text[/#(\d+)/, 1].to_i }
+    end
+end
diff --git a/test/models/card_search_test.rb b/test/models/card_search_test.rb
new file mode 100644
index 0000000..acfcfa4
--- /dev/null
+++ b/test/models/card_search_test.rb
@@ -0,0 +1,41 @@
+require "test_helper"
+
+class CardSearchTest < ActiveSupport::TestCase
+  test "finds cards by title" do
+    assert_includes Card.search("logo"), cards(:logo)
+  end
+
+  test "finds cards by description" do
+    card = cards(:logo)
+    card.update! description: "Bigger is better"
+
+    assert_includes Card.search("bigger"), card
+  end
+
+  test "finds cards by comment body" do
+    card = cards(:logo)
+    card.comments.create! creator: users(:kevin), body: "What about the favicon?"
+
+    assert_includes Card.search("favicon"), card
+  end
+
+  test "requires every word to match" do
+    card = cards(:logo)
+
+    assert_includes Card.search("logo big"), card
+    assert_not_includes Card.search("logo missing"), card
+  end
+
+  test "matches within words" do
+    assert_includes Card.search("ogo"), cards(:logo)
+  end
+
+  test "matches case-insensitively" do
+    assert_includes Card.search("LOGO"), cards(:logo)
+  end
+
+  test "blank term matches nothing" do
+    assert_empty Card.search("")
+    assert_empty Card.search("   ")
+  end
+end
