diff --git a/app/helpers/search_helper.rb b/app/helpers/search_helper.rb
new file mode 100644
index 0000000..36dad10
--- /dev/null
+++ b/app/helpers/search_helper.rb
@@ -0,0 +1,60 @@
+module SearchHelper
+  EXCERPT_LENGTH = 200
+
+  # The term someone searched for, if any.
+  def search_term
+    params[:q].to_s.strip
+  end
+
+  def search_words
+    search_term.split
+  end
+
+  # The text with every searched word wrapped in a mark, so it's easy to see why
+  # a result matched.
+  def highlighted_text(text)
+    return "" if text.blank? || search_words.none?
+
+    ERB::Util.html_escape(text).gsub(matching_pattern) { tag.mark(it) }.html_safe
+  end
+
+  # An excerpt from the description or the comment that matched, falling back to
+  # the description when the card only matched on its title.
+  def search_excerpt_for(card)
+    return unless (text = excerpt_text_for(card))
+
+    highlighted_text(format_excerpt(text, length: EXCERPT_LENGTH)).presence
+  end
+
+  private
+    def matching_pattern
+      @matching_pattern ||= Regexp.new(
+        search_words.map { Regexp.escape(ERB::Util.html_escape(it)) }.join("|"),
+        Regexp::IGNORECASE
+      )
+    end
+
+    def excerpt_text_for(card)
+      text = [ card.description&.to_plain_text, *card.comments.map { it.body.to_plain_text } ]
+        .compact.find { text_matches?(it) } || card.description&.to_plain_text
+
+      text && excerpt_around_first_match(text)
+    end
+
+    def text_matches?(text)
+      downcased = text.downcase
+      search_words.all? { downcased.include?(it.downcase) }
+    end
+
+    # Skips ahead to the part of a text that holds the first match, since an
+    # excerpt cut off before it wouldn't show why the card was found.
+    def excerpt_around_first_match(text)
+      return text if text.length <= EXCERPT_LENGTH * 2
+
+      if (offset = text.downcase.index(search_words.first.to_s.downcase))
+        text[[ offset - EXCERPT_LENGTH / 2, 0 ].max..]
+      else
+        text
+      end
+    end
+end
