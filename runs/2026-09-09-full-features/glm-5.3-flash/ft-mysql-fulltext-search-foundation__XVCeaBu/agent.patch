diff --git a/app/views/searches/index.html.erb b/app/views/searches/index.html.erb
new file mode 100644
index 0000000..f804665
--- /dev/null
+++ b/app/views/searches/index.html.erb
@@ -0,0 +1,25 @@
+<% @page_title = "Search" %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="search">
+  <%= form_tag search_path, method: :get, class: "search__form", data: { turbo_frame: "_top" } do %>
+    <%= text_field_tag :q, search_term, type: "search", placeholder: "Search cards, descriptions, and comments...",
+      class: "input full-width", autofocus: true, autocorrect: "off", autocapitalize: "off", autocomplete: "off",
+      spellcheck: false, "aria-label": "Search", data: { "1p-ignore": "true" } %>
+  <% end %>
+
+  <% if search_term.present? %>
+    <% if @page.records.any? %>
+      <%= with_manual_pagination :search_results, @page do %>
+        <ul class="search__results">
+          <%= render partial: "searches/result", collection: @page.records, as: :card %>
+        </ul>
+      <% end %>
+    <% else %>
+      <div class="blank-slate">No cards match '<%= search_term %>'</div>
+    <% end %>
+  <% end %>
+</section>
