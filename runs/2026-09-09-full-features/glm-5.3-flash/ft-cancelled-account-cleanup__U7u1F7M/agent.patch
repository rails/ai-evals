diff --git a/app/models/account/incineratable.rb b/app/models/account/incineratable.rb
index 2357b99..bb88b20 100644
--- a/app/models/account/incineratable.rb
+++ b/app/models/account/incineratable.rb
@@ -1,3 +1,43 @@
 module Account::Incineratable
+  extend ActiveSupport::Concern
+
   INCINERATION_GRACE_PERIOD = 30.days
+
+  included do
+    scope :incineration_due, -> { joins(:cancellation).where(account_cancellations: { created_at: ..INCINERATION_GRACE_PERIOD.ago }) }
+  end
+
+  class_methods do
+    def incinerate_due
+      incineration_due.find_each(&:incinerate)
+    end
+  end
+
+  def incinerate
+    transaction do
+      # The storage ledger has no association back from the account, so it needs
+      # an explicit removal.
+      Storage::Entry.where(account_id: id).delete_all
+
+      destroy
+    end
+
+    purge_detached_blobs
+  end
+
+  def incineration_due?
+    if cancellation = self.cancellation
+      cancellation.created_at <= INCINERATION_GRACE_PERIOD.ago
+    else
+      false
+    end
+  end
+
+  private
+    # Attachments purge their blobs asynchronously once the account is gone, so
+    # sweep the blobs that are no longer attached to anything to not leave any
+    # account data behind.
+    def purge_detached_blobs
+      ActiveStorage::Blob.where(account_id: id).where.missing(:attachments).find_each(&:purge)
+    end
 end
