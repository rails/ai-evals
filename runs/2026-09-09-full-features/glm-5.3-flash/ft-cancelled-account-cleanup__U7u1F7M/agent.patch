diff --git a/test/jobs/account/incinerate_due_job_test.rb b/test/jobs/account/incinerate_due_job_test.rb
new file mode 100644
index 0000000..bfe2b6e
--- /dev/null
+++ b/test/jobs/account/incinerate_due_job_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Account::IncinerateDueJobTest < ActiveJob::TestCase
+  test "incinerates accounts cancelled more than the grace period ago" do
+    account = cancelled_account
+
+    assert_difference -> { Account.count }, -1 do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert_not Account.exists?(account.id)
+    assert_not account.users.exists?
+    assert_not account.boards.exists?
+    assert_not account.cards.exists?
+  end
+
+  test "leaves accounts cancelled less than the grace period ago alone" do
+    account = cancelled_account(Account::Incineratable::INCINERATION_GRACE_PERIOD - 1.day)
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+  end
+
+  test "leaves active accounts alone" do
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+  end
+
+  test "leaves other accounts alone" do
+    account = cancelled_account
+    other = accounts(:initech)
+
+    Account::IncinerateDueJob.perform_now
+
+    assert_not Account.exists?(account.id)
+    assert Account.exists?(other.id)
+    assert_not_includes Account.incineration_due, other
+  end
+
+  test "leaves reactivated accounts alone" do
+    account = cancelled_account
+    account.reactivate
+
+    assert_no_difference -> { Account.count } do
+      Account::IncinerateDueJob.perform_now
+    end
+
+    assert Account.exists?(account.id)
+  end
+
+  private
+    def cancelled_account(grace_period_ago = Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day)
+      account = accounts(:"37s")
+      account.cancel(initiated_by: users(:david))
+      account.cancellation.update!(created_at: grace_period_ago.ago)
+      account
+    end
+end
diff --git a/test/models/account/incineratable_test.rb b/test/models/account/incineratable_test.rb
new file mode 100644
index 0000000..ee10279
--- /dev/null
+++ b/test/models/account/incineratable_test.rb
@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Account::IncineratableTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:"37s")
+    @user = users(:david)
+  end
+
+  test "incineration_due only includes accounts cancelled more than the grace period ago" do
+    @account.cancel(initiated_by: @user)
+
+    assert_not_includes Account.incineration_due, @account
+    assert_not @account.incineration_due?
+
+    @account.cancellation.update!(created_at: (Account::Incineratable::INCINERATION_GRACE_PERIOD + 1.day).ago)
+
+    assert_includes Account.incineration_due, @account
+    assert @account.incineration_due?
+  end
+
+  test "incinerate removes the account and all of its data" do
+    @account.cancel(initiated_by: @user)
+
+    assert_difference -> { Account.count }, -1 do
+      assert_difference -> { User.count }, -@account.users.count do
+        assert_difference -> { Board.count }, -@account.boards.count do
+          assert_difference -> { Card.count }, -@account.cards.count do
+            @account.incinerate
+          end
+        end
+      end
+    end
+
+    assert_not Account.exists?(@account.id)
+    assert_empty Storage::Entry.where(account_id: @account.id)
+  end
+end
