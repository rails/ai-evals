@@ -0,0 +1,67 @@
+require "test_helper"
+
+class Event::RelayingTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+  end
+
+  test "events are relayed to the webhooks subscribed to their action" do
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    assert_difference -> { @webhook.deliveries.count }, 1 do
+      perform_enqueued_jobs do
+        boards(:writebook).events.create! creator: users(:david), eventable: cards(:logo), action: "card_published"
+      end
+    end
+
+    assert_requested :post, @webhook.url, times: 1
+    assert @webhook.deliveries.ordered.first.succeeded?
+  end
+
+  test "events are not relayed to webhooks subscribed to other actions" do
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs do
+        boards(:writebook).events.create! creator: users(:david), eventable: cards(:logo), action: "card_postponed"
+      end
+    end
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "events are not relayed to webhooks on other boards" do
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs do
+        boards(:private).events.create! creator: users(:david), eventable: cards(:logo), action: "card_published"
+      end
+    end
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "events are not relayed to inactive webhooks" do
+    @webhook.deactivate
+
+    assert_no_difference -> { @webhook.deliveries.count } do
+      perform_enqueued_jobs do
+        boards(:writebook).events.create! creator: users(:david), eventable: cards(:logo), action: "card_published"
+      end
+    end
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "events are relayed to every webhook subscribed to the action" do
+    campfire = Webhook.create! name: "Campfire", url: "https://campfire.example.com/rooms/1/2-engineering/messages",
+      board: boards(:writebook), subscribed_actions: %w[ card_published ]
+
+    stub_request(:post, @webhook.url).to_return(status: 200)
+    stub_request(:post, campfire.url).to_return(status: 200)
+
+    perform_enqueued_jobs do
+      boards(:writebook).events.create! creator: users(:david), eventable: cards(:logo), action: "card_published"
+    end
+
+    assert_requested :post, @webhook.url, times: 1
+    assert_requested :post, campfire.url, times: 1
+  end
+end
