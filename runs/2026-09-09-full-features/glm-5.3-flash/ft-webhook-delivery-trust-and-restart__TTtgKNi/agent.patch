diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..6ae3dd9
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,41 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  # A webhook is switched off after failing this many deliveries in a row,
+  # as long as all of them happened within the failure window.
+  FAILURE_LIMIT = 10
+  FAILURE_WINDOW = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record_failure
+    with_lock do
+      reset if stale?
+
+      update!(
+        consecutive_failures_count: consecutive_failures_count + 1,
+        first_failure_at: first_failure_at || Time.current
+      )
+    end
+
+    webhook.deactivate if delinquent?
+  end
+
+  def record_success
+    reset
+  end
+
+  def delinquent?
+    consecutive_failures_count >= FAILURE_LIMIT && !stale?
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  private
+    # Failures older than the window are no longer "in a row over an hour",
+    # so the count starts over.
+    def stale?
+      first_failure_at? && first_failure_at.before?(FAILURE_WINDOW.ago)
+    end
+end
