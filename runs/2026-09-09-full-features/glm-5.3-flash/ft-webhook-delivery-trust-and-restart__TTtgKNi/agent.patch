@@ -0,0 +1,64 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.delinquency_tracker
+  end
+
+  test "is created along with the webhook" do
+    webhook = Webhook.create! name: "Test", url: "https://example.com/webhook", board: boards(:writebook)
+
+    assert_not_nil webhook.delinquency_tracker
+    assert_equal 0, webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "counts consecutive failures" do
+    @tracker.record_failure
+    @tracker.record_failure
+
+    assert_equal 2, @tracker.reload.consecutive_failures_count
+    assert_not_nil @tracker.reload.first_failure_at
+  end
+
+  test "switches the webhook off after failing too many times in a row" do
+    assert_changes -> { @webhook.reload.active? }, from: true, to: false do
+      Webhook::DelinquencyTracker::FAILURE_LIMIT.times { @tracker.record_failure }
+    end
+  end
+
+  test "failures outside of the window don't count as consecutive" do
+    @tracker.update! consecutive_failures_count: Webhook::DelinquencyTracker::FAILURE_LIMIT - 1, first_failure_at: 2.hours.ago
+
+    @tracker.record_failure
+
+    assert @webhook.reload.active?
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+  end
+
+  test "is not delinquent before reaching the limit" do
+    (Webhook::DelinquencyTracker::FAILURE_LIMIT - 1).times { @tracker.record_failure }
+
+    assert_not @tracker.reload.delinquent?
+    assert @webhook.reload.active?
+  end
+
+  test "a success resets the failures" do
+    @tracker.record_failure
+    @tracker.record_failure
+
+    @tracker.record_success
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.reload.first_failure_at
+  end
+
+  test "reactivating a webhook gives it a fresh start" do
+    @tracker.update! consecutive_failures_count: 3, first_failure_at: 1.minute.ago
+
+    @webhook.deactivate
+    @webhook.activate
+
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+  end
+end
