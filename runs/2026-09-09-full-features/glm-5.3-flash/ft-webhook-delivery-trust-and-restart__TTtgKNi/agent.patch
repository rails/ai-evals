 class Webhook::Delivery < ApplicationRecord
+  # How long a delivery stays in the log before it's cleaned up.
+  RETENTION = 1.week
+
+  # How long we wait for the receiver before giving up on it.
+  OPEN_TIMEOUT = 5.seconds
+  READ_TIMEOUT = 10.seconds
+
+  USER_AGENT = "fizzy/1.0.0 Webhook"
+
+  # Errors that mean the receiver couldn't be reached at all, as opposed to
+  # errors that mean it answered with something we couldn't handle.
+  UNREACHABLE_ERRORS = [
+    EOFError,
+    Errno::ECONNABORTED, Errno::ECONNREFUSED, Errno::ECONNRESET,
+    Errno::EHOSTUNREACH, Errno::ENETUNREACH, Errno::ETIMEDOUT,
+    Net::OpenTimeout, Net::ReadTimeout, Net::WriteTimeout,
+    OpenSSL::SSL::SSLError, SocketError, Timeout::Error
+  ].freeze
+
+  DESTINATION_UNREACHABLE = "destination_unreachable"
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -9,6 +30,27 @@ class Webhook::Delivery < ApplicationRecord
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
+  scope :stale, -> { where created_at: ...RETENTION.ago }
+
+  class << self
+    def cleanup
+      stale.delete_all
+    end
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later self
+  end
+
+  # Every delivery is attempted exactly once: there are no retries, a receiver
+  # that doesn't answer is logged as such and the webhook is held accountable.
+  def deliver
+    return unless pending?
+
+    update! state: :in_progress, request: { headers: headers }
+
+    post_payload
+  end
 
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
@@ -29,4 +71,65 @@ class Webhook::Delivery < ApplicationRecord
   def succeeded?
     completed? && response[:error].blank? && response[:code].between?(200, 299)
   end
+
+  private
+    def post_payload
+      record_response http.request post_request
+    rescue *UNREACHABLE_ERRORS
+      record_error DESTINATION_UNREACHABLE
+    rescue => error
+      record_error error.class.name.demodulize.underscore
+    end
+
+    def record_response(response)
+      update! state: :completed, response: { code: response.code.to_i, headers: response.each_header.to_h }
+
+      if succeeded?
+        webhook.delinquency_tracker.record_success
+      else
+        webhook.delinquency_tracker.record_failure
+      end
+    end
+
+    def record_error(error)
+      update! state: :errored, response: { error: error.to_s }
+
+      webhook.delinquency_tracker.record_failure
+    end
+
+    def http
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.use_ssl = uri.is_a?(URI::HTTPS)
+        http.open_timeout = OPEN_TIMEOUT
+        http.read_timeout = READ_TIMEOUT
+        http.write_timeout = READ_TIMEOUT
+      end
+    end
+
+    def post_request
+      Net::HTTP::Post.new(uri.request_uri, headers).tap do |request|
+        request.body = payload
+      end
+    end
+
+    def headers
+      {
+        "User-Agent" => USER_AGENT,
+        "Content-Type" => "application/json",
+        "X-Webhook-Signature" => signature,
+        "X-Webhook-Timestamp" => event.created_at.utc.iso8601
+      }
+    end
+
+    def signature
+      OpenSSL::HMAC.hexdigest "SHA256", webhook.signing_secret, payload
+    end
+
+    def payload
+      Webhook::EventPayload.new(event).to_json
+    end
+
+    def uri
+      @uri ||= URI.parse(webhook.url)
+    end
 end
diff --git a/app/models/webhook/event_payload.rb b/app/models/webhook/event_payload.rb
