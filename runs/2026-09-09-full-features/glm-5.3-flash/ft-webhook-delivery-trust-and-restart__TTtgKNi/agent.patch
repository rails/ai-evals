+++ b/app/models/webhook/event_payload.rb
@@ -0,0 +1,61 @@
+class Webhook::EventPayload
+  def initialize(event)
+    @event = event
+  end
+
+  def to_json(*)
+    JSON.generate to_h
+  end
+
+  def to_h
+    {
+      id: event.id,
+      action: event.action,
+      created_at: event.created_at.utc.iso8601,
+      creator: creator,
+      board: board,
+      eventable: eventable
+    }
+  end
+
+  private
+    attr_reader :event
+
+    def creator
+      { id: event.creator_id, name: event.creator.name }
+    end
+
+    def board
+      { id: event.board_id, name: event.board.name }
+    end
+
+    def eventable
+      record = event.eventable
+
+      {
+        type: record.class.name,
+        id: record.id,
+        url: polymorphic_url(record)
+      }.merge attributes_for(record)
+    end
+
+    def attributes_for(record)
+      case record
+      when Card then { number: record.number, title: record.title, status: record.status }
+      when Comment then { body: record.body.to_plain_text, card_id: record.card_id }
+      else {}
+      end
+    end
+
+    def polymorphic_url(record)
+      Rails.application.routes.url_helpers.polymorphic_url record, **url_options
+    end
+
+    def url_options
+      base_options = Rails.application.routes.default_url_options.presence ||
+        Rails.application.config.action_mailer.default_url_options ||
+        {}
+
+      base_options.merge script_name: event.account.slug
+    end
+end
