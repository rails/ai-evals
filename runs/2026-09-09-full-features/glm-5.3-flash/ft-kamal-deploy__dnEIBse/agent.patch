+# Kamal reads its secrets from .kamal/secrets. Copy this file there and fill it
+# in, then never commit it:
+#
+#   cp .kamal/secrets.example .kamal/secrets
+#
+# Everything in here is injected into the Fizzy container on deploy.
+
+# Signs and encrypts sessions, cookies, and everything else that has to stay
+# secret. Generate one with:
+#
+#   bin/rails secret
+SECRET_KEY_BASE=
+
+# Credentials for the mail server in SMTP_ADDRESS (config/deploy.yml).
+SMTP_USER_NAME=
+SMTP_PASSWORD=
+
+# Keys that let Fizzy send browser push notifications. Generate a pair with:
+#
+#   bin/rails runner 'key = WebPush.generate_key; puts "VAPID_PUBLIC_KEY=#{key.public_key}"; puts "VAPID_PRIVATE_KEY=#{key.private_key}"'
+#
+# Leave them empty if you don't want push notifications.
+VAPID_PUBLIC_KEY=
+VAPID_PRIVATE_KEY=
+
+# Access token for the registry Kamal pushes the image to, e.g. a Docker Hub
+# access token.
+REGISTRY_PASSWORD=
