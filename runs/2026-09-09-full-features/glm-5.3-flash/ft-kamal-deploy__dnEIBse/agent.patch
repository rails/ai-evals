+++ b/config/environments/production.rb
@@ -76,6 +76,37 @@ Rails.application.configure do
 
   config.action_mailer.perform_caching = false
 
+  # Where this Fizzy lives, used to build absolute URLs in emails, exports, and
+  # push notifications. Set APP_HOST to the hostname you deploy to, and see
+  # docs/self-hosting.md for the rest of the deploy configuration.
+  if app_host = ENV["APP_HOST"].presence
+    protocol = config.force_ssl ? "https" : "http"
+    config.action_controller.default_url_options = { host: app_host, protocol: protocol }
+    config.action_mailer.default_url_options = { host: app_host, protocol: protocol }
+  end
+
+  # Your mail server, given as environment variables so that it can be filled in
+  # at deploy time. SMTP_USER_NAME and SMTP_PASSWORD hold its credentials, and
+  # SMTP_DOMAIN is the name to introduce ourselves as (the HELO domain).
+  #
+  # Leave SMTP_ADDRESS unset to deliver with Action Mailer's own defaults, i.e.
+  # to a local SMTP server on port 25.
+  if smtp_address = ENV["SMTP_ADDRESS"].presence
+    smtp_user_name = ENV["SMTP_USER_NAME"].presence
+
+    config.action_mailer.delivery_method = :smtp
+    config.action_mailer.smtp_settings = {
+      address: smtp_address,
+      port: ENV["SMTP_PORT"].presence&.to_i || 587,
+      domain: ENV["SMTP_DOMAIN"].presence,
+      user_name: smtp_user_name,
+      password: ENV["SMTP_PASSWORD"].presence,
+      authentication: smtp_user_name && ENV.fetch("SMTP_AUTHENTICATION", "plain").to_sym,
+      enable_starttls_auto: ENV.fetch("SMTP_ENABLE_STARTTLS_AUTO", "true") == "true",
+      tls: ENV["SMTP_TLS"] == "true"
+    }.compact
+  end
+
   # Ignore bad email addresses and do not raise email delivery errors.
   # Set this to true and configure the email server for immediate delivery to raise delivery errors.
   # config.action_mailer.raise_delivery_errors = false
