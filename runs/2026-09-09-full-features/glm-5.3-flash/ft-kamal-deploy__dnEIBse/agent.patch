new file mode 100644
index 0000000..b70eb9c
--- /dev/null
+++ b/config/deploy.yml
@@ -0,0 +1,101 @@
+# Deploy Fizzy to one box with Kamal: https://kamal-deploy.org
+#
+# Everything runs in a single container on a single Linux server: the web
+# server, the background jobs, a SQLite database, and uploaded files on disk.
+# kamal-proxy sits in front of it all and terminates SSL for your hostname.
+#
+# See docs/self-hosting.md for a walkthrough of what to fill in, then run:
+#
+#   bin/kamal setup   # the first time
+#   bin/kamal deploy  # every time after that
+
+service: fizzy
+
+# The image to run. Point this at your own image after you fork Fizzy, and
+# configure `registry` below so Kamal can build and push it.
+image: your-registry-username/fizzy
+
+# The box to deploy to. Kamal connects as root over SSH unless you set `ssh:`.
+#
+# Once one box isn't enough, move background jobs onto their own servers:
+#
+#   jobs:
+#     hosts:
+#       - your-jobs-host
+#     cmd: bin/jobs
+servers:
+  web:
+    - your-host
+  # jobs:
+  #   hosts:
+  #     - your-jobs-host
+  #   cmd: bin/jobs
+
+# kamal-proxy requests a certificate for `host` from Let's Encrypt, so point the
+# DNS record for it at your server and keep ports 80 and 443 open.
+proxy:
+  ssl: true
+  host: your-host
+
+# Where Kamal pushes the image it builds. Add `server: ghcr.io` (or another
+# registry) if you don't use Docker Hub.
+registry:
+  username: your-registry-username
+  password:
+    - REGISTRY_PASSWORD
+
+env:
+  clear:
+    # Background jobs run in the web container's Puma process. If you move them
+    # to the `jobs` servers above, set this to false.
+    SOLID_QUEUE_IN_PUMA: true
+
+    # Uploads are stored on disk, in the volume below.
+    ACTIVE_STORAGE_SERVICE: local
+
+    # Where this Fizzy lives. Used to build absolute URLs in emails, exports,
+    # and push notifications.
+    APP_HOST: your-host
+    MAILER_FROM_ADDRESS: Fizzy <fizzy@your-host>
+
+    # Your mail server. Credentials come from .kamal/secrets.
+    SMTP_ADDRESS: your-mail-server
+    SMTP_PORT: 587
+    SMTP_DOMAIN: your-host
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: true
+    # SMTP_TLS: false # Set to true for mail servers that want SSL from the start, on port 465.
+
+    # How much to log: debug, info (the default), warn, error, or fatal.
+    # RAILS_LOG_LEVEL: info
+
+    # How many Puma workers and Solid Queue threads a small box gets:
+    # WEB_CONCURRENCY: 2
+    # JOB_CONCURRENCY: 3
+
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USER_NAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
+
+# SQLite databases and uploaded files live here, so they survive the next
+# deploy. Point this at a path that gets backed up.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+# Bridge fingerprinted assets, like JS and CSS, between versions to avoid
+# hitting 404 on in-flight requests.
+asset_path: /rails/public/assets
+
+builder:
+  arch: amd64
+  # On an ARM server, like a Raspberry Pi or an AWS Graviton instance, build
+  # for that instead:
+  # arch: arm64
