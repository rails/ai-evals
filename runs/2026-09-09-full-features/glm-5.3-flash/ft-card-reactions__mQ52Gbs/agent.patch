diff --git a/db/migrate/20260710000000_make_reactions_polymorphic.rb b/db/migrate/20260710000000_make_reactions_polymorphic.rb
new file mode 100644
index 0000000..97aaa49
--- /dev/null
+++ b/db/migrate/20260710000000_make_reactions_polymorphic.rb
@@ -0,0 +1,52 @@
+class MakeReactionsPolymorphic < ActiveRecord::Migration[8.2]
+  class Reaction < ActiveRecord::Base
+    self.table_name = "reactions"
+  end
+
+  def change
+    reversible do |dir|
+      dir.up do
+        add_column :reactions, :reactable_type, :string
+        add_column :reactions, :reactable_id, :uuid
+
+        move_comment_reactions
+
+        change_column_null :reactions, :reactable_type, false
+        change_column_null :reactions, :reactable_id, false
+        replace_comment_id_with_reactable_index
+      end
+
+      dir.down do
+        add_column :reactions, :comment_id, :uuid
+
+        restore_comment_reactions
+
+        remove_index :reactions, name: "index_reactions_on_reactable"
+        remove_column :reactions, :reactable_id
+        remove_column :reactions, :reactable_type
+        add_index :reactions, :comment_id
+      end
+    end
+  end
+
+  private
+    def move_comment_reactions
+      Reaction.reset_column_information
+      Reaction.where.not(comment_id: nil).update_all(<<~SQL.squish)
+        reactable_type = 'Comment', reactable_id = comment_id
+      SQL
+    end
+
+    def restore_comment_reactions
+      Reaction.reset_column_information
+      Reaction.where(reactable_type: "Comment").update_all(<<~SQL.squish)
+        comment_id = reactable_id
+      SQL
+    end
+
+    def replace_comment_id_with_reactable_index
+      remove_index :reactions, name: "index_reactions_on_comment_id"
+      remove_column :reactions, :comment_id
+      add_index :reactions, [ :reactable_type, :reactable_id ], name: "index_reactions_on_reactable"
+    end
+end
