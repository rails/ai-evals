+
+  test "creating a card reaction touches the card activity" do
+    assert_changes -> { cards(:logo).reload.last_active_at } do
+      cards(:logo).reactions.create!(content: "Nice!")
+    end
+  end
+
+  test "creating a card reaction invalidates the card cache" do
+    card = cards(:logo)
+
+    assert_changes -> { card.reload.cache_version } do
+      card.reactions.create!(content: "Nice!")
+    end
+  end
+
+  test "destroying a card reaction touches the card" do
+    card = cards(:logo)
+    card.reactions.create!(content: "Nice!")
+
+    assert_changes -> { card.reload.updated_at } do
+      card.reactions.first.destroy
+    end
+  end
+
+  test "a reaction requires a reactable" do
+    reaction = Reaction.new(content: "Nice!")
+
+    assert_not reaction.valid?
+    assert reaction.errors.of_kind?(:reactable, :blank)
+  end
