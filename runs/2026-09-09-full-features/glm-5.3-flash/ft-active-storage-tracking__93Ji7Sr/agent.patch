diff --git a/lib/rails_ext/active_storage_usage_counting.rb b/lib/rails_ext/active_storage_usage_counting.rb
new file mode 100644
index 0000000..7f8da82
--- /dev/null
+++ b/lib/rails_ext/active_storage_usage_counting.rb
@@ -0,0 +1,60 @@
+module ActiveStorage
+  module Extensions
+    # Active Storage attachments are the records we count storage usage for: card
+    # images and the files embedded in board descriptions, card descriptions, and
+    # comments. When they change, the boards caching that usage have to forget it.
+    module AttachmentUsageCounting
+      extend ActiveSupport::Concern
+
+      included do
+        after_commit :expire_usage_later, on: %i[ create destroy ]
+      end
+
+      # The boards whose usage includes this attachment: the ones of the record it
+      # belongs to, when that is a record we count.
+      def usage_boards
+        if (record = record_counted_for_usage)
+          record.usage_boards
+        else
+          []
+        end
+      end
+
+      private
+        def record_counted_for_usage
+          case record_type
+          when "Card" then Card.find_by(id: record_id)
+          when "Comment" then Comment.find_by(id: record_id)
+          when "Board" then Board.find_by(id: record_id)
+          when "ActionText::RichText" then rich_text_record_counted_for_usage
+          end
+        end
+
+        # Files embedded in a rich text count towards the usage of the record the
+        # rich text belongs to: a card, a comment, or a board.
+        def rich_text_record_counted_for_usage
+          if (rich_text = ActionText::RichText.find_by(id: record_id))
+            case rich_text.record_type
+            when "Card" then Card.find_by(id: rich_text.record_id)
+            when "Comment" then Comment.find_by(id: rich_text.record_id)
+            when "Board" then Board.find_by(id: rich_text.record_id)
+            end
+          end
+        end
+    end
+
+    # Purging an attachment deletes it without running its destroy callbacks, so
+    # the cached usage has to be expired explicitly.
+    module PurgedAttachmentUsageCounting
+      def purge
+        super
+        expire_usage_later
+      end
+
+      def purge_later
+        super
+        expire_usage_later
+      end
+    end
+  end
+end
diff --git a/test/models/concerns/usage_tracked_test.rb b/test/models/concerns/usage_tracked_test.rb
new file mode 100644
index 0000000..ceaa91e
--- /dev/null
+++ b/test/models/concerns/usage_tracked_test.rb
@@ -0,0 +1,134 @@
+require "test_helper"
+
+class UsageTrackedTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "board usage counts everything counted on the board" do
+    card = attach_image_to(@card)
+
+    assert_equal card.image.blob.byte_size, @board.bytes_used
+  end
+
+  test "account usage counts everything counted on all of its boards" do
+    card = attach_image_to(@card)
+    embedded = embed_file_in(boards(:private), :public_description)
+
+    assert_equal card.image.blob.byte_size + embedded.byte_size, @account.bytes_used
+  end
+
+  test "usage is calculated in the background and cached" do
+    card = attach_image_to(@card)
+    perform_enqueued_jobs
+
+    assert_equal card.image.blob.byte_size, @board.reload[:bytes_used]
+    assert_equal card.image.blob.byte_size, @account.reload[:bytes_used]
+  end
+
+  test "expiring the usage schedules its recalculation" do
+    assert_enqueued_with job: Storage::UsageJob do
+      @board.expire_bytes_used_later
+    end
+  end
+
+  test "usage is calculated on the spot when it has been invalidated and not recalculated yet" do
+    @board.refresh_bytes_used
+    card = attach_image_to(@card)
+
+    assert_nil @board.reload[:bytes_used]
+    assert_nil @account.reload[:bytes_used]
+    assert_equal card.image.blob.byte_size, @board.bytes_used
+    assert_equal card.image.blob.byte_size, @account.bytes_used
+  end
+
+  test "usage is recalculated in the background after being expired" do
+    card = attach_image_to(@card)
+    perform_enqueued_jobs
+    assert_equal card.image.blob.byte_size, @board.reload[:bytes_used]
+
+    @board.expire_bytes_used_later
+    perform_enqueued_jobs
+
+    assert_equal card.image.blob.byte_size, @board.reload[:bytes_used]
+  end
+
+  test "removing a card image drops its usage" do
+    card = attach_image_to(@card)
+    perform_enqueued_jobs
+    assert_equal card.image.blob.byte_size, @board.reload[:bytes_used]
+
+    card.image.purge_later
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload[:bytes_used]
+    assert_equal 0, @account.reload[:bytes_used]
+  end
+
+  test "moving a card to another board moves its usage" do
+    card = attach_image_to(@card)
+    perform_enqueued_jobs
+    other_board = boards(:private)
+
+    card.move_to(other_board)
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload[:bytes_used]
+    assert_equal card.image.blob.byte_size, other_board.reload[:bytes_used]
+    assert_equal card.image.blob.byte_size, @account.reload[:bytes_used]
+  end
+
+  test "destroying a card drops its usage" do
+    card = attach_image_to(@card)
+    perform_enqueued_jobs
+    assert_equal card.image.blob.byte_size, @board.reload[:bytes_used]
+
+    card.destroy!
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload[:bytes_used]
+    assert_equal 0, @account.reload[:bytes_used]
+  end
+
+  test "destroying a comment drops its usage" do
+    comment = comments(:logo_agreement_jz)
+    embedded = embed_file_in(comment, :body)
+    perform_enqueued_jobs
+    assert_equal embedded.byte_size, @board.reload[:bytes_used]
+
+    comment.destroy!
+    perform_enqueued_jobs
+
+    assert_equal 0, @board.reload[:bytes_used]
+  end
+
+  test "destroying a board drops the account usage" do
+    embedded = embed_file_in(@board, :public_description)
+    perform_enqueued_jobs
+    assert_equal embedded.byte_size, @account.reload[:bytes_used]
+
+    @board.destroy!
+    perform_enqueued_jobs
+
+    assert_equal 0, @account.reload[:bytes_used]
+  end
+
+  private
+    def attach_image_to(card)
+      card.image.attach io: StringIO.new("card image"), filename: "card.png", content_type: "image/png"
+      card
+    end
+
+    def embed_file_in(record, attribute)
+      blob = ActiveStorage::Blob.create_and_upload! \
+        io: file_fixture("moon.jpg").open,
+        filename: "embedded.jpg",
+        content_type: "image/jpeg"
+
+      record.update!(attribute => "<p>Embedded: #{ActionText::Attachment.from_attachable(blob).to_html}</p>")
+      blob
+    end
+end
