+class Storage::UsageJob < ApplicationJob
+  # An account can be incinerated before its recalculation runs; there is nothing
+  # left to recalculate then.
+  discard_on ActiveJob::DeserializationError
+
+  def perform(account)
+    account.refresh_bytes_used
+  end
+end
