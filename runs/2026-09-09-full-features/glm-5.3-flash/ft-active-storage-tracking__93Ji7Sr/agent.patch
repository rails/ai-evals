diff --git a/app/models/concerns/usage_counted.rb b/app/models/concerns/usage_counted.rb
new file mode 100644
index 0000000..6587ccb
--- /dev/null
+++ b/app/models/concerns/usage_counted.rb
@@ -0,0 +1,16 @@
+# Records whose attachments count towards the storage usage of a board (see
+# Storage::Usage). When they change in ways that affect what's counted, the boards
+# caching that usage have to forget it, so that it gets recalculated in the
+# background.
+module UsageCounted
+  extend ActiveSupport::Concern
+
+  # The boards whose usage includes the attachments of this record.
+  def usage_boards
+    [ self ]
+  end
+
+  def expire_usage_later
+    usage_boards.each(&:expire_bytes_used_later)
+  end
+end
diff --git a/app/models/concerns/usage_tracked.rb b/app/models/concerns/usage_tracked.rb
new file mode 100644
index 0000000..4660890
--- /dev/null
+++ b/app/models/concerns/usage_tracked.rb
@@ -0,0 +1,41 @@
+# Accounts and boards cache the storage usage counted for them (see Storage::Usage).
+#
+# The cache is calculated in the background by Storage::UsageJob, whenever
+# something that counts towards the usage changes. Reading it never returns a stale
+# value: a cache that has been invalidated but hasn't been recalculated yet is
+# calculated on the spot.
+module UsageTracked
+  extend ActiveSupport::Concern
+
+  # Bytes used by the attachments counted for this account or board.
+  def bytes_used
+    self[:bytes_used] || calculated_bytes_used
+  end
+
+  # Calculates the usage and caches it, so that subsequent reads don't have to.
+  def refresh_bytes_used
+    update_column :bytes_used, calculated_bytes_used
+    self[:bytes_used]
+  end
+
+  # Forgets the cached usage and schedules its recalculation in the background.
+  def expire_bytes_used_later
+    forget_bytes_used
+    expire_dependent_bytes_used_later
+  end
+
+  private
+    # Records that are gone don't count towards anything anymore, so there is
+    # nothing left to forget for them.
+    def forget_bytes_used
+      if persisted? && self[:bytes_used]
+        update_column :bytes_used, nil
+      end
+    end
+
+    # Boards drop their account's cached usage along with their own, since an
+    # account's usage includes everything counted on all of its boards.
+    def expire_dependent_bytes_used_later
+      Storage::UsageJob.perform_later(self)
+    end
+end
diff --git a/app/models/storage/usage.rb b/app/models/storage/usage.rb
new file mode 100644
index 0000000..98b2510
--- /dev/null
+++ b/app/models/storage/usage.rb
@@ -0,0 +1,42 @@
+# Counts the storage we keep track of: card images and the files embedded in board
+# descriptions, card descriptions, and comments.
+#
+# Everything is counted by the database in a single aggregate query over indexed
+# rows, so counting costs the same for a board with a handful of cards as for one
+# with hundreds of thousands of attachments, and nothing is loaded into memory.
+class Storage::Usage
+  CARD_IMAGES = { record_type: "Card", name: "image" }.freeze
+  EMBEDDED_FILES = { record_type: "ActionText::RichText", name: "embeds" }.freeze
+
+  def initialize(board)
+    @board = board
+  end
+
+  def bytes
+    counted_attachments.joins(:blob).sum("#{ActiveStorage::Blob.table_name}.byte_size")
+  end
+
+  private
+    attr_reader :board
+
+    def counted_attachments
+      ActiveStorage::Attachment.where(**CARD_IMAGES, record_id: cards)
+        .or(ActiveStorage::Attachment.where(**EMBEDDED_FILES, record_id: rich_texts_with_embeds))
+    end
+
+    def cards
+      Card.where(board_id: board.id)
+    end
+
+    # The rich texts that can embed files: the board's description, its cards'
+    # descriptions, and its cards' comments.
+    def rich_texts_with_embeds
+      ActionText::RichText.where(record_type: "Board", record_id: board.id)
+        .or(ActionText::RichText.where(record_type: "Card", record_id: cards))
+        .or(ActionText::RichText.where(record_type: "Comment", record_id: comments))
+    end
+
+    def comments
+      Comment.where(card_id: cards)
+    end
+end
diff --git a/config/initializers/usage_counting.rb b/config/initializers/usage_counting.rb
new file mode 100644
index 0000000..ac23e1f
--- /dev/null
+++ b/config/initializers/usage_counting.rb
@@ -0,0 +1,9 @@
+require_relative "extensions"
+
+# Active Storage attachments are the records we count storage usage for, so their
+# changes have to expire the usage cached by boards and accounts.
+Rails.application.config.to_prepare do
+  ActiveStorage::Attachment.include UsageCounted
+  ActiveStorage::Attachment.include ActiveStorage::Extensions::AttachmentUsageCounting
+  ActiveStorage::Attachment.prepend ActiveStorage::Extensions::PurgedAttachmentUsageCounting
+end
