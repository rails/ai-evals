@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Storage::UsageTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts("37s")
+    @board = boards(:writebook)
+    @card = cards(:logo)
+  end
+
+  test "counts nothing when nothing is attached" do
+    assert_equal 0, Storage::Usage.new(@board).bytes
+  end
+
+  test "counts card images" do
+    card = attach_image_to(@card)
+
+    assert_equal card.image.blob.byte_size, Storage::Usage.new(@board).bytes
+  end
+
+  test "counts files embedded in card descriptions" do
+    blob = embed_file_in(@card, :description)
+
+    assert_equal blob.byte_size, Storage::Usage.new(@board).bytes
+  end
+
+  test "counts files embedded in comments" do
+    blob = embed_file_in(comments(:logo_agreement_jz), :body)
+
+    assert_equal blob.byte_size, Storage::Usage.new(@board).bytes
+  end
+
+  test "counts files embedded in board descriptions" do
+    blob = embed_file_in(@board, :public_description)
+
+    assert_equal blob.byte_size, Storage::Usage.new(@board).bytes
+  end
+
+  test "counts everything attached to a board" do
+    image = attach_image_to(@card)
+    card_description = embed_file_in(@card, :description)
+    comment = embed_file_in(comments(:logo_agreement_jz), :body)
+    board_description = embed_file_in(@board, :public_description)
+
+    assert_equal image.image.blob.byte_size + card_description.byte_size + comment.byte_size +
+      board_description.byte_size, Storage::Usage.new(@board).bytes
+  end
+
+  test "does not count attachments of records we don't count" do
+    users(:david).avatar.attach io: file_fixture("moon.jpg").open, filename: "avatar.jpg", content_type: "image/jpeg"
+
+    assert_equal 0, Storage::Usage.new(@board).bytes
+  end
+
+  test "does not count attachments of other boards" do
+    attach_image_to(cards(:radio))
+    embed_file_in(boards(:private), :public_description)
+
+    assert_equal 0, Storage::Usage.new(@board).bytes
+  end
