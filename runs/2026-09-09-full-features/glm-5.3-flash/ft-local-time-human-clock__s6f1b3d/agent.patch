diff --git a/app/helpers/time_helper.rb b/app/helpers/time_helper.rb
index 90020f0..aaacb98 100644
--- a/app/helpers/time_helper.rb
+++ b/app/helpers/time_helper.rb
@@ -1,2 +1,21 @@
 module TimeHelper
+  # Times are rendered by the browser, in the viewer's own timezone, so the same
+  # HTML works - and can be cached - for everybody. All we send is the raw
+  # timestamp; app/javascript/controllers/local_time_controller.js turns it into
+  # words once it reaches the page.
+  #
+  #   local_time_tag card.created_at                          # "1:42 PM", "yesterday", "5 days ago", "Sep 12"
+  #   local_time_tag comment.created_at, format: :time        # "1:42 PM"
+  #   local_time_tag card.closed_at, format: :date_with_year  # "Sep 12, 2026"
+  def local_time_tag(datetime, format: :relative, **options)
+    if datetime
+      tag.time datetime: datetime.utc.iso8601,
+        data: {
+          controller: "local-time",
+          action: "turbo:morph-element->local-time#render",
+          local_time_format_value: format
+        },
+        **options
+    end
+  end
 end
