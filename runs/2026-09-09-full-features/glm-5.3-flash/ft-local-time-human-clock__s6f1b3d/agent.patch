diff --git a/test/helpers/time_helper_test.rb b/test/helpers/time_helper_test.rb
new file mode 100644
index 0000000..d782df2
--- /dev/null
+++ b/test/helpers/time_helper_test.rb
@@ -0,0 +1,22 @@
+require "test_helper"
+
+class TimeHelperTest < ActionView::TestCase
+  test "sends the raw timestamp for the browser to turn into words" do
+    time = Time.utc(2026, 1, 26, 13, 42)
+
+    assert_select parse(local_time_tag(time)), "time[datetime='2026-01-26T13:42:00Z']"
+  end
+
+  test "tells the browser how to format the timestamp" do
+    assert_select parse(local_time_tag(Time.current, format: :date)), "time[data-local-time-format-value='date']"
+  end
+
+  test "renders nothing when there is no timestamp" do
+    assert_nil local_time_tag(nil)
+  end
+
+  private
+    def parse(html)
+      Nokogiri::HTML::DocumentFragment.parse(html)
+    end
+end
diff --git a/test/integration/local_time_test.rb b/test/integration/local_time_test.rb
new file mode 100644
index 0000000..fed76a5
--- /dev/null
+++ b/test/integration/local_time_test.rb
@@ -0,0 +1,42 @@
+require "test_helper"
+
+class LocalTimeRenderingTest < ActionDispatch::IntegrationTest
+  test "sends timestamps for the browser to render, not times" do
+    sign_in_as :david
+    get card_url(cards(:layout))
+
+    assert_select ".card__meta-text--added time[datetime='#{cards(:layout).created_at.utc.iso8601}']"
+    assert_select ".card__meta-text--added", text: /ago/, count: 0
+  end
+
+  test "the native share description carries timestamps as well" do
+    sign_in_as :david
+    get card_url(cards(:layout))
+
+    assert_select "button[data-controller='bridge--share'] time[datetime]", count: 2
+  end
+
+  test "renders the same page for every timezone" do
+    sign_in_as :david
+
+    cookies[:timezone] = "Asia/Tokyo"
+    users(:david).settings.update!(timezone_name: "Asia/Tokyo")
+    get card_url(cards(:layout))
+    tokyo = page_html
+
+    cookies[:timezone] = "America/New_York"
+    users(:david).settings.update!(timezone_name: "America/New_York")
+    get card_url(cards(:layout))
+    new_york = page_html
+
+    assert_equal tokyo, new_york
+  end
+
+  private
+    # The nonce is unique per request, everything else is everybody's to share
+    def page_html
+      response.body
+        .gsub(/nonce="[^"]*"/, 'nonce=""')
+        .gsub(/csp-nonce" content="[^"]*"/, 'csp-nonce" content=""')
+    end
+end
diff --git a/test/system/local_time_test.rb b/test/system/local_time_test.rb
new file mode 100644
index 0000000..167606e
--- /dev/null
+++ b/test/system/local_time_test.rb
@@ -0,0 +1,73 @@
+require "application_system_test_case"
+
+# The browser is launched half a world away from the server, so anything the page
+# shows about time has to be rendered in the browser.
+class LocalTimeTest < ApplicationSystemTestCase
+  driven_by :chrome_headless_in_tokyo, screen_size: [ 1200, 1000 ]
+
+  test "a comment reads in the viewer's own timezone" do
+    comments(:logo_agreement_kevin).update!(created_at: Time.utc(2026, 1, 26, 13, 42))
+
+    sign_in_as(users(:david))
+    visit card_url(cards(:logo))
+
+    assert_text "January 26, 10:42 PM"
+  end
+
+  test "a card added earlier in the week reads as a number of days ago" do
+    sign_in_as(users(:david))
+    cards(:logo).update!(created_at: 5.days.ago, last_active_at: 5.days.ago)
+
+    visit card_url(cards(:logo))
+
+    assert_selector ".card__meta-text--added", text: /added 5 days ago/i
+  end
+
+  test "a card auto-closing overnight reads as tomorrow" do
+    sign_in_as(users(:david))
+    entropies(:writebook_board).update!(auto_postpone_period: 3.days.to_i)
+    cards(:logo).update!(last_active_at: 2.days.ago)
+
+    visit card_url(cards(:logo))
+
+    assert_selector ".card-perma__closure-message", text: /tomorrow if there\u2019s no activity/i
+  end
+
+  test "a card closing further out reads as a date" do
+    sign_in_as(users(:david))
+    cards(:logo).update!(last_active_at: 3.days.ago)
+
+    visit card_url(cards(:logo))
+
+    assert_selector ".card-perma__closure-message", text: /Moves to \u201cNot Now\u201d on /i
+  end
+end
+
+Capybara.register_driver :chrome_headless_in_tokyo do |app|
+  Capybara::Selenium::Driver.new(app, browser: :chrome, options: chrome_options_running_in("Asia/Tokyo"))
+end
+
+def chrome_options_running_in(timezone)
+  Selenium::WebDriver::Chrome::Options.new.tap do |options|
+    options.add_argument("--headless")
+    options.add_argument("--window-size=1200,800")
+    options.binary = chrome_wrapper_running_in(timezone)
+  end
+end
+
+# Chrome picks its timezone up from the environment, so we launch it through a
+# wrapper that sets one.
+def chrome_wrapper_running_in(timezone)
+  wrapper = File.join(Dir.mktmpdir, "chrome")
+  File.write(wrapper, <<~SCRIPT)
+    #!/bin/sh
+    TZ=#{timezone} exec #{chrome_binary} "$@"
+  SCRIPT
+
+  FileUtils.chmod(0o755, wrapper)
+  wrapper
+end
+
+def chrome_binary
+  Selenium::WebDriver::DriverFinder.new(Selenium::WebDriver::Chrome::Options.new, Selenium::WebDriver::Chrome::Service.new).browser_path
+end
