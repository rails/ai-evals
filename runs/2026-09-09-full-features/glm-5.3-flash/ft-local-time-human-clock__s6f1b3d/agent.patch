diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..1c8d178
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,20 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatTimestamp } from "helpers/time_helpers"
+
+// Turns the raw timestamp the server sent into words in the viewer's own
+// timezone. See TimeHelper, which renders the element this is attached to.
+export default class extends Controller {
+  static values = { format: { type: String, default: "relative" } }
+
+  connect() {
+    this.render()
+  }
+
+  render() {
+    this.element.textContent = formatTimestamp(this.date, this.formatValue)
+  }
+
+  get date() {
+    return new Date(this.element.getAttribute("datetime"))
+  }
+}
