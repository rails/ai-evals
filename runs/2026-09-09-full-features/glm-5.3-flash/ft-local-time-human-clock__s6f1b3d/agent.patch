diff --git a/app/javascript/helpers/time_helpers.js b/app/javascript/helpers/time_helpers.js
new file mode 100644
index 0000000..0cbe93d
--- /dev/null
+++ b/app/javascript/helpers/time_helpers.js
@@ -0,0 +1,85 @@
+import { signedDifferenceInDays } from "helpers/date_helpers"
+
+// The server only sends timestamps; these turn them into words in the viewer's
+// own timezone.
+//
+//   "1:42 PM"     today
+//   "yesterday"   yesterday
+//   "5 days ago"  earlier in the week
+//   "Sep 12"      further back than that
+//   "tomorrow"    tomorrow, "in 3 days" further ahead
+
+export function formatTimestamp(date, format = RELATIVE, now = new Date()) {
+  switch (format) {
+    case DATE: return formatDate(date, now)
+    case DATE_WITH_YEAR: return dateWithYearFormatter().format(date)
+    case WEEKDAY_AND_DATE: return weekdayAndDateFormatter().format(date)
+    case TIME: return timeFormatter().format(date)
+    case DATE_AND_TIME: return dateAndTimeFormatter().format(date)
+    case COUNTDOWN: return formatCountdown(date, now)
+    default: return formatRelative(date, now)
+  }
+}
+
+function formatRelative(date, now) {
+  const days = signedDifferenceInDays(now, date)
+
+  if (days === 0) return date.getTime() < now.getTime() ? timeFormatter().format(date) : "today"
+  if (days === -1) return "yesterday"
+  if (days === 1) return "tomorrow"
+  if (Math.abs(days) < DAYS_BEFORE_A_DATE_IS_CLEARER) return relativeDateFormatter().format(days, "day")
+
+  return formatDate(date, now)
+}
+
+// A deadline, worded so it reads in a sentence: "Moves to Not Now tomorrow if
+// there's no activity"
+function formatCountdown(date, now) {
+  const days = signedDifferenceInDays(now, date)
+
+  if (days <= 0) return "today"
+  if (days === 1) return "tomorrow"
+  if (days < DAYS_BEFORE_A_DATE_IS_CLEARER) return relativeDateFormatter().format(days, "day")
+
+  return `on ${dateWithYearFormatter().format(date)}`
+}
+
+function formatDate(date, now) {
+  if (date.getFullYear() === now.getFullYear()) {
+    return dateFormatter().format(date)
+  } else {
+    return dateWithYearFormatter().format(date)
+  }
+}
+
+const RELATIVE = "relative"
+const COUNTDOWN = "countdown"
+const DATE = "date"
+const DATE_WITH_YEAR = "date_with_year"
+const WEEKDAY_AND_DATE = "weekday_and_date"
+const TIME = "time"
+const DATE_AND_TIME = "date_and_time"
+
+// The app is written in English, so times are spelled in English as well
+const LOCALE = "en-US"
+
+// A week out, "9 days ago" is harder to place than "Sep 12"
+const DAYS_BEFORE_A_DATE_IS_CLEARER = 7
+
+const DATE_FORMAT = { month: "short", day: "numeric" }
+const DATE_WITH_YEAR_FORMAT = { month: "short", day: "numeric", year: "numeric" }
+const WEEKDAY_AND_DATE_FORMAT = { weekday: "long", month: "long", day: "numeric" }
+const TIME_FORMAT = { hour: "numeric", minute: "2-digit" }
+const DATE_AND_TIME_FORMAT = { year: "2-digit", month: "numeric", day: "numeric", hour: "numeric", minute: "2-digit" }
+
+const dateFormatter = memoize(() => new Intl.DateTimeFormat(LOCALE, DATE_FORMAT))
+const dateWithYearFormatter = memoize(() => new Intl.DateTimeFormat(LOCALE, DATE_WITH_YEAR_FORMAT))
+const weekdayAndDateFormatter = memoize(() => new Intl.DateTimeFormat(LOCALE, WEEKDAY_AND_DATE_FORMAT))
+const timeFormatter = memoize(() => new Intl.DateTimeFormat(LOCALE, TIME_FORMAT))
+const dateAndTimeFormatter = memoize(() => new Intl.DateTimeFormat(LOCALE, DATE_AND_TIME_FORMAT))
+const relativeDateFormatter = memoize(() => new Intl.RelativeTimeFormat(LOCALE, { numeric: "auto" }))
+
+function memoize(build) {
+  let formatter
+  return () => formatter ||= build()
+}
