diff --git a/app/controllers/cards/comments/reactions_controller.rb b/app/controllers/cards/comments/reactions_controller.rb
new file mode 100644
index 0000000..317c8df
--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,56 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  wrap_parameters :reaction, include: %i[ content ]
+
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_reactibility, only: :create
+  before_action :ensure_reactership, only: :destroy
+
+  def index
+    @reactions = @comment.reactions
+
+    fresh_when etag: @reactions
+  end
+
+  def create
+    # Reacting again with the same content doesn't leave a second reaction.
+    @reaction = @comment.reactions.find_or_create_by!(reaction_params.merge(reacter: Current.user))
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { render :show, status: :created, location: card_comment_reaction_path(@card, @comment, @reaction, format: :json) }
+    end
+  end
+
+  def destroy
+    @reaction.destroy
+
+    respond_to do |format|
+      format.turbo_stream
+      format.json { head :no_content }
+    end
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_reactibility
+      head :forbidden unless @card.commentable?
+    end
+
+    def ensure_reactership
+      head :forbidden if Current.user != @reaction.reacter
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..9886d94
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,31 @@
+import { Controller } from "@hotwired/stimulus"
+
+// A single reaction in the strip. Only your own reactions can be expanded, which
+// is what reveals the button that removes them.
+export default class extends Controller {
+  static targets = [ "delete" ]
+  static classes = [ "deleteable", "deleting", "expanded" ]
+
+  connect() {
+    if (this.#isOwn) this.element.classList.add(this.deleteableClass)
+  }
+
+  toggle() {
+    if (!this.#isOwn) return
+
+    this.element.classList.toggle(this.expandedClass)
+    this.deleteTarget.toggleAttribute("hidden")
+  }
+
+  remove() {
+    this.element.classList.add(this.deletingClass)
+  }
+
+  get #isOwn() {
+    return this.#reacterId === Current.user?.id
+  }
+
+  get #reacterId() {
+    return this.element.dataset.reacterId
+  }
+}
diff --git a/app/javascript/controllers/reactions_controller.js b/app/javascript/controllers/reactions_controller.js
new file mode 100644
index 0000000..7b6d62c
--- /dev/null
+++ b/app/javascript/controllers/reactions_controller.js
@@ -0,0 +1,30 @@
+import { Controller } from "@hotwired/stimulus"
+
+// Swaps the "add a reaction" trigger for the little input it turns into, and
+// back again once a reaction was added or the input was canceled.
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input" ]
+  static classes = [ "expanded" ]
+
+  open() {
+    this.#hideItem(this.triggerTarget)
+    this.#showItem(this.formTarget)
+    this.inputTarget.focus()
+  }
+
+  close() {
+    this.#hideItem(this.formTarget)
+    this.#showItem(this.triggerTarget)
+    this.inputTarget.value = ""
+  }
+
+  #showItem(element) {
+    element.removeAttribute("hidden")
+    element.classList.add(this.expandedClass)
+  }
+
+  #hideItem(element) {
+    element.setAttribute("hidden", "hidden")
+    element.classList.remove(this.expandedClass)
+  }
+}
