+require "application_system_test_case"
+
+class DebugShotTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "measure collapsed" do
+    sign_in_as(users(:kevin))
+    card = cards(:logo)
+    comment = comments(:logo_agreement_jz)
+    Current.account = accounts("37s")
+    Current.user = users(:kevin)
+    comment.reactions.create!(content: "Nice work!", reacter: users(:kevin))
+    visit card_url(card)
+    assert_selector "##{dom_id(comment, :reactions)} .reaction"
+    puts page.evaluate_script(<<~JS)
+      (() => {
+        const strip = document.querySelector('##{dom_id(comment, :reactions)}');
+        const chip = strip.querySelector('.reaction');
+        const avatar = strip.querySelector('.reaction__avatar');
+        const trigger = strip.querySelector('.reactions__trigger');
+        const form = strip.querySelector('.reaction__form');
+        const input = strip.querySelector('.reaction__input');
+        const sizes = el => el ? getComputedStyle(el).display + " " + Math.round(el.getBoundingClientRect().width) + "x" + Math.round(el.getBoundingClientRect().height) : "none";
+        return {strip: sizes(strip), list: sizes(strip.querySelector(".reactions__list")), chip: sizes(chip), avatar: sizes(avatar), trigger: sizes(trigger), form: sizes(form), input: sizes(input), chipRadius: getComputedStyle(chip).borderRadius};
+      })()
+    JS
+    find("##{dom_id(comment, :reactions)} .reactions__trigger").click
+    puts page.evaluate_script(<<~JS)
+      (() => {
+        const strip = document.querySelector('##{dom_id(comment, :reactions)}');
+        const sizes = el => el ? getComputedStyle(el).display + " " + Math.round(el.getBoundingClientRect().width) + "x" + Math.round(el.getBoundingClientRect().height) : "none";
+        return {trigger: sizes(strip.querySelector('.reactions__trigger')), form: sizes(strip.querySelector('.reaction__form')), input: sizes(strip.querySelector('.reaction__input')), focused: document.activeElement.className};
+      })()
+    JS
+  end
+end
diff --git a/test/system/reactions_test.rb b/test/system/reactions_test.rb
new file mode 100644
index 0000000..102abbb
--- /dev/null
+++ b/test/system/reactions_test.rb
@@ -0,0 +1,92 @@
+require "application_system_test_case"
+
+class ReactionsTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:kevin))
+    @card = cards(:logo)
+    @comment = comments(:logo_agreement_kevin)
+  end
+
+  test "adding a reaction puts it in the strip and brings the button back" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find(".reactions__trigger").click
+      fill_in dom_id(@comment, :reaction_content), with: "Nice!"
+      find(".reaction__submit-btn").click
+
+      assert_selector ".reaction", text: "Nice!"
+      assert_no_selector ".reactions__form:not([hidden])"
+      assert_selector ".reactions__trigger"
+    end
+  end
+
+  test "canceling keeps the strip as it was" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find(".reactions__trigger").click
+      fill_in dom_id(@comment, :reaction_content), with: "Nice!"
+      find(".reaction__cancel-btn").click
+
+      assert_no_selector ".reaction", text: "Nice!"
+      assert_no_selector ".reactions__form:not([hidden])"
+      assert_selector ".reactions__trigger"
+    end
+  end
+
+  test "your own reaction reveals a way to remove it" do
+    visit card_url(@card)
+
+    reaction = find("##{dom_id(@comment, :reactions)} .reaction", text: "\u{1F389}")
+    assert_selector "##{dom_id(@comment, :reactions)} .reaction--deleteable"
+
+    reaction.click
+    assert_selector "##{dom_id(@comment, :reactions)} .reaction__delete"
+
+    reaction.click
+    assert_no_selector "##{dom_id(@comment, :reactions)} .reaction__delete", visible: true
+  end
+
+  test "removing your own reaction takes it out of the strip" do
+    visit card_url(@card)
+
+    within "##{dom_id(@comment, :reactions)}" do
+      find(".reaction", text: "\u{1F389}").click
+      find(".reaction__delete").click
+
+      assert_no_selector ".reaction", text: "\u{1F389}"
+    end
+  end
+
+  test "someone else's reaction can't be removed" do
+    visit card_url(@card)
+
+    assert_no_selector ".reaction--deleteable", text: "\u{1F44D}"
+
+    find("##{dom_id(comments(:logo_agreement_jz), :reactions)} .reaction", text: "\u{1F44D}").click
+    assert_no_selector ".reaction__delete", visible: true
+  end
+
+  test "reactions made elsewhere land on the card as they happen" do
+    visit card_url(@card)
+    assert_text comments(:logo_agreement_kevin).body.to_plain_text
+
+    wait_for_cable_subscriptions
+    Current.account = accounts("37s")
+    Current.user = users(:jz)
+    comments(:logo_agreement_kevin).reactions.create!(content: "Wow", reacter: users(:jz))
+    perform_enqueued_jobs only: %i[ Turbo::Streams::ActionBroadcastJob Turbo::Streams::BroadcastStreamJob ]
+
+    assert_text "Wow"
+  end
+
+  private
+    # A broadcast sent before the page's subscriptions are confirmed is lost.
+    def wait_for_cable_subscriptions
+      assert_selector "turbo-cable-stream-source[connected]", visible: :all
+      assert_no_selector "turbo-cable-stream-source:not([connected])", visible: :all
+    end
+end
