+require "application_system_test_case"
+
+class DebugBcastTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  test "combined perform" do
+    sign_in_as(users(:kevin))
+    card = cards(:logo)
+    comment = comments(:logo_agreement_kevin)
+    visit card_url(card)
+    assert_selector "turbo-cable-stream-source[connected]", visible: :all
+
+    Current.account = accounts("37s")
+    Current.user = users(:jz)
+    comment.reactions.create!(content: "Wow", reacter: users(:jz))
+
+    perform_enqueued_jobs only: %i[ Turbo::Streams::ActionBroadcastJob Turbo::Streams::BroadcastStreamJob ]
+    sleep 2
+    puts "STRIP: #{page.evaluate_script("var el = document.querySelector('#reactions_comment_#{comment.id}'); el ? el.outerHTML.replace(/</g, '\\n<').slice(0, 800) : 'MISSING'")}"
+  end
+end
