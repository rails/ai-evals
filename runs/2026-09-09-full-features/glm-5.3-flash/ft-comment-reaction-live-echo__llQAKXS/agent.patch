diff --git a/app/models/reaction.rb b/app/models/reaction.rb
new file mode 100644
index 0000000..b8bab52
--- /dev/null
+++ b/app/models/reaction.rb
@@ -0,0 +1,25 @@
+class Reaction < ApplicationRecord
+  MAXIMUM_LENGTH = 16
+
+  belongs_to :account, default: -> { comment.account }
+  belongs_to :comment, touch: true
+  belongs_to :reacter, class_name: "User", default: -> { Current.user }
+
+  scope :chronologically, -> { order created_at: :asc, id: :asc }
+
+  validates :content, presence: true, length: { maximum: MAXIMUM_LENGTH },
+    uniqueness: { scope: %i[ comment_id reacter_id ] }
+
+  after_commit :broadcast_reactions_change, on: %i[ create destroy ]
+
+  def to_partial_path
+    "cards/comments/#{super}"
+  end
+
+  private
+    # Everyone looking at the card sees the reactions strip change as it happens.
+    def broadcast_reactions_change
+      comment.broadcast_replace_later_to comment.card, target: [ comment, :reactions ],
+        partial: "cards/comments/reactions/reactions", locals: { comment: comment }
+    end
+end
