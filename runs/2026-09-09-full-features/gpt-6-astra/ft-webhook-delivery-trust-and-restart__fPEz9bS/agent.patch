+require "test_helper"
+
+class Webhook::DeliveryExecutionTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @delivery = @webhook.deliveries.create!(event: events(:layout_commented))
+    stub_dns_resolution("93.184.216.34")
+  end
+
+  test "posts a signed event once and records the outcome" do
+    post = stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 204)
+
+    @delivery.deliver
+    Webhook::Delivery.find(@delivery.id).deliver
+
+    assert_requested post, times: 1
+    assert @delivery.reload.succeeded?
+    assert_equal 204, @delivery.response[:code]
+    assert_equal @delivery.event.id, JSON.parse(@delivery.request[:body])["id"]
+    assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, @delivery.request[:body]),
+      @delivery.request[:headers]["X-Webhook-Signature"]
+  end
+  test "enqueues delivery after creation and runs with its account context" do
+    assert_enqueued_with(job: Webhook::DeliveryJob, args: [ @delivery ])
+    post = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    perform_enqueued_jobs(only: Webhook::DeliveryJob)
+
+    assert_requested post, times: 1
+    assert @delivery.reload.succeeded?
+    body = JSON.parse(@delivery.request[:body])
+    assert_includes body["board"]["url"], @delivery.account.slug
+  end
+
+  test "does not retry a request already claimed by another worker" do
+    @delivery.update!(state: :in_progress)
+    @delivery.deliver
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "records non-success HTTP responses without retrying or following redirects" do
+    [ 302, 422, 500 ].each do |status|
+      @delivery.update!(state: :pending)
+      post = stub_request(:post, @webhook.url).to_return(status: status, headers: { "Location" => "http://127.0.0.1" })
+
+      @delivery.deliver
+      @delivery.deliver
+
+      assert @delivery.reload.failed?
+      assert @delivery.completed?
+      assert_equal status, @delivery.response[:code]
+      remove_request_stub post
+    end
+    assert_requested :post, @webhook.url, times: 3
+    assert_not_requested :get, "http://127.0.0.1"
+    assert_equal 3, @webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "records timeouts without retrying" do
+    post = stub_request(:post, @webhook.url).to_timeout
+
+    @delivery.deliver
+    @delivery.deliver
+
+    assert_requested post, times: 1
+    assert @delivery.reload.errored?
+    assert @delivery.failed?
+    assert @delivery.response[:error].present?
+    assert_equal 1, @webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "blocks destinations resolving to private addresses" do
+    stub_dns_resolution("127.0.0.1", "169.254.169.254", "::1")
+
+    @delivery.deliver
+
+    assert_not_requested :post, @webhook.url
+    assert @delivery.reload.errored?
+  end
+
+  test "does not send queued deliveries for deactivated webhooks" do
+    @webhook.deactivate
+
+    @delivery.deliver
+
+    assert_not_requested :post, @webhook.url
+    assert_equal "webhook_inactive", @delivery.reload.response[:error]
+    assert_nil @webhook.reload.delinquency_tracker
+  end
+
+  test "a successful delivery resets the failure streak" do
+    @webhook.create_delinquency_tracker!(consecutive_failures_count: 9, first_failure_at: 2.hours.ago)
+    stub_request(:post, @webhook.url).to_return(status: 200)
+
+    @delivery.deliver
+
+    tracker = @webhook.reload.delinquency_tracker
+    assert_equal 0, tracker.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+    assert @webhook.active?
+  end
+
+  test "a tenth failure after an hour deactivates the webhook" do
+    @webhook.create_delinquency_tracker!(consecutive_failures_count: 9, first_failure_at: 1.hour.ago)
+    stub_request(:post, @webhook.url).to_return(status: 503)
+
+    @delivery.deliver
+    @delivery.deliver
+
+    assert_not @webhook.reload.active?
+    assert_equal 10, @webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "a webhook and event have only one delivery even when validation is bypassed" do
+    assert_raises ActiveRecord::RecordNotUnique do
+      @webhook.deliveries.create!(event: @delivery.event)
+    end
+  end
+
+  test "cleanup keeps the last week and deletes older deliveries in every account" do
+    freeze_time do
+      @delivery.update!(created_at: 1.week.ago)
+      old = webhook_deliveries(:successfully_completed)
+      old.update!(created_at: 1.week.ago - 1.second)
+      other_account_delivery = webhooks(:inactive).deliveries.create!(event: events(:layout_commented))
+      other_account_delivery.update_columns(account_id: accounts(:initech).id, created_at: 8.days.ago)
+
+      Webhook::Delivery.cleanup
+
+      assert @delivery.reload.persisted?
+      assert_not Webhook::Delivery.exists?(old.id)
+      assert_not Webhook::Delivery.exists?(other_account_delivery.id)
+    end
+  end
+  test "another worker cannot post while the first request is in flight" do
+    second_worker = Webhook::Delivery.find(@delivery.id)
+    post = stub_request(:post, @webhook.url).to_return do
+      second_worker.deliver
+      { status: 200 }
+    end
+
+    @delivery.deliver
+
+    assert_requested post, times: 1
+    assert_equal 0, @webhook.reload.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "public literal IP addresses are pinned without DNS" do
+    @webhook.update!(url: "http://93.184.216.34/webhook")
+    SsrfProtection.expects(:resolve_public_ip).never
+    post = stub_request(:post, @webhook.url).with(ipaddr: "93.184.216.34").to_return(status: 200)
+
+    @delivery.deliver
+
+    assert_requested post, times: 1
+    assert @delivery.reload.succeeded?
+  end
+
+  test "private literal IP addresses are blocked without DNS" do
+    @webhook.update!(url: "http://127.0.0.1/webhook")
+    SsrfProtection.expects(:resolve_public_ip).never
+
+    @delivery.deliver
+
+    assert_not_requested :post, @webhook.url
+    assert @delivery.reload.errored?
+  end
+
+  test "connection and DNS errors are recorded" do
+    stub_request(:post, @webhook.url).to_raise(Errno::ECONNREFUSED)
+    @delivery.deliver
+    assert_equal "Errno::ECONNREFUSED", @delivery.reload.response[:error]
+
+    @delivery.update!(state: :pending)
+    SsrfProtection.stubs(:resolve_public_ip).raises(Resolv::ResolvError)
+    @delivery.deliver
+    assert_equal "Resolv::ResolvError", @delivery.reload.response[:error]
+  end
+
+  test "jobs for deleted deliveries are discarded" do
+    @delivery.destroy!
+
+    assert_nothing_raised do
+      perform_enqueued_jobs(only: Webhook::DeliveryJob)
+    end
+    assert_not_requested :post, @webhook.url
+  end
+end
