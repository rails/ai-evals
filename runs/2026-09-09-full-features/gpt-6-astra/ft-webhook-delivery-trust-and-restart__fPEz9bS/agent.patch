--- /dev/null
+++ b/test/models/webhook/payload_test.rb
@@ -0,0 +1,47 @@
+require "test_helper"
+
+class Webhook::PayloadTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @event = events(:layout_commented)
+  end
+
+  test "generic endpoints receive the event JSON including comment and tenant URLs" do
+    body = JSON.parse(Webhook::Payload.new(@webhook, @event).to_json)
+
+    assert_equal @event.id, body["id"]
+    assert_equal @event.action, body["action"]
+    assert_equal @event.eventable.id, body["eventable"]["id"]
+    assert_equal @event.creator.id, body["creator"]["id"]
+    assert_includes body["board"]["url"], @event.account.slug
+  end
+
+  test "Slack endpoints receive text" do
+    @webhook.url = "https://hooks.slack.com/services/T123/B456/token"
+    body = JSON.parse(Webhook::Payload.new(@webhook, @event).to_json)
+
+    assert_includes body["text"], "commented on"
+    assert_includes body["text"], @event.account.slug
+  end
+
+  test "Campfire and Basecamp endpoints receive HTML content" do
+    [ "https://chat.example.com/rooms/123/456-bot/messages",
+      "https://3.basecamp.com/123/integrations/token/buckets/456/chats/789/lines" ].each do |url|
+      @webhook.url = url
+      body = JSON.parse(Webhook::Payload.new(@webhook, @event).to_json)
+
+      assert_includes body["content"], "commented on"
+      assert_includes body["content"], "<a href="
+      assert_includes body["content"], @event.account.slug
+    end
+  end
+  test "payload links respect the configured host protocol port and tenant" do
+    defaults = Rails.application.routes.default_url_options.dup
+    Rails.application.routes.default_url_options.merge!(host: "fizzy.example.com", protocol: "https", port: 8443)
+
+    body = JSON.parse(Webhook::Payload.new(@webhook, @event).to_json)
+    assert body["board"]["url"].start_with?("https://fizzy.example.com:8443#{@event.account.slug}/")
+  ensure
+    Rails.application.routes.default_url_options.replace(defaults)
+  end
+end
