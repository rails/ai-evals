diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..817a1dd
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,65 @@
+require "net/http"
+
+class Webhook::Delivery::Request
+  TIMEOUT = 10
+
+  attr_reader :delivery
+
+  delegate :webhook, :event, to: :delivery
+
+  def initialize(delivery)
+    @delivery = delivery
+  end
+
+  def perform
+    payload = Webhook::Payload.new(webhook, event).to_json
+    headers = {
+      "Content-Type" => "application/json",
+      "User-Agent" => "Fizzy Webhook",
+      "X-Webhook-Id" => delivery.id,
+      "X-Webhook-Timestamp" => Time.current.utc.iso8601(3),
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, payload)
+    }
+    delivery.update! request: { headers: headers, body: payload }
+
+    response = post(payload, headers)
+    { state: :completed, response: response }
+  rescue Timeout::Error, SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::ProtocolError, Resolv::ResolvError, Resolv::ResolvTimeout, URI::InvalidURIError => error
+    { state: :errored, response: { error: error.class.name } }
+  end
+
+  private
+    def post(payload, headers)
+      uri = URI.parse(webhook.url)
+      unless Webhook::PERMITTED_SCHEMES.include?(uri.scheme) && uri.hostname.present? && uri.userinfo.nil?
+        raise URI::InvalidURIError, "Invalid webhook URL"
+      end
+      ip = resolve_ip(uri.hostname)
+      raise SocketError, "Destination must resolve to a public address" unless ip
+
+      # Pin the validated IP while retaining the hostname for TLS and Host.
+      # Do not use environment proxies or follow redirects to unchecked URLs.
+      http = Net::HTTP.new(uri.hostname, uri.port, nil)
+      http.ipaddr = ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+      http.max_retries = 0
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = payload
+
+      Timeout.timeout(TIMEOUT) do
+        http.request(request) do |response|
+          response.read_body { |_chunk| } # Drain without retaining an unbounded response body.
+          return { code: response.code.to_i, headers: response.to_hash }
+        end
+      end
+    end
+
+    def resolve_ip(hostname)
+      ip = IPAddr.new(hostname)
+      ip.to_s unless SsrfProtection.blocked_address?(ip)
+    rescue IPAddr::InvalidAddressError
+      SsrfProtection.resolve_public_ip(hostname)
+    end
+end
