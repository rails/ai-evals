@@ -0,0 +1,61 @@
+require "test_helper"
+
+class Event::WebhookDispatchingTest < ActiveSupport::TestCase
+  test "dispatches only to active subscriptions on the event's board" do
+    webhook = webhooks(:active)
+    inactive = Webhook.create!(webhook.attributes.except("id", "created_at", "updated_at").merge(active: false))
+    unsubscribed = Webhook.create!(webhook.attributes.except("id", "created_at", "updated_at").merge(subscribed_actions: []))
+    other_board = Webhook.create!(webhook.attributes.except("id", "created_at", "updated_at").merge(board: boards(:private)))
+
+    event = nil
+    assert_difference "Webhook::Delivery.count", 1 do
+      event = create_event
+    end
+
+    assert_equal [ webhook ], event.webhook_deliveries.map(&:webhook)
+    assert_equal event.account, event.webhook_deliveries.sole.account
+    assert_empty inactive.deliveries
+    assert_empty unsubscribed.deliveries
+    assert_empty other_board.deliveries
+  end
+
+  test "does not dispatch unsubscribed actions" do
+    assert_no_difference "Webhook::Delivery.count" do
+      create_event(action: "card_title_changed")
+    end
+  end
+
+  test "rolled back events leave no delivery or job" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference "Webhook::Delivery.count" do
+        Event.transaction do
+          create_event
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "dispatches once to each subscribed webhook even if dispatch is repeated" do
+    first = webhooks(:active)
+    second = Webhook.create!(name: "Second", url: "https://second.example.com/webhook",
+      board: first.board, subscribed_actions: first.subscribed_actions)
+
+    event = nil
+    assert_difference "Webhook::Delivery.count", 2 do
+      event = create_event
+    end
+    assert_equal [ first.id, second.id ].sort, event.webhook_deliveries.pluck(:webhook_id).sort
+
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference "Webhook::Delivery.count" do
+        event.send(:dispatch_webhooks)
+      end
+    end
+  end
+
+  private
+    def create_event(**attributes)
+      boards(:writebook).events.create!({ action: "card_published", eventable: cards(:logo), creator: users(:david) }.merge(attributes))
+    end
+end
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..d2fa56d
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,64 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @tracker = @webhook.create_delinquency_tracker!
+    @failure = Webhook::Delivery.new(webhook: @webhook, state: :errored, response: { error: "timeout" })
+    @success = Webhook::Delivery.new(webhook: @webhook, state: :completed, response: { code: 200 })
+  end
+
+  test "requires both ten failures and an hour of failure" do
+    freeze_time do
+      9.times { @tracker.record(@failure) }
+      assert @webhook.reload.active?
+
+      travel 1.hour
+      assert @webhook.reload.active?
+      @tracker.record(@failure)
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "ten rapid failures do not deactivate the webhook" do
+    freeze_time do
+      10.times { @tracker.record(@failure) }
+      assert @webhook.reload.active?
+
+      travel 1.hour - 1.second
+      @tracker.record(@failure)
+      assert @webhook.reload.active?
+
+      travel 1.second
+      @tracker.record(@failure)
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "a success restarts the count and the hour" do
+    @tracker.update!(consecutive_failures_count: 9, first_failure_at: 2.hours.ago)
+    @tracker.record(@success)
+    @tracker.record(@failure)
+
+    assert_equal 1, @tracker.reload.consecutive_failures_count
+    assert_in_delta Time.current, @tracker.first_failure_at, 1.second
+    assert @webhook.reload.active?
+  end
+
+  test "reactivation clears the failure streak" do
+    @tracker.update!(consecutive_failures_count: 10, first_failure_at: 2.hours.ago)
+    @webhook.deactivate
+    @webhook.activate
+
+    assert_equal 0, @tracker.reload.consecutive_failures_count
+    assert_nil @tracker.first_failure_at
+    @tracker.record(@failure)
+    assert @webhook.reload.active?
+  end
+
+  test "destroying the webhook removes its tracker" do
+    assert_difference "Webhook::DelinquencyTracker.count", -1 do
+      @webhook.destroy!
+    end
+  end
+end
