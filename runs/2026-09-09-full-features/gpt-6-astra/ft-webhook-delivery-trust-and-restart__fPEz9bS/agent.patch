@@ -0,0 +1,25 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_THRESHOLD = 10
+  FAILURE_DURATION = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  # Called under the webhook lock, together with saving the delivery result.
+  def record(delivery)
+    if delivery.succeeded?
+      reset
+    elsif delivery.failed?
+      update! consecutive_failures_count: consecutive_failures_count + 1,
+        first_failure_at: first_failure_at || Time.current
+
+      if consecutive_failures_count >= FAILURE_THRESHOLD && first_failure_at <= FAILURE_DURATION.ago
+        webhook.deactivate
+      end
+    end
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+end
