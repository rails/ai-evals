+module Event::WebhookDispatching
+  extend ActiveSupport::Concern
+
+  included do
+    # Persist the deliveries with the event; their jobs only enqueue after commit.
+    after_create :dispatch_webhooks
+  end
+
+  private
+    def dispatch_webhooks
+      board.webhooks.active.find_each do |webhook|
+        if webhook.subscribed_actions.include?(action)
+          webhook.deliveries.create_or_find_by!(event: self)
+        end
+      end
+    end
+end
