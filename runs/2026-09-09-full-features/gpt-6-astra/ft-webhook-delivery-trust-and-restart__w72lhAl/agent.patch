+require "test_helper"
+
+class Webhook::DispatchTest < ActiveSupport::TestCase
+  test "a subscribed board event is posted and logged once" do
+    webhook = webhooks(:active)
+    SsrfProtection.stubs(:resolve_public_ip).returns("93.184.216.34")
+    post = stub_request(:post, webhook.url).to_return(status: 204)
+
+    assert_difference "webhook.deliveries.count", 1 do
+      perform_enqueued_jobs do
+        @event = Event.create!(board: webhook.board, creator: users(:david), eventable: cards(:logo), action: "card_closed")
+      end
+    end
+
+    delivery = webhook.deliveries.find_by!(event: @event)
+    assert delivery.succeeded?
+    delivery.deliver_now
+    assert_requested post, times: 1
+  end
+  test "only active subscribers on the event board receive a delivery" do
+    webhook = webhooks(:active)
+    second = webhook.board.webhooks.create!(name: "Second", url: "https://second.example.com", subscribed_actions: [ "card_closed" ])
+    webhook.board.webhooks.create!(name: "Unsubscribed", url: "https://unsubscribed.example.com", subscribed_actions: [ "comment_created" ])
+    webhook.board.webhooks.create!(name: "Inactive", url: "https://inactive.example.com", subscribed_actions: [ "card_closed" ], active: false)
+    webhooks(:inactive).activate
+
+    assert_enqueued_jobs 2, only: Webhook::DeliveryJob do
+      @event = Event.create!(board: webhook.board, creator: users(:david), eventable: cards(:logo), action: "card_closed")
+    end
+
+    assert_equal [ webhook.id, second.id ].sort, @event.webhook_deliveries.pluck(:webhook_id).sort
+    assert_equal [ webhook.account_id ], @event.webhook_deliveries.pluck(:account_id).uniq
+  end
+
+  test "unsubscribed events do not create deliveries" do
+    assert_no_difference "Webhook::Delivery.count" do
+      Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_triaged")
+    end
+  end
+
+  test "rolled back events do not leave deliveries or enqueue jobs" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference "Webhook::Delivery.count" do
+        Event.transaction do
+          Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_closed")
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+end
