diff --git a/app/models/webhook/delinquency_tracker.rb b/app/models/webhook/delinquency_tracker.rb
new file mode 100644
index 0000000..52fb571
--- /dev/null
+++ b/app/models/webhook/delinquency_tracker.rb
@@ -0,0 +1,24 @@
+class Webhook::DelinquencyTracker < ApplicationRecord
+  FAILURE_LIMIT = 10
+  FAILURE_PERIOD = 1.hour
+
+  belongs_to :account, default: -> { webhook.account }
+  belongs_to :webhook
+
+  def record(delivery)
+    if delivery.succeeded?
+      reset
+    else
+      update! consecutive_failures_count: consecutive_failures_count + 1, first_failure_at: first_failure_at || Time.current
+      webhook.deactivate if delinquent?
+    end
+  end
+
+  def reset
+    update! consecutive_failures_count: 0, first_failure_at: nil
+  end
+
+  def delinquent?
+    consecutive_failures_count >= FAILURE_LIMIT && first_failure_at && first_failure_at <= FAILURE_PERIOD.ago
+  end
+end
diff --git a/app/models/webhook/delivery.rb b/app/models/webhook/delivery.rb
index 4ecfeb8..3f71c32 100644
--- a/app/models/webhook/delivery.rb
+++ b/app/models/webhook/delivery.rb
@@ -1,4 +1,9 @@
+require "net/http"
+
 class Webhook::Delivery < ApplicationRecord
+  RETENTION_PERIOD = 1.week
+  REQUEST_TIMEOUT = 10.seconds
+
   belongs_to :account, default: -> { webhook.account }
   belongs_to :webhook
   belongs_to :event
@@ -10,6 +15,29 @@ class Webhook::Delivery < ApplicationRecord
 
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  after_create_commit :deliver_later
+
+  def self.cleanup
+    where(created_at: ...RETENTION_PERIOD.ago).in_batches.delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    # Commit the claim before making the request. A repeated job must never
+    # repeat a POST, even if a worker died before recording its outcome.
+    if self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+      reload
+      if webhook.reload.active?
+        deliver_request
+      else
+        update! state: :errored, response: { error: "webhook_inactive" }
+      end
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -27,6 +55,70 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def deliver_request
+      body = payload.to_json
+      headers = {
+        "Content-Type" => "application/json",
+        "User-Agent" => "Fizzy Webhook",
+        "X-Webhook-Id" => id,
+        "X-Webhook-Timestamp" => Time.current.iso8601,
+        "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", webhook.signing_secret, body)
+      }
+      update! request: { headers: headers, body: body }
+
+      state, result = post(body, headers)
+      transaction do
+        update! state: state, response: result
+        webhook.record_delivery(self)
+      end
+    end
+
+    def payload
+      {
+        id: event.id,
+        action: event.action,
+        created_at: event.created_at,
+        board: { id: event.board_id, name: event.board.name },
+        creator: { id: event.creator_id, name: event.creator.name },
+        card: { id: event.card.id, number: event.card.number, title: event.card.title },
+        eventable: { id: event.eventable_id, type: event.eventable_type },
+        particulars: event.api_particulars
+      }
+    end
+
+    def post(body, headers)
+      uri = URI.parse(webhook.url)
+      ip = resolve_public_ip(uri.hostname)
+
+      if ip
+        # Pin the validated address without changing TLS hostname verification.
+        # Do not use an environment proxy, follow redirects, or retry requests.
+        http = Net::HTTP.new(uri.hostname, uri.port, nil)
+        http.ipaddr = ip
+        http.use_ssl = uri.scheme == "https"
+        http.open_timeout = http.read_timeout = http.write_timeout = REQUEST_TIMEOUT
+        http.max_retries = 0
+        result = nil
+        http.request(Net::HTTP::Post.new(uri.request_uri, headers), body) do |response|
+          result = { code: response.code.to_i, headers: response.to_hash }
+          response.read_body { |_| } # Discard chunks rather than buffering an unbounded body.
+        end
+        [ :completed, result ]
+      else
+        [ :errored, { error: "destination_unreachable" } ]
+      end
+    rescue Timeout::Error, SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Resolv::ResolvError => error
+      [ :errored, { error: error.class.name } ]
+    end
+
+    def resolve_public_ip(hostname)
+      address = IPAddr.new(hostname)
+      address.to_s unless SsrfProtection.blocked_address?(address)
+    rescue IPAddr::InvalidAddressError
+      SsrfProtection.resolve_public_ip(hostname)
+    end
 end
