diff --git a/docs/webhooks.md b/docs/webhooks.md
new file mode 100644
index 0000000..ba63283
--- /dev/null
+++ b/docs/webhooks.md
@@ -0,0 +1,50 @@
+# Board webhooks
+
+Board administrators can use the existing Webhooks settings to register an HTTP
+or HTTPS receiver and select actions. Each committed event creates a delivery for
+each active subscriber on that event's board. Changes that roll back do not send
+webhooks. An empty action selection sends nothing.
+
+## Requests and results
+
+Deliveries run in the background and POST JSON containing the event's `id`,
+`action`, `created_at`, `board` (ID and name), `creator` (ID and name), `card`
+(ID, number, and title), `eventable` (ID and type), and action-specific
+`particulars`. The `X-Webhook-Id` header identifies the delivery;
+`X-Webhook-Timestamp` identifies the request time.
+
+To authenticate a request, compute the hex-encoded HMAC-SHA256 of the **raw
+request body**, using the signing secret from the webhook settings. Compare it
+with `X-Webhook-Signature` using a constant-time comparison.
+
+A 2xx response is a success. Other statuses, including redirects, are failures;
+redirects are never followed. Network errors are also failures. Connections use
+10-second open, read, and write timeouts. Protected/private destination addresses
+are blocked, and connections are pinned to a validated public address.
+
+The settings page shows delivery states and HTTP statuses or errors. The existing
+JSON delivery-log endpoint also exposes sanitized request headers and the result.
+The signature is excluded from that endpoint. Logs older than seven days are
+removed by the existing cleanup task, which runs every 15 minutes.
+
+## Single-attempt delivery
+
+There is one delivery record per webhook/event pair, enforced by a unique database
+index. A worker atomically claims it before sending. Neither failed requests nor
+duplicate executions of a job send the POST again. Pending deliveries are skipped
+if the webhook has been deactivated.
+
+This is **at-most-once sending**, not a guarantee of exactly-once processing by an
+arbitrary HTTP receiver. If a worker crashes after claiming a delivery, its log
+can remain `in_progress` and it will not retry: the receiver may already have
+processed the POST. Receivers can use `X-Webhook-Id` as an idempotency key.
+End-to-end exactly-once processing requires receiver cooperation; retrying an
+ambiguous network failure would risk duplicate processing.
+
+## Automatic deactivation
+
+A webhook is deactivated after at least ten consecutive failed deliveries when
+the failure streak spans at least one hour. Both conditions must hold: a short
+burst of ten failures alone does not deactivate it. A success clears the count
+and the first-failure timestamp. Failure tracking is independent of retained logs.
+Reactivating a webhook from its settings clears the streak and starts it afresh.
diff --git a/test/models/webhook/delinquency_tracker_test.rb b/test/models/webhook/delinquency_tracker_test.rb
new file mode 100644
index 0000000..16a5a60
--- /dev/null
+++ b/test/models/webhook/delinquency_tracker_test.rb
@@ -0,0 +1,62 @@
+require "test_helper"
+
+class Webhook::DelinquencyTrackerTest < ActiveSupport::TestCase
+  setup do
+    @webhook = webhooks(:active)
+    @failure = webhook_deliveries(:unsuccessfully_completed)
+    @success = webhook_deliveries(:successfully_completed)
+  end
+
+  test "ten consecutive failures spanning an hour deactivate the webhook" do
+    freeze_time do
+      @webhook.record_delivery(@failure)
+      travel 1.hour
+      8.times { @webhook.record_delivery(@failure) }
+      assert @webhook.reload.active?
+
+      @webhook.record_delivery(@failure)
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "ten failures in less than an hour do not deactivate" do
+    freeze_time do
+      10.times { @webhook.record_delivery(@failure) }
+      travel 1.hour - 1.second
+      @webhook.record_delivery(@failure)
+      assert @webhook.reload.active?
+
+      travel 1.second
+      @webhook.record_delivery(@failure)
+      assert_not @webhook.reload.active?
+    end
+  end
+
+  test "success resets the consecutive failure count and period" do
+    @webhook.record_delivery(@failure)
+    travel 2.hours
+    @webhook.record_delivery(@success)
+
+    tracker = @webhook.delinquency_tracker.reload
+    assert_equal 0, tracker.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+
+    10.times { @webhook.record_delivery(@failure) }
+    assert @webhook.reload.active?
+  end
+
+  test "reactivation resets the failure streak" do
+    @webhook.record_delivery(@failure)
+    travel 2.hours
+    9.times { @webhook.record_delivery(@failure) }
+    assert_not @webhook.reload.active?
+
+    @webhook.activate
+
+    assert @webhook.reload.active?
+    assert_equal 0, @webhook.delinquency_tracker.reload.consecutive_failures_count
+    assert_nil @webhook.delinquency_tracker.first_failure_at
+    @webhook.record_delivery(@failure)
+    assert @webhook.reload.active?
+  end
+end
diff --git a/test/models/webhook/delivery_execution_test.rb b/test/models/webhook/delivery_execution_test.rb
new file mode 100644
index 0000000..5db7db9
--- /dev/null
+++ b/test/models/webhook/delivery_execution_test.rb
@@ -0,0 +1,178 @@
+require "test_helper"
+
+class Webhook::DeliveryExecutionTest < ActiveSupport::TestCase
+  setup do
+    @delivery = webhook_deliveries(:pending)
+    @webhook = @delivery.webhook
+    SsrfProtection.stubs(:resolve_public_ip).returns("93.184.216.34")
+  end
+
+  test "POST contains event data and a verifiable signature" do
+    post = stub_request(:post, @webhook.url).with do |request|
+      payload = JSON.parse(request.body)
+      assert_equal @delivery.event_id, payload["id"]
+      assert_equal @delivery.event.action, payload["action"]
+      assert_equal @delivery.event.board_id, payload.dig("board", "id")
+      assert_equal @delivery.id, request.headers["X-Webhook-Id"]
+      assert_equal "application/json", request.headers["Content-Type"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", @webhook.signing_secret, request.body), request.headers["X-Webhook-Signature"]
+      true
+    end.to_return(status: 201, headers: { "X-Result" => "ok" })
+
+    @delivery.deliver_now
+
+    assert @delivery.succeeded?
+    assert_equal 201, @delivery.reload.response[:code]
+    assert_equal [ "ok" ], @delivery.response.dig("headers", "x-result")
+    assert_requested post, times: 1
+  end
+
+  test "HTTP failures are logged without retries" do
+    post = stub_request(:post, @webhook.url).to_return(status: 503)
+
+    2.times { Webhook::DeliveryJob.perform_now(@delivery) }
+
+    assert @delivery.reload.failed?
+    assert @delivery.completed?
+    assert_equal 503, @delivery.response[:code]
+    assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+    assert_requested post, times: 1
+  end
+
+  test "timeouts are logged without retries" do
+    post = stub_request(:post, @webhook.url).to_timeout
+
+    2.times { @delivery.deliver_now }
+
+    assert @delivery.reload.errored?
+    assert @delivery.failed?
+    assert @delivery.response[:error].present?
+    assert_equal 1, @webhook.delinquency_tracker.consecutive_failures_count
+    assert_requested post, times: 1
+  end
+
+  test "redirects are failures and are not followed" do
+    post = stub_request(:post, @webhook.url).to_return(status: 302, headers: { "Location" => "http://127.0.0.1/secret" })
+    stub_request(:any, "http://127.0.0.1/secret").to_raise("must not follow redirects")
+
+    @delivery.deliver_now
+
+    assert @delivery.failed?
+    assert_equal 302, @delivery.response[:code]
+    assert_requested post, times: 1
+    assert_not_requested :any, "http://127.0.0.1/secret"
+  end
+
+  test "blocked destinations are logged without an HTTP request" do
+    SsrfProtection.stubs(:resolve_public_ip).returns(nil)
+
+    @delivery.deliver_now
+
+    assert @delivery.errored?
+    assert_equal "destination_unreachable", @delivery.response[:error]
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "queued deliveries do not send after deactivation" do
+    @webhook.deactivate
+
+    @delivery.deliver_now
+
+    assert @delivery.errored?
+    assert_equal "webhook_inactive", @delivery.response[:error]
+    assert_not_requested :post, @webhook.url
+    assert_nil @webhook.delinquency_tracker
+  end
+
+  test "public IP literal destinations are supported" do
+    @webhook.update!(url: "http://93.184.216.34/webhook")
+    post = stub_request(:post, @webhook.url).to_return(status: 200)
+    SsrfProtection.expects(:resolve_public_ip).never
+
+    @delivery.deliver_now
+
+    assert @delivery.succeeded?
+    assert_requested post, times: 1
+  end
+
+  test "private IP literal destinations are blocked" do
+    @webhook.update!(url: "http://127.0.0.1/webhook")
+    SsrfProtection.expects(:resolve_public_ip).never
+
+    @delivery.deliver_now
+
+    assert @delivery.errored?
+    assert_equal "destination_unreachable", @delivery.response[:error]
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "the HTTP connection is pinned and has no proxy or automatic retries" do
+    connection = Net::HTTP.new("api.example.com", 443, nil)
+    Net::HTTP.expects(:new).with("api.example.com", 443, nil).returns(connection)
+    post = stub_request(:post, @webhook.url).to_return(status: 200)
+
+    @delivery.deliver_now
+
+    assert_equal "93.184.216.34", connection.ipaddr
+    assert connection.use_ssl?
+    assert_equal 0, connection.max_retries
+    assert_equal 10, connection.open_timeout
+    assert_equal 10, connection.read_timeout
+    assert_equal 10, connection.write_timeout
+    assert_requested post, times: 1
+  end
+
+  test "another worker cannot claim an in progress delivery" do
+    @delivery.update!(state: :in_progress)
+
+    @delivery.deliver_now
+
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "a competing worker cannot POST while the first worker is sending" do
+    competing_delivery = Webhook::Delivery.find(@delivery.id)
+    post = stub_request(:post, @webhook.url).to_return do
+      competing_delivery.deliver_now
+      { status: 200 }
+    end
+
+    @delivery.deliver_now
+
+    assert @delivery.succeeded?
+    assert_requested post, times: 1
+  end
+
+  test "deleted deliveries are safely discarded by the job" do
+    job = Webhook::DeliveryJob.perform_later(@delivery)
+    @delivery.destroy!
+
+    assert_nothing_raised { ActiveJob::Base.execute(job.serialize) }
+    assert_not_requested :post, @webhook.url
+  end
+
+  test "a webhook event pair is unique in the database" do
+    assert_raises ActiveRecord::RecordNotUnique do
+      Webhook::Delivery.create!(webhook: @webhook, event: @delivery.event)
+    end
+  end
+
+  test "cleanup removes only logs older than a week" do
+    freeze_time do
+      old = webhook_deliveries(:successfully_completed)
+      old.update_columns(created_at: 1.week.ago - 1.second)
+      @delivery.update_columns(created_at: 1.week.ago)
+
+      Webhook::Delivery.cleanup
+
+      assert_not Webhook::Delivery.exists?(old.id)
+      assert Webhook::Delivery.exists?(@delivery.id)
+      assert Webhook::Delivery.exists?(webhook_deliveries(:in_progress).id)
+    end
+  end
+
+  test "a missing response code is not a success" do
+    @delivery.assign_attributes(state: :completed, response: {})
+    assert_not @delivery.succeeded?
+  end
+end
