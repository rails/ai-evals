diff --git a/test/models/card/entropic_test.rb b/test/models/card/entropic_test.rb
index 848cfa7..62ece4c 100644
--- a/test/models/card/entropic_test.rb
+++ b/test/models/card/entropic_test.rb
@@ -85,4 +85,99 @@ class Card::EntropicTest < ActiveSupport::TestCase
 
     assert_equal(cards(:logo, :radio).to_set, Card.postponing_soon.to_set)
   end
+
+  test "auto postpone includes the cutoff but not more recent activity" do
+    freeze_time
+    cutoff = entropies(:writebook_board).auto_postpone_period.seconds.ago
+    cards(:logo).update! last_active_at: cutoff
+    cards(:layout).update! last_active_at: cutoff + 1.second
+    cards(:text).update! last_active_at: cutoff - 1.second
+
+    assert_difference -> { Card.postponed.count }, 2 do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:logo).reload.postponed?
+    assert cards(:text).reload.postponed?
+    assert_not cards(:layout).reload.postponed?
+  end
+
+  test "auto postpone excludes closed, drafted, and already postponed cards" do
+    cards(:logo).postpone
+    cards(:layout).drafted!
+    cards(:logo, :layout, :shipping).each do |card|
+      card.update! last_active_at: 2.years.ago
+    end
+
+    assert_no_difference [ -> { Card::NotNow.count }, -> { Event.count } ] do
+      Card.auto_postpone_all_due
+    end
+
+    assert cards(:shipping).reload.closed?
+    assert cards(:layout).reload.drafted?
+  end
+
+  test "auto postpone respects shorter and longer board overrides" do
+    entropies("37s_account").update! auto_postpone_period: 30.days
+    entropies(:writebook_board).update! auto_postpone_period: 90.days
+    entropies(:initech_account).update! auto_postpone_period: 90.days
+    entropies(:miltons_wish_list_board).update! auto_postpone_period: 30.days
+    cards(:logo, :radio).each { |card| card.update! last_active_at: 60.days.ago }
+
+    Card.auto_postpone_all_due
+
+    assert_not cards(:logo).reload.postponed?
+    assert cards(:radio).reload.postponed?
+    assert_equal accounts(:initech).system_user, cards(:radio).postponed_by
+
+    assert_no_difference -> { Event.count } do
+      Card.auto_postpone_all_due
+    end
+  end
+
+  test "auto postpone falls back to each board's own account entropy" do
+    entropies(:writebook_board, :miltons_wish_list_board).each(&:destroy!)
+    entropies("37s_account").update! auto_postpone_period: 90.days
+    entropies(:initech_account).update! auto_postpone_period: 30.days
+    cards(:logo, :radio).each { |card| card.update! last_active_at: 60.days.ago }
+
+    Card.auto_postpone_all_due
+
+    assert_not cards(:logo).reload.postponed?
+    assert cards(:radio).reload.postponed?
+    assert_equal accounts(:initech).system_user, cards(:radio).postponed_by
+  end
+
+  test "auto postpone uses indexed board activity lookups on SQLite" do
+    skip "SQLite query plan" unless Card.connection.adapter_name == "SQLite"
+
+    queries = []
+    subscriber = ->(event) do
+      if event.payload[:sql].start_with?('SELECT "cards".*')
+        queries << event.payload
+      end
+    end
+
+    ActiveSupport::Notifications.subscribed(subscriber, "sql.active_record") do
+      Card.auto_postpone_all_due
+    end
+
+    assert_not_empty queries
+    queries.each do |query|
+      assert_no_match(/JOIN "(?:boards|accounts|entropies)"/, query[:sql])
+      plan = Card.connection.exec_query("EXPLAIN QUERY PLAN #{query[:sql]}", "EXPLAIN", query[:binds])
+      assert_match(/index_cards_on_board_id_and_last_active_at/, plan.rows.flatten.join(" "))
+    end
+  end
+
+  test "auto postpone skips boards without any entropy settings" do
+    entropies(:writebook_board).destroy!
+    entropies("37s_account").destroy!
+    cards(:logo, :radio).each { |card| card.update! last_active_at: 2.years.ago }
+
+    Card.auto_postpone_all_due
+
+    assert_not cards(:logo).reload.postponed?
+    assert cards(:radio).reload.postponed?
+  end
 end
