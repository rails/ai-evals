+++ b/app/models/card/entropic.rb
@@ -25,8 +25,15 @@ module Card::Entropic
 
   class_methods do
     def auto_postpone_all_due
-      due_to_be_postponed.find_each do |card|
-        card.auto_postpone(user: card.account.system_user)
+      now = Time.current
+
+      # Resolve entropy once per board so the sweep can use the board/activity index.
+      Board.preload(:entropy, account: :entropy).find_each do |board|
+        if period = board.entropy&.auto_postpone_period
+          board.cards.active.where(last_active_at: ..(now - period)).find_each do |card|
+            card.auto_postpone(user: board.account.system_user)
+          end
+        end
       end
     end
   end
