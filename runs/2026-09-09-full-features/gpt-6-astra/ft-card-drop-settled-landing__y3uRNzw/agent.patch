diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..fa1efe2
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,231 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+const DRAGGED_CLASS = "drag-and-drop__dragged-item"
+const HOVER_CLASS = "drag-and-drop__hover-container"
+
+export default class extends Controller {
+  static targets = [ "card", "column", "stamp", "columnName", "empty" ]
+  static values = { userName: String }
+
+  #card
+  #hoveredColumn
+  #saving = false
+  #pendingColumns = []
+  #columnVersions = new WeakMap()
+  #frameRequests = new WeakMap()
+
+  cardTargetConnected(card) {
+    card.draggable = true
+  }
+
+  disconnect() {
+    this.end()
+    this.cardTargets.forEach(card => card.removeAttribute("draggable"))
+  }
+
+  start(event) {
+    const card = event.target.closest('[data-drag-and-drop-target~="card"]')
+    if (!this.cardTargets.includes(card) || this.#saving || event.target.closest("input, textarea, button, [contenteditable]")) {
+      event.preventDefault()
+      return
+    }
+
+    this.#card = card
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+    card.classList.add(DRAGGED_CLASS)
+  }
+
+  over(event) {
+    const column = this.#destination(event)
+    this.#highlight(column)
+    if (column) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = "move"
+    }
+  }
+
+  leave(event) {
+    if (this.#hoveredColumn && !this.#hoveredColumn.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  async drop(event) {
+    const column = this.#destination(event)
+    if (!column) {
+      this.end()
+      return
+    }
+
+    event.preventDefault()
+    const card = this.#card
+    const source = card.closest('[data-drag-and-drop-target~="column"]')
+    this.end()
+
+    const original = { parent: card.parentNode, next: card.nextSibling, copy: card.cloneNode(true) }
+    this.#saving = true
+    this.#pendingColumns = [ source, column ]
+    this.#pendingColumns.forEach(column => this.#columnVersions.set(column, (this.#columnVersions.get(column) || 0) + 1))
+    this.element.setAttribute("aria-busy", "true")
+    // Keep unrelated refreshes from overwriting the optimistic move during the save.
+    this.element.setAttribute("data-turbo-permanent", "")
+    this.#move(card, source, column)
+
+    try {
+      const response = await this.#request(card, column).perform()
+      if (!response.ok) throw new Error("Unable to move card")
+    } catch (error) {
+      original.parent.insertBefore(original.copy, original.next)
+      card.remove()
+      this.#changeCount(source, 1)
+      this.#changeCount(column, -1)
+      this.#ensureEmptyPlaceholder(column)
+      window.alert("The card couldn't be moved. Please try again.")
+    } finally {
+      this.#saving = false
+      this.#pendingColumns = []
+      this.element.removeAttribute("aria-busy")
+      this.element.removeAttribute("data-turbo-permanent")
+    }
+  }
+
+  rememberFrameRequest(event) {
+    const column = event.target.closest('[data-drag-and-drop-target~="column"]')
+    if (this.columnTargets.includes(column)) {
+      this.#frameRequests.set(event.target, {
+        version: this.#columnVersions.get(column) || 0,
+        pending: this.#pendingColumns.includes(column)
+      })
+    }
+  }
+
+  preservePendingMove(event) {
+    const column = event.target.closest('[data-drag-and-drop-target~="column"]')
+    const request = this.#frameRequests.get(event.target)
+    const stale = request && (request.pending || request.version !== (this.#columnVersions.get(column) || 0))
+    if ((stale || this.#pendingColumns.includes(column)) && event.target.querySelector(".cards__list")) {
+      // A frame fetch started before the save can still contain the old location.
+      // Keep our already-rendered list instead of applying that stale snapshot.
+      event.detail.render = () => {}
+    }
+  }
+
+  end() {
+    this.#card?.classList.remove(DRAGGED_CLASS)
+    this.#card = null
+    this.#highlight(null)
+  }
+
+  #destination(event) {
+    if (!this.#card || this.#saving) return null
+
+    const column = event.target.closest('[data-drag-and-drop-target~="column"]')
+    if (this.columnTargets.includes(column) && !column.contains(this.#card) && column.querySelector(".cards__list")) {
+      return column
+    }
+  }
+
+  #highlight(column) {
+    this.#hoveredColumn?.classList.remove(HOVER_CLASS)
+    this.#hoveredColumn = column
+    column?.classList.add(HOVER_CLASS)
+  }
+
+  #move(card, source, column) {
+    const list = column.querySelector(".cards__list")
+    const cards = Array.from(list.querySelectorAll('[data-drag-and-drop-target~="card"]'))
+    const goldenFirst = [ "maybe", "column" ].includes(column.dataset.dragAndDropKind)
+    const next = cards.find(other => !goldenFirst || card.classList.contains("golden-effect") || !other.classList.contains("golden-effect"))
+
+    // Moving is activity: newest first, after golden cards in active columns.
+    // Insert inside the pagination frames, keeping load-more links at the end.
+    if (next) {
+      next.before(card)
+    } else if (cards.length) {
+      cards.at(-1).after(card)
+    } else {
+      const frame = list.querySelector("turbo-frame")
+      const container = frame || list
+      container.prepend(card)
+    }
+
+    this.#updateAppearance(card, column)
+    this.#changeCount(source, -1)
+    this.#changeCount(column, 1)
+    this.#ensureEmptyPlaceholder(source)
+  }
+
+  #updateAppearance(card, column) {
+    const kind = column.dataset.dragAndDropKind
+    const active = [ "maybe", "column" ].includes(kind)
+    card.classList.toggle("card--active", active)
+    card.classList.toggle("card--postponed", kind === "not-now")
+    if (kind !== "closed") {
+      card.dataset.cardNotNowUrl = card.dataset.dragAndDropNotNowUrl
+      card.dataset.cardClosureUrl = card.dataset.dragAndDropClosureUrl
+      card.dataset.cardAssignToSelfUrl = card.dataset.dragAndDropAssignToSelfUrl
+    }
+    card.dataset.action = kind === "closed" ? "" : "mouseenter->navigable-list#hoverSelect"
+    card.querySelector(".card__closed")?.remove()
+    card.querySelector(".card__header > .card__column-name")?.remove()
+    card.querySelector(".bubble")?.remove()
+
+    if (kind === "column") {
+      const name = this.columnNameTarget.content.firstElementChild.cloneNode(true)
+      name.firstElementChild.textContent = column.dataset.columnName
+      card.querySelector(".card__header").append(name)
+      card.style.setProperty("--card-color", column.dataset.dragAndDropColor)
+    } else if (kind !== "closed") {
+      card.style.setProperty("--card-color", "var(--color-card-default)")
+    }
+
+    if (!active) {
+      const stamp = this.stampTarget.content.firstElementChild.cloneNode(true)
+      const title = kind === "closed" ? "Done" : "Not Now"
+      const titleElement = stamp.querySelector(".card__closed-title")
+      titleElement.textContent = title
+      titleElement.dataset.text = title
+      stamp.querySelector(".card__closed-date").textContent = new Date().toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" })
+      stamp.querySelector(".card__closed-by").textContent = this.userNameValue
+      card.querySelector(".card__body").append(stamp)
+    }
+
+    if (kind !== "closed") {
+      card.querySelectorAll(".card__stages .card__column-name").forEach(name => {
+        name.classList.toggle("card__column-name--current", name.dataset.columnId === column.dataset.dragAndDropColumnId)
+      })
+    }
+  }
+
+  #changeCount(column, delta) {
+    const counter = column.querySelector("[data-drag-and-drop-count]")
+    const count = Math.max(0, Number(counter.dataset.dragAndDropCount) + delta)
+    counter.dataset.dragAndDropCount = count
+    counter.textContent = count > 99 ? "99+" : count
+    column.querySelector(".cards__expander").style.setProperty("--card-count", Math.min(count, 15))
+  }
+
+  #ensureEmptyPlaceholder(column) {
+    const list = column.querySelector(".cards__list")
+    if (!list.querySelector(".card, .blank-slate")) {
+      list.append(this.emptyTarget.content.cloneNode(true))
+    }
+  }
+
+  #request(card, column) {
+    const options = { responseKind: "json" }
+    switch (column.dataset.dragAndDropKind) {
+      case "column":
+        options.body = { column_id: column.dataset.dragAndDropColumnId }
+        return new FetchRequest("post", card.dataset.dragAndDropTriageUrl, options)
+      case "maybe":
+        return new FetchRequest("delete", card.dataset.dragAndDropTriageUrl, options)
+      case "not-now":
+        return new FetchRequest("post", card.dataset.dragAndDropNotNowUrl, options)
+      case "closed":
+        return new FetchRequest("post", card.dataset.dragAndDropClosureUrl, options)
+    }
+  }
+}
