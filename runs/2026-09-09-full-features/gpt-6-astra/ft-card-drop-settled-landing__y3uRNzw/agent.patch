diff --git a/test/system/card_drag_and_drop_test.rb b/test/system/card_drag_and_drop_test.rb
new file mode 100644
index 0000000..6e8d325
--- /dev/null
+++ b/test/system/card_drag_and_drop_test.rb
@@ -0,0 +1,236 @@
+require "application_system_test_case"
+
+class CardDragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    Current.user = users(:david)
+    @card = cards(:layout)
+    @column = columns(:writebook_in_progress)
+    @card.send_back_to_triage
+  end
+
+  test "a drop moves immediately, preserves golden ordering, and persists" do
+    golden = cards(:text)
+    golden.triage_into(@column)
+    golden.gild
+    visit board_url(@card.board)
+    assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+    assert_selector "##{dom_id(@card, :article)}[draggable=true]"
+
+    pause_saves
+    drag_card_to(dom_id(@column))
+
+    assert_equal [ dom_id(golden, :article), dom_id(@card, :article) ], card_ids_in(dom_id(@column))
+    assert_nil @card.reload.column
+    page.execute_script("window.releaseSave()")
+    assert_selector "[data-controller~='drag-and-drop']:not([aria-busy=true])"
+    assert_equal @column, @card.reload.column
+
+    page.refresh
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_equal [ dom_id(golden, :article), dom_id(@card, :article) ], card_ids_in(dom_id(@column))
+  end
+
+  test "dropping in the source column does not save or reorder" do
+    visit board_url(@card.board)
+    assert_selector "##{dom_id(@card, :article)}[draggable=true]"
+    original_order = card_ids_in("maybe")
+    pause_saves
+    drag_card_to("maybe")
+    assert_equal original_order, card_ids_in("maybe")
+    assert_nil page.evaluate_script("window.releaseSave")
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container"
+  end
+
+  test "cards move between every status without waiting for the save" do
+    visit board_url(@card.board)
+    assert_selector "#not-now .cards__list", visible: :all
+    assert_selector "#closed-cards .cards__list", visible: :all
+    assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+    assert_selector "##{dom_id(@card, :article)}[draggable=true]"
+    pause_saves
+
+    [ "not-now", "closed-cards", dom_id(@column), "maybe" ].each do |destination|
+      drag_card_to(destination)
+      assert_selector "##{destination} ##{dom_id(@card, :article)}", visible: :all
+      assert_selector "[data-controller~='drag-and-drop'][aria-busy=true]"
+      page.execute_script("window.releaseSave()")
+      assert_selector "[data-controller~='drag-and-drop']:not([aria-busy=true])"
+      @card.reload
+      case destination
+      when "not-now" then assert @card.postponed?
+      when "closed-cards" then assert @card.closed?
+      when "maybe" then assert @card.awaiting_triage?
+      else assert_equal @column, @card.column
+      end
+    end
+  end
+
+  test "a rejected save restores the card and counts" do
+    visit board_url(@card.board)
+    assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+    assert_selector "##{dom_id(@card, :article)}[draggable=true]"
+    original_order = card_ids_in("maybe")
+    original_count = find("#maybe [data-drag-and-drop-count]", visible: :all).text(:all)
+    page.execute_script <<~JS
+      window.fetch = () => Promise.resolve(new Response(null, { status: 422 }))
+    JS
+
+    accept_alert("The card couldn't be moved. Please try again.") do
+      drag_card_to(dom_id(@column))
+    end
+
+    assert_selector "#maybe ##{dom_id(@card, :article)}"
+    assert_equal original_order, card_ids_in("maybe")
+    assert_equal original_count, find("#maybe [data-drag-and-drop-count]", visible: :all).text(:all)
+    assert_no_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_nil @card.reload.column
+  end
+
+  test "drag feedback is cleared on cancellation and unrelated drops are ignored" do
+    visit board_url(@card.board)
+    assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+    assert_selector "##{dom_id(@card, :article)}[draggable=true]"
+    page.execute_script <<~JS, dom_id(@card, :article), dom_id(@column)
+      window.draggedCard = document.getElementById(arguments[0])
+      window.dropColumn = document.getElementById(arguments[1])
+      window.transfer = new DataTransfer()
+      draggedCard.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer: transfer }))
+      dropColumn.querySelector("header").dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer: transfer }))
+    JS
+    assert_selector ".drag-and-drop__dragged-item"
+    assert_selector "##{dom_id(@column)}.drag-and-drop__hover-container", visible: :all
+    page.execute_script <<~JS
+      draggedCard.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer: transfer }))
+      dropColumn.dispatchEvent(new DragEvent("drop", { bubbles: true, dataTransfer: transfer }))
+    JS
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+    assert_selector "#maybe ##{dom_id(@card, :article)}"
+    assert_nil @card.reload.column
+  end
+
+  test "a native drag moves a card into an empty column" do
+    @column = columns(:writebook_on_hold)
+    visit board_url(@card.board)
+    assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+    find("##{dom_id(@card, :article)}").drag_to(find("##{dom_id(@column)} .cards__header"))
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_selector "[data-controller~='drag-and-drop']:not([aria-busy=true])"
+    assert_equal @column, @card.reload.column
+  end
+
+  test "golden cards go first in active columns but not in Not Now" do
+    @card.gild
+    golden = cards(:text)
+    golden.gild
+    visit board_url(@card.board)
+    assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+    drag_card_to(dom_id(@column))
+    assert_selector "[data-controller~='drag-and-drop']:not([aria-busy=true])"
+    assert_equal [ dom_id(@card, :article), dom_id(golden, :article) ], card_ids_in(dom_id(@column))
+
+    golden.postpone
+    @card.ungild
+    page.refresh
+    assert_selector "#not-now ##{dom_id(golden, :article)}", visible: :all
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}[draggable=true]", visible: :all
+    drag_card_to("not-now")
+    assert_selector "[data-controller~='drag-and-drop']:not([aria-busy=true])"
+    assert_equal [ dom_id(@card, :article), dom_id(golden, :article) ], card_ids_in("not-now")
+    page.refresh
+    assert_selector "#not-now ##{dom_id(@card, :article)}", visible: :all
+    assert_equal [ dom_id(@card, :article), dom_id(golden, :article) ], card_ids_in("not-now")
+  end
+
+  test "a frame response during a save cannot undo the drop" do
+    visit board_url(@card.board)
+    assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+    assert_selector "##{dom_id(@card, :article)}[draggable=true]"
+    pause_saves
+    drag_card_to(dom_id(@column))
+
+    page.evaluate_async_script <<~JS, dom_id(@column, :cards)
+      const frame = document.getElementById(arguments[0])
+      const done = arguments[arguments.length - 1]
+      frame.addEventListener("turbo:frame-load", () => done(), { once: true })
+      frame.reload()
+    JS
+
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    page.execute_script("window.releaseSave()")
+    assert_selector "[data-controller~='drag-and-drop']:not([aria-busy=true])"
+    assert_equal @column, @card.reload.column
+  end
+
+  test "a stale frame response arriving after the save cannot undo the drop" do
+    visit board_url(@card.board)
+    assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+    assert_selector "##{dom_id(@card, :article)}[draggable=true]"
+    pause_saves
+    drag_card_to(dom_id(@column))
+    page.execute_script <<~JS, dom_id(@column, :cards)
+      const originalFetch = window.fetch
+      window.fetch = async (url, options) => {
+        const response = await originalFetch(url, options)
+        if (options.method.toUpperCase() === "GET") {
+          return new Promise(resolve => {
+            window.releaseFrame = () => resolve(response)
+            document.body.dataset.frameResponseReady = "true"
+          })
+        }
+        return response
+      }
+      document.getElementById(arguments[0]).reload()
+    JS
+    assert_selector "body[data-frame-response-ready]"
+    page.execute_script("window.releaseSave()")
+    assert_selector "[data-controller~='drag-and-drop']:not([aria-busy=true])"
+
+    page.evaluate_async_script <<~JS, dom_id(@column, :cards)
+      const done = arguments[arguments.length - 1]
+      document.getElementById(arguments[0]).addEventListener("turbo:frame-load", () => done(), { once: true })
+      window.releaseFrame()
+    JS
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_equal @column, @card.reload.column
+  end
+
+  test "previews outside the board columns are not draggable" do
+    visit board_columns_stream_url(@card.board)
+    assert_selector "##{dom_id(@card, :article)}"
+    assert_no_selector "[data-controller~='drag-and-drop'], article[draggable=true]"
+  end
+
+  private
+    def pause_saves
+      page.execute_script <<~JS
+        const originalFetch = window.fetch
+        window.fetch = (url, options) => {
+          if (options?.method && options.method.toUpperCase() !== "GET") {
+            return new Promise(resolve => {
+              window.releaseSave = () => resolve(originalFetch(url, options))
+            })
+          }
+          return originalFetch(url, options)
+        }
+      JS
+    end
+
+    def drag_card_to(column_id)
+      page.execute_script <<~JS, dom_id(@card, :article), column_id
+        const card = document.getElementById(arguments[0])
+        const column = document.getElementById(arguments[1])
+        const dataTransfer = new DataTransfer()
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+      JS
+    end
+
+    def card_ids_in(column_id)
+      page.evaluate_script("Array.from(document.getElementById(arguments[0]).querySelectorAll('article.card'), card => card.id)", column_id)
+    end
+end
