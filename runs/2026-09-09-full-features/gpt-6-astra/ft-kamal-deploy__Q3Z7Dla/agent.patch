+# Copy to .kamal/secrets and fill in the values. Never commit the filled-in file.
+# Generate once with: bundle exec rails secret
+SECRET_KEY_BASE=replace-with-a-generated-secret
+
+# Use credentials from your mail provider. Quote values containing special characters.
+SMTP_USERNAME='replace-with-smtp-username'
+SMTP_PASSWORD='replace-with-smtp-password'
+
+# Generate a pair using the command in docs/deployment.md. Keep it across deploys.
+VAPID_PUBLIC_KEY=replace-with-generated-public-key
+VAPID_PRIVATE_KEY=replace-with-generated-private-key
