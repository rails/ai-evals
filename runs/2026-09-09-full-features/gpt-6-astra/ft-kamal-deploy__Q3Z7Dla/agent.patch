@@ -0,0 +1,54 @@
+# Single-server deployment. See docs/deployment.md before running bin/kamal setup.
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - fizzy.example.com
+
+proxy:
+  ssl: true
+  host: fizzy.example.com
+  app_port: 80 # Thruster, which forwards to Puma inside the container.
+
+# Kamal runs a local registry and forwards it over SSH. No registry account needed.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64 # Use arm64 for an ARM server.
+
+# Keep databases, uploads, and exports across container replacements.
+volumes:
+  - fizzy_storage:/rails/storage
+
+asset_path: /rails/public/assets
+
+env:
+  clear:
+    SAAS: "false"
+    APP_FQDN: fizzy.example.com # Must match proxy.host (no https:// prefix).
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    WEB_CONCURRENCY: 2
+    JOB_CONCURRENCY: 1
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+    # For implicit TLS on port 465, set SMTP_TLS to "true" and STARTTLS to "false".
+    SMTP_TLS: "false"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+    - VAPID_PUBLIC_KEY
+    - VAPID_PRIVATE_KEY
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
