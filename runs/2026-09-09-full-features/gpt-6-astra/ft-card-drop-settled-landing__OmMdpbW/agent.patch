diff --git a/test/system/drag_and_drop_test.rb b/test/system/drag_and_drop_test.rb
new file mode 100644
index 0000000..97f626f
--- /dev/null
+++ b/test/system/drag_and_drop_test.rb
@@ -0,0 +1,246 @@
+require "application_system_test_case"
+
+class DragAndDropTest < ApplicationSystemTestCase
+  include ActionView::RecordIdentifier
+
+  setup do
+    sign_in_as(users(:david))
+    Current.user = users(:david)
+    @card = cards(:layout)
+    @board = @card.board
+    @column = @board.columns.create!(name: "Drop here", color: "var(--color-card-4)")
+    @card.reload.send_back_to_triage
+    visit board_url(@board)
+    assert_selector "#maybe ##{dom_id(@card, :article)}"
+    assert_selector "##{dom_id(@column)} .cards__list", visible: :all
+  end
+
+  test "dropping moves a card before the save completes" do
+    hold_requests
+    drag_card_to dom_id(@column)
+
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_no_selector "#maybe ##{dom_id(@card, :article)}", visible: :all
+    assert_nil @card.reload.column
+    assert_equal "1", page.evaluate_script("window.dropColumnCount")
+    assert page.evaluate_script("!!window.dropRequestId")
+
+    page.execute_script "window.releaseDropRequest()"
+    assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+    assert_equal @column, @card.reload.column
+
+    page.refresh
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+  end
+
+  test "cards can move between all statuses and custom columns" do
+    [ "closed-cards", "not-now", dom_id(@column), "maybe", dom_id(columns(:writebook_in_progress)) ].each do |destination|
+      assert_selector "##{destination} .cards__list", visible: :all
+      hold_requests
+      drag_card_to destination
+      assert_selector "##{destination} ##{dom_id(@card, :article)}[aria-busy]", visible: :all
+      page.execute_script "window.releaseDropRequest()"
+      assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+      @card.reload
+
+      case destination
+      when "closed-cards" then assert @card.closed?
+      when "not-now" then assert @card.postponed?
+      when "maybe" then assert @card.awaiting_triage?
+      else assert_equal destination, dom_id(@card.column)
+      end
+
+      page.refresh
+      assert_selector "##{destination} ##{dom_id(@card, :article)}", visible: :all
+    end
+  end
+
+  test "active columns preserve golden first ordering at drop and after reload" do
+    golden = cards(:logo)
+    golden.triage_into(@column)
+    golden.gild
+    ordinary = cards(:text)
+    ordinary.triage_into(@column)
+    page.refresh
+    assert_selector "##{dom_id(@column)} ##{dom_id(ordinary, :article)}", visible: :all
+
+    hold_requests
+    drag_card_to dom_id(@column)
+    assert_equal [ golden, @card, ordinary ].map { |card| dom_id(card, :article) }, card_ids_in(dom_id(@column))
+    page.execute_script "window.releaseDropRequest()"
+    assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+
+    page.refresh
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_equal [ golden, @card, ordinary ].map { |card| dom_id(card, :article) }, card_ids_in(dom_id(@column))
+  end
+
+  test "same-column drops do not reorder cards or save" do
+    original_order = card_ids_in("maybe")
+    original_activity = @card.reload.last_active_at
+    hold_requests
+    drag_card_to "maybe"
+    assert_equal original_order, card_ids_in("maybe")
+    assert_not page.evaluate_script("!!window.releaseDropRequest")
+    assert_equal original_activity, @card.reload.last_active_at
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+  end
+
+  test "failed saves restore position appearance and counts" do
+    original_order = card_ids_in("maybe")
+    original_count = find("#maybe .cards__expander-count", visible: :all).text(:all)
+    page.execute_script <<~JS
+      window.fetch = async () => new Response("", { status: 422 })
+    JS
+
+    accept_alert "The card could not be moved. Please try again." do
+      drag_card_to dom_id(@column)
+    end
+
+    assert_equal original_order, card_ids_in("maybe")
+    assert_equal original_count, find("#maybe .cards__expander-count", visible: :all).text(:all)
+    assert_nil @card.reload.column
+    assert_no_selector "##{dom_id(@column)} .card", visible: :all
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container, .card[aria-busy]", visible: :all
+  end
+
+  test "drag feedback clears when canceled and external drags are ignored" do
+    page.execute_script <<~JS, dom_id(@card, :article), dom_id(@column)
+      const card = document.getElementById(arguments[0])
+      const column = document.getElementById(arguments[1])
+      const dataTransfer = new DataTransfer()
+      card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, dataTransfer }))
+      column.dispatchEvent(new DragEvent("dragover", { bubbles: true, dataTransfer }))
+    JS
+    assert_selector "##{dom_id(@card, :article)}.drag-and-drop__dragged-item", visible: :all
+    assert_selector "##{dom_id(@column)}.drag-and-drop__hover-container", visible: :all
+    page.execute_script <<~JS, dom_id(@card, :article), dom_id(@column)
+      document.getElementById(arguments[0]).dispatchEvent(new DragEvent("dragend", { bubbles: true }))
+      document.getElementById(arguments[1]).dispatchEvent(new DragEvent("drop", { bubbles: true }))
+    JS
+    assert_selector "#maybe ##{dom_id(@card, :article)}", visible: :all
+    assert_no_selector ".drag-and-drop__dragged-item, .drag-and-drop__hover-container", visible: :all
+    assert_nil @card.reload.column
+  end
+
+  test "native mouse dragging moves a card into a collapsed column" do
+    hold_requests
+    find("##{dom_id(@card, :article)}").drag_to(find("##{dom_id(@column)} .cards__expander"))
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}[aria-busy]", visible: :all
+    page.execute_script "window.releaseDropRequest()"
+    assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+    assert_equal @column, @card.reload.column
+  end
+
+  test "a card stays draggable through repeated moves without a refresh" do
+    [ dom_id(@column), "closed-cards", "maybe", "not-now", "maybe" ].each do |destination|
+      assert_selector "##{destination} .cards__list", visible: :all
+      drag_card_to destination
+      assert_selector "##{destination} ##{dom_id(@card, :article)}[draggable=true]:not([aria-busy])", visible: :all
+    end
+    assert @card.reload.awaiting_triage?
+    assert_no_selector "##{dom_id(@card, :article)} .card__closed", visible: :all
+    assert_no_selector "##{dom_id(@column)} .card", visible: :all
+  end
+
+  test "golden cards land first in active columns" do
+    @card.gild
+    cards(:logo).triage_into(@column)
+    cards(:logo).gild
+    page.refresh
+    assert_selector "##{dom_id(@column)} .card", visible: :all
+    hold_requests
+    drag_card_to dom_id(@column)
+    assert_equal dom_id(@card, :article), card_ids_in(dom_id(@column)).first
+    page.execute_script "window.releaseDropRequest()"
+    assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+    page.refresh
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_equal dom_id(@card, :article), card_ids_in(dom_id(@column)).first
+  end
+
+  test "cards remain draggable after their previews are morphed" do
+    page.execute_script <<~JS, dom_id(@card, :article)
+      const card = document.getElementById(arguments[0])
+      const parent = card.parentElement
+      const incoming = parent.cloneNode(true)
+      incoming.querySelectorAll(".card").forEach(card => card.removeAttribute("draggable"))
+      window.Turbo.morphChildren(parent, incoming)
+    JS
+    assert_selector "##{dom_id(@card, :article)}[draggable=true]", visible: :all
+  end
+
+  test "inactive columns sort by recency rather than goldness" do
+    golden = cards(:logo)
+    golden.gild
+
+    [ "closed-cards", "not-now" ].each do |destination|
+      destination == "closed-cards" ? golden.close : golden.postpone
+      @card.reload.send_back_to_triage
+      visit board_url(@board)
+      assert_selector "##{destination} ##{dom_id(golden, :article)}", visible: :all
+
+      hold_requests
+      drag_card_to destination
+      expected_order = card_ids_in(destination)
+      assert_equal dom_id(@card, :article), expected_order.first
+      page.execute_script "window.releaseDropRequest()"
+      assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+      page.refresh
+      assert_selector "##{destination} ##{dom_id(@card, :article)}", visible: :all
+      assert_equal expected_order, card_ids_in(destination)
+    end
+  end
+
+  test "ordinary cards follow an entirely golden destination" do
+    golden = cards(:logo)
+    golden.triage_into(@column)
+    golden.gild
+    page.refresh
+    assert_selector "##{dom_id(@column)} ##{dom_id(golden, :article)}", visible: :all
+    hold_requests
+    drag_card_to dom_id(@column)
+    assert_equal [ golden, @card ].map { |card| dom_id(card, :article) }, card_ids_in(dom_id(@column))
+    page.execute_script "window.releaseDropRequest()"
+    assert_selector "##{dom_id(@card, :article)}:not([aria-busy])", visible: :all
+    page.refresh
+    assert_selector "##{dom_id(@column)} ##{dom_id(@card, :article)}", visible: :all
+    assert_equal [ golden, @card ].map { |card| dom_id(card, :article) }, card_ids_in(dom_id(@column))
+  end
+
+  private
+
+
+
+    def card_ids_in(column_id)
+      all("##{column_id} .card", visible: :all).map { |card| card[:id] }
+    end
+
+
+    def hold_requests
+      page.execute_script <<~JS
+        const originalFetch = window.fetch
+        window.fetch = async (...args) => {
+          if ((args[1]?.method || "GET").toUpperCase() !== "GET") {
+            window.dropRequestId = new Headers(args[1].headers).get("X-Turbo-Request-Id")
+            await new Promise(resolve => window.releaseDropRequest = resolve)
+          }
+          return originalFetch(...args)
+        }
+      JS
+    end
+
+    def drag_card_to(column_id)
+      assert_selector "##{dom_id(@card, :article)}[draggable=true]", visible: :all
+      page.execute_script <<~JS, dom_id(@card, :article), column_id
+        const card = document.getElementById(arguments[0])
+        const column = document.getElementById(arguments[1])
+        const dataTransfer = new DataTransfer()
+        card.dispatchEvent(new DragEvent("dragstart", { bubbles: true, cancelable: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent("dragover", { bubbles: true, cancelable: true, dataTransfer }))
+        column.dispatchEvent(new DragEvent("drop", { bubbles: true, cancelable: true, dataTransfer }))
+        window.dropColumnCount = column.querySelector(".cards__expander").style.getPropertyValue("--card-count")
+        card.dispatchEvent(new DragEvent("dragend", { bubbles: true, dataTransfer }))
+      JS
+    end
+end
