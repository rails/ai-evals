diff --git a/app/javascript/controllers/drag_and_drop_controller.js b/app/javascript/controllers/drag_and_drop_controller.js
new file mode 100644
index 0000000..d63f6ac
--- /dev/null
+++ b/app/javascript/controllers/drag_and_drop_controller.js
@@ -0,0 +1,174 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "card", "column" ]
+  static classes = [ "draggedItem", "hoverContainer" ]
+
+  cardTargetConnected(card) {
+    card.draggable = true
+  }
+
+  cardTargetDisconnected(card) {
+    card.draggable = false
+  }
+
+  disconnect() {
+    this.end()
+  }
+
+  preserveDraggable(event) {
+    if (event.detail.attributeName === "draggable" && this.cardTargets.includes(event.target)) {
+      event.preventDefault()
+    }
+  }
+
+  start(event) {
+    const card = event.target.closest('[data-drag-and-drop-target~="card"]')
+    if (!card || card.hasAttribute("aria-busy")) {
+      event.preventDefault()
+      return
+    }
+
+    this.card = card
+    this.source = this.#columnFor(card)
+    event.dataTransfer.effectAllowed = "move"
+    event.dataTransfer.setData("text/plain", card.id)
+    card.classList.add(this.draggedItemClass)
+  }
+
+  over(event) {
+    const column = this.#columnFor(event.target)
+    if (this.card && column) {
+      event.preventDefault()
+      event.dataTransfer.dropEffect = column === this.source ? "none" : "move"
+      this.#highlight(column === this.source ? null : column)
+    }
+  }
+
+  leave(event) {
+    if (!this.hoverColumn?.contains(event.relatedTarget)) {
+      this.#highlight(null)
+    }
+  }
+
+  async drop(event) {
+    const destination = this.#columnFor(event.target)
+    if (!this.card || !destination) return
+
+    event.preventDefault()
+    const card = this.card
+    const source = this.source
+    this.end()
+    if (source === destination) return
+
+    const list = destination.querySelector(".cards__list")
+    if (!list) return
+
+    const position = document.createComment("card position before drop")
+    card.before(position)
+    const original = card.cloneNode(true)
+
+    card.setAttribute("aria-busy", "true")
+    this.#insert(card, list, destination)
+    this.#updateCard(card, destination)
+    this.#adjustCount(source, -1)
+    this.#adjustCount(destination, 1)
+
+    try {
+      const response = await this.#save(card, destination)
+      if (!response.ok || response.redirected) throw new Error("Could not move card")
+    } catch (error) {
+      position.replaceWith(original)
+      card.remove()
+      this.#adjustCount(source, 1)
+      this.#adjustCount(destination, -1)
+      window.alert("The card could not be moved. Please try again.")
+    } finally {
+      position.remove()
+      card.removeAttribute("aria-busy")
+    }
+  }
+
+  end() {
+    this.card?.classList.remove(this.draggedItemClass)
+    this.#highlight(null)
+    this.card = null
+    this.source = null
+  }
+
+  #columnFor(element) {
+    const column = element?.closest('[data-drag-and-drop-target~="column"]')
+    return this.columnTargets.includes(column) ? column : null
+  }
+
+  #highlight(column) {
+    this.hoverColumn?.classList.remove(this.hoverContainerClass)
+    this.hoverColumn = column
+    this.hoverColumn?.classList.add(this.hoverContainerClass)
+  }
+
+  #insert(card, list, destination) {
+    // Moving updates last_active_at. Active columns keep golden cards first;
+    // Done and Not Now sort only by recency, regardless of goldness.
+    const cards = Array.from(list.querySelectorAll('[data-drag-and-drop-target~="card"]'))
+    const goldenFirst = destination.dataset.dragAndDropStatus === "triage"
+    const nextCard = goldenFirst && !card.classList.contains("golden-effect")
+      ? cards.find(candidate => !candidate.classList.contains("golden-effect"))
+      : cards[0]
+
+    if (nextCard) {
+      nextCard.before(card)
+    } else if (cards.length) {
+      cards.at(-1).after(card)
+    } else {
+      const container = list.querySelector("turbo-frame") || list
+      container.prepend(card)
+    }
+  }
+
+  #updateCard(card, destination) {
+    const active = destination.dataset.dragAndDropStatus === "triage"
+    card.classList.toggle("card--active", active)
+    card.classList.toggle("card--postponed", destination.dataset.dragAndDropStatus === "not-now")
+    card.style.setProperty("--card-color", destination.dataset.dragAndDropColor)
+    card.querySelector(".card__meta-text--updated time")?.setAttribute("datetime", Math.floor(Date.now() / 1000))
+    card.querySelectorAll(".card__closed, .bubble").forEach(element => element.remove())
+    card.querySelector(".card__header > .card__column-name")?.remove()
+    card.querySelectorAll(".card__stages .card__column-name").forEach(stage => {
+      stage.classList.toggle("card__column-name--current", stage.dataset.columnId === destination.dataset.dragAndDropColumnId)
+    })
+  }
+
+  #adjustCount(column, adjustment) {
+    const counter = column.querySelector(".cards__expander-count")
+    if (counter) {
+      const count = Number(counter.dataset.count) + adjustment
+      counter.dataset.count = count
+      counter.textContent = count > 99 ? "99+" : count
+
+      // Match css-variable-counter immediately, rather than waiting for its debounce.
+      const loadedCount = column.querySelectorAll('[data-drag-and-drop-target~="card"]').length
+      counter.closest(".cards__expander").style.setProperty("--card-count", Math.min(loadedCount, 15))
+    }
+  }
+
+  #save(card, destination) {
+    const status = destination.dataset.dragAndDropStatus
+    const columnId = destination.dataset.dragAndDropColumnId
+    let url, method, body
+
+    if (status === "triage") {
+      url = card.dataset.cardTriageUrl
+      method = columnId ? "post" : "delete"
+      body = columnId ? { column_id: columnId } : undefined
+    } else {
+      url = status === "closed" ? card.dataset.cardClosureUrl : card.dataset.cardNotNowUrl
+      method = "post"
+    }
+
+    // request.js uses Turbo.fetch, so our own refresh broadcast is ignored.
+    // A JSON response saves the move without replacing the optimistic board.
+    return new FetchRequest(method, url, { body, responseKind: "json" }).perform()
+  }
+}
