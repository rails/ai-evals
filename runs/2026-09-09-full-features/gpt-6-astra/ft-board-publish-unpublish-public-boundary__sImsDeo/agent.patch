+  end
+
+  test "a public key cannot be used under another account prefix" do
+    get public_board_path(@key, script_name: accounts(:initech).slug)
+    assert_response :not_found
+  end
+end
diff --git a/test/models/board/publishable_test.rb b/test/models/board/publishable_test.rb
