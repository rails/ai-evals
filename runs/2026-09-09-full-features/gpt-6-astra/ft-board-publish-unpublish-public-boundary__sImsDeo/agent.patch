+++ b/test/models/board/publishable_test.rb
@@ -0,0 +1,60 @@
+require "test_helper"
+
+class Board::PublishableTest < ActiveSupport::TestCase
+  setup do
+    @board = boards(:writebook)
+  end
+
+  test "boards are unpublished by default" do
+    assert_not @board.published?
+  end
+
+  test "publishing is idempotent and creates a secret key" do
+    assert_difference "Board::Publication.count", 1 do
+      @board.publish
+      @board.publish
+    end
+
+    assert @board.reload.published?
+    assert_equal @board.account, @board.publication.account
+    assert_operator @board.publication.key.length, :>=, 24
+    key = @board.publication.key
+    @board.publish
+    assert_equal key, @board.reload.publication.key
+  end
+
+  test "unpublishing is idempotent and republishing rotates the key" do
+    @board.unpublish
+    @board.publish
+    key = @board.publication.key
+
+    assert_difference "Board::Publication.count", -1 do
+      @board.unpublish
+      @board.unpublish
+    end
+    assert_not @board.published?
+
+    @board.publish
+    assert_not_equal key, @board.publication.key
+  end
+
+  test "publication changes invalidate board caches" do
+    travel 1.minute do
+      assert_changes -> { @board.reload.updated_at } do
+        @board.publish
+      end
+    end
+    travel 2.minutes do
+      assert_changes -> { @board.reload.updated_at } do
+        @board.unpublish
+      end
+    end
+  end
+
+  test "destroying a board destroys its publication" do
+    @board.publish
+    assert_difference "Board::Publication.count", -1 do
+      @board.destroy!
+    end
+  end
+end
