+## Board Publication
+
+Only account admins and owners with access to a board can publish or unpublish it.
+Being the board's creator is not sufficient. Members receive `403 Forbidden`.
+Publishing does not change the board's account access permissions.
+
+### `POST /:account_slug/boards/:board_id/publication`
+
+Publishes the board. No request body is required. Returns `200 OK` with the board's
+JSON, including its `public_url`. Publishing an already published board preserves
+the existing URL.
+
+### `DELETE /:account_slug/boards/:board_id/publication`
+
+Unpublishes the board and returns `204 No Content`. The board's `public_url` becomes
+`null`, and the old public board, column, and card links return `404 Not Found`.
+Publishing the board again generates a new secret URL.
+
+### Public pages
+
+Anyone with the secret URL can view these read-only HTML pages without authentication:
+
+- `GET /public/boards/:key`
+- `GET /public/boards/:key/columns/:id`
+- `GET /public/boards/:key/cards/:number`
+
+These paths also support the board's account slug prefix. Public pages only expose
+published cards, never drafts. Column and card links must belong to the published
+board; invalid keys or inaccessible records return `404 Not Found`.
+
+Treat `public_url` as a secret: anyone you share it with can view the board.
+
 ## Board Accesses
 
 Board accesses let you see who has access to a board and their involvement level (watching or access only). Any board member can view this information.
diff --git a/test/controllers/boards/publications_controller_test.rb b/test/controllers/boards/publications_controller_test.rb
new file mode 100644
index 0000000..d0d29a6
--- /dev/null
+++ b/test/controllers/boards/publications_controller_test.rb
@@ -0,0 +1,86 @@
+require "test_helper"
+
+class Boards::PublicationsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    sign_in_as :kevin
+  end
+
+  test "publish, view anonymously, and unpublish" do
+    get board_path(@board, format: :json)
+    assert response.parsed_body.key?("public_url")
+    assert_nil response.parsed_body["public_url"]
+
+    post board_publication_path(@board, format: :json)
+    assert_response :success
+    assert @board.reload.published?
+
+    get board_path(@board, format: :json)
+    public_url = response.parsed_body.fetch("public_url")
+    assert_includes public_url, "/public/boards/#{@board.publication.key}"
+
+    sign_out
+    get public_url
+    assert_response :success
+    assert_select "h1", text: @board.name
+
+    sign_in_as :kevin
+    delete board_publication_path(@board, format: :json)
+    assert_response :no_content
+    assert_not @board.reload.published?
+
+    get board_path(@board, format: :json)
+    assert_nil response.parsed_body.fetch("public_url")
+
+    sign_out
+    get public_url
+    assert_response :not_found
+  end
+
+  test "owners can publish and unpublish using HTML" do
+    sign_out
+    @board.accesses.grant_to users(:jason)
+    sign_in_as :jason
+
+    post board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert @board.reload.published?
+
+    delete board_publication_path(@board)
+    assert_redirected_to edit_board_path(@board)
+    assert_not @board.reload.published?
+  end
+
+  test "anonymous visitors cannot publish or unpublish" do
+    sign_out
+
+    post board_publication_path(@board, format: :json)
+    assert_redirected_to new_session_path(script_name: nil)
+    assert_not @board.reload.published?
+
+    @board.publish
+    delete board_publication_path(@board, format: :json)
+    assert_redirected_to new_session_path(script_name: nil)
+    assert @board.reload.published?
+  end
+
+  test "admins cannot publish boards they cannot access" do
+    post board_publication_path(boards(:miltons_wish_list), format: :json)
+    assert_response :not_found
+    assert_not boards(:miltons_wish_list).reload.published?
+  end
+
+  test "only admins can publish or unpublish, even when a member created the board" do
+    sign_out
+    sign_in_as :david
+
+    post board_publication_path(@board, format: :json)
+    assert_response :forbidden
+    assert_not @board.reload.published?
+
+    @board.publish
+    delete board_publication_path(@board, format: :json)
+    assert_response :forbidden
+    assert @board.reload.published?
+  end
+end
diff --git a/test/controllers/public/boards_controller_test.rb b/test/controllers/public/boards_controller_test.rb
new file mode 100644
index 0000000..aaa2eea
--- /dev/null
+++ b/test/controllers/public/boards_controller_test.rb
@@ -0,0 +1,137 @@
+require "test_helper"
+
+class Public::BoardsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @board = boards(:writebook)
+    @board.publish
+    @key = @board.publication.key
+    @column = columns(:writebook_in_progress)
+    @card = cards(:logo)
+    @card.update!(column: @column)
+    @draft = @board.cards.create!(title: "Secret draft", creator: users(:david), column: @column)
+  end
+
+  test "anonymous board and column pages link to published cards only" do
+    get public_board_path(@key)
+    assert_response :success
+    assert_select "a[href=?]", public_board_column_path(@key, @column), text: @column.name
+    assert_select "a[href=?]", public_board_card_path(@key, @card), text: @card.title
+    assert_select "a", text: @draft.title, count: 0
+    assert_select "form", count: 0
+    assert_select "turbo-cable-stream-source", count: 0
+
+    get public_board_column_path(@key, @column)
+    assert_response :success
+    assert_select "a[href=?]", public_board_card_path(@key, @card), text: @card.title
+    assert_select "a", text: @draft.title, count: 0
+    assert_select "a", text: cards(:layout).title, count: 0
+  end
+
+  test "anonymous published card includes its description and steps" do
+    @card.update!(description: "A public description")
+    @card.steps.create!(content: "Review the logo", completed: true)
+
+    get public_board_card_path(@key, @card)
+    assert_response :success
+    assert_select "h1", text: @card.title
+    assert_includes response.headers["Cache-Control"], "no-store"
+    assert_equal "no-referrer", response.headers["Referrer-Policy"]
+    assert_select ".rich-text-content", text: /A public description/
+    assert_select "li", text: "Review the logo (completed)"
+    assert_select "form", count: 0
+  end
+
+  test "draft cards cannot be opened directly" do
+    get public_board_card_path(@key, @draft)
+    assert_response :not_found
+  end
+
+  test "cards and columns from another board cannot be opened" do
+    other_board = boards(:private)
+    other_card = Current.set(user: users(:kevin)) do
+      other_board.cards.create!(title: "Private card", status: :published, creator: users(:kevin))
+    end
+    other_column = other_board.columns.create!(name: "Private", color: @column.color)
+
+    get public_board_card_path(@key, other_card)
+    assert_response :not_found
+
+    get public_board_column_path(@key, other_column)
+    assert_response :not_found
+  end
+
+  test "unknown keys and missing records return not found" do
+    get public_board_path("unknown")
+    assert_response :not_found
+
+    get public_board_column_path(@key, "missing")
+    assert_response :not_found
+
+    get public_board_card_path(@key, 999999)
+    assert_response :not_found
+  end
+
+  test "unpublishing revokes all public endpoints" do
+    @board.unpublish
+
+    get public_board_path(@key)
+    assert_response :not_found
+    get public_board_column_path(@key, @column)
+    assert_response :not_found
+    get public_board_card_path(@key, @card)
+    assert_response :not_found
+  end
+
+  test "public board is available without an account prefix" do
+    untenanted do
+      get public_board_path(@key)
+      assert_response :success
+      get public_board_column_path(@key, @column)
+      assert_response :success
+      get public_board_card_path(@key, @card)
+      assert_response :success
+    end
+  end
+
+  test "signed in users from other accounts can view public boards" do
+    sign_in_as :mike
+    get public_board_path(@key)
+    assert_response :success
+  end
+
+  test "private boards can be shared without granting account access" do
+    board = boards(:private)
+    board.publish
+
+    get public_board_path(board.publication.key)
+    assert_response :success
+    assert_select "h1", text: board.name
+    assert_select "meta[name='turbo-cache-control'][content='no-cache']"
+  end
+
+  test "public boards in cancelled accounts cannot be viewed" do
+    @board.account.create_cancellation!(initiated_by: users(:kevin))
+
+    get public_board_path(@key)
+    assert_response :not_found
+    get public_board_column_path(@key, @column)
+    assert_response :not_found
+    get public_board_card_path(@key, @card)
+    assert_response :not_found
+  end
+
+  test "a republished board does not restore access through the old key" do
