diff --git a/test/models/card/stallable_test.rb b/test/models/card/stallable_test.rb
new file mode 100644
index 0000000..13312d7
--- /dev/null
+++ b/test/models/card/stallable_test.rb
@@ -0,0 +1,192 @@
+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+    @card = cards(:logo)
+    @card.comments.destroy_all
+    freeze_time
+  end
+
+  test "a comment burst stalls after two weeks and new activity resets the clock" do
+    @card.comments.create!(body: "First", creator: users(:david))
+    @card.comments.create!(body: "Second", creator: users(:jz))
+    @card.comments.create!(body: "Third", creator: users(:david))
+
+    assert_not_predicate @card.reload, :stalled?
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+    assert_includes Card.indexed_by("stalled"), @card
+
+    @card.comments.create!(body: "Still working on this", creator: users(:jz))
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.indexed_by("stalled"), @card
+  end
+  test "quiet cards without a burst never stall" do
+    travel 3.weeks
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "two comments from two people are not a burst" do
+    comment_by :david
+    comment_by :jz
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "three comments require at least two people" do
+    3.times { comment_by :david }
+    assert_nil @card.reload.last_burst_at
+
+    comment_by :jz
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "system comments do not count towards a burst" do
+    comment_by :david
+    comment_by :jz
+    @card.comments.create!(body: "System update", creator: @card.account.system_user)
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "the burst window includes exactly a third of the board period" do
+    comment_by :david
+    travel @card.auto_postpone_period / 3
+    comment_by :david
+    comment_by :jz
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "comments outside a third of the board period do not count" do
+    comment_by :david
+    travel @card.auto_postpone_period / 3 + 1.second
+    comment_by :david
+    comment_by :jz
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "burst window falls back to the account period" do
+    @card.board.entropy.destroy!
+    @card.reload.board.reload
+    comment_by :david
+    travel @card.account.entropy.auto_postpone_period / 3 + 1.second
+    comment_by :david
+    comment_by :jz
+    assert_nil @card.reload.last_burst_at
+
+    comment_by :david
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "comments on other cards do not count" do
+    comment_by :david
+    comment_by :david
+    cards(:layout).comments.create!(body: "Elsewhere", creator: users(:jz))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "assignment is a burst but unassignment is not" do
+    @card.assignments.delete_all
+    @card.toggle_assignment users(:jz)
+    assert_equal Time.current, @card.reload.last_burst_at
+
+    travel 1.day
+    @card.toggle_assignment users(:jz)
+    assert_equal 1.day.ago, @card.reload.last_burst_at
+  end
+
+  test "reopening is a burst but closing is not" do
+    @card.close
+    assert_nil @card.reload.last_burst_at
+    @card.reopen
+    assert_equal Time.current, @card.reload.last_burst_at
+  end
+
+  test "stalling starts at exactly two weeks" do
+    @card.record_burst
+    travel 2.weeks - 1.second
+    assert_not_predicate @card.reload, :stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 1.second
+    assert_predicate @card.reload, :stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "closed postponed and draft cards do not stall" do
+    [ -> { @card.close }, -> { @card.postpone }, -> { @card.drafted! } ].each do |change_status|
+      @card.record_burst
+      change_status.call
+      travel 2.weeks
+      assert_not_predicate @card.reload, :stalled?
+      assert_not_includes Card.stalled, @card
+    end
+  end
+
+  test "editing the card resets inactivity" do
+    stall_card
+    @card.update! title: "Updated title"
+    assert_not_predicate @card.reload, :stalled?
+
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+    @card.update! description: "Updated description"
+    assert_not_predicate @card.reload, :stalled?
+  end
+
+  test "editing or deleting a comment resets inactivity" do
+    comment = comment_by :david
+    stall_card
+    comment.update! body: "Revised comment"
+    assert_not_predicate @card.reload, :stalled?
+
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+    comment.destroy!
+    assert_not_predicate @card.reload, :stalled?
+  end
+
+  test "step activity resets inactivity" do
+    stall_card
+    step = @card.steps.create! content: "Next step"
+    assert_not_predicate @card.reload, :stalled?
+
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+    step.update! completed: true
+    assert_not_predicate @card.reload, :stalled?
+
+    travel 2.weeks
+    step.destroy!
+    assert_not_predicate @card.reload, :stalled?
+  end
+
+  test "reactions reset inactivity" do
+    stall_card
+    reaction = @card.reactions.create! content: "👍", reacter: users(:jz)
+    assert_not_predicate @card.reload, :stalled?
+
+    travel 2.weeks
+    assert_predicate @card.reload, :stalled?
+    reaction.destroy!
+    assert_not_predicate @card.reload, :stalled?
+  end
+
+  test "cache keys change when cards become stalled without a database update" do
+    @card.record_burst
+    key = @card.cache_key_with_version
+    travel 2.weeks
+    assert_not_equal key, @card.cache_key_with_version
+  end
+
+  private
+    def comment_by(user)
+      @card.comments.create! body: "An update", creator: users(user)
+    end
+
+    def stall_card
+      @card.record_burst
+      travel 2.weeks
+      assert_predicate @card.reload, :stalled?
+    end
+end
