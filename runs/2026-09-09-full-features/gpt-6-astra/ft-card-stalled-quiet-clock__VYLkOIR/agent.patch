diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..6b3d503
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,35 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    scope :stalled, -> do
+      cutoff = STALLED_AFTER.ago
+      active.where.not(last_burst_at: nil).where(last_active_at: ..cutoff, updated_at: ..cutoff)
+    end
+  end
+
+  def stalled?
+    last_burst_at.present? && stalled_at <= Time.current && active?
+  end
+
+  def stalled_at
+    # Association touches and content edits are activity too, even without an event.
+    [ last_active_at, updated_at ].compact.max + STALLED_AFTER if last_burst_at.present?
+  end
+
+  def record_burst
+    update! last_burst_at: Time.current
+  end
+
+  def detect_comment_burst
+    comment_counts = comments.by_user.where(created_at: (Time.current - auto_postpone_period / 3.0)..Time.current).group(:creator_id).count
+
+    record_burst if comment_counts.size >= 2 && comment_counts.values.sum >= 3
+  end
+
+  def cache_key
+    "#{super}/#{stalled? ? 'stalled' : 'unstalled'}"
+  end
+end
