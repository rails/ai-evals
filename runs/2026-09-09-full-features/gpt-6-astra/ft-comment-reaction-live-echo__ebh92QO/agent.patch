diff --git a/test/controllers/cards/comments/reactions_controller_test.rb b/test/controllers/cards/comments/reactions_controller_test.rb
new file mode 100644
index 0000000..53e14e0
--- /dev/null
+++ b/test/controllers/cards/comments/reactions_controller_test.rb
@@ -0,0 +1,119 @@
+require "test_helper"
+
+class Cards::Comments::ReactionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "create a reaction on another user's comment" do
+    assert_difference "Reaction.count", 1 do
+      post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "🎉" } }, as: :turbo_stream
+    end
+
+    assert_response :success
+    reaction = Reaction.last
+    assert_equal "🎉", reaction.content
+    assert_equal users(:kevin), reaction.creator
+    assert_equal @comment.account, reaction.account
+    assert_equal @comment, reaction.comment
+    assert_turbo_stream action: :append, target: ActionView::RecordIdentifier.dom_id(@comment, :reactions)
+  end
+
+  test "reject blank and overlong reactions" do
+    [ "", "   ", "a" * 17 ].each do |content|
+      assert_no_difference "Reaction.count" do
+        post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: content } }, as: :turbo_stream
+      end
+      assert_response :unprocessable_entity
+    end
+  end
+  test "allows multiple reactions from the same person" do
+    assert_difference "Reaction.count", 2 do
+      2.times do
+        post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "Thanks!" } }, as: :turbo_stream
+        assert_response :success
+      end
+    end
+  end
+
+  test "cannot spoof the creator or comment" do
+    post card_comment_reactions_path(@comment.card, @comment), params: {
+      reaction: { content: "Thanks!", creator_id: users(:jz).id, comment_id: comments(:layout_overflowing_david).id, account_id: accounts(:initech).id }
+    }, as: :turbo_stream
+
+    assert_response :success
+    assert_equal users(:kevin), Reaction.last.creator
+    assert_equal @comment, Reaction.last.comment
+    assert_equal @comment.account, Reaction.last.account
+  end
+
+  test "delete your own reaction" do
+    reaction = @comment.reactions.create!(content: "Nice!", creator: users(:kevin))
+
+    assert_difference "Reaction.count", -1 do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :success
+    assert_turbo_stream action: :remove, target: ActionView::RecordIdentifier.dom_id(reaction)
+  end
+
+  test "cannot delete another person's reaction" do
+    reaction = @comment.reactions.create!(content: "Nice!", creator: users(:jz))
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@comment.card, @comment, reaction), as: :turbo_stream
+    end
+
+    assert_response :forbidden
+  end
+
+  test "comment must belong to the card" do
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(cards(:layout), @comment), params: { reaction: { content: "Nice!" } }, as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "reaction must belong to the comment" do
+    reaction = @comment.reactions.create!(content: "Nice!", creator: users(:kevin))
+    other_comment = comments(:logo_agreement_kevin)
+
+    assert_no_difference "Reaction.count" do
+      delete card_comment_reaction_path(@comment.card, other_comment, reaction), as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "cannot react to a card on an inaccessible board" do
+    logout_and_sign_in_as :jz
+    card = Current.set(user: users(:kevin)) do
+      boards(:private).cards.create!(title: "Private card", status: :published)
+    end
+    comment = card.comments.create!(body: "Private", creator: users(:kevin))
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "Nice!" } }, as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+  test "cannot react to a comment in another account" do
+    comment = Current.set(account: accounts(:initech), user: users(:mike)) do
+      cards(:radio).comments.create!(body: "Private")
+    end
+
+    assert_no_difference "Reaction.count" do
+      post card_comment_reactions_path(comment.card, comment), params: { reaction: { content: "Nice!" } }, as: :turbo_stream
+    end
+    assert_response :not_found
+  end
+
+  test "reaction text is escaped" do
+    post card_comment_reactions_path(@comment.card, @comment), params: { reaction: { content: "<b>Nice!</b>" } }, as: :turbo_stream
+
+    assert_response :success
+    assert_select ".reaction span.txt-small", text: "<b>Nice!</b>"
+    assert_select ".reaction b", count: 0
+  end
+end
diff --git a/test/models/reaction_test.rb b/test/models/reaction_test.rb
new file mode 100644
index 0000000..5934043
--- /dev/null
+++ b/test/models/reaction_test.rb
@@ -0,0 +1,57 @@
+require "test_helper"
+
+class ReactionTest < ActiveSupport::TestCase
+  setup do
+    Current.user = users(:kevin)
+    @comment = comments(:logo_agreement_jz)
+  end
+
+  test "requires content of at most sixteen characters" do
+    [ "🎉", "Great work!", "a" * 16, "🎉" * 16 ].each do |content|
+      assert @comment.reactions.build(content: content).valid?, content
+    end
+
+    [ nil, "", " \n", "a" * 17, "🎉" * 17 ].each do |content|
+      assert_not @comment.reactions.build(content: content).valid?, content.inspect
+    end
+  end
+
+  test "creation broadcasts the reaction and author to the card" do
+    broadcasts = capture_turbo_stream_broadcasts(@comment.card) do
+      @reaction = @comment.reactions.create!(content: "Nice!")
+    end
+
+    assert_equal 1, broadcasts.size
+    assert_equal "append", broadcasts.first["action"]
+    assert_equal ActionView::RecordIdentifier.dom_id(@comment, :reactions), broadcasts.first["target"]
+    assert_includes broadcasts.first.to_s, "Nice!"
+    assert_includes broadcasts.first.to_s, users(:kevin).name
+    assert_includes broadcasts.first.to_s, "#{@comment.account.slug}/cards/"
+  end
+
+  test "removal broadcasts to the card" do
+    reaction = @comment.reactions.create!(content: "Nice!")
+    broadcasts = capture_turbo_stream_broadcasts(@comment.card) { reaction.destroy! }
+
+    assert_equal 1, broadcasts.size
+    assert_equal "remove", broadcasts.first["action"]
+    assert_equal ActionView::RecordIdentifier.dom_id(reaction), broadcasts.first["target"]
+  end
+
+  test "creating and removing reactions invalidates the cached comment" do
+    assert_changes -> { @comment.reload.cache_key_with_version } do
+      @reaction = @comment.reactions.create!(content: "Nice!")
+    end
+
+    assert_changes -> { @comment.reload.cache_key_with_version } do
+      @reaction.destroy!
+    end
+  end
+
+  test "deleting a comment deletes its reactions" do
+    @comment.reactions.create!(content: "Nice!")
+    assert_difference "Reaction.count", -1 do
+      @comment.destroy!
+    end
+  end
+end
