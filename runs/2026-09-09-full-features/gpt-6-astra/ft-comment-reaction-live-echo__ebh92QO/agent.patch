--- /dev/null
+++ b/app/controllers/cards/comments/reactions_controller.rb
@@ -0,0 +1,40 @@
+class Cards::Comments::ReactionsController < ApplicationController
+  include CardScoped
+
+  before_action :set_comment
+  before_action :set_reaction, only: :destroy
+  before_action :ensure_creatorship, only: :destroy
+
+  def create
+    @reaction = @comment.reactions.build(reaction_params)
+
+    if @reaction.save
+      render turbo_stream: turbo_stream.append([ @comment, :reactions ], @reaction)
+    else
+      render turbo_stream: turbo_stream.update([ @comment, :reaction_errors ], @reaction.errors.full_messages.to_sentence),
+        status: :unprocessable_entity
+    end
+  end
+
+  def destroy
+    @reaction.destroy!
+    render turbo_stream: turbo_stream.remove(@reaction)
+  end
+
+  private
+    def set_comment
+      @comment = @card.comments.find(params[:comment_id])
+    end
+
+    def set_reaction
+      @reaction = @comment.reactions.find(params[:id])
+    end
+
+    def ensure_creatorship
+      head :forbidden unless @reaction.creator == Current.user
+    end
+
+    def reaction_params
+      params.expect(reaction: [ :content ])
+    end
+end
diff --git a/app/javascript/controllers/reaction_controller.js b/app/javascript/controllers/reaction_controller.js
new file mode 100644
index 0000000..27599a4
--- /dev/null
+++ b/app/javascript/controllers/reaction_controller.js
@@ -0,0 +1,27 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "removal" ]
+  static values = { creatorId: String }
+
+  connect() {
+    this.triggerTarget.setAttribute("aria-disabled", !this.#owned)
+    this.triggerTarget.tabIndex = this.#owned ? 0 : -1
+    this.removalTarget.hidden = true
+    this.element.classList.remove("expanded")
+    this.element.classList.toggle("reaction--deleteable", this.#owned)
+    if (this.#owned) this.triggerTarget.setAttribute("aria-expanded", "false")
+  }
+
+  toggle() {
+    if (this.#owned) {
+      const expanded = this.element.classList.toggle("expanded")
+      this.triggerTarget.setAttribute("aria-expanded", expanded)
+      this.removalTarget.hidden = !expanded
+    }
+  }
+
+  get #owned() {
+    return Current.user?.id === this.creatorIdValue
+  }
+}
diff --git a/app/javascript/controllers/reaction_form_controller.js b/app/javascript/controllers/reaction_form_controller.js
new file mode 100644
index 0000000..4b9918c
--- /dev/null
+++ b/app/javascript/controllers/reaction_form_controller.js
@@ -0,0 +1,40 @@
+import { Controller } from "@hotwired/stimulus"
+
+export default class extends Controller {
+  static targets = [ "trigger", "form", "input", "errors" ]
+
+  open() {
+    this.triggerTarget.hidden = true
+    this.formTarget.classList.add("reaction")
+    this.formTarget.hidden = false
+    this.inputTarget.focus()
+  }
+
+  cancel(event) {
+    event?.preventDefault()
+    this.formTarget.reset()
+    this.inputTarget.setCustomValidity("")
+    this.errorsTarget.textContent = ""
+    this.formTarget.hidden = true
+    this.formTarget.classList.remove("reaction")
+    this.triggerTarget.hidden = false
+    this.triggerTarget.focus()
+  }
+
+  submitted(event) {
+    if (event.detail.success) this.cancel()
+  }
+
+  validate() {
+    const content = this.inputTarget.value
+    let message = ""
+
+    if (!content.trim()) {
+      message = "Please enter a reaction"
+    } else if (Array.from(content).length > 16) {
+      message = "Reactions must be 16 characters or fewer"
+    }
+
+    this.inputTarget.setCustomValidity(message)
+  }
+}
