diff --git a/test/integration/card_stalling_test.rb b/test/integration/card_stalling_test.rb
new file mode 100644
index 0000000..ac2f27e
--- /dev/null
+++ b/test/integration/card_stalling_test.rb
@@ -0,0 +1,144 @@
+require "test_helper"
+
+class CardStallingTest < ActionDispatch::IntegrationTest
+  setup do
+    freeze_time
+    sign_in_as :kevin
+    @card = cards(:logo)
+    @card.record_activity_burst
+    boards(:writebook).publish
+  end
+
+  test "stalled index returns only accessible stalled cards" do
+    cards(:radio).record_activity_burst
+    travel 2.weeks
+
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_equal [ @card.number ], response.parsed_body.pluck("number")
+    assert_equal true, response.parsed_body.first["stalled"]
+
+    @card.touch_last_active_at
+    get cards_path(format: :json), params: { indexed_by: "stalled" }
+    assert_response :success
+    assert_empty response.parsed_body
+  end
+
+  test "stalled badges appear on card detail and private and public previews" do
+    travel 2.weeks
+
+    [ card_path(@card), cards_path(indexed_by: "stalled"),
+      board_column_path(@card.board, @card.column),
+      public_board_card_path(@card.board.publication.key, @card),
+      public_board_column_path(@card.board.publication.key, @card.column) ].each do |path|
+      get path
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled"
+    end
+  end
+
+  test "cached previews reflect time passing and new activity" do
+    with_card_caching do
+      get board_column_path(@card.board, @card.column)
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+
+      travel 2.weeks
+      get board_column_path(@card.board, @card.column)
+      assert_response :success
+      assert_select ".card__stalled", text: "Stalled"
+
+      @card.touch_last_active_at
+      get board_column_path(@card.board, @card.column)
+      assert_response :success
+      assert_select ".card__stalled", count: 0
+    end
+  end
+
+  test "notifications show stalled cards" do
+    travel 2.weeks
+    get notifications_path
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+
+    get notifications_path(format: :json)
+    assert_response :success
+    notification = response.parsed_body.find { |notification| notification["card"]["id"] == @card.id }
+    assert_equal true, notification.dig("card", "stalled")
+  end
+
+  test "activity timeline caches reflect stalling and new activity" do
+    event = events(:logo_published)
+    path = events_path(day: event.created_at.to_date)
+
+    get path
+    assert_response :success
+    assert_select ".card__stalled", count: 0
+    etag = response.headers["ETag"]
+
+    travel 2.weeks
+    get path, headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_select ".card__stalled", text: "Stalled"
+    etag = response.headers["ETag"]
+
+    @card.touch_last_active_at
+    get path, headers: { "If-None-Match" => etag }
+    assert_response :success
+    assert_select ".card__stalled", count: 0
+  end
+  test "cached details public previews and notifications reflect stalling and activity" do
+    with_card_caching do
+      paths = [ card_path(@card), public_board_column_path(@card.board.publication.key, @card.column), notifications_path ]
+
+      paths.each do |path|
+        get path
+        assert_response :success
+        assert_select ".card__stalled", count: 0
+      end
+
+      travel 2.weeks
+      paths.each do |path|
+        get path
+        assert_response :success
+        assert_select ".card__stalled", text: "Stalled"
+      end
+
+      @card.touch_last_active_at
+      paths.each do |path|
+        get path
+        assert_response :success
+        assert_select ".card__stalled", count: 0
+      end
+    end
+  end
+
+  test "cached card JSON reflects stalling and activity" do
+    with_card_caching do
+      get card_path(@card, format: :json)
+      assert_response :success
+      assert_equal false, response.parsed_body["stalled"]
+
+      travel 2.weeks
+      get card_path(@card, format: :json)
+      assert_response :success
+      assert_equal true, response.parsed_body["stalled"]
+
+      @card.touch_last_active_at
+      get card_path(@card, format: :json)
+      assert_response :success
+      assert_equal false, response.parsed_body["stalled"]
+    end
+  end
+
+  private
+    def with_card_caching
+      old_cache = Rails.cache
+      old_controller_cache = ApplicationController.cache_store
+      Rails.cache = ApplicationController.cache_store = ActiveSupport::Cache::MemoryStore.new
+      with_actionview_partial_caching { yield }
+    ensure
+      Rails.cache = old_cache
+      ApplicationController.cache_store = old_controller_cache
+    end
+end
