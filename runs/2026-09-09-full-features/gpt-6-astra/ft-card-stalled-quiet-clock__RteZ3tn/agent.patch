+require "test_helper"
+
+class Card::StallableTest < ActiveSupport::TestCase
+  setup do
+    freeze_time
+    Current.session = sessions(:david)
+    @card = cards(:logo)
+    @card.comments.destroy_all
+  end
+
+  test "an assigned card stalls after two quiet weeks and activity resets it" do
+    freeze_time
+    @card.toggle_assignment(users(:david))
+    assert_not @card.reload.stalled?
+
+    travel 2.weeks - 1.second
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+
+    travel 1.second
+    assert @card.stalled?
+    assert_includes Card.indexed_by("stalled"), @card
+
+    @card.touch_last_active_at
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+  test "quiet cards without a burst do not stall" do
+    travel 3.weeks
+    assert_not @card.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "three comments from two people within a third of the board period create a burst" do
+    freeze_time
+    comment_by :david
+    travel 20.days
+    comment_by :kevin
+    assert_nil @card.reload.last_burst_at
+
+    travel 10.days
+    comment_by :david
+    assert_equal Time.current, @card.reload.last_burst_at
+
+    travel 2.weeks
+    assert @card.stalled?
+    assert_includes Card.stalled, @card
+  end
+
+  test "comments outside the window do not count" do
+    comment_by :david
+    travel 30.days + 1.second
+    comment_by :kevin
+    comment_by :david
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "the account period is used when the board has no override" do
+    @card.board.entropy.destroy!
+    @card.reload
+    comment_by :david
+    travel 10.days + 1.second
+    comment_by :kevin
+    comment_by :david
+    assert_nil @card.reload.last_burst_at
+
+    comment_by :kevin
+    assert_not_nil @card.reload.last_burst_at
+  end
+
+  test "a single person cannot create a comment burst" do
+    4.times { comment_by :david }
+    assert_nil @card.reload.last_burst_at
+
+    comment_by :kevin
+    assert_not_nil @card.reload.last_burst_at
+  end
+
+  test "system comments do not count toward either burst threshold" do
+    comment_by :david
+    3.times { comment_by :system }
+    assert_nil @card.reload.last_burst_at
+
+    comment_by :kevin
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "reopening creates a burst but closing does not" do
+    freeze_time
+    @card.close
+    assert_nil @card.reload.last_burst_at
+    @card.reopen
+    assert_equal Time.current, @card.reload.last_burst_at
+
+    travel 2.weeks
+    assert @card.stalled?
+  end
+
+  test "unassignment does not create a burst" do
+    @card.toggle_assignment(users(:jz))
+    assert_nil @card.reload.last_burst_at
+  end
+
+  test "drafted closed and postponed cards are not stalled" do
+    @card.toggle_assignment(users(:david))
+    @card.close
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.reopen
+    @card.postpone
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+
+    @card.resume
+    @card.drafted!
+    travel 2.weeks
+    assert_not @card.reload.stalled?
+    assert_not_includes Card.stalled, @card
+  end
+
+  test "card edits reset inactivity" do
+    assert_activity_resets_stalling { @card.update!(title: "Updated title") }
+    assert_activity_resets_stalling { @card.update!(description: "Updated description") }
+  end
+
+  test "comments and comment edits reset inactivity" do
+    comment = nil
+    assert_activity_resets_stalling { comment = comment_by(:david) }
+    assert_activity_resets_stalling { comment.update!(body: "Edited comment") }
+    assert_activity_resets_stalling { comment.destroy! }
+  end
+
+  test "reactions and steps reset inactivity" do
+    assert_activity_resets_stalling { @card.reactions.create!(content: "👍", reacter: users(:kevin)) }
+    step = nil
+    assert_activity_resets_stalling { step = @card.steps.create!(content: "Next step") }
+    assert_activity_resets_stalling { step.update!(completed: true) }
+  end
+
+  private
+    def comment_by(person)
+      @card.comments.create!(body: "A comment", creator: users(person))
+    end
+
+    def assert_activity_resets_stalling
+      @card.record_activity_burst
+      travel 2.weeks
+      assert @card.reload.stalled?
+
+      yield
+
+      assert_not @card.reload.stalled?
+      assert_not_includes Card.stalled, @card
+
+      travel 2.weeks
+      assert @card.reload.stalled?
+    end
+end
