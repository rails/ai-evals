diff --git a/app/models/card/stallable.rb b/app/models/card/stallable.rb
new file mode 100644
index 0000000..4fb2f4c
--- /dev/null
+++ b/app/models/card/stallable.rb
@@ -0,0 +1,37 @@
+module Card::Stallable
+  extend ActiveSupport::Concern
+
+  STALLED_AFTER = 2.weeks
+
+  included do
+    before_update :refresh_activity_after_burst, if: :last_burst_at?
+    after_touch :touch_last_active_at, if: :last_burst_at?
+
+    scope :stalled, -> { active.where.not(last_burst_at: nil).where(last_active_at: ..STALLED_AFTER.ago) }
+  end
+
+  def stalled?
+    last_burst_at.present? && last_active_at.present? && last_active_at <= STALLED_AFTER.ago && active?
+  end
+
+  def record_activity_burst
+    now = Time.current
+    update! last_burst_at: now, last_active_at: now
+  end
+
+  def detect_comment_activity_burst
+    now = Time.current
+    comments_per_person = comments.by_user.where(created_at: (now - auto_postpone_period / 3.0)..now).group(:creator_id).count
+
+    if comments_per_person.size >= 2 && comments_per_person.values.sum >= 3
+      record_activity_burst
+    end
+  end
+
+  private
+    def refresh_activity_after_burst
+      if (changed - %w[ last_active_at updated_at ]).any? && !last_active_at_changed?
+        self.last_active_at = Time.current
+      end
+    end
+end
