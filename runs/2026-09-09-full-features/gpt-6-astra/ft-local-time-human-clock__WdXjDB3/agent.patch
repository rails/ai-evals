diff --git a/app/javascript/controllers/local_time_controller.js b/app/javascript/controllers/local_time_controller.js
new file mode 100644
index 0000000..7a9e6a4
--- /dev/null
+++ b/app/javascript/controllers/local_time_controller.js
@@ -0,0 +1,26 @@
+import { Controller } from "@hotwired/stimulus"
+import { formatLocalTime, parseLocalTime } from "helpers/local_time_helpers"
+
+export default class extends Controller {
+  static values = { format: { type: String, default: "auto" } }
+
+  #timer
+
+  connect() {
+    this.render()
+    this.#timer = setInterval(() => this.render(), 60_000)
+  }
+
+  disconnect() {
+    clearInterval(this.#timer)
+  }
+
+  render() {
+    const date = parseLocalTime(this.element.dateTime)
+
+    if (!isNaN(date.getTime())) {
+      this.element.textContent = formatLocalTime(date, this.formatValue)
+      this.element.title = formatLocalTime(date, "datetime")
+    }
+  }
+}
diff --git a/app/javascript/helpers/local_time_helpers.js b/app/javascript/helpers/local_time_helpers.js
new file mode 100644
index 0000000..2a7e418
--- /dev/null
+++ b/app/javascript/helpers/local_time_helpers.js
@@ -0,0 +1,47 @@
+const DAY_IN_MILLISECONDS = 86_400_000
+const relativeFormatter = new Intl.RelativeTimeFormat("en", { numeric: "auto" })
+
+export function parseLocalTime(timestamp) {
+  // Calendar dates (timeline headings) must not shift to the previous day west of UTC.
+  if (/^\d{4}-\d{2}-\d{2}$/.test(timestamp)) {
+    return new Date(`${timestamp}T00:00:00`)
+  } else {
+    return new Date(timestamp)
+  }
+}
+
+export function formatLocalTime(date, format = "auto", now = new Date()) {
+  const days = localDayDifference(now, date)
+
+  switch (format) {
+    case "time":
+      return date.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" })
+    case "date":
+      return date.toLocaleDateString("en-US", {
+        month: "short", day: "numeric", year: date.getFullYear() === now.getFullYear() ? undefined : "numeric"
+      })
+    case "date_year":
+      return date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
+    case "long_date":
+      return date.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric" })
+    case "datetime":
+      return date.toLocaleString("en-US", { dateStyle: "long", timeStyle: "short" })
+    case "relative":
+      return relativeFormatter.format(days, "day")
+    default:
+      if (days === 0) {
+        return formatLocalTime(date, "time", now)
+      } else if (Math.abs(days) < 7) {
+        return relativeFormatter.format(days, "day")
+      } else {
+        return formatLocalTime(date, "date", now)
+      }
+  }
+}
+
+export function localDayDifference(fromDate, toDate) {
+  // Compare local calendar dates, not elapsed 24-hour periods (which fail across DST).
+  const fromDay = Date.UTC(fromDate.getFullYear(), fromDate.getMonth(), fromDate.getDate())
+  const toDay = Date.UTC(toDate.getFullYear(), toDate.getMonth(), toDate.getDate())
+  return (toDay - fromDay) / DAY_IN_MILLISECONDS
+}
