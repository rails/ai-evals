@@ -0,0 +1,54 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns account activity as a flat array, newest first. Only events on boards accessible to the current user are returned. Results follow the standard [pagination conventions](../README.md#pagination); follow the `Link` header's `rel="next"` URL to retrieve more activity.
+
+### Filters
+
+| Parameter | Type | Description |
+|-----------|------|-------------|
+| `creator_ids` | array of strings | Only events created by these users |
+| `board_ids` | array of strings | Only events on these boards |
+
+Multiple values within a filter are combined with OR; the two filters are combined with AND. Filtering does not grant access to otherwise inaccessible boards.
+
+```text
+GET /1234567/activities.json?creator_ids[]=USER_ID&board_ids[]=BOARD_ID
+```
+
+### Event fields
+
+| Field | Description |
+|-------|-------------|
+| `id` | Event ID |
+| `action` | Event action (see below) |
+| `created_at` | UTC timestamp in ISO 8601 format |
+| `description` | The event's plain-text description |
+| `particulars` | Event-specific details (see below) |
+| `url` | Card URL; comment events include an anchor to the comment on its card |
+| `eventable_type` | `Card` or `Comment` |
+| `eventable` | The existing [card](cards.md) or [comment](comments.md) API representation |
+| `board` | The existing [board](boards.md) API representation |
+| `creator` | The existing [user](users.md) API representation |
+
+### Actions and particulars
+
+| Action | `particulars` fields |
+|--------|---------------------|
+| `card_assigned` | `assignee_ids` (array of user IDs) |
+| `card_unassigned` | `assignee_ids` (array of user IDs) |
+| `card_board_changed` | `old_board`, `new_board` (board names) |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` (column name) |
+| `card_published` | Empty object |
+| `card_closed` | Empty object |
+| `card_reopened` | Empty object |
+| `card_postponed` | Empty object |
+| `card_auto_postponed` | Empty object |
+| `card_sent_back_to_triage` | Empty object |
+| `comment_created` | Empty object |
+
+Missing board names, titles, and column names are returned as empty strings. Events without event-specific fields return `"particulars": {}`.
+
+This endpoint mirrors the HTML timeline's event types, except that it includes `card_title_changed` and omits deprecated `card_collection_changed` events.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..9049447
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,190 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "supports read-only bearer tokens" do
+    sign_out
+    token = identities(:kevin).access_tokens.create!(description: "Activity reader", permission: :read)
+
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer #{token.token}" }
+
+    assert_response :success
+    assert_not_empty response.parsed_body
+  end
+
+  test "rejects invalid bearer tokens" do
+    sign_out
+
+    get activities_path(format: :json), headers: { "Authorization" => "Bearer invalid" }
+
+    assert_response :unauthorized
+  end
+
+  test "index returns a flat array of activity newest first" do
+    get activities_path(format: :json)
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+    expected_ids = Event.order(created_at: :desc, id: :desc).ids
+    assert_equal expected_ids, response.parsed_body.pluck("id")
+  end
+
+  test "card activity uses the existing API representations and plain text description" do
+    event = events(:layout_assignment_jz)
+
+    get activities_path(format: :json)
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, activity.keys.sort
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at, Time.iso8601(activity["created_at"])
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_not_includes activity["description"], "<span"
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal({ "assignee_ids" => [ users(:jz).id ] }, activity["particulars"])
+
+    get card_path(event.eventable, format: :json)
+    assert_equal response.parsed_body.except("steps"), activity["eventable"]
+
+    get board_path(event.board, format: :json)
+    assert_equal response.parsed_body, activity["board"]
+
+    get user_path(event.creator, format: :json)
+    assert_equal response.parsed_body, activity["creator"]
+  end
+
+  test "comment activity links to the comment on its card" do
+    event = events(:layout_commented)
+    comment = event.eventable
+
+    get activities_path(format: :json)
+    activity = response.parsed_body.find { |item| item["id"] == event.id }
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+
+    get card_comment_path(comment.card, comment, format: :json)
+    assert_equal response.parsed_body, activity["eventable"]
+  end
+
+  test "includes timeline actions and title changes but not deprecated or unrelated actions" do
+    actions = %w[
+      card_assigned card_unassigned card_published card_closed card_reopened
+      card_board_changed card_postponed card_auto_postponed card_triaged
+      card_sent_back_to_triage card_title_changed
+    ]
+
+    actions.each do |action|
+      events(:layout_published).update!(action: action)
+      get activities_path(format: :json)
+      assert_includes response.parsed_body.pluck("action"), action
+    end
+
+    %w[ card_collection_changed card_resumed card_gilded ].each do |action|
+      events(:layout_published).update!(action: action)
+      get activities_path(format: :json)
+      assert_not_includes response.parsed_body.pluck("action"), action
+    end
+  end
+
+  test "particulars expose only the fields for each action" do
+    details = { "old_board" => "Old board", "new_board" => "New board", "old_title" => "Old title", "new_title" => "New title", "column" => "In progress", "extra" => "hidden" }
+    expected_particulars = {
+      "card_assigned" => { "assignee_ids" => [ users(:jz).id ] },
+      "card_unassigned" => { "assignee_ids" => [ users(:jz).id ] },
+      "card_board_changed" => details.slice("old_board", "new_board"),
+      "card_title_changed" => details.slice("old_title", "new_title"),
+      "card_triaged" => details.slice("column"),
+      "card_sent_back_to_triage" => {},
+      "card_published" => {}
+    }
+
+    expected_particulars.each do |action, expected|
+      event = events(:layout_published)
+      event.update!(action: action, particulars: { assignee_ids: [ users(:jz).id ], particulars: details })
+
+      get activities_path(format: :json)
+      activity = response.parsed_body.find { |item| item["id"] == event.id }
+      assert_equal expected, activity["particulars"], action
+    end
+  end
+
+  test "missing and null board title and column particulars are empty strings" do
+    { "card_board_changed" => %w[ old_board new_board ], "card_title_changed" => %w[ old_title new_title ], "card_triaged" => %w[ column ] }.each do |action, keys|
+      [ {}, { particulars: keys.index_with(nil) } ].each do |particulars|
+        event = events(:layout_published)
+        event.update!(action: action, particulars: particulars)
+
+        get activities_path(format: :json)
+        activity = response.parsed_body.find { |item| item["id"] == event.id }
+        assert_equal keys.index_with(""), activity["particulars"], action
+      end
+    end
+  end
+
+  test "filters by creators and boards" do
+    events(:logo_published).update!(board: boards(:private))
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id, users(:kevin).id ], board_ids: [ boards(:writebook).id ] }
+    assert_response :success
+    assert_equal Event.where(board: boards(:writebook), creator: [ users(:david), users(:kevin) ]).order(created_at: :desc, id: :desc).ids, response.parsed_body.pluck("id")
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ], board_ids: [ boards(:private).id ] }
+    assert_equal [ events(:logo_published).id ], response.parsed_body.pluck("id")
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:kevin).id ], board_ids: [ boards(:private).id ] }
+    assert_equal [], response.parsed_body
+  end
+
+  test "only returns accessible activity even when filtering by inaccessible boards" do
+    events(:logo_published).update!(board: boards(:private))
+    events(:layout_published).update!(board: boards(:miltons_wish_list), account: accounts(:initech), eventable: cards(:radio), creator: users(:mike))
+    sign_out
+    sign_in_as :david
+
+    get activities_path(format: :json)
+    assert_response :success
+    assert_not_includes response.parsed_body.pluck("id"), events(:logo_published).id
+    assert_not_includes response.parsed_body.pluck("id"), events(:layout_published).id
+
+    [ boards(:private).id, boards(:miltons_wish_list).id, "nonexistent" ].each do |board_id|
+      get activities_path(format: :json), params: { board_ids: [ board_id ] }
+      assert_response :success
+      assert_equal [], response.parsed_body
+    end
+
+    get activities_path(format: :json), params: { creator_ids: [ "nonexistent" ] }
+    assert_equal [], response.parsed_body
+  end
+
+  test "paginates with next links preserving filters and stable ordering" do
+    20.times do
+      event = events(:layout_published).dup
+      event.id = ActiveRecord::Type::Uuid.generate
+      event.created_at = Time.current.beginning_of_day
+      event.save!
+    end
+
+    get activities_path(format: :json), params: { creator_ids: [ users(:david).id ], board_ids: [ boards(:writebook).id ] }
+    assert_response :success
+    ids = response.parsed_body.pluck("id")
+    assert_equal 15, ids.size
+    assert_match(/rel="next"/, response.headers["Link"])
+
+    get response.headers["Link"].match(/<([^>]+)>; rel="next"/)[1]
+    assert_response :success
+    ids.concat(response.parsed_body.pluck("id"))
+    assert_equal Event.where(creator: users(:david), board: boards(:writebook)).order(created_at: :desc, id: :desc).ids, ids
+    assert_nil response.headers["Link"]
+
+    get activities_path(format: :json), params: { page: 100 }
+    assert_response :success
+    assert_equal [], response.parsed_body
+  end
+end
