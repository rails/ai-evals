--- /dev/null
+++ b/test/models/identity/email_code_test.rb
@@ -0,0 +1,55 @@
+require "test_helper"
+
+class Identity::EmailCodeTest < ActiveSupport::TestCase
+  setup do
+    @identity = identities(:kevin)
+    @email_code = @identity.email_codes.create!
+  end
+
+  test "generates a six-character code valid for fifteen minutes" do
+    assert_match /\A[A-Z0-9]{6}\z/, @email_code.code
+    assert_in_delta 15.minutes.from_now, @email_code.expires_at, 1.second
+    assert_not_equal @email_code.code, @email_code.code_digest
+  end
+
+  test "consumes a code just before expiration" do
+    travel_to @email_code.expires_at - 1.second do
+      assert_equal @identity, @email_code.consume(@email_code.code)
+      assert @email_code.destroyed?
+    end
+  end
+
+  test "rejects codes at and after expiration" do
+    travel_to @email_code.expires_at, with_usec: true do
+      assert_nil @email_code.consume(@email_code.code)
+    end
+    travel_to @email_code.expires_at + 1.second do
+      assert_nil @email_code.consume(@email_code.code)
+    end
+  end
+
+  test "accepts lowercase codes and surrounding whitespace" do
+    assert_equal @identity, @email_code.consume(" #{@email_code.code.downcase}\n")
+  end
+
+  test "allows retrying an incorrect code" do
+    assert_nil @email_code.consume("wrong")
+    assert_equal 1, @email_code.reload.attempts
+    assert_equal @identity, @email_code.consume(@email_code.code)
+  end
+
+  test "locks a code after five incorrect attempts" do
+    5.times { assert_nil @email_code.consume("wrong") }
+    assert_nil @email_code.consume(@email_code.code)
+  end
+
+  test "cleanup deletes only expired codes" do
+    expired = @identity.email_codes.create!
+    expired.update!(expires_at: Time.current)
+
+    assert_difference -> { Identity::EmailCode.count }, -1 do
+      Identity::EmailCode.cleanup
+    end
+    assert Identity::EmailCode.exists?(@email_code.id)
+  end
+end
