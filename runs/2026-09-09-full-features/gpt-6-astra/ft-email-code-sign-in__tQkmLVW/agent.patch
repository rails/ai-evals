new file mode 100644
index 0000000..accc4e4
--- /dev/null
+++ b/app/controllers/concerns/email_code_authentication.rb
@@ -0,0 +1,22 @@
+module EmailCodeAuthentication
+  extend ActiveSupport::Concern
+
+  private
+    def send_email_code(identity, purpose: "sign_in", join_code: nil)
+      if pending = session.delete(:email_code)
+        Identity::EmailCode.find_by(id: pending["id"])&.destroy!
+      end
+
+      email_code = identity.email_codes.create!
+      IdentityMailer.email_code(identity, email_code.code).deliver_later
+      session[:email_code] = {
+        id: email_code.id, purpose: purpose,
+        join_code: join_code&.code, account_id: join_code&.account_id
+      }
+
+      respond_to do |format|
+        format.html { redirect_to new_session_email_code_path(script_name: nil) }
+        format.json { head :created }
+      end
+    end
+end
