--- /dev/null
+++ b/app/controllers/sessions/email_codes_controller.rb
@@ -0,0 +1,92 @@
+class Sessions::EmailCodesController < ApplicationController
+  disallow_account_scope
+  allow_unauthenticated_access
+  rate_limit to: 10, within: 3.minutes, only: :create, with: -> { head :too_many_requests }
+
+  before_action :set_email_code
+
+  layout "public"
+
+  def new
+  end
+
+  def create
+    if identity = @email_code.consume(params.expect(:code))
+      pending = session.delete(:email_code)
+      start_new_session_for identity
+
+      if pending["purpose"] == "join"
+        join_account(identity, pending)
+      else
+        respond_to do |format|
+          format.html { redirect_to pending["purpose"] == "signup" ? new_signup_completion_path : after_authentication_url }
+          format.json { render json: { session_token: session_token } }
+        end
+      end
+    else
+      invalid_code
+    end
+  rescue ActiveRecord::RecordNotFound
+    invalid_code
+  end
+
+  private
+    def set_email_code
+      @email_code = Identity::EmailCode.find_by(id: session.dig(:email_code, "id"))
+
+      if @email_code
+        @new_code_path = new_code_path
+      else
+        respond_to do |format|
+          format.html { redirect_to new_session_path, alert: "Request a new sign-in code to continue." }
+          format.json { head :unauthorized }
+        end
+      end
+    end
+
+    def new_code_path
+      pending = session[:email_code]
+
+      case pending["purpose"]
+      when "signup"
+        new_signup_path
+      when "join"
+        account = Account.find(pending["account_id"])
+        join_path(code: pending["join_code"], script_name: account.slug)
+      else
+        new_session_path
+      end
+    end
+
+    def invalid_code
+      respond_to do |format|
+        format.html do
+          flash.now[:alert] = "That code is incorrect or expired. Try again or request a new code."
+          render :new, status: :unprocessable_entity
+        end
+        format.json { render json: { message: "That code is incorrect or expired." }, status: :unauthorized }
+      end
+    end
+
+    def join_account(identity, pending)
+      join_code = Account::JoinCode.find_by(code: pending["join_code"], account_id: pending["account_id"])
+
+      if join_code&.active?
+        join_code.redeem_if { |account| identity.join(account) }
+        user = User.active.find_by(account: join_code.account, identity: identity)
+
+        if user
+          respond_to do |format|
+            format.html do
+              redirect_to user.setup? ? landing_url(script_name: join_code.account.slug) : new_users_verification_url(script_name: join_code.account.slug)
+            end
+            format.json { head :created }
+          end
+        else
+          head :gone
+        end
+      else
+        head :gone
+      end
+    end
+end
