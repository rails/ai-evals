@@ -0,0 +1,22 @@
+<% @page_title = "Enter your sign-in code" %>
+
+<div class="panel panel--centered flex flex-column gap-half">
+  <h1 class="txt-x-large font-weight-black margin-block-end">Check your email</h1>
+  <p>We sent a six-character code to <strong><%= @email_code.identity.email_address %></strong>. Enter it below to continue. The code expires in 15 minutes.</p>
+
+  <%= form_with url: session_email_code_path, class: "flex flex-column gap-half txt-medium" do |form| %>
+    <%= form.label :code, "Sign-in code" %>
+    <%= form.text_field :code, required: true, minlength: 6, maxlength: 6, class: "input txt-large full-width", autofocus: true, autocomplete: "one-time-code", autocapitalize: "characters", spellcheck: false %>
+
+    <button type="submit" class="btn btn--link center txt-medium">
+      <span>Continue</span>
+      <%= icon_tag "arrow-right" %>
+    </button>
+  <% end %>
+
+  <p><%= link_to "Start over with a new code", @new_code_path %></p>
+</div>
+
+<% content_for :footer do %>
+  <%= render "sessions/footer" %>
+<% end %>
