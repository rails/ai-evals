diff --git a/test/integration/email_code_sign_in_test.rb b/test/integration/email_code_sign_in_test.rb
new file mode 100644
index 0000000..8ba66e4
--- /dev/null
+++ b/test/integration/email_code_sign_in_test.rb
@@ -0,0 +1,295 @@
+require "test_helper"
+
+class EmailCodeSignInTest < ActionDispatch::IntegrationTest
+  include ActionMailer::TestHelper
+
+  test "sign in with an emailed code" do
+    untenanted do
+      email = nil
+      assert_no_difference -> { Session.count } do
+        email = capture_emails do
+          post session_path, params: { email_address: identities(:kevin).email_address }
+        end.sole
+      end
+
+      assert_redirected_to new_session_email_code_path
+      follow_redirect!
+      assert_select "input[name=code][autocomplete=one-time-code]"
+
+      code = email.subject[/\b[A-Z0-9]{6}\b/]
+      assert_not_nil code
+      assert_includes email.body.to_s, code
+
+      assert_difference -> { Session.count }, 1 do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_response :redirect
+      assert_equal identities(:kevin), Session.last.identity
+      assert cookies[:session_token].present?
+    end
+  end
+  test "signing up verifies email before creating an account" do
+    untenanted do
+      assert_no_difference -> { Account.count } do
+        assert_no_difference -> { Session.count } do
+          @code = request_code(signup_path, signup: { email_address: "new-person@example.com" })
+        end
+      end
+      post session_email_code_path, params: { code: @code }
+      assert_redirected_to new_signup_completion_path
+      follow_redirect!
+      assert_response :success
+
+      assert_difference -> { Account.count }, 1 do
+        post signup_completion_path, params: { signup: { full_name: "New Person" } }
+      end
+      assert_response :redirect
+      identity = Identity.find_by!(email_address: "new-person@example.com")
+      assert_equal "New Person", identity.users.sole.name
+    end
+  end
+
+  test "signup reuses an existing identity" do
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        code = request_code(signup_path, signup: { email_address: identities(:kevin).email_address })
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to new_signup_completion_path
+      assert_equal identities(:kevin), Session.last.identity
+    end
+  end
+
+  test "joining verifies email before redeeming the join code" do
+    join_code = account_join_codes(:"37s")
+    account = join_code.account
+    code = nil
+
+    assert_no_difference -> { User.count } do
+      assert_no_difference -> { join_code.reload.usage_count } do
+        code = request_code(join_path(code: join_code.code, script_name: account.slug), email_address: "joining@example.com")
+      end
+    end
+
+    untenanted do
+      assert_difference -> { User.count }, 1 do
+        assert_difference -> { join_code.reload.usage_count }, 1 do
+          post session_email_code_path, params: { code: code }
+        end
+      end
+      assert_redirected_to new_users_verification_url(script_name: account.slug)
+    end
+
+    post users_verifications_path(script_name: account.slug)
+    assert_redirected_to new_users_join_path(script_name: account.slug)
+    post users_joins_path(script_name: account.slug), params: { user: { name: "Joining Person" } }
+    assert_response :redirect
+    assert_equal "Joining Person", Identity.find_by!(email_address: "joining@example.com").users.sole.name
+  end
+
+  test "joining an existing membership does not use another join code redemption" do
+    join_code = account_join_codes(:"37s")
+    identity = identities(:jz)
+    code = request_code(join_path(code: join_code.code), email_address: identity.email_address)
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        assert_no_difference -> { join_code.reload.usage_count } do
+          post session_email_code_path, params: { code: code }
+        end
+      end
+      assert_redirected_to landing_url(script_name: join_code.account.slug)
+    end
+  end
+
+  test "joining rechecks the join code after email verification" do
+    join_code = account_join_codes(:"37s")
+    code = request_code(join_path(code: join_code.code), email_address: "joining@example.com")
+    join_code.update!(usage_count: join_code.usage_limit)
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_response :gone
+    end
+  end
+
+  test "invalid and expired codes do not sign in" do
+    untenanted do
+      code = request_code(session_path, email_address: identities(:kevin).email_address)
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: "wrong!" }
+        assert_response :unprocessable_entity
+        assert_select "input[name=code]"
+
+        travel_to Identity::EmailCode.last.expires_at, with_usec: true do
+          post session_email_code_path, params: { code: code }
+          assert_response :unprocessable_entity
+        end
+      end
+    end
+  end
+
+  test "a code can only be used once" do
+    untenanted do
+      code = request_code(session_path, email_address: identities(:kevin).email_address)
+      post session_email_code_path, params: { code: code }
+      delete session_path
+
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "a code cannot be used in another browser" do
+    untenanted do
+      code = request_code(session_path, email_address: identities(:kevin).email_address)
+      other_browser = open_session
+
+      assert_no_difference -> { Session.count } do
+        other_browser.post session_email_code_path, params: { code: code }
+      end
+      other_browser.assert_redirected_to new_session_path
+    end
+  end
+
+  test "requesting another code invalidates the previous challenge" do
+    untenanted do
+      request_code(session_path, email_address: identities(:kevin).email_address)
+      previous_id = Identity::EmailCode.last.id
+      code = request_code(session_path, email_address: identities(:kevin).email_address)
+      assert_not Identity::EmailCode.exists?(previous_id)
+      post session_email_code_path, params: { code: code }
+      assert cookies[:session_token].present?
+    end
+  end
+
+  test "email login respects the original destination" do
+    get boards_path
+    assert_response :redirect
+
+    untenanted do
+      code = request_code(session_path, email_address: identities(:kevin).email_address)
+      post session_email_code_path, params: { code: code }
+      assert_redirected_to boards_url(script_name: accounts(:"37s").slug)
+    end
+  end
+
+  test "sign in normalizes email addresses" do
+    untenanted do
+      code = request_code(session_path, email_address: " #{identities(:kevin).email_address.upcase} ")
+      post session_email_code_path, params: { code: code }
+      assert_equal identities(:kevin), Session.last.identity
+    end
+  end
+
+  test "invalid and unknown emails do not create identities or send email" do
+    untenanted do
+      assert_no_difference -> { Identity.count } do
+        assert_no_emails do
+          post session_path, params: { email_address: "not an email" }
+          assert_response :unprocessable_entity
+          post session_path, params: { email_address: "unknown@example.com" }
+          assert_redirected_to new_session_path
+        end
+      end
+    end
+  end
+
+  test "verification requires a pending challenge" do
+    untenanted do
+      get new_session_email_code_path
+      assert_redirected_to new_session_path
+      post session_email_code_path, params: { code: "ABCDEF" }
+      assert_redirected_to new_session_path
+    end
+  end
+
+  test "verification is rate limited" do
+    untenanted do
+      code = request_code(session_path, email_address: identities(:kevin).email_address)
+      Rails.cache.stubs(:increment).returns(11)
+      assert_no_difference -> { Session.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_response :too_many_requests
+    end
+  end
+
+  test "sign in via JSON" do
+    untenanted do
+      email = capture_emails do
+        post session_path, params: { email_address: identities(:kevin).email_address }, as: :json
+      end.sole
+      assert_response :created
+      post session_email_code_path, params: { code: email.subject[/\b[A-Z0-9]{6}\b/] }, as: :json
+      assert_response :success
+      assert response.parsed_body["session_token"].present?
+    end
+  end
+
+  test "joining with an existing identity creates the membership only after verification" do
+    identity = identities(:mike)
+    join_code = account_join_codes(:"37s")
+
+    assert_no_difference -> { Identity.count } do
+      code = request_code(join_path(code: join_code.code), email_address: identity.email_address)
+      assert_not identity.users.exists?(account: join_code.account)
+
+      untenanted do
+        post session_email_code_path, params: { code: code }
+        assert_redirected_to new_users_verification_url(script_name: join_code.account.slug)
+      end
+    end
+    assert identity.users.exists?(account: join_code.account)
+  end
+
+  test "reset join codes cannot be redeemed after verification" do
+    join_code = account_join_codes(:"37s")
+    code = request_code(join_path(code: join_code.code), email_address: "joining@example.com")
+    join_code.reset
+
+    untenanted do
+      assert_no_difference -> { User.count } do
+        post session_email_code_path, params: { code: code }
+      end
+      assert_response :gone
+    end
+  end
+
+  test "requesting a new code preserves the signup or join flow" do
+    untenanted do
+      request_code(signup_path, signup: { email_address: "new-person@example.com" })
+      assert_select "a[href=?]", new_signup_path, text: "Start over with a new code"
+    end
+
+    join_code = account_join_codes(:"37s")
+    path = join_path(code: join_code.code, script_name: join_code.account.slug)
+    request_code(path, email_address: "new-person@example.com")
+    assert_select "a[href=?]", path, text: "Start over with a new code"
+  end
+
+  test "sign-in code requests are rate limited" do
+    Rails.cache.stubs(:increment).returns(11)
+
+    untenanted do
+      assert_no_emails do
+        post session_path, params: { email_address: identities(:kevin).email_address }
+      end
+      assert_redirected_to new_session_path
+      assert_equal "Try again later.", flash[:alert]
+    end
+  end
+
+  private
+    def request_code(path, **params)
+      email = capture_emails { post path, params: params }.sole
+      assert_redirected_to new_session_email_code_path(script_name: nil)
+      follow_redirect!
+      assert_response :success
+      email.subject[/\b[A-Z0-9]{6}\b/].tap { |code| assert_not_nil code }
+    end
+end
