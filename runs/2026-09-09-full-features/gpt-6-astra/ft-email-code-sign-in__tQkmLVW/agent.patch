diff --git a/app/models/identity/email_code.rb b/app/models/identity/email_code.rb
new file mode 100644
index 0000000..e9be177
--- /dev/null
+++ b/app/models/identity/email_code.rb
@@ -0,0 +1,34 @@
+class Identity::EmailCode < ApplicationRecord
+  EXPIRATION_TIME = 15.minutes
+  MAX_ATTEMPTS = 5
+
+  belongs_to :identity
+
+  attr_reader :code
+
+  before_create :generate_code
+
+  def self.cleanup
+    where(expires_at: ..Time.current).delete_all
+  end
+
+  def consume(code)
+    with_lock do
+      if expires_at > Time.current && attempts < MAX_ATTEMPTS
+        increment!(:attempts)
+
+        if ActiveSupport::SecurityUtils.secure_compare(code_digest, Digest::SHA256.hexdigest(code.to_s.strip.upcase))
+          destroy!
+          identity
+        end
+      end
+    end
+  end
+
+  private
+    def generate_code
+      @code = SecureRandom.alphanumeric(6).upcase
+      self.code_digest = Digest::SHA256.hexdigest(@code)
+      self.expires_at = EXPIRATION_TIME.from_now
+    end
+end
