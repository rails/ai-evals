+++ b/test/models/webhook/dispatch_test.rb
@@ -0,0 +1,176 @@
+require "test_helper"
+
+class Webhook::DispatchTest < ActiveSupport::TestCase
+  test "an event schedules one delivery for each active subscribed webhook on its board" do
+    webhook = webhooks(:active)
+    attributes = webhook.attributes.slice("name", "url", "subscribed_actions", "board_id")
+    Webhook.create!(attributes.merge(board_id: boards(:private).id))
+    Webhook.create!(attributes.merge(active: false))
+    Webhook.create!(attributes.merge(subscribed_actions: [ "comment_created" ]))
+
+    assert_enqueued_jobs 1, only: Webhook::DeliveryJob do
+      event = Event.create!(board: webhook.board, creator: users(:david), eventable: cards(:logo), action: "card_published")
+      assert_equal [ webhook.id ], event.webhook_deliveries.pluck(:webhook_id)
+      event.dispatch_webhooks
+      assert_equal 1, event.webhook_deliveries.count
+    end
+  end
+
+  test "delivery posts a signed payload once and records its response" do
+    delivery = webhook_deliveries(:pending)
+    stub_dns_resolution("93.184.216.34")
+    Net::HTTP.any_instance.expects(:ipaddr=).with("93.184.216.34").once
+    stub_request(:post, delivery.webhook.url).with do |request|
+      assert_equal delivery.event_id, JSON.parse(request.body)["id"]
+      assert_equal OpenSSL::HMAC.hexdigest("SHA256", delivery.webhook.signing_secret, request.body), request.headers["X-Webhook-Signature"]
+      true
+    end.to_return(status: 204)
+
+    stale_copy = Webhook::Delivery.find(delivery.id)
+    Webhook::DeliveryJob.perform_now(delivery)
+    Webhook::DeliveryJob.perform_now(stale_copy)
+
+    assert_requested :post, delivery.webhook.url, times: 1
+    assert delivery.reload.succeeded?, delivery.response.inspect
+    assert_equal 204, delivery.response_summary[:code]
+    assert delivery.sanitized_request.present?
+  end
+  test "timeouts are logged and never retried" do
+    delivery = webhook_deliveries(:pending)
+    stub_dns_resolution("93.184.216.34")
+    stub_request(:post, delivery.webhook.url).to_timeout
+
+    2.times { delivery.deliver_now }
+
+    assert_requested :post, delivery.webhook.url, times: 1
+    assert delivery.reload.errored?
+    assert delivery.failed?
+    assert delivery.response_summary[:error].present?
+    assert_equal 1, delivery.webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "HTTP failures complete with the status logged and count toward delinquency" do
+    delivery = webhook_deliveries(:pending)
+    stub_dns_resolution("93.184.216.34")
+    stub_request(:post, delivery.webhook.url).to_return(status: 503)
+    delivery.deliver_now
+    assert delivery.reload.completed?
+    assert delivery.failed?
+    assert_equal 503, delivery.response_summary[:code]
+    assert_equal 1, delivery.webhook.delinquency_tracker.consecutive_failures_count
+  end
+
+  test "private destinations are blocked and redirects are not followed" do
+    delivery = webhook_deliveries(:pending)
+    stub_dns_resolution("127.0.0.1")
+    delivery.deliver_now
+    assert delivery.reload.errored?
+    assert_equal "destination_unreachable", delivery.response_summary[:error]
+    assert_not_requested :post, delivery.webhook.url
+
+    delivery = webhook_deliveries(:pending)
+    delivery.update!(state: :pending)
+    stub_dns_resolution("93.184.216.34")
+    stub_request(:post, delivery.webhook.url).to_return(status: 302, headers: { "Location" => "http://127.0.0.1/secret" })
+    delivery.deliver_now
+    assert_equal 302, delivery.reload.response_summary[:code]
+    assert delivery.failed?
+    assert_not_requested :any, "http://127.0.0.1/secret"
+  end
+
+  test "queued deliveries to inactive webhooks are not sent" do
+    delivery = webhook_deliveries(:pending)
+    delivery.webhook.deactivate
+    delivery.deliver_now
+    assert_equal "webhook_inactive", delivery.reload.response_summary[:error]
+    assert_not_requested :post, delivery.webhook.url
+    assert_nil delivery.webhook.delinquency_tracker
+  end
+
+  test "in progress and finished deliveries are never sent again" do
+    %i[ in_progress successfully_completed unsuccessfully_completed errored ].each do |fixture|
+      delivery = webhook_deliveries(fixture)
+      assert_no_changes -> { delivery.reload.attributes } do
+        delivery.deliver_now
+      end
+      assert_not_requested :post, delivery.webhook.url
+    end
+  end
+
+  test "cleanup deletes only logs older than a week" do
+    freeze_time do
+      old = webhook_deliveries(:errored)
+      boundary = webhook_deliveries(:successfully_completed)
+      old.update!(created_at: 1.week.ago - 1.second)
+      boundary.update!(created_at: 1.week.ago)
+      Webhook::Delivery.cleanup
+      assert_not Webhook::Delivery.exists?(old.id)
+      assert Webhook::Delivery.exists?(boundary.id)
+      assert Webhook::Delivery.exists?(webhook_deliveries(:pending).id)
+    end
+  end
+
+  test "a duplicate webhook and event pair is rejected by the database" do
+    delivery = webhook_deliveries(:pending)
+    assert_raises ActiveRecord::RecordNotUnique do
+      delivery.webhook.deliveries.create!(event: delivery.event)
+    end
+  end
+  test "rolling back an event also rolls back its deliveries and enqueues no delivery jobs" do
+    assert_no_enqueued_jobs only: Webhook::DeliveryJob do
+      assert_no_difference "Webhook::Delivery.count" do
+        Event.transaction do
+          Event.create!(board: boards(:writebook), creator: users(:david), eventable: cards(:logo), action: "card_published")
+          raise ActiveRecord::Rollback
+        end
+      end
+    end
+  end
+
+  test "a successful POST resets previous failures" do
+    delivery = webhook_deliveries(:pending)
+    tracker = delivery.webhook.create_delinquency_tracker!(consecutive_failures_count: 9, first_failure_at: 2.hours.ago)
+    stub_dns_resolution("93.184.216.34")
+    stub_request(:post, delivery.webhook.url).to_return(status: 200)
+    delivery.deliver_now
+    assert delivery.reload.succeeded?
+    assert_equal 0, tracker.reload.consecutive_failures_count
+    assert_nil tracker.first_failure_at
+  end
+  test "every subscribed receiver gets its own delivery" do
+    original = webhooks(:active)
+    second = original.board.webhooks.create!(name: "Second", url: "https://second.example.com/events", subscribed_actions: [ "card_published" ])
+    assert_enqueued_jobs 2, only: Webhook::DeliveryJob do
+      event = Event.create!(board: original.board, creator: users(:david), eventable: cards(:logo), action: "card_published")
+      assert_equal [ original.id, second.id ].sort, event.webhook_deliveries.pluck(:webhook_id).sort
+    end
+  end
+
+  test "comment payloads include their eventable and account scoped URLs" do
+    webhook = webhooks(:active)
+    webhook.update!(subscribed_actions: [ "comment_created" ])
+    event = events(:layout_commented)
+    event.dispatch_webhooks
+    delivery = event.webhook_deliveries.sole
+    stub_dns_resolution("93.184.216.34")
+    stub_request(:post, webhook.url).with do |request|
+      payload = JSON.parse(request.body)
+      assert_equal "comment_created", payload["action"]
+      assert_equal event.eventable_id, payload["eventable"]["id"]
+      assert_includes payload["board"]["url"], delivery.account.slug
+      true
+    end.to_return(status: 201)
+    delivery.deliver_now
+    assert delivery.reload.succeeded?
+  end
+
+  test "HTTP success at the tenth delivery does not deactivate" do
+    delivery = webhook_deliveries(:pending)
+    tracker = delivery.webhook.create_delinquency_tracker!(consecutive_failures_count: 9, first_failure_at: 1.hour.ago)
+    stub_dns_resolution("93.184.216.34")
+    stub_request(:post, delivery.webhook.url).to_return(status: 299)
+    delivery.deliver_now
+    assert delivery.webhook.reload.active?
+    assert_equal 0, tracker.reload.consecutive_failures_count
+  end
+end
