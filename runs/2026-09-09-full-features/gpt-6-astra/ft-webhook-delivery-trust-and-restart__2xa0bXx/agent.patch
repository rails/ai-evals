diff --git a/app/models/webhook/delivery/request.rb b/app/models/webhook/delivery/request.rb
new file mode 100644
index 0000000..fe6c930
--- /dev/null
+++ b/app/models/webhook/delivery/request.rb
@@ -0,0 +1,49 @@
+require "net/http"
+
+class Webhook::Delivery::Request
+  TIMEOUT = 10
+
+  attr_reader :delivery, :body, :headers
+
+  def initialize(delivery)
+    @delivery = delivery
+    @body = ApplicationController.renderer.new(script_name: delivery.account.slug).render(
+      template: "webhooks/event", formats: [ :json ], assigns: { event: delivery.event }
+    )
+    @headers = {
+      "Content-Type" => "application/json",
+      "User-Agent" => "Fizzy Webhook",
+      "X-Webhook-Id" => delivery.id,
+      "X-Webhook-Timestamp" => Time.current.iso8601,
+      "X-Webhook-Signature" => OpenSSL::HMAC.hexdigest("SHA256", delivery.webhook.signing_secret, body)
+    }
+  end
+
+  def perform
+    uri = URI.parse(delivery.webhook.url)
+    ip = SsrfProtection.resolve_public_ip(uri.hostname)
+
+    if ip
+      # Pin the validated address to prevent DNS rebinding. Do not use an
+      # environment proxy, follow redirects, or retry an ambiguous POST.
+      http = Net::HTTP.new(uri.hostname, uri.port, nil)
+      http.ipaddr = ip
+      http.use_ssl = uri.scheme == "https"
+      http.open_timeout = http.read_timeout = http.write_timeout = TIMEOUT
+      http.max_retries = 0
+
+      request = Net::HTTP::Post.new(uri.request_uri, headers)
+      request.body = body
+      http.start do
+        http.request(request) do |response|
+          # Only retain status and headers, not an unbounded receiver body.
+          return { code: response.code.to_i, headers: response.to_hash }
+        end
+      end
+    else
+      { error: "destination_unreachable" }
+    end
+  rescue Timeout::Error, SocketError, SystemCallError, IOError, OpenSSL::SSL::SSLError, Net::HTTPBadResponse, Net::ProtocolError, Resolv::ResolvError => error
+    { error: error.class.name }
+  end
+end
