@@ -8,8 +8,33 @@ class Webhook::Delivery < ApplicationRecord
 
   enum :state, %w[ pending in_progress completed errored ].index_by(&:itself), default: :pending
 
+  after_create_commit :deliver_later
+
   scope :ordered, -> { order created_at: :desc, id: :desc }
 
+  def self.cleanup
+    where(created_at: ...1.week.ago).in_batches.delete_all
+  end
+
+  def deliver_later
+    Webhook::DeliveryJob.perform_later(self)
+  end
+
+  def deliver_now
+    # Commit the claim before making the POST. A competing or retried job must
+    # never send an in-progress delivery, even if its outcome is unknown.
+    if self.class.where(id: id, state: :pending).update_all(state: :in_progress, updated_at: Time.current) == 1
+      reload
+      if webhook.reload.active?
+        outgoing = Request.new(self)
+        update! request: { headers: outgoing.headers, body: outgoing.body }
+        finish(outgoing.perform)
+      else
+        update! state: :errored, response: { error: "webhook_inactive" }
+      end
+    end
+  end
+
   def sanitized_request
     if headers = request&.dig("headers")&.except("X-Webhook-Signature")
       { headers: headers }
@@ -27,6 +52,15 @@ class Webhook::Delivery < ApplicationRecord
   end
 
   def succeeded?
-    completed? && response[:error].blank? && response[:code].between?(200, 299)
+    completed? && response[:error].blank? && response[:code].to_i.between?(200, 299)
   end
+
+  private
+    def finish(result)
+      webhook.with_lock do
+        update! response: result, state: result[:error] ? :errored : :completed
+        tracker = webhook.delinquency_tracker || webhook.create_delinquency_tracker!
+        tracker.record(self)
+      end
+    end
