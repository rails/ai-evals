+++ b/config/deploy.yml
@@ -0,0 +1,54 @@
+# Single-server deployment. See docs/deployment.md before running kamal setup.
+service: fizzy
+image: fizzy
+
+servers:
+  web:
+    - fizzy.example.com
+
+# Point this hostname at your server. Kamal Proxy obtains and renews the certificate.
+proxy:
+  ssl: true
+  host: fizzy.example.com
+  app_port: 80
+
+# Kamal runs a registry on your development machine and tunnels it over SSH.
+# No external registry account is required.
+registry:
+  server: localhost:5555
+
+builder:
+  arch: amd64 # Use arm64 if your server is ARM-based.
+
+env:
+  clear:
+    SAAS: "false"
+    DATABASE_ADAPTER: sqlite
+    ACTIVE_STORAGE_SERVICE: local
+    SOLID_QUEUE_IN_PUMA: "true"
+    WEB_CONCURRENCY: 1
+    JOB_CONCURRENCY: 1
+    # Match proxy.host above. Used for links in emails and background jobs.
+    APP_FQDN: fizzy.example.com
+    MAILER_FROM_ADDRESS: "Fizzy <fizzy@example.com>"
+    SMTP_ADDRESS: smtp.example.com
+    SMTP_PORT: 587
+    SMTP_DOMAIN: example.com
+    SMTP_AUTHENTICATION: plain
+    SMTP_ENABLE_STARTTLS_AUTO: "true"
+  secret:
+    - SECRET_KEY_BASE
+    - SMTP_USERNAME
+    - SMTP_PASSWORD
+
+# All four SQLite databases (including jobs) and local uploads live here.
+# Keep this volume name unchanged across deploys.
+volumes:
+  - "fizzy_storage:/rails/storage"
+
+asset_path: /rails/public/assets
+
+aliases:
+  console: app exec --interactive --reuse "bin/rails console"
+  shell: app exec --interactive --reuse "bash"
+  logs: app logs -f
