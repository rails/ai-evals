diff --git a/app/models/account/data_transfer.rb b/app/models/account/data_transfer.rb
new file mode 100644
index 0000000..72d2420
--- /dev/null
+++ b/app/models/account/data_transfer.rb
@@ -0,0 +1,47 @@
+module Account::DataTransfer
+  VERSION = 1
+
+  # Only these account-owned types can cross the archive boundary. Authentication
+  # credentials, sessions, webhooks, and notification delivery state never do.
+  RECORD_TYPES = {
+    "users" => User,
+    "user_settings" => User::Settings,
+    "boards" => Board,
+    "columns" => Column,
+    "cards" => Card,
+    "comments" => Comment,
+    "tags" => Tag,
+    "accesses" => Access,
+    "assignments" => Assignment,
+    "steps" => Step,
+    "closures" => Closure,
+    "goldnesses" => Card::Goldness,
+    "not_nows" => Card::NotNow,
+    "taggings" => Tagging,
+    "reactions" => Reaction,
+    "entropies" => Entropy,
+    "watches" => Watch,
+    "pins" => Pin,
+    "events" => Event,
+    "mentions" => Mention,
+    "activity_spikes" => Card::ActivitySpike,
+    "rich_texts" => ::ActionText::RichText,
+    "attachments" => ::ActiveStorage::Attachment
+  }.freeze
+
+  REFERENCES = {
+    "creator_id" => User, "user_id" => User, "assignee_id" => User,
+    "assigner_id" => User, "reacter_id" => User, "board_id" => Board,
+    "card_id" => Card, "column_id" => Column, "tag_id" => Tag,
+    "mentioner_id" => User, "mentionee_id" => User,
+    "blob_id" => ::ActiveStorage::Blob
+  }.freeze
+
+  POLYMORPHIC_REFERENCES = {
+    "record" => [ User, Board, Card, Comment, ::ActionText::RichText ],
+    "reactable" => [ Card, Comment ],
+    "eventable" => [ Card, Comment ],
+    "source" => [ Card, Comment ],
+    "container" => [ Account, Board ]
+  }.freeze
+end
diff --git a/app/models/account/data_transfer/reader.rb b/app/models/account/data_transfer/reader.rb
new file mode 100644
index 0000000..f332cb7
--- /dev/null
+++ b/app/models/account/data_transfer/reader.rb
@@ -0,0 +1,210 @@
+class Account::DataTransfer::Reader
+  include Account::DataTransfer
+
+  def initialize(io, identity:)
+    @zip = ZipFile::Reader.new(io)
+    @identity = identity
+    @ids = {}
+    @attachables = {}
+    @uploaded_blobs = []
+  end
+
+  def restore
+    manifest = @zip.json("manifest.json")
+    unless manifest.values_at("format", "version", "kind") == [ "fizzy", VERSION, "account" ]
+      raise ZipFile::Invalid, "Choose a supported Fizzy account export, not a personal cards export"
+    end
+    prepare_ids
+
+    Account.transaction(requires_new: true) do
+      @account = Account.create!(manifest.fetch("account").slice("name", "created_at", "updated_at"))
+      @account.entropies.delete_all
+      @ids[[ Account.name, manifest.fetch("account").fetch("id") ]] = @account.id
+      Current.with(account: @account, user: nil) do
+        restore_blobs
+        RECORD_TYPES.each do |directory, model|
+          entries_for(directory).each do |name|
+            data = @zip.json(name)
+            unless name == "#{directory}/#{data.fetch('attributes').fetch('id')}.json"
+              raise ZipFile::Invalid, "Record ID does not match its archive entry"
+            end
+            restore_record(model, data)
+          end
+        end
+        ensure_owner_and_system_user
+        @account.update!(cards_count: @account.cards.maximum(:number) || 0)
+        @account.cards.find_each(&:reindex)
+        Comment.where(account: @account).find_each(&:reindex)
+        @account.boards.find_each(&:reconcile_storage)
+        @account.reconcile_storage
+        yield @account if block_given?
+      end
+      @account
+    end
+  rescue Exception
+    # Blob uploads are external to the database transaction. Keep the generated
+    # keys so even a partially completed upload is deleted after a rollback.
+    @uploaded_blobs.each { |blob| blob.service.delete(blob.key) }
+    raise
+  end
+
+  private
+    def prepare_ids
+      @zip.names.each do |name|
+        next if name == "manifest.json"
+        match = name.match(%r{\A([a-z_]+)/([a-z0-9]{25})(\.json)?\z})
+        raise ZipFile::Invalid, "Unknown archive entry: #{name}" unless match
+        directory, id, extension = match.captures
+        if directory == "files"
+          raise ZipFile::Invalid, "Invalid file entry" if extension
+        else
+          model = directory == "blobs" ? ::ActiveStorage::Blob : RECORD_TYPES[directory]
+          raise ZipFile::Invalid, "Unknown record type: #{directory}" unless model && extension
+          @ids[[ model.name, id ]] = ActiveRecord::Type::Uuid.generate
+        end
+      end
+    end
+
+    def entries_for(directory)
+      @zip.names.grep(%r{\A#{directory}/})
+    end
+
+    def restore_blobs
+      unless entries_for("files").sort == entries_for("blobs").map { |name| name.sub("blobs/", "files/").delete_suffix(".json") }.sort
+        raise ZipFile::Invalid, "File entries do not match their metadata"
+      end
+      entries_for("blobs").each do |name|
+        data = @zip.json(name)
+        unless name == "blobs/#{data.fetch('id')}.json"
+          raise ZipFile::Invalid, "File ID does not match its archive entry"
+        end
+        Tempfile.create("fizzy-import-file", binmode: true) do |file|
+          @zip.copy("files/#{data.fetch('id')}", file)
+          file.rewind
+          blob = ::ActiveStorage::Blob.build_after_unfurling(
+            io: file, filename: data.fetch("filename"), content_type: data["content_type"], identify: false
+          )
+          unless blob.byte_size == data.fetch("byte_size") && blob.checksum == data.fetch("checksum")
+            raise ZipFile::Invalid, "File checksum does not match: #{data['filename']}"
+          end
+          blob.id = mapped_id(::ActiveStorage::Blob, data.fetch("id"))
+          blob.account_id = @account.id
+          blob.save!
+          @uploaded_blobs << blob
+          file.rewind
+          blob.upload_without_unfurling(file)
+          @attachables[data.fetch("attachable_sgid")] = blob
+        end
+      end
+    end
+
+    def restore_record(model, data)
+      original = data.fetch("attributes")
+      attributes = original.slice(*model.column_names).except("account_id", "identity_id")
+      attributes["id"] = mapped_id(model, original.fetch("id"))
+      attributes["account_id"] = @account.id
+
+      REFERENCES.each do |foreign_key, target|
+        attributes[foreign_key] = mapped_id(target, attributes[foreign_key]) if attributes[foreign_key]
+      end
+      POLYMORPHIC_REFERENCES.each do |prefix, allowed|
+        if attributes["#{prefix}_id"]
+          target = allowed.find { |candidate| candidate.name == attributes["#{prefix}_type"] }
+          raise ZipFile::Invalid, "Invalid #{prefix} type" unless target
+          attributes["#{prefix}_id"] = mapped_id(target, attributes["#{prefix}_id"])
+        end
+      end
+
+      if model == User
+        raise ZipFile::Invalid, "Invalid user role" unless User.roles.key?(attributes["role"])
+        if email = data["email_address"].presence
+          identity = Identity.find_or_create_by!(email_address: email.strip.downcase)
+          attributes["identity_id"] = identity.id
+        end
+        # The person performing the import is the sole owner of the new account.
+        attributes["role"] = "admin" if attributes["role"] == "owner"
+      elsif model == Event && attributes["particulars"].is_a?(Hash)
+        if ids = attributes["particulars"]["assignee_ids"]
+          attributes["particulars"]["assignee_ids"] = ids.map { |id| mapped_id(User, id) }
+        end
+      elsif model == Card
+        raise ZipFile::Invalid, "Invalid card status" unless Card.statuses.key?(attributes["status"])
+        if attributes["column_id"] && Column.find(attributes["column_id"]).board_id != attributes["board_id"]
+          raise ZipFile::Invalid, "Card column belongs to a different board"
+        end
+      elsif model == ::ActionText::RichText
+        validate_record_name(attributes, rich_text: true)
+        attributes["body"] = restore_rich_text(attributes["body"])
+      elsif model == ::ActiveStorage::Attachment
+        validate_record_name(attributes)
+      end
+
+      model.reflect_on_all_associations(:belongs_to).each do |association|
+        next if association.name == :account || association.polymorphic?
+        if id = attributes[association.foreign_key]
+          unless association.klass.exists?(id: id)
+            raise ZipFile::Invalid, "Missing #{association.name} record"
+          end
+        elsif !association.options[:optional]
+          raise ZipFile::Invalid, "Missing #{association.name} reference"
+        end
+      end
+
+      # Bypass live-activity callbacks: importing history must not send invitations,
+      # notifications, webhooks, or broadcasts. Search and storage are rebuilt above.
+      model.insert_all!([ attributes ])
+      if model == User
+        @attachables[data.fetch("attachable_sgid")] = User.find(attributes["id"])
+      end
+    end
+
+    def mapped_id(model, old_id)
+      @ids.fetch([ model.name, old_id ]) { raise ZipFile::Invalid, "Missing #{model.model_name.human} reference" }
+    end
+
+    def validate_record_name(attributes, rich_text: false)
+      allowed = if rich_text
+        { "Card" => [ "description" ], "Comment" => [ "body" ], "Board" => [ "public_description" ] }
+      else
+        { "Card" => [ "image" ], "User" => [ "avatar" ], "ActionText::RichText" => [ "embeds" ] }
+      end
+      unless allowed.fetch(attributes["record_type"], []).include?(attributes["name"])
+        raise ZipFile::Invalid, "Invalid attachment or rich text association"
+      end
+    end
+
+    def restore_rich_text(body)
+      fragment = Nokogiri::HTML5.fragment(body.to_s)
+      fragment.css("action-text-attachment").each do |node|
+        if old_sgid = node["sgid"]
+          attachable = @attachables[old_sgid]
+          raise ZipFile::Invalid, "Missing rich text attachment" unless attachable
+          node.remove_attribute("url")
+          node.remove_attribute("href")
+          attachable.to_rich_text_attributes.each { |key, value| node[key.to_s] = value.to_s }
+          node["sgid"] = attachable.attachable_sgid
+        end
+      end
+      fragment.to_html
+    end
+
+    def ensure_owner_and_system_user
+      owner = @account.users.find_by(identity: @identity)
+      if owner
+        owner.update_columns(role: "owner", active: true, verified_at: Time.current)
+      else
+        owner_id = ActiveRecord::Type::Uuid.generate
+        User.insert_all!([ { id: owner_id, account_id: @account.id, identity_id: @identity.id,
+          role: "owner", name: @identity.email_address, active: true, verified_at: Time.current } ])
+        owner = @account.users.find(owner_id)
+      end
+      unless @account.users.exists?(role: "system")
+        User.insert_all!([ { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, role: "system", name: "System" } ])
+      end
+      @account.boards.find_each do |board|
+        unless Access.exists?(board: board, user: owner)
+          Access.insert_all!([ { id: ActiveRecord::Type::Uuid.generate, account_id: @account.id, board_id: board.id, user_id: owner.id } ])
+        end
+      end
+    end
+end
