--- /dev/null
+++ b/test/models/zip_file/blob_io_test.rb
@@ -0,0 +1,17 @@
+require "test_helper"
+
+class ZipFile::BlobIOTest < ActiveSupport::TestCase
+  test "reads storage ranges at ZIP64 sized offsets without downloading the blob" do
+    size = 600.gigabytes
+    blob = mock(byte_size: size)
+    blob.expects(:download_chunk).with((size - 4)...size).returns("tail")
+    blob.expects(:download).never
+    io = ZipFile::BlobIO.new(blob)
+    io.seek(-4, IO::SEEK_END)
+    assert_equal "tail", io.read(4)
+    assert_equal size, io.tell
+    assert_equal "", io.read(1)
+    assert_raises(ZipFile::Invalid) { io.seek(-1) }
+    assert_raises(ZipFile::Invalid) { io.seek(size + 1) }
+  end
+end
diff --git a/test/models/zip_file/reader_test.rb b/test/models/zip_file/reader_test.rb
new file mode 100644
