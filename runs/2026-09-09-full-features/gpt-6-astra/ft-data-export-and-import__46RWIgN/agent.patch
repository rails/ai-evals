--- /dev/null
+++ b/test/models/zip_file/reader_test.rb
@@ -0,0 +1,56 @@
+require "test_helper"
+
+class ZipFile::ReaderTest < ActiveSupport::TestCase
+  test "rejects corrupt file content" do
+    io = StringIO.new("".b)
+    zip = ZipFile::Writer.new(io)
+    zip.add_file("manifest.json", '{"format":"fizzy"}', compress: false)
+    zip.close
+    io.string.sub!("fizzy", "fuzzy")
+    assert_raises(ZipFile::Invalid) { ZipFile::Reader.new(io).json("manifest.json") }
+  end
+
+  test "rejects unsafe paths and compressed entries" do
+    [ [ "../manifest.json", false ], [ "manifest.json", true ] ].each do |path, compressed|
+      io = StringIO.new("".b)
+      zip = ZipFile::Writer.new(io)
+      zip.add_file(path, "{}", compress: compressed)
+      zip.close
+      assert_raises(ZipFile::Invalid) { ZipFile::Reader.new(io) }
+    end
+  end
+
+  test "rejects duplicate filenames" do
+    io = StringIO.new("".b)
+    zip = ZipFile::Writer.new(io)
+    zip.add_file("one.json", "{}", compress: false)
+    zip.add_file("two.json", "{}", compress: false)
+    zip.close
+    io.string.gsub!("two.json", "one.json")
+    assert_raises(ZipFile::Invalid) { ZipFile::Reader.new(io) }
+  end
+
+  test "preserves empty and whitespace-only files" do
+    io = StringIO.new("".b)
+    zip = ZipFile::Writer.new(io)
+    zip.add_file("empty.txt", "", compress: false)
+    zip.add_file("spaces.txt", " \n\t ", compress: false)
+    zip.close
+    reader = ZipFile::Reader.new(io)
+    [ [ "empty.txt", "" ], [ "spaces.txt", " \n\t " ] ].each do |name, content|
+      output = StringIO.new
+      reader.copy(name, output)
+      assert_equal content, output.string
+    end
+  end
+
+  test "writer tracks bytes and checksum for multipart uploads" do
+    io = StringIO.new("".b)
+    zip = ZipFile::Writer.new
+    zip.stream_to(io)
+    zip.add_file("manifest.json", "{}", compress: false)
+    zip.close
+    assert_equal io.size, zip.byte_size
+    assert_equal Digest::MD5.base64digest(io.string), zip.checksum
+  end
+end
