@@ -0,0 +1,57 @@
+require "test_helper"
+
+class Account::ExportTest < ActiveSupport::TestCase
+  test "generates a stored ZIP and emails a link that expires in one day" do
+    export = accounts(:"37s").exports.create!(user: users(:jason), kind: :account)
+    assert_enqueued_with(job: ActionMailer::MailDeliveryJob, args: [ "DataTransferMailer", "export_ready", "deliver_now", { args: [ export ] } ]) do
+      export.generate
+    end
+    assert export.completed?
+    assert export.archive.attached?
+    assert_in_delta 1.day.from_now, export.expires_at, 2.seconds
+    assert_equal export, Account::Export.find_signed(export.download_token, purpose: :download)
+    token = export.download_token
+    data = ZipFile::Reader.new(ZipFile::BlobIO.new(export.archive.blob))
+    assert_equal "account", data.json("manifest.json")["kind"]
+    assert_not_includes data.names, "attachments/#{export.archive.attachment.id}.json"
+    assert_includes DataTransferMailer.export_ready(export).text_part.body.decoded, "Your Fizzy"
+    travel 1.day + 1.second do
+      assert_not export.downloadable?
+      assert_nil Account::Export.find_signed(token, purpose: :download)
+      Account::ExportCleanupJob.perform_now(export)
+      assert_not export.reload.archive.attached?
+    end
+  end
+
+  test "does not export an account after an administrator loses their role" do
+    export = accounts(:"37s").exports.create!(user: users(:david), kind: :account)
+    assert_raises(ActiveRecord::RecordNotFound) { export.generate }
+    assert export.failed?
+    assert_not export.archive.attached?
+  end
+
+  test "S3 archive generation streams a complete ZIP with the correct checksum" do
+    require "aws-sdk-s3"
+    service = ActiveStorage::Blob.service
+    output = StringIO.new("".b)
+    ZipFile.stubs(:s3_service?).with(service).returns(true)
+    service.expects(:upload_stream).yields(output)
+    export = accounts(:"37s").exports.create!(user: users(:jason), kind: :account)
+    export.generate
+    assert export.completed?
+    assert_equal output.size, export.archive.blob.byte_size
+    assert_equal Digest::MD5.base64digest(output.string), export.archive.blob.checksum
+    assert_equal "account", ZipFile::Reader.new(output).json("manifest.json")["kind"]
+  end
+
+  test "later exports exclude previous export archives" do
+    account = accounts(:"37s")
+    first = account.exports.create!(user: users(:jason), kind: :account)
+    first.generate
+    second = account.exports.create!(user: users(:jason), kind: :account)
+    second.generate
+    copy = Account::DataTransfer::Reader.new(ZipFile::BlobIO.new(second.archive.blob), identity: identities(:jason)).restore
+    assert_equal account.cards.count, copy.cards.count
+    assert_not_includes ActiveStorage::Attachment.where(account: copy).pluck(:record_type), "Account::Export"
+  end
+end
