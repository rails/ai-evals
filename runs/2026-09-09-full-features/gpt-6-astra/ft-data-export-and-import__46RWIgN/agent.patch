+class Account::ExportsController < ApplicationController
+  before_action :ensure_admin, only: :create
+  skip_before_action :require_account, only: :show
+  allow_unauthenticated_access only: :show
+
+  def create
+    export = Current.account.exports.create!(user: Current.user, kind: :account)
+    Account::ExportJob.perform_later(export)
+    redirect_to account_settings_path, notice: "We'll email you a download link when your export is ready."
+  end
+
+  def show
+    export = Account::Export.find_signed(params[:id], purpose: :download)
+    raise ActiveRecord::RecordNotFound unless export
+    if export.downloadable?
+      expires_in 0, private: true
+      ActiveStorage::Current.set(url_options: { protocol: request.protocol, host: request.host, port: request.port, script_name: nil }) do
+        redirect_to export.archive.url(expires_in: [ export.expires_at - Time.current, 5.minutes ].min,
+          disposition: :attachment), allow_other_host: true
+      end
+    else
+      head :gone
+    end
+  end
+end
diff --git a/app/controllers/account/imports_controller.rb b/app/controllers/account/imports_controller.rb
