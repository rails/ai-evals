diff --git a/app/models/zip_file/blob_io.rb b/app/models/zip_file/blob_io.rb
new file mode 100644
index 0000000..7a7d901
--- /dev/null
+++ b/app/models/zip_file/blob_io.rb
@@ -0,0 +1,37 @@
+# Seekable range reads work on both Disk and S3 without downloading an entire
+# account ZIP to a worker's local disk. The ZIP reader only needs the directory
+# and the entries currently being restored.
+class ZipFile::BlobIO
+  attr_reader :size, :pos
+  alias_method :tell, :pos
+
+  def initialize(blob)
+    @blob = blob
+    @size = blob.byte_size
+    @pos = 0
+  end
+
+  def seek(offset, whence = IO::SEEK_SET)
+    position = case whence
+    when IO::SEEK_SET then offset
+    when IO::SEEK_CUR then pos + offset
+    when IO::SEEK_END then size + offset
+    end
+    raise ZipFile::Invalid, "Invalid ZIP offset" unless position&.between?(0, size)
+    @pos = position
+    0
+  end
+
+  def read(length = nil)
+    length ||= size - pos
+    raise ZipFile::Invalid, "Invalid ZIP read" if length.negative?
+    length = [ length, size - pos ].min
+    if length.zero?
+      "".b
+    else
+      data = @blob.download_chunk(pos...(pos + length))
+      @pos += data.bytesize
+      data
+    end
+  end
+end
diff --git a/app/models/zip_file/reader.rb b/app/models/zip_file/reader.rb
new file mode 100644
index 0000000..fc62b73
--- /dev/null
+++ b/app/models/zip_file/reader.rb
@@ -0,0 +1,61 @@
+# ZIP entries are streamed, never extracted to user-controlled filesystem paths.
+class ZipFile::Reader
+  CHUNK_SIZE = 1.megabyte
+  MAX_METADATA_SIZE = 16.megabytes
+
+  def initialize(io)
+    @io = io
+    entries = ZipKit::FileReader.read_zip_structure(io: BoundedIO.new(io))
+    @entries = entries.index_by(&:filename)
+    raise ZipFile::Invalid, "Duplicate ZIP entries" unless @entries.size == entries.size
+    @entries.each_value do |entry|
+      unless entry.storage_mode == 0 && entry.compressed_size == entry.uncompressed_size &&
+          entry.compressed_data_offset >= 0 && entry.compressed_data_offset + entry.compressed_size <= io.size &&
+          (entry.gp_flags & 1).zero? && entry.filename.match?(%r{\A[a-zA-Z0-9_./-]+\z}) && !entry.filename.split("/").include?("..")
+        raise ZipFile::Invalid, "Unsupported or invalid ZIP entry"
+      end
+    end
+  rescue ZipKit::FileReader::ReadError, ZipKit::FileReader::MissingEOCD, ZipKit::FileReader::UnsupportedFeature, EOFError, RangeError, ArgumentError => error
+    raise ZipFile::Invalid, "Invalid ZIP archive: #{error.message}"
+  end
+
+  def names
+    @entries.keys
+  end
+
+  def json(name)
+    entry = @entries.fetch(name) { raise ZipFile::Invalid, "Missing #{name}" }
+    raise ZipFile::Invalid, "Metadata entry is too large" if entry.uncompressed_size > MAX_METADATA_SIZE
+    output = StringIO.new
+    copy(name, output)
+    JSON.parse(output.string)
+  rescue JSON::ParserError
+    raise ZipFile::Invalid, "Invalid JSON in #{name}"
+  end
+
+  def copy(name, output)
+    entry = @entries.fetch(name) { raise ZipFile::Invalid, "Missing #{name}" }
+    extractor = entry.extractor_from(@io)
+    size = crc = 0
+    until extractor.eof?
+      chunk = extractor.extract(CHUNK_SIZE)
+      raise ZipFile::Invalid, "Truncated ZIP entry: #{name}" if chunk.nil? || chunk.empty?
+      size += chunk.bytesize
+      crc = Zlib.crc32(chunk, crc)
+      output.write(chunk)
+    end
+    unless size == entry.uncompressed_size && crc == entry.crc32
+      raise ZipFile::Invalid, "Corrupt ZIP entry: #{name}"
+    end
+  end
+
+  # ZipKit reads the central directory in one operation. Bound that read, including
+  # malformed offsets, without limiting the size of the archive or its file entries.
+  class BoundedIO < SimpleDelegator
+    def read(length = nil, *arguments)
+      length ||= size - tell
+      raise ZipFile::Invalid, "ZIP directory is too large" unless length.between?(0, 128.megabytes)
+      super(length, *arguments)
+    end
+  end
+end
