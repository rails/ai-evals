@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Account::ImportTest < ActiveSupport::TestCase
+  test "imports asynchronously into a new account and notifies the identity" do
+    export = accounts(:"37s").exports.create!(user: users(:jason), kind: :account)
+    export.generate
+    Current.without_account do
+      import = Account::Import.create!(identity: identities(:david), archive: { io: StringIO.new(export.archive.download), filename: "account.zip" })
+      assert_difference "Account.count", 1 do
+        assert_enqueued_with(job: ActionMailer::MailDeliveryJob, args: [ "DataTransferMailer", "import_finished", "deliver_now", { args: [ import ] } ]) do
+          import.restore
+        end
+      end
+      assert import.completed?
+      assert_equal "owner", import.account.users.find_by!(identity: identities(:david)).role
+      assert_not import.archive.attached?
+      assert_includes DataTransferMailer.import_finished(import).text_part.body.decoded, "Your Fizzy account has been imported"
+      assert_no_difference "Account.count" do
+        import.restore
+      end
+    end
+  end
+
+  test "invalid ZIP sends a failure reason and leaves no account or files" do
+    Current.without_account do
+      import = Account::Import.create!(identity: identities(:david), archive: { io: StringIO.new("not a zip"), filename: "bad.zip" })
+      assert_no_difference "Account.count" do
+        assert_enqueued_with(job: ActionMailer::MailDeliveryJob) { import.restore }
+      end
+      assert import.failed?
+      assert_nil import.account
+      assert import.error.present?
+      assert_not import.archive.attached?
+      assert_includes DataTransferMailer.import_finished(import).text_part.body.decoded, "Your Fizzy import failed"
+    end
+  end
+end
diff --git a/test/models/zip_file/blob_io_test.rb b/test/models/zip_file/blob_io_test.rb
new file mode 100644
