diff --git a/test/models/account/data_transfer_test.rb b/test/models/account/data_transfer_test.rb
new file mode 100644
index 0000000..ad0a2e7
--- /dev/null
+++ b/test/models/account/data_transfer_test.rb
@@ -0,0 +1,115 @@
+require "test_helper"
+
+class Account::DataTransferTest < ActiveSupport::TestCase
+  test "account archive round trips boards cards comments people and rich text files" do
+    account = accounts(:"37s")
+    with_current_user(:david) do
+      blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("a file with useful content"), filename: "notes.txt", content_type: "text/plain")
+      cards(:logo).update!(description: ActionText::Content.new("<p>Keep this</p>").append_attachables([ blob, users(:david) ]))
+      comment_blob = ActiveStorage::Blob.create_and_upload!(io: StringIO.new("comment attachment"), filename: "comment.txt", content_type: "text/plain")
+      cards(:logo).comments.create!(creator: users(:david), body: ActionText::Content.new("<p>A comment</p>").append_attachables([ comment_blob ]))
+      cards(:logo).image.attach(io: StringIO.new("picture bytes"), filename: "picture.png", content_type: "image/png")
+    end
+
+    with_archive(account) do |file|
+      archive = ZipFile::Reader.new(file)
+      card_data = archive.json("cards/#{cards(:logo).id}.json")
+      assert_equal cards(:logo).comments.count, card_data.fetch("comments").count
+
+      copy = Account::DataTransfer::Reader.new(file, identity: identities(:jason)).restore
+      assert_not_equal account.id, copy.id
+      assert_not_equal account.external_account_id, copy.external_account_id
+      assert_equal account.boards.count, copy.boards.count
+      assert_equal account.cards.count, copy.cards.count
+      assert_equal account.users.count, copy.users.count
+      [ Event, Mention, User::Settings, Assignment, Closure, Tagging, Reaction, Entropy ].each do |model|
+        assert_equal model.where(account: account).count, model.where(account: copy).count, model.name
+      end
+      Access.where(account: account).each do |access|
+        board = copy.boards.find_by!(name: access.board.name)
+        user = copy.users.find_by!(name: access.user.name)
+        assert Access.exists?(board: board, user: user)
+      end
+      assert_equal Comment.where(account: account).count, Comment.where(account: copy).count
+      card = copy.cards.find_by!(number: cards(:logo).number)
+      assert_equal cards(:logo).title, card.title
+      assert_equal "picture bytes", card.image.download
+      assert_includes card.description.to_plain_text, "Keep this"
+      assert_equal "a file with useful content", card.description.embeds.first.download
+      assert_equal copy.id, card.description.body.attachables.grep(User).first.account_id
+      assert_equal "comment attachment", card.comments.order(:created_at).last.body.embeds.first.download
+      assert_equal copy.id, card.creator.account_id
+      assert_equal "owner", copy.users.find_by!(identity: identities(:jason)).role
+    end
+  end
+
+  test "personal archives exclude inaccessible cards and cannot be imported" do
+    user = users(:david)
+    private_board = accounts(:"37s").boards.create!(name: "Secret", creator: users(:jason), all_access: false)
+    secret = private_board.cards.create!(title: "Secret", creator: users(:jason), status: :drafted)
+    other_draft = cards(:logo).board.cards.create!(title: "Other draft", creator: users(:jason), status: :drafted)
+    with_archive(accounts(:"37s"), user: user) do |file|
+      names = ZipFile::Reader.new(file).names
+      assert_includes names, "cards/#{cards(:logo).id}.json"
+      assert_not_includes names, "cards/#{secret.id}.json"
+      assert_not_includes names, "cards/#{other_draft.id}.json"
+      assert_no_difference "Account.count" do
+        assert_raises(ZipFile::Invalid) { Account::DataTransfer::Reader.new(file, identity: identities(:david)).restore }
+      end
+    end
+  end
+
+  test "a failure after restoring files rolls back all records and deletes uploaded files" do
+    cards(:logo).image.attach(io: StringIO.new("picture"), filename: "picture.png", content_type: "image/png")
+    with_archive(accounts(:"37s")) do |file|
+      counts = [ Account, User, Board, Card, Comment, Identity, ActiveStorage::Blob, ActiveStorage::Attachment ].to_h { |model| [ model, model.count ] }
+      service = ActiveStorage::Blob.service
+      service.expects(:delete).at_least_once
+      assert_raises(RuntimeError) do
+        Account::DataTransfer::Reader.new(file, identity: identities(:jason)).restore { raise "Simulated failure" }
+      end
+      counts.each { |model, count| assert_equal count, model.count, model.name }
+    end
+  end
+
+  test "rejects a reference into another account without leaving records behind" do
+    with_archive(accounts(:"37s")) do |file|
+      original = ZipFile::Reader.new(file)
+      malicious = StringIO.new("".b)
+      writer = ZipFile::Writer.new(malicious)
+      original.names.each do |name|
+        data = original.json(name)
+        if name == "cards/#{cards(:logo).id}.json"
+          data["attributes"]["creator_id"] = users(:mike).id
+        end
+        writer.add_file(name, data.to_json, compress: false)
+      end
+      writer.close
+      assert_no_difference [ "Account.count", "User.count", "Card.count" ] do
+        assert_raises(ZipFile::Invalid) do
+          Account::DataTransfer::Reader.new(malicious, identity: identities(:jason)).restore
+        end
+      end
+    end
+  end
+
+  test "repeated imports receive different record IDs" do
+    with_archive(accounts(:"37s")) do |file|
+      first = Account::DataTransfer::Reader.new(file, identity: identities(:jason)).restore
+      second = Account::DataTransfer::Reader.new(file, identity: identities(:jason)).restore
+      assert_not_equal first.id, second.id
+      assert_empty first.cards.ids & second.cards.ids
+    end
+  end
+
+  private
+    def with_archive(account, user: nil)
+      Tempfile.create([ "round-trip", ".zip" ], binmode: true) do |file|
+        zip = ZipFile::Writer.new(file)
+        Account::DataTransfer::Writer.new(account, user: user).write(zip)
+        zip.close
+        file.rewind
+        yield file
+      end
+    end
+end
