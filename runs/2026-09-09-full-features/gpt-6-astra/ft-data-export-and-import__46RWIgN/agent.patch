@@ -0,0 +1,19 @@
+class Account::ImportsController < ApplicationController
+  disallow_account_scope
+
+  def new
+    @import = Account::Import.new
+  end
+
+  def create
+    upload = params.expect(import: [ :archive ])[:archive]
+    raise ActionController::BadRequest if upload.present? && !upload.is_a?(ActionDispatch::Http::UploadedFile)
+    @import = Account::Import.new(identity: Current.identity, archive: upload)
+    if @import.save
+      Account::ImportJob.perform_later(@import)
+      redirect_to new_account_import_path, notice: "Your import has started. We'll email you when it's finished."
+    else
+      render :new, status: :unprocessable_entity
+    end
+  end
+end
