diff --git a/app/models/account/data_transfer/writer.rb b/app/models/account/data_transfer/writer.rb
new file mode 100644
index 0000000..54819f5
--- /dev/null
+++ b/app/models/account/data_transfer/writer.rb
@@ -0,0 +1,83 @@
+class Account::DataTransfer::Writer
+  include Account::DataTransfer
+
+  def initialize(account, user: nil)
+    @account, @user = account, user
+    @blobs = {}
+  end
+
+  def write(zip)
+    @zip = zip
+    write_json "manifest.json", {
+      format: "fizzy", version: VERSION, kind: @user ? "cards" : "account",
+      account: @account.attributes.slice("id", "name", "created_at", "updated_at", "cards_count")
+    }
+    RECORD_TYPES.each do |directory, model|
+      scope_for(model).find_each do |record|
+        data = { "attributes" => record.attributes }
+        if record.is_a?(User)
+          data["email_address"] = record.identity&.email_address
+          data["attachable_sgid"] = record.attachable_sgid
+          data["attributes"].delete("identity_id")
+        elsif record.is_a?(Card)
+          data["description"] = record.description.to_s
+          data["comments"] = record.comments.chronologically.map do |comment|
+            comment.attributes.merge("body" => comment.body.to_s)
+          end
+        elsif record.is_a?(::ActiveStorage::Attachment)
+          @blobs[record.blob_id] = true
+        end
+        write_json "#{directory}/#{record.id}.json", data
+      end
+    end
+    @blobs.each_key do |id|
+      blob = ::ActiveStorage::Blob.find(id)
+      write_json "blobs/#{id}.json", blob.attributes.slice("id", "filename", "content_type", "byte_size", "checksum").merge("attachable_sgid" => blob.attachable_sgid)
+      @zip.add_file("files/#{id}", compress: false) do |sink|
+        blob.download { |chunk| sink << chunk }
+      end
+    end
+  end
+
+  private
+    def scope_for(model)
+      scope = model.where(account_id: @account.id)
+      if model == ::ActiveStorage::Attachment
+        scope = scope.where(record_type: %w[User Board Card Comment ActionText::RichText])
+      elsif model == ::ActionText::RichText
+        scope = scope.where(record_type: %w[Board Card Comment])
+      end
+      return scope unless @user
+
+      case model.name
+      when "Card" then cards
+      when "Board" then @user.boards
+      when "Column" then scope.where(board_id: @user.boards.select(:id))
+      when "Comment" then comments
+      when "ActionText::RichText" then rich_texts
+      when "ActiveStorage::Attachment"
+        scope.where(record: cards).or(scope.where(record: comments)).or(scope.where(record: rich_texts))
+      when "Reaction"
+        scope.where(reactable: cards).or(scope.where(reactable: comments))
+      when "User", "User::Settings", "Access", "Entropy", "Pin", "Watch", "Event", "Mention" then scope.none
+      when "Tag" then scope.where(id: Tagging.where(card_id: cards.select(:id)).select(:tag_id))
+      else scope.where(card_id: cards.select(:id))
+      end
+    end
+
+    def cards
+      @cards ||= @user.accessible_cards.where(status: "published").or(@user.accessible_cards.where(creator: @user))
+    end
+
+    def comments
+      Comment.where(card_id: cards.select(:id))
+    end
+
+    def rich_texts
+      ::ActionText::RichText.where(record: cards).or(::ActionText::RichText.where(record: comments))
+    end
+
+    def write_json(name, data)
+      @zip.add_file(name, compress: false) { |sink| sink << data.to_json }
+    end
+end
diff --git a/app/models/account/export.rb b/app/models/account/export.rb
new file mode 100644
index 0000000..8f2e97a
--- /dev/null
+++ b/app/models/account/export.rb
@@ -0,0 +1,37 @@
+class Account::Export < ApplicationRecord
+  belongs_to :account
+  belongs_to :user
+  has_one_attached :archive
+
+  enum :kind, %w[ account cards ].index_by(&:itself), suffix: true
+  enum :status, %w[ pending completed failed ].index_by(&:itself)
+
+  def generate
+    begin
+      with_lock do
+        return unless pending?
+        raise ActiveRecord::RecordNotFound unless user.active? && account.active? && user.account_id == account_id
+        raise ActiveRecord::RecordNotFound if account_kind? && !user.admin?
+
+        ZipFile.create_for(archive, filename: "fizzy-#{kind}-#{id}.zip") do |zip|
+          Account::DataTransfer::Writer.new(account, user: cards_kind? ? user : nil).write(zip)
+        end
+        update!(status: :completed, expires_at: 1.day.from_now)
+      end
+    rescue StandardError
+      archive.purge
+      update!(status: :failed)
+      raise
+    end
+    Account::ExportCleanupJob.set(wait_until: expires_at).perform_later(self)
+    DataTransferMailer.export_ready(self).deliver_later
+  end
+
+  def download_token
+    signed_id(purpose: :download, expires_at: expires_at)
+  end
+
+  def downloadable?
+    completed? && expires_at&.future? && archive.attached?
+  end
+end
diff --git a/app/models/account/import.rb b/app/models/account/import.rb
new file mode 100644
index 0000000..4aaa28f
--- /dev/null
+++ b/app/models/account/import.rb
@@ -0,0 +1,38 @@
+class Account::Import < ApplicationRecord
+  belongs_to :identity
+  belongs_to :account, optional: true
+  has_one_attached :archive
+
+  enum :status, %w[ pending completed failed ].index_by(&:itself)
+
+  before_validation -> { archive.blob.account_import_archive = true if archive.attached? }, on: :create
+
+  validates :archive, presence: true, on: :create
+
+  def restore
+    return unless pending?
+
+    with_lock do
+      return unless pending?
+
+      begin
+        file = ZipFile::BlobIO.new(archive.blob)
+        Account::DataTransfer::Reader.new(file, identity: identity).restore do |account|
+          update!(account: account, status: :completed)
+        end
+      rescue StandardError => error
+        Rails.logger.error "Account import #{id} failed: #{error.class}: #{error.message}"
+        reason = case error
+        when ZipFile::Invalid then error.message
+        when KeyError, TypeError, NoMethodError then "The archive contains incomplete or invalid records"
+        when ActiveRecord::ActiveRecordError then "The archive contains invalid or conflicting records"
+        else "The archive could not be read or its files could not be stored. Please try again"
+        end
+        update!(account: nil, status: :failed, error: reason.truncate(1000))
+      end
+    end
+
+    archive.purge
+    DataTransferMailer.import_finished(self).deliver_later
+  end
+end
