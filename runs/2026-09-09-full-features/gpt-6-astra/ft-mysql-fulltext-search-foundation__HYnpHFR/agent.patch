diff --git a/test/models/card/searchable_test.rb b/test/models/card/searchable_test.rb
new file mode 100644
index 0000000..cd3a61b
--- /dev/null
+++ b/test/models/card/searchable_test.rb
@@ -0,0 +1,76 @@
+require "test_helper"
+
+class Card::SearchableTest < ActiveSupport::TestCase
+  setup do
+    Current.session = sessions(:david)
+  end
+
+  test "matches words across fields and comments" do
+    cards(:logo).update! title: "Searchalpha", description: "Searchbeta"
+    cards(:logo).comments.create! body: "Searchgamma"
+    cards(:logo).comments.create! body: "Searchdelta"
+    cards(:layout).update! title: "Searchalpha"
+
+    assert_equal [ cards(:logo) ], Card.search(" searchALPHA searchbeta searchgamma searchdelta ")
+  end
+
+  test "searches readable rich text instead of markup" do
+    cards(:logo).update! description: '<p><a href="https://markupneedle.example">search<strong>needle</strong> &amp; partners</a></p>'
+    cards(:layout).comments.create! body: "<p>Search<strong>needle</strong> &amp; partners</p>"
+
+    assert_equal [ cards(:logo), cards(:layout) ].sort_by(&:id), Card.search("searchneedle & partners").sort_by(&:id)
+    assert_empty Card.search("markupneedle")
+  end
+
+  test "reflects edits and deletion immediately" do
+    cards(:logo).update! description: "searchneedle"
+    comment = cards(:layout).comments.create! body: "searchneedle"
+    assert_equal 2, Card.search("searchneedle").count
+
+    cards(:logo).update! description: "replacement"
+    comment.update! body: "replacement"
+    assert_empty Card.search("searchneedle")
+
+    comment.update! body: "searchneedle"
+    assert_equal [ cards(:layout) ], Card.search("searchneedle")
+    comment.destroy!
+    assert_empty Card.search("searchneedle")
+
+    cards(:logo).update! title: "searchneedle"
+    assert_equal [ cards(:logo) ], Card.search("searchneedle")
+    cards(:logo).destroy!
+    assert_empty Card.search("searchneedle")
+  end
+
+  test "does not let SQL wildcards or quotes widen a search" do
+    cards(:logo).update! title: "100%_ wow! 'quoted'"
+    cards(:layout).update! title: "100xx wowz"
+
+    assert_equal [ cards(:logo) ], Card.search("100%_")
+    assert_equal [ cards(:logo) ], Card.search("wow!")
+    assert_equal [ cards(:logo) ], Card.search("'quoted'")
+    assert_empty Card.search("' OR 1=1 --")
+  end
+
+  test "search stays within its caller's scope" do
+    cards(:logo).update! title: "searchneedle"
+    cards(:layout).comments.create! body: "searchneedle"
+    cards(:text).update! description: "searchneedle"
+
+    assert_empty boards(:private).cards.search("searchneedle")
+    assert_equal [ cards(:text) ], Card.where(id: cards(:text)).search("searchneedle")
+  end
+
+  test "orders ties deterministically and excludes drafts" do
+    [ cards(:logo), cards(:layout) ].each do |card|
+      card.update! title: "searchneedle", created_at: Time.current.beginning_of_day
+    end
+    cards(:text).update! title: "searchneedle", status: :drafted
+
+    assert_equal [ cards(:logo), cards(:layout) ].sort_by(&:id).reverse, Card.search("searchneedle")
+  end
+
+  test "searches pre-existing rich text" do
+    assert_includes Card.search("overflowing"), cards(:layout)
+  end
+end
