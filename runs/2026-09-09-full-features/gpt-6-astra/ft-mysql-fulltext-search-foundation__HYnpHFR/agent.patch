@@ -19,6 +19,17 @@ class Comment < ApplicationRecord
 
   delegate :publicly_accessible?, :accessible_to?, :board, :watch_by, to: :card
 
+  def self.search(query)
+    terms = query.to_s.split
+    bodies = ActionText::RichText.where(record_type: "Comment", name: "body")
+    matches = terms.reduce(bodies.none) do |matches, term|
+      pattern = "%#{sanitize_sql_like(term.downcase, "!")}%"
+      matches.or(bodies.where("LOWER(plain_text_body) LIKE ? ESCAPE '!'", pattern))
+    end
+
+    where(id: matches.select(:record_id))
+  end
+
   def to_partial_path
     "cards/#{super}"
   end
