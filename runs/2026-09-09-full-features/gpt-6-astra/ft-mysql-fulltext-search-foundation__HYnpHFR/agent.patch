@@ -0,0 +1,10 @@
+class SearchesController < ApplicationController
+  def show
+    @query = params[:q].to_s.strip
+    @terms = @query.split
+    cards = Current.user.accessible_cards.search(@query).preload(:board, :rich_text_description)
+    set_page_and_extract_portion_from cards
+    @comments_by_card = Comment.search(@query).where(card_id: @page.records.map(&:id))
+      .chronologically.with_rich_text_body.group_by(&:card_id)
+  end
+end
