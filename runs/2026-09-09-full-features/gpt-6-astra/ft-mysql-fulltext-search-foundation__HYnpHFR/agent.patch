diff --git a/app/models/card/searchable.rb b/app/models/card/searchable.rb
new file mode 100644
index 0000000..26e5423
--- /dev/null
+++ b/app/models/card/searchable.rb
@@ -0,0 +1,23 @@
+module Card::Searchable
+  extend ActiveSupport::Concern
+
+  class_methods do
+    def search(query)
+      terms = query.to_s.split
+
+      if terms.any?
+        terms.reduce(published) do |cards, term|
+          pattern = "%#{sanitize_sql_like(term.downcase, "!")}%"
+          descriptions = ActionText::RichText.where(record_type: "Card", name: "description")
+            .where("LOWER(plain_text_body) LIKE ? ESCAPE '!'", pattern)
+
+          cards.where("LOWER(cards.title) LIKE ? ESCAPE '!'", pattern)
+            .or(cards.where(id: descriptions.select(:record_id)))
+            .or(cards.where(id: Comment.search(term).select(:card_id)))
+        end.reverse_chronologically
+      else
+        none
+      end
+    end
+  end
+end
diff --git a/app/models/comment.rb b/app/models/comment.rb
