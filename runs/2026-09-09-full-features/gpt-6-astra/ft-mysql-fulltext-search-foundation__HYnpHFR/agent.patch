+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,17 @@
+module SearchesHelper
+  def highlight_search_matches(text, terms)
+    if terms.any?
+      parts = text.to_s.split(Regexp.new("(#{Regexp.union(terms).source})", Regexp::IGNORECASE))
+      safe_join parts.each_with_index.map { |part, index| index.odd? ? tag.mark(part) : part }
+    else
+      h(text)
+    end
+  end
+
+  def search_excerpt(text, terms)
+    text = text.to_s
+    term = terms.find { |term| text.downcase.include?(term.downcase) }
+    snippet = term ? excerpt(text, term, radius: 120) : truncate(text, length: 240)
+    highlight_search_matches(snippet, terms)
+  end
+end
