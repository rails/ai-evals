diff --git a/test/controllers/searches_controller_test.rb b/test/controllers/searches_controller_test.rb
new file mode 100644
index 0000000..800fd5a
--- /dev/null
+++ b/test/controllers/searches_controller_test.rb
@@ -0,0 +1,126 @@
+require "test_helper"
+
+class SearchesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "finds titles descriptions and comments once per card newest first" do
+    cards(:logo).update_columns title: "A Searchneedle title", created_at: 3.days.ago
+    cards(:layout).update! description: "<p>A SEARCHNEEDLE description</p>", created_at: 2.days.ago
+    cards(:text).update! created_at: 1.day.ago
+    2.times { cards(:text).comments.create! body: "A searchneedle comment", creator: users(:kevin) }
+
+    get search_path, params: { q: "searchneedle" }
+
+    assert_response :success
+    assert_equal [ cards(:text), cards(:layout), cards(:logo) ].map { |card| card_path(card) }, result_paths
+    assert_select ".search-result__title a[data-turbo-frame='_top']", count: 3
+    assert_select "mark", text: "Searchneedle"
+    assert_select "mark", text: "SEARCHNEEDLE"
+    assert_select "mark", text: "searchneedle"
+  end
+
+  test "excludes drafts including matches in their comments" do
+    cards(:logo).comments.create! body: "searchneedle comment", creator: users(:kevin)
+    cards(:logo).update! status: :drafted
+    cards(:layout).update! title: "searchneedle", description: "searchneedle", status: :drafted
+
+    get search_path, params: { q: "searchneedle" }
+
+    assert_response :success
+    assert_empty result_paths
+  end
+
+  test "checks current board access on every request" do
+    cards(:logo).update_columns title: "searchneedle"
+    get search_path, params: { q: "searchneedle" }
+    assert_equal [ card_path(cards(:logo)) ], result_paths
+
+    boards(:writebook).update! all_access: false
+    boards(:writebook).accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "searchneedle" }
+    assert_response :success
+    assert_empty result_paths
+  end
+
+  test "does not search other accounts or inaccessible boards" do
+    cards(:radio).update_columns title: "searchneedle"
+    cards(:logo).comments.create! body: "searchneedle secret", creator: users(:kevin)
+    cards(:logo).update_column :board_id, boards(:private).id
+    logout_and_sign_in_as :david
+
+    get search_path, params: { q: "searchneedle" }
+
+    assert_response :success
+    assert_empty result_paths
+    assert_no_match "searchneedle secret", response.body
+  end
+
+  test "blank and missing queries do not list cards" do
+    [ nil, "", "  " ].each do |query|
+      get search_path, params: { q: query }
+      assert_response :success
+      assert_empty result_paths
+    end
+  end
+
+  test "escapes content and treats query metacharacters literally" do
+    cards(:logo).update_columns title: "<img src=x onerror=alert(1)> 100%_ [needle]"
+
+    get search_path, params: { q: "100%_ [needle]" }
+
+    assert_response :success
+    assert_equal [ card_path(cards(:logo)) ], result_paths
+    assert_select ".search-result img", count: 0
+    assert_select ".search-result mark", text: "100%_"
+    assert_select ".search-result mark", text: "[needle]"
+
+    get search_path, params: { q: "absent%_" }
+    assert_empty result_paths
+  end
+
+  test "comments follow the card's current board access" do
+    cards(:logo).comments.create! body: "searchneedle", creator: users(:kevin)
+    get search_path, params: { q: "searchneedle" }
+    assert_equal [ card_path(cards(:logo)) ], result_paths
+
+    with_current_user(:kevin) { cards(:logo).move_to boards(:private) }
+    boards(:private).accesses.revoke_from users(:kevin)
+
+    get search_path, params: { q: "searchneedle" }
+    assert_response :success
+    assert_empty result_paths
+  end
+
+  test "pagination preserves the query and newest first order" do
+    with_current_user(:kevin) do
+      30.times do |index|
+        boards(:writebook).cards.create! title: "searchneedle #{index}", status: :published, created_at: index.minutes.ago
+      end
+    end
+    expected = users(:kevin).accessible_cards.search("searchneedle").map { |card| card_path(card) }
+
+    get search_path, params: { q: "searchneedle" }
+    first_page = result_paths
+    assert first_page.size < expected.size
+    next_page = css_select("a.pagination-link").sole["href"]
+    assert_includes next_page, "q=searchneedle"
+
+    get next_page
+    assert_response :success
+    assert_equal expected, first_page + result_paths
+  end
+
+  test "requires authentication" do
+    sign_out
+    get search_path, params: { q: "logo" }
+    assert_response :redirect
+  end
+
+  private
+    def result_paths
+      css_select(".search-result__title a").map { |link| link["href"] }
+    end
+end
