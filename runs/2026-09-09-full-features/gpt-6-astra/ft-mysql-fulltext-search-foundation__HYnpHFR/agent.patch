diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..043390e
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,35 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title">Search</h1>
+<% end %>
+
+<section class="panel panel--wide center margin-block">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @query, placeholder: "Search cards", class: "input full-width", autofocus: true %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <% if @terms.empty? %>
+    <p>Search card titles, descriptions, and comments.</p>
+  <% elsif @page.records.empty? %>
+    <p>No cards found.</p>
+  <% else %>
+    <%= with_manual_pagination :search_results, @page do %>
+      <% @page.records.each do |card| %>
+        <article class="search-result margin-block txt-align-start">
+          <h2 class="search-result__title"><%= link_to highlight_search_matches(card.title, @terms), card_path(card), data: { turbo_frame: "_top" } %></h2>
+          <p class="txt-small"><%= card.board.name %> &middot; <%= local_datetime_tag card.created_at %></p>
+          <% if card.description.present? %>
+            <p><%= search_excerpt(card.description.to_plain_text, @terms) %></p>
+          <% end %>
+          <% @comments_by_card.fetch(card.id, []).each do |comment| %>
+            <blockquote><%= search_excerpt(comment.body.to_plain_text, @terms) %></blockquote>
+          <% end %>
+        </article>
+      <% end %>
+    <% end %>
+  <% end %>
+</section>
