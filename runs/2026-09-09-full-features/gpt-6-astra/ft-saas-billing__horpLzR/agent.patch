diff --git a/saas/test/controllers/account/billings_controller_test.rb b/saas/test/controllers/account/billings_controller_test.rb
new file mode 100644
index 0000000..9b2274d
--- /dev/null
+++ b/saas/test/controllers/account/billings_controller_test.rb
@@ -0,0 +1,101 @@
+require "test_helper"
+
+class Account::BillingsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @old_env = ENV.to_h.slice("STRIPE_SECRET_KEY", "STRIPE_MONTHLY_V1_PRICE_ID", "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+    ENV["STRIPE_SECRET_KEY"] = "sk_test_local"
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_plus"
+    sign_in_as :mike
+    @account = accounts(:initech)
+    integration_session.default_url_options[:script_name] = @account.slug
+  end
+
+  teardown do
+    %w[ STRIPE_SECRET_KEY STRIPE_MONTHLY_V1_PRICE_ID STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID ].each { |key| ENV[key] = @old_env[key] }
+  end
+
+  test "admins see their plan and approved prices" do
+    get account_settings_path
+    assert_response :success
+    assert_select "h2", text: "Plan: Free"
+    assert_select "a", text: "Upgrade"
+    get saas.account_billing_path
+    assert_response :success
+    assert_match "Unlimited — $20/month", response.body
+    assert_match "Unlimited+ — $25/month", response.body
+    assert_match "500 GB", response.body
+  end
+
+  test "checkout creates a customer and uses a server selected price" do
+    Stripe::Customer.expects(:create).with(
+      { email: @account.owner_email, name: @account.name, metadata: { account_id: @account.id } },
+      { idempotency_key: "fizzy-account-#{@account.id}", api_key: "sk_test_local" }
+    ).returns(Stripe::Customer.construct_from(id: "cus_new"))
+    Stripe::Checkout::Session.expects(:create).with do |params, options|
+      assert_equal "subscription", params[:mode]
+      assert_equal "cus_new", params[:customer]
+      assert_equal [ { price: "price_plus", quantity: 1 } ], params[:line_items]
+      assert_equal @account.id, params[:subscription_data][:metadata][:account_id]
+      assert_includes params[:success_url], "#{@account.slug}/account/billing"
+      assert_equal params[:success_url], params[:cancel_url]
+      assert_equal "sk_test_local", options[:api_key]
+      true
+    end.returns(Stripe::Checkout::Session.construct_from(url: "https://checkout.stripe.com/test"))
+    post saas.account_billing_checkout_path, params: { plan_key: "unlimited_plus", price: "untrusted", customer: "cus_other" }
+    assert_redirected_to "https://checkout.stripe.com/test"
+    assert_equal "cus_new", @account.reload.subscription.stripe_customer_id
+    assert_equal "free", @account.billing_plan.key
+  end
+
+  test "existing paid customers go to the portal instead of buying a duplicate subscription" do
+    @account.create_subscription!(stripe_customer_id: "cus_existing", plan_key: "unlimited", status: "active")
+    Stripe::Checkout::Session.expects(:create).never
+    Stripe::BillingPortal::Session.expects(:create).with do |params, options|
+      params[:customer] == "cus_existing" && params[:return_url].include?(@account.slug) && options[:api_key] == "sk_test_local"
+    end.returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/test"))
+    post saas.account_billing_checkout_path, params: { plan_key: "unlimited_plus" }
+    assert_redirected_to "https://billing.stripe.com/test"
+  end
+
+  test "portal is scoped to the current account" do
+    @account.create_subscription!(stripe_customer_id: "cus_existing")
+    Stripe::BillingPortal::Session.expects(:create).with do |params, _|
+      params[:customer] == "cus_existing"
+    end.returns(Stripe::BillingPortal::Session.construct_from(url: "https://billing.stripe.com/test"))
+    post saas.account_billing_portal_path, params: { customer: "cus_other" }
+    assert_redirected_to "https://billing.stripe.com/test"
+  end
+
+  test "invalid plans never contact Stripe" do
+    Stripe::Customer.expects(:create).never
+    Stripe::Checkout::Session.expects(:create).never
+    [ "free", "unknown", "price_plus" ].each do |key|
+      post saas.account_billing_checkout_path, params: { plan_key: key }
+      assert_response :unprocessable_entity
+    end
+  end
+
+  test "members cannot manage billing" do
+    users(:mike).update!(role: :member)
+    Stripe::Customer.expects(:create).never
+    get saas.account_billing_path
+    assert_response :forbidden
+    post saas.account_billing_checkout_path, params: { plan_key: "unlimited" }
+    assert_response :forbidden
+    post saas.account_billing_portal_path
+    assert_response :forbidden
+    get account_settings_path
+    assert_response :success
+    assert_select "a", text: "Upgrade", count: 0
+  end
+
+  test "Stripe failures leave the account free and show a retry message" do
+    @account.create_subscription!(stripe_customer_id: "cus_existing")
+    Stripe::Checkout::Session.expects(:create).raises(Stripe::APIConnectionError.new("Offline"))
+    post saas.account_billing_checkout_path, params: { plan_key: "unlimited" }
+    assert_redirected_to saas.account_billing_path
+    assert_match "temporarily unavailable", flash[:alert]
+    assert_equal "free", @account.reload.billing_plan.key
+  end
+end
