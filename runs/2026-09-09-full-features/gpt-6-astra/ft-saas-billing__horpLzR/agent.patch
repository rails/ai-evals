--- /dev/null
+++ b/saas/app/views/account/billings/show.html.erb
@@ -0,0 +1,15 @@
+<% @page_title = "Billing" %>
+<h1>Billing</h1>
+<p>Your plan: <strong><%= @account.billing_plan.name %></strong><%= " (Comped)" if @account.comped? %></p>
+<p>Free includes 1,000 cards and 1 GB storage.</p>
+<% Billing::Plan.paid.each do |plan| %>
+  <section class="panel margin-block">
+    <h2><%= plan.name %> — $<%= plan.price %>/month</h2>
+    <p>Unlimited cards and <%= plan.storage_limit / 1.gigabyte %> GB storage.</p>
+    <%= button_to "Upgrade to #{plan.name}", saas.account_billing_checkout_path(plan_key: plan.key), data: { turbo: false }, class: "btn" %>
+  </section>
