+module Card::CardLimited
+  extend ActiveSupport::Concern
+
+  private
+    def ensure_within_card_limit
+      Current.account.with_lock do
+        if Current.account.card_limit_reached?
+          respond_to do |format|
+            format.json { render json: { error: "Card limit reached. Upgrade to publish more cards." }, status: :forbidden }
+            format.html { render partial: "billing/upgrade", status: :forbidden }
+          end
+        else
+          yield
+        end
+      end
+    end
+end
