index 0000000..68ae0a3
--- /dev/null
+++ b/saas/app/controllers/account/billing/checkouts_controller.rb
@@ -0,0 +1,20 @@
+class Account::Billing::CheckoutsController < ApplicationController
+  before_action :ensure_admin
+
+  def create
+    plan = ::Billing::Plan.find(params[:plan_key])
+    if plan && !plan.free?
+      subscription = Current.account.subscription_for_checkout
+      url = if subscription.active?
+        subscription.portal_url(return_url: saas.account_billing_url)
+      else
+        subscription.checkout_url(plan, return_url: saas.account_billing_url)
+      end
+      redirect_to url, allow_other_host: true, status: :see_other
+    else
+      head :unprocessable_entity
+    end
+  rescue Stripe::StripeError
+    redirect_to saas.account_billing_path, alert: "Billing is temporarily unavailable. Please try again."
+  end
+end
