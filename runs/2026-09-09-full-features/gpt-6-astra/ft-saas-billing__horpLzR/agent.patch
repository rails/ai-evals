diff --git a/saas/app/models/account/billing.rb b/saas/app/models/account/billing.rb
new file mode 100644
index 0000000..a895f2e
--- /dev/null
+++ b/saas/app/models/account/billing.rb
@@ -0,0 +1,74 @@
+module Account::Billing
+  extend ActiveSupport::Concern
+
+  included do
+    has_one :subscription, dependent: :destroy
+    has_one :overridden_limits, dependent: :destroy
+    has_one :billing_waiver, dependent: :destroy
+  end
+
+  def billing_plan
+    if comped?
+      ::Billing::Plan.find("unlimited_plus")
+    elsif subscription&.active?
+      ::Billing::Plan.find(subscription.plan_key) || ::Billing::Plan.find("free")
+    else
+      ::Billing::Plan.find("free")
+    end
+  end
+
+  def comped?
+    billing_waiver.present?
+  end
+
+  def comp
+    create_billing_waiver! unless comped?
+  end
+
+  def uncomp
+    billing_waiver&.destroy!
+    reload_billing_waiver
+  end
+
+  def comped=(value)
+    ActiveModel::Type::Boolean.new.cast(value) ? comp : uncomp
+  end
+
+  def card_count
+    overridden_limits&.card_count || cards.published.count
+  end
+
+  def bytes_used
+    overridden_limits&.bytes_used || super
+  end
+
+  def cards_remaining
+    [ billing_plan.card_limit - card_count, 0 ].max if billing_plan.card_limit
+  end
+
+  def card_limit_reached?
+    cards_remaining == 0
+  end
+
+  def nearing_card_limit?
+    cards_remaining&.between?(1, 100) || false
+  end
+
+  def override_usage(attributes)
+    (overridden_limits || build_overridden_limits).update!(attributes)
+  end
+
+  def reset_usage_override
+    overridden_limits&.destroy!
+    reload_overridden_limits
+  end
+
+  def subscription_for_checkout
+    with_lock do
+      reload_subscription || create_subscription!(stripe_customer_id: Stripe::Customer.create(
+        { email: owner_email, name: name, metadata: { account_id: id } },
+        { idempotency_key: "fizzy-account-#{id}", api_key: ENV.fetch("STRIPE_SECRET_KEY") }
+      ).id)
+    end
+  end
+end
