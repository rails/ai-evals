diff --git a/saas/test/controllers/card/card_limited_test.rb b/saas/test/controllers/card/card_limited_test.rb
new file mode 100644
index 0000000..dae8dd4
--- /dev/null
+++ b/saas/test/controllers/card/card_limited_test.rb
@@ -0,0 +1,68 @@
+require "test_helper"
+
+class Card::CardLimitedTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :mike
+    @account = accounts(:initech)
+    @board = boards(:miltons_wish_list)
+    @account.update_column(:cards_count, 100)
+    @account.override_usage(card_count: 1000)
+  end
+
+  test "API creation is refused at the limit" do
+    assert_no_difference -> { Card.count } do
+      post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Blocked" } }, as: :json
+    end
+    assert_response :forbidden
+  end
+
+  test "drafting and editing remain available but publishing is refused" do
+    post board_cards_path(@board, script_name: @account.slug)
+    assert_response :redirect
+    follow_redirect!
+    assert_response :success
+    assert_match "Upgrade", response.body
+    assert_select "button", text: "Create card", count: 0
+    card = @board.cards.drafted.find_by!(creator: users(:mike))
+    patch card_path(card, script_name: @account.slug), params: { card: { title: "Still drafting" } }, as: :json
+    assert_response :success
+    post card_publish_path(card, script_name: @account.slug)
+    assert_response :forbidden
+    assert card.reload.drafted?
+    post card_publish_path(card, script_name: @account.slug), as: :json
+    assert_response :forbidden
+  end
+
+  test "paid accounts can create above the free limit" do
+    @account.create_subscription!(stripe_customer_id: "cus_paid", plan_key: "unlimited", status: "active")
+    post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Paid" } }, as: :json
+    assert_response :created
+  end
+
+  test "paid storage allowance is enforced by API creation" do
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_storage", status: "active", plan_key: "unlimited")
+    [ [ "unlimited", 5.gigabytes ], [ "unlimited_plus", 500.gigabytes ] ].each do |key, allowance|
+      subscription.update!(plan_key: key)
+      @account.override_usage(bytes_used: allowance - 1)
+      post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Within allowance" } }, as: :json
+      assert_response :created
+      @account.override_usage(bytes_used: allowance + 1)
+      assert_no_difference -> { Card.count } do
+        post board_cards_path(@board, script_name: @account.slug), params: { card: { title: "Over allowance" } }, as: :json
+      end
+      assert_response :forbidden
+    end
+  end
+
+  test "warning counts down and add buttons become an upgrade pitch" do
+    @account.override_usage(card_count: 950)
+    get board_path(@board, script_name: @account.slug)
+    assert_response :success
+    assert_match "50 cards left", response.body
+    @account.override_usage(card_count: 1000)
+    get board_path(@board, script_name: @account.slug)
+    assert_response :success
+    assert_match "Upgrade", response.body
+    assert_select "button", text: "Add a card", count: 0
+  end
+end
diff --git a/saas/test/controllers/stripe/webhooks_controller_test.rb b/saas/test/controllers/stripe/webhooks_controller_test.rb
new file mode 100644
index 0000000..e8f92e4
--- /dev/null
+++ b/saas/test/controllers/stripe/webhooks_controller_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class Stripe::WebhooksControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @old_env = ENV.to_h.slice("STRIPE_WEBHOOK_SECRET", "STRIPE_MONTHLY_V1_PRICE_ID", "STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID")
+    ENV["STRIPE_WEBHOOK_SECRET"] = "whsec_test"
+    ENV["STRIPE_MONTHLY_V1_PRICE_ID"] = "price_unlimited"
+    ENV["STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID"] = "price_plus"
+    @subscription = accounts(:initech).create_subscription!(stripe_customer_id: "cus_test")
+  end
+
+  teardown do
+    %w[ STRIPE_WEBHOOK_SECRET STRIPE_MONTHLY_V1_PRICE_ID STRIPE_MONTHLY_EXTRA_STORAGE_V1_PRICE_ID ].each { |key| ENV[key] = @old_env[key] }
+  end
+
+  test "signed subscription lifecycle, duplicate delivery and stale events" do
+    deliver("evt_create", "customer.subscription.created", 100, "price_unlimited")
+    assert_response :success
+    assert_equal "unlimited", @subscription.reload.plan_key
+    assert_equal 5.gigabytes, @subscription.account.storage_limit
+    assert_no_difference -> { Stripe::WebhookEvent.count } do
+      deliver("evt_create", "customer.subscription.created", 100, "price_unlimited")
+    end
+    deliver("evt_update", "customer.subscription.updated", 200, "price_plus")
+    assert_equal "unlimited_plus", @subscription.reload.plan_key
+    deliver("evt_stale", "customer.subscription.updated", 150, "price_unlimited")
+    assert_equal "unlimited_plus", @subscription.reload.plan_key
+    deliver("evt_delete", "customer.subscription.deleted", 300, "price_plus")
+    assert_not @subscription.reload.active?
+    assert_equal "free", @subscription.account.billing_plan.key
+  end
+
+  test "invalid signature does not change subscriptions" do
+    untenanted do
+      post "/stripe/webhooks", params: "{}", headers: { "Content-Type" => "application/json", "Stripe-Signature" => "invalid" }
+    end
+    assert_response :bad_request
+    assert_nil @subscription.reload.status
+  end
+
+  test "unrelated events are acknowledged" do
+    deliver("evt_ignore", "invoice.paid", 100, "price_unlimited")
+    assert_response :success
+    assert_nil @subscription.reload.status
+  end
+
+  test "scheduled cancellation retains allowance until deletion" do
+    cancel_at = 1.month.from_now.to_i
+    deliver("evt_scheduled", "customer.subscription.updated", 100, "price_unlimited", cancel_at: cancel_at)
+    assert @subscription.reload.active?
+    assert_equal Time.at(cancel_at), @subscription.cancel_at
+    assert_equal 5.gigabytes, @subscription.account.storage_limit
+  end
+
+  test "a canceled subscription cannot be revived by a same-second update" do
+    deliver("evt_deleted", "customer.subscription.deleted", 100, "price_unlimited")
+    deliver("evt_late_update", "customer.subscription.updated", 100, "price_unlimited")
+    assert_not @subscription.reload.active?
+  end
+
+  test "deleting an old subscription does not cancel its replacement" do
+    deliver("evt_new", "customer.subscription.created", 100, "price_plus", subscription_id: "sub_new")
+    deliver("evt_old_delete", "customer.subscription.deleted", 200, "price_unlimited")
+    assert @subscription.reload.active?
+    assert_equal "sub_new", @subscription.stripe_subscription_id
+    assert_equal "unlimited_plus", @subscription.plan_key
+  end
+
+  test "unpaid and paused subscriptions return to Free" do
+    %w[ unpaid paused incomplete incomplete_expired ].each_with_index do |status, index|
+      deliver("evt_#{status}", "customer.subscription.updated", 100 + index, "price_unlimited", status: status)
+      assert_response :success
+      assert_equal "free", @subscription.reload.account.billing_plan.key
+    end
+  end
+
+  test "unknown prices never grant a paid allowance" do
+    deliver("evt_unknown", "customer.subscription.updated", 100, "price_unknown")
+    assert_response :success
+    assert_equal "free", @subscription.reload.account.billing_plan.key
+  end
+
+  private
+    def deliver(id, type, created, price, subscription_id: "sub_test", status: "active", cancel_at: nil)
+      payload = { id: id, object: "event", type: type, created: created, data: { object: {
+        id: subscription_id, object: "subscription", customer: "cus_test", status: status, cancel_at: cancel_at,
+        items: { object: "list", data: [ { price: { id: price, object: "price" }, current_period_end: 1.month.from_now.to_i } ] }
+      } } }.to_json
+      now = Time.now
+      signature = Stripe::Webhook::Signature.compute_signature(now, payload, ENV.fetch("STRIPE_WEBHOOK_SECRET"))
+      header = Stripe::Webhook::Signature.generate_header(now, signature)
+      untenanted do
+        post "/stripe/webhooks", params: payload, headers: { "Content-Type" => "application/json", "Stripe-Signature" => header }
+      end
+    end
+end
diff --git a/saas/test/models/account/billing_test.rb b/saas/test/models/account/billing_test.rb
new file mode 100644
index 0000000..317f2b1
--- /dev/null
+++ b/saas/test/models/account/billing_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class Account::BillingTest < ActiveSupport::TestCase
+  setup do
+    @account = accounts(:initech)
+    Current.account = @account
+    Current.user = users(:mike)
+  end
+
+  test "free allowance and warning boundaries" do
+    assert_equal "Free", @account.billing_plan.name
+    assert_equal 1.gigabyte, @account.storage_limit
+
+    [ [ 899, false, 101 ], [ 900, true, 100 ], [ 950, true, 50 ], [ 1000, false, 0 ], [ 1001, false, 0 ] ].each do |count, warning, left|
+      @account.override_usage(card_count: count)
+      assert_equal warning, @account.nearing_card_limit?
+      assert_equal left, @account.cards_remaining
+      assert_equal count >= 1000, @account.card_limit_reached?
+    end
+  end
+
+  test "paid plans have unlimited cards and their own storage allowance" do
+    @account.override_usage(card_count: 5000)
+    subscription = @account.create_subscription!(stripe_customer_id: "cus_test", plan_key: "unlimited", status: "active")
+    assert_not @account.card_limit_reached?
+    assert_equal 5.gigabytes, @account.storage_limit
+    subscription.update!(plan_key: "unlimited_plus")
+    assert_equal 500.gigabytes, @account.storage_limit
+    subscription.update!(status: "canceled")
+    assert @account.card_limit_reached?
+    assert_equal 1.gigabyte, @account.storage_limit
+  end
+
+  test "comp and uncomp preserve subscription and reset drops only usage override" do
+    real_count = @account.cards.published.count
+    real_bytes = @account.bytes_used
+    @account.override_usage(card_count: 1000, bytes_used: 9.gigabytes)
+    @account.comp
+    assert @account.comped?
+    assert_not @account.card_limit_reached?
+    @account.uncomp
+    assert @account.card_limit_reached?
+    assert_equal 9.gigabytes, @account.bytes_used
+    @account.reset_usage_override
+    assert_nil @account.overridden_limits
+    assert_equal real_count, @account.card_count
+    assert_equal real_bytes, @account.bytes_used
+  end
+
+  test "drafts do not consume the allowance and published cards do" do
+    @account.update_column(:cards_count, 100)
+    count = @account.card_count
+    card = boards(:miltons_wish_list).cards.create!(status: :drafted, creator: users(:mike))
+    assert_equal count, @account.card_count
+    card.publish
+    assert_equal count + 1, @account.card_count
+  end
+
+  test "zero overrides are honored and blank fields restore measured usage" do
+    @account.override_usage(card_count: 0, bytes_used: 0)
+    assert_equal 0, @account.card_count
+    assert_equal 0, @account.bytes_used
+    @account.override_usage(card_count: "", bytes_used: "")
+    assert_equal @account.cards.published.count, @account.card_count
+    assert_nil @account.overridden_limits.bytes_used
+  end
+
+  test "uncomp restores an existing paid plan" do
+    @account.create_subscription!(stripe_customer_id: "cus_comp", status: "active", plan_key: "unlimited")
+    2.times { @account.comp }
+    assert_equal 500.gigabytes, @account.storage_limit
+    2.times { @account.uncomp }
+    assert_equal 5.gigabytes, @account.storage_limit
+  end
+
+  test "negative usage is rejected" do
+    assert_raises ActiveRecord::RecordInvalid do
+      @account.override_usage(card_count: -1)
+    end
+  end
+end
