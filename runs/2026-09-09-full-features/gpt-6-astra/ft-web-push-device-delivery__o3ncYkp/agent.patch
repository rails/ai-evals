diff --git a/app/javascript/controllers/notifications_controller.js b/app/javascript/controllers/notifications_controller.js
new file mode 100644
index 0000000..586112d
--- /dev/null
+++ b/app/javascript/controllers/notifications_controller.js
@@ -0,0 +1,93 @@
+import { Controller } from "@hotwired/stimulus"
+import { FetchRequest } from "@rails/request.js"
+
+export default class extends Controller {
+  static targets = [ "button", "status", "help", "details" ]
+  static values = { url: String, publicKey: String, subscriptions: Object }
+
+  async connect() {
+    this.enabled = false
+    this.subscriptionId = null
+    this.supported = "serviceWorker" in navigator && "PushManager" in window && "Notification" in window
+
+    if (!this.supported) {
+      this.statusTarget.textContent = "This browser doesn’t support push notifications."
+      this.helpTarget.hidden = false
+    } else if (!this.publicKeyValue) {
+      this.statusTarget.textContent = "Push notifications aren’t configured on this server."
+    } else {
+      try {
+        await navigator.serviceWorker.register("/service-worker.js", { scope: "/" })
+        this.registration = await navigator.serviceWorker.ready
+        this.subscription = await this.registration.pushManager.getSubscription()
+        if (this.subscription && Notification.permission === "granted") {
+          this.subscriptionId = this.subscriptionsValue[this.subscription.endpoint]
+          this.enabled = !!this.subscriptionId
+        }
+        this.refresh()
+      } catch (error) {
+        this.showError()
+      }
+    }
+  }
+
+  async toggle() {
+    this.buttonTarget.disabled = true
+    this.statusTarget.textContent = ""
+
+    try {
+      if (this.enabled) {
+        const response = await new FetchRequest("delete", `${this.urlValue}/${this.subscriptionId}`, { responseKind: "json" }).perform()
+        if (!response.ok && response.statusCode !== 404) throw new Error("Unable to remove subscription")
+        // The browser subscription may also be used by another Fizzy account.
+        // Remove only this user's server-side registration.
+        this.subscriptionId = null
+        this.enabled = false
+      } else {
+        // Request permission directly from the click, as required by Safari.
+        const permission = await Notification.requestPermission()
+        if (permission === "granted") {
+          this.subscription = await this.registration.pushManager.getSubscription() || await this.registration.pushManager.subscribe({
+            userVisibleOnly: true,
+            applicationServerKey: this.applicationServerKey
+          })
+          await this.saveSubscription()
+          this.enabled = true
+        }
+      }
+      this.refresh()
+    } catch (error) {
+      this.showError()
+    }
+  }
+
+  async saveSubscription() {
+    const { endpoint, keys } = this.subscription.toJSON()
+    const response = await new FetchRequest("post", this.urlValue, {
+      responseKind: "json",
+      body: JSON.stringify({ push_subscription: { endpoint, p256dh_key: keys.p256dh, auth_key: keys.auth } })
+    }).perform()
+    if (!response.ok) throw new Error("Unable to save subscription")
+    this.subscriptionId = (await response.json).id
+  }
+
+  refresh() {
+    const denied = Notification.permission === "denied"
+    this.element.classList.toggle("notifications--on", this.enabled)
+    this.buttonTarget.textContent = this.enabled ? "Turn off notifications" : "Turn on notifications"
+    this.buttonTarget.disabled = denied
+    this.helpTarget.hidden = !denied
+    if (denied) this.statusTarget.textContent = "Notifications are blocked. Follow the steps below to allow them."
+  }
+
+  showError() {
+    this.statusTarget.textContent = "Couldn’t update notifications. Please try again."
+    this.buttonTarget.disabled = !this.registration
+  }
+
+  get applicationServerKey() {
+    const base64 = this.publicKeyValue.replace(/-/g, "+").replace(/_/g, "/")
+    const padded = base64 + "=".repeat((4 - base64.length % 4) % 4)
+    return Uint8Array.from(atob(padded), character => character.charCodeAt(0))
+  }
+}
diff --git a/app/jobs/notification/push_job.rb b/app/jobs/notification/push_job.rb
new file mode 100644
