diff --git a/app/models/notification/pushable.rb b/app/models/notification/pushable.rb
new file mode 100644
index 0000000..c7b8872
--- /dev/null
+++ b/app/models/notification/pushable.rb
@@ -0,0 +1,27 @@
+module Notification::Pushable
+  extend ActiveSupport::Concern
+
+  included do
+    after_save_commit :push_later, if: -> { source_id_previously_changed? || source_type_previously_changed? }
+  end
+
+  def push_payload
+    helpers = ApplicationController.helpers
+    {
+      title: helpers.notification_title(self),
+      body: helpers.notification_body(self),
+      tag: "notification_#{id}",
+      data: { url: Rails.application.routes.url_helpers.polymorphic_path(self, script_name: account.slug, only_path: true) }
+    }
+  end
+
+  private
+    def push_later
+      if PushSubscription.configured?
+        payload = push_payload
+        user.push_subscriptions.find_each do |subscription|
+          Notification::PushJob.perform_later(subscription, payload)
+        end
+      end
+    end
+end
diff --git a/app/models/push_subscription.rb b/app/models/push_subscription.rb
new file mode 100644
index 0000000..a5ea66b
--- /dev/null
+++ b/app/models/push_subscription.rb
@@ -0,0 +1,38 @@
+class PushSubscription < ApplicationRecord
+  belongs_to :user
+  belongs_to :account, default: -> { user.account }
+
+  before_validation :set_endpoint_digest
+
+  validates :endpoint, :p256dh_key, :auth_key, presence: true
+  validate :endpoint_is_https
+
+  def self.configured?
+    ENV["VAPID_PUBLIC_KEY"].present? && ENV["VAPID_PRIVATE_KEY"].present?
+  end
+
+  def push(payload)
+    if self.class.configured? && user.active?
+      WebPush.payload_send(
+        endpoint: endpoint, p256dh: p256dh_key, auth: auth_key,
+        message: payload.to_json,
+        vapid: { public_key: ENV.fetch("VAPID_PUBLIC_KEY"), private_key: ENV.fetch("VAPID_PRIVATE_KEY") },
+        open_timeout: 10, read_timeout: 10
+      )
+    end
+  rescue WebPush::ExpiredSubscription, WebPush::InvalidSubscription
+    destroy!
+  end
+
+  private
+    def set_endpoint_digest
+      self.endpoint_digest = Digest::SHA256.hexdigest(endpoint.to_s)
+    end
+
+    def endpoint_is_https
+      uri = URI.parse(endpoint.to_s)
+      errors.add(:endpoint, "must be an HTTPS URL") unless uri.is_a?(URI::HTTPS) && uri.host.present? && uri.userinfo.nil?
+    rescue URI::InvalidURIError
+      errors.add(:endpoint, "must be an HTTPS URL")
+    end
+end
