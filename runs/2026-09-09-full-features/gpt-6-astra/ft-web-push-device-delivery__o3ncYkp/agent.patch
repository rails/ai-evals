@@ -0,0 +1,50 @@
+require "test_helper"
+
+class Notification::PushableTest < ActiveSupport::TestCase
+  setup do
+    @notification = notifications(:logo_assignment_kevin)
+    PushSubscription.stubs(:configured?).returns(true)
+    2.times do |device|
+      @notification.user.push_subscriptions.create!(endpoint: "https://push.example.com/#{device}", p256dh_key: "public", auth_key: "secret")
+    end
+  end
+
+  test "new notifications enqueue delivery to every device" do
+    @notification.destroy!
+    assert_enqueued_jobs 2, only: Notification::PushJob do
+      Notification.create!(user: users(:kevin), source: events(:logo_assignment_km), creator: users(:david))
+    end
+  end
+
+  test "new activity on an existing notification pushes but read changes do not" do
+    assert_enqueued_jobs 2, only: Notification::PushJob do
+      @notification.update!(source: events(:logo_assignment_jz))
+    end
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.read
+      @notification.unread
+    end
+  end
+
+  test "pushes are not enqueued when VAPID is not configured" do
+    PushSubscription.stubs(:configured?).returns(false)
+    assert_no_enqueued_jobs only: Notification::PushJob do
+      @notification.update!(source: events(:logo_assignment_jz))
+    end
+  end
+
+  test "payload uses tray text and an account scoped target" do
+    payload = @notification.push_payload
+    assert_equal ApplicationController.helpers.event_notification_title(@notification.source), payload[:title]
+    assert_equal ApplicationController.helpers.event_notification_body(@notification.source), payload[:body]
+    assert_equal "#{@notification.account.slug}/cards/#{@notification.card.number}", payload[:data][:url]
+  end
+
+  test "mentions use the same copy as the tray" do
+    notification = notifications(:logo_mentioned_david)
+    payload = notification.push_payload
+    assert_equal "#{notification.source.mentioner.first_name} @mentioned you", payload[:title]
+    assert_equal notification.source.source.mentionable_content.truncate(200), payload[:body]
+    assert_includes payload[:data][:url], "#comment_"
+  end
+end
