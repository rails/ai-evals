+require "test_helper"
+
+class Users::PushSubscriptionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @user = users(:david)
+    sign_in_as @user
+    @subscription = { endpoint: "https://push.example.com/device", p256dh_key: "public", auth_key: "secret" }
+  end
+
+  test "register a device and refresh its keys without duplicating it" do
+    assert_difference -> { @user.push_subscriptions.count }, 1 do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription }, as: :json
+      assert_response :created
+    end
+
+    assert_no_difference "PushSubscription.count" do
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.merge(auth_key: "refreshed") }, as: :json
+      assert_response :created
+    end
+    assert_equal "refreshed", @user.push_subscriptions.sole.auth_key
+    assert_equal @user.account, @user.push_subscriptions.sole.account
+  end
+
+  test "cannot register a device for another user" do
+    post user_push_subscriptions_path(users(:kevin)), params: { push_subscription: @subscription }, as: :json
+    assert_response :forbidden
+  end
+
+  test "reject missing keys" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.except(:auth_key) }, as: :json
+    assert_response :unprocessable_entity
+  end
+
+  test "cannot delete another user's subscription" do
+    subscription = users(:kevin).push_subscriptions.create!(@subscription)
+    assert_no_difference "PushSubscription.count" do
+      delete user_push_subscription_path(@user, subscription)
+      assert_response :not_found
+      delete user_push_subscription_path(users(:kevin), subscription)
+      assert_response :forbidden
+    end
+  end
+
+  test "missing endpoint is a bad request" do
+    post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.except(:endpoint) }, as: :json
+    assert_response :bad_request
+  end
+
+  test "ownership cannot be supplied in the subscription parameters" do
+    post user_push_subscriptions_path(@user), params: {
+      push_subscription: @subscription.merge(user_id: users(:kevin).id, account_id: accounts(:initech).id)
+    }, as: :json
+    assert_response :created
+    assert_equal @user.account, @user.push_subscriptions.sole.account
+  end
+
+  test "each device has its own subscription" do
+    2.times do |device|
+      post user_push_subscriptions_path(@user), params: { push_subscription: @subscription.merge(endpoint: "https://push.example.com/#{device}") }, as: :json
+      assert_response :created
+    end
+    assert_equal 2, @user.push_subscriptions.count
+  end
+
+  test "remove only this user's device" do
+    subscription = @user.push_subscriptions.create!(@subscription)
+    delete user_push_subscription_path(@user, subscription)
+    assert_response :no_content
+    assert_not PushSubscription.exists?(subscription.id)
+  end
+end
diff --git a/test/javascript/push_notifications_test.rb b/test/javascript/push_notifications_test.rb
new file mode 100644
index 0000000..f142299
--- /dev/null
+++ b/test/javascript/push_notifications_test.rb
@@ -0,0 +1,157 @@
+# Run with: bundle exec ruby test/javascript/push_notifications_test.rb
+require "minitest/autorun"
+require "selenium-webdriver"
+
+class PushNotificationsJavaScriptTest < Minitest::Test
+  def setup
+    options = Selenium::WebDriver::Chrome::Options.new
+    options.add_argument("--headless")
+    options.add_argument("--no-sandbox")
+    @browser = Selenium::WebDriver.for(:chrome, options: options)
+    @browser.manage.timeouts.script_timeout = 10
+  end
+
+  def teardown
+    @browser&.quit
+  end
+
+  def test_device_opt_in_and_opt_out
+    result = run_controller(<<~JS)
+      await controller.connect()
+      const initiallyOff = !controller.enabled && requests.length === 0
+      await controller.toggle()
+      const enabled = controller.enabled
+      await controller.toggle()
+      return { initiallyOff, enabled, disabled: !controller.enabled, requests, options: subscribeOptions }
+    JS
+    assert result["initiallyOff"]
+    assert result["enabled"]
+    assert result["disabled"]
+    request = result["requests"].first
+    assert_equal "post", request["method"]
+    assert_equal "/123/users/me/push_subscriptions", request["url"]
+    assert_equal({ "endpoint" => "https://push.example/device", "p256dh_key" => "public", "auth_key" => "auth" }, JSON.parse(request["options"]["body"])["push_subscription"])
+    assert_equal "delete", result["requests"].last["method"]
+    assert_equal "/123/users/me/push_subscriptions/device-id", result["requests"].last["url"]
+    assert result["options"]["userVisibleOnly"]
+    assert_equal [ 1, 2, 3 ], result["options"]["applicationServerKey"]
+  end
+
+  def test_existing_browser_permission_does_not_opt_in_another_account
+    result = run_controller(<<~JS)
+      subscription = device
+      await controller.connect()
+      return { enabled: controller.enabled, requests }
+    JS
+    refute result["enabled"]
+    assert_empty result["requests"]
+  end
+
+  def test_registered_device_is_shown_as_enabled
+    result = run_controller(<<~JS)
+      subscription = device
+      controller.subscriptionsValue = { [device.endpoint]: "device-id" }
+      await controller.connect()
+      return { enabled: controller.enabled, requests }
+    JS
+    assert result["enabled"]
+    assert_empty result["requests"]
+  end
+
+  def test_denied_and_unsupported_browsers_show_help
+    result = run_controller(<<~JS)
+      Notification.permission = "denied"
+      await controller.connect()
+      const denied = controller.buttonTarget.disabled && !controller.helpTarget.hidden
+      delete window.PushManager
+      await controller.connect()
+      return { denied, unsupported: !controller.helpTarget.hidden, requests }
+    JS
+    assert result["denied"]
+    assert result["unsupported"]
+    assert_empty result["requests"]
+  end
+
+  def test_server_failure_does_not_claim_notifications_are_enabled
+    result = run_controller(<<~JS)
+      await controller.connect()
+      requestOK = false
+      await controller.toggle()
+      return { enabled: controller.enabled, status: controller.statusTarget.textContent, disabled: controller.buttonTarget.disabled }
+    JS
+    refute result["enabled"]
+    refute result["disabled"]
+    assert_includes result["status"], "Please try again"
+  end
+
+  def test_worker_displays_payload_and_opens_or_focuses_target
+    worker = File.read("app/views/pwa/service_worker.js.erb").split('self.addEventListener("push",').last
+    result = evaluate(<<~JS)
+      const listeners = {}, shown = [], opened = []
+      let windows = [], focused = false, pending
+      const self = {
+        location: { origin: "https://fizzy.example" },
+        addEventListener: (name, listener) => listeners[name] = listener,
+        registration: { showNotification: async (...args) => shown.push(args) },
+        clients: { matchAll: async () => windows, openWindow: async url => opened.push(url) }
+      }
+      self.addEventListener("push", #{worker}
+      const payload = { title: "RE: Card", body: "A comment", tag: "notification_1", data: { url: "/123/cards/1#comment_2" } }
+      const event = { data: { json: () => payload }, waitUntil: promise => pending = promise }
+      listeners.push(event)
+      await pending
+      const click = { notification: { ...payload, close() {} }, waitUntil: promise => pending = promise }
+      listeners.notificationclick(click)
+      await pending
+      windows = [{ url: opened[0], focus: async () => focused = true }]
+      listeners.notificationclick(click)
+      await pending
+      click.notification.data.url = "https://evil.example"
+      listeners.notificationclick(click)
+      return { shown, opened, focused }
+    JS
+    assert_equal "RE: Card", result["shown"][0][0]
+    assert_equal "A comment", result["shown"][0][1]["body"]
+    assert_equal [ "https://fizzy.example/123/cards/1#comment_2" ], result["opened"]
+    assert result["focused"]
+  end
+
+  private
+    def run_controller(script)
+      controller = File.read("app/javascript/controllers/notifications_controller.js").gsub(/^import .*\n/, "").sub("export default class", "class NotificationsController")
+      evaluate(<<~JS)
+        const requests = []
+        let requestOK = true, subscribeOptions, subscription = null
+        const device = { endpoint: "https://push.example/device", toJSON: () => ({ endpoint: "https://push.example/device", keys: { p256dh: "public", auth: "auth" } }) }
+        const registration = { pushManager: {
+          getSubscription: async () => subscription,
+          subscribe: async options => { subscribeOptions = options; return subscription = device }
+        } }
+        const navigator = { serviceWorker: { register: async () => registration, ready: Promise.resolve(registration) } }
+        const Notification = { permission: "granted", requestPermission: async () => Notification.permission }
+        const window = { PushManager: {}, Notification }
+        class Controller {}
+        class FetchRequest {
+          constructor(method, url, options) { requests.push({ method, url, options }) }
+          async perform() { return { ok: requestOK, json: Promise.resolve({ id: "device-id" }) } }
+        }
+        #{controller}
+        const controller = new NotificationsController()
+        Object.assign(controller, {
+          urlValue: "/123/users/me/push_subscriptions", publicKeyValue: "AQID", subscriptionsValue: {},
+          buttonTarget: { disabled: true }, statusTarget: {}, helpTarget: { hidden: true },
+          element: { classList: { toggle() {} } }
+        })
+        #{script}
+      JS
+    end
+
+    def evaluate(script)
+      result = @browser.execute_async_script(<<~JS)
+        const done = arguments[arguments.length - 1]
+        ;(async () => { #{script} })().then(done).catch(error => done({ error: error.stack }))
+      JS
+      refute result.key?("error"), result["error"]
+      result
+    end
+end
