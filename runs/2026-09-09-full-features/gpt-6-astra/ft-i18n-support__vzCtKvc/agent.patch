@@ -0,0 +1,11 @@
+# Unlike the actor's locale serialized by Active Job, this is the viewer's
+# preference at delivery time (it may have changed since the update was made).
+class LocalizedBroadcastJob < ApplicationJob
+  discard_on ActiveJob::DeserializationError
+
+  def perform(record, user, action:, stream:, **rendering)
+    I18n.with_locale(user.identity.locale || I18n.default_locale) do
+      record.public_send("broadcast_#{action}_to", user, stream, **rendering)
+    end
+  end
+end
