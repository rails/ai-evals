+++ b/test/helpers/comments_localization_test.rb
@@ -0,0 +1,27 @@
+require "test_helper"
+
+class CommentsLocalizationTest < ActionView::TestCase
+  include CommentsHelper
+
+  test "system history follows the viewer rather than the actor" do
+    Current.session = sessions(:david)
+    card = cards(:text)
+    I18n.with_locale(:ja) { card.close }
+    comment = card.comments.by_system.order(:created_at).last
+    assert_includes comment.body.to_plain_text, "Moved"
+    assert_includes localized_comment_body(comment).to_s, "Moved"
+
+    I18n.with_locale(:ja) do
+      assert_includes localized_comment_body(comment), "移動しました"
+      assert_equal "システム", comment.creator.name
+    end
+    assert_equal "System", comment.creator.name
+  end
+
+  test "user-authored English is not translated or interpreted" do
+    comment = comments(:logo_agreement_jz)
+    I18n.with_locale(:ja) do
+      assert_equal comment.body, localized_comment_body(comment)
+    end
+  end
+end
diff --git a/test/integration/localization_test.rb b/test/integration/localization_test.rb
new file mode 100644
index 0000000..07270e6
--- /dev/null
+++ b/test/integration/localization_test.rb
@@ -0,0 +1,94 @@
+require "test_helper"
+
+class LocalizationTest < ActionDispatch::IntegrationTest
+  test "English is unchanged until a locale is selected" do
+    untenanted do
+      get new_session_path
+      assert_select "html[lang=en]"
+      assert_select "h1", text: "Get into Fizzy"
+      get new_session_path(locale: "xx")
+      assert_select "html[lang=en]"
+      assert_select "h1", text: "Get into Fizzy"
+    end
+    assert_equal :en, I18n.locale
+  end
+
+  test "an anonymous choice survives navigation and authentication" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      assert_select "html[lang=ja]"
+      assert_select "h1", text: "Fizzyを始める"
+      get new_session_path(locale: "xx")
+      assert_select "html[lang=ja]"
+    end
+    sign_in_as :david
+    assert_equal "ja", identities(:david).reload.locale
+    get root_path
+    assert_select "html[lang=ja]"
+    assert_no_match(/translation missing/i, response.body)
+    assert_equal :en, I18n.locale
+  end
+
+  test "identity preference is restored in a clean browser and can be changed back" do
+    sign_in_as :david
+    get root_path(locale: "ja")
+    assert_equal "ja", identities(:david).reload.locale
+    reset!
+    sign_in_as :david
+    get root_path
+    assert_select "html[lang=ja]"
+    get root_path(locale: "en")
+    assert_select "html[lang=en]"
+    assert_equal "en", identities(:david).reload.locale
+  end
+
+  test "invalid and structured locales never switch or raise" do
+    sign_in_as :david
+    get root_path(locale: "ja")
+    [ "xx", "JA", "", [ "ja" ], { language: "ja" } ].each do |locale|
+      get root_path, params: { locale: locale }
+      assert_response :success
+      assert_select "html[lang=ja]"
+      assert_equal "ja", identities(:david).reload.locale
+      assert_equal :en, I18n.locale
+    end
+  end
+
+  test "Japanese screens include localized accessibility copy" do
+    sign_in_as :david
+    get root_path(locale: "ja")
+    [ root_path, new_board_path, notifications_path, notifications_settings_path,
+      user_path(users(:david)), account_settings_path, my_passkeys_path, my_access_tokens_path,
+      board_path(boards(:writebook)), card_path(cards(:logo)) ].each do |path|
+      get path
+      assert_response :success
+      assert_no_match(/translation missing/i, response.body, path)
+      assert_select "html[lang=ja]"
+      assert_includes response.body, "本文へスキップ"
+      assert_no_match(/>\s*(?:Skip to main content|Settings|Add a card|Save changes|Unpin this card)\s*</, response.body)
+    end
+  end
+  test "collection caches are isolated by locale" do
+    sign_in_as :david
+    with_actionview_partial_caching do
+      get card_path(cards(:logo))
+      assert_includes response.body, "Full history"
+      get card_path(cards(:logo), locale: "ja")
+      assert_includes response.body, "すべての履歴"
+      assert_no_match(/>\s*Full history\s*</, response.body)
+      get card_path(cards(:logo), locale: "en")
+      assert_includes response.body, "Full history"
+    end
+  end
+
+  test "anonymous magic link email uses the chosen language without changing the identity" do
+    untenanted do
+      get new_session_path(locale: "ja")
+      perform_enqueued_jobs only: ActionMailer::MailDeliveryJob do
+        post session_path, params: { email_address: identities(:david).email_address }
+      end
+      assert_match(/Fizzyの認証コード/, ActionMailer::Base.deliveries.last.subject)
+      assert_nil identities(:david).reload.locale
+    end
+  end
+end
diff --git a/test/lib/localization_test.rb b/test/lib/localization_test.rb
new file mode 100644
index 0000000..c296407
--- /dev/null
+++ b/test/lib/localization_test.rb
@@ -0,0 +1,58 @@
+require "test_helper"
+
+class LocalizationCatalogTest < ActiveSupport::TestCase
+  test "Japanese has every application key and interpolation" do
+    %i[ui copy emoji onboarding pwa browser counts labels].each do |namespace|
+      english = flatten(I18n.t(namespace, locale: :en))
+      japanese = flatten(I18n.t(namespace, locale: :ja))
+      assert_equal english.keys.sort, japanese.keys.sort, namespace.to_s
+      english.each do |key, value|
+        # Japanese has no plural suffix and no English ordinal suffix.
+        next if %w[ago account_ordinal].include?(key)
+        assert_equal value.scan(/%\{\w+\}/).sort, japanese.fetch(key).scan(/%\{\w+\}/).sort, "#{namespace}.#{key}"
+        assert japanese.fetch(key).present? || value.empty?, "#{namespace}.#{key}"
+      end
+    end
+  end
+
+  test "Japanese dates and durations have no English fallback" do
+    I18n.with_locale(:ja) do
+      assert_match(/2026年.*月.*日/, I18n.l(Time.utc(2026, 7, 10), format: :stamp))
+      assert_match(/金曜日/, I18n.l(Time.utc(2026, 7, 10), format: :notification))
+      assert_equal "30分", ApplicationController.helpers.distance_of_time_in_words(30.minutes)
+      assert_equal "1人", I18n.t("counts.people", count: 1)
+      assert_equal "3人", I18n.t("counts.people", count: 3)
+      assert_equal "今日", TimeWindowParser.human_name_for("today")
+      assert_equal "青", Color::COLORS.first.name
+      signup = Signup.new(email_address: "invalid")
+      assert_not signup.valid?(:identity_creation)
+      assert_match(/メールアドレス/, signup.errors.full_messages.first)
+    end
+    assert_equal "Today", TimeWindowParser.human_name_for("today")
+    assert_equal "Blue", Color::COLORS.first.name
+  end
+
+  test "English stamp and email date formats retain their exact output" do
+    time = Time.utc(2026, 7, 10, 15, 42)
+    { short_stamp: "%b %e", stamp: "%b %d, %Y", notification: "%-l%P on %A, %B %-d" }.each do |format, pattern|
+      assert_equal time.strftime(pattern), I18n.l(time, format: format, locale: :en)
+    end
+  end
+
+  test "static error pages contain both languages" do
+    Dir[Rails.root.join("public/*.html")].each do |path|
+      html = Nokogiri::HTML5(File.read(path))
+      assert html.at_css('[lang="ja"]'), path
+      assert_match(/[ぁ-んァ-ヶ一-龠]/, html.text)
+      assert_includes html.text, "Back home"
+    end
+  end
+
+  private
+    def flatten(hash, prefix = nil)
+      hash.each_with_object({}) do |(key, value), result|
+        name = [ prefix, key ].compact.join(".")
+        value.is_a?(Hash) ? result.merge!(flatten(value, name)) : result[name] = value
+      end
+    end
+end
diff --git a/test/mailers/localization_test.rb b/test/mailers/localization_test.rb
new file mode 100644
index 0000000..12f6ed0
--- /dev/null
+++ b/test/mailers/localization_test.rb
@@ -0,0 +1,61 @@
+require "test_helper"
+
+class MailerLocalizationTest < ActionMailer::TestCase
+  setup do
+    @identity = identities(:david)
+    @identity.update! locale: "ja"
+    @user = users(:david)
+  end
+
+  test "all mail actions use the recipient language for subject and body" do
+    export = Account::Export.create!(account: Current.account, user: @user)
+    import = Account::Import.create!(account: Current.account, identity: @identity, status: :failed)
+    cancellation = Account::Cancellation.new(account: Current.account, initiated_by: @user)
+    magic_link = @identity.magic_links.create!
+    @user.notifications.destroy_all
+    bundle = Notification::Bundle.create!(user: @user, starts_at: 1.hour.ago, ends_at: 1.hour.from_now)
+    Notification.create!(user: @user, creator: @user, source: events(:logo_published))
+
+    messages = [
+      AccountMailer.cancellation(cancellation),
+      ExportMailer.completed(export),
+      ImportMailer.completed(@identity, Current.account),
+      ImportMailer.failed(import),
+      MagicLinkMailer.sign_in_instructions(magic_link),
+      UserMailer.email_change_confirmation(email_address: "new@example.com", token: "token", user: @user),
+      Notification::BundleMailer.notification(bundle)
+    ]
+
+    messages.each do |email|
+      assert_match(/[ぁ-んァ-ヶ一-龠]/, email.subject)
+      parts = email.multipart? ? email.parts : [ email ]
+      parts.each do |part|
+        body = part.body.decoded
+        assert_match(/[ぁ-んァ-ヶ一-龠]/, body)
+        assert_no_match(/translation missing|Please enter|Need help|Your Fizzy|new notifications|minutes|hours|Monday|January/i, body)
+      end
+      assert_equal :en, I18n.locale
+    end
+  end
+
+  test "deferred mail resolves the recipient language at delivery time" do
+    @identity.update! locale: nil
+    email = ImportMailer.completed(@identity, Current.account)
+    assert_enqueued_emails 1 do
+      email.deliver_later
+    end
+    @identity.update! locale: "ja"
+    perform_enqueued_jobs
+    assert_equal "Fizzyアカウントのインポートが完了しました", ActionMailer::Base.deliveries.last.subject
+    assert_equal :en, I18n.locale
+  end
+
+  test "English recipients do not inherit a Japanese actor's locale" do
+    @identity.update! locale: nil
+    I18n.with_locale(:ja) do
+      email = ImportMailer.completed(@identity, Current.account)
+      assert_equal "Your Fizzy account import is done", email.subject
+      assert_equal :ja, I18n.locale
+    end
+  end
+end
diff --git a/test/system/localization_test.rb b/test/system/localization_test.rb
new file mode 100644
index 0000000..c100492
--- /dev/null
+++ b/test/system/localization_test.rb
@@ -0,0 +1,60 @@
+require "application_system_test_case"
+
+class LocalizationSystemTest < ApplicationSystemTestCase
+  # Chromium requires this when tests run inside a root-owned container.
+  if Process.uid.zero?
+    Capybara.register_driver :localization_chrome do |app|
+      options = Selenium::WebDriver::Chrome::Options.new
+      options.add_argument("--headless")
+      options.add_argument("--no-sandbox")
+      options.add_argument("--disable-dev-shm-usage")
+      Capybara::Selenium::Driver.new(app, browser: :chrome, options: options)
+    end
+    driven_by :localization_chrome
+  end
+
+  test "dates, relative times, accessibility and locale switching in the browser" do
+    sign_in_as users(:david)
+    visit root_path(locale: "ja")
+    assert_selector "html[lang=ja]"
+    assert_selector ".header__skip-navigation", text: "本文へスキップ", visible: :all
+
+    insert_times
+    assert_selector "#localized-date", text: "2020年1月2日"
+    assert_selector "#localized-ago", text: "1分前"
+    assert_selector "#localized-days", text: "2日前"
+    assert_selector "#localized-future", text: "2日後"
+
+    visit card_path(cards(:logo))
+    assert_selector "html[lang=ja]"
+    assert_no_text "translation missing"
+
+    visit root_path(locale: "en")
+    assert_selector "html[lang=en]"
+    insert_times
+    assert_selector "#localized-date", text: "January 2, 2020"
+    assert_selector "#localized-ago", text: "1 minute ago"
+    assert_selector "#localized-days", text: "2 days ago"
+    assert_selector "#localized-future", text: "in 2 days"
+  end
+
+  private
+    def insert_times
+      page.execute_script <<~JS
+        const dates = {
+          date: new Date(2020, 0, 2, 12).getTime(),
+          ago: Date.now() - 90_000,
+          days: Date.now() - 2 * 86_400_000,
+          future: Date.now() + 2 * 86_400_000
+        }
+        const targets = { date: "date", ago: "ago", days: "daysago", future: "indays" }
+        for (const [name, milliseconds] of Object.entries(dates)) {
+          const time = document.createElement("time")
+          time.id = `localized-${name}`
+          time.setAttribute("datetime", Math.floor(milliseconds / 1000))
+          time.dataset.localTimeTarget = targets[name]
+          document.querySelector("main").append(time)
+        }
+      JS
+    end
+end
