--- /dev/null
+++ b/app/javascript/controllers/locale_controller.js
@@ -0,0 +1,15 @@
+import { Controller } from "@hotwired/stimulus"
+import { Turbo } from "@hotwired/turbo-rails"
+
+export default class extends Controller {
+  connect() {
+    const locale = document.documentElement.lang
+    const previous = sessionStorage.getItem("fizzy-locale") || "en"
+    if (previous !== locale) {
+      Turbo.cache.clear()
+      Turbo.offline.clearCache()
+      sessionStorage.removeItem("referrerLabel")
+    }
+    sessionStorage.setItem("fizzy-locale", locale)
+  }
+}
