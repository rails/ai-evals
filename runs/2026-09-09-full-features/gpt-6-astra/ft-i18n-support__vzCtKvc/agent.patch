diff --git a/app/controllers/concerns/localization.rb b/app/controllers/concerns/localization.rb
new file mode 100644
index 0000000..e6d2177
--- /dev/null
+++ b/app/controllers/concerns/localization.rb
@@ -0,0 +1,29 @@
+module Localization
+  extend ActiveSupport::Concern
+
+  included do
+    prepend_around_action :with_locale
+    etag { I18n.locale }
+  end
+
+  private
+    def with_locale(&action)
+      requested_locale = params[:locale].presence_in(I18n.available_locales.map(&:to_s))
+      session[:locale] = requested_locale if requested_locale
+      identity = Current.identity || find_session_by_cookie&.identity
+      locale = requested_locale || session[:locale].presence_in(I18n.available_locales.map(&:to_s)) || identity&.locale || I18n.default_locale
+
+      if identity && session[:locale].present? && identity.locale != locale.to_s
+        identity.update! locale: locale
+      end
+
+      I18n.with_locale(locale, &action)
+    end
+
+    def remember_locale_for(identity)
+      if locale = session[:locale].presence_in(I18n.available_locales.map(&:to_s))
+        identity.update! locale: locale unless identity.locale == locale
+      end
+      I18n.locale = identity.locale || I18n.default_locale
+    end
+end
