new file mode 100644
index 0000000..6754dc3
--- /dev/null
+++ b/app/javascript/helpers/i18n.js
@@ -0,0 +1,9 @@
+export function locale() {
+  return document.documentElement.lang === "ja" ? "ja-JP" : "en-US"
+}
+
+export function translate(key, values = {}) {
+  const messages = JSON.parse(document.querySelector('meta[name="translations"]').content)
+  const message = key.split(".").reduce((value, part) => value[part], messages)
+  return message.replace(/%\{(\w+)\}/g, (_, name) => values[name])
+}
