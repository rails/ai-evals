diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..29ccccc
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,37 @@
+<% @page_title = "Search" %>
+<% turbo_exempts_page_from_cache %>
+
+<% content_for :header do %>
+  <h1 class="header__title" data-bridge--title-target="header"><%= @page_title %></h1>
+<% end %>
+
+<section class="panel panel--wide center margin-block pad">
+  <%= form_with url: search_path, method: :get, class: "flex align-center gap" do |form| %>
+    <%= form.label :q, "Search cards", class: "for-screen-reader" %>
+    <%= form.search_field :q, value: @search.query, placeholder: "Search cards", class: "input full-width", autofocus: true %>
+    <%= form.submit "Search", class: "btn" %>
+  <% end %>
+
+  <div id="search_results" class="txt-align-start" aria-live="polite">
+    <% if @search.terms.empty? %>
+      <p>Search cards by title, description, or comment.</p>
+    <% elsif @page.records.empty? %>
+      <p>No cards found for “<%= @search.query %>”.</p>
+    <% else %>
+      <%= with_manual_pagination :search_results, @page do %>
+        <% @page.records.each do |card| %>
+          <article class="margin-block pad-block border-bottom">
+            <h2><%= link_to highlight_search_text(card.title, @search.terms), card_path(card), data: { turbo_frame: "_top" } %></h2>
+            <p class="txt-small"><%= card.board.name %> · <%= local_datetime_tag card.created_at, style: :date %></p>
+            <% if card.description.present? %>
+              <p><%= highlight_search_text(search_excerpt(card.description.plain_text, @search.terms), @search.terms) %></p>
+            <% end %>
+            <% Array(@comments[card.id]).each do |comment| %>
+              <blockquote><%= highlight_search_text(search_excerpt(comment.body.plain_text, @search.terms), @search.terms) %></blockquote>
+            <% end %>
+          </article>
+        <% end %>
+      <% end %>
+    <% end %>
+  </div>
+</section>
