+  test "import builds searchable plain text for exports without it" do
+    card = cards(:logo)
+    data = {
+      "id" => ActiveRecord::Type::Uuid.generate,
+      "account_id" => card.account_id,
+      "record_type" => "Card",
+      "record_id" => card.id,
+      "name" => "description",
+      "body" => "<p>Imported <strong>searchneedle</strong> &amp; text</p>",
+      "created_at" => Time.current.iso8601,
+      "updated_at" => Time.current.iso8601
