new file mode 100644
index 0000000..3e01ce2
--- /dev/null
+++ b/app/helpers/searches_helper.rb
@@ -0,0 +1,18 @@
+module SearchesHelper
+  def highlight_search_text(text, terms)
+    safe_join(text.to_s.split(/(#{search_pattern(terms)})/).map.with_index do |part, index|
+      index.odd? ? tag.mark(part) : part
+    end)
+  end
+
+  def search_excerpt(text, terms)
+    text = text.to_s.squish
+    match = text.match(search_pattern(terms))
+    excerpt(text, match ? match[0] : "", radius: 150)
+  end
+
+  private
+    def search_pattern(terms)
+      Regexp.union(terms.sort_by { |term| -term.length }.map { |term| /#{Regexp.escape(term)}/i })
+    end
+end
