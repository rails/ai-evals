diff --git a/app/models/search.rb b/app/models/search.rb
new file mode 100644
index 0000000..c6243e3
--- /dev/null
+++ b/app/models/search.rb
@@ -0,0 +1,45 @@
+class Search
+  attr_reader :user, :query, :terms
+
+  def initialize(user, query)
+    @user = user
+    @query = query.to_s.strip
+    @terms = @query.split.uniq
+  end
+
+  def cards
+    if terms.any?
+      terms.reduce(user.accessible_cards.published) do |cards, term|
+        descriptions = rich_text_matching(term).where(record_type: "Card", name: "description")
+        comments = Comment.where(id: rich_text_matching(term).where(record_type: "Comment", name: "body").select(:record_id))
+
+        matches = Card.where("LOWER(cards.title) LIKE ? ESCAPE '!'", pattern_for(term))
+          .or(Card.where(id: descriptions.select(:record_id)))
+          .or(Card.where(id: comments.select(:card_id)))
+
+        cards.merge(matches)
+      end.reverse_chronologically
+    else
+      user.accessible_cards.none
+    end
+  end
+
+  def comments_for(cards)
+    bodies = terms.reduce(ActionText::RichText.none) do |bodies, term|
+      bodies.or(rich_text_matching(term))
+    end.where(record_type: "Comment", name: "body")
+
+    user.accessible_comments.joins(:card).merge(Card.published)
+      .where(card_id: cards.map(&:id), id: bodies.select(:record_id))
+      .with_rich_text_body.chronologically.group_by(&:card_id)
+  end
+
+  private
+    def rich_text_matching(term)
+      ActionText::RichText.where(account: user.account).where("LOWER(plain_text) LIKE ? ESCAPE '!'", pattern_for(term))
+    end
+
+    def pattern_for(term)
+      "%#{ActiveRecord::Base.sanitize_sql_like(term.downcase, "!")}%"
+    end
+end
