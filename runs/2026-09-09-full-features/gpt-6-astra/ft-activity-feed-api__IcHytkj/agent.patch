index 0000000..0cb7fc2
--- /dev/null
+++ b/app/views/activities/_activity.json.jbuilder
@@ -0,0 +1,32 @@
+json.(event, :id, :action)
+json.created_at event.created_at.utc
+json.description event.description_for(Current.user).to_plain_text
+json.url polymorphic_url(event.eventable)
+json.eventable_type event.eventable_type
+
+json.particulars do
+  case event.action
+  when "card_assigned", "card_unassigned"
+    json.assignee_ids event.assignee_ids
+  when "card_board_changed"
+    json.old_board event.particulars.dig("particulars", "old_board").to_s
+    json.new_board event.particulars.dig("particulars", "new_board").to_s
+  when "card_title_changed"
+    json.old_title event.particulars.dig("particulars", "old_title").to_s
+    json.new_title event.particulars.dig("particulars", "new_title").to_s
+  when "card_triaged"
+    json.column event.particulars.dig("particulars", "column").to_s
+  else
+    json.merge!({})
+  end
+end
+
+json.eventable do
+  case event.eventable
+  when Card then json.partial! "cards/card", card: event.eventable
+  when Comment then json.partial! "cards/comments/comment", comment: event.eventable
+  end
+end
+
+json.board event.board, partial: "boards/board", as: :board
+json.creator event.creator, partial: "users/user", as: :user
