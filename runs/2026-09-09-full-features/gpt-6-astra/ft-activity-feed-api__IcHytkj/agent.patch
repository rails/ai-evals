@@ -0,0 +1,52 @@
+# Activities
+
+## `GET /:account_slug/activities.json`
+
+Returns account activity as a flat array, newest first. Only events on boards the current user can access are returned. Results use the API's standard [pagination](../README.md#pagination); follow the `Link` header's `rel="next"` URL to fetch more activity.
+
+### Filters
+
+| Parameter | Type | Description |
+|-----------|------|-------------|
+| `creator_ids[]` | array of IDs | Only activity created by these users |
+| `board_ids[]` | array of IDs | Only activity on these boards, subject to the current user's access |
+
+Filters can be combined. For example:
+
+```http
+GET /1234567/activities.json?creator_ids[]=user_id&board_ids[]=board_id
+```
+
+### Event fields
+
+| Field | Description |
+|-------|-------------|
+| `id` | Event ID |
+| `action` | Event action (listed below) |
+| `created_at` | UTC timestamp |
+| `description` | The event's plain-text description |
+| `particulars` | Event-specific details (listed below) |
+| `url` | Browser URL for the card; comment events include an anchor to the comment |
+| `eventable_type` | `Card` or `Comment` |
+| `eventable` | The existing [card](cards.md) or [comment](comments.md) API representation |
+| `board` | The existing [board](boards.md) API representation |
+| `creator` | The existing [user](users.md) API representation |
+
+### Actions and particulars
+
+| Action | `particulars` fields |
+|--------|---------------------|
+| `card_assigned` | `assignee_ids` |
+| `card_unassigned` | `assignee_ids` |
+| `card_board_changed` | `old_board`, `new_board` (board names) |
+| `card_title_changed` | `old_title`, `new_title` |
+| `card_triaged` | `column` (column name) |
+| `card_published` | Empty object |
+| `card_closed` | Empty object |
+| `card_reopened` | Empty object |
+| `card_postponed` | Empty object |
+| `card_auto_postponed` | Empty object |
+| `card_sent_back_to_triage` | Empty object |
+| `comment_created` | Empty object |
+
+Missing board names, titles, and column names are returned as empty strings. Other particulars are not exposed. Deprecated `card_collection_changed` events are omitted.
diff --git a/test/controllers/activities_controller_test.rb b/test/controllers/activities_controller_test.rb
new file mode 100644
index 0000000..1515928
--- /dev/null
+++ b/test/controllers/activities_controller_test.rb
@@ -0,0 +1,206 @@
+require "test_helper"
+
+class ActivitiesControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in_as :kevin
+  end
+
+  test "index returns activity as a flat array newest first" do
+    get "/#{accounts(:"37s").external_account_id}/activities.json"
+
+    assert_response :success
+    assert_kind_of Array, response.parsed_body
+    expected = Event.where(board: users(:kevin).boards).order(created_at: :desc, id: :desc).pluck(:id)
+    assert_equal expected, response.parsed_body.pluck("id")
+  end
+
+  test "card activity uses the existing API representations" do
+    event = events(:logo_published)
+    activity = fetch_activity(event)
+
+    assert_equal %w[ id action created_at description particulars url eventable_type eventable board creator ].sort, activity.keys.sort
+    assert_equal event.action, activity["action"]
+    assert_equal event.created_at.utc.iso8601(3), activity["created_at"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal "Card", activity["eventable_type"]
+    assert_equal card_url(event.eventable), activity["url"]
+    assert_equal({}, activity["particulars"])
+
+    get card_path(event.eventable), as: :json
+    assert_equal response.parsed_body.except("steps"), activity["eventable"]
+    get board_path(event.board), as: :json
+    assert_equal response.parsed_body, activity["board"]
+    get user_path(event.creator), as: :json
+    assert_equal response.parsed_body, activity["creator"]
+  end
+
+  test "comment activity links to its card and comment anchor" do
+    event = events(:layout_commented)
+    comment = event.eventable
+    activity = fetch_activity(event)
+
+    assert_equal "Comment", activity["eventable_type"]
+    assert_equal card_url(comment.card, anchor: ActionView::RecordIdentifier.dom_id(comment)), activity["url"]
+    assert_equal event.description_for(users(:kevin)).to_plain_text, activity["description"]
+    assert_equal({}, activity["particulars"])
+
+    get card_comment_path(comment.card, comment), as: :json
+    assert_equal response.parsed_body, activity["eventable"]
+  end
+
+  test "includes timeline actions and title changes but not deprecated or unrelated actions" do
+    event = events(:logo_published)
+    actions = %w[ card_assigned card_unassigned card_published card_closed card_reopened
+      card_board_changed card_title_changed card_postponed card_auto_postponed card_triaged
+      card_sent_back_to_triage ]
+
+    actions.each do |action|
+      event.update_columns(action: action)
+      assert_equal action, fetch_activity(event)["action"]
+    end
+
+    %w[ card_collection_changed card_resumed unknown_action ].each do |action|
+      event.update_columns(action: action)
+      get activities_path, as: :json
+      assert_response :success
+      assert_not_includes response.parsed_body.pluck("id"), event.id
+    end
+  end
+
+  test "assignment particulars contain only assignee ids" do
+    event = events(:logo_assignment_jz)
+
+    %w[ card_assigned card_unassigned ].each do |action|
+      event.update_columns(action: action)
+      assert_equal({ "assignee_ids" => [ users(:jz).id ] }, fetch_activity(event)["particulars"])
+    end
+  end
+
+  test "board title and triage particulars expose their values and default missing values to empty strings" do
+    event = events(:logo_published)
+    {
+      "card_board_changed" => { "old_board" => "Old board", "new_board" => "New board" },
+      "card_title_changed" => { "old_title" => "Old title", "new_title" => "New title" },
+      "card_triaged" => { "column" => "In progress" }
+    }.each do |action, details|
+      event.update_columns(action: action, particulars: { "particulars" => details.merge("internal" => "hidden") })
+      assert_equal details, fetch_activity(event)["particulars"]
+
+      [ {}, { "particulars" => details.transform_values { nil } }, { "particulars" => details.transform_values { "" } } ].each do |particulars|
+        event.update_columns(particulars: particulars)
+        assert_equal details.transform_values { "" }, fetch_activity(event)["particulars"]
+      end
+    end
+  end
+
+  test "other activity does not expose internal particulars" do
+    event = events(:logo_published)
+    event.update_columns(particulars: { "internal" => "hidden", "particulars" => { "column" => "hidden" } })
+
+    assert_equal({}, fetch_activity(event)["particulars"])
+  end
+
+  test "filters by creator and board ids" do
+    with_current_user(:kevin) { cards(:logo).move_to(boards(:private)) }
+
+    get activities_path, params: { creator_ids: [ users(:david).id ], board_ids: [ boards(:writebook).id ] }, as: :json
+    assert_response :success
+
+    expected = Event.for_activity.where(board: boards(:writebook), creator: users(:david)).order(created_at: :desc, id: :desc).pluck(:id)
+    assert_not_empty expected
+    assert_equal expected, response.parsed_body.pluck("id")
+
+    get activities_path, params: { creator_ids: [ users(:david).id, users(:kevin).id ], board_ids: users(:kevin).boards.ids }, as: :json
+    assert_response :success
+    assert_equal Event.for_activity.where(board: users(:kevin).boards).count, response.parsed_body.size
+  end
+
+  test "unknown filters and boards in other accounts return no activity" do
+    cards(:radio).track_event("published", creator: users(:mike))
+
+    [ { creator_ids: [ "unknown" ] }, { board_ids: [ "unknown" ] }, { board_ids: [ boards(:miltons_wish_list).id ] } ].each do |filters|
+      get activities_path, params: filters, as: :json
+      assert_response :success
+      assert_equal [], response.parsed_body
+    end
+
+    get activities_path, as: :json
+    assert_response :success
+    assert_not_includes response.parsed_body.pluck("board").pluck("id"), boards(:miltons_wish_list).id
+  end
+
+  test "inaccessible card and comment activity is excluded even when requested" do
+    with_current_user(:kevin) { cards(:layout).move_to(boards(:private)) }
+    boards(:private).accesses.revoke_from(users(:david))
+    logout_and_sign_in_as :david
+
+    [ {}, { board_ids: [ boards(:private).id ] }, { board_ids: [ boards(:private).id, boards(:writebook).id ] } ].each do |filters|
+      get activities_path, params: filters, as: :json
+      assert_response :success
+      assert_not_includes response.parsed_body.pluck("id"), events(:layout_published).id
+      assert_not_includes response.parsed_body.pluck("id"), events(:layout_commented).id
+      assert_not_includes response.parsed_body.pluck("board").pluck("id"), boards(:private).id
+    end
+  end
+
+  test "paginates in stable newest first order and preserves filters in links" do
+    50.times do
+      cards(:logo).track_event("published", creator: users(:david))
+    end
+    Event.where(eventable: cards(:logo)).update_all(created_at: Time.current)
+
+    expected = Event.for_activity.where(board: boards(:writebook), creator: users(:david)).order(created_at: :desc, id: :desc).pluck(:id)
+    actual = []
+    next_page = activities_path(format: :json, creator_ids: [ users(:david).id ], board_ids: [ boards(:writebook).id ])
+    page_count = 0
+
+    while next_page
+      get next_page, as: :json
+      assert_response :success
+      actual.concat(response.parsed_body.pluck("id"))
+      page_count += 1
+      url = response.headers["Link"]&.match(/<([^>]+)>;\s*rel="next"/)&.captures&.first
+      next_page = url && URI.parse(url).request_uri
+    end
+
+    assert_operator page_count, :>, 1
+    assert_equal expected, actual
+
+    get activities_path(page: 100), as: :json
+    assert_response :success
+    assert_equal [], response.parsed_body
+  end
+
+  test "empty filters leave activity unfiltered" do
+    get activities_path, as: :json
+    expected = response.parsed_body.pluck("id")
+
+    get activities_path, params: { creator_ids: [], board_ids: [] }, as: :json
+    assert_response :success
+    assert_equal expected, response.parsed_body.pluck("id")
+  end
+
+  test "cannot access another account's activity" do
+    get activities_path(script_name: accounts(:initech).slug), as: :json
+    assert_response :forbidden
+  end
+
+  test "requires authentication and accepts API bearer tokens" do
+    sign_out
+    get activities_path, as: :json
+    assert_redirected_to new_session_path(script_name: nil)
+
+    get activities_path, as: :json, headers: { "Authorization" => "Bearer #{identity_access_tokens(:davids_api_token).token}" }
+    assert_response :success
+    assert_not_empty response.parsed_body
+  end
+
+  private
+    def fetch_activity(event)
+      get activities_path, as: :json
+      assert_response :success
+      response.parsed_body.find { |activity| activity["id"] == event.id }.tap do |activity|
+        assert_not_nil activity
+      end
+    end
+end
