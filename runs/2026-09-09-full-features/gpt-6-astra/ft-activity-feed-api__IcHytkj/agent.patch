+class ActivitiesController < ApplicationController
+  def index
+    set_page_and_extract_portion_from filtered_events.preloaded.order(created_at: :desc, id: :desc)
+  end
+
+  private
+    def filtered_events
+      creator_ids = Array(params[:creator_ids]).compact_blank
+      board_ids = Array(params[:board_ids]).compact_blank
+
+      events = Event.for_activity.where(board: Current.user.boards)
+      events = events.where(creator_id: creator_ids) if creator_ids.present?
+      events = events.where(board_id: board_ids) if board_ids.present?
+      events
+    end
+end
