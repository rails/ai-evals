diff --git a/app/models/user/erasable.rb b/app/models/user/erasable.rb
new file mode 100644
index 0000000..fd17b88
--- /dev/null
+++ b/app/models/user/erasable.rb
@@ -0,0 +1,37 @@
+module User::Erasable
+  extend ActiveSupport::Concern
+
+  ERASED_BYLINE = "Deleted author"
+  DEACTIVATED_ADDRESS = /-deactivated-[0-9a-f-]+@/
+
+  # Erase the account for good: everything personal goes, everything other
+  # people are still reading stays, attributed to nobody.
+  def erase
+    transaction do
+      erase_private_books
+      created_books.update_all(creator_id: nil, author: ERASED_BYLINE)
+
+      destroy!
+
+      SignInEvent.where(email_address: sign_in_addresses).delete_all
+    end
+  end
+
+  private
+    def erase_private_books
+      books = created_books.without_everyone_access
+
+      # Leaf's `has_many :edits, dependent: :delete_all` would strand the
+      # superseded copies, so the edits go first and take their leafables along.
+      Edit.where(leaf: Leaf.where(book: books)).destroy_all
+      books.destroy_all
+    end
+
+    # `deactivate` rewrote the address on the row but left the audit log under
+    # the one they signed in with. Only inferred for a hidden row: an active
+    # person whose real address contains "-deactivated-" must not cost a
+    # neighbour their audit rows.
+    def sign_in_addresses
+      [ email_address, (email_address.sub(DEACTIVATED_ADDRESS, "@") unless active?) ].compact.uniq
+    end
+end
