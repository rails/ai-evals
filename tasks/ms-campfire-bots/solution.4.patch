diff --git a/db/migrate/20261003150000_add_bots_quota_to_users.rb b/db/migrate/20261003150000_add_bots_quota_to_users.rb
new file mode 100644
index 0000000..ebcccb2
--- /dev/null
+++ b/db/migrate/20261003150000_add_bots_quota_to_users.rb
@@ -0,0 +1,18 @@
+class AddBotsQuotaToUsers < ActiveRecord::Migration[8.1]
+  def change
+    add_column :users, :bots_count, :integer, default: 0, null: false
+    add_column :users, :bots_quota, :integer, default: 5, null: false
+
+    up_only do
+      execute <<~SQL
+        UPDATE users SET bots_count = (
+          SELECT COUNT(*) FROM users AS bots WHERE bots.creator_id = users.id AND bots.role = 2 AND bots.status = 0
+        )
+      SQL
+      execute "UPDATE users SET bots_quota = MAX(bots_count, bots_quota)"
+    end
+
+    # Administrators (role 1) are not limited
+    add_check_constraint :users, "bots_count <= bots_quota OR role = 1", name: "bots_within_quota"
+  end
+end
