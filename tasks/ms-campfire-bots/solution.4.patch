diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
index 38e8ee6..e760fa4 100644
--- a/test/controllers/bots_controller_test.rb
+++ b/test/controllers/bots_controller_test.rb
@@ -96,4 +96,44 @@ class BotsControllerTest < ActionDispatch::IntegrationTest
     post bots_url, params: { user: { name: "Bender's Friend", auto_join_open_rooms: "1" } }
     assert_equal Rooms::Open.count, User.bot.last.rooms.count
   end
+
+  test "members can't add bots beyond the limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    sign_in :kevin
+
+    post bots_url, params: { user: { name: "First" } }
+    assert_redirected_to bots_url
+
+    get bots_url
+    assert_select "a[href=?]", new_bot_path, count: 0
+    assert_select "p", text: /reached the limit of 1 bot/
+
+    get new_bot_url
+    assert_redirected_to bots_url
+
+    assert_no_difference -> { User.bot.count } do
+      post bots_url, params: { user: { name: "Second" } }
+    end
+    assert_redirected_to bots_url
+    assert_equal "You can't have more than 1 bots", flash[:alert]
+  end
+
+  test "deleted bots don't count towards the limit" do
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+    sign_in :kevin
+    post bots_url, params: { user: { name: "First" } }
+    delete bot_url(User.bot.last)
+
+    assert_difference -> { User.bot.count }, +1 do
+      post bots_url, params: { user: { name: "Second" } }
+    end
+  end
+
+  test "administrators are not limited" do
+    accounts(:signal).update!(settings: { bots_per_member: 0 })
+
+    assert_difference -> { User.bot.count }, +1 do
+      post bots_url, params: { user: { name: "Admin's Bot" } }
+    end
+  end
 end
diff --git a/test/models/user/bot_test.rb b/test/models/user/bot_test.rb
index 4d476ed..84ee779 100644
--- a/test/models/user/bot_test.rb
+++ b/test/models/user/bot_test.rb
@@ -125,4 +125,69 @@ class User::BotTest < ActiveSupport::TestCase
       Current.set(user: users(:david)) { Rooms::Direct.find_or_create_for([ users(:david), bot ]) }
     end
   end
+
+  test "creators can't exceed their bot quota" do
+    users(:kevin).update!(bots_quota: 1)
+    User.create_bot!(name: "First", creator: users(:kevin))
+    assert_equal 1, users(:kevin).reload.bots_count
+
+    assert_raises ActiveRecord::RecordInvalid do
+      User.create_bot!(name: "Second", creator: users(:kevin))
+    end
+    assert User.create_bot!(name: "Console")
+  end
+
+  test "the database enforces the quota when concurrent requests pass the check" do
+    users(:kevin).update!(bots_quota: 1)
+    creator_in_one_request, creator_in_another = User.find(users(:kevin).id), User.find(users(:kevin).id)
+
+    User.create_bot!(name: "First", creator: creator_in_one_request)
+
+    assert_no_difference -> { User.bot.count } do
+      assert_raises ActiveRecord::CheckViolation do
+        User.create_bot!(name: "Second", creator: creator_in_another)
+      end
+    end
+    assert_equal 1, users(:kevin).reload.bots_count
+  end
+
+  test "administrators have no quota" do
+    users(:david).update!(bots_quota: 0)
+
+    assert_difference -> { users(:david).reload.bots_count }, +2 do
+      2.times { |index| User.create_bot!(name: "Admin's #{index}", creator: users(:david)) }
+    end
+  end
+
+  test "demoting an administrator keeps their bots" do
+    users(:david).update!(bots_quota: 0)
+    2.times { |index| User.create_bot!(name: "Admin's #{index}", creator: users(:david)) }
+
+    users(:david).reload.member!
+    assert_equal 2, users(:david).bots_quota
+  end
+
+  test "deleted bots release the quota" do
+    bot = User.create_bot!(name: "First", creator: users(:kevin))
+    assert_equal 1, users(:kevin).reload.bots_count
+
+    bot.deactivate
+    assert_equal 0, users(:kevin).reload.bots_count
+  end
+
+  test "new people get the account's quota" do
+    accounts(:signal).update!(settings: { bots_per_member: 2 })
+    user = User.create!(name: "Newcomer", email_address: "newcomer@example.com", password: "secret123456")
+
+    assert_equal 2, user.bots_quota
+  end
+
+  test "changing the account's limit updates everyone's quota but never below their bot count" do
+    3.times { |index| User.create_bot!(name: "Kevin's #{index}", creator: users(:kevin)) }
+
+    accounts(:signal).update!(settings: { bots_per_member: 1 })
+
+    assert_equal 3, users(:kevin).reload.bots_quota
+    assert_equal 1, users(:jz).reload.bots_quota
+  end
 end
