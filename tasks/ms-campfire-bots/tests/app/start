#!/usr/bin/env bash
# Rails: the production-mode server (qa environment), in the foreground, reachable on every interface.
set -euo pipefail
cd "${WORKDIR:-/app}"
source "$(dirname "$0")/env"

# A fixed size: config/puma.rb scales workers with the CPU count, and a sandbox can report
# the host's (48 CPUs on Daytona gave 32 workers in 2 GB, and no request got an answer)
export WEB_CONCURRENCY="${WEB_CONCURRENCY:-2}" JOB_CONCURRENCY="${JOB_CONCURRENCY:-2}"
rm -f tmp/pids/server.pid
exec bin/rails server --binding 0.0.0.0 --port "${E2E_APP_PORT:-3000}"
