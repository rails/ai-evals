#!/usr/bin/env bash
# Rails: the codebase's architecture rules (archspec). Prints the violations; exits non-zero on any.
# Optional: a stack without this script has no architecture check in its suite.
set -uo pipefail
cd "${WORKDIR:-/app}"
cp "$(dirname "$0")/../Archspec.rb" Archspec.rb
archspec check
status=$?
rm -f Archspec.rb
exit $status
