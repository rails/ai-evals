@@ -0,0 +1,98 @@
+require "test_helper"
+
+class WebhookTest < ActiveSupport::TestCase
+  setup do
+    Resolv.stubs(:getaddresses).returns([ "93.184.216.34" ])
+  end
+
+  test "payload" do
+    message = messages(:first)
+    message_path = Rails.application.routes.url_helpers.room_at_message_path(message.room, message)
+    bot_messages_path = Rails.application.routes.url_helpers.room_bot_messages_path(message.room, users(:bender).bot_code)
+
+    WebMock.stub_request(:post, webhooks(:bender).url).
+      with(headers: { "Content-Type" => "application/json" }, body: hash_including(
+        event: "mention",
+        author: { id: message.creator.id, name: message.creator.name },
+        room: { id: message.room.id, name: message.room.name, reply_to: bot_messages_path },
+        message: { id: message.id, body: { text: "First post!", html: "First post!" }, link: message_path },
+      ))
+
+    response = webhooks(:bender).deliver(messages(:first))
+    assert_equal 200, response.code.to_i
+  end
+
+  test "payload text has the bot mention stripped" do
+    message = rooms(:watercooler).messages.create!(body: "<div>#{mention_attachment_for(:bender)} restart the build please</div>", creator: users(:david))
+
+    WebMock.stub_request(:post, webhooks(:bender).url).
+      with(body: hash_including(message: hash_including(body: hash_including(text: "restart the build please"))))
+
+    response = webhooks(:bender).deliver(message)
+    assert_equal 200, response.code.to_i
+  end
+
+  test "delivery with no content reply" do
+    WebMock.stub_request(:post, webhooks(:bender).url).to_return(status: 204)
+
+    assert_no_difference -> { Message.count } do
+      webhooks(:bender).deliver(messages(:first))
+    end
+  end
+
+  test "delivery with OK text reply" do
+    WebMock.stub_request(:post, webhooks(:bender).url).to_return(status: 200, body: "Hello back!", headers: { "Content-Type" => "text/plain" })
+    webhooks(:bender).deliver(messages(:first))
+
+    reply_message = Message.last
+    assert_equal "Hello back!", reply_message.body.to_plain_text
+    assert_equal users(:bender), reply_message.creator
+  end
+
+  test "delivery with OK HTML reply" do
+    WebMock.stub_request(:post, webhooks(:bender).url).to_return(status: 200, body: "<p>Hello <strong>back</strong>!</p>", headers: { "Content-Type" => "text/html; charset=utf-8" })
+    webhooks(:bender).deliver(messages(:first))
+
+    assert_equal "Hello back!", Message.last.body.to_plain_text
+  end
+
+  test "delivery with error reply" do
+    WebMock.stub_request(:post, webhooks(:bender).url).to_return(status: 500, body: "Internal Error!")
+
+    assert_no_difference -> { Message.count } do
+      webhooks(:bender).deliver(messages(:first))
+    end
+  end
+
+  test "delivery that times out" do
+    Webhook.any_instance.stubs(:post).raises(Net::OpenTimeout)
+
+    assert_no_difference -> { Message.count } do
+      webhooks(:bender).deliver(messages(:first))
+    end
+  end
+
+  test "delivery to a host that turned private" do
+    Resolv.stubs(:getaddresses).with("example.com").returns([ "10.0.0.5" ])
+
+    assert_nil webhooks(:bender).deliver(messages(:first))
+    assert_not_requested :post, webhooks(:bender).url
+  end
+
+  test "url must be public" do
+    Resolv.stubs(:getaddresses).with("localhost").returns([ "127.0.0.1" ])
+    Resolv.stubs(:getaddresses).with("internal.example.com").returns([ "10.0.0.5" ])
+
+    assert Webhook.new(user: users(:bender), url: "https://bots.example.com/hook").valid?
+
+    %w[ http://localhost/hook http://127.0.0.1/hook http://internal.example.com/hook ftp://bots.example.com/hook not-a-url ].each do |url|
+      assert_not Webhook.new(user: users(:bender), url: url).valid?, "#{url} must be rejected"
+    end
+  end
+
+  test "url must not point to Campfire itself" do
+    Current.request = ActionDispatch::TestRequest.create("HTTP_HOST" => "chat.example.com")
+
+    assert_not Webhook.new(user: users(:bender), url: "https://chat.example.com/rooms").valid?
+  end
+end
