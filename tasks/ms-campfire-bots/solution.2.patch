diff --git a/app/models/webhook.rb b/app/models/webhook.rb
new file mode 100644
index 0000000..562f116
--- /dev/null
+++ b/app/models/webhook.rb
@@ -0,0 +1,88 @@
+require "net/http"
+require "uri"
+require "restricted_http/private_network_guard"
+
+class Webhook < ApplicationRecord
+  ENDPOINT_TIMEOUT = 7.seconds
+
+  belongs_to :user
+
+  validate :ensure_url_is_public, if: :url_changed?
+
+  def deliver(message)
+    post(payload(message)).tap do |response|
+      if text = extract_text_from(response)
+        receive_text_reply_to(message.room, text: text)
+      end
+    end
+  rescue Net::OpenTimeout, Net::ReadTimeout
+    # A bot that doesn't answer in time simply doesn't reply
+  rescue RestrictedHTTP::Violation, Surfguard::Unresolvable
+    # The URL no longer resolves to a public address
+  end
+
+  private
+    def post(payload)
+      http.request \
+        Net::HTTP::Post.new(uri, "Content-Type" => "application/json").tap { |request| request.body = payload }
+    end
+
+    def http
+      Net::HTTP.new(uri.host, uri.port).tap do |http|
+        http.ipaddr = RestrictedHTTP::PrivateNetworkGuard.resolve(uri.host)
+        http.use_ssl = (uri.scheme == "https")
+        http.open_timeout = ENDPOINT_TIMEOUT
+        http.read_timeout = ENDPOINT_TIMEOUT
+      end
+    end
+
+    def uri
+      @uri ||= URI(url)
+    end
+
+    # Bots must not reach into the private network or back into Campfire itself
+    def ensure_url_is_public
+      parsed_url = URI.parse(url.to_s)
+
+      unless parsed_url.is_a?(URI::HTTP) && !own_host?(parsed_url.host) && Surfguard.resolvable_public_ip?(parsed_url.to_s)
+        errors.add :url, "must be a public address"
+      end
+    rescue URI::InvalidURIError
+      errors.add :url, "is invalid"
+    end
+
+    def own_host?(host)
+      host.to_s.casecmp?(Current.request_host.to_s)
+    end
+
+    def payload(message)
+      {
+        event:   "mention",
+        author:  { id: message.creator.id, name: message.creator.name },
+        room:    { id: message.room.id, name: message.room.name, reply_to: room_bot_messages_path(message) },
+        message: { id: message.id, body: { text: without_recipient_mentions(message.plain_text_body), html: message.body.body.to_html }, link: message_path(message) }
+      }.to_json
+    end
+
+    def message_path(message)
+      Rails.application.routes.url_helpers.room_at_message_path(message.room, message)
+    end
+
+    def room_bot_messages_path(message)
+      Rails.application.routes.url_helpers.room_bot_messages_path(message.room, user.bot_code)
+    end
+
+    def extract_text_from(response)
+      String.new(response.body).force_encoding("UTF-8") if response.code == "200" && response.content_type.in?(%w[ text/html text/plain ])
+    end
+
+    def receive_text_reply_to(room, text:)
+      room.messages.create!(body: text, creator: user).broadcast_create
+    end
+
+    def without_recipient_mentions(body)
+      body \
+        .gsub(user.attachable_plain_text_representation(nil), "") # Remove mentions of the recipient user
+        .gsub(/\A\p{Space}+|\p{Space}+\z/, "") # Remove leading and trailing whitespace uncluding unicode spaces
+    end
+end
