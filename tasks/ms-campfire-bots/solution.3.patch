@@ -58,9 +58,71 @@ class User::BotTest < ActiveSupport::TestCase
     WebMock.stub_request(:post, webhooks(:bender).url).to_return(status: 200)
 
     perform_enqueued_jobs only: Bot::WebhookJob do
-      users(:bender).deliver_webhook_later(messages(:first))
+      users(:bender).deliver_webhook_later(:mention, messages(:first))
     end
 
     assert_requested :post, webhooks(:bender).url
   end
+
+  test "bots do not join open rooms unless asked to" do
+    bot = User.create_bot!(name: "Bender")
+    assert_empty bot.rooms
+
+    room = Rooms::Open.create!(name: "New open room", creator: users(:david))
+    assert_not_includes room.users, bot
+  end
+
+  test "auto-joining bots join existing open rooms and get a joined event per room" do
+    open_rooms = Rooms::Open.count
+    assert_operator open_rooms, :>, 1
+
+    assert_enqueued_jobs open_rooms, only: Bot::WebhookJob do
+      bot = User.create_bot!(name: "Bender", auto_join_open_rooms: true, webhook_url: "https://example.com/hook")
+      assert_equal Rooms::Open.pluck(:id).sort, bot.rooms.pluck(:id).sort
+    end
+  end
+
+  test "auto-joining bots join new open rooms" do
+    bot = User.create_bot!(name: "Bender", auto_join_open_rooms: true, webhook_url: "https://example.com/hook")
+
+    assert_enqueued_jobs 1, only: Bot::WebhookJob do
+      room = Rooms::Open.create!(name: "New open room", creator: users(:david))
+      assert_includes room.users, bot
+    end
+  end
+
+  test "auto-joining bots join closed rooms that become open" do
+    bot = User.create_bot!(name: "Bender", auto_join_open_rooms: true, webhook_url: "https://example.com/hook")
+    assert_not_includes rooms(:designers).users, bot
+
+    assert_enqueued_jobs 1, only: Bot::WebhookJob do
+      room = rooms(:designers).becomes!(Rooms::Open)
+      room.save!
+      assert_includes room.users, bot
+    end
+  end
+
+  test "turning auto-join on joins only the missing open rooms" do
+    bot = User.create_bot!(name: "Bender", webhook_url: "https://example.com/hook")
+    rooms(:pets).memberships.grant_to(bot) if rooms(:pets).open?
+    already_joined = bot.rooms.opens.count
+
+    assert_enqueued_jobs Rooms::Open.count - already_joined, only: Bot::WebhookJob do
+      bot.update_bot!(auto_join_open_rooms: true, webhook_url: "https://example.com/hook")
+    end
+
+    assert_equal Rooms::Open.count, bot.rooms.opens.count
+  end
+
+  test "bots get a joined event when added to a closed room, not to a direct room" do
+    bot = User.create_bot!(name: "Bender", webhook_url: "https://example.com/hook")
+
+    assert_enqueued_jobs 1, only: Bot::WebhookJob do
+      rooms(:designers).memberships.revise(granted: [ bot ])
+    end
+
+    assert_no_enqueued_jobs only: Bot::WebhookJob do
+      Current.set(user: users(:david)) { Rooms::Direct.find_or_create_for([ users(:david), bot ]) }
+    end
+  end
 end
