@@ -0,0 +1,37 @@
+require "test_helper"
+
+class Bots::SuspensionsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    users(:bender).suspend(:webhook_failures)
+  end
+
+  test "bots page shows suspended bots" do
+    sign_in :david
+    get bots_url
+
+    assert_select "span", text: "Suspended: its webhook kept failing"
+    assert_select "form[action=?]", bot_suspension_path(users(:bender))
+  end
+
+  test "administrators reactivate bots" do
+    sign_in :david
+    delete bot_suspension_url(users(:bender))
+
+    assert_redirected_to bots_url
+    assert users(:bender).reload.active?
+  end
+
+  test "members can't reactivate their bots" do
+    bot = User.create_bot!(name: "Chatty", creator: users(:kevin))
+    bot.suspend(:flooding)
+    sign_in :kevin
+
+    get bots_url
+    assert_select "span", text: "Suspended: posted too many messages"
+    assert_select "form[action=?]", bot_suspension_path(bot), count: 0
+
+    delete bot_suspension_url(bot)
+    assert_response :forbidden
+    assert bot.reload.suspended?
+  end
+end
