     assert_equal rooms(:watercooler), reply_message.room
     assert_equal users(:bender), reply_message.creator
   end
+
+  test "a success resets the failure streak" do
+    webhooks(:bender).update!(consecutive_failures: 3)
+    WebMock.stub_request(:post, webhooks(:bender).url).to_return(status: 204)
+
+    webhooks(:bender).deliver_mention(messages(:first))
+    assert_equal 0, webhooks(:bender).reload.consecutive_failures
+  end
+
+  test "failing deliveries suspend the bot" do
+    WebMock.stub_request(:post, webhooks(:bender).url).
+      to_return(status: 500).then.to_timeout.then.to_raise(Errno::ECONNREFUSED).then.to_return(status: 404)
+
+    (Webhook::FAILURES_LIMIT - 1).times { webhooks(:bender).deliver_mention(messages(:first)) }
+    assert users(:bender).reload.active?
+
+    webhooks(:bender).deliver_mention(messages(:first))
+    assert users(:bender).reload.suspended?
+    assert users(:bender).suspended_for_webhook_failures?
+  end
+
+  test "replies are dropped while the bot floods the room" do
+    cache, Rails.cache = Rails.cache, ActiveSupport::Cache::MemoryStore.new
+    User::Suspendable::FLOOD_LIMIT.times { rooms(:watercooler).messages.create!(body: "Spam", creator: users(:bender)) }
+    WebMock.stub_request(:post, webhooks(:bender).url).to_return(status: 200, body: "One more", headers: { "Content-Type" => "text/plain" })
+
+    assert_no_difference -> { Message.count } do
+      webhooks(:bender).deliver_mention(messages(:first))
+    end
+  ensure
+    Rails.cache = cache
+  end
 end
