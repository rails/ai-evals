diff --git a/app/models/user/suspendable.rb b/app/models/user/suspendable.rb
new file mode 100644
index 0000000..ef6324a
--- /dev/null
+++ b/app/models/user/suspendable.rb
@@ -0,0 +1,73 @@
+# Bots that flood rooms or whose webhooks keep failing get suspended. Only administrators can reactivate them.
+module User::Suspendable
+  extend ActiveSupport::Concern
+
+  FLOOD_LIMIT = 10
+  FLOOD_WINDOW = 10.seconds
+  COOLDOWN = 30.seconds
+  COOLDOWN_VIOLATIONS_LIMIT = 5
+
+  included do
+    enum :suspension_reason, %w[ flooding webhook_failures ].index_by(&:itself), prefix: :suspended_for
+  end
+
+  def suspend(reason)
+    update! status: :suspended, suspension_reason: reason
+  end
+
+  def reactivate!
+    transaction do
+      update! status: :active, suspension_reason: nil
+      webhook&.update!(consecutive_failures: 0)
+    end
+    Rails.cache.delete cooldown_key
+  end
+
+  # A bot posts at most FLOOD_LIMIT messages per FLOOD_WINDOW. Going over starts a cooldown;
+  # every message rejected during the cooldown is a violation, and too many suspend the bot.
+  def allowed_to_post?
+    if cooling_down?
+      register_cooldown_violation
+      false
+    elsif flooding?
+      start_cooldown
+      false
+    else
+      true
+    end
+  end
+
+  def cooldown_remaining
+    (cooldown_started_at + COOLDOWN - Time.current).ceil if cooling_down?
+  end
+
+  private
+    def flooding?
+      messages.where(created_at: FLOOD_WINDOW.ago..).count >= FLOOD_LIMIT
+    end
+
+    def cooling_down?
+      cooldown_started_at.present?
+    end
+
+    def cooldown_started_at
+      Rails.cache.read(cooldown_key)
+    end
+
+    def start_cooldown
+      Rails.cache.write cooldown_key, Time.current, expires_in: COOLDOWN
+    end
+
+    def register_cooldown_violation
+      violations = Rails.cache.increment(cooldown_violations_key, 1, expires_in: COOLDOWN)
+      suspend(:flooding) if violations.to_i >= COOLDOWN_VIOLATIONS_LIMIT
+    end
+
+    def cooldown_key
+      "bots/#{id}/cooldown"
+    end
+
+    def cooldown_violations_key
+      "bots/#{id}/cooldown/#{cooldown_started_at.to_i}/violations"
+    end
+end
