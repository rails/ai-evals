diff --git a/test/models/user/suspendable_test.rb b/test/models/user/suspendable_test.rb
new file mode 100644
index 0000000..24f1be4
--- /dev/null
+++ b/test/models/user/suspendable_test.rb
@@ -0,0 +1,81 @@
+require "test_helper"
+
+class User::SuspendableTest < ActiveSupport::TestCase
+  setup do
+    @cache, Rails.cache = Rails.cache, ActiveSupport::Cache::MemoryStore.new
+    @bot = users(:bender)
+  end
+
+  teardown { Rails.cache = @cache }
+
+  test "a bot may post up to the flood limit" do
+    post_messages(User::Suspendable::FLOOD_LIMIT - 1)
+    assert @bot.allowed_to_post?
+  end
+
+  test "going over the flood limit starts a cooldown" do
+    post_messages(User::Suspendable::FLOOD_LIMIT)
+
+    assert_not @bot.allowed_to_post?
+    assert_equal 30, @bot.cooldown_remaining
+
+    travel User::Suspendable::COOLDOWN + 1.second
+    assert @bot.allowed_to_post?
+  end
+
+  test "posting during the cooldown suspends the bot" do
+    post_messages(User::Suspendable::FLOOD_LIMIT)
+    assert_not @bot.allowed_to_post?
+
+    (User::Suspendable::COOLDOWN_VIOLATIONS_LIMIT - 1).times { assert_not @bot.allowed_to_post? }
+    assert @bot.reload.active?
+
+    assert_not @bot.allowed_to_post?
+    assert @bot.reload.suspended?
+    assert @bot.suspended_for_flooding?
+  end
+
+  test "violations don't carry over to the next cooldown" do
+    post_messages(User::Suspendable::FLOOD_LIMIT)
+    assert_not @bot.allowed_to_post?
+    (User::Suspendable::COOLDOWN_VIOLATIONS_LIMIT - 1).times { @bot.allowed_to_post? }
+
+    travel User::Suspendable::COOLDOWN + 1.second
+    post_messages(User::Suspendable::FLOOD_LIMIT)
+    assert_not @bot.allowed_to_post?
+    assert_not @bot.allowed_to_post?
+
+    assert @bot.reload.active?
+  end
+
+  test "reactivate" do
+    @bot.suspend(:flooding)
+    webhooks(:bender).update!(consecutive_failures: 10)
+
+    @bot.reactivate!
+
+    assert @bot.reload.active?
+    assert_nil @bot.suspension_reason
+    assert_equal 0, webhooks(:bender).reload.consecutive_failures
+  end
+
+  test "suspended bots don't get webhooks" do
+    @bot.suspend(:flooding)
+
+    @bot.deliver_webhook(:mention, messages(:first))
+    assert_not_requested :post, webhooks(:bender).url
+  end
+
+  test "deleting a suspended bot releases its creator's quota" do
+    bot = User.create_bot!(name: "Chatty", creator: users(:kevin))
+    bot.suspend(:flooding)
+
+    bot.deactivate
+    assert_equal 0, users(:kevin).reload.bots_count
+  end
+
+  private
+    def post_messages(count)
+      count.times { rooms(:watercooler).messages.create!(body: "Spam", creator: @bot) }
+    end
+end
