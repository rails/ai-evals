diff --git a/test/test_helpers/network_test_helper.rb b/test/test_helpers/network_test_helper.rb
new file mode 100644
index 0000000..5b12b59
--- /dev/null
+++ b/test/test_helpers/network_test_helper.rb
@@ -0,0 +1,11 @@
+module NetworkTestHelper
+  # URL validation resolves hostnames through real DNS (see RestrictedHTTP::PrivateNetworkGuard),
+  # which WebMock can't intercept. Checked once at boot so per-test Resolv stubs don't interfere.
+  DNS_AVAILABLE = Resolv.getaddresses("example.com").any?
+
+  # Skip tests that depend on DNS resolution when running in an offline sandbox
+  # (e.g., a Docker container with no outside network access).
+  def skip_unless_dns
+    skip "DNS resolution is unavailable (offline sandbox)" unless DNS_AVAILABLE
+  end
+end
