+require "test_helper"
+
+class User::BotTest < ActiveSupport::TestCase
+  test "create bot" do
+    token = "5M0aLYwQyBXO"
+    SecureRandom.stubs(:alphanumeric).returns(token)
+
+    bot = User.create_bot!(name: "Bender")
+    assert_equal "#{bot.id}-#{token}", bot.bot_code
+  end
+
+  test "authenticate" do
+    bot = User.create_bot!(name: "Bender")
+
+    assert_equal bot, User.authenticate_bot(bot.bot_code)
+    assert_nil User.authenticate_bot("#{bot.id}-wrong")
+    assert_nil User.authenticate_bot("#{users(:david).id}-")
+  end
+
+  test "bots by creator" do
+    bot = users(:kevin).create_bot!(name: "Bender")
+
+    assert_equal [ bot ], users(:kevin).bots
+    assert_empty users(:jz).bots
+  end
+end
