diff --git a/test/controllers/bots_controller_test.rb b/test/controllers/bots_controller_test.rb
new file mode 100644
index 0000000..423581b
--- /dev/null
+++ b/test/controllers/bots_controller_test.rb
@@ -0,0 +1,69 @@
+require "test_helper"
+
+class BotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    sign_in :david
+  end
+
+  test "index" do
+    get bots_url
+    assert_response :ok
+    assert_select "input[value=?]", users(:bender).bot_code
+  end
+
+  test "index shows bot owners to administrators" do
+    users(:bender).update!(creator: users(:kevin))
+
+    get bots_url
+    assert_select "a[href=?]", user_path(users(:kevin)), text: "Kevin"
+
+    sign_in :kevin
+    get bots_url
+    assert_select "a[href=?]", user_path(users(:kevin)), text: "Kevin", count: 0
+  end
+
+  test "create" do
+    get new_bot_url
+    assert_response :ok
+
+    post bots_url, params: { user: { name: "Bender's Friend" } }
+    assert_redirected_to bots_url
+    assert_equal "Bender's Friend", User.bot.last.name
+    assert_equal users(:david), User.bot.last.creator
+  end
+
+  test "update" do
+    get edit_bot_url(users(:bender))
+    assert_response :ok
+
+    put bot_url(users(:bender)), params: { user: { name: "Bender's New Friend" } }
+    assert_redirected_to bots_url
+    assert_equal "Bender's New Friend", users(:bender).reload.name
+  end
+
+  test "destroy" do
+    assert_difference -> { User.active_bots.count }, -1 do
+      delete bot_url(users(:bender))
+    end
+
+    assert users(:bender).reload.deactivated?
+  end
+
+  test "members manage only their own bots" do
+    sign_in :kevin
+    bot = User.create_bot!(name: "Kevin's Bot", creator: users(:kevin))
+
+    get bots_url
+    assert_select "input[value=?]", bot.bot_code
+    assert_select "input[value=?]", users(:bender).bot_code, count: 0
+
+    assert_raises ActiveRecord::RecordNotFound do
+      get edit_bot_url(users(:bender))
+    end
+
+    assert_raises ActiveRecord::RecordNotFound do
+      delete bot_url(users(:bender))
+    end
+    assert users(:bender).reload.active?
+  end
+end
diff --git a/test/controllers/messages/by_bots_controller_test.rb b/test/controllers/messages/by_bots_controller_test.rb
new file mode 100644
index 0000000..6198d00
--- /dev/null
+++ b/test/controllers/messages/by_bots_controller_test.rb
@@ -0,0 +1,96 @@
+require "test_helper"
+
+class Messages::ByBotsControllerTest < ActionDispatch::IntegrationTest
+  setup do
+    @room = rooms(:watercooler)
+  end
+
+  test "create" do
+    assert_difference -> { Message.count }, +1 do
+      post room_bot_messages_url(@room, users(:bender).bot_code), params: +"Hello Bot World!"
+    end
+
+    message = Message.last
+    assert_response :created
+    assert_equal message_url(message), response.location
+    assert_equal "Hello Bot World!", message.plain_text_body
+    assert_equal users(:bender), message.creator
+  end
+
+  test "create with UTF-8 content" do
+    assert_difference -> { Message.count }, +1 do
+      post room_bot_messages_url(@room, users(:bender).bot_code), params: +"Hello 👋!"
+      assert_equal "Hello 👋!", Message.last.plain_text_body
+    end
+  end
+
+  test "create with invalid UTF-8 content" do
+    assert_difference -> { Message.count }, +1 do
+      post room_bot_messages_url(@room, users(:bender).bot_code), params: "Caf\xE9".b, headers: { "Content-Type" => "text/plain" }
+    end
+
+    assert_response :created
+    assert_equal "Caf\uFFFD", Message.last.plain_text_body
+  end
+
+  test "create file" do
+    assert_difference -> { Message.count }, +1 do
+      post room_bot_messages_url(@room, users(:bender).bot_code), params: { attachment: fixture_file_upload("moon.jpg", "image/jpeg") }
+      assert Message.last.attachment.present?
+    end
+  end
+
+  test "create without body or attachment" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, users(:bender).bot_code), params: +""
+    end
+
+    assert_response :unprocessable_content
+  end
+
+  test "create in a room the bot is not a member of" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(rooms(:designers), users(:bender).bot_code), params: +"Hello!"
+    end
+
+    assert_response :not_found
+  end
+
+  test "create with invalid code" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, "#{users(:bender).id}-invalid"), params: +"Hello!"
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "create can't be abused to post messages as any user" do
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(rooms(:bender_and_kevin), "#{users(:kevin).id}-"), params: +"Hello 👋!"
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "create ignores the session of a signed-in user" do
+    sign_in :kevin
+
+    assert_no_difference -> { Message.count } do
+      post room_bot_messages_url(@room, "#{users(:kevin).id}-"), params: +"Hello!"
+    end
+
+    assert_response :unauthorized
+  end
+
+  test "deactivated bots can't post" do
+    users(:bender).deactivate
+
+    post room_bot_messages_url(@room, users(:bender).bot_code), params: +"Hello!"
+    assert_response :unauthorized
+  end
+
+  test "bot code does not grant access to other actions" do
+    get room_messages_url(@room, bot_code: users(:bender).bot_code, format: :json)
+    assert_redirected_to new_session_url
+  end
+end
