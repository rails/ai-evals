diff --git a/app/models/user/bot.rb b/app/models/user/bot.rb
new file mode 100644
index 0000000..1b11712
--- /dev/null
+++ b/app/models/user/bot.rb
@@ -0,0 +1,39 @@
+module User::Bot
+  extend ActiveSupport::Concern
+
+  included do
+    scope :active_bots, -> { active.where(role: :bot) }
+    scope :without_bots, -> { where.not(role: :bot) }
+
+    belongs_to :creator, class_name: "User", optional: true
+    has_many :bots, -> { active_bots }, class_name: "User", foreign_key: :creator_id
+  end
+
+  class_methods do
+    def create_bot!(attributes)
+      User.create!(**attributes, bot_token: generate_bot_token, role: :bot)
+    end
+
+    def authenticate_bot(bot_code)
+      bot_id, bot_token = bot_code.to_s.split("-")
+      active_bots.find_by(id: bot_id, bot_token: bot_token)
+    end
+
+    def generate_bot_token
+      SecureRandom.alphanumeric(12)
+    end
+  end
+
+  # A bot owned by this person
+  def create_bot!(attributes)
+    User.create_bot! attributes.merge(creator: self)
+  end
+
+  def deactivate!
+    deactivate
+  end
+
+  def bot_code
+    "#{id}-#{bot_token}"
+  end
+end
