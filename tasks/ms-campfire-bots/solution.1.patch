diff --git a/app/controllers/bots_controller.rb b/app/controllers/bots_controller.rb
new file mode 100644
index 0000000..eb81d4c
--- /dev/null
+++ b/app/controllers/bots_controller.rb
@@ -0,0 +1,43 @@
+class BotsController < ApplicationController
+  before_action :set_bot, only: %i[ edit update destroy ]
+
+  def index
+    @bots = bot_scope.includes(:creator).ordered
+  end
+
+  def new
+    @bot = User.active_bots.new
+  end
+
+  def create
+    Current.user.create_bot! bot_params
+    redirect_to bots_url
+  end
+
+  def edit
+  end
+
+  def update
+    @bot.update! bot_params
+    redirect_to bots_url
+  end
+
+  def destroy
+    @bot.deactivate!
+    redirect_to bots_url
+  end
+
+  private
+    # Administrators manage all bots, members only the ones they created.
+    def bot_scope
+      Current.user.administrator? ? User.active_bots : Current.user.bots
+    end
+
+    def set_bot
+      @bot = bot_scope.find(params[:id])
+    end
+
+    def bot_params
+      params.require(:user).permit(:name, :avatar)
+    end
+end
