diff --git a/app/controllers/messages/by_bots_controller.rb b/app/controllers/messages/by_bots_controller.rb
new file mode 100644
index 0000000..5e418b4
--- /dev/null
+++ b/app/controllers/messages/by_bots_controller.rb
@@ -0,0 +1,32 @@
+class Messages::ByBotsController < MessagesController
+  allow_bot_access only: :create
+
+  before_action :set_room, :ensure_message_present
+
+  rescue_from(ActiveRecord::RecordNotFound) { head :not_found }
+
+  def create
+    super
+    head :created, location: message_url(@message)
+  end
+
+  private
+    def ensure_message_present
+      head :unprocessable_content if message_params.compact_blank.empty?
+    end
+
+    def message_params
+      if params[:attachment]
+        params.permit(:attachment)
+      else
+        reading(request.body) { |body| { body: body } }
+      end
+    end
+
+    def reading(io)
+      io.rewind
+      yield io.read.force_encoding("UTF-8").scrub
+    ensure
+      io.rewind
+    end
+end
