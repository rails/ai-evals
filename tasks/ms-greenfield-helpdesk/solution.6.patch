+    group = accounts(:acme).groups.new(name: "  BILLING  ")
+
+    assert_not group.valid?
+    assert group.errors.of_kind?(:name, :taken)
+
+    group.account = accounts(:globex)
+    assert group.valid?
+  end
+end
