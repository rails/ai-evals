+class RetireCitizenProposals < ActiveRecord::Migration[8.0]
+  # What other tables keep about the retired records: the rows naming their
+  # class, the comments on them with whatever points at those comments, and the
+  # communities of proposals with their topics. Children come before parents.
+  TYPES = "'Proposal', 'ProposalNotification', 'Dashboard::Action'".freeze
+  COMMUNITIES = "SELECT community_id FROM proposals WHERE community_id IS NOT NULL".freeze
+  TOPICS = "SELECT id FROM topics WHERE community_id IN (#{COMMUNITIES})".freeze
+  COMMENTS = "SELECT id FROM comments WHERE commentable_type IN (#{TYPES}) " \
+             "OR (commentable_type = 'Topic' AND commentable_id IN (#{TOPICS}))".freeze
+  RELATED = "parent_relationable_type IN (#{TYPES}) OR child_relationable_type IN (#{TYPES})".freeze
+  POINTERS = {
+    "votes" => "votable",
+    "flags" => "flaggable",
+    "notifications" => "notifiable",
+    "activities" => "actionable",
+    "ml_summary_comments" => "commentable",
+    "follows" => "followable",
+    "taggings" => "taggable",
+    "images" => "imageable",
+    "documents" => "documentable",
+    "milestones" => "milestoneable",
+    "progress_bars" => "progressable",
+    "remote_translations" => "remote_translatable",
+    "sdg_relations" => "relatable",
+    "sdg_reviews" => "relatable",
+    "signature_sheets" => "signable"
+  }.freeze
+  OWNED = ->(table) { "SELECT id FROM #{table} WHERE #{POINTERS[table]}_type IN (#{TYPES})" }
+  LEFTOVERS = {
+    **POINTERS.first(4).to_h do |table, pointer|
+      ["#{table}_on_comments", [table, "#{pointer}_type = 'Comment' AND #{pointer}_id IN (#{COMMENTS})"]]
+    end,
+    "comment_translations" => ["comment_translations", "comment_id IN (#{COMMENTS})"],
+    "comments" => ["comments", "id IN (#{COMMENTS})"],
+    "milestone_translations" => ["milestone_translations", "milestone_id IN (#{OWNED.call("milestones")})"],
+    "progress_bar_translations" => ["progress_bar_translations",
+                                    "progress_bar_id IN (#{OWNED.call("progress_bars")})"],
+    "signatures" => ["signatures", "signature_sheet_id IN (#{OWNED.call("signature_sheets")})"],
+    "attachments" => ["active_storage_attachments",
+                      "(record_type = 'Image' AND record_id IN (#{OWNED.call("images")})) " \
+                      "OR (record_type = 'Document' AND record_id IN (#{OWNED.call("documents")}))"],
+    **POINTERS.to_h { |table, pointer| [table, [table, "#{pointer}_type IN (#{TYPES})"]] },
+    "related_content_scores" => ["related_content_scores",
+                                 "related_content_id IN (SELECT id FROM related_contents WHERE #{RELATED})"],
+    "related_contents" => ["related_contents", RELATED],
+    "topics" => ["topics", "community_id IN (#{COMMUNITIES})"],
+    "communities" => ["communities", "id IN (#{COMMUNITIES})"],
+    "map_locations" => ["map_locations", "proposal_id IS NOT NULL"]
+  }.freeze
+
+  def change
+    remove_foreign_key :dashboard_executed_actions, :proposals
+    remove_foreign_key :poll_questions, :proposals
+    remove_foreign_key :proposals, :communities
+
+    reversible do |direction|
+      direction.up { delete_leftovers }
+    end
+
+    remove_index :poll_questions, :proposal_id
+    remove_column :poll_questions, :proposal_id, :integer
+    remove_index :map_locations, :proposal_id
+    remove_column :map_locations, :proposal_id, :integer
+    remove_index :tags, :proposals_count
+    remove_column :tags, :proposals_count, :integer, default: 0
+    remove_column :users, :recommended_proposals, :boolean
+    remove_column :users, :email_digest, :boolean
+    remove_column :users, :failed_email_digests_count, :integer, default: 0
+
+    drop_table :dashboard_administrator_tasks, id: :serial, force: :cascade do |t|
+      t.string "source_type"
