diff --git a/app/models/concerns/retired_records.rb b/app/models/concerns/retired_records.rb
deleted file mode 100644
index d123c4d..0000000
--- a/app/models/concerns/retired_records.rb
+++ /dev/null
@@ -1,27 +0,0 @@
-# Rows that still point at records of a retired feature stay in the database
-# until a migration takes them out; until then nothing loads them.
-module RetiredRecords
-  extend ActiveSupport::Concern
-
-  TYPES = %w[Proposal ProposalNotification Dashboard::Action].freeze
-
-  class_methods do
-    # A comment on a retired record is as gone as the record itself, and so is
-    # whatever points at that comment.
-    def hides_retired(*associations, comments: false)
-      associations.each do |association|
-        type = arel_table["#{association}_type"]
-        id = arel_table["#{association}_id"]
-
-        default_scope { where(type.eq(nil).or(type.not_in(TYPES))) }
-        next unless comments
-
-        default_scope do
-          retired_comments = Comment.unscoped.where(commentable_type: TYPES).select(:id)
-
-          where(type.not_eq("Comment").or(id.not_in(retired_comments.arel)))
-        end
-      end
-    end
-  end
-end
