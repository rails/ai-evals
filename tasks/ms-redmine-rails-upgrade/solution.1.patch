@@ -22,6 +22,10 @@ module Redmine
   module Database
     class << self
       # Returns true if the database is SQLite
+      def timezone
+        NextRails.next? ? ActiveRecord.default_timezone : ActiveRecord::Base.default_timezone
+      end
+
       def sqlite?
         ActiveRecord::Base.connection.adapter_name =~ /sqlite/i
