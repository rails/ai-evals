diff --git a/config/initializers/key_rotations.rb b/config/initializers/key_rotations.rb
new file mode 100644
index 0000000..971caa6
--- /dev/null
+++ b/config/initializers/key_rotations.rb
@@ -0,0 +1,11 @@
+# frozen_string_literal: true
+
+# Reads the cookies and mail links the 7.0 release writes, so it can be rolled back to
+# this one. The 6.1 key generator is SHA-1 only, hence pbkdf2_hmac.
+Rails.application.config.after_initialize do
+  config = Rails.application.config.action_dispatch
+  key = ->(salt, length) { OpenSSL::PKCS5.pbkdf2_hmac(Rails.application.secret_key_base, salt, 1000, length, 'sha256') }
+  secret = key.call(config.authenticated_encrypted_cookie_salt, 32)
+  config.cookies_rotations.rotate :encrypted, secret, :cipher => 'aes-256-gcm'
+  Rails.application.message_verifier(:mail_links).rotate(key.call('mail_links', 64))
+end
diff --git a/docs/UPGRADE.md b/docs/UPGRADE.md
new file mode 100644
index 0000000..df70e17
--- /dev/null
+++ b/docs/UPGRADE.md
@@ -0,0 +1,9 @@
+# Upgrade notes
+
+## Step 1: Ruby 3.2, Gemfile.next on Rails 7.0
+
+- Ruby 3.0 to 3.2. `Gemfile.next` (next_rails) boots Rails 7.0, and the suite is green on both.
+- 7.0 fixes that also run on 6.1: API templates, `request.media_type`, `to_formatted_s(:db)`.
+- `key_rotations.rb` reads the cookies and mail links 7.0 will write, so 7.0 can roll back
+  to this release.
+- Rollback: revert, and set `.ruby-version` back to 3.0.7.
