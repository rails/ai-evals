diff --git a/app/models/session/auditable.rb b/app/models/session/auditable.rb
new file mode 100644
index 0000000..4be9ac1
--- /dev/null
+++ b/app/models/session/auditable.rb
@@ -0,0 +1,25 @@
+module Session::Auditable
+  extend ActiveSupport::Concern
+
+  included do
+    after_create  :record_signed_in
+    after_destroy :record_signed_out
+  end
+
+  private
+    def record_signed_in
+      record_event :signed_in
+    end
+
+    def record_signed_out
+      record_event :signed_out
+    end
+
+    def record_event(action)
+      SignInEvent.create! \
+        action: action,
+        email_address: user.email_address,
+        ip_address: ip_address,
+        user_agent: user_agent
+    end
+end
