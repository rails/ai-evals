diff --git a/app/models/reading_mark.rb b/app/models/reading_mark.rb
new file mode 100644
index 0000000..62e8dc6
--- /dev/null
+++ b/app/models/reading_mark.rb
@@ -0,0 +1,14 @@
+class ReadingMark < ApplicationRecord
+  belongs_to :user
+  belongs_to :leaf
+
+  has_one :book, through: :leaf
+
+  scope :recent, -> { order(last_read_at: :desc) }
+
+  def self.remember(leaf, user: Current.user, at: Time.now)
+    mark = find_or_initialize_by(user: user, leaf: leaf)
+    mark.update! last_read_at: at
+    mark
+  end
+end
