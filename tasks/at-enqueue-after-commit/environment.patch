diff --git a/app/models/book/editing.rb b/app/models/book/editing.rb
new file mode 100644
index 0000000..d99f523
--- /dev/null
+++ b/app/models/book/editing.rb
@@ -0,0 +1,11 @@
+module Book::Editing
+  extend ActiveSupport::Concern
+
+  def apply_edit(attributes)
+    transaction do
+      update!(attributes)
+      Book::SearchIndexJob.perform_later(self)
+      Book::CoverProcessingJob.set(wait: 5.seconds).perform_later(self) if attributes[:cover].present?
+    end
+  end
+end
