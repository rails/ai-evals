+module Search::Stemmer
+  extend self
+
+  STEMMER = Mittens::Stemmer.new
+
+  def stem(value)
+    if value.present?
+      value.gsub(/[^\w\s]/, " ").split(/\s+/).map { |word| STEMMER.stem(word.downcase) }.join(" ")
+    else
+      value
+    end
+  end
+end
