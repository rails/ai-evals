diff --git a/spec/support/test_routes.rb b/spec/support/test_routes.rb
new file mode 100644
index 0000000..ed7ae14
--- /dev/null
+++ b/spec/support/test_routes.rb
@@ -0,0 +1,21 @@
+# frozen_string_literal: true
+
+# Draws a minimal route set once for a whole example group and restores the
+# application's routes after it, instead of reloading them after every example.
+# Routes refer to controllers by name, so the controllers can still be stubbed
+# per example with `stub_const`.
+module TestRoutes
+  def draw_test_routes(&)
+    before(:context) do
+      # The routes load lazily: load them now, so they do not replace ours later
+      Rails.application.reload_routes_unless_loaded
+      Rails.application.routes.draw(&)
+    end
+
+    after(:context) { Rails.application.reload_routes! }
+  end
+end
+
+RSpec.configure do |config|
+  config.extend TestRoutes
+end
