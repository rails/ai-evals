#!/usr/bin/env bash
# Moves the agent's own runtime state aside, so the run starts from an empty database and
# leaves no trace for the agent's next step (lemans' `git clean -fd` keeps ignored files).
# app/cleanup deletes what the run created and puts the agent's state back.
set -euo pipefail
cd "${WORKDIR:-/app}"
backup=/tmp/e2e-backup
rm -rf "$backup" && mkdir -p "$backup"

# Data (the contract: everything under storage/), logs, temp files and built assets. A symlink
# stays in place (an app may keep log/ and tmp/ under storage/: log -> storage/log); its target
# moves with storage/, and an empty target is made below.
for path in storage log tmp public/assets; do
  [ -L "$path" ] && continue
  if [ -e "$path" ]; then
    mkdir -p "$backup/$(dirname "$path")"
    mv "$path" "$backup/$path"
    echo "$path" >> "$backup/moved"
  fi
done
mkdir -p storage
for path in log tmp; do
  if [ -L "$path" ]; then mkdir -p "$(readlink -m "$path")"; else mkdir -p "$path"; fi
done
