#!/usr/bin/env bash
# Undoes app/prepare: deletes the run's data, logs, temp files and built assets, and puts
# the agent's own back, so the next step's workspace holds only the agent's state.
set -uo pipefail
cd "${WORKDIR:-/app}"
backup=/tmp/e2e-backup
[ -d "$backup" ] || exit 0

# A symlink stays (app/prepare left it in place); its target goes with storage/
for path in storage log tmp public/assets; do [ -L "$path" ] || rm -rf "$path"; done
if [ -f "$backup/moved" ]; then
  while read -r path; do
    mkdir -p "$(dirname "$path")"
    mv "$backup/$path" "$path"
  done < "$backup/moved"
fi
rm -rf "$backup"
