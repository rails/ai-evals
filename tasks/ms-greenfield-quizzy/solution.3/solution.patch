diff --git a/anycable.toml b/anycable.toml
new file mode 100644
index 0000000..ed461ae
--- /dev/null
+++ b/anycable.toml
@@ -0,0 +1,44 @@
+# AnyCable server configuration: the server is embedded into Thruster (bin/thrust)
+# and serves WebSockets at /cable on the same host and port as the app.
+#
+# Read more at https://docs.anycable.io/anycable-go/configuration
+
+# The application secret: it's used to verify Turbo signed stream names (and broadcast requests).
+# It MUST match the Rails side (config/anycable.yml).
+# IMPORTANT: In production, provide the secret via the ANYCABLE_SECRET env var.
+secret = "anycable-local-secret"
+
+# Participants are anonymous, so we don't authenticate connections.
+# Streams are still protected: only signed Turbo stream names are accepted.
+noauth = true
+
+# Rails broadcasts to the embedded server over HTTP (localhost only, see [http_broadcast])
+broadcast_adapters = ["http"]
+
+# A single-instance setup: don't auto-apply platform presets (e.g., on Fly, it would start an embedded NATS cluster)
+presets = ["none"]
+
+[logging]
+level = "info"
+
+# Standalone mode: Turbo Streams are authorized by the AnyCable server itself, no RPC calls to Rails
+[rpc]
+implementation = "none"
+
+[streams]
+turbo = true
+
+# In-memory broker: resumable sessions and streams history, so phones on a flaky
+# conference Wi-Fi catch up on missed updates after reconnecting.
+# Read more: https://docs.anycable.io/anycable-go/reliable_streams
+[broker]
+adapter = "memory"
+# How long (in seconds) a disconnected client can be away and still catch up
+history_ttl = 600
+sessions_ttl = 600
+# How long (in seconds) a disconnected player still counts as present: a Wi-Fi blip doesn't
+# flicker the counters, a closed page drops out within seconds
+presence_ttl = 3
+
+[http_broadcast]
+port = 8090
diff --git a/app/controllers/answers_controller.rb b/app/controllers/answers_controller.rb
new file mode 100644
index 0000000..05384cd
--- /dev/null
+++ b/app/controllers/answers_controller.rb
@@ -0,0 +1,23 @@
+class AnswersController < ApplicationController
+  include ParticipantIdentity
+
+  before_action :set_run, :set_participation
+
+  def create
+    if @participation
+      # Re-check the run state inside the write transaction so that an answer
+      # racing with "Finish" can't sneak in after results are revealed
+      Run.transaction do
+        @run.reload
+        question = @run.current_question
+        if question && @run.accepting_answers_for?(question) && question.id == params[:question_id].to_i
+          @participation.answers.find_or_initialize_by(question:).update(option_index: params[:option_index])
+        end
+      end
+    end
+
+    redirect_to play_path(@run)
+  rescue ActiveRecord::RecordNotUnique
+    redirect_to play_path(@run)
+  end
+end
diff --git a/app/controllers/concerns/participant_identity.rb b/app/controllers/concerns/participant_identity.rb
new file mode 100644
index 0000000..036ff71
--- /dev/null
+++ b/app/controllers/concerns/participant_identity.rb
@@ -0,0 +1,34 @@
+# Participants are anonymous: we generate a unique ID on the first visit and
+# keep it both in the session and in a permanent signed cookie.
+module ParticipantIdentity
+  extend ActiveSupport::Concern
+
+  included do
+    helper_method :participant_uid, :remembered_name
+  end
+
+  private
+
+  def participant_uid
+    @participant_uid ||= begin
+      uid = session[:participant_uid].presence || cookies.signed[:participant_uid].presence || SecureRandom.uuid
+      session[:participant_uid] = uid
+      cookies.permanent.signed[:participant_uid] = {value: uid, httponly: true}
+      uid
+    end
+  end
+
+  def remembered_name = cookies[:participant_name]
+
+  def remember_name(name)
+    cookies.permanent[:participant_name] = {value: name, httponly: true}
+  end
+
+  def set_run
+    @run = Run.find_by!(code: params[:code].to_s.upcase)
+  end
+
+  def set_participation
+    @participation = @run.participations.find_by(uid: participant_uid)
+  end
+end
diff --git a/app/controllers/moderate/runs_controller.rb b/app/controllers/moderate/runs_controller.rb
new file mode 100644
index 0000000..affd7ba
--- /dev/null
+++ b/app/controllers/moderate/runs_controller.rb
@@ -0,0 +1,47 @@
+module Moderate
+  class RunsController < BaseController
+    layout "application"
+
+    before_action :set_run, except: :create
+
+    def create
+      quiz = Quiz.find(params[:quiz_id])
+      run = quiz.runs.create!
+      redirect_to moderate_run_path(run)
+    end
+
+    def show
+      @question = @run.current_question if @run.running?
+    end
+
+    def destroy
+      @run.destroy!
+      redirect_to moderate_quiz_path(@run.quiz), notice: "Game deleted", status: :see_other
+    end
+
+    def start
+      if @run.idle? && @run.next_question.nil?
+        return redirect_to(moderate_run_path(@run), alert: "The quiz has no active questions")
+      end
+
+      @run.start! if @run.idle?
+      redirect_to moderate_run_path(@run)
+    end
+
+    def close_question
+      @run.close_question!
+      redirect_to moderate_run_path(@run)
+    end
+
+    def advance
+      @run.advance!
+      redirect_to moderate_run_path(@run)
+    end
+
+    private
+
+    def set_run
+      @run = Run.find_by!(code: params[:id])
+    end
+  end
+end
diff --git a/app/controllers/participations_controller.rb b/app/controllers/participations_controller.rb
new file mode 100644
index 0000000..85e1ad3
--- /dev/null
+++ b/app/controllers/participations_controller.rb
@@ -0,0 +1,21 @@
+class ParticipationsController < ApplicationController
+  include ParticipantIdentity
+
+  before_action :set_run, :set_participation
+
+  def create
+    return redirect_to(play_path(@run)) if @participation || @run.finished?
+
+    @participation = @run.participations.new(name: params[:name], uid: participant_uid)
+
+    if @participation.save
+      remember_name(@participation.name)
+      redirect_to play_path(@run)
+    else
+      @question = @run.current_question if @run.running?
+      render "plays/show", status: :unprocessable_entity
+    end
+  rescue ActiveRecord::RecordNotUnique
+    redirect_to play_path(@run)
+  end
+end
