@@ -0,0 +1,21 @@
+<% content_for :title, @run.quiz.title %>
+<%= turbo_refreshes_with method: :morph, scroll: :preserve %>
+<%= turbo_stream_from @run %>
+<% if @participation&.persisted? && !@run.finished? %><%= presence_source @run, id: "quizzy-player-#{@participation.id}" %><% end %>
+
+<div class="play">
