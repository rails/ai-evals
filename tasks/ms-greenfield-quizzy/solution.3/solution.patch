+# AnyCable Rails integration settings (NOT the AnyCable server, see anycable.toml).
+#
+# Values can be overridden via Rails credentials (e.g., `anycable.secret`) or
+# environment variables (e.g., ANYCABLE_SECRET), see https://github.com/palkan/anyway_config.
+default: &default
+  # Broadcast to the AnyCable server embedded into Thruster
+  broadcast_adapter: http
+  http_broadcast_url: "http://localhost:8090/_broadcast"
+  # MUST be the same as in the AnyCable server configuration (anycable.toml)
+  secret: "anycable-local-secret"
+  # AnyCable is served by Thruster at the same host
+  websocket_url: "/cable"
+
+development:
+  <<: *default
+
+test:
+  <<: *default
+  # Don't clash with a development server running at the same time
+  http_broadcast_url: "http://localhost:8091/_broadcast"
+
+production:
+  <<: *default
+  # Provide via the ANYCABLE_SECRET env var (shared by Rails and the AnyCable server)
+  secret: ~
