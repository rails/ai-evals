+<% answer = @participation.answer_for(question) %>
+<% results = @run.showing_results? %>
+<div class="play__body play__body--top">
+  <%= render "shared/play_question", question:, number: @run.current_question_number, total: @run.questions.size,
+        picked: answer&.option_index, reveal: results,
+        answer_url: (answers_path(code: @run.code) if @run.accepting_answers_for?(question)), extra_params: {} %>
+
+  <% if results %>
+    <% if answer.nil? %>
+      <div class="play-status play-status--neutral">No answer</div>
+    <% elsif answer.correct? %>
+      <div class="play-status play-status--right">Correct!</div>
+    <% else %>
+      <div class="play-status play-status--wrong">Wrong!</div>
+    <% end %>
+  <% elsif answer %>
+    <div class="play-status">Answer accepted. You can change it until the question closes.</div>
+  <% end %>
+</div>
