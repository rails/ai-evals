+  <% if @participation.nil? || @participation.new_record? %>
+    <%= render "plays/join" %>
+  <% elsif @run.idle? %>
+    <%= render "plays/waiting" %>
+  <% elsif @run.running? && @question %>
+    <%= render "plays/question", question: @question %>
+  <% else %>
+    <%= render "plays/finished" %>
+  <% end %>
+</div>
