+<% content_for :title, "Question responses · #{@run.code}" %>
+<% total = @answers.size %>
+
+<%= render "moderate/runs/responses_header", run: @run %>
+
+<div class="page-head">
+  <div>
+    <div class="meta"><%= question_progress(@questions.index(@question) + 1, @questions.size) %></div>
+    <h1 class="response-title"><%= @question.body %></h1>
+  </div>
+</div>
+
+<div class="card">
+  <ol class="response-options">
+    <% @question.options.each_with_index do |option, index| %>
+      <% count = @counts.fetch(index, 0) %>
+      <li class="response-option <%= "is-correct" if option["correct"] %>"
+          style="--share: <%= total.zero? ? 0 : (count * 100.0 / total).round(1) %>%">
+        <span class="response-option__title"><%= option_label(@question, index) %></span>
+        <span class="response-option__count"><%= count %></span>
+      </li>
+    <% end %>
+  </ol>
+  <p class="meta"><%= total %> of <%= @participations.size %> answered</p>
+</div>
+
+<div class="card">
+  <table class="runs-table">
+    <thead>
+      <tr><th>Player</th><th>Answer</th><th></th><th>Time</th></tr>
+    </thead>
+    <tbody>
+      <% @participations.each do |participation| %>
+        <% answer = @answers[participation.id] %>
+        <tr id="<%= dom_id(participation) %>">
+          <td><%= link_to participation.name, moderate_run_participant_response_path(@run, participation) %></td>
+          <td><%= answer ? option_label(@question, answer.option_index) : "—" %></td>
+          <td><%= render "moderate/runs/answer_mark", answer: %></td>
+          <td><%= format_duration(answer.elapsed_ms) if answer %></td>
+        </tr>
+      <% end %>
+    </tbody>
+  </table>
+</div>
+
+<nav class="pager">
+  <%= link_to "← Previous question", moderate_run_question_response_path(@run, @prev_question), class: "btn btn--ghost btn--sm" if @prev_question %>
+  <%= link_to "All questions", moderate_run_responses_path(@run), class: "btn btn--ghost btn--sm" %>
+  <%= link_to "Next question →", moderate_run_question_response_path(@run, @next_question), class: "btn btn--ghost btn--sm" if @next_question %>
+</nav>
