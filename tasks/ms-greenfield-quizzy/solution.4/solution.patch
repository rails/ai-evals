+<% content_for :title, "Player responses · #{@participation.name}" %>
+
+<%= render "moderate/runs/responses_header", run: @run %>
+
+<div class="page-head">
+  <div>
+    <h1>
+      <%= @participation.name %>
+      <% if @participation.winner? %><span class="mark mark--winner">winner</span><% end %>
+    </h1>
+    <div class="meta mt-2">
+      Place <%= @place %> of <%= @total %> ·
+      <%= t("counts.points", count: @participation.score) %>
+      <% if @participation.score.positive? %>· time of correct answers: <%= format_duration(@participation.correct_time_ms) %><% end %>
+    </div>
+  </div>
+</div>
+
+<% @questions.each_with_index do |question, index| %>
+  <% answer = @answers[question.id] %>
+  <article class="card response-card" id="<%= dom_id(question) %>">
+    <div class="response-card__head">
+      <span class="meta"><%= question_progress(index + 1, @questions.size) %></span>
+      <%= render "moderate/runs/answer_mark", answer: %>
+    </div>
+    <div class="question-item__body"><%= link_to question.body, moderate_run_question_response_path(@run, question) %></div>
+    <ul class="question-item__options">
+      <% question.options.each_with_index do |option, i| %>
+        <li class="<%= "is-correct" if option["correct"] %> <%= "is-picked" if answer&.option_index == i %>"><%= option_label(question, i) %></li>
+      <% end %>
+    </ul>
+    <% if answer %><div class="meta mt-2">Answer time: <%= format_duration(answer.elapsed_ms) %></div><% end %>
+  </article>
+<% end %>
+
+<nav class="pager">
+  <%= link_to "← #{@prev_participation.name}", moderate_run_participant_response_path(@run, @prev_participation), class: "btn btn--ghost btn--sm" if @prev_participation %>
+  <%= link_to "All players", moderate_run_responses_path(@run, tab: "participants"), class: "btn btn--ghost btn--sm" %>
+  <%= link_to "#{@next_participation.name} →", moderate_run_participant_response_path(@run, @next_participation), class: "btn btn--ghost btn--sm" if @next_participation %>
+</nav>
