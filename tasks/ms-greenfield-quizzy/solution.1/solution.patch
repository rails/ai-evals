+<% content_for :title, @quiz.title %>
+<% questions = @quiz.questions.to_a %>
+<% active_count = questions.count(&:active?) %>
+
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+
+<div class="page-head">
+  <div>
+    <h1><%= @quiz.title %></h1>
+    <div class="meta mt-2">
+      <%= active_count %> of <%= t("counts.questions", count: questions.size) %> active ·
+      <%= link_to "Settings", edit_moderate_quiz_path(@quiz) %>
+    </div>
+  </div>
+  <div class="buttons">
+    <%= link_to "Preview", moderate_quiz_preview_path(@quiz), class: "btn btn--ghost #{"btn--disabled" if active_count.zero?}" %>
+  </div>
+</div>
+
+<section class="section mt-0" id="questions">
+  <div class="section-head">
+    <h2>Questions</h2>
+    <%= link_to "Add question", new_moderate_quiz_question_path(@quiz), class: "btn" %>
+  </div>
+
+  <% if questions.empty? %>
+    <div class="empty">No questions yet.</div>
+  <% end %>
+
+  <ol class="question-list">
+    <% number = 0 %>
+    <% questions.each_with_index do |question, index| %>
+      <li id="<%= dom_id(question) %>" class="card question-item <%= "question-item--inactive" unless question.active? %>">
+        <div class="question-item__num"><%= question.active? ? (number += 1) : "—" %></div>
+        <div>
+          <div class="question-item__body"><%= question.body %></div>
+          <ul class="question-item__options">
+            <% question.options.each_with_index do |option, i| %>
+              <li class="<%= "is-correct" if option["correct"] %>"><%= option_letter(i) %>. <%= option["title"] %></li>
+            <% end %>
+          </ul>
+        </div>
+        <div class="question-item__actions">
+          <div class="buttons">
+            <%= button_to "↑", move_moderate_question_path(question, direction: :up), method: :patch, class: "btn btn--ghost btn--icon", title: "Move up", "aria-label": "Move up", disabled: index.zero? %>
+            <%= button_to "↓", move_moderate_question_path(question, direction: :down), method: :patch, class: "btn btn--ghost btn--icon", title: "Move down", "aria-label": "Move down", disabled: index == questions.size - 1 %>
+          </div>
+          <%= form_with model: [:moderate, question], class: "inline-form" do |f| %>
+            <label class="checkbox">
+              <%= f.check_box :active, onchange: "this.form.requestSubmit()" %>
+              Active
+            </label>
+          <% end %>
+          <div class="buttons">
+            <%= link_to "Edit", edit_moderate_question_path(question), class: "btn btn--sm" %>
+            <%= button_to "Delete", moderate_question_path(question), method: :delete, class: "btn btn--sm btn--danger",
+                  form: {data: {turbo_confirm: "Delete this question?"}} %>
+          </div>
+        </div>
+      </li>
+    <% end %>
+  </ol>
+</section>
