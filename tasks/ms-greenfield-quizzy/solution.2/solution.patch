@@ -0,0 +1,22 @@
+<% content_for :title, "Import quiz" %>
+
+<div class="breadcrumbs"><%= link_to "← All quizzes", moderate_root_path %></div>
+<div class="page-head"><h1>Import quiz</h1></div>
+
+<%= form_with url: moderate_import_path, class: "card" do |f| %>
+  <% if @error %>
+    <div class="errors" role="alert">The quiz could not be imported. <%= @error %></div>
+  <% end %>
+
+  <div class="field">
+    <%= f.label :json, "Quiz JSON" %>
+    <%= f.text_area :json, value: @json, class: "input input--code", rows: 16, required: true, spellcheck: false,
+          placeholder: '{"title": "...", "questions": [...]}' %>
+    <span class="field-hint">Paste a quiz exported from Quizzy. The import creates a new quiz.</span>
+  </div>
+
+  <div class="buttons">
+    <%= f.submit "Import", class: "btn btn--pink" %>
+    <%= link_to "Cancel", moderate_root_path, class: "btn btn--ghost" %>
+  </div>
+<% end %>
