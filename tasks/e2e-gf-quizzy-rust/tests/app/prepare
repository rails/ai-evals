#!/usr/bin/env bash
# Moves the agent's own runtime state aside, so the run starts from an empty database and
# leaves no trace for the agent's next step (lemans' `git clean -fd` keeps ignored files).
# app/cleanup deletes what the run created and puts the agent's state back.
set -euo pipefail
cd "${WORKDIR:-/app}"
backup=/tmp/e2e-backup
rm -rf "$backup" && mkdir -p "$backup"

# Data (the contract: everything under storage/), logs, temp files and built assets
for path in storage log tmp public/assets; do
  if [ -e "$path" ]; then
    mkdir -p "$backup/$(dirname "$path")"
    mv "$path" "$backup/$path"
    echo "$path" >> "$backup/moved"
  fi
done
mkdir -p storage log tmp
