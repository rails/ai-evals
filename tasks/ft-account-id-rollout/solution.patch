--- /dev/null
+++ b/db/migrate/20260827092735_backfill_account_ids.rb
@@ -0,0 +1,179 @@
+class BackfillAccountIds < ActiveRecord::Migration[8.2]
+  TENANTED_TABLES = %w[
+    accesses
+    assignments
+    board_publications
+    card_activity_spikes
+    card_goldnesses
+    card_not_nows
+    closures
+    entropies
+    mentions
+    pins
+    reactions
+    search_queries
+    taggings
+    user_settings
+    watches
+    webhook_delinquency_trackers
+    webhook_deliveries
+    action_text_rich_texts
+    active_storage_attachments
+    active_storage_blobs
+    active_storage_variant_records
+
+    account_join_codes
+    boards
+    cards
+    columns
+    comments
+    events
+    filters
+    notification_bundles
+    notifications
+    push_subscriptions
+    steps
+    tags
+    users
+    webhooks
+  ]
+
+  # Each table's account is derived through its own association path. Order
+  # matters: parents are resolved before the tables that derive through them
+  # (boards -> cards -> comments -> rich texts -> attachments -> blobs).
+  SIMPLE_DERIVATIONS = [
+    %w[ cards boards board_id ],
+    %w[ columns boards board_id ],
+    %w[ events boards board_id ],
+    %w[ webhooks boards board_id ],
+    %w[ board_publications boards board_id ],
+    %w[ comments cards card_id ],
+    %w[ steps cards card_id ],
+    %w[ assignments cards card_id ],
+    %w[ card_activity_spikes cards card_id ],
+    %w[ card_goldnesses cards card_id ],
+    %w[ card_not_nows cards card_id ],
+    %w[ closures cards card_id ],
+    %w[ taggings cards card_id ],
+    %w[ filters users creator_id ],
+    %w[ notifications users user_id ],
+    %w[ notification_bundles users user_id ],
+    %w[ push_subscriptions users user_id ],
+    %w[ accesses users user_id ],
+    %w[ pins users user_id ],
+    %w[ search_queries users user_id ],
+    %w[ user_settings users user_id ],
+    %w[ watches users user_id ],
+    %w[ webhook_delinquency_trackers webhooks webhook_id ],
+    %w[ webhook_deliveries webhooks webhook_id ]
+  ]
+
+  def up
+    SIMPLE_DERIVATIONS.each do |table, parent, key|
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = (SELECT account_id FROM #{parent} WHERE #{parent}.id = #{table}.#{key})
+        WHERE account_id IS NULL
+      SQL
+    end
+
+    execute <<~SQL
+      UPDATE entropies
+      SET account_id = CASE container_type
+        WHEN 'Account' THEN container_id
+        ELSE (SELECT account_id FROM boards WHERE boards.id = entropies.container_id)
+      END
+      WHERE account_id IS NULL
+    SQL
+
+    { "mentions" => "source", "reactions" => "reactable" }.each do |table, name|
+      execute <<~SQL
+        UPDATE #{table}
+        SET account_id = CASE #{name}_type
+          WHEN 'Card' THEN (SELECT account_id FROM cards WHERE cards.id = #{table}.#{name}_id)
+          WHEN 'Comment' THEN (SELECT account_id FROM comments WHERE comments.id = #{table}.#{name}_id)
+        END
+        WHERE account_id IS NULL
+      SQL
+    end
+
+    execute <<~SQL
+      UPDATE action_text_rich_texts
+      SET account_id = CASE record_type
+        WHEN 'Card' THEN (SELECT account_id FROM cards WHERE cards.id = action_text_rich_texts.record_id)
+        WHEN 'Comment' THEN (SELECT account_id FROM comments WHERE comments.id = action_text_rich_texts.record_id)
+        WHEN 'Board' THEN (SELECT account_id FROM boards WHERE boards.id = action_text_rich_texts.record_id)
+      END
+      WHERE account_id IS NULL
+    SQL
+
+    execute <<~SQL
+      UPDATE active_storage_attachments
+      SET account_id = CASE record_type
+        WHEN 'Card' THEN (SELECT account_id FROM cards WHERE cards.id = active_storage_attachments.record_id)
+        WHEN 'User' THEN (SELECT account_id FROM users WHERE users.id = active_storage_attachments.record_id)
+        WHEN 'Export' THEN (SELECT account_id FROM exports WHERE exports.id = active_storage_attachments.record_id)
+        WHEN 'Account::Import' THEN (SELECT account_id FROM account_imports WHERE account_imports.id = active_storage_attachments.record_id)
+        WHEN 'ActionText::RichText' THEN (SELECT account_id FROM action_text_rich_texts WHERE action_text_rich_texts.id = active_storage_attachments.record_id)
+        WHEN 'ActiveStorage::VariantRecord' THEN (SELECT account_id FROM active_storage_variant_records WHERE active_storage_variant_records.id = active_storage_attachments.record_id)
+        WHEN 'Identity' THEN (
+          -- An identity spans accounts; its stored avatar copies belong to its
+          -- earliest membership, the only persisted ownership we have.
+          SELECT users.account_id FROM users
+          WHERE users.identity_id = active_storage_attachments.record_id
+          ORDER BY users.created_at LIMIT 1
+        )
+      END
+      WHERE account_id IS NULL
+    SQL
+
+    execute <<~SQL
+      UPDATE active_storage_blobs
+      SET account_id = (
+        SELECT account_id FROM active_storage_attachments
+        WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+          AND active_storage_attachments.account_id IS NOT NULL
+        LIMIT 1
+      )
+      WHERE account_id IS NULL
+    SQL
+
+    execute <<~SQL
+      UPDATE active_storage_variant_records
+      SET account_id = (SELECT account_id FROM active_storage_blobs WHERE active_storage_blobs.id = active_storage_variant_records.blob_id)
+      WHERE account_id IS NULL
+    SQL
+
+    # A variant's own image file is an attachment on the variant record, so its
+    # attachment and blob only resolve once the variant record has its account:
+    # run the storage chain a second time to pick up what the first pass added.
+    execute <<~SQL
+      UPDATE active_storage_attachments
+      SET account_id = (SELECT account_id FROM active_storage_variant_records WHERE active_storage_variant_records.id = active_storage_attachments.record_id)
+      WHERE account_id IS NULL AND record_type = 'ActiveStorage::VariantRecord'
+    SQL
+
+    execute <<~SQL
+      UPDATE active_storage_blobs
+      SET account_id = (
+        SELECT account_id FROM active_storage_attachments
+        WHERE active_storage_attachments.blob_id = active_storage_blobs.id
+          AND active_storage_attachments.account_id IS NOT NULL
+        LIMIT 1
+      )
+      WHERE account_id IS NULL
+    SQL
+
+    # Whatever the backfill could not attribute has no surviving owner: a
+    # tagging for a card deleted years ago, a file for an identity that never
+    # joined an account. Leftovers go rather than block the constraint.
+    TENANTED_TABLES.each do |table|
+      orphans = connection.delete("DELETE FROM #{table} WHERE account_id IS NULL")
+      say "Discarded #{orphans} #{table} row(s) with no account to inherit" if orphans > 0
+    end
+  end
+
+  def down
+    # Data-only migration: dropping the columns discards the backfill.
+  end
+end
