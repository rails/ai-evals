diff --git a/app/models/concerns/profile_picture.rb b/app/models/concerns/profile_picture.rb
new file mode 100644
index 0000000..2d22053
--- /dev/null
+++ b/app/models/concerns/profile_picture.rb
@@ -0,0 +1,50 @@
+# Profile pictures are moving from CarrierWave to Active Storage. New pictures are attached,
+# older ones are read from CarrierWave until they are copied over.
+require "open-uri"
+
+module ProfilePicture
+  extend ActiveSupport::Concern
+
+  included do
+    has_one_attached :profile_picture
+  end
+
+  # Strings keep CarrierWave's handling. Files are attached, with EXIF stripped as the uploader did.
+  def profile_image=(image)
+    return super unless image.respond_to?(:path)
+
+    profile_picture.attach(io: processed_picture(image.path), filename: picture_filename(image))
+    profile_image_will_change!
+    self[:profile_image] = nil
+  end
+
+  def remote_profile_image_url=(url)
+    return if url.blank?
+
+    uri = URI.parse(url)
+    profile_picture.attach(io: uri.open, filename: File.basename(uri.path))
+    profile_image_will_change!
+    self[:profile_image] = nil
+  end
+
+  def profile_image_url
+    return super unless profile_picture.attached? && profile_picture.blob.persisted?
+
+    Rails.application.routes.url_helpers.rails_blob_path(profile_picture, only_path: true)
+  end
+
+  private
+
+  def processed_picture(path)
+    return File.open(path, "rb") unless ProfileImageUploader.enable_processing
+
+    image = MiniMagick::Image.open(path)
+    image.auto_orient
+    image.strip
+    File.open(image.path, "rb")
+  end
+
+  def picture_filename(image)
+    File.basename(image.try(:original_filename) || image.path)
+  end
+end
