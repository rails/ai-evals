@@ -0,0 +1,14 @@
+# Shared contract tests the private gem injects into host-app test classes.
+# The stand-in ships the one contract Fizzy interacts with; Fizzy undefs it
+# as not-applicable (accounts are created Fizzy -> Queenbee, never pushed).
+require "queenbee"
+
+module Queenbee
+  module Testing
+    module Client
+      def test_client_class_should_respond_to_create_with_dependents
+        assert_respond_to Account, :create_with_dependents
+      end
+    end
+  end
+end
diff --git a/vendor/gems/queenbee/lib/queenbee/testing/mocks.rb b/vendor/gems/queenbee/lib/queenbee/testing/mocks.rb
new file mode 100644
index 000000000..141e569ce
--- /dev/null
+++ b/vendor/gems/queenbee/lib/queenbee/testing/mocks.rb
@@ -0,0 +1,25 @@
+# Test-mode mocks: Remote::Account creation happens locally, with sequential
+# ids, no network. next_id lives in a module so the host app can override it
+# and still reach the default through super.
+require "queenbee"
+
+module Queenbee
+  module Remote
+    module AccountMocks
+      def next_id
+        @@next_id ||= 900_000
+        @@next_id += 1
+      end
+    end
+
+    class Account
+      include AccountMocks
+
+      class << self
+        def create!(attributes = {})
+          new(attributes).tap { |account| account.attributes[:id] ||= account.next_id }
+        end
+      end
+    end
+  end
+end
