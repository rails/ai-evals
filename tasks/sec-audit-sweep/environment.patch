diff --git a/app/views/searches/show.html.erb b/app/views/searches/show.html.erb
new file mode 100644
index 0000000..014b625
--- /dev/null
+++ b/app/views/searches/show.html.erb
@@ -0,0 +1,39 @@
+<% content_for(:title) { "Search | Writebook" } %>
+<% @layout_class = "books" %>
+
+<% content_for :header do %>
+  <nav>
+    <%= link_to root_path, class: "btn" do %>
+      <%= image_tag "arrow-left.svg", aria: { hidden: true }, size: 24 %>
+      <span class="for-screen-reader">Go back</span>
+    <% end %>
+
+    <div class="breadcrumbs">
+      <%= render "books/index_link" %>
+      <span class="flex-item-no-shrink">▸</span>
+      Search
+    </div>
+  </nav>
+<% end %>
+
+<div class="panel margin-block-double shadow center">
+  <%= form_with url: library_search_path, method: :get, class: "flex align-center gap" do |form| %>
+    <label class="flex align-center gap input full-width">
+      <%= form.search_field :q, value: @query, class: "input full-width", placeholder: "Search the library", autofocus: true %>
+      <%= image_tag "search.svg", aria: { hidden: true }, size: 24, class: "colorize--black" %>
+    </label>
+    <button type="submit" class="btn"><span class="for-screen-reader">Search</span></button>
+  <% end %>
+
+  <div class="search__results flex flex-column margin-block-start">
+    <% if @leaves.any? %>
+      <% @leaves.each do |leaf| %>
+        <%= link_to leafable_slug_path(leaf), class: "search__result txt-ink" do %>
+          <strong><%= leaf.book.title %>:</strong> <%= leaf.title %>
+        <% end %>
+      <% end %>
+    <% elsif @query.present? %>
+      <p class="search__no_matches txt-align-center">No matches.</p>
+    <% end %>
+  </div>
+</div>
